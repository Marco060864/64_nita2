l_riga~") COLUMN(NAME=~"riga_documento.tot_riga_val_doc~") COLUMN(NAME=~"riga_documento.tot_riga_val_az~") COLUMN(NAME=~"riga_documento.id_riga_doc_provenienza~") COLUMN(NAME=~"riga_documento.id_conto~") COLUMN(NAME=~"riga_documento.id_azienda~") COLUMN(NAME=~"riga_documento.provv_subage~") COLUMN(NAME=~"riga_documento.provv_carea~") COMPUTE(NAME=~"cast('' as char(8)) as c_catcom~") COMPUTE(NAME=~"cast('' as char(8)) as c_catmer~") COMPUTE(NAME=~"cast('' as char(8)) as c_codiva~") COMPUTE(NAME=~"cast('' as char(8)) as c_contro~") COMPUTE(NAME=~"cast('' as char(20)) as c_codart~") COMPUTE(NAME=~"cast('' as char(18)) as rif_num~") COMPUTE(NAME=~"cast('' as char(11)) as rif_data~") COLUMN(NAME=~"riga_documento.id_riga_doc_padre~") COLUMN(NAME=~"riga_documento.provv_imp_agente~") COLUMN(NAME=~"riga_documento.provv_imp_subage~") COLUMN(NAME=~"riga_documento.provv_imp_carea~") COLUMN(NAME=~"riga_documento.id_riga_lotto~") COLUMN(NAME=~"unita_misura.simbolo~") COLUMN(NAME=~"riga_documento.peso_netto_evaso~") COLUMN(NAME=~"riga_documento.id_gruppo_agenti_2~") COLUMN(NAME=~"riga_documento.provv_agente_2~") COLUMN(NAME=~"riga_documento.provv_subage_2~") COLUMN(NAME=~"riga_documento.provv_carea_2~") COLUMN(NAME=~"riga_documento.provv_imp_agente_2~") COLUMN(NAME=~"riga_documento.provv_imp_subage_2~") COLUMN(NAME=~"riga_documento.provv_imp_carea_2~") COLUMN(NAME=~"riga_documento.prezzo~") COLUMN(NAME=~"riga_documento.prezzo_netto~")    JOIN (LEFT=~"unita_confezione.id_unita_confezione~"    OP =~"=~"RIGHT=~"riga_documento.id_unita_confezione~"    OUTER2 =~"riga_documento.id_unita_confezione~" )    JOIN (LEFT=~"unita_confezione.id_unita_misura~"    OP =~"=~"RIGHT=~"unita_misura.id_unita_misura~"    OUTER1 =~"unita_confezione.id_unita_misura~" )) " update="riga_documento" updatewhere=1 updatekeyinplace=yes  sort="id_documento A num_riga A " )
