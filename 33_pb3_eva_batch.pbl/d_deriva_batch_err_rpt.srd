release 5;
datawindow(units=3 timer_interval=0 color=1090519039 processing=0 print.documentname="Elenco Anomalie" print.orientation = 0 print.margin.left = 1500 print.margin.right = 1500 print.margin.top = 1500 print.margin.bottom = 1500 print.paper.source = 0 print.paper.size = 0 print.prompt=no )
header(height=2063 color="536870912" )
summary(height=79 color="536870912" )
footer(height=555 color="536870912" )
detail(height=423 color="553648127"  height.autosize=yes)
table(column=(type=char(4) updatewhereclause=yes name=codice dbname="esercizio.codice" )
 column=(type=char(2) updatewhereclause=yes name=tipo_registro dbname="registro.tipo_registro" values="IVA acquisti	IA/IVA vendite	IV/IVA corrispettivi	IC/Manageriale	MN/Prima nota	PN/Preventivi acquisti	PA/Preventivi vendite	PV/Ordini acquisti	OA/Ordini vendite	OV/DDT acquisti	DA/DDT vendite	DV/Liste prelievo acquisti	LA/Liste prelievo vendite	LV/Generico acquisti	GA/Generico vendite	GV/" validation=" gettext()  = 'IA' OR  gettext()  = 'IV' OR  gettext()  = 'IC' OR  gettext()  = 'MN' OR  gettext()  = 'PN' OR  gettext()  = 'PZ' OR  gettext()  = 'PA' OR  gettext()  = 'PV' OR  gettext()  = 'OA' OR  gettext()  = 'OV' OR  gettext()  = 'DA' OR  gettext()  = 'DV' OR  gettext()  = 'LA' OR  gettext()  = 'LV' OR  gettext()  = 'GA' OR  gettext()  = 'GV'" validationmsg="'Immettere: IA, IV,IC , MN, PN, OA, OP, DA, DV, LA, LP, GA, GV'" )
 column=(type=decimal(0) updatewhereclause=yes name=numero dbname="registro.numero" validation=" real(gettext())  >= 0" validationmsg="'Immettere un valore >= 0'" )
 column=(type=decimal(0) updatewhereclause=yes name=num_progressivo dbname="documento.num_progressivo" validation=" real(gettext())  >= 0" validationmsg="'Immettere un valore >= 0'" )
 column=(type=date updatewhereclause=yes name=data_registrazione dbname="documento.data_registrazione" )
 column=(type=char(8) updatewhereclause=yes name=codice_1 dbname="sog_commerciale_gen.codice" )
 column=(type=char(40) updatewhereclause=yes name=rag_soc_1 dbname="sog_commerciale_gen.rag_soc_1" )
 column=(type=decimal(0) updatewhereclause=yes name=num_riga dbname="riga_documento.num_riga" validation=" real(gettext())  >= 0" validationmsg="'Immettere un valore >= 0'" )
 column=(type=char(32766) updatewhereclause=no name=descrizione dbname="riga_documento.descrizione" )
 column=(type=char(0) updatewhereclause=yes name=err_txt dbname="err_txt" )
 column=(type=long updatewhereclause=yes identity=yes name=id_documento dbname="documento.id_documento" )
 column=(type=char(32) updatewhereclause=yes name=articolo_codice dbname="articolo.codice" )
 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"articolo~" )  TABLE(NAME=~"documento~" )  TABLE(NAME=~"esercizio~" )  TABLE(NAME=~"registro~" )  TABLE(NAME=~"riga_documento~" )  TABLE(NAME=~"sog_commerciale_gen~" ) COLUMN(NAME=~"esercizio.codice~") COLUMN(NAME=~"registro.tipo_registro~") COLUMN(NAME=~"registro.numero~") COLUMN(NAME=~"documento.num_progressivo~") COLUMN(NAME=~"documento.data_registrazione~") COLUMN(NAME=~"sog_commerciale_gen.codice~") COLUMN(NAME=~"sog_commerciale_gen.rag_soc_1~") COLUMN(NAME=~"riga_documento.num_riga~") COLUMN(NAME=~"riga_documento.descrizione~") COMPUTE(NAME=~"'' as err_txt~") COLUMN(NAME=~"documento.id_documento~") COLUMN(NAME=~"articolo.codice~")    JOIN (LEFT=~"registro.id_esercizio~"    OP =~"=~"RIGHT=~"esercizio.id_esercizio~" )    JOIN (LEFT=~"registro.id_registro~"    OP =~"=~"RIGHT=~"documento.id_registro~" )    JOIN (LEFT=~"riga_documento.id_documento~"    OP =~"=~"RIGHT=~"documento.id_documento~" )    JOIN (LEFT=~"riga_documento.id_articolo~"    OP =~"=~"RIGHT=~"articolo.id_articolo~" )    JOIN (LEFT=~"documento.id_sog_commerciale~"    OP =~"=~"RIGHT=~"sog_commerciale_gen.id_sog_commerciale~" )) "  sort="codice A tipo_registro A numero A num_progressivo A num_riga A " )
group(level=1 header.height=1270 trailer.height=79 by=("codice" , "tipo_registro" , "numero" , "num_progressivo" ) header.color="536870912" trailer.color="536870912" )
compute(band=header alignment="2" expression="~"  ~"+ string(today()) + ~"  - Elenco delle anomalie riscontrate durante l'evasione ~""border="1" color="33554432" x="132" y="132" height="502" width="17330" format="[general]"  name=data_ora  font.face="Arial" font.height="-10" font.weight="700"  font.family="2" font.pitch="2" font.charset="0" background.mode="2" background.color="79741120" )
line(band=header x1="0" y1="1852" x2="17594" y2="1852" pen.style="0" pen.width="132" pen.color="79741120"  background.mode="1" background.color="553648127" )
text(band=header alignment="0" text="Titolo 2"border="0" color="33554432" x="793" y="926" height="767" width="16113"  name=titolo_2  font.face="Arial" font.height="-8" font.weight="400"  font.family="2" font.pitch="2" font.charset="0" background.mode="1" background.color="553648127"  height.autosize=yes)
text(band=header.1 alignment="1" text="N"border="0" color="33554432" x="264" y="662" height="370" width="714"  name=num_riga_t  font.face="Arial" font.height="-8" font.weight="400"  font.family="2" font.pitch="2" font.charset="0" background.mode="1" background.color="536870912" )
text(band=header.1 alignment="0" text="Articolo"border="0" color="33554432" x="1190" y="662" height="370" width="2698"  name=codart_t  font.face="Arial" font.height="-8" font.weight="400"  font.family="2" font.pitch="2" font.charset="0" background.mode="1" background.color="536870912" )
column(band=header.1 id=3 alignment="0" tabsequence=32766 border="0" color="33554432" x="4497" y="132" height="370" width="767" format="#,0"  name=numero  slideleft=yes edit.name="es_Pos_8" edit.limit=8 edit.case=any edit.format="#0 " edit.autoselect=yes edit.nilisnull=yes  font.face="Arial" font.height="-8" font.weight="700"  font.family="2" font.pitch="2" font.charset="0" background.mode="1" background.color="553648127" )
compute(band=header.1 alignment="0" expression="~"Es. : ~"+ codice "border="0" color="33554432" x="132" y="132" height="370" width="1190" format="[general]"  name=c_es  font.face="Arial" font.height="-8" font.weight="700"  font.family="2" font.pitch="2" font.charset="0" background.mode="1" background.color="536870912" )
compute(band=header.1 alignment="0" expression="~"N. ~"+string ( num_progressivo ) + ~" del ~"+string( data_registrazione ) + ~"  Intestato a ~" +  codice_1 + ~"-~" +  rag_soc_1 "border="0" color="33554432" x="5953" y="132" height="370" width="11641" format="[general]"  name=c_numdoc  font.face="Arial" font.height="-8" font.weight="700"  font.family="2" font.pitch="2" font.charset="0" background.mode="1" background.color="553648127" )
column(band=header.1 id=2 alignment="0" tabsequence=32766 border="0" color="33554432" x="1719" y="132" height="370" width="2672" format="[general]"  name=tipo_registro  slideleft=yes ddlb.limit=0 ddlb.allowedit=no ddlb.case=any ddlb.nilisnull=yes ddlb.vscrollbar=yes  font.face="Arial" font.height="-8" font.weight="700"  font.family="2" font.pitch="2" font.charset="0" background.mode="1" background.color="553648127" )
column(band=detail id=8 alignment="1" tabsequence=32766 border="0" color="33554432" x="264" y="0" height="370" width="714" format="#,0"  name=num_riga edit.name="es_Pos_4" edit.limit=4 edit.case=any edit.format="#0 " edit.autoselect=yes edit.nilisnull=yes  font.face="Arial" font.height="-8" font.weight="400"  font.family="2" font.pitch="2" font.charset="0"font.italic="0~tif ((num_riga =0), 1, 0)"  background.mode="1" background.color="536870912" )
line(band=trailer.1 x1="0" y1="0" x2="17594" y2="0" pen.style="0" pen.width="26" pen.color="33554432"  background.mode="1" background.color="536870912" )
compute(band=footer alignment="0" expression="'Pag. ' + page() + ' di  ' + pagecount()"border="0" color="33554432" x="132" y="132" height="370" width="2725" format="[general]"  name=numpag  font.face="Arial" font.height="-8" font.weight="700"  font.family="2" font.pitch="2" font.charset="0" background.mode="1" background.color="536870912" )
column(band=detail id=12 alignment="0" tabsequence=0 border="0" color="33554432" x="1058" y="0" height="396" width="4445"  name=articolo_codice  font.face="Arial" font.height="-8" font.weight="400"  font.family="2" font.pitch="2" font.charset="0" background.mode="1" background.color="553648127" )
