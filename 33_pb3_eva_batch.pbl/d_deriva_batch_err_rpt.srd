text(band=header.1 alignment="0" text="Errore"border="0" color="33554432" x="11853" y="662" height="370" width="793"  name=err_txt_t  font.face="Arial" font.height="-8" font.weight="400"  font.family="2" font.pitch="2" font.charset="0" background.mode="1" background.color="536870912" )
