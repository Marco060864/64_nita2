footer(height=4 color="536870912" )
detail(height=76 color="536870912" )
table(column=(type=long update=yes updatewhereclause=yes key=yes name=id_documento dbname="spesa_documento.id_documento" )
 column=(type=long update=yes updatewhereclause=yes key=yes name=id_spesa dbname="spesa_documento.id_spesa" )
 column=(type=decimal(2) update=yes updatewhereclause=yes name=percentuale dbname="spesa_documento.percentuale" validation=" real(gettext())  >= 0 AND  real(gettext())  <= 100" validationmsg="'Immettere un valore fra 0 e 100'" )
 column=(type=decimal(4) update=yes updatewhereclause=yes name=importo dbname="spesa_documento.importo" )
 column=(type=long update=yes updatewhereclause=yes name=id_tab_iva dbname="spesa_documento.id_tab_iva" )
 column=(type=char(1) updatewhereclause=yes name=cc_mod_calc_iva dbname="c_mod_calc_iva" )
 column=(type=decimal(0) updatewhereclause=yes name=cc_importo_buffer dbname="c_importo_buffer" )
 column=(type=char(1) update=yes updatewhereclause=yes name=mantieni dbname="spesa_documento.mantieni" initial="N" )
 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"spesa_documento~" )  TABLE(NAME=~"spesa~" ) COLUMN(NAME=~"spesa_documento.id_documento~") COLUMN(NAME=~"spesa_documento.id_spesa~") COLUMN(NAME=~"spesa_documento.percentuale~") COLUMN(NAME=~"spesa_documento.importo~") COLUMN(NAME=~"spesa_documento.id_tab_iva~") COMPUTE(NAME=~"CAST( ~~~"spesa~~~".~~~"mod_cal_iva~~~" as char(1)) as c_mod_calc_iva~") COMPUTE(NAME=~"CAST( 0 as decimal) as c_importo_buffer~") COLUMN(NAME=~"spesa_documento.mantieni~")    JOIN (LEFT=~"spesa.id_spesa~"    OP =~"=~"RIGHT=~"spesa_documento.id_spesa~" )) " update="spesa_documento" updatewhere=1 updatekeyinplace=yes )
