table(column=(type=long updatewhereclause=yes identity=yes name=riga_documento_id_riga_documento dbname="id_riga_documento" )
 column=(type=decimal(4) updatewhereclause=yes name=riga_documento_quantita dbname="quantita" )
 column=(type=decimal(4) updatewhereclause=yes name=riga_documento_qta_sconto_merce dbname="qta_sconto_merce" )
 column=(type=decimal(4) updatewhereclause=yes name=riga_documento_qta_evasa dbname="qta_evasa" )
 column=(type=long updatewhereclause=yes name=locazione_id_magazzino dbname="id_magazzino" )
 column=(type=long updatewhereclause=yes name=riga_documento_id_caus_magazzino dbname="id_caus_magazzino" )
 column=(type=decimal(4) updatewhereclause=yes name=riga_documento_tot_riga_val_doc dbname="tot_riga_val_doc" )
 column=(type=char(80) updatewhereclause=yes name=cdescrizione dbname="descrizione" )
 column=(type=char(1) updatewhereclause=yes name=riga_documento_chiuforz dbname="forza_chius_evasione" initial="N" values="	S/	N" validation=" gettext()  = 'S' OR  gettext()  = 'N'" validationmsg="'Immettere: S, N'" )
 column=(type=long updatewhereclause=yes name=riga_documento_id_conto dbname="id_conto" )
 column=(type=long updatewhereclause=yes name=riga_documento_id_articolo dbname="id_articolo" )
 column=(type=char(32) updatewhereclause=yes name=ccodice dbname="codice" )
 column=(type=decimal(2) updatewhereclause=yes name=peso_netto dbname="peso_netto" )
 column=(type=decimal(4) updatewhereclause=yes name=peso_netto_evaso dbname="peso_netto_evaso" )
 column=(type=decimal(0) updatewhereclause=yes name=num_riga dbname="num_riga" )
 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"locazione~" )  TABLE(NAME=~"riga_documento~" )  TABLE(NAME=~"articolo~" ) COLUMN(NAME=~"riga_documento.id_riga_documento~") COLUMN(NAME=~"riga_documento.quantita~") COLUMN(NAME=~"riga_documento.qta_sconto_merce~") COLUMN(NAME=~"riga_documento.qta_evasa~") COLUMN(NAME=~"locazione.id_magazzino~") COLUMN(NAME=~"riga_documento.id_caus_magazzino~") COLUMN(NAME=~"riga_documento.tot_riga_val_doc~") COLUMN(NAME=~"articolo.descrizione~") COLUMN(NAME=~"riga_documento.forza_chius_evasione~") COLUMN(NAME=~"riga_documento.id_conto~") COLUMN(NAME=~"riga_documento.id_articolo~") COLUMN(NAME=~"articolo.codice~") COLUMN(NAME=~"riga_documento.peso_netto~") COLUMN(NAME=~"riga_documento.peso_netto_evaso~") COLUMN(NAME=~"riga_documento.num_riga~")    JOIN (LEFT=~"riga_documento.id_locazione_1~"    OP =~"=~"RIGHT=~"locazione.id_locazione~"    OUTER1 =~"riga_documento.id_locazione_1~" )    JOIN (LEFT=~"articolo.id_articolo~"    OP =~"=~"RIGHT=~"riga_documento.id_articolo~"    OUTER2 =~"riga_documento.id_articolo~" )WHERE(    EXP1 =~"~~~"riga_documento~~~".~~~"id_documento~~~"~"   OP =~"=~"    EXP2 =~":rl_iddoc~" ) ) ARG(NAME = ~"rl_iddoc~" TYPE = number) " arguments=(("rl_iddoc", number))  sort="num_riga A " )
