 column=(type=char(16) updatewhereclause=yes name=num_documento dbname="documento.num_documento" )
 column=(type=long updatewhereclause=yes name=documento_id_gruppo_agenti_2 dbname="documento.id_gruppo_agenti_2" )
 column=(type=decimal(4) updatewhereclause=yes name=documento_cambio dbname="documento.cambio" )
 retrieve="PBSELECT( VERSION(400) DISTINCT ()TABLE(NAME=~"documento~" )  TABLE(NAME=~"sog_commerciale_gen~" )  TABLE(NAME=~"valuta~" )  TABLE(NAME=~"der_profilo~" )  TABLE(NAME=~"registro~" )  TABLE(NAME=~"sog_commerciale~" ) COLUMN(NAME=~"documento.id_documento~") COLUMN(NAME=~"documento.id_prof_documento~") COLUMN(NAME=~"documento.num_progressivo~") COLUMN(NAME=~"documento.data_registrazione~") COLUMN(NAME=~"sog_commerciale_gen.codice~") COLUMN(NAME=~"valuta.descrizione~") COLUMN(NAME=~"valuta.cambio~") COLUMN(NAME=~"documento.sconto_finanziario~") COLUMN(NAME=~"documento.sconto_fin_cassa~") COLUMN(NAME=~"documento.creato_in_esenzione~") COLUMN(NAME=~"documento.id_valuta~") COLUMN(NAME=~"documento.id_banca_sog_commerciale~") COLUMN(NAME=~"documento.id_sog_commerciale~") COLUMN(NAME=~"documento.id_sog_commerciale_fattura~") COLUMN(NAME=~"documento.id_gruppo_agenti~") COLUMN(NAME=~"documento.id_destinazione~") COLUMN(NAME=~"documento.id_con_pagamento~") COLUMN(NAME=~"registro.tipo_registro~") COMPUTE(NAME=~"' ' as c_ok~") COLUMN(NAME=~"documento.imp_acconto~") COLUMN(NAME=~"documento.id_tipo_pag_acconto~") COLUMN(NAME=~"documento.id_tab_iva_acconto~") COLUMN(NAME=~"documento.id_val_acconto~") COLUMN(NAME=~"der_profilo.id_prof_documento_padre~") COLUMN(NAME=~"documento.num_documento~") COLUMN(NAME=~"documento.id_gruppo_agenti_2~") COLUMN(NAME=~"documento.cambio~")    JOIN (LEFT=~"documento.id_registro~"    OP =~"=~"RIGHT=~"registro.id_registro~" )    JOIN (LEFT=~"valuta.id_valuta~"    OP =~"=~"RIGHT=~"documento.id_valuta~" )    JOIN (LEFT=~"sog_commerciale_gen.id_sog_commerciale~"    OP =~"=~"RIGHT=~"sog_commerciale.id_sog_commerciale~" )) "  sort="documento_id_documento A " )
