 column=(type=long update=yes updatewhereclause=yes name=documento_id_prof_documento dbname="documento.id_prof_documento" )
 column=(type=decimal(0) update=yes updatewhereclause=yes name=documento_num_progressivo dbname="documento.num_progressivo" validation=" real(gettext())  >= 0" validationmsg="'Immettere un valore >= 0'" )
 column=(type=date update=yes updatewhereclause=yes name=documento_data_registrazione dbname="documento.data_registrazione" )
 column=(type=char(8) updatewhereclause=yes name=sog_commerciale_gen_codice dbname="sog_commerciale_gen.codice" )
