 column=(type=char(40) update=yes updatewhereclause=yes name=documento_sconto_finanziario dbname="documento.sconto_finanziario" )
 column=(type=decimal(2) update=yes updatewhereclause=yes name=documento_sconto_fin_cassa dbname="documento.sconto_fin_cassa" validation=" real(gettext())  >= 0 AND  real(gettext())  <= 100" validationmsg="'Immettere un valore fra 0 e 100'" )
