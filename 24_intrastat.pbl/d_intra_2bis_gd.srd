 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"intra_2bis~" )  TABLE(NAME=~"sog_commerciale~" )  TABLE(NAME=~"anagrafica~" ) COLUMN(NAME=~"intra_2bis.prog_operazioni~") COLUMN(NAME=~"intra_2bis.id_sog_commerciale~") COLUMN(NAME=~"intra_2bis.amm_operazioni~") COLUMN(NAME=~"intra_2bis.id_i_nat_trans~") COLUMN(NAME=~"intra_2bis.id_i_nomenclatura~") COLUMN(NAME=~"intra_2bis.unita_suppl~") COLUMN(NAME=~"intra_2bis.valore_stat~") COLUMN(NAME=~"intra_2bis.id_i_cod_cons~") COLUMN(NAME=~"intra_2bis.id_i_modo_trsp~") COLUMN(NAME=~"intra_2bis.id_i_tab_iso~") COLUMN(NAME=~"intra_2bis.id_localita~") COLUMN(NAME=~"intra_2bis.id_i_2bis~") COLUMN(NAME=~"intra_2bis.id_i_fronte~") COLUMN(NAME=~"intra_2bis.intra_tab_iso~") COLUMN(NAME=~"anagrafica.rag_soc_1~") COLUMN(NAME=~"anagrafica.par_iva~") COLUMN(NAME=~"anagrafica.nazione~") COLUMN(NAME=~"intra_2bis.amm_valuta~") COLUMN(NAME=~"intra_2bis.massa_netta~")    JOIN (LEFT=~"sog_commerciale.id_sog_commerciale~"    OP =~"=~"RIGHT=~"intra_2bis.id_sog_commerciale~" )    JOIN (LEFT=~"anagrafica.id_anagrafica~"    OP =~"=~"RIGHT=~"sog_commerciale.id_anagrafica~" )WHERE(    EXP1 =~"~~~"intra_2bis~~~".~~~"id_i_fronte~~~"~"   OP =~"=~"    EXP2 =~":rn_id_i_fronte~" ) ) ARG(NAME = ~"rn_id_i_fronte~" TYPE = number) " update="intra_2bis" updatewhere=1 updatekeyinplace=yes arguments=(("rn_id_i_fronte", number))  sort="prog_operazioni A " )
