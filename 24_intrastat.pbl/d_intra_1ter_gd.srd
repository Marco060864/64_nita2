 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"intra_1ter~" )  TABLE(NAME=~"sog_commerciale~" )  TABLE(NAME=~"anagrafica~" ) COLUMN(NAME=~"intra_1ter.id_i_1ter~") COLUMN(NAME=~"intra_1ter.id_i_fronte~") COLUMN(NAME=~"intra_1ter.prog_operaz~") COLUMN(NAME=~"intra_1ter.id_sog_commerciale~") COLUMN(NAME=~"intra_1ter.segno~") COLUMN(NAME=~"intra_1ter.amm_operaz~") COLUMN(NAME=~"intra_1ter.id_i_nat_trans~") COLUMN(NAME=~"intra_1ter.id_i_nomenclatura~") COLUMN(NAME=~"intra_1ter.val_stat~") COLUMN(NAME=~"intra_1ter.rif~") COLUMN(NAME=~"anagrafica.rag_soc_1~") COLUMN(NAME=~"anagrafica.par_iva~") COLUMN(NAME=~"anagrafica.nazione~") COLUMN(NAME=~"intra_1ter.mese_rif~") COLUMN(NAME=~"intra_1ter.trim_rif~") COLUMN(NAME=~"intra_1ter.anno_rif~")    JOIN (LEFT=~"sog_commerciale.id_sog_commerciale~"    OP =~"=~"RIGHT=~"intra_1ter.id_sog_commerciale~" )    JOIN (LEFT=~"anagrafica.id_anagrafica~"    OP =~"=~"RIGHT=~"sog_commerciale.id_anagrafica~" )WHERE(    EXP1 =~"~~~"intra_1ter~~~".~~~"id_i_fronte~~~"~"   OP =~"=~"    EXP2 =~":rn_id_i_fronte~" ) ) ARG(NAME = ~"rn_id_i_fronte~" TYPE = number) " update="intra_1ter" updatewhere=1 updatekeyinplace=yes arguments=(("rn_id_i_fronte", number))  sort="prog_operazioni A " )
