 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"documento~" )  TABLE(NAME=~"registro~" )  TABLE(NAME=~"riga_documento~" )  TABLE(NAME=~"tab_iva~" )  TABLE(NAME=~"sog_commerciale~" )  TABLE(NAME=~"articolo~" ) COLUMN(NAME=~"documento.data_documento~") COLUMN(NAME=~"documento.tipo_fattura~") COLUMN(NAME=~"riga_documento.quantita~") COLUMN(NAME=~"riga_documento.prezzo~") COLUMN(NAME=~"registro.tipo_registro~") COLUMN(NAME=~"articolo.cod_intrastat~") COLUMN(NAME=~"sog_commerciale.id_sog_commerciale~") COLUMN(NAME=~"riga_documento.tot_riga_val_az~") COLUMN(NAME=~"riga_documento.tot_riga_val_doc~") COLUMN(NAME=~"documento.peso_netto~") COLUMN(NAME=~"riga_documento.peso_netto~")    JOIN (LEFT=~"registro.id_registro~"    OP =~"=~"RIGHT=~"documento.id_registro~" )    JOIN (LEFT=~"riga_documento.id_documento~"    OP =~"=~"RIGHT=~"documento.id_documento~" )    JOIN (LEFT=~"tab_iva.id_tab_iva~"    OP =~"=~"RIGHT=~"riga_documento.id_tab_iva~" )    JOIN (LEFT=~"sog_commerciale.id_sog_commerciale~"    OP =~"=~"RIGHT=~"documento.id_sog_commerciale~" )    JOIN (LEFT=~"articolo.id_articolo~"    OP =~"=~"RIGHT=~"riga_documento.id_articolo~" )WHERE(    EXP1 =~"~~~"tab_iva~~~".~~~"ges_oper_intracomunitarie~~~"~"   OP =~"=~"    EXP2 =~"'S'~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"documento~~~".~~~"data_documento~~~"~"   OP =~">=~"    EXP2 =~":rd_data_iniziale~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"documento~~~".~~~"data_documento~~~"~"   OP =~"<=~"    EXP2 =~":rd_data_finale~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"registro~~~".~~~"tipo_registro~~~"~"   OP =~">=~"    EXP2 =~":rs_tiporeg1~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"registro~~~".~~~"tipo_registro~~~"~"   OP =~"<=~"    EXP2 =~":rs_tiporeg2~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"documento~~~".~~~"tipo_fattura~~~"~"   OP =~">=~"    EXP2 =~":rs_tipodoc1~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"documento~~~".~~~"tipo_fattura~~~"~"   OP =~"<=~"    EXP2 =~":rs_tipodoc2~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"documento~~~".~~~"contabilizzato~~~"~"   OP =~"=~"    EXP2 =~"'N'~" ) ) ARG(NAME = ~"rd_data_iniziale~" TYPE = date)  ARG(NAME = ~"rd_data_finale~" TYPE = date)  ARG(NAME = ~"rs_tiporeg1~" TYPE = string)  ARG(NAME = ~"rs_tiporeg2~" TYPE = string)  ARG(NAME = ~"rs_tipodoc1~" TYPE = string)  ARG(NAME = ~"rs_tipodoc2~" TYPE = string) " arguments=(("rd_data_iniziale", date),("rd_data_finale", date),("rs_tiporeg1", string),("rs_tiporeg2", string),("rs_tipodoc1", string),("rs_tipodoc2", string)) )
