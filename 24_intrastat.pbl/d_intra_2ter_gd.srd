 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"intra_2ter~" )  TABLE(NAME=~"sog_commerciale~" )  TABLE(NAME=~"anagrafica~" ) COLUMN(NAME=~"intra_2ter.id_i_2ter~") COLUMN(NAME=~"intra_2ter.prog_oper~") COLUMN(NAME=~"intra_2ter.id_sog_commerciale~") COLUMN(NAME=~"intra_2ter.segn~") COLUMN(NAME=~"intra_2ter.amm_oper~") COLUMN(NAME=~"intra_2ter.id_i_nat_trans~") COLUMN(NAME=~"intra_2ter.id_i_nomenclatura~") COLUMN(NAME=~"intra_2ter.val_stat~") COLUMN(NAME=~"intra_2ter.rifer~") COLUMN(NAME=~"intra_2ter.id_i_fronte~") COLUMN(NAME=~"anagrafica.rag_soc_1~") COLUMN(NAME=~"anagrafica.par_iva~") COLUMN(NAME=~"anagrafica.nazione~") COLUMN(NAME=~"intra_2ter.amm_valut~") COLUMN(NAME=~"intra_2ter.mese_rif~") COLUMN(NAME=~"intra_2ter.trim_rif~") COLUMN(NAME=~"intra_2ter.anno_rif~")    JOIN (LEFT=~"sog_commerciale.id_sog_commerciale~"    OP =~"=~"RIGHT=~"intra_2ter.id_sog_commerciale~" )    JOIN (LEFT=~"anagrafica.id_anagrafica~"    OP =~"=~"RIGHT=~"sog_commerciale.id_anagrafica~" )WHERE(    EXP1 =~"~~~"intra_2ter~~~".~~~"id_i_fronte~~~"~"   OP =~"=~"    EXP2 =~":rn_id_i_fronte~" ) ) ARG(NAME = ~"rn_id_i_fronte~" TYPE = number) " update="intra_2ter" updatewhere=1 updatekeyinplace=yes arguments=(("rn_id_i_fronte", number))  sort="prog_operazioni A " )
