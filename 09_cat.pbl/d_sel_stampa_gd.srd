 column=(type=long updatewhereclause=yes name=cat_com_articolo_id_cat_com_articolo dbname="id_cat_com_articolo" )
 column=(type=long updatewhereclause=yes name=cat_fiscale_id_cat_fiscale dbname="id_cat_fiscale" )
 column=(type=long updatewhereclause=yes name=cat_merceologica_id_cat_merceologica dbname="id_cat_merceologica" )
 column=(type=long updatewhereclause=yes name=orafo_metallo_id_metallo dbname="id_metallo" )
 column=(type=long updatewhereclause=yes name=orafo_titolo_id_titolo dbname="id_titolo" )
 column=(type=long updatewhereclause=yes name=anagrafica_id_anagrafica dbname="id_anagrafica" )
 column=(type=long updatewhereclause=yes name=id_valuta dbname="id_valuta" )
 column=(type=long updatewhereclause=yes name=sog_commerciale_gen_id_sog_commerciale dbname="id_sog_commerciale" )
 column=(type=decimal(2) updatewhereclause=yes name=unita_confezione_peso_non_prezioso dbname="peso_non_prezioso" )
 column=(type=decimal(2) updatewhereclause=yes name=unita_confezione_peso_netto dbname="peso_netto" )
 column=(type=decimal(4) updatewhereclause=yes name=unita_confezione_dim_l dbname="dim_l" )
 column=(type=long updatewhereclause=yes name=prezzo_id_variazione dbname="id_variazione" )
 column=(type=decimal(2) updatewhereclause=yes name=orafo_metallo_quotazione dbname="quotazione" )
 column=(type=char(40) updatewhereclause=yes name=orafo_colore_descrizione dbname="descrizione" )
 column=(type=char(32766) updatewhereclause=yes name=note dbname="note" )
 column=(type=long updatewhereclause=yes name=id_distinta dbname="id_distinta" )
 column=(type=char(32) updatewhereclause=yes name=codice dbname="codice" )
 column=(type=long updatewhereclause=yes name=id_articolo dbname="id_articolo" )
 column=(type=datetime updatewhereclause=yes name=data_ora_creazione dbname="data_ora_creazione" )
 column=(type=datetime updatewhereclause=yes name=data_ora_ult_cambiamento dbname="data_ora_ult_cambiamento" )
 column=(type=char(1) updatewhereclause=yes name=tipo_applicazione dbname="tipo_applicazione" )
 column=(type=long updatewhereclause=yes name=id_azienda dbname="id_azienda" )
 retrieve="  SELECT  distinct ~"articolo~".~"id_articolo~",   
         ~"articolo~".~"codice~",
			cast('' as char(255))as note_art,   
         ~"articolo~".~"descrizione~",   
         ~"articolo~".~"immagine~",   
         ~"cat_codifica~".~"codice~",   
         ~"cat_com_articolo~".~"codice~",   
         ~"cat_fiscale~".~"codice~",   
         ~"cat_merceologica~".~"codice~",   
         ~"prezzo~".~"prezzo~",  
 			~"prezzo~".~"prezzo_manifattura~",  
         ~"unita_confezione~".~"codice~",   
         ~"orafo_titolo~".~"titolo~",   
         ~"orafo_colore~".~"codice~",   
         ~"orafo_metallo~".~"codice~",   
         ~"orafo_metallo~".~"data_quotazione~",   
         ~"orafo_metallo~".~"descrizione~",   
         ~"articolo~".~"coef_calo~",   
         ~"anagrafica~".~"rag_soc_1~",   
         ~"sog_commerciale_gen~".~"rag_soc_1~",   
         ~"cat_codifica~".~"id_cat_codifica~",   
         ~"cat_com_articolo~".~"id_cat_com_articolo~",   
         ~"cat_fiscale~".~"id_cat_fiscale~",   
         ~"cat_merceologica~".~"id_cat_merceologica~",   
         ~"orafo_metallo~".~"id_metallo~",   
         ~"orafo_titolo~".~"id_titolo~",   
         ~"anagrafica~".~"id_anagrafica~", 
			~"anagrafica~".~"id_valuta~",  
         ~"sog_commerciale_gen~".~"id_sog_commerciale~",   
         ~"unita_confezione~".~"peso_non_prezioso~",   
         ~"unita_confezione~".~"peso_netto~",
         ~"unita_confezione~".~"dim_l~",
         ~"prezzo~".~"id_variazione~",   
         ~"orafo_metallo~".~"quotazione~",   
         ~"orafo_colore~".~"descrizione~",   
         ~"distinta~".~"note~",   
         ~"distinta~".~"id_distinta~",   
         ~"distinta~".~"codice~",   
         ~"distinta~".~"id_articolo~",   
         ~"distinta~".~"data_ora_creazione~",   
         ~"distinta~".~"data_ora_ult_cambiamento~",   
         ~"distinta~".~"tipo_applicazione~",   
         ~"distinta~".~"id_azienda~"  
    FROM {oj {oj {oj {oj {oj {oj {oj {oj ~"articolo~"  LEFT OUTER JOIN ~"cat_codifica~"  ON ~"articolo~".~"id_cat_codifica~" = ~"cat_codifica~".~"id_cat_codifica~"} LEFT OUTER JOIN ~"cat_com_articolo~"  ON ~"articolo~".~"id_cat_com_articolo~" = ~"cat_com_articolo~".~"id_cat_com_articolo~"} LEFT OUTER JOIN ~"cat_fiscale~"  ON ~"articolo~".~"id_cat_fiscale~" = ~"cat_fiscale~".~"id_cat_fiscale~"} LEFT OUTER JOIN ~"cat_merceologica~"  ON ~"articolo~".~"id_cat_merceologica~" = ~"cat_merceologica~".~"id_cat_merceologica~"}, {oj ~"riepilogo~"  LEFT OUTER JOIN ~"locazione~"  ON ~"riepilogo~".~"id_locazione~" = ~"locazione~".~"id_locazione~"}, {oj ~"articolo~"  LEFT OUTER JOIN ~"riepilogo~"  ON ~"articolo~".~"id_articolo~" = ~"riepilogo~".~"id_articolo~"}, {oj ~"unita_confezione~"  LEFT OUTER JOIN ~"prezzo~"  ON ~"unita_confezione~".~"id_unita_confezione~" = ~"prezzo~".~"id_unita_confezione~"}, {oj ~"articolo~"  LEFT OUTER JOIN ~"unita_confezione~"  ON ~"articolo~".~"id_articolo~" = ~"unita_confezione~".~"id_articolo~"} LEFT OUTER JOIN ~"orafo_colore~"  ON ~"articolo~".~"id_colore~" = ~"orafo_colore~".~"id_colore~"}, {oj ~"orafo_titolo~"  LEFT OUTER JOIN ~"orafo_metallo~"  ON ~"orafo_titolo~".~"id_metallo~" = ~"orafo_metallo~".~"id_metallo~"}, {oj ~"articolo~"  LEFT OUTER JOIN ~"orafo_titolo~"  ON ~"articolo~".~"id_titolo~" = ~"orafo_titolo~".~"id_titolo~"} LEFT OUTER JOIN ~"anagrafica~"  ON ~"articolo~".~"id_anagrafica~" = ~"anagrafica~".~"id_anagrafica~"} LEFT OUTER JOIN ~"sog_commerciale_gen~"  ON ~"articolo~".~"id_sog_commerciale~" = ~"sog_commerciale_gen~".~"id_sog_commerciale~"} LEFT OUTER JOIN ~"distinta~"  ON ~"articolo~".~"id_articolo~" = ~"distinta~".~"id_articolo~"}, {oj ~"prezzo~"  LEFT OUTER JOIN ~"variazione~"  ON ~"prezzo~".~"id_variazione~" = ~"variazione~".~"id_variazione~"}  
			, listino
   WHERE 
			listino.id_listino=variazione.id_listino and 
			
			( ~"articolo~".~"stampa_in_catalogo~" = 'S' ) AND
			( ~"unita_confezione~".~"unita_base~" = 'S' ) "  sort="articolo_codice A " )
