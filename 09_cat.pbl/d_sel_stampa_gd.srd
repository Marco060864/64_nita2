 column=(type=char(32) updatewhereclause=yes name=articolo_codice dbname="codice" )
 column=(type=char(255) updatewhereclause=yes name=note_art dbname="note_art" )
 column=(type=char(80) updatewhereclause=yes name=articolo_descrizione dbname="descrizione" )
