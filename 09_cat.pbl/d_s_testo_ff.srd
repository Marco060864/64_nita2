 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"s_testo~" ) COLUMN(NAME=~"s_testo.note~") COLUMN(NAME=~"s_testo.campo~") COLUMN(NAME=~"s_testo.font~") COLUMN(NAME=~"s_testo.altezza~") COLUMN(NAME=~"s_testo.riga~") COLUMN(NAME=~"s_testo.x~") COLUMN(NAME=~"s_testo.id_lingua~") COLUMN(NAME=~"s_testo.id_template~") COLUMN(NAME=~"s_testo.red~") COLUMN(NAME=~"s_testo.green~") COLUMN(NAME=~"s_testo.blue~")WHERE(    EXP1 =~"( ~~~"s_testo~~~".~~~"id_template~~~"~"   OP =~"=~"    EXP2 =~":rn_id_template )~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"( ~~~"s_testo~~~".~~~"id_lingua~~~"~"   OP =~"=~"    EXP2 =~":rn_id_lingua )~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"( ~~~"s_testo~~~".~~~"note~~~"~"   OP =~"=~"    EXP2 =~":rs_note )~" ) ) ARG(NAME = ~"rn_id_template~" TYPE = number)  ARG(NAME = ~"rn_id_lingua~" TYPE = number)  ARG(NAME = ~"rs_note~" TYPE = string) " update="s_testo" updatewhere=1 updatekeyinplace=yes arguments=(("rn_id_template", number),("rn_id_lingua", number),("rs_note", string)) )
