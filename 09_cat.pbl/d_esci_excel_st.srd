 column=(type=char(8) updatewhereclause=yes name=tab_iva_codice dbname="tab_iva.codice" dbalias=".codice" )
 column=(type=decimal(2) updatewhereclause=yes name=per_aliquota dbname="tab_iva.per_aliquota" dbalias=".per_aliquota" )
 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"articolo~" )  TABLE(NAME=~"orafo_metallo~" )  TABLE(NAME=~"orafo_titolo~" )  TABLE(NAME=~"riga_documento~" )  TABLE(NAME=~"unita_confezione~" )  TABLE(NAME=~"unita_misura~" )  TABLE(NAME=~"tab_iva~" ) COLUMN(NAME=~"riga_documento.num_riga~") COLUMN(NAME=~"riga_documento.descrizione~") COLUMN(NAME=~"articolo.codice~") COLUMN(NAME=~"orafo_titolo.titolo~") COLUMN(NAME=~"orafo_metallo.codice~") COLUMN(NAME=~"riga_documento.quantita~") COLUMN(NAME=~"riga_documento.peso_netto~") COLUMN(NAME=~"riga_documento.coef_calo~") COLUMN(NAME=~"riga_documento.id_documento~") COLUMN(NAME=~"unita_misura.simbolo~") COLUMN(NAME=~"riga_documento.prezzo_manifattura~") COLUMN(NAME=~"riga_documento.prezzo_metallo~") COLUMN(NAME=~"riga_documento.prezzo_complessivo~") COLUMN(NAME=~"riga_documento.tot_riga_val_riga~") COLUMN(NAME=~"tab_iva.codice~") COLUMN(NAME=~"tab_iva.per_aliquota~")    JOIN (LEFT=~"orafo_titolo.id_metallo~"    OP =~"=~"RIGHT=~"orafo_metallo.id_metallo~" )    JOIN (LEFT=~"orafo_titolo.id_titolo~"    OP =~"=~"RIGHT=~"articolo.id_titolo~" )    JOIN (LEFT=~"riga_documento.id_articolo~"    OP =~"=~"RIGHT=~"articolo.id_articolo~" )    JOIN (LEFT=~"riga_documento.id_unita_confezione~"    OP =~"=~"RIGHT=~"unita_confezione.id_unita_confezione~" )    JOIN (LEFT=~"unita_misura.id_unita_misura~"    OP =~"=~"RIGHT=~"unita_confezione.id_unita_mis_peso~" )    JOIN (LEFT=~"riga_documento.id_tab_iva~"    OP =~"=~"RIGHT=~"tab_iva.id_tab_iva~" )WHERE(    EXP1 =~"~~~"riga_documento~~~".~~~"id_documento~~~"~"   OP =~"=~"    EXP2 =~":al_id_doc~" ) ) ARG(NAME = ~"al_id_doc~" TYPE = number) " arguments=(("al_id_doc", number)) )
