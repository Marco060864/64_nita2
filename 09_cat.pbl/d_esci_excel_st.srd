 column=(type=decimal(6) updatewhereclause=yes name=prezzo_metallo dbname="riga_documento.prezzo_metallo" dbalias=".prezzo_metallo" )
 column=(type=decimal(6) updatewhereclause=yes name=prezzo_complessivo dbname="riga_documento.prezzo_complessivo" dbalias=".prezzo_complessivo" )
