table(column=(type=decimal(0) updatewhereclause=yes name=riga_documento_num_riga dbname="riga_documento.num_riga" dbalias=".num_riga" )
 column=(type=char(32766) updatewhereclause=no name=descrizione dbname="riga_documento.descrizione" dbalias=".descrizione" )
 column=(type=char(32) updatewhereclause=yes name=articolo_codice dbname="articolo.codice" dbalias=".codice" )
 column=(type=decimal(2) updatewhereclause=yes name=orafo_titolo_titolo dbname="orafo_titolo.titolo" dbalias=".titolo" )
 column=(type=char(2) updatewhereclause=yes name=orafo_metallo_codice dbname="orafo_metallo.codice" dbalias=".codice" )
 column=(type=decimal(4) updatewhereclause=yes name=quantita dbname="riga_documento.quantita" dbalias=".quantita" )
 column=(type=decimal(4) updatewhereclause=yes name=peso_netto dbname="riga_documento.peso_netto" dbalias=".peso_netto" )
