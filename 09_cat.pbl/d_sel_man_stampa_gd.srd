table(column=(type=long updatewhereclause=yes name=id_articolo dbname="articolo.id_articolo" )
 column=(type=char(32) updatewhereclause=yes name=articolo_codice dbname="articolo.codice" )
 column=(type=char(255) updatewhereclause=yes name=note_art dbname="note_art" )
 column=(type=char(80) updatewhereclause=yes name=articolo_descrizione dbname="articolo.descrizione" )
 column=(type=char(255) updatewhereclause=yes name=articolo_immagine dbname="articolo.immagine" )
 column=(type=char(4) updatewhereclause=yes name=cat_codifica_codice dbname="cat_codifica.codice" )
 column=(type=char(8) updatewhereclause=yes name=cat_com_articolo_codice dbname="cat_com_articolo.codice" )
 column=(type=char(8) updatewhereclause=yes name=cat_fiscale_codice dbname="cat_fiscale.codice" )
 column=(type=char(8) updatewhereclause=yes name=cat_merceologica_codice dbname="cat_merceologica.codice" )
 column=(type=decimal(4) updatewhereclause=yes name=prezzo_prezzo dbname="prezzo.prezzo" )
 column=(type=decimal(4) updatewhereclause=yes name=prezzo_prezzo_manifattura dbname="prezzo.prezzo_manifattura" )
 column=(type=char(8) updatewhereclause=yes name=unita_confezione_codice dbname="unita_confezione.codice" )
 column=(type=decimal(2) updatewhereclause=yes name=orafo_titolo_titolo dbname="orafo_titolo.titolo" )
 column=(type=char(4) updatewhereclause=yes name=orafo_colore_codice dbname="orafo_colore.codice" )
 column=(type=char(2) updatewhereclause=yes name=orafo_metallo_codice dbname="orafo_metallo.codice" )
 column=(type=datetime updatewhereclause=yes name=orafo_metallo_data_quotazione dbname="orafo_metallo.data_quotazione" )
 column=(type=char(40) updatewhereclause=yes name=orafo_metallo_descrizione dbname="orafo_metallo.descrizione" )
 column=(type=decimal(2) updatewhereclause=yes name=articolo_coef_calo dbname="articolo.coef_calo" )
 column=(type=char(40) updatewhereclause=yes name=anagrafica_rag_soc_1 dbname="anagrafica.rag_soc_1" )
 column=(type=char(40) updatewhereclause=yes name=sog_commerciale_gen_rag_soc_1 dbname="sog_commerciale_gen.rag_soc_1" )
 column=(type=long updatewhereclause=yes name=cat_codifica_id_cat_codifica dbname="cat_codifica.id_cat_codifica" )
 column=(type=long updatewhereclause=yes name=cat_com_articolo_id_cat_com_articolo dbname="cat_com_articolo.id_cat_com_articolo" )
 column=(type=long updatewhereclause=yes name=cat_fiscale_id_cat_fiscale dbname="cat_fiscale.id_cat_fiscale" )
 column=(type=long updatewhereclause=yes name=cat_merceologica_id_cat_merceologica dbname="cat_merceologica.id_cat_merceologica" )
 column=(type=long updatewhereclause=yes name=orafo_metallo_id_metallo dbname="orafo_metallo.id_metallo" )
 column=(type=long updatewhereclause=yes name=orafo_titolo_id_titolo dbname="orafo_titolo.id_titolo" )
 column=(type=long updatewhereclause=yes name=anagrafica_id_anagrafica dbname="anagrafica.id_anagrafica" )
 column=(type=long updatewhereclause=yes name=anagrafica_id_valuta dbname="anagrafica.id_valuta" )
 column=(type=long updatewhereclause=yes name=sog_commerciale_gen_id_sog_commerciale dbname="sog_commerciale_gen.id_sog_commerciale" )
 column=(type=decimal(4) updatewhereclause=yes name=unita_confezione_peso_non_prezioso dbname="unita_confezione.peso_non_prezioso" )
 column=(type=decimal(4) updatewhereclause=yes name=unita_confezione_peso_netto dbname="unita_confezione.peso_netto" )
 column=(type=decimal(4) updatewhereclause=yes name=unita_confezione_dim_l dbname="unita_confezione.dim_l" )
 column=(type=long updatewhereclause=yes name=prezzo_id_variazione dbname="prezzo.id_variazione" )
 column=(type=decimal(4) updatewhereclause=yes name=orafo_metallo_quotazione dbname="orafo_metallo.quotazione" )
 column=(type=char(40) updatewhereclause=yes name=orafo_colore_descrizione dbname="orafo_colore.descrizione" )
 column=(type=char(32766) updatewhereclause=yes name=note dbname="distinta.note" )
 column=(type=long updatewhereclause=yes name=id_distinta dbname="distinta.id_distinta" )
 column=(type=char(32) updatewhereclause=yes name=codice dbname="distinta.codice" )
 column=(type=long updatewhereclause=yes name=id_articolo dbname="distinta.id_articolo" )
 column=(type=datetime updatewhereclause=yes name=data_ora_creazione dbname="distinta.data_ora_creazione" )
 column=(type=datetime updatewhereclause=yes name=data_ora_ult_cambiamento dbname="distinta.data_ora_ult_cambiamento" )
 column=(type=char(1) updatewhereclause=yes name=tipo_applicazione dbname="distinta.tipo_applicazione" )
 column=(type=long updatewhereclause=yes name=id_azienda dbname="distinta.id_azienda" )
 retrieve="    SELECT  distinct ~"articolo~".~"id_articolo~",   
         ~"articolo~".~"codice~",
			cast('' as char(255))as note_art,   
         ~"articolo~".~"descrizione~",   
         ~"articolo~".~"immagine~",   
         ~"cat_codifica~".~"codice~",   
         ~"cat_com_articolo~".~"codice~",   
         ~"cat_fiscale~".~"codice~",   
         ~"cat_merceologica~".~"codice~",   
         ~"prezzo~".~"prezzo~",  
 			~"prezzo~".~"prezzo_manifattura~",  
         ~"unita_confezione~".~"codice~",   
         ~"orafo_titolo~".~"titolo~",   
         ~"orafo_colore~".~"codice~",   
         ~"orafo_metallo~".~"codice~",   
         ~"orafo_metallo~".~"data_quotazione~",   
         ~"orafo_metallo~".~"descrizione~",   
         ~"articolo~".~"coef_calo~",   
         ~"anagrafica~".~"rag_soc_1~",   
         ~"sog_commerciale_gen~".~"rag_soc_1~",   
         ~"cat_codifica~".~"id_cat_codifica~",   
         ~"cat_com_articolo~".~"id_cat_com_articolo~",   
         ~"cat_fiscale~".~"id_cat_fiscale~",   
         ~"cat_merceologica~".~"id_cat_merceologica~",   
         ~"orafo_metallo~".~"id_metallo~",   
         ~"orafo_titolo~".~"id_titolo~",   
         ~"anagrafica~".~"id_anagrafica~", 
			~"anagrafica~".~"id_valuta~",  
         ~"sog_commerciale_gen~".~"id_sog_commerciale~",   
         ~"unita_confezione~".~"peso_non_prezioso~",   
         ~"unita_confezione~".~"peso_netto~",
         ~"unita_confezione~".~"dim_l~",
         ~"prezzo~".~"id_variazione~",   
         ~"orafo_metallo~".~"quotazione~",   
         ~"orafo_colore~".~"descrizione~",   
         ~"distinta~".~"note~",   
         ~"distinta~".~"id_distinta~",   
         ~"distinta~".~"codice~",   
         ~"distinta~".~"id_articolo~",   
         ~"distinta~".~"data_ora_creazione~",   
         ~"distinta~".~"data_ora_ult_cambiamento~",   
         ~"distinta~".~"tipo_applicazione~",   
         ~"distinta~".~"id_azienda~"  
    FROM    articolo, prezzo, unita_confezione,
			 listino, variazione, cat_codifica, cat_com_articolo, orafo_titolo,
			orafo_metallo, cat_fiscale, cat_merceologica, orafo_colore,
anagrafica, sog_commerciale_gen, distinta
   WHERE ( ~"articolo~".~"stampa_in_catalogo~" = 'S' ) AND
			( ~"unita_confezione~".~"unita_base~" = 'S' ) AND
			(unita_confezione.id_articolo=articolo.id_articolo) and 
			(~"variazione~".~"id_variazione~"=:ra_id_var) and
			(articolo.id_articolo=:rn_id_articolo) and 
			(listino.id_listino=variazione.id_listino) and 
			(prezzo.id_unita_confezione=unita_confezione.id_unita_confezione) and 
			(prezzo.id_variazione=variazione.id_variazione) and 	 
			(articolo.id_cat_codifica=cat_codifica.id_cat_codifica) and  
    	   (articolo.id_cat_com_articolo=cat_com_articolo.id_cat_com_articolo) and 
			(articolo.id_titolo=orafo_titolo.id_titolo) and
			(orafo_metallo.id_metallo=orafo_titolo.id_metallo) and 
			(articolo.id_cat_fiscale*=cat_fiscale.id_cat_fiscale) and 
			(articolo.id_cat_merceologica*=cat_merceologica.id_cat_merceologica) and
			(articolo.id_colore*=orafo_colore.id_colore) and 
			(articolo.id_anagrafica*=anagrafica.id_anagrafica) and
			(anagrafica.id_anagrafica*=sog_commerciale_gen.id_anagrafica) and
			(articolo.id_articolo*=distinta.id_articolo)
	  
    
" arguments=(("rn_id_articolo", number),("ra_id_var", number))  sort="articolo_codice A " )
