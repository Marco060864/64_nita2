table(column=(type=long update=yes updatewhereclause=yes key=yes identity=yes name=con_lis_articolo_id_con_lis_articolo dbname="con_lis_articolo.id_con_lis_articolo" )
 column=(type=long update=yes updatewhereclause=yes name=id_sog_commerciale dbname="con_lis_articolo.id_sog_commerciale" )
 column=(type=char(1) update=yes updatewhereclause=yes name=con_lis_articolo_applicazione dbname="con_lis_articolo.applicazione" values="Acquisti	A/Vendite	V/" validation=" gettext()  = 'A' OR  gettext()  = 'V'" validationmsg="'Immettere: A, V'" )
 column=(type=long update=yes updatewhereclause=yes name=con_lis_articolo_id_articolo dbname="con_lis_articolo.id_articolo" )
 column=(type=date update=yes updatewhereclause=yes name=con_lis_articolo_data_inizio dbname="con_lis_articolo.data_inizio" )
 column=(type=long update=yes updatewhereclause=yes name=con_lis_articolo_id_valuta dbname="con_lis_articolo.id_valuta" )
 column=(type=char(40) update=yes updatewhereclause=yes name=con_lis_articolo_percentuali dbname="con_lis_articolo.percentuali" )
 column=(type=long update=yes updatewhereclause=yes name=con_lis_articolo_id_azienda dbname="con_lis_articolo.id_azienda" initial="1" )
 column=(type=decimal(0) update=yes updatewhereclause=yes name=con_lis_articolo_importo dbname="con_lis_articolo.importo" )
 column=(type=char(1) update=yes updatewhereclause=yes name=con_lis_articolo_tipo_applicazione dbname="con_lis_articolo.tipo_applicazione" initial="S" values="Applicazione sconto	S/Variazione fissa del prezzo	V/Variazione percentuale del prezzo	P/Applicazione sconto riga	R/Imposizione prezzo netto	N/" validation=" gettext()  = 'S' OR  gettext()  = 'V' OR  gettext()  = 'P' OR  gettext()  = 'R' OR  gettext()  = 'N'" validationmsg="'Immettere: S, V, P, R o N'" )
 column=(type=char(20) updatewhereclause=yes name=articolo_codice dbname="articolo.codice" )
 column=(type=char(80) updatewhereclause=yes name=articolo_descrizione dbname="articolo.descrizione" )
 column=(type=decimal(4) update=yes updatewhereclause=yes name=con_lis_articolo_cambio dbname="con_lis_articolo.cambio" validation=" real(gettext())  >= 0" validationmsg="'Immettere un valore >= 0'" )
 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"con_lis_articolo~" )  TABLE(NAME=~"articolo~" ) COLUMN(NAME=~"con_lis_articolo.id_con_lis_articolo~") COLUMN(NAME=~"con_lis_articolo.id_sog_commerciale~") COLUMN(NAME=~"con_lis_articolo.applicazione~") COLUMN(NAME=~"con_lis_articolo.id_articolo~") COLUMN(NAME=~"con_lis_articolo.data_inizio~") COLUMN(NAME=~"con_lis_articolo.id_valuta~") COLUMN(NAME=~"con_lis_articolo.percentuali~") COLUMN(NAME=~"con_lis_articolo.id_azienda~") COLUMN(NAME=~"con_lis_articolo.importo~") COLUMN(NAME=~"con_lis_articolo.tipo_applicazione~") COLUMN(NAME=~"articolo.codice~") COLUMN(NAME=~"articolo.descrizione~") COLUMN(NAME=~"con_lis_articolo.cambio~")    JOIN (LEFT=~"articolo.id_articolo~"    OP =~"=~"RIGHT=~"con_lis_articolo.id_articolo~" )WHERE(    EXP1 =~"~~~"con_lis_articolo~~~".~~~"id_sog_commerciale~~~"~"   OP =~"=~"    EXP2 =~":ra_id_sog_commerciale~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"con_lis_articolo~~~".~~~"id_azienda~~~"~"   OP =~"=~"    EXP2 =~"1~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"con_lis_articolo~~~".~~~"id_cat_com_articolo~~~"~"   OP =~"is~"    EXP2 =~"null~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"con_lis_articolo~~~".~~~"id_unita_confezione~~~"~"   OP =~"is~"    EXP2 =~"null~" ) ) ARG(NAME = ~"ra_id_sog_commerciale~" TYPE = number) " update="con_lis_articolo" updatewhere=1 updatekeyinplace=yes arguments=(("ra_id_sog_commerciale", number)) )
