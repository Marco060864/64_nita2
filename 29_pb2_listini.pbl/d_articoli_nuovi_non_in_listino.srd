table(column=(type=long updatewhereclause=yes identity=yes name=articolo_id_articolo dbname="articolo.id_articolo" )
 column=(type=char(32) updatewhereclause=yes name=articolo_codice dbname="articolo.codice" )
 column=(type=datetime updatewhereclause=yes name=articolo_data_ora_creazione dbname="articolo.data_ora_creazione" )
 column=(type=long updatewhereclause=yes identity=yes name=id_unita_confezione dbname="unita_confezione.id_unita_confezione" )
 column=(type=decimal(6) updatewhereclause=yes name=c_prezzo_partenza dbname="c_prezzo_partenza" )
 column=(type=decimal(6) updatewhereclause=yes name=c_prezzo_destinazione dbname="c_prezzo_destinazione" )
 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"articolo~" )  TABLE(NAME=~"unita_confezione~" ) COLUMN(NAME=~"articolo.id_articolo~") COLUMN(NAME=~"articolo.codice~") COLUMN(NAME=~"articolo.data_ora_creazione~") COLUMN(NAME=~"unita_confezione.id_unita_confezione~") COMPUTE(NAME=~"(select prezzo from prezzo  where id_unita_confezione=~~~"unita_confezione~~~".~~~"id_unita_confezione~~~"  and id_variazione= :id_variazione_partenza) as c_prezzo_partenza~") COMPUTE(NAME=~"(select prezzo from prezzo  where id_unita_confezione=~~~"unita_confezione~~~".~~~"id_unita_confezione~~~"  and id_variazione= :id_variazione) as c_prezzo_destinazione~")    JOIN (LEFT=~"unita_confezione.id_articolo~"    OP =~"=~"RIGHT=~"articolo.id_articolo~" )WHERE(    EXP1 =~"~~~"unita_confezione~~~".~~~"id_unita_confezione~~~"~"   OP =~"not in~"    EXP2 =~"select id_unita_confezione from prezzo where id_unita_confezione=~~~"unita_confezione~~~".~~~"id_unita_confezione~~~" and id_variazione=:id_variazione~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"articolo~~~".~~~"data_ora_creazione~~~"~"   OP =~"<=~"    EXP2 =~":a_data~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"articolo~~~".~~~"data_ora_creazione~~~"~"   OP =~">=~"    EXP2 =~":da_data~" ) ) ARG(NAME = ~"da_data~" TYPE = date)  ARG(NAME = ~"a_data~" TYPE = date)  ARG(NAME = ~"id_variazione~" TYPE = number)  ARG(NAME = ~"id_variazione_partenza~" TYPE = number) " arguments=(("da_data", date),("a_data", date),("id_variazione", number),("id_variazione_partenza", number))  sort="articolo_codice A " )
