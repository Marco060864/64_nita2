table(column=(type=long update=yes updatewhereclause=yes key=yes identity=yes name=con_lis_articolo_id_con_lis_articolo dbname="con_lis_articolo.id_con_lis_articolo" )
 column=(type=char(1) update=yes updatewhereclause=yes name=con_lis_articolo_applicazione dbname="con_lis_articolo.applicazione" values="Acquisti	A/Vendite	V/" validation=" gettext()  = 'A' OR  gettext()  = 'V'" validationmsg="'Immettere: A, V'" )
 column=(type=long update=yes updatewhereclause=yes name=con_lis_articolo_id_sog_commerciale dbname="con_lis_articolo.id_sog_commerciale" )
 column=(type=char(8) updatewhereclause=yes name=sog_commerciale_gen_codice dbname="sog_commerciale_gen.codice" )
 column=(type=char(40) updatewhereclause=yes name=sog_commerciale_gen_rag_soc_1 dbname="sog_commerciale_gen.rag_soc_1" )
 column=(type=long update=yes updatewhereclause=yes name=con_lis_articolo_id_articolo dbname="con_lis_articolo.id_articolo" )
 column=(type=char(20) updatewhereclause=yes name=articolo_codice dbname="articolo.codice" )
 column=(type=char(80) updatewhereclause=yes name=articolo_descrizione dbname="articolo.descrizione" )
 column=(type=long update=yes updatewhereclause=yes name=con_lis_articolo_id_cat_com_articolo dbname="con_lis_articolo.id_cat_com_articolo" )
 column=(type=long update=yes updatewhereclause=yes name=con_lis_articolo_id_listino_des dbname="con_lis_articolo.id_listino" )
