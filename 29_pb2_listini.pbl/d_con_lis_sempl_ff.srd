 column=(type=date update=yes updatewhereclause=yes name=con_lis_articolo_data_fine dbname="con_lis_articolo.data_fine" )
 column=(type=decimal(4) update=yes updatewhereclause=yes name=con_lis_articolo_qta_minima dbname="con_lis_articolo.qta_minima" initial="0" )
 column=(type=decimal(4) update=yes updatewhereclause=yes name=con_lis_articolo_qta_massima dbname="con_lis_articolo.qta_massima" initial="0" validationmsg="'Quantità minima maggiore di quantità massima'" )
 column=(type=char(1) update=yes updatewhereclause=yes name=con_lis_articolo_tipo_applicazione dbname="con_lis_articolo.tipo_applicazione" initial="S" values="Applicazione sconto	S/Variazione fissa del prezzo	V/Variazione percentuale del prezzo	P/Applicazione di uno sconto riga	R/Imposizione del prezzo netto	N/" validation=" gettext()  = 'S' OR  gettext()  = 'V' OR  gettext()  = 'P' OR  gettext()  = 'R' OR  gettext()  = 'N'" validationmsg="'Immettere: S, V, P, R o N'" )
 column=(type=long update=yes updatewhereclause=yes name=con_lis_articolo_id_valuta_des dbname="con_lis_articolo.id_valuta" )
 column=(type=decimal(4) update=yes updatewhereclause=yes name=con_lis_articolo_cambio dbname="con_lis_articolo.cambio" validation=" real(gettext())  >= 0" validationmsg="'Immettere un valore >= 0'" )
 column=(type=decimal(0) update=yes updatewhereclause=yes name=con_lis_articolo_importo dbname="con_lis_articolo.importo" )
 column=(type=char(40) update=yes updatewhereclause=yes name=con_lis_articolo_percentuali dbname="con_lis_articolo.percentuali" )
 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"con_lis_articolo~" )  TABLE(NAME=~"sog_commerciale_gen~" )  TABLE(NAME=~"articolo~" )  TABLE(NAME=~"cat_com_articolo~" ) COLUMN(NAME=~"con_lis_articolo.id_con_lis_articolo~") COLUMN(NAME=~"con_lis_articolo.applicazione~") COLUMN(NAME=~"con_lis_articolo.id_sog_commerciale~") COLUMN(NAME=~"sog_commerciale_gen.codice~") COLUMN(NAME=~"sog_commerciale_gen.rag_soc_1~") COLUMN(NAME=~"con_lis_articolo.id_articolo~") COLUMN(NAME=~"articolo.codice~") COLUMN(NAME=~"articolo.descrizione~") COLUMN(NAME=~"con_lis_articolo.id_cat_com_articolo~") COLUMN(NAME=~"con_lis_articolo.id_listino~") COLUMN(NAME=~"con_lis_articolo.data_inizio~") COLUMN(NAME=~"con_lis_articolo.data_fine~") COLUMN(NAME=~"con_lis_articolo.qta_minima~") COLUMN(NAME=~"con_lis_articolo.qta_massima~") COLUMN(NAME=~"con_lis_articolo.tipo_applicazione~") COLUMN(NAME=~"con_lis_articolo.id_valuta~") COLUMN(NAME=~"con_lis_articolo.cambio~") COLUMN(NAME=~"con_lis_articolo.importo~") COLUMN(NAME=~"con_lis_articolo.percentuali~")    JOIN (LEFT=~"articolo.id_articolo~"    OP =~"=~"RIGHT=~"con_lis_articolo.id_articolo~"    OUTER2 =~"con_lis_articolo.id_articolo~" )    JOIN (LEFT=~"cat_com_articolo.id_cat_com_articolo~"    OP =~"=~"RIGHT=~"con_lis_articolo.id_cat_com_articolo~"    OUTER2 =~"con_lis_articolo.id_cat_com_articolo~" )   JOIN (LEFT=~"con_lis_articolo.id_sog_commerciale~"    OP =~"=~"RIGHT=~"sog_commerciale_gen.id_sog_commerciale~" ) ) " update="con_lis_articolo" updatewhere=1 updatekeyinplace=yes )
