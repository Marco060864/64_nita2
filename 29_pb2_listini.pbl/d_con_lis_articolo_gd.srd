 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"con_lis_articolo~" )  TABLE(NAME=~"unita_confezione~" )  TABLE(NAME=~"anagrafica~" ALIAS=~"anagrafica_a~" )  TABLE(NAME=~"sog_commerciale~" ALIAS=~"sog_commerciale_a~" )  TABLE(NAME=~"anagrafica~" ALIAS=~"anagrafica_b~" )  TABLE(NAME=~"sog_commerciale~" ALIAS=~"sog_commerciale_b~" )  TABLE(NAME=~"articolo~" ALIAS=~"articolo_a~" )  TABLE(NAME=~"articolo~" ALIAS=~"articolo_b~" )  TABLE(NAME=~"valuta~" )  TABLE(NAME=~"listino~" )  TABLE(NAME=~"anagrafica~" ALIAS=~"anagrafica_c~" )  TABLE(NAME=~"destinazione~" )  TABLE(NAME=~"sog_commerciale_gen~" ) COLUMN(NAME=~"con_lis_articolo.id_con_lis_articolo~") COLUMN(NAME=~"con_lis_articolo.applicazione~") COLUMN(NAME=~"unita_confezione.codice~") COLUMN(NAME=~"unita_confezione.descrizione~") COLUMN(NAME=~"sog_commerciale_a.codice~") COLUMN(NAME=~"anagrafica_a.rag_soc_1~") COLUMN(NAME=~"articolo_a.codice~") COLUMN(NAME=~"articolo_a.descrizione~") COLUMN(NAME=~"articolo_b.codice~") COLUMN(NAME=~"articolo_b.descrizione~") COLUMN(NAME=~"sog_commerciale_b.codice~") COLUMN(NAME=~"anagrafica_b.rag_soc_1~") COLUMN(NAME=~"con_lis_articolo.tipo_applicazione~") COLUMN(NAME=~"con_lis_articolo.cambio~") COLUMN(NAME=~"valuta.codice~") COLUMN(NAME=~"valuta.descrizione~") COLUMN(NAME=~"con_lis_articolo.percentuali~") COLUMN(NAME=~"con_lis_articolo.spesa~") COLUMN(NAME=~"con_lis_articolo.spesa_fissa~") COLUMN(NAME=~"con_lis_articolo.data_inizio~") COLUMN(NAME=~"con_lis_articolo.data_fine~") COLUMN(NAME=~"con_lis_articolo.qta_minima~") COLUMN(NAME=~"con_lis_articolo.qta_massima~") COLUMN(NAME=~"con_lis_articolo.id_cat_com_articolo~") COLUMN(NAME=~"con_lis_articolo.id_cat_com_sc~") COLUMN(NAME=~"con_lis_articolo.priorita~") COLUMN(NAME=~"listino.codice~") COLUMN(NAME=~"listino.descrizione~") COLUMN(NAME=~"anagrafica_c.rag_soc_1~") COMPUTE(NAME=~"CAST(( ~~~"sog_commerciale_gen~~~".~~~"rag_soc_1~~~" || ' - ' || ~~~"destinazione~~~".~~~"rag_soc_1~~~" || ' - ' ||  ~~~"destinazione~~~".~~~"indirizzo~~~") AS CHAR(40)) AS c_destinazione_des~") COLUMN(NAME=~"con_lis_articolo.id_sog_commerciale~") COLUMN(NAME=~"con_lis_articolo.importo~") COLUMN(NAME=~"con_lis_articolo.id_valuta~")    JOIN (LEFT=~"unita_confezione.id_unita_confezione~"    OP =~"=~"RIGHT=~"con_lis_articolo.id_unita_confezione~"    OUTER2 =~"con_lis_articolo.id_unita_confezione~" )    JOIN (LEFT=~"sog_commerciale_a.id_sog_commerciale~"    OP =~"=~"RIGHT=~"con_lis_articolo.id_sog_commerciale~"    OUTER2 =~"con_lis_articolo.id_sog_commerciale~" )    JOIN (LEFT=~"anagrafica_a.id_anagrafica~"    OP =~"=~"RIGHT=~"sog_commerciale_a.id_anagrafica~"    OUTER2 =~"sog_commerciale_a.id_anagrafica~" )    JOIN (LEFT=~"anagrafica_b.id_anagrafica~"    OP =~"=~"RIGHT=~"sog_commerciale_b.id_anagrafica~"    OUTER2 =~"sog_commerciale_b.id_anagrafica~" )    JOIN (LEFT=~"sog_commerciale_b.id_sog_commerciale~"    OP =~"=~"RIGHT=~"con_lis_articolo.id_sog_commerciale_fornitore~"    OUTER2 =~"con_lis_articolo.id_sog_commerciale_fornitore~" )    JOIN (LEFT=~"articolo_a.id_articolo~"    OP =~"=~"RIGHT=~"con_lis_articolo.id_art_da~"    OUTER2 =~"con_lis_articolo.id_art_da~" )    JOIN (LEFT=~"articolo_b.id_articolo~"    OP =~"=~"RIGHT=~"con_lis_articolo.id_art_a~"    OUTER2 =~"con_lis_articolo.id_art_a~" )    JOIN (LEFT=~"valuta.id_valuta~"    OP =~"=~"RIGHT=~"con_lis_articolo.id_valuta~"    OUTER2 =~"con_lis_articolo.id_valuta~" )    JOIN (LEFT=~"listino.id_listino~"    OP =~"=~"RIGHT=~"con_lis_articolo.id_listino~"    OUTER2 =~"con_lis_articolo.id_listino~" )    JOIN (LEFT=~"anagrafica_c.id_anagrafica~"    OP =~"=~"RIGHT=~"con_lis_articolo.id_anagrafica~"    OUTER2 =~"con_lis_articolo.id_anagrafica~" )    JOIN (LEFT=~"destinazione.id_destinazione~"    OP =~"=~"RIGHT=~"con_lis_articolo.id_destinazione~"    OUTER2 =~"con_lis_articolo.id_destinazione~" )    JOIN (LEFT=~"sog_commerciale_gen.id_sog_commerciale~"    OP =~"=~"RIGHT=~"destinazione.id_sog_commerciale~"    OUTER2 =~"destinazione.id_sog_commerciale~" )) " )
