release 9;
datawindow(units=0 timer_interval=0 color=16777215 processing=0 HTMLDW=no print.printername="" print.documentname="" print.orientation = 0 print.margin.left = 110 print.margin.right = 110 print.margin.top = 96 print.margin.bottom = 96 print.paper.source = 0 print.paper.size = 0 print.canusedefaultprinter=yes print.prompt=no print.buttons=no print.preview.buttons=no print.cliptext=no print.overrideprintjob=no print.collate=yes hidegrayline=no )
header(height=333 color="536870912" )
summary(height=0 color="536870912" )
footer(height=58 color="536870912" )
detail(height=70 color="536870912" )
table(column=(type=char(32) updatewhereclause=yes name=articolo_codice dbname="articolo.codice" )
 column=(type=char(40) updatewhereclause=yes name=articolo_des_breve dbname="articolo.des_breve" )
 column=(type=char(5) updatewhereclause=yes name=unita_misura_simbolo dbname="unita_misura.simbolo" )
 column=(type=decimal(6) updatewhereclause=yes name=prezzo dbname="prezzo" )
 column=(type=char(40) updatewhereclause=yes name=valuta dbname="valuta" )
 column=(type=long updatewhereclause=yes name=id_valuta dbname="id_valuta" )
 column=(type=char(8) updatewhereclause=yes name=cat_com_articolo_codice dbname="cat_com_articolo.codice" )
 column=(type=char(8) updatewhereclause=yes name=cat_merceologica_codice dbname="cat_merceologica.codice" )
 column=(type=char(8) updatewhereclause=yes name=cat_fiscale_codice dbname="cat_fiscale.codice" )
 column=(type=decimal(4) updatewhereclause=yes name=unita_confezione_peso_netto dbname="unita_confezione.peso_netto" )
 column=(type=decimal(4) updatewhereclause=yes name=unita_confezione_dim_l dbname="unita_confezione.dim_l" )
 column=(type=char(1) updatewhereclause=yes name=articolo_prod_interna dbname="articolo.prod_interna" )
 column=(type=decimal(6) updatewhereclause=yes name=prezzo_manifattura dbname="prezzo_manifattura" )
 column=(type=char(1) updatewhereclause=yes name=unita_misura_tipo dbname="unita_misura.tipo" )
 column=(type=char(40) updatewhereclause=yes name=azienda_rag_soc_2 dbname="azienda.rag_soc_2" )
 column=(type=decimal(2) updatewhereclause=yes name=articolo_coef_calo dbname="articolo.coef_calo" )
 column=(type=char(40) updatewhereclause=yes name=des_listino dbname="des_listino" )
 column=(type=real updatewhereclause=yes name=coef_calo dbname="coef_calo" )
 column=(type=decimal(6) updatewhereclause=yes name=galvanica dbname="galvanica" )
 column=(type=long updatewhereclause=yes name=articolo_id_cat_codifica dbname="articolo.id_cat_codifica" )
 column=(type=char(80) updatewhereclause=yes name=articolo_descrizione dbname="articolo.descrizione" )
 column=(type=long updatewhereclause=yes identity=yes name=id_unita_confezione dbname="unita_confezione.id_unita_confezione" )
 column=(type=char(40) updatewhereclause=yes name=azienda_rag_soc_1 dbname="azienda.rag_soc_1" )
 column=(type=char(40) updatewhereclause=yes name=azienda_rag_soc_2 dbname="azienda.rag_soc_2" )
 column=(type=char(16) updatewhereclause=yes name=azienda_par_iva dbname="azienda.par_iva" )
 column=(type=char(40) updatewhereclause=yes name=sede_indirizzo dbname="sede.indirizzo" )
 column=(type=char(10) updatewhereclause=yes name=sede_cap dbname="sede.cap" )
 column=(type=char(40) updatewhereclause=yes name=sede_localita dbname="sede.localita" )
 column=(type=char(5) updatewhereclause=yes name=sede_provincia dbname="sede.provincia" )
 retrieve="SELECT ~"articolo~".~"codice~",   
         ~"articolo~".~"des_breve~",   
         ~"unita_misura~".~"simbolo~",   
         CAST((SELECT ~"prezzo~" FROM ~"prezzo~" 
WHERE ~"id_variazione~" = :rl_id_variazione AND
 ~"id_unita_confezione~" = ~"unita_confezione~".~"id_unita_confezione~") 
AS decimal(20,6)) AS prezzo,   
         CAST((SELECT ~"valuta~".~"descrizione~" 
FROM ~"valuta~" WHERE  ~"valuta~".~"id_valuta~" =:ra_id_valuta) AS CHAR) AS Valuta,   
          CAST((SELECT ~"valuta~".~"id_valuta~" 
FROM ~"valuta~", ~"variazione~", ~"listino~" WHERE
 ~"variazione~".~"id_variazione~" = :rl_id_variazione
AND ~"listino~".~"id_listino~" = ~"variazione~".~"id_listino~" 
AND ~"valuta~".~"id_valuta~" = ~"listino~".~"id_valuta~") AS integer) AS id_valuta,  
         ~"cat_com_articolo~".~"codice~",   
         ~"cat_merceologica~".~"codice~",   
         ~"cat_fiscale~".~"codice~",   
         ~"unita_confezione~".~"peso_netto~",   
         ~"unita_confezione~".~"dim_l~",   
         ~"articolo~".~"prod_interna~",   
         CAST((SELECT ~"prezzo_manifattura~" FROM ~"prezzo~" 
WHERE ~"id_variazione~" = :rl_id_variazione AND
 ~"id_unita_confezione~" = ~"unita_confezione~".~"id_unita_confezione~")
 AS decimal(20,6)) AS prezzo_manifattura,   
         ~"unita_misura~".~"tipo~",   
         ~"azienda~".~"rag_soc_2~",   
         ~"articolo~".~"coef_calo~",   
         CAST((SELECT ~"listino~".~"descrizione~" FROM ~"listino~", ~"variazione~"
 WHERE ~"variazione~".~"id_variazione~" = :rl_id_variazione
and ~"listino~".~"id_listino~"=~"variazione~".~"id_listino~") as char(40) )as des_listino,
CAST((SELECT ~"coef_calo~" FROM ~"prezzo~" 
WHERE ~"id_variazione~" = :rl_id_variazione 
AND ~"id_unita_confezione~" = ~"unita_confezione~".~"id_unita_confezione~") 
AS FLOAT(4)) AS coef_calo,
CAST((SELECT ~"galvanica~" FROM ~"prezzo~" 
WHERE ~"id_variazione~" = :rl_id_variazione AND
 ~"id_unita_confezione~" = ~"unita_confezione~".~"id_unita_confezione~") 
AS decimal(20,6)) AS galvanica,
articolo.id_cat_codifica , articolo.descrizione, unita_confezione.id_unita_confezione,
azienda.rag_soc_1,  azienda.rag_soc_2,   azienda.par_iva, sede.indirizzo, 
sede.cap, sede.localita, sede.provincia
FROM {oj ~"unita_confezione~"  LEFT OUTER JOIN ~"unita_misura~" 
 ON ~"unita_confezione~".~"id_unita_misura~" = ~"unita_misura~".~"id_unita_misura~"}, 
{oj ~"articolo~"  LEFT OUTER JOIN ~"cat_merceologica~" 
 ON ~"articolo~".~"id_cat_merceologica~" = ~"cat_merceologica~".~"id_cat_merceologica~"},
 {oj ~"articolo~"  LEFT OUTER JOIN ~"cat_fiscale~" 
 ON ~"articolo~".~"id_cat_fiscale~" = ~"cat_fiscale~".~"id_cat_fiscale~"}, {oj ~"articolo~"  
LEFT OUTER JOIN ~"unita_confezione~"  
ON ~"articolo~".~"id_articolo~" = ~"unita_confezione~".~"id_articolo~"},   
         ~"cat_com_articolo~",   
         ~"azienda~", ~"sede~"  
   WHERE ( ~"cat_com_articolo~".~"id_cat_com_articolo~" =
 ~"articolo~".~"id_cat_com_articolo~" ) and  
         ( ~"azienda~".~"id_azienda~" = ~"unita_confezione~".~"id_azienda~" ) and 
			(  ~"azienda~".~"id_azienda~"=~"sede~".~"id_azienda~") and
         ( ( ~"articolo~".~"codice~" >= :rs_da_codice ) AND  
         ( ~"articolo~".~"codice~" <= :rs_a_codice ) )  
" arguments=(("rl_id_variazione", number),("rs_da_codice", string),("rs_a_codice", string),("ra_id_valuta", number),("ra_cambio", number),("num_dec_arr", number),("tipo_arr", string))  sort="articolo_codice A " )
