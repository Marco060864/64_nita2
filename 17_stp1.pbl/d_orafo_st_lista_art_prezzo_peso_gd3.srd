when -6 then ~"#,0.000000~"
)" html.valueishtml="0"  name=prezzo_valuta visible="1"  font.face="Arial" font.height="-8" font.weight="400"  font.family="2" font.pitch="2" font.charset="0" background.mode="1" background.color="536870912" )
