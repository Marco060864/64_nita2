table(column=(type=char(32) updatewhereclause=yes name=codice dbname="prezzo.codice" )
 column=(type=char(40) updatewhereclause=yes name=des_breve dbname="prezzo.des_breve" )
 column=(type=char(5) updatewhereclause=yes name=simbolo dbname="prezzo.simbolo" )
 column=(type=decimal(6) updatewhereclause=yes name=cprezzo dbname="prezzo" )
 column=(type=char(40) updatewhereclause=yes name=valuta dbname="valuta" )
 column=(type=long updatewhereclause=yes name=id_valuta dbname="id_valuta" )
 column=(type=char(255) updatewhereclause=yes name=parametri dbname="parametri" )
 column=(type=char(32) updatewhereclause=yes name=da_articolo dbname="da_articolo" )
 column=(type=char(32) updatewhereclause=yes name=a_articolo dbname="a_articolo" )
 column=(type=char(8) updatewhereclause=yes name=cat_com_articolo_codice dbname="prezzo.codice" )
 column=(type=char(8) updatewhereclause=yes name=cat_merceologica_codice dbname="prezzo.codice" )
 column=(type=char(8) updatewhereclause=yes name=cat_fiscale_codice dbname="prezzo.codice" )
 column=(type=char(30) updatewhereclause=yes name=ordinamento dbname="ordinamento" values="Articolo	A/Cat. Commerciale	C/Cat. Merceologica	M/Cat. Fiscale	F/" )
 column=(type=decimal(4) updatewhereclause=yes name=peso_netto dbname="prezzo.peso_netto" )
 column=(type=decimal(4) updatewhereclause=yes name=dim_l dbname="prezzo.dim_l" )
 column=(type=char(1) updatewhereclause=yes name=prod_interna dbname="prezzo.prod_interna" )
 column=(type=char(32) updatewhereclause=yes name=codice dbname="prezzo.codice" )
 column=(type=decimal(2) updatewhereclause=yes name=per_aliquota dbname="prezzo.per_aliquota" )
 column=(type=decimal(6) updatewhereclause=yes name=prezzo_manifattura dbname="prezzo_manifattura" )
 column=(type=real updatewhereclause=yes name=coef_calo dbname="coef_calo" )
 column=(type=char(40) updatewhereclause=yes name=lis_descrizione dbname="lis_descrizione" )
 retrieve="  SELECT ~"articolo~".~"codice~",   
         ~"articolo~".~"des_breve~",   
         ~"unita_misura~".~"simbolo~",   
         CAST((SELECT ~"prezzo~" FROM ~"prezzo~" WHERE ~"id_variazione~" = :rl_id_variazione AND ~"id_unita_confezione~" = ~"unita_confezione~".~"id_unita_confezione~") AS DECIMAL(20,6)) AS prezzo,   
         CAST((SELECT ~"valuta~".~"descrizione~" FROM ~"valuta~" WHERE ~"valuta~".~"id_valuta~" =:id_valuta ) AS CHAR) AS Valuta,   
		CAST((SELECT ~"valuta~".~"id_valuta~" FROM ~"valuta~"  WHERE ~"valuta~".~"id_valuta~" =:id_valuta ) AS integer) AS id_valuta,   
         
CAST (:parametri as char(255)) as parametri,   
         CAST(:rs_da_codice as char(32)) as da_articolo,   
         CAST(:rs_a_codice as char(32)) as a_articolo,   
         ~"cat_com_articolo~".~"codice~",   
         ~"cat_merceologica~".~"codice~",   
         ~"cat_fiscale~".~"codice~",   
         CAST(:ordinamento as char(30)) as ordinamento,   
         ~"unita_confezione~".~"peso_netto~",   
         ~"unita_confezione~".~"dim_l~",   
         ~"articolo~".~"prod_interna~",   
         ~"distinta~".~"codice~",   
         ~"tab_iva~".~"per_aliquota~",   
         CAST((SELECT ~"prezzo_manifattura~" FROM ~"prezzo~" WHERE ~"id_variazione~" = :rl_id_variazione AND ~"id_unita_confezione~" = ~"unita_confezione~".~"id_unita_confezione~") AS DECIMAL(20,6)) AS prezzo_manifattura,   
         CAST((SELECT ~"coef_calo~" FROM ~"prezzo~" WHERE ~"id_variazione~" = :rl_id_variazione AND ~"id_unita_confezione~" = ~"unita_confezione~".~"id_unita_confezione~") AS FLOAT(4)) AS coef_calo,
			CAST((SELECT ~"listino~".~"descrizione~" FROM ~"listino~", ~"variazione~" WHERE ~"listino~".~"id_listino~"=~"variazione~".~"id_listino~" and ~"variazione~".~"id_variazione~" = :rl_id_variazione) as char) as lis_descrizione  
    FROM {oj {oj {oj ~"unita_confezione~"  LEFT OUTER JOIN ~"unita_misura~"  ON ~"unita_confezione~".~"id_unita_misura~" = ~"unita_misura~".~"id_unita_misura~"}, {oj ~"articolo~"  LEFT OUTER JOIN ~"tab_iva~"  ON ~"articolo~".~"id_tab_iva~" = ~"tab_iva~".~"id_tab_iva~"} LEFT OUTER JOIN ~"cat_merceologica~"  ON ~"articolo~".~"id_cat_merceologica~" = ~"cat_merceologica~".~"id_cat_merceologica~"}, {oj ~"articolo~"  LEFT OUTER JOIN ~"cat_fiscale~"  ON ~"articolo~".~"id_cat_fiscale~" = ~"cat_fiscale~".~"id_cat_fiscale~"}, {oj ~"articolo~"  LEFT OUTER JOIN ~"distinta~"  ON ~"articolo~".~"id_articolo~" = ~"distinta~".~"id_articolo~"} LEFT OUTER JOIN ~"unita_confezione~"  ON ~"articolo~".~"id_articolo~" = ~"unita_confezione~".~"id_articolo~"},   
         ~"cat_com_articolo~"  
   WHERE ( ~"cat_com_articolo~".~"id_cat_com_articolo~" = ~"articolo~".~"id_cat_com_articolo~" ) and  
         ( ( ~"articolo~".~"codice~" >= :rs_da_codice ) AND  
         ( ~"articolo~".~"codice~" <= :rs_a_codice ) AND  
         ( ~"unita_confezione~".~"unita_base~" = 'S' ) )    
" arguments=(("rl_id_variazione", number),("rs_da_codice", string),("rs_a_codice", string),("parametri", string),("ordinamento", string),("cifra_arrotondamento", number),("tipo_arrotondamento", string),("id_valuta", number),("cambio", number))  sort="codice A " )
