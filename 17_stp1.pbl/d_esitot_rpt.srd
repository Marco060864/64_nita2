 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"sys.dummy~" ) COMPUTE(NAME=~"CAST(fn_esistenza(:id_esercizio,0,0,:anno,:mese)as char(160)) as Esistenze~") COMPUTE(NAME=~"CAST(SUBSTR(esistenze, 1, 20) AS NUMERIC(18,2)) AS esi_fisica_P~") COMPUTE(NAME=~"CAST(SUBSTR(esistenze, 21, 20) AS NUMERIC(18,2)) AS esi_fiscale_P~") COMPUTE(NAME=~"CAST(SUBSTR(esistenze, 41, 20) AS NUMERIC(18,2)) AS esi_fisica_F~") COMPUTE(NAME=~"CAST(SUBSTR(esistenze, 61, 20) AS NUMERIC(18,2)) AS esi_fiscale_F~") COMPUTE(NAME=~"CAST(SUBSTR(esistenze, 81, 20) AS NUMERIC(18,2)) AS esi_fisica_C~") COMPUTE(NAME=~"CAST(SUBSTR(esistenze, 101, 20) AS NUMERIC(18,2)) AS esi_fiscale_C~") COMPUTE(NAME=~"CAST(SUBSTR(esistenze, 121, 20) AS NUMERIC(18,2)) AS esi_fisica_PN~") COMPUTE(NAME=~"CAST(SUBSTR(esistenze, 141, 20) AS NUMERIC(18,2)) AS esi_fiscale_PN~")) ARG(NAME = ~"id_esercizio~" TYPE = number)  ARG(NAME = ~"anno~" TYPE = number)  ARG(NAME = ~"mese~" TYPE = number)  ARG(NAME = ~"parametri~" TYPE = string)  ARG(NAME = ~"titolo~" TYPE = string) " arguments=(("id_esercizio", number),("anno", number),("mese", number),("parametri", string),("titolo", string)) )
