 column=(type=char(4) updatewhereclause=yes name=tipo_pagamento_codice dbname="tipo_pagamento.codice" )
 column=(type=long updatewhereclause=yes identity=yes name=documento_id_documento dbname="documento.id_documento" )
 column=(type=char(16) updatewhereclause=yes name=documento_num_documento dbname="documento.num_documento" )
 column=(type=date updatewhereclause=yes name=documento_data_documento dbname="documento.data_documento" )
 column=(type=char(40) updatewhereclause=yes name=anagrafica_rag_soc_1 dbname="anagrafica.rag_soc_1" )
 column=(type=decimal(0) updatewhereclause=yes name=reg_pd_num_progressivo dbname="reg_pd.num_progressivo" )
 column=(type=date updatewhereclause=yes name=reg_pd_data_registrazione dbname="reg_pd.data_registrazione" )
 column=(type=char(16) updatewhereclause=yes name=reg_pd_num_documento dbname="reg_pd.num_documento" )
 column=(type=date updatewhereclause=yes name=reg_pd_data_documento dbname="reg_pd.data_documento" )
 column=(type=long updatewhereclause=yes identity=yes name=scadenza_id_scadenza dbname="scadenza.id_scadenza" )
 column=(type=long updatewhereclause=yes name=scadenza_id_documento dbname="scadenza.id_documento" )
 column=(type=char(5) updatewhereclause=yes name=banca_appoggio_cod_abi dbname="banca_appoggio.cod_abi" )
 column=(type=char(40) updatewhereclause=yes name=banca_appoggio_den_abi dbname="banca_appoggio.den_abi" )
 column=(type=decimal(0) updatewhereclause=yes name=segno_reg_iva dbname="reg_pd.segno_reg_iva" )
 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"scadenza~" ALIAS=~"Scadenza~" )  TABLE(NAME=~"DBA.documento~" ALIAS=~"documento~" )  TABLE(NAME=~"par_aperta~" )  TABLE(NAME=~"reg_pd~" )  TABLE(NAME=~"DBA.sog_commerciale~" ALIAS=~"Sog_Commerciale~" )  TABLE(NAME=~"DBA.anagrafica~" ALIAS=~"Anagrafica~" )  TABLE(NAME=~"DBA.tipo_pagamento~" ALIAS=~"Tipo_Pagamento~" )  TABLE(NAME=~"azienda~" )  TABLE(NAME=~"banca_sog_commerciale~" )  TABLE(NAME=~"banca_appoggio~" ) COLUMN(NAME=~"Scadenza.data_scadenza~") COLUMN(NAME=~"Scadenza.importo~") COLUMN(NAME=~"Scadenza.note~") COLUMN(NAME=~"Scadenza.stato_scadenza~") COLUMN(NAME=~"Scadenza.esito_pagamento~") COLUMN(NAME=~"Scadenza.id_riga_distinta_banca~") COLUMN(NAME=~"Scadenza.id_par_aperta~") COLUMN(NAME=~"Sog_Commerciale.codice~") COLUMN(NAME=~"Tipo_Pagamento.codice~") COLUMN(NAME=~"documento.id_documento~") COLUMN(NAME=~"documento.num_documento~") COLUMN(NAME=~"documento.data_documento~") COLUMN(NAME=~"Anagrafica.rag_soc_1~") COLUMN(NAME=~"reg_pd.num_progressivo~") COLUMN(NAME=~"reg_pd.data_registrazione~") COLUMN(NAME=~"reg_pd.num_documento~") COLUMN(NAME=~"reg_pd.data_documento~") COLUMN(NAME=~"Scadenza.id_scadenza~") COLUMN(NAME=~"Scadenza.id_documento~") COLUMN(NAME=~"banca_appoggio.cod_abi~") COLUMN(NAME=~"banca_appoggio.den_abi~") COLUMN(NAME=~"reg_pd.segno_reg_iva~")    JOIN (LEFT=~"Scadenza.id_documento~"    OP =~"=~"RIGHT=~"documento.id_documento~"    OUTER1 =~"Scadenza.id_documento~" )    JOIN (LEFT=~"par_aperta.id_par_aperta~"    OP =~"=~"RIGHT=~"Scadenza.id_par_aperta~"    OUTER2 =~"Scadenza.id_par_aperta~" )    JOIN (LEFT=~"reg_pd.id_reg_pd~"    OP =~"=~"RIGHT=~"par_aperta.id_reg_pd~"    OUTER2 =~"par_aperta.id_reg_pd~" )    JOIN (LEFT=~"banca_sog_commerciale.id_banca_sog_commerciale~"    OP =~"=~"RIGHT=~"Sog_Commerciale.id_banca_sog_commerciale~"    OUTER2 =~"Sog_Commerciale.id_banca_sog_commerciale~" )    JOIN (LEFT=~"banca_appoggio.id_banca_appoggio~"    OP =~"=~"RIGHT=~"banca_sog_commerciale.id_banca_appoggio~"    OUTER2 =~"banca_sog_commerciale.id_banca_appoggio~" )    JOIN (LEFT=~"Scadenza.id_sog_commerciale~"    OP =~"=~"RIGHT=~"Sog_Commerciale.id_sog_commerciale~" )    JOIN (LEFT=~"Sog_Commerciale.id_anagrafica~"    OP =~"=~"RIGHT=~"Anagrafica.id_anagrafica~" )    JOIN (LEFT=~"Scadenza.id_tipo_pagamento~"    OP =~"=~"RIGHT=~"Tipo_Pagamento.id_tipo_pagamento~" )    JOIN (LEFT=~"Scadenza.id_azienda~"    OP =~"=~"RIGHT=~"azienda.id_azienda~" )WHERE(    EXP1 =~"~~~"Scadenza~~~".~~~"data_scadenza~~~"~"   OP =~">=~"    EXP2 =~":da_data~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"Scadenza~~~".~~~"data_scadenza~~~"~"   OP =~"<=~"    EXP2 =~":a_data~" ) ) ORDER(NAME=~"Scadenza.data_scadenza~" ASC=yes )  ORDER(NAME=~"Anagrafica.rag_soc_1~" ASC=yes ) ARG(NAME = ~"da_data~" TYPE = date)  ARG(NAME = ~"a_data~" TYPE = date) " arguments=(("da_data", date),("a_data", date))  sort="scadenza_data_scadenza A tipo_pagamento_codice A anagrafica_rag_soc_1 A " )
