 column=(type=char(1) updatewhereclause=yes name=scadenza_esito_pagamento dbname="scadenza.esito_pagamento" values="EMESSO	E/DISTINTA	D/PAGATO	P/INSOLUTO	I/BLOCCATO	B/" )
