 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"bollettine_excel~" )  TABLE(NAME=~"documento~" )  TABLE(NAME=~"riga_documento~" ) COLUMN(NAME=~"bollettine_excel.cod_barre~") COLUMN(NAME=~"bollettine_excel.pezzi~") COLUMN(NAME=~"bollettine_excel.cliente~") COLUMN(NAME=~"bollettine_excel.num_ordine~") COLUMN(NAME=~"bollettine_excel.articolo~") COLUMN(NAME=~"documento.num_documento~") COLUMN(NAME=~"documento.data_documento~") COLUMN(NAME=~"bollettine_excel.data~")    JOIN (LEFT=~"bollettine_excel.id_riga_documento~"    OP =~"=~"RIGHT=~"riga_documento.id_riga_doc_provenienza~"    OUTER1 =~"bollettine_excel.id_riga_documento~" )    JOIN (LEFT=~"riga_documento.id_documento~"    OP =~"=~"RIGHT=~"documento.id_documento~"    OUTER1 =~"riga_documento.id_documento~" )WHERE(    EXP1 =~"~~~"bollettine_excel~~~".~~~"num_ordine~~~"~"   OP =~"=~"    EXP2 =~":numero_ordine~" ) ) ARG(NAME = ~"numero_ordine~" TYPE = number) " arguments=(("numero_ordine", number)) )
