PBSELECT( VERSION(400) TABLE(NAME="articolo" )  TABLE(NAME="prezzo" )  TABLE(NAME="unita_confezione" ) COLUMN(NAME="articolo.id_articolo") COLUMN(NAME="articolo.codice") COLUMN(NAME="articolo.descrizione") COLUMN(NAME="prezzo.prezzo") COLUMN(NAME="prezzo.prezzo_manifattura") COMPUTE(NAME="0.0000 as c_prezzo")    JOIN (LEFT="unita_confezione.id_unita_confezione"    OP ="="RIGHT="prezzo.id_unita_confezione" )    JOIN (LEFT="unita_confezione.id_articolo"    OP ="="RIGHT="articolo.id_articolo" )WHERE(    EXP1 ="~"prezzo~".~"id_variazione~""   OP ="="    EXP2 =":id_variazione" ) ) ARG(NAME = "id_variazione" TYPE = number) 