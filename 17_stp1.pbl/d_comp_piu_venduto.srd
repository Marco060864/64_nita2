 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"articolo~" ALIAS=~"articolo_a~" )  TABLE(NAME=~"distinta~" )  TABLE(NAME=~"riga_distinta~" )  TABLE(NAME=~"articolo~" ALIAS=~"articolo_b~" )  TABLE(NAME=~"riga_documento~" )  TABLE(NAME=~"documento~" )  TABLE(NAME=~"caus_magazzino~" ) COLUMN(NAME=~"documento.num_progressivo~") COLUMN(NAME=~"documento.num_documento~") COLUMN(NAME=~"documento.data_documento~") COLUMN(NAME=~"riga_documento.quantita~") COLUMN(NAME=~"riga_documento.prezzo_netto~") COLUMN(NAME=~"riga_documento.prezzo~") COLUMN(NAME=~"riga_documento.peso_netto~") COLUMN(NAME=~"riga_documento.calo~") COLUMN(NAME=~"riga_documento.fino~") COLUMN(NAME=~"riga_documento.prezzo_manifattura~") COLUMN(NAME=~"articolo_a.codice~") COLUMN(NAME=~"riga_distinta.quantita~") COLUMN(NAME=~"riga_distinta.peso_netto~") COLUMN(NAME=~"articolo_b.codice~") COLUMN(NAME=~"riga_documento.tot_riga_val_riga~") COLUMN(NAME=~"caus_magazzino.mp_scar_fiscali~") COLUMN(NAME=~"riga_distinta.id_distinta~")    JOIN (LEFT=~"distinta.id_articolo~"    OP =~"=~"RIGHT=~"articolo_a.id_articolo~" )    JOIN (LEFT=~"riga_distinta.id_distinta~"    OP =~"=~"RIGHT=~"distinta.id_distinta~" )    JOIN (LEFT=~"riga_distinta.id_articolo~"    OP =~"=~"RIGHT=~"articolo_b.id_articolo~" )    JOIN (LEFT=~"documento.id_documento~"    OP =~"=~"RIGHT=~"riga_documento.id_documento~" )    JOIN (LEFT=~"riga_documento.id_articolo~"    OP =~"=~"RIGHT=~"articolo_a.id_articolo~" )    JOIN (LEFT=~"caus_magazzino.id_caus_magazzino~"    OP =~"=~"RIGHT=~"riga_documento.id_caus_magazzino~" )WHERE(    EXP1 =~"~~~"documento~~~".~~~"data_documento~~~"~"   OP =~">=~"    EXP2 =~":da_data~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"documento~~~".~~~"data_documento~~~"~"   OP =~"<=~"    EXP2 =~":a_data~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"caus_magazzino~~~".~~~"segno~~~"~"   OP =~"=~"    EXP2 =~"'S'~" ) ) ARG(NAME = ~"da_data~" TYPE = date)  ARG(NAME = ~"a_data~" TYPE = date) " arguments=(("da_data", date),("a_data", date))  sort="sum_peso_netto D componente A documento_data_documento A documento_num_progressivo A " )
