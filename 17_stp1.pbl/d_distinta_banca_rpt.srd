 column=(type=date updatewhereclause=yes name=data_distinta dbname="dis_banca.data_distinta" )
 column=(type=decimal(4) updatewhereclause=yes name=tot_distinta dbname="dis_banca.tot_distinta" )
 column=(type=decimal(0) updatewhereclause=yes name=num_riga dbname="riga_dis_banca.num_riga" )
 column=(type=decimal(4) updatewhereclause=yes name=imp_totale dbname="riga_dis_banca.imp_totale" )
 column=(type=char(40) updatewhereclause=yes name=rif_documento dbname="riga_dis_banca.rif_documento" )
 column=(type=char(20) updatewhereclause=yes name=conto_corrente dbname="banca_azienda.conto_corrente" )
 column=(type=char(40) updatewhereclause=yes name=rag_1_az dbname="azienda.rag_1_az" )
 column=(type=char(40) updatewhereclause=yes name=rag_2_az dbname="azienda.rag_2_az" )
 column=(type=char(40) updatewhereclause=yes name=banca_appoggio_den_abi_az dbname="banca_appoggio.den_abi_az" )
 column=(type=char(40) updatewhereclause=yes name=banca_appoggio_den_cab_az dbname="banca_appoggio.den_cab_az" )
 column=(type=date updatewhereclause=yes name=data_scadenza dbname="scadenza.data_scadenza" )
 column=(type=decimal(4) updatewhereclause=yes name=importo dbname="scadenza.importo" )
 column=(type=char(40) updatewhereclause=yes name=rag_soc_1 dbname="anagrafica.rag_soc_1" )
 column=(type=char(40) updatewhereclause=yes name=rag_soc_2 dbname="anagrafica.rag_soc_2" )
 column=(type=char(40) updatewhereclause=yes name=indirizzo dbname="anagrafica.indirizzo" )
 column=(type=char(10) updatewhereclause=yes name=cap dbname="anagrafica.cap" )
 column=(type=char(40) updatewhereclause=yes name=localita dbname="anagrafica.localita" )
 column=(type=char(5) updatewhereclause=yes name=provincia dbname="anagrafica.provincia" )
 column=(type=char(16) updatewhereclause=yes name=cod_fiscale dbname="anagrafica.cod_fiscale" )
 column=(type=char(16) updatewhereclause=yes name=par_iva dbname="anagrafica.par_iva" )
 column=(type=char(5) updatewhereclause=yes name=cod_abi dbname="banca_appoggio.cod_abi" )
 column=(type=char(40) updatewhereclause=yes name=den_abi dbname="banca_appoggio.den_abi" )
 column=(type=char(5) updatewhereclause=yes name=cod_cab dbname="banca_appoggio.cod_cab" )
 column=(type=char(40) updatewhereclause=yes name=den_cab dbname="banca_appoggio.den_cab" )
 column=(type=char(40) updatewhereclause=yes name=des_indirizzo dbname="destinazione.des_indirizzo" )
 column=(type=char(10) updatewhereclause=yes name=des_cap dbname="destinazione.des_cap" )
 column=(type=char(40) updatewhereclause=yes name=des_loc dbname="destinazione.des_loc" )
 column=(type=char(1) updatewhereclause=yes name=tipo_destinazione dbname="destinazione.tipo_destinazione" )
 column=(type=char(1) updatewhereclause=yes name=scadenza_scadenza_da_raggruppare dbname="scadenza.scadenza_da_raggruppare" )
 column=(type=char(40) updatewhereclause=yes name=banca_appoggio_den_abi dbname="banca_appoggio.den_abi" )
 retrieve="  SELECT ~"dis_banca~".~"num_distinta~",   
         ~"dis_banca~".~"data_distinta~",   
         ~"dis_banca~".~"tot_distinta~",   
         ~"riga_dis_banca~".~"num_riga~",   
         ~"riga_dis_banca~".~"imp_totale~",   
         ~"riga_dis_banca~".~"rif_documento~",   
         ~"banca_azienda~".~"conto_corrente~",   
         ~"azienda~".~"rag_soc_1~" as rag_1_az,   
         ~"azienda~".~"rag_soc_2~" as rag_2_az,   
         ~"banca_appoggio_b~".~"den_abi~" as den_abi_az,   
         ~"banca_appoggio_b~".~"den_cab~"as den_cab_az,   
         ~"scadenza~".~"data_scadenza~",   
         ~"scadenza~".~"importo~",   
         ~"anagrafica~".~"rag_soc_1~",   
         ~"anagrafica~".~"rag_soc_2~",   
         ~"anagrafica~".~"indirizzo~",   
         ~"anagrafica~".~"cap~",   
         ~"anagrafica~".~"localita~",   
         ~"anagrafica~".~"provincia~",   
         ~"anagrafica~".~"cod_fiscale~",   
         ~"anagrafica~".~"par_iva~",   
         ~"banca_appoggio_a~".~"cod_abi~",   
         ~"banca_appoggio_a~".~"den_abi~",   
         ~"banca_appoggio_a~".~"cod_cab~",   
         ~"banca_appoggio_a~".~"den_cab~",   
         ~"destinazione~".~"indirizzo~" as des_indirizzo,   
         ~"destinazione~".~"cap~" as des_cap,   
         ~"destinazione~".~"localita~" as des_loc,   
         ~"destinazione~".~"tipo_destinazione~",
			~"scadenza~".~"scadenza_da_raggruppare~",
			~"banca_appoggio_b~".~"den_abi~"
    FROM {oj  ~"sog_commerciale~"  LEFT OUTER JOIN ~"destinazione~"  ON 
~"sog_commerciale~".~"id_sog_commerciale~" = ~"destinazione~".~"id_sog_commerciale~" AND
    destinazione.~"tipo_destinazione~"='R'},
 {oj ~"scadenza~"  LEFT OUTER JOIN ~"banca_sog_commerciale~"  
ON ~"scadenza~".~"id_banca_sog_commerciale~" = ~"banca_sog_commerciale~".~"id_banca_sog_commerciale~"}
 ,
 {oj ~"banca_sog_commerciale~"  LEFT OUTER JOIN ~"banca_appoggio~" banca_appoggio_a  
ON ~"banca_sog_commerciale~".~"id_banca_appoggio~" = ~"banca_appoggio_a~".~"id_banca_appoggio~"},   
         ~"anagrafica~",   
         ~"azienda~",   
         ~"banca_azienda~",   
         ~"dis_banca~",   
         ~"riga_dis_banca~",   
         ~"banca_appoggio~" ~"banca_appoggio_b~"  
   WHERE ( ~"riga_dis_banca~".~"id_distinta_banca~" = ~"dis_banca~".~"id_distinta_banca~" ) and  
         ( ~"riga_dis_banca~".~"id_riga_distinta_banca~" = ~"scadenza~".~"id_riga_distinta_banca~" ) and  
         ( ~"scadenza~".~"id_sog_commerciale~" = ~"sog_commerciale~".~"id_sog_commerciale~" ) and  
         ( ~"sog_commerciale~".~"id_anagrafica~" = ~"anagrafica~".~"id_anagrafica~" ) and  
         ( ~"dis_banca~".~"id_banca_azienda~" = ~"banca_azienda~".~"id_banca_azienda~" ) and  
         ( ~"dis_banca~".~"id_azienda~" = ~"azienda~".~"id_azienda~" ) and  
         ( ~"banca_azienda~".~"id_banca_appoggio~" = ~"banca_appoggio_b~".~"id_banca_appoggio~" )  
and   ( ~"dis_banca~".~"id_distinta_banca~" = :id_dis)
" arguments=(("id_dis", number))  sort="data_scadenza A rag_soc_1 A " )
