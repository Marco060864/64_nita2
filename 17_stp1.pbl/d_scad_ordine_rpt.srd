 column=(type=char(32766) updatewhereclause=no name=descrizione dbname="riga_documento.descrizione" )
 column=(type=long updatewhereclause=yes name=orafo_dis_cliente_id_riga_doc dbname="orafo_dis_cliente.id_riga_doc" )
 column=(type=char(1) updatewhereclause=yes name=unita_misura_tipo dbname="unita_misura.tipo" )
 column=(type=char(40) updatewhereclause=yes name=unita_misura_descrizione dbname="unita_misura.descrizione" )
 column=(type=date updatewhereclause=yes name=documento_data_competenza dbname="documento.data_competenza" )
 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"documento~" )  TABLE(NAME=~"sog_commerciale~" )  TABLE(NAME=~"riga_documento~" )  TABLE(NAME=~"articolo~" )  TABLE(NAME=~"conto~" )  TABLE(NAME=~"orafo_dis_cliente~" )  TABLE(NAME=~"unita_confezione~" )  TABLE(NAME=~"unita_misura~" ) COLUMN(NAME=~"sog_commerciale.id_conto~") COLUMN(NAME=~"articolo.codice~") COLUMN(NAME=~"articolo.descrizione~") COLUMN(NAME=~"riga_documento.quantita~") COLUMN(NAME=~"riga_documento.qta_evasa~") COLUMN(NAME=~"riga_documento.peso_netto~") COLUMN(NAME=~"riga_documento.peso_netto_evaso~") COLUMN(NAME=~"documento.num_documento~") COLUMN(NAME=~"conto.codice~") COLUMN(NAME=~"conto.descrizione~") COLUMN(NAME=~"documento.id_documento~") COLUMN(NAME=~"documento.data_documento~") COLUMN(NAME=~"documento.data_prev_consegna~") COLUMN(NAME=~"riga_documento.descrizione~") COLUMN(NAME=~"orafo_dis_cliente.id_riga_doc~") COLUMN(NAME=~"unita_misura.tipo~") COLUMN(NAME=~"unita_misura.descrizione~") COLUMN(NAME=~"documento.data_competenza~")    JOIN (LEFT=~"orafo_dis_cliente.id_riga_doc~"    OP =~"=~"RIGHT=~"riga_documento.id_riga_documento~"    OUTER2 =~"riga_documento.id_riga_documento~" )    JOIN (LEFT=~"riga_documento.id_documento~"    OP =~"=~"RIGHT=~"documento.id_documento~" )    JOIN (LEFT=~"sog_commerciale.id_sog_commerciale~"    OP =~"=~"RIGHT=~"documento.id_sog_commerciale~" )    JOIN (LEFT=~"articolo.id_articolo~"    OP =~"=~"RIGHT=~"riga_documento.id_articolo~" )    JOIN (LEFT=~"conto.id_conto~"    OP =~"=~"RIGHT=~"sog_commerciale.id_conto~" )    JOIN (LEFT=~"unita_confezione.id_articolo~"    OP =~"=~"RIGHT=~"articolo.id_articolo~" )    JOIN (LEFT=~"unita_misura.id_unita_misura~"    OP =~"=~"RIGHT=~"unita_confezione.id_unita_mis_peso~" )WHERE(    EXP1 =~"~~~"documento~~~".~~~"data_prev_consegna~~~"~"   OP =~"<=~"    EXP2 =~":rd_data~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"sog_commerciale~~~".~~~"id_conto~~~"~"   OP =~"=~"    EXP2 =~":rn_conto~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"documento~~~".~~~"evaso_totalmente~~~"~"   OP =~"<>~"    EXP2 =~"'S'~" ) ) ARG(NAME = ~"rn_conto~" TYPE = number)  ARG(NAME = ~"rd_data~" TYPE = date) " filter="( quantita <> qta_evasa or  isnull ( qta_evasa ) ) and  ( peso_netto <> peso_netto_evaso or  isnull ( peso_netto_evaso ) )" arguments=(("rn_conto", number),("rd_data", date)) )
