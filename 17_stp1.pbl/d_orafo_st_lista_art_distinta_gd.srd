 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"articolo~" )  TABLE(NAME=~"distinta~" )  TABLE(NAME=~"riga_distinta~" )  TABLE(NAME=~"cat_com_articolo~" )  TABLE(NAME=~"cat_fiscale~" )  TABLE(NAME=~"cat_merceologica~" ) COLUMN(NAME=~"articolo.codice~") COLUMN(NAME=~"articolo.des_breve~") COLUMN(NAME=~"distinta.codice~") COLUMN(NAME=~"riga_distinta.num_riga~") COMPUTE(NAME=~"cast(:rs_da_codice as char(255)) as da_articolo~") COMPUTE(NAME=~"cast(:rs_a_codice as char(255)) as a_articolo~") COLUMN(NAME=~"cat_com_articolo.codice~") COLUMN(NAME=~"cat_fiscale.codice~") COLUMN(NAME=~"cat_merceologica.codice~")    JOIN (LEFT=~"distinta.id_articolo~"    OP =~"=~"RIGHT=~"articolo.id_articolo~"    OUTER2 =~"articolo.id_articolo~" )    JOIN (LEFT=~"riga_distinta.id_distinta~"    OP =~"=~"RIGHT=~"distinta.id_distinta~"    OUTER2 =~"distinta.id_distinta~" )    JOIN (LEFT=~"cat_com_articolo.id_cat_com_articolo~"    OP =~"=~"RIGHT=~"articolo.id_cat_com_articolo~"    OUTER2 =~"articolo.id_cat_com_articolo~" )    JOIN (LEFT=~"cat_fiscale.id_cat_fiscale~"    OP =~"=~"RIGHT=~"articolo.id_cat_fiscale~"    OUTER2 =~"articolo.id_cat_fiscale~" )    JOIN (LEFT=~"cat_merceologica.id_cat_merceologica~"    OP =~"=~"RIGHT=~"articolo.id_cat_merceologica~"    OUTER2 =~"articolo.id_cat_merceologica~" )WHERE(    EXP1 =~"~~~"articolo~~~".~~~"codice~~~"~"   OP =~">=~"    EXP2 =~":rs_da_codice~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"articolo~~~".~~~"codice~~~"~"   OP =~"<=~"    EXP2 =~":rs_a_codice~" ) ) ARG(NAME = ~"rs_da_codice~" TYPE = string)  ARG(NAME = ~"rs_a_codice~" TYPE = string) " arguments=(("rs_da_codice", string),("rs_a_codice", string)) )
