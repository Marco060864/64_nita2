release 9;
datawindow(units=3 timer_interval=0 color=1090519039 processing=0 HTMLDW=no print.printername="" print.documentname="Listino" print.orientation = 0 print.margin.left = 1000 print.margin.right = 1000 print.margin.top = 1000 print.margin.bottom = 2000 print.paper.source = 0 print.paper.size = 0 print.canusedefaultprinter=yes print.prompt=no print.buttons=no print.preview.buttons=no print.cliptext=no print.overrideprintjob=no print.collate=yes hidegrayline=no rows_per_detail = 2 )
header(height=1481 color="536870912" )
summary(height=0 color="553648127" )
footer(height=476 color="536870912" )
detail(height=529 color="536870912" )
table(column=(type=char(32) updatewhereclause=yes name=articolo_codice dbname="articolo.codice" )
 column=(type=char(80) updatewhereclause=yes name=articolo_descrizione dbname="articolo.descrizione" )
 column=(type=char(1) updatewhereclause=yes name=unita_misura_tipo dbname="unita_misura.tipo" )
 column=(type=char(5) updatewhereclause=yes name=unita_misura_simbolo dbname="unita_misura.simbolo" )
 column=(type=char(40) updatewhereclause=yes name=lis_descrizione dbname="lis_descrizione" )
 column=(type=char(40) updatewhereclause=yes name=lis_descrizione_1 dbname="lis_descrizione_1" )
 column=(type=char(40) updatewhereclause=yes name=des_valuta dbname="des_valuta" )
 column=(type=decimal(6) updatewhereclause=yes name=prezzo dbname="prezzo" )
 retrieve="SELECT  ~"articolo~".~"codice~" ,
           ~"articolo~".~"descrizione~" ,
           ~"unita_misura~".~"tipo~" ,
           ~"unita_misura~".~"simbolo~" ,
           cast((select descrizione 
        from listino,
 variazione 
        where listino.id_listino=variazione.id_listino and variazione.id_variazione=:rl_id_variazione) as varchar(40)) as lis_descrizione,
   
cast((select descrizione from listino,
 variazione where listino.id_listino=variazione.id_listino and variazione.id_variazione=:rl_id_variazione) as varchar(40)) as lis_descrizione_1,
           CAST((SELECT ~"valuta~".~"descrizione~" FROM ~"valuta~"  WHERE  ~"valuta~".~"id_valuta~" = :ra_id_valuta) AS CHAR) AS des_valuta,
           CAST(f_rounddb(:num_dec_arr,
:tipo_arr,
 ~"unita_confezione~".~"id_unita_confezione~",
~"unita_misura~".~"simbolo~",
 :rl_id_variazione,
 :cambio) AS decimal(20,
6)) AS prezzo FROM {oj ~"cat_fiscale~" RIGHT OUTER JOIN ~"articolo~" ON ~"cat_fiscale~".~"id_cat_fiscale~" = ~"articolo~".~"id_cat_fiscale~"},
 {oj ~"cat_merceologica~" RIGHT OUTER JOIN ~"articolo~" ON ~"cat_merceologica~".~"id_cat_merceologica~" = ~"articolo~".~"id_cat_merceologica~"} ,
           ~"unita_confezione~" ,
           ~"unita_misura~" ,
           ~"prezzo~" ,
           ~"cat_com_articolo~"    WHERE ( ~"unita_confezione~".~"id_articolo~" = ~"articolo~".~"id_articolo~" ) and          ( ~"unita_misura~".~"id_unita_misura~" = ~"unita_confezione~".~"id_unita_misura~" ) and          ( ~"prezzo~".~"id_unita_confezione~" = ~"unita_confezione~".~"id_unita_confezione~" ) and          ( ~"cat_com_articolo~".~"id_cat_com_articolo~" = ~"articolo~".~"id_cat_com_articolo~" ) and          ( ( ~"prezzo~".~"id_variazione~" = :rl_id_variazione ) and          ( ~"articolo~".~"codice~" >= :rs_da_codice ) and          ( ~"articolo~".~"codice~" <= :rs_a_codice ) )  " arguments=(("rl_id_variazione", number),("rs_da_codice", string),("rs_a_codice", string),("ra_id_valuta", number),("cambio", number),("num_dec_arr", number),("tipo_arr", string))  sort="articolo_codice A " )
