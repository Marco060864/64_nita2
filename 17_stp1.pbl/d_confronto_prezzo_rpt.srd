table(column=(type=char(32) updatewhereclause=yes name=articolo_codice dbname="articolo.codice" )
 column=(type=char(80) updatewhereclause=yes name=articolo_descrizione dbname="articolo.descrizione" )
 column=(type=decimal(4) updatewhereclause=yes name=unita_confezione_peso_netto dbname="unita_confezione.peso_netto" )
 column=(type=decimal(4) updatewhereclause=yes name=dim_l dbname="unita_confezione.dim_l" )
 column=(type=decimal(6) updatewhereclause=yes name=prezzo dbname="prezzo.prezzo" )
 column=(type=decimal(2) updatewhereclause=yes name=coef_calo dbname="prezzo.coef_calo" )
 column=(type=decimal(6) updatewhereclause=yes name=prezzo_manifattura dbname="prezzo.prezzo_manifattura" )
 column=(type=char(4) updatewhereclause=yes name=listino_codice dbname="listino.codice" )
 column=(type=char(40) updatewhereclause=yes name=listino_descrizione dbname="listino.descrizione" )
 column=(type=char(5) updatewhereclause=yes name=unita_misura_simbolo dbname="unita_misura.simbolo" )
 column=(type=decimal(2) updatewhereclause=yes name=articolo_coef_calo dbname="articolo.coef_calo" )
 column=(type=char(80) updatewhereclause=yes name=des_valuta dbname="des_valuta" )
 column=(type=long updatewhereclause=yes identity=yes name=articolo_id_articolo dbname="articolo.id_articolo" )
 column=(type=decimal(4) updatewhereclause=yes name=c_sum_costo dbname="c_sum_costo" )
 column=(type=date updatewhereclause=yes name=data_ult_doc dbname="data_ult_doc" )
 column=(type=char(1) updatewhereclause=yes name=c_scelto dbname="articolo.ges_lotti" values="	N/	S" )
 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"articolo~" )  TABLE(NAME=~"listino~" )  TABLE(NAME=~"prezzo~" )  TABLE(NAME=~"variazione~" )  TABLE(NAME=~"unita_confezione~" )  TABLE(NAME=~"unita_misura~" )  TABLE(NAME=~"cat_com_articolo~" )  TABLE(NAME=~"cat_fiscale~" )  TABLE(NAME=~"cat_merceologica~" ) COLUMN(NAME=~"articolo.codice~") COLUMN(NAME=~"articolo.descrizione~") COLUMN(NAME=~"unita_confezione.peso_netto~") COLUMN(NAME=~"unita_confezione.dim_l~") COLUMN(NAME=~"prezzo.prezzo~") COLUMN(NAME=~"prezzo.coef_calo~") COLUMN(NAME=~"prezzo.prezzo_manifattura~") COLUMN(NAME=~"listino.codice~") COLUMN(NAME=~"listino.descrizione~") COLUMN(NAME=~"unita_misura.simbolo~") COLUMN(NAME=~"articolo.coef_calo~") COMPUTE(NAME=~" CAST((SELECT DESCRIZIONE FROM VALUTA WHERE ID_VALUTA=:ra_id_valuta) AS VARCHAR(80)) AS DES_VALUTA~") COLUMN(NAME=~"articolo.id_articolo~") COMPUTE(NAME=~"(select sum(ifnull(costo, 0,costo)) from distinta d, riga_distinta r where d.id_articolo=articolo.id_articolo and d.id_distinta=r.id_distinta) as c_sum_costo~") COMPUTE(NAME=~"(select max(data_documento) from documento d, riga_documento r where d.id_documento=r.id_documento and r.id_articolo=articolo.id_articolo) as data_ult_doc~") COLUMN(NAME=~"articolo.ges_lotti~")    JOIN (LEFT=~"cat_fiscale.id_cat_fiscale~"    OP =~"=~"RIGHT=~"articolo.id_cat_fiscale~"    OUTER2 =~"articolo.id_cat_fiscale~" )    JOIN (LEFT=~"cat_merceologica.id_cat_merceologica~"    OP =~"=~"RIGHT=~"articolo.id_cat_merceologica~"    OUTER2 =~"articolo.id_cat_merceologica~" )    JOIN (LEFT=~"variazione.id_variazione~"    OP =~"=~"RIGHT=~"prezzo.id_variazione~" )    JOIN (LEFT=~"variazione.id_listino~"    OP =~"=~"RIGHT=~"listino.id_listino~" )    JOIN (LEFT=~"unita_confezione.id_unita_confezione~"    OP =~"=~"RIGHT=~"prezzo.id_unita_confezione~" )    JOIN (LEFT=~"unita_confezione.id_articolo~"    OP =~"=~"RIGHT=~"articolo.id_articolo~" )    JOIN (LEFT=~"unita_misura.id_unita_misura~"    OP =~"=~"RIGHT=~"unita_confezione.id_unita_misura~" )    JOIN (LEFT=~"cat_com_articolo.id_cat_com_articolo~"    OP =~"=~"RIGHT=~"articolo.id_cat_com_articolo~" )WHERE(    EXP1 =~"~~~"prezzo~~~".~~~"id_variazione~~~"~"   OP =~"=~"    EXP2 =~":rl_id_variazione~" ) ) ARG(NAME = ~"rl_id_variazione~" TYPE = number)  ARG(NAME = ~"rs_da_codice~" TYPE = string)  ARG(NAME = ~"rs_a_codice~" TYPE = string)  ARG(NAME = ~"ra_id_valuta~" TYPE = number)  ARG(NAME = ~"ra_cambio~" TYPE = number)  ARG(NAME = ~"num_dec_arr~" TYPE = number)  ARG(NAME = ~"tipo_arr~" TYPE = string) " arguments=(("rl_id_variazione", number),("rs_da_codice", string),("rs_a_codice", string),("ra_id_valuta", number),("ra_cambio", number),("num_dec_arr", number),("tipo_arr", string))  sort="articolo_codice A " )
