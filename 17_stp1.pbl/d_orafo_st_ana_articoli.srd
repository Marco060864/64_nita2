footer(height=96 color="536870912" )
detail(height=72 color="536870912" )
table(column=(type=char(32) updatewhereclause=yes name=codice dbname="unita_confezione.codice" )
 column=(type=char(40) updatewhereclause=yes name=des_breve dbname="unita_confezione.des_breve" )
 column=(type=decimal(2) updatewhereclause=yes name=coef_calo dbname="unita_confezione.coef_calo" )
 column=(type=decimal(4) updatewhereclause=yes name=peso_non_prezioso dbname="unita_confezione.peso_non_prezioso" )
 column=(type=char(5) updatewhereclause=yes name=simbolo dbname="unita_misura.simbolo" )
 column=(type=char(2) updatewhereclause=yes name=cat_com_articolo_codice dbname="orafo_metallo.codice" )
 column=(type=decimal(2) updatewhereclause=yes name=titolo dbname="orafo_titolo.titolo" )
 column=(type=char(8) updatewhereclause=yes name=cat_merceologica_codice dbname="cat_com_articolo.codice" )
 column=(type=char(8) updatewhereclause=yes name=cat_fiscale_codice dbname="unita_confezione.codice" )
 column=(type=char(8) updatewhereclause=yes name=codice dbname="unita_confezione.codice" )
 column=(type=decimal(4) updatewhereclause=yes name=peso_netto dbname="unita_confezione.peso_netto" )
 column=(type=decimal(4) updatewhereclause=yes name=dim_l dbname="unita_confezione.dim_l" )
 column=(type=decimal(6) updatewhereclause=yes name=prezzo_manifattura dbname="prezzo.prezzo_manifattura" )
 column=(type=decimal(6) updatewhereclause=yes name=prezzo dbname="prezzo.prezzo" )
 column=(type=char(1) updatewhereclause=yes name=prod_interna dbname="unita_confezione.prod_interna" )
 column=(type=char(32) updatewhereclause=yes name=cod_metallo dbname="unita_confezione.codice" )
 column=(type=decimal(2) updatewhereclause=yes name=per_aliquota dbname="unita_confezione.per_aliquota" )
 column=(type=long updatewhereclause=yes name=id_valuta dbname="par_sistema.id_valuta" )
 column=(type=decimal(4) updatewhereclause=yes name=peso_tot_dist dbname="peso_tot_dist" )
 retrieve="SELECT ~"articolo~".~"codice~",   
         ~"articolo~".~"des_breve~",
			articolo.coef_calo,
			unita_confezione.peso_non_prezioso,   
         ~"unita_misura~".~"simbolo~",  
			orafo_metallo.codice,
			orafo_titolo.titolo, 
         ~"cat_com_articolo~".~"codice~",   
         ~"cat_merceologica~".~"codice~",   
         ~"cat_fiscale~".~"codice~",   
          ~"unita_confezione~".~"peso_netto~",   
         ~"unita_confezione~".~"dim_l~",  
			prezzo.prezzo_manifattura,
			prezzo.prezzo, 
         ~"articolo~".~"prod_interna~",   
         ~"distinta~".~"codice~",   
         ~"tab_iva~".~"per_aliquota~",
			par_sistema.id_valuta,
	cast((select sum(peso_netto) from riga_distinta 
where riga_distinta.id_distinta=distinta.id_distinta) 
	as decimal) as  peso_tot_dist




    FROM {oj {oj {oj ~"unita_confezione~"  LEFT OUTER JOIN ~"unita_misura~" 
 ON ~"unita_confezione~".~"id_unita_misura~" = ~"unita_misura~".~"id_unita_misura~"}, 
{oj ~"articolo~"  LEFT OUTER JOIN ~"tab_iva~"  ON ~"articolo~".~"id_tab_iva~" = 
~"tab_iva~".~"id_tab_iva~"} LEFT OUTER JOIN ~"cat_merceologica~"  
ON ~"articolo~".~"id_cat_merceologica~" = ~"cat_merceologica~".~"id_cat_merceologica~"}, 
{oj ~"articolo~"  LEFT OUTER JOIN ~"cat_fiscale~"  ON ~"articolo~".~"id_cat_fiscale~" 
= ~"cat_fiscale~".~"id_cat_fiscale~"}, {oj ~"articolo~"  LEFT OUTER JOIN ~"distinta~" 
 ON ~"articolo~".~"id_articolo~" = ~"distinta~".~"id_articolo~"} 
LEFT OUTER JOIN ~"unita_confezione~"  ON ~"articolo~".~"id_articolo~" =
 ~"unita_confezione~".~"id_articolo~"},   
{oj ~"unita_confezione~"  LEFT OUTER JOIN ~"prezzo~"  ON ~"unita_confezione~".~"id_unita_confezione~" =
 ~"prezzo~".~"id_unita_confezione~"},
{oj ~"prezzo~"  LEFT OUTER JOIN ~"variazione~"  ON ~"prezzo~".~"id_variazione~" =
 ~"variazione~".~"id_variazione~"},
{oj ~"variazione~"  LEFT OUTER JOIN ~"listino~"  ON ~"variazione~".~"id_listino~" =
 ~"listino~".~"id_listino~"},
         ~"cat_com_articolo~", orafo_metallo, orafo_titolo , par_sistema
   WHERE ( ~"cat_com_articolo~".~"id_cat_com_articolo~" = ~"articolo~".~"id_cat_com_articolo~" ) and  
         ( ( ~"articolo~".~"codice~" >= :rs_da_codice) AND  
         ( ~"articolo~".~"codice~" <= :rs_a_codice ) AND  
         ( ~"unita_confezione~".~"unita_base~" = 'S' ) )  
and (orafo_metallo.codice>=:rs_da_cod_metallo 
and orafo_metallo.codice<=:rs_a_cod_metallo)
and (orafo_titolo.titolo>=:rs_da_titolo
and  orafo_titolo.titolo<=:rs_a_titolo)

and orafo_metallo.id_metallo=orafo_titolo.id_metallo
and orafo_titolo.id_titolo=articolo.id_titolo
and variazione.data_inizio<=date(today()) and (variazione.data_fine>= 
date(today()) or variazione.data_fine is null)
and listino.lis_base='S' and listino.tipo='V'" arguments=(("rs_da_codice", string),("rs_a_codice", string),("parametri", string),("rs_da_cod_metallo", string),("rs_a_cod_metallo", string),("rs_da_titolo", number),("rs_a_titolo", number))  sort="codice A " )
