table(column=(type=long updatewhereclause=yes identity=yes name=articolo_id_articolo dbname="articolo.id_articolo" )
 column=(type=char(32) updatewhereclause=yes name=articolo_codice dbname="articolo.codice" )
 column=(type=char(80) updatewhereclause=yes name=articolo_descrizione dbname="articolo.descrizione" )
 column=(type=decimal(6) updatewhereclause=yes name=prezzo_prezzo dbname="prezzo.prezzo" )
 column=(type=decimal(6) updatewhereclause=yes name=prezzo_prezzo_manifattura dbname="prezzo.prezzo_manifattura" )
 column=(type=long updatewhereclause=yes name=articolo_id_cat_codifica dbname="articolo.id_cat_codifica" )
 column=(type=long updatewhereclause=yes name=articolo_id_cat_com_articolo dbname="articolo.id_cat_com_articolo" )
 column=(type=datetime updatewhereclause=yes name=articolo_data_ora_creazione dbname="articolo.data_ora_creazione" )
 column=(type=char(32) updatewhereclause=yes name=distinta_codice dbname="distinta.codice" )
 column=(type=long updatewhereclause=yes name=c_esiste_distinta dbname="c_esiste_distinta" values="	1/	0" )
 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"articolo~" )  TABLE(NAME=~"prezzo~" )  TABLE(NAME=~"unita_confezione~" )  TABLE(NAME=~"distinta~" ) COLUMN(NAME=~"articolo.id_articolo~") COLUMN(NAME=~"articolo.codice~") COLUMN(NAME=~"articolo.descrizione~") COLUMN(NAME=~"prezzo.prezzo~") COLUMN(NAME=~"prezzo.prezzo_manifattura~") COLUMN(NAME=~"articolo.id_cat_codifica~") COLUMN(NAME=~"articolo.id_cat_com_articolo~") COLUMN(NAME=~"articolo.data_ora_creazione~") COLUMN(NAME=~"distinta.codice~") COMPUTE(NAME=~"(if distinta.codice> ' ' then 1 else 0 end if) as c_esiste_distinta~")    JOIN (LEFT=~"articolo.id_articolo~"    OP =~"=~"RIGHT=~"distinta.id_articolo~"    OUTER1 =~"articolo.id_articolo~" )    JOIN (LEFT=~"unita_confezione.id_unita_confezione~"    OP =~"=~"RIGHT=~"prezzo.id_unita_confezione~" )    JOIN (LEFT=~"unita_confezione.id_articolo~"    OP =~"=~"RIGHT=~"articolo.id_articolo~" )WHERE(    EXP1 =~"~~~"prezzo~~~".~~~"id_variazione~~~"~"   OP =~"=~"    EXP2 =~":id_variazione~" ) ) ARG(NAME = ~"id_variazione~" TYPE = number) " arguments=(("id_variazione", number)) )
