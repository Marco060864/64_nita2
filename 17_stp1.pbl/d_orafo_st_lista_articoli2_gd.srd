 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"unita_confezione~" )  TABLE(NAME=~"unita_misura~" )  TABLE(NAME=~"articolo~" )  TABLE(NAME=~"tab_iva~" )  TABLE(NAME=~"cat_com_articolo~" )  TABLE(NAME=~"cat_merceologica~" )  TABLE(NAME=~"cat_fiscale~" )  TABLE(NAME=~"distinta~" ) COLUMN(NAME=~"articolo.codice~") COLUMN(NAME=~"articolo.des_breve~") COLUMN(NAME=~"unita_misura.simbolo~") COMPUTE(NAME=~"CAST (:parametri as char(255)) as parametri~") COMPUTE(NAME=~"CAST(:rs_da_codice as char(32)) as da_articolo~") COMPUTE(NAME=~"CAST(:rs_a_codice as char(32)) as a_articolo~") COLUMN(NAME=~"cat_com_articolo.codice~") COLUMN(NAME=~"cat_merceologica.codice~") COLUMN(NAME=~"cat_fiscale.codice~") COMPUTE(NAME=~"CAST(:ordinamento as char(30)) as ordinamento~") COLUMN(NAME=~"unita_confezione.peso_netto~") COLUMN(NAME=~"unita_confezione.dim_l~") COLUMN(NAME=~"articolo.prod_interna~") COLUMN(NAME=~"distinta.codice~") COLUMN(NAME=~"tab_iva.per_aliquota~") COMPUTE(NAME=~"CAST((SELECT ~~~"valuta~~~".~~~"descrizione~~~" FROM ~~~"valuta~~~"  WHERE  ~~~"valuta~~~".~~~"id_valuta~~~" =:id_valuta ) AS CHAR) AS Valuta~") COMPUTE(NAME=~"CAST((SELECT ~~~"valuta~~~".~~~"id_valuta~~~" FROM ~~~"valuta~~~"  WHERE  ~~~"valuta~~~".~~~"id_valuta~~~" = :id_valuta) AS integer) AS id_valuta~") COMPUTE(NAME=~"CAST((SELECT ~~~"listino~~~".~~~"descrizione~~~" FROM ~~~"listino~~~", ~~~"variazione~~~" WHERE ~~~"listino~~~".~~~"id_listino~~~"=~~~"variazione~~~".~~~"id_listino~~~" and ~~~"variazione~~~".~~~"id_variazione~~~" = :rl_id_variazione) as char) as lis_descrizione~") COMPUTE(NAME=~"CAST((SELECT ~~~"prezzo~~~" FROM ~~~"prezzo~~~" WHERE ~~~"id_variazione~~~" = :rl_id_variazione AND ~~~"id_unita_confezione~~~" = ~~~"unita_confezione~~~".~~~"id_unita_confezione~~~") AS DECIMAL(20,6)) AS prezzo~") COMPUTE(NAME=~"CAST((SELECT ~~~"prezzo_manifattura~~~" FROM ~~~"prezzo~~~" WHERE ~~~"id_variazione~~~" = :rl_id_variazione AND ~~~"id_unita_confezione~~~" = ~~~"unita_confezione~~~".~~~"id_unita_confezione~~~") AS DECIMAL(20,6)) AS prezzo_manifattura~")    JOIN (LEFT=~"unita_confezione.id_unita_misura~"    OP =~"=~"RIGHT=~"unita_misura.id_unita_misura~"    OUTER1 =~"unita_confezione.id_unita_misura~" )    JOIN (LEFT=~"articolo.id_tab_iva~"    OP =~"=~"RIGHT=~"tab_iva.id_tab_iva~"    OUTER1 =~"articolo.id_tab_iva~" )    JOIN (LEFT=~"cat_merceologica.id_cat_merceologica~"    OP =~"=~"RIGHT=~"articolo.id_cat_merceologica~"    OUTER2 =~"articolo.id_cat_merceologica~" )    JOIN (LEFT=~"cat_fiscale.id_cat_fiscale~"    OP =~"=~"RIGHT=~"articolo.id_cat_fiscale~"    OUTER2 =~"articolo.id_cat_fiscale~" )    JOIN (LEFT=~"articolo.id_articolo~"    OP =~"=~"RIGHT=~"distinta.id_articolo~"    OUTER1 =~"articolo.id_articolo~" )    JOIN (LEFT=~"unita_confezione.id_articolo~"    OP =~"=~"RIGHT=~"articolo.id_articolo~"    OUTER2 =~"articolo.id_articolo~" )    JOIN (LEFT=~"cat_com_articolo.id_cat_com_articolo~"    OP =~"=~"RIGHT=~"articolo.id_cat_com_articolo~" )WHERE(    EXP1 =~"~~~"articolo~~~".~~~"codice~~~"~"   OP =~">=~"    EXP2 =~":rs_da_codice~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"articolo~~~".~~~"codice~~~"~"   OP =~"<=~"    EXP2 =~":rs_a_codice~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"unita_confezione~~~".~~~"unita_base~~~"~"   OP =~"=~"    EXP2 =~"'S'~" ) ) ARG(NAME = ~"rl_id_variazione~" TYPE = number)  ARG(NAME = ~"rs_da_codice~" TYPE = string)  ARG(NAME = ~"rs_a_codice~" TYPE = string)  ARG(NAME = ~"parametri~" TYPE = string)  ARG(NAME = ~"ordinamento~" TYPE = string)  ARG(NAME = ~"cifra_arrotondamento~" TYPE = number)  ARG(NAME = ~"tipo_arrotondamento~" TYPE = string)  ARG(NAME = ~"id_valuta~" TYPE = number)  ARG(NAME = ~"cambio~" TYPE = number) " update="valuta" updatewhere=0 updatekeyinplace=no arguments=(("rl_id_variazione", number),("rs_da_codice", string),("rs_a_codice", string),("parametri", string),("ordinamento", string),("cifra_arrotondamento", number),("tipo_arrotondamento", string),("id_valuta", number),("cambio", number))  sort="codice A " )
