 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"distinta~" )  TABLE(NAME=~"articolo~" )  TABLE(NAME=~"des_articolo~" ) COLUMN(NAME=~"distinta.codice~") COLUMN(NAME=~"distinta.descrizione~") COLUMN(NAME=~"distinta.id_articolo~") COLUMN(NAME=~"distinta.calo~") COLUMN(NAME=~"distinta.data_ora_creazione~") COLUMN(NAME=~"distinta.data_ora_ult_cambiamento~") COLUMN(NAME=~"distinta.data_ora_ult_agg~") COLUMN(NAME=~"distinta.tipo_aggiornamento~") COLUMN(NAME=~"distinta.tipo_cal_valore~") COLUMN(NAME=~"distinta.tipo_applicazione~") COLUMN(NAME=~"distinta.id_dis_base~") COLUMN(NAME=~"distinta.id_distinta~") COLUMN(NAME=~"articolo.codice~") COLUMN(NAME=~"articolo.descrizione~") COLUMN(NAME=~"articolo.immagine~") COLUMN(NAME=~"distinta.id_azienda~") COLUMN(NAME=~"distinta.id_valuta~") COMPUTE(NAME=~"cast(null as char(8))as cod_cli~") COMPUTE(NAME=~"cast(null as integer) as id_sog_commerciale~") COLUMN(NAME=~"des_articolo.codice~") COLUMN(NAME=~"distinta.ricarico~") COMPUTE(NAME=~"cast(null as integer) as id_listino~") COLUMN(NAME=~"distinta.tipo_ric~")    JOIN (LEFT=~"des_articolo.id_articolo~"    OP =~"=~"RIGHT=~"articolo.id_articolo~"    OUTER2 =~"articolo.id_articolo~" )    JOIN (LEFT=~"articolo.id_articolo~"    OP =~"=~"RIGHT=~"distinta.id_articolo~" )WHERE(    EXP1 =~"~~~"distinta~~~".~~~"codice~~~"~"   OP =~">=~"    EXP2 =~":ra_cod1~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"distinta~~~".~~~"codice~~~"~"   OP =~"<=~"    EXP2 =~":ra_cod2~" ) ) ORDER(NAME=~"distinta.codice~" ASC=yes ) ARG(NAME = ~"ra_cod1~" TYPE = string)  ARG(NAME = ~"ra_cod2~" TYPE = string) " arguments=(("ra_cod1", string),("ra_cod2", string)) )
