 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"riga_distinta~" )  TABLE(NAME=~"distinta~" ) COLUMN(NAME=~"riga_distinta.id_riga_distinta~") COLUMN(NAME=~"riga_distinta.id_distinta~") COLUMN(NAME=~"riga_distinta.num_riga~") COLUMN(NAME=~"riga_distinta.id_articolo~") COLUMN(NAME=~"riga_distinta.id_dis_figlio~") COLUMN(NAME=~"riga_distinta.tipo_riga~") COLUMN(NAME=~"riga_distinta.quantita~") COLUMN(NAME=~"riga_distinta.costo~") COLUMN(NAME=~"riga_distinta.calo~") COLUMN(NAME=~"riga_distinta.note~") COLUMN(NAME=~"riga_distinta.data_inizio~") COLUMN(NAME=~"riga_distinta.data_fine~") COLUMN(NAME=~"riga_distinta.id_dis_var~") COLUMN(NAME=~"riga_distinta.varie~") COLUMN(NAME=~"riga_distinta.id_componente~") COLUMN(NAME=~"riga_distinta.peso_netto~") COLUMN(NAME=~"riga_distinta.rif_schema~") COLUMN(NAME=~"riga_distinta.infilatura~") COLUMN(NAME=~"distinta.id_articolo~")    JOIN (LEFT=~"distinta.id_distinta~"    OP =~"=~"RIGHT=~"riga_distinta.id_distinta~" )WHERE(    EXP1 =~"~~~"distinta~~~".~~~"id_articolo~~~"~"   OP =~"=~"    EXP2 =~":id_art_distinta~" ) ) ARG(NAME = ~"id_art_distinta~" TYPE = number) " update="riga_distinta" updatewhere=1 updatekeyinplace=yes arguments=(("id_art_distinta", number)) )
