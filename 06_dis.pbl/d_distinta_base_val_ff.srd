 column=(type=char(1) update=yes updatewhereclause=yes name=tipo_aggiornamento dbname="distinta.tipo_aggiornamento" values="Ultimo Costo	U/Costo Medio	M/Costo medio Continuo	C/" )
 column=(type=char(1) update=yes updatewhereclause=yes name=tipo_cal_valore dbname="distinta.tipo_cal_valore" values="Listino	L/Ultimo Costo	U/Costo Medio	M/Costo Medio Continuo	C/Costo in Distinta	D/" )
 column=(type=char(1) update=yes updatewhereclause=yes name=tipo_applicazione dbname="distinta.tipo_applicazione" values="Vendita	V/Acquisto	A/" )
