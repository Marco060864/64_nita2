 column=(type=long update=yes updatewhereclause=yes identity=yes name=id_distinta dbname="distinta.id_distinta" )
 column=(type=char(32) updatewhereclause=yes name=articolo_codice dbname="articolo.codice" )
 column=(type=char(80) updatewhereclause=yes name=articolo_descrizione dbname="articolo.descrizione" )
 column=(type=char(255) updatewhereclause=yes name=articolo_immagine dbname="articolo.immagine" )
 column=(type=long update=yes updatewhereclause=yes key=yes name=id_azienda dbname="distinta.id_azienda" initial="1" )
