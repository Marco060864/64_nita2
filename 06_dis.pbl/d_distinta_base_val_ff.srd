table(column=(type=char(32) update=yes updatewhereclause=yes key=yes name=codice dbname="distinta.codice" )
 column=(type=char(80) update=yes updatewhereclause=yes name=descrizione dbname="distinta.descrizione" )
 column=(type=long update=yes updatewhereclause=yes name=id_articolo dbname="distinta.id_articolo" )
