table(column=(type=long updatewhereclause=yes name=riga_documento_id_riga_doc_padre dbname="riga_documento.id_riga_doc_padre" )
 column=(type=char(16) updatewhereclause=yes name=documento_num_documento dbname="documento.num_documento" )
 column=(type=date updatewhereclause=yes name=documento_data_documento dbname="documento.data_documento" )
 column=(type=decimal(0) updatewhereclause=yes name=riga_documento_num_riga dbname="riga_documento.num_riga" )
 column=(type=long updatewhereclause=yes name=riga_documento_id_articolo dbname="riga_documento.id_articolo" )
 column=(type=char(64) updatewhereclause=yes name=articolo_codice dbname="articolo.codice" )
 column=(type=char(32766) updatewhereclause=no name=riga_documento_descrizione dbname="riga_documento.descrizione" )
 column=(type=decimal(4) updatewhereclause=yes name=riga_documento_quantita dbname="riga_documento.quantita" )
 column=(type=decimal(6) updatewhereclause=yes name=riga_documento_prezzo_complessivo dbname="riga_documento.prezzo_complessivo" )
 column=(type=decimal(6) updatewhereclause=yes name=riga_documento_prezzo dbname="riga_documento.prezzo" )
 column=(type=decimal(6) updatewhereclause=yes name=riga_documento_prezzo_manifattura dbname="riga_documento.prezzo_manifattura" )
 column=(type=decimal(4) updatewhereclause=yes name=compute_0012 dbname="compute_0012" )
 column=(type=long updatewhereclause=yes name=c_id_art_padre dbname="c_id_art_padre" )
 retrieve="SELECT  r.id_riga_doc_padre,num_documento, data_documento, num_riga, r.id_articolo, a.codice, r.descrizione, r.quantita, r.prezzo_complessivo, r.prezzo, r.prezzo_manifattura,
case when id_riga_doc_padre>0 then (select costo from riga_distinta rd, distinta ds,  riga_documento r2 
where rd.id_articolo=r.id_articolo and  ds.id_articolo=r2.id_articolo and r2.id_riga_documento= r.id_riga_doc_padre and ds.id_distinta=rd.id_distinta) else 0 end,

(select r3.id_articolo from  riga_documento r3 
where r3.id_riga_documento= r.id_riga_doc_padre )as c_id_art_padre

 FROM riga_documento r, documento d, articolo a where d.id_documento=r.id_documento
and d.id_prof_documento=127 and d.data_documento>=20220201 and a.id_articolo=r.id_articolo order by d.data_documento desc, r.num_riga asc
" filter=" riga_documento_id_riga_doc_padre >0 and ( left(articolo_codice, 2)= 'SA' or  left(articolo_codice, 2)= 'SP')")
