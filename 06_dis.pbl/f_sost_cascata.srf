global type f_sost_cascata from function_object
end type

forward prototypes
global subroutine f_sost_cascata (treeview tv_dis, long ll_root, boolean lb_con, long id, date data_inizio, date data_fine, long id_testa, string operazione, long id_articolo, long id_art_sostitutivo, date d_in_new, date d_fin_new)
end prototypes

global subroutine f_sost_cascata (treeview tv_dis, long ll_root, boolean lb_con, long id, date data_inizio, date data_fine, long id_testa, string operazione, long id_articolo, long id_art_sostitutivo, date d_in_new, date d_fin_new);
long id_base,id_f,ll_child,id_art,id_var,ll_app,ll_id_riga,ll_num_riga
boolean controllo
decimal  qt, cs
string cod,tg,pt,testa,path,des
treeviewitem tvi 
dati dat
controllo=false
string ls_fine,ls_inizio
ls_fine=string(data_fine,'yy/mm/dd')
ls_inizio=string(data_inizio,'yy/mm/dd')
DECLARE recupera CURSOR FOR
  SELECT "articolo"."codice", 
  			"articolo"."descrizione", 
  			"articolo"."id_articolo",	
			"articolo"."immagine",
			"riga_distinta"."tipo_riga",            
         "riga_distinta"."quantita",   
         "riga_distinta"."costo",    
			"riga_distinta"."id_dis_figlio",
			"riga_distinta"."id_riga_distinta",
			"riga_distinta"."num_riga"
    FROM "articolo",   
         "riga_distinta",   
       	"distinta"  ,
   WHERE ( "articolo"."id_articolo" = "riga_distinta"."id_articolo" ) and  
         ( "distinta"."id_distinta" = "riga_distinta"."id_distinta" ) and 
			(( dateformat("riga_distinta"."data_fine",'yy/mm/dd')>=:ls_inizio )and 
			( dateformat("riga_distinta"."data_fine",'yy/mm/dd')<=:ls_fine ) OR
			("riga_distinta"."data_fine"  is null) and ("riga_distinta"."data_fine" is null )) and
			(("riga_distinta"."id_distinta" =  :id_base )  or
          ("riga_distinta"."id_distinta" = :id_var and  "riga_distinta"."id_dis_var"=null) or
			 ("riga_distinta"."id_dis_var"=:id_var) and ("riga_distinta"."id_distinta" =:id_testa))  and
			("riga_distinta"."id_riga_distinta" not in (select "var_riga_distinta"."id_riga_distinta"
			from "var_riga_distinta" where "var_riga_distinta"."id_dis_variante"=:id_testa))
	ORDER BY "riga_distinta"."num_riga" ;     
ll_app=ll_root
if lb_con=true then
	select articolo.id_articolo,articolo.codice,articolo.immagine
	into:id_art,:testa,:path
	from articolo,distinta
	where distinta.id_distinta=:id
	and articolo.id_articolo=distinta.id_articolo;
	dat.quantita=1
	dat.path=path
	dat.id_dis_figlio=id
	dat.id_articolo=id_art
	dat.id_distinta=id
	tvi.data=dat
	tvi.label=testa
	tvi.pictureindex=4
	tvi.selectedpictureindex=4
	tvi.Expanded=true
	ll_root=tv_dis.insertitemfirst(0,tvi)
	ll_app=ll_root
end if
if ll_root<> -1 then
	tv_dis.getitem(ll_root,tvi)
	dat=tvi.data
	id_var=dat.id_dis_figlio
	select id_dis_base
	into :id_base
	from distinta
	where id_distinta=:id_var;
	if isnull(id_base) then id_base=id_var
end if

open recupera;
fetch recupera into :cod,:des,:id_art,:pt,:tg,:qt,:cs,:id_f,:ll_id_riga,:ll_num_riga;
do while sqlca.sqlcode=0
	if id_f>0 then controllo=true
	dat.path=pt
	if id_art=id_articolo then
		select id_distinta 
		into :id_f
		from distinta 
		where id_articolo=:id_art_sostitutivo;
		if sqlca.sqlcode<>0 then setnull(id_f)
		select codice,descrizione,immagine
		into :cod,:des,:pt
		from articolo
		where id_articolo=:id_art_sostitutivo;
		if operazione='A' then
			date data_new
			data_new=RelativeDate ( d_in_new, -1 ) 
			update riga_distinta set data_fine=:data_new
			where id_riga_distinta=:ll_id_riga;
			insert into riga_distinta 
			(id_articolo,id_dis_figlio,data_inizio,data_fine,id_distinta,num_riga,tipo_riga,quantita,costo,calo,note,id_dis_var)
			select :id_art_sostitutivo,:id_f,:d_in_new,:d_fin_new,id_distinta,num_riga,tipo_riga,quantita,costo,calo,note,id_dis_var
			from riga_distinta
			where id_riga_distinta=:ll_id_riga;
			
		else
			id_art=id_art_sostitutivo
			update riga_distinta set id_articolo=:id_art_sostitutivo,id_dis_figlio=:id_f 
			where id_riga_distinta=:ll_id_riga;
		end if
	else
		dat.id_articolo=id_art
	end if
	dat.id_dis_figlio=id_f
	dat.id_distinta=id_f
	dat.id_riga=ll_id_riga
	dat.quantita=qt
	dat.costo=cs
	dat.codice=cod
	dat.descrizione=des
	dat.tipo_riga=tg
	dat.num_riga=ll_num_riga
	if id_f>0 then
		tvi.Expanded=true
	else	
		tvi.Expanded=false
	end if
	tvi.data=dat
	tvi.label=string(ll_num_riga) +" - " +cod
	if id_f>0 then
		choose case tg
			case 'E'
				tvi.pictureindex=2
				tvi.selectedpictureindex=3
			case 'N'
				tvi.pictureindex=6
				tvi.selectedpictureindex=11
			case 'R'
				tvi.pictureindex=7
				tvi.selectedpictureindex=12
			case 'F'
				tvi.pictureindex=8
				tvi.selectedpictureindex=13
			case 'C'
				tvi.pictureindex=9
				tvi.selectedpictureindex=14
			case 'D'
				tvi.pictureindex=10
				tvi.selectedpictureindex=15
		end choose
		
		controllo=true
	else
		choose case tg
			case 'E'
				tvi.pictureindex=17
				tvi.selectedpictureindex=17
			case 'N'
				tvi.pictureindex=16
				tvi.selectedpictureindex=16
			case 'R'
				tvi.pictureindex=5
				tvi.selectedpictureindex=5
			case 'F'
				tvi.pictureindex=20
				tvi.selectedpictureindex=20
			case 'C'
				tvi.pictureindex=18
				tvi.selectedpictureindex=18
			case 'D'
				tvi.pictureindex=19
				tvi.selectedpictureindex=19
		end choose
		
	end if
	tvi.expanded=false
	ll_child=tv_dis.insertitemlast(ll_root,tvi)
	fetch recupera into :cod,:des,:id_art,:pt,:tg,:qt,:cs,:id_f,:ll_id_riga,:ll_num_riga;
loop
close recupera;

ll_root=ll_app
ll_root=tv_dis.finditem(childtreeitem!,ll_root)
do while ll_root<> -1 
	f_sost_cascata(tv_dis,ll_root,false,0,data_inizio,data_fine,id_testa,operazione,id_articolo,id_art_sostitutivo,d_in_new,d_fin_new)
	ll_root=tv_dis.finditem(Nexttreeitem!,ll_root)
loop






end subroutine

