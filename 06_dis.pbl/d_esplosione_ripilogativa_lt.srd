 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"distinta~" ) COLUMN(NAME=~"distinta.codice~") COLUMN(NAME=~"distinta.descrizione~") COMPUTE(NAME=~"cast (null as dec) as qta~") COMPUTE(NAME=~"cast (null as date) as data_in~") COMPUTE(NAME=~"cast (null as date) as data_fin~") COMPUTE(NAME=~"cast (null as dec) as quantita~") COMPUTE(NAME=~"cast (null as dec) as esistenza~") COMPUTE(NAME=~"cast (null as dec) as disponibilita~") COMPUTE(NAME=~"cast (null as char(40)) as unita_misura~") COMPUTE(NAME=~"cast (null as char(32)) as cod~") COMPUTE(NAME=~"cast (null as char(80)) as des~") COMPUTE(NAME=~"cast(null as integer) as id_articolo~")WHERE(    EXP1 =~"~~~"distinta~~~".~~~"id_distinta~~~"~"   OP =~"=~"    EXP2 =~":rn_id_distinta~" ) ) ARG(NAME = ~"rn_id_distinta~" TYPE = number) " arguments=(("rn_id_distinta", number)) )
