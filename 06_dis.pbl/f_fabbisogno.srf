global type f_fabbisogno from function_object
end type

forward prototypes
global function any f_fabbisogno (u_tv_distinta tv_dis, long ll_root, boolean lb_con, long id, date data_inizio, date data_fine, long id_testa, string tipo_calcolo, string tipo_applicazione, boolean lb_distinta, datawindow dw_esplodi, decimal quantita)
end prototypes

global function any f_fabbisogno (u_tv_distinta tv_dis, long ll_root, boolean lb_con, long id, date data_inizio, date data_fine, long id_testa, string tipo_calcolo, string tipo_applicazione, boolean lb_distinta, datawindow dw_esplodi, decimal quantita);
long id_base,id_f,ll_child,id_art,id_var,ll_app,ll_id_riga,ll_num_riga,ll_figlio,ll_id_componente
long ll_riga_trovata,ll_padre
boolean controllo
decimal{4} cs,app,qt,ld_quantita,ld_costo,ld_qt_app
string cod,tg,pt,testa,path,des,ls_cod_app
treeviewitem tvi ,ltvi_app
s_val ls_app,ls_ritorno
dati dat,dat_app
controllo=false
string ls_fine,ls_inizio
ls_fine=string(data_fine,'yy/mm/dd')
ls_inizio=string(data_inizio,'yy/mm/dd')
DECLARE recupera CURSOR FOR
  SELECT "articolo"."codice", 
  			"articolo"."descrizione", 
  			"articolo"."id_articolo",	
			"articolo"."immagine",
			"riga_distinta"."tipo_riga",            
         "riga_distinta"."quantita",   
         "riga_distinta"."costo",    
			"riga_distinta"."id_dis_figlio",
			"riga_distinta"."id_riga_distinta",
			"riga_distinta"."num_riga",
			"riga_distinta"."id_componente"
    FROM "articolo",   
         "riga_distinta",   
       	"distinta"  ,
   WHERE ( "articolo"."id_articolo" = "riga_distinta"."id_articolo" ) and  
         ( "distinta"."id_distinta" = "riga_distinta"."id_distinta" ) and 
			(( dateformat("riga_distinta"."data_fine",'yy/mm/dd')>=:ls_inizio )and 
			( dateformat("riga_distinta"."data_fine",'yy/mm/dd')<=:ls_fine ) OR
			("riga_distinta"."data_fine"  is null) and ("riga_distinta"."data_fine" is null )) and
			(("riga_distinta"."id_distinta" =  :id_base )  or
          ("riga_distinta"."id_distinta" = :id_var and  "riga_distinta"."id_dis_var"=null) or
			 ("riga_distinta"."id_dis_var"=:id_var) and ("riga_distinta"."id_distinta" =:id_testa))  and
			("riga_distinta"."id_riga_distinta" not in (select "var_riga_distinta"."id_riga_distinta"
			from "var_riga_distinta" where "var_riga_distinta"."id_dis_variante"=:id_testa))
	ORDER BY "riga_distinta"."num_riga" ;
ll_app=ll_root
if lb_con=true then
	select articolo.id_articolo,articolo.codice,articolo.immagine
	into:id_art,:testa,:path
	from articolo,distinta
	where distinta.id_distinta=:id
	and articolo.id_articolo=distinta.id_articolo;
	dat.quantita=1
	dat.path=path
	dat.id_dis_figlio=id
	dat.id_articolo=id_art
	dat.id_distinta=id
	tvi.data=dat
	tvi.label=testa
	tvi.pictureindex=4
	tvi.selectedpictureindex=4
	tvi.Expanded=true
	ll_root=tv_dis.insertitemfirst(0,tvi)
	ll_app=ll_root
end if
if ll_root<> -1 then
	tv_dis.getitem(ll_root,tvi)
	dat=tvi.data
	id_var=dat.id_dis_figlio
	select id_dis_base
	into :id_base
	from distinta
	where id_distinta=:id_var;
	if isnull(id_base) then id_base=id_var
end if

open recupera;
fetch recupera into :cod,:des,:id_art,:pt,:tg,:qt,:cs,:id_f,:ll_id_riga,:ll_num_riga,:ll_id_componente;
do while sqlca.sqlcode=0	
	if sqlca.sqlcode=0 then 
		if id_f>0 then controllo=true
		if ll_id_componente>0 and not isnull(ll_id_componente) then
			long ll_art_comp,ll_comp,i
			for i=1 to upperbound(tv_dis.is_comp) 
				ll_comp=tv_dis.is_comp[i].id_componente
				if ll_comp=ll_id_componente then
					ll_art_comp=tv_dis.is_comp[i].id_articolo					
					select codice,descrizione
					into :cod,:des
					from articolo
					where id_articolo=:ll_art_comp;
					select id_distinta
					into :id_f
					from distinta
					where id_articolo=:ll_art_comp;
					if sqlca.sqlcode=0 then 
						controllo=true
					else
						setnull(id_f)
					end if
					exit
				end if
				
			next
		end if
		dat.path=pt
		dat.id_articolo=id_art
		dat.id_dis_figlio=id_f
		dat.id_distinta=id_f
		dat.id_riga=ll_id_riga
		dat.quantita=qt
		dat.costo=cs
		dat.codice=cod
		dat.descrizione=des
		dat.tipo_riga=tg
		dat.num_riga=ll_num_riga
		
		if isnull(cs) then cs=0			
		if id_f>0 then
			tvi.Expanded=true
		else	
			tvi.Expanded=false
		end if
		tvi.data=dat
		ll_padre=ll_root
		do while ll_padre<> -1
			tv_dis.getitem(ll_padre,ltvi_app)
			dat_app=ltvi_app.data
			ld_qt_app=dat_app.quantita
			qt=qt*ld_qt_app
			ll_padre=tv_dis.finditem(parenttreeitem!,ll_padre)
		loop
		if id_f>0 then
		else
			ll_child=tv_dis.insertitemlast(ll_root,tvi)
			ll_riga_trovata=dw_esplodi.find("id_articolo="+string(id_art),1,dw_esplodi.rowcount())
			if ll_riga_trovata>0 then
				ld_quantita=dw_esplodi.getitemnumber(ll_riga_trovata,"consumo")
				ld_quantita=ld_quantita+(qt*quantita)
				dw_esplodi.setitem(ll_riga_trovata,"consumo",ld_quantita)
			else
				ll_riga_trovata=dw_esplodi.insertrow(0)
				dw_esplodi.setitem(ll_riga_trovata,"consumo",(qt*quantita))
				dw_esplodi.setitem(ll_riga_trovata,"codice",cod)
				dw_esplodi.setitem(ll_riga_trovata,"descrizione",des)
				dw_esplodi.setitem(ll_riga_trovata,"id_articolo",id_art)
			end if
		end if
		if id_f>0 then
			choose case tg
				case 'E'
					tvi.pictureindex=2
					tvi.selectedpictureindex=3
				case 'N'
					tvi.pictureindex=6
					tvi.selectedpictureindex=11
				case 'R'
					tvi.pictureindex=7
					tvi.selectedpictureindex=12
				case 'F'
					tvi.pictureindex=8
					tvi.selectedpictureindex=13
				case 'C'
					tvi.pictureindex=9
					tvi.selectedpictureindex=14
				case 'D'
					tvi.pictureindex=10
					tvi.selectedpictureindex=15
			end choose
			
			controllo=true
		else
			choose case tg
				case 'E'
					tvi.pictureindex=17
					tvi.selectedpictureindex=17
				case 'N'
					tvi.pictureindex=16
					tvi.selectedpictureindex=16
				case 'R'
					tvi.pictureindex=5
					tvi.selectedpictureindex=5
				case 'F'
					tvi.pictureindex=20
					tvi.selectedpictureindex=20
				case 'C'
					tvi.pictureindex=18
					tvi.selectedpictureindex=18
				case 'D'
					tvi.pictureindex=19
					tvi.selectedpictureindex=19
			end choose
			
		end if
		
///
		
		
		if tg='F'  then
			s_art_fittizio ls_art,ls_art_app
			ls_art=ls_art_app
			ls_art.id_articolo=id_art
			ls_art.id_distinta=id_var
			openwithparm(w_art_fittizio_ff,ls_art)
			ls_art=message.powerobjectparm
			if isvalid(ls_art) then 
				if ls_art.id_articolo>0 then
					tvi.label=string(ll_num_riga) +" - " +ls_art.codice_art+" "+STRING(QT)
					dat.path=pt
					dat.id_articolo=ls_art.id_articolo
					select id_distinta
					into :ll_figlio
					from distinta
					where id_articolo=:ls_art.id_articolo;
					if ll_figlio<=0 then setnull(ll_figlio)
					dat.id_dis_figlio=ll_figlio
					dat.id_distinta=id_f
					dat.id_riga=ll_id_riga					
					update riga_distinta set 
					id_articolo=:ls_art.id_articolo,
					id_dis_figlio=:ll_figlio,
					tipo_riga=:ls_art.tipo_riga
					where id_riga_distinta=:ll_id_riga;					
					dat.quantita=qt
					dat.costo=cs
					dat.codice=cod
					dat.descrizione=des
					dat.tipo_riga=tg
					dat.num_riga=ll_num_riga
				end if
			end if
		end if
		
		
     
		
		
		tvi.expanded=false
		ll_child=tv_dis.insertitemlast(ll_root,tvi)
	end if
	fetch recupera into :cod,:des,:id_art,:pt,:tg,:qt,:cs,:id_f,:ll_id_riga,:ll_num_riga,:ll_id_componente;
loop
close recupera;

ll_root=ll_app
ll_root=tv_dis.finditem(childtreeitem!,ll_root)
do while ll_root<> -1 
	ls_app=f_fabbisogno(tv_dis,ll_root,false,0,data_inizio,data_fine,id_testa,tipo_calcolo,tipo_applicazione,lb_distinta,dw_esplodi,quantita)
	
	cs=ls_app.costo_componenti+ls_app.altri_costi
	tv_dis.getitem(ll_root,ltvi_app)
	dat_app=ltvi_app.data
	ll_figlio=dat_app.id_dis_figlio
	if ll_figlio>0 then
		ls_cod_app=dat_app.codice
		ltvi_app.label=string(dat_app.num_riga) +" - " +ls_cod_app+" £ "+string(cs)+" * "+string(dat_app.quantita)
		ls_app.costo_componenti=ls_app.costo_componenti*dat_app.quantita
		ls_app.altri_costi=ls_app.altri_costi*dat_app.quantita
		tv_dis.setitem(ll_root,ltvi_app)
	end if	
	ll_root=tv_dis.finditem(Nexttreeitem!,ll_root)
	ls_ritorno.costo_componenti=ls_app.costo_componenti+ls_ritorno.costo_componenti
	ls_ritorno.altri_costi=ls_app.altri_costi+ls_ritorno.altri_costi
loop
return ls_ritorno




end function

