 column=(type=decimal(4) updatewhereclause=yes name=riga_distinta_quantita dbname="riga_distinta.quantita" initial="1" )
 column=(type=char(32767) updatewhereclause=yes name=csost dbname="sost" )
 column=(type=long updatewhereclause=yes name=criga_sost dbname="riga_sost" )
 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"riga_distinta~" )  TABLE(NAME=~"articolo~" ) COLUMN(NAME=~"riga_distinta.num_riga~") COLUMN(NAME=~"riga_distinta.id_riga_distinta~") COLUMN(NAME=~"riga_distinta.id_distinta~") COLUMN(NAME=~"riga_distinta.id_articolo~") COLUMN(NAME=~"riga_distinta.id_dis_figlio~") COLUMN(NAME=~"riga_distinta.tipo_riga~") COLUMN(NAME=~"riga_distinta.costo~") COLUMN(NAME=~"riga_distinta.calo~") COLUMN(NAME=~"riga_distinta.note~") COLUMN(NAME=~"riga_distinta.data_inizio~") COLUMN(NAME=~"riga_distinta.data_fine~") COLUMN(NAME=~"riga_distinta.id_dis_var~") COLUMN(NAME=~"articolo.codice~") COLUMN(NAME=~"articolo.descrizione~") COLUMN(NAME=~"riga_distinta.quantita~") COMPUTE(NAME=~"cast(null as char) as sost~") COMPUTE(NAME=~"cast(null as integer) as riga_sost~")    JOIN (LEFT=~"articolo.id_articolo~"    OP =~"=~"RIGHT=~"riga_distinta.id_articolo~" )) " )
