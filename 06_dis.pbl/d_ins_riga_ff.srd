 column=(type=decimal(4) updatewhereclause=yes name=riga_distinta_costo dbname="riga_distinta.costo" )
 column=(type=decimal(2) updatewhereclause=yes name=riga_distinta_calo dbname="riga_distinta.calo" )
 column=(type=char(32766) updatewhereclause=no name=riga_distinta_note dbname="riga_distinta.note" )
