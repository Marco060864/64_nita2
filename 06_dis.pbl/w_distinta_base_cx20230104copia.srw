type tv_1 from u_tv_distinta within tabpage_3
integer x = 23
integer y = 180
integer width = 1545
integer height = 1300
integer taborder = 2
end type

event selectionchanged;
treeviewitem ltvi_imm
dati dat
integer li_ret
string ls_imm,ls_cod,ls_path,ls_app
boolean lb_esiste
if tab_1.tabpage_3.cbx_2.checked=true then
	select dir_immagini
	into :ls_path
	from par_sistema;
	if sqlca.sqlcode<>0 then ls_path="c:\"
	
	li_ret=this.getitem(newhandle,ltvi_imm)
	if li_ret=1 then
		dat=ltvi_imm.data
		ls_imm=dat.path
		ls_cod=dat.codice
		tab_1.tabpage_3.ole_2.object.aspectratio=1
		ls_app=ls_path+'\'+ls_imm
		lb_esiste=fileexists(ls_app)
		if lb_esiste=false then			
			ls_imm=ls_path+"\"+ls_cod+'.bmp'
			lb_esiste=fileexists(ls_imm)
		end if
		if lb_esiste=true then
			ls_imm=ls_app
			tab_1.tabpage_3.ole_2.object.loadimage=ls_imm
			sle_1.text=ls_imm
		else
			tab_1.tabpage_3.ole_2.object.DelImage = True
			if ls_imm="" or isnull(ls_imm) then
				sle_1.text="L'articolo non ha nessuna immagine associata!"
			else
				sle_1.text="L'immagine "+ls_imm+" associata all'articolo non esiste!"
			end if
		end if
	end if
end if
end event

event itemexpanding;call super::itemexpanding;
end event

event losefocus;call super::losefocus;mle_1.visible=false
end event

event rightclicked;call super::rightclicked;
treeviewitem ltvi_inf
string ls_cod,ls_des
decimal ld_costo
integer li_con
dati dat
li_con=getitem(handle,ltvi_inf)
if li_con=1 then
	mle_1.visible=true
	mle_1.move(tv_1.pointerX()+50,tv_1.pointerY())
	dat=ltvi_inf.data
	ls_cod=dat.codice
	ls_des=dat.descrizione
	ld_costo=dat.costo
	if isnull(ls_cod) then ls_cod=" "
	if isnull(ls_des) then ls_des=" "
	if isnull(ld_costo) then ld_costo=0
	mle_1.text="Codice:"+ls_cod+"~r~nDescrizione:"+ls_des+"~r~nCosto:"+string(ld_costo)
else
	mle_1.visible=false
end if
end event

event clicked;call super::clicked;mle_1.visible=false
end event

