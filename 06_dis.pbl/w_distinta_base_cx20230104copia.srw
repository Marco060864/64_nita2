tv_sost.ib_completa=true
testa=tab_1.tabpage_1.dw_distinta_base_ff.getitemstring(1,"articolo_codice")
id_art=tab_1.tabpage_1.dw_distinta_base_ff.getitemnumber(1,"id_articolo")
id=tab_1.tabpage_1.dw_distinta_base_ff.getitemnumber(1,"id_distinta")
dat.path=tab_1.tabpage_1.dw_distinta_base_ff.getitemstring(1,"articolo_immagine")
tab_1.tabpage_5.tv_sost.DeleteItem (0 )
if testa<>"" and isnull(testa)=false then
	dat.quantita=1
	dat.id_dis_figlio=id
	dat.id_distinta=id
	dat.id_articolo=id_art
	tvi_esplodi.data=dat
	tvi_esplodi.label=testa
	tvi_esplodi.pictureindex=4
	tvi_esplodi.selectedpictureindex=4
	tvi_esplodi.Expanded=true
	ll_root=tab_1.tabpage_5.tv_sost.insertitemfirst(0,tvi_esplodi)
end if
treeview t
t=tab_1.tabpage_5.tv_sost
integer li_anno
li_anno=year(today())
open(w_data_val_ff)
dat=message.powerobjectparm
date ld_1,ld_2
ld_1=dat.data_inizio
ld_2=dat.data_fine
if isnull(ld_1) then ld_1=date('01/01/'+string(li_anno))
if isnull(ld_2) then ld_2=date('31/12/'+string(li_anno))
sle_8.text=string(ld_1,'dd/mm/yyyy')
sle_9.text=string(ld_2,'dd/mm/yyyy')	
f_rec_righe(t,1,false,id,ld_1,ld_2,id,true)


dw_1.insertrow(1)
cb_15.enabled=true
cb_16.enabled=true
end event

type cb_15 from commandbutton within tabpage_5
integer x = 1079
integer y = 252
integer width = 265
integer height = 92
integer taborder = 11
boolean bringtotop = true
integer textsize = -8
integer weight = 400
fontpitch fontpitch = variable!
fontfamily fontfamily = swiss!
string facename = "Arial"
boolean enabled = false
string text = "Aggiungi"
end type

event clicked;
long ll_dimensione,ll_root,id_testa,id_articolo,id_art_sostitutivo,handle,id_art,id
treeviewitem ltvi_sost
dati dat
date ld_1,ld_2,ld_in,ld_fin
string testa
ld_in=dw_1.getitemdate(1,"data_inizio")
ld_fin=dw_1.getitemdate(1,"data_fine")
if not isnull(ld_in) and not isnull(ld_fin) then
	ld_1=date(sle_8.text)
	ld_2=date(sle_9.text)
	id_testa=tab_1.tabpage_1.dw_distinta_base_ff.getitemnumber(1,"id_distinta")
	handle=tv_sost.finditem(currenttreeitem!,0)
	if handle<> -1 then
		tv_sost.getitem(handle,ltvi_sost)
		dat=ltvi_sost.data
		id_articolo=dat.id_articolo
		
		id_art_sostitutivo=dw_sost_cascata.getitemnumber(dw_sost_cascata.getrow(),"sostituzione_id_art_sostitutivo")
		if id_art_sostitutivo>0 then
			testa=tab_1.tabpage_1.dw_distinta_base_ff.getitemstring(1,"articolo_codice")
			id_art=tab_1.tabpage_1.dw_distinta_base_ff.getitemnumber(1,"id_articolo")
			id=tab_1.tabpage_1.dw_distinta_base_ff.getitemnumber(1,"id_distinta")
			dat.path=tab_1.tabpage_1.dw_distinta_base_ff.getitemstring(1,"articolo_immagine")
			tv_sost.DeleteItem (0 )
			if testa<>"" and isnull(testa)=false then
				dat.quantita=1
				dat.id_dis_figlio=id
				dat.id_distinta=id
				dat.id_articolo=id_art
				ltvi_sost.data=dat
				ltvi_sost.label=testa
				ltvi_sost.pictureindex=4
				ltvi_sost.selectedpictureindex=4
				ltvi_sost.Expanded=true
				ll_root=tv_sost.insertitemfirst(0,ltvi_sost)
			end if
			
			f_sost_cascata(tv_sost,ll_root,false,0,ld_1,ld_2,id_testa,'A',id_articolo,id_art_sostitutivo,ld_in,ld_fin)
			tv_sost.deleteitem(0)
			
			f_rec_righe(tv_sost,1,true,id_testa,ld_1,ld_2,id_testa,true)
			ll_dimensione= upperbound(is_oper_sost)
			is_oper_sost[ll_dimensione + 1]='A'
		end if
	end if
	tab_1.tabpage_2.dw_riga_dis_base_lt.retrieve(id_testa)
else
	messagebox("Informazione","Si devono inserire le nuove date di validazione ~r~nper il nuovo articolo.")
end if
end event

