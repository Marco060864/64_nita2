event clicked;
string testa
treeviewitem tvi_esplodi
long ll_root,id,id_art,ll_valuta,ll_id_sog_commerciale
dati dat
tv_1.ib_completa=true
testa=tab_1.tabpage_1.dw_distinta_base_ff.getitemstring(1,"articolo_codice")
id_art=tab_1.tabpage_1.dw_distinta_base_ff.getitemnumber(1,"id_articolo")
id=tab_1.tabpage_1.dw_distinta_base_ff.getitemnumber(1,"id_distinta")
dat.path=tab_1.tabpage_1.dw_distinta_base_ff.getitemstring(1,"articolo_immagine")
tab_1.tabpage_3.tv_1.DeleteItem (0 )
if testa<>"" and isnull(testa)=false then
	dat.quantita=1
	dat.peso_netto=0	
	dat.id_dis_figlio=id
	dat.id_distinta=id
	dat.id_articolo=id_art
	tvi_esplodi.data=dat
	tvi_esplodi.label=testa
	tvi_esplodi.pictureindex=4
	tvi_esplodi.selectedpictureindex=4
	tvi_esplodi.Expanded=true
	ll_root=tab_1.tabpage_3.tv_1.insertitemfirst(0,tvi_esplodi)
end if
treeview t
t=tab_1.tabpage_3.tv_1
integer li_anno
long ll_magazzino,ll_row
string tipo_calcolo,tipo_applicazione
li_anno=year(today())
open(w_data_val_ff)
dat=message.powerobjectparm
date ld_1,ld_2
ld_1=dat.data_inizio
ld_2=dat.data_fine
if isnull(ld_1) then ld_1=date('01/01/'+string(li_anno))
if isnull(ld_2) then ld_2=date('31/12/'+string(li_anno))
if ib_visualizza_prezzo=false then
	f_rec_righe(t,1,false,id,ld_1,ld_2,id,false)
else
	tipo_calcolo=tab_1.tabpage_1.dw_distinta_base_ff.getitemstring(1,"tipo_cal_valore")
	tipo_applicazione=tab_1.tabpage_1.dw_distinta_base_ff.getitemstring(1,"tipo_applicazione")
	ll_row=tab_1.tabpage_3.dw_mag.getrow()
	ll_magazzino=tab_1.tabpage_3.dw_mag.getitemnumber(1,"magazzino")
	ll_valuta=tab_1.tabpage_1.dw_distinta_base_ff.getitemnumber(1,"distinta_id_valuta")
	if isnull(ll_valuta) then
		select id_valuta
		into :ll_valuta
		from par_sistema;
	end if
	ll_id_sog_commerciale=tab_1.tabpage_1.dw_distinta_base_ff.getitemnumber(1,"id_sog_commerciale")
	     
	f_valorizza_comp(t,1,false,id,ld_1,ld_2,id,tipo_calcolo,tipo_applicazione,ll_magazzino,false,ll_valuta,ll_id_sog_commerciale)
end if
tab_1.tabpage_2.dw_riga_dis_base_lt.retrieve(id)

end event

