type cb_var_batch from commandbutton within tabpage_4
integer x = 1029
integer y = 128
integer width = 389
integer height = 92
integer taborder = 32
boolean bringtotop = true
integer textsize = -8
integer weight = 400
fontcharset fontcharset = ansi!
fontpitch fontpitch = variable!
fontfamily fontfamily = swiss!
string facename = "Arial"
string text = "Variante Batch"
end type

event clicked;integer li_anno
dati dat
date ld_1,ld_2
string ls_parametri
long ll_distinta 
u_tv_distinta luo_distinta
tv_variante.deleteitem(0)
ll_distinta=tab_1.tabpage_1.dw_distinta_base_ff.getitemnumber(1,"id_distinta")
if ll_distinta>0 and not isnull(ll_distinta) then	
	li_anno=year(today())
	open(w_data_val_ff)
	dat=message.powerobjectparm
	ld_1=dat.data_inizio
	ld_2=dat.data_fine
	if isnull(ld_1) then ld_1=date('01/01/'+string(li_anno))
	if isnull(ld_2) then ld_2=date('31/12/'+string(li_anno))
	sle_2.text=string(ld_1,'dd/mm/yyyy')
	sle_3.text=string(ld_2,'dd/mm/yyyy')
	f_rec_righe_comp(tv_variante,0,true,ll_distinta,ld_1,ld_2,ll_distinta,false)
	if upperbound(tv_variante.is_comp) >0 then 
		luo_distinta=create u_tv_distinta
		luo_distinta.is_comp=tv_variante.is_comp		
		openwithparm(w_variante_comp_ff,luo_distinta)
		luo_distinta=message.powerobjectparm
		if isvalid(luo_distinta) then
			
			string new_codice, cod_art_comp, cod_art, cod_dis,cod_art_padre
			int i
			for i=1 to UpperBound (luo_distinta.is_comp)
				select codice
				into :cod_art_comp
				from articolo
				where id_articolo = :luo_distinta.is_comp[i].id_articolo;
				if len(cod_art_comp) >3 then
					cod_art_comp=left(cod_art_comp,3)
				end if
				new_codice+=cod_art_comp;
			next
			cod_art_padre=tab_1.tabpage_1.dw_distinta_base_ff.getitemstring(1,"articolo_codice")
			cod_dis=tab_1.tabpage_1.dw_distinta_base_ff.getitemstring(1,"codice")
			cod_art=cod_art_padre+"\" + new_codice
			cod_dis+="\" + new_codice
			long id_dis
			select id_distinta
			into :id_dis
			from distinta
			where codice=:cod_dis;
			if ((sqlca.sqlcode=0) and (id_dis>0)) then
				messagebox("Errore","Distinta già esistente")
				return
			end if
			long id_art
			select id_articolo
			into :id_art
			from articolo
			where codice=:cod_art;
			if ((sqlca.sqlcode=0) and (id_art>0)) then					
			else
				id_art=crea_articolo(cod_art_padre,cod_art)
			end if
			long id_dis_var
			id_dis_var=crea_distinta(id_art,ll_distinta,cod_art)
			
			if isvalid(luo_distinta) then 
				tv_variante.is_comp=luo_distinta.is_comp
				destroy luo_distinta;
			else
				messagebox("Errore","Si e verificato un errore nel passaggio di parametri")
				destroy luo_distinta;
				return
			end if
			tv_variante.deleteitem(0)
			f_riesplodi_righe(tv_variante,0,true,ll_distinta,ld_1,ld_2,ll_distinta,false,id_art,id_dis_var)
		end if 
	else
		messagebox("Informazione","Impossibile creare una variante batch la distinta non contiene nessun articolo neutro!",information!)
	end if
end if

end event

