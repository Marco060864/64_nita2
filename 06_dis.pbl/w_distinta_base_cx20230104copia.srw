event ue_insert;call super::ue_insert;
datetime ldt_data
ldt_data=datetime(today(),now())
long ll_row
ll_row=this.getrow()
this.setitem(ll_row,"data_ora_creazione",ldt_data)
this.setitem(ll_row,"data_ora_ult_cambiamento",ldt_data)
