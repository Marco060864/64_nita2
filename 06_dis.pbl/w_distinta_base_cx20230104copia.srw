event ue_use_search;call super::ue_use_search;
CHOOSE CASE as_nomecol
	CASE "codice"
		uf_set_colval(as_nomecol, is_ricpar.s_main_value)
		uf_set_colval("sostituzione_id_art_sostitutivo", is_ricpar.s_id_seg_value[1])
		uf_set_colval("descrizione", is_ricpar.s_ausil_value[1])
		tab_1.tabpage_4.dw_sost.SetItemStatus (this.getrow(), 0, primary!, notmodified! )
	CASE "descrizione"
		uf_set_colval(as_nomecol, is_ricpar.s_main_value)
		uf_set_colval("sostituzione_id_art_sostitutivo", is_ricpar.s_id_seg_value[1])
		uf_set_colval("codice", is_ricpar.s_ausil_value[1])
		tab_1.tabpage_4.dw_sost.SetItemStatus (this.getrow(), 0, primary!, notmodified! )
END CHOOSE
end event

event ue_set_search;call super::ue_set_search;CHOOSE CASE as_nomecol
	CASE "codice"
			is_search_window = "w_ric_articolo_sw"
			is_ricpar.s_filter_value = as_valcol
			is_ricpar.s_filter_name ="codice"
	CASE "descrizione"
			is_search_window = "w_ric_articolo_sw"
			is_ricpar.s_filter_value = as_valcol
			is_ricpar.s_filter_name ="descrizione"
END CHOOSE
end event

event itemchanged;call super::itemchanged;string		ls_dbc[], ls_dbv[], ls_dwc[]
integer li_ok
CHOOSE CASE dwo.name
	case "codice"
		ls_dbc[1] = "id_articolo"
		ls_dbc[2] = "codice"
		ls_dbc[3] = "descrizione"
		ls_dwc[1] = "id_articolo"
		ls_dwc[2] = "articolo_codice"
		ls_dwc[3] = "articolo_descrizione"
		li_ok = uf_autofind_col (string(dwo.name),"articolo","codice","A",data,"",3,ls_dbc,ls_dbv,ls_dwc)
	case "descrizione"
		ls_dbc[1] = "id_articolo"
		ls_dbc[2] = "codice"
		ls_dbc[3] = "descrizione"
		ls_dwc[1] = "id_articolo"
		ls_dwc[2] = "articolo_codice"
		ls_dwc[3] = "articolo_descrizione"
		li_ok = uf_autofind_col (string(dwo.name),"articolo","descrizione","A",data,"",3,ls_dbc,ls_dbv,ls_dwc)

end choose
end event

type cb_8 from commandbutton within tabpage_4
integer x = 1033
integer y = 1056
integer width = 389
integer height = 92
integer taborder = 24
boolean bringtotop = true
integer textsize = -8
integer weight = 400
fontpitch fontpitch = variable!
fontfamily fontfamily = swiss!
string facename = "Arial"
string text = "Undo"
end type

event clicked;
long ll_dimensione,i,ll_app[]
string ls_app[],ls_app2[]
boolean lb_esplodi
dati dat
treeviewitem tvi_esplodi
integer li_anno
date ld_1,ld_2
long ll_righe,ll_riga,ll_dis
string ls_stato
long ll_dim,ll_nriga,ll_dis_testa
lb_esplodi=false
ll_dimensione=upperbound(is_operazione)
if ll_dimensione>0 then
	choose case is_operazione[ll_dimensione]
		case 'A'
			lb_esplodi=true
			ll_righe=ids_righe.rowcount()
			if ll_righe>0 then
				ids_righe.deleterow(ll_righe)
				ids_righe.update(true,true)
			end if
		case 'T'
			ll_riga=ids_testa.rowcount()
			ids_testa.deleterow(ll_riga)
			ids_testa.update(true,true)
			tv_variante.deleteitem(0)
			
			cb_4.enabled=false
			cb_7.enabled=false
			cb_elimina.enabled=false
			cb_sostituisci.enabled=false
			cb_agg_riga.enabled=false	
		case 'S'
			lb_esplodi=true
			FOR i=1 TO ll_dimensione - 1
				ls_app[i]=is_operazione[i]
			NEXT
			is_operazione=ls_app
			lb_esplodi=true
			ll_righe=ids_righe.rowcount()
			if ll_righe>0 then
				ids_righe.deleterow(ll_righe)
				ids_righe.update(true,true)
			end if
			ls_app=ls_app2
			ll_dimensione=upperbound(is_operazione)
			FOR i=1 TO ll_dimensione - 1
				ls_app[i]=is_operazione[i]
			NEXT
			is_operazione=ls_app
			lb_esplodi=true
			ll_dim=upperbound(is_eliminate)
			ll_nriga=is_eliminate[ll_dim]
			ll_dis_testa=ids_testa.getitemnumber(1,"id_distinta")
			delete from var_riga_distinta 
			where id_dis_variante=:ll_dis_testa
			and id_riga_distinta=:ll_nriga;
			
			if ll_dim >1 then
				FOR i=1 TO ll_dim - 1
					ll_app[i]=is_eliminate[i]
				NEXT
			end if
			is_eliminate=ll_app
		case 'E'
			lb_esplodi=true
			ll_dim=upperbound(is_eliminate)
			ll_nriga=is_eliminate[ll_dim]
			ll_dis_testa=ids_testa.getitemnumber(1,"id_distinta")
			delete from var_riga_distinta 
			where id_dis_variante=:ll_dis_testa
			and id_riga_distinta=:ll_nriga;
			
			if ll_dim >1 then
				FOR i=1 TO ll_dim - 1
					ll_app[i]=is_eliminate[i]
				NEXT
			end if
			is_eliminate=ll_app
			
	end choose
			
end if	

ls_app=ls_app2
ll_dimensione=upperbound(is_operazione)
if ll_dimensione >1 then
	FOR i=1 TO ll_dimensione - 1
		ls_app[i]=is_operazione[i]
	NEXT
end if
is_operazione=ls_app

if lb_esplodi=true then
	wf_esplodi_distinta()
end if
end event

