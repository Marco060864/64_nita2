 column=(type=char(32) updatewhereclause=yes name=articolo_codice dbname="articolo.codice" )
 column=(type=char(80) updatewhereclause=yes name=articolo_descrizione dbname="articolo.descrizione" )
 column=(type=char(255) updatewhereclause=yes name=articolo_immagine dbname="articolo.immagine" )
 column=(type=long update=yes updatewhereclause=yes name=id_azienda dbname="distinta.id_azienda" initial="1" )
 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"distinta~" )  TABLE(NAME=~"articolo~" ) COLUMN(NAME=~"distinta.codice~") COLUMN(NAME=~"distinta.descrizione~") COLUMN(NAME=~"distinta.id_articolo~") COLUMN(NAME=~"distinta.ricarico~") COLUMN(NAME=~"distinta.calo~") COLUMN(NAME=~"distinta.data_ora_creazione~") COLUMN(NAME=~"distinta.data_ora_ult_cambiamento~") COLUMN(NAME=~"distinta.data_ora_ult_agg~") COLUMN(NAME=~"distinta.tipo_aggiornamento~") COLUMN(NAME=~"distinta.tipo_cal_valore~") COLUMN(NAME=~"distinta.tipo_applicazione~") COLUMN(NAME=~"distinta.id_dis_base~") COLUMN(NAME=~"distinta.id_distinta~") COLUMN(NAME=~"articolo.codice~") COLUMN(NAME=~"articolo.descrizione~") COLUMN(NAME=~"articolo.immagine~") COLUMN(NAME=~"distinta.id_azienda~")    JOIN (LEFT=~"articolo.id_articolo~"    OP =~"=~"RIGHT=~"distinta.id_articolo~" )WHERE(    EXP1 =~"~~~"distinta~~~".~~~"id_distinta~~~"~"   OP =~"=~"    EXP2 =~":rn_id_distinata~" ) ) ARG(NAME = ~"rn_id_distinata~" TYPE = number) " update="distinta" updatewhere=1 updatekeyinplace=yes arguments=(("rn_id_distinata", number)) )
