 column=(type=char(32766) updatewhereclause=no name=riga_distinta_note dbname="riga_distinta.note" )
 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"unita_confezione~" )  TABLE(NAME=~"unita_misura~" )  TABLE(NAME=~"articolo~" )  TABLE(NAME=~"distinta~" )  TABLE(NAME=~"riga_distinta~" ) COLUMN(NAME=~"distinta.codice~") COLUMN(NAME=~"distinta.descrizione~") COMPUTE(NAME=~"cast(null as dec) as qta~") COMPUTE(NAME=~"cast(null as date) as data_in~") COMPUTE(NAME=~"cast(null as date) as data_fin~") COLUMN(NAME=~"articolo.codice~") COLUMN(NAME=~"articolo.descrizione~") COLUMN(NAME=~"riga_distinta.quantita~") COLUMN(NAME=~"riga_distinta.tipo_riga~") COLUMN(NAME=~"riga_distinta.calo~") COLUMN(NAME=~"riga_distinta.data_inizio~") COLUMN(NAME=~"riga_distinta.data_fine~") COLUMN(NAME=~"unita_misura.descrizione~") COLUMN(NAME=~"riga_distinta.note~")    JOIN (LEFT=~"unita_confezione.id_unita_mis_peso~"    OP =~"=~"RIGHT=~"unita_misura.id_unita_misura~"    OUTER1 =~"unita_confezione.id_unita_mis_peso~" )    JOIN (LEFT=~"riga_distinta.id_distinta~"    OP =~"=~"RIGHT=~"distinta.id_distinta~" )    JOIN (LEFT=~"riga_distinta.id_articolo~"    OP =~"=~"RIGHT=~"articolo.id_articolo~" )    JOIN (LEFT=~"unita_confezione.id_articolo~"    OP =~"=~"RIGHT=~"articolo.id_articolo~" )WHERE(    EXP1 =~"( ~~~"unita_confezione~~~".~~~"unita_base~~~"~"   OP =~"=~"    EXP2 =~"'S' )~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"( ~~~"distinta~~~".~~~"id_distinta~~~"~"   OP =~"=~"    EXP2 =~":rn_id_distinta )~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"( ( ~~~"riga_distinta~~~".~~~"data_fine~~~"~"   OP =~">=~"    EXP2 =~":rn_data_inizio )~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"( ~~~"riga_distinta~~~".~~~"data_fine~~~"~"   OP =~"<=~"    EXP2 =~":rn_data_fine )~"    LOGIC =~"or~" ) WHERE(    EXP1 =~"( ~~~"riga_distinta~~~".~~~"data_fine~~~"~"   OP =~"is~"    EXP2 =~"null)~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"( ~~~"riga_distinta~~~".~~~"data_inizio~~~"~"   OP =~"is~"    EXP2 =~"null ) )~" ) ) ARG(NAME = ~"rn_id_distinta~" TYPE = number)  ARG(NAME = ~"rn_data_inizio~" TYPE = date)  ARG(NAME = ~"rn_data_fine~" TYPE = date) " arguments=(("rn_id_distinta", number),("rn_data_inizio", date),("rn_data_fine", date)) )
