 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"riga_distinta~" )  TABLE(NAME=~"articolo~" ) COLUMN(NAME=~"riga_distinta.num_riga~") COLUMN(NAME=~"riga_distinta.id_riga_distinta~") COLUMN(NAME=~"riga_distinta.id_distinta~") COLUMN(NAME=~"riga_distinta.id_articolo~") COLUMN(NAME=~"riga_distinta.id_dis_figlio~") COLUMN(NAME=~"riga_distinta.tipo_riga~") COLUMN(NAME=~"riga_distinta.costo~") COLUMN(NAME=~"riga_distinta.calo~") COLUMN(NAME=~"riga_distinta.note~") COLUMN(NAME=~"riga_distinta.data_inizio~") COLUMN(NAME=~"riga_distinta.data_fine~") COLUMN(NAME=~"riga_distinta.id_dis_var~") COLUMN(NAME=~"articolo.codice~") COLUMN(NAME=~"articolo.descrizione~") COLUMN(NAME=~"riga_distinta.quantita~") COLUMN(NAME=~"riga_distinta.varie~") COLUMN(NAME=~"riga_distinta.id_componente~") COLUMN(NAME=~"riga_distinta.peso_netto~") COLUMN(NAME=~"riga_distinta.infilatura~")    JOIN (LEFT=~"articolo.id_articolo~"    OP =~"=~"RIGHT=~"riga_distinta.id_articolo~" )WHERE(    EXP1 =~"( ( ~~~"riga_distinta~~~".~~~"id_distinta~~~"~"   OP =~"=~"    EXP2 =~":rn_id_distinta ) )~" ) ) ARG(NAME = ~"rn_id_distinta~" TYPE = number) " update="riga_distinta" updatewhere=1 updatekeyinplace=yes arguments=(("rn_id_distinta", number))  sort="riga_distinta_num_riga A " )
