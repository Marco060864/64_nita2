table(column=(type=decimal(0) update=yes updatewhereclause=yes name=riga_distinta_num_riga dbname="riga_distinta.num_riga" )
 column=(type=long update=yes updatewhereclause=yes key=yes identity=yes name=riga_distinta_id_riga_distinta dbname="riga_distinta.id_riga_distinta" )
