 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"articolo~" ALIAS=~"articolo_a~" )  TABLE(NAME=~"distinta~" )  TABLE(NAME=~"riga_distinta~" )  TABLE(NAME=~"articolo~" ALIAS=~"articolo_b~" )  TABLE(NAME=~"unita_confezione~" ) COLUMN(NAME=~"articolo_a.codice~") COLUMN(NAME=~"articolo_a.descrizione~") COLUMN(NAME=~"articolo_a.id_articolo~") COLUMN(NAME=~"riga_distinta.num_riga~") COLUMN(NAME=~"riga_distinta.tipo_riga~") COLUMN(NAME=~"riga_distinta.quantita~") COLUMN(NAME=~"riga_distinta.costo~") COLUMN(NAME=~"riga_distinta.note~") COLUMN(NAME=~"riga_distinta.peso_netto~") COLUMN(NAME=~"riga_distinta.varie~") COLUMN(NAME=~"riga_distinta.infilatura~") COLUMN(NAME=~"articolo_b.codice~") COLUMN(NAME=~"articolo_b.descrizione~") COLUMN(NAME=~"distinta.id_distinta~") COLUMN(NAME=~"unita_confezione.peso_netto~") COLUMN(NAME=~"unita_confezione.dim_l~")    JOIN (LEFT=~"distinta.id_articolo~"    OP =~"=~"RIGHT=~"articolo_a.id_articolo~"    OUTER2 =~"articolo_a.id_articolo~" )    JOIN (LEFT=~"riga_distinta.id_distinta~"    OP =~"=~"RIGHT=~"distinta.id_distinta~"    OUTER2 =~"distinta.id_distinta~" )    JOIN (LEFT=~"riga_distinta.id_articolo~"    OP =~"=~"RIGHT=~"articolo_b.id_articolo~"    OUTER1 =~"riga_distinta.id_articolo~" )    JOIN (LEFT=~"articolo_a.id_articolo~"    OP =~"=~"RIGHT=~"unita_confezione.id_articolo~" )WHERE(    EXP1 =~"~~~"articolo_a~~~".~~~"codice~~~"~"   OP =~">=~"    EXP2 =~":da_art~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"articolo_a~~~".~~~"codice~~~"~"   OP =~"<=~"    EXP2 =~":ad_art~" ) ) ARG(NAME = ~"da_art~" TYPE = string)  ARG(NAME = ~"ad_art~" TYPE = string) " arguments=(("da_art", string),("ad_art", string))  sort="articolo_codice A riga_distinta_num_riga A " )
