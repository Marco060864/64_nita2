release 5;
datawindow(units=0 timer_interval=0 color=79741120 processing=1 print.documentname="" print.orientation = 0 print.margin.left = 110 print.margin.right = 110 print.margin.top = 97 print.margin.bottom = 97 print.paper.source = 0 print.paper.size = 0 print.prompt=no grid.lines=0 selected.mouse=no )
header(height=73 color="553648127" )
summary(height=1 color="553648127" )
footer(height=117 color="536870912" )
detail(height=73 color="553648127" )
table(column=(type=long update=yes updatewhereclause=yes identity=yes name=id_mov_contabile dbname="mov_contabile.id_mov_contabile" )
 column=(type=long update=yes updatewhereclause=yes name=id_reg_pd dbname="mov_contabile.id_reg_pd" )
 column=(type=decimal(0) update=yes updatewhereclause=yes name=numero dbname="mov_contabile.numero" validation="real(gettext())  >= 0 and real(gettext()) <= 8999" validationmsg="'Immettere un valore compreso tra 0 e 8999'" )
 column=(type=long update=yes updatewhereclause=yes name=id_conto dbname="mov_contabile.id_conto" )
 column=(type=long update=yes updatewhereclause=yes name=id_valuta dbname="mov_contabile.id_valuta" )
 column=(type=decimal(4) update=yes updatewhereclause=yes name=cambio dbname="mov_contabile.cambio" validation=" real(gettext())  >= 0" validationmsg="'Immettere un valore >= 0'" )
 column=(type=decimal(4) update=yes updatewhereclause=yes name=dare dbname="mov_contabile.dare" )
 column=(type=decimal(4) update=yes updatewhereclause=yes name=avere dbname="mov_contabile.avere" )
 column=(type=date update=yes updatewhereclause=yes name=data_val_banca dbname="mov_contabile.data_val_banca" )
 column=(type=date update=yes updatewhereclause=yes name=data_inizio_competenza dbname="mov_contabile.data_inizio_competenza" )
 column=(type=date update=yes updatewhereclause=yes name=data_fine_competenza dbname="mov_contabile.data_fine_competenza" )
 column=(type=long update=yes updatewhereclause=yes name=id_azienda dbname="mov_contabile.id_azienda" initial="1" )
 column=(type=char(8) updatewhereclause=yes name=conto_codice dbname="conto.codice" )
 column=(type=char(40) updatewhereclause=yes name=conto_descrizione dbname="conto.descrizione" )
 column=(type=char(4) updatewhereclause=yes name=valuta_codice dbname="valuta.codice" )
 column=(type=char(40) updatewhereclause=yes name=valuta_descrizione dbname="valuta.descrizione" )
 column=(type=char(40) update=yes updatewhereclause=yes name=mov_contabile_des_contabile dbname="mov_contabile.des_contabile" )
 column=(type=char(1) update=yes updatewhereclause=yes name=mov_contabile_rateo_risconto dbname="mov_contabile.rateo_risconto" values="Non Gestito	N/Rateo	T/Risconto	S/" )
 column=(type=real updatewhereclause=yes name=ceuro dbname="euro" )
 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"mov_contabile~" )  TABLE(NAME=~"conto~" )  TABLE(NAME=~"valuta~" ) COLUMN(NAME=~"mov_contabile.id_mov_contabile~") COLUMN(NAME=~"mov_contabile.id_reg_pd~") COLUMN(NAME=~"mov_contabile.numero~") COLUMN(NAME=~"mov_contabile.id_conto~") COLUMN(NAME=~"mov_contabile.id_valuta~") COLUMN(NAME=~"mov_contabile.cambio~") COLUMN(NAME=~"mov_contabile.dare~") COLUMN(NAME=~"mov_contabile.avere~") COLUMN(NAME=~"mov_contabile.data_val_banca~") COLUMN(NAME=~"mov_contabile.data_inizio_competenza~") COLUMN(NAME=~"mov_contabile.data_fine_competenza~") COLUMN(NAME=~"mov_contabile.id_azienda~") COLUMN(NAME=~"conto.codice~") COLUMN(NAME=~"conto.descrizione~") COLUMN(NAME=~"valuta.codice~") COLUMN(NAME=~"valuta.descrizione~") COLUMN(NAME=~"mov_contabile.des_contabile~") COLUMN(NAME=~"mov_contabile.rateo_risconto~") COMPUTE(NAME=~"cast( 1 as real) as euro~")    JOIN (LEFT=~"conto.id_conto~"    OP =~"=~"RIGHT=~"mov_contabile.id_conto~" )    JOIN (LEFT=~"valuta.id_valuta~"    OP =~"=~"RIGHT=~"mov_contabile.id_valuta~" )WHERE(    EXP1 =~"~~~"mov_contabile~~~".~~~"id_azienda~~~"~"   OP =~"in~"    EXP2 =~"(0,1)~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"mov_contabile~~~".~~~"id_reg_pd~~~"~"   OP =~"=~"    EXP2 =~":ra_id_reg_pd~" ) ) ORDER(NAME=~"mov_contabile.numero~" ASC=yes ) ARG(NAME = ~"ra_id_reg_pd~" TYPE = number) " arguments=(("ra_id_reg_pd", number))  sort="numero A " )
