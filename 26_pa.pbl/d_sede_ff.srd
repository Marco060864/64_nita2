table(column=(type=long update=yes updatewhereclause=yes key=yes identity=yes name=id_sede dbname="sede.id_sede" dbalias=".id_sede" )
 column=(type=char(1) update=yes updatewhereclause=yes name=tipo_sede dbname="sede.tipo_sede" dbalias=".tipo_sede" initial="L" values="Legale	L/Amministrativa	A/Operativa	O/" validation=" gettext()  = 'L' OR  gettext()  = 'A' OR  gettext()  = 'O'" validationmsg="'Immettere: L, A, O'" )
 column=(type=char(40) update=yes updatewhereclause=yes name=indirizzo dbname="sede.indirizzo" dbalias=".indirizzo" )
 column=(type=char(10) update=yes updatewhereclause=yes name=cap dbname="sede.cap" dbalias=".cap" )
 column=(type=char(40) update=yes updatewhereclause=yes name=localita dbname="sede.localita" dbalias=".localita" )
 column=(type=char(5) update=yes updatewhereclause=yes name=provincia dbname="sede.provincia" dbalias=".provincia" )
 column=(type=char(5) update=yes updatewhereclause=yes name=nazione dbname="sede.nazione" dbalias=".nazione" initial="IT" )
 column=(type=long update=yes updatewhereclause=yes name=id_azienda dbname="sede.id_azienda" dbalias=".id_azienda" initial="1" )
 column=(type=char(8) update=yes updatewhereclause=yes name=num_civico dbname="sede.num_civico" dbalias=".num_civico" )
 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"sede~" ) COLUMN(NAME=~"sede.id_sede~") COLUMN(NAME=~"sede.tipo_sede~") COLUMN(NAME=~"sede.indirizzo~") COLUMN(NAME=~"sede.cap~") COLUMN(NAME=~"sede.localita~") COLUMN(NAME=~"sede.provincia~") COLUMN(NAME=~"sede.nazione~") COLUMN(NAME=~"sede.id_azienda~") COLUMN(NAME=~"sede.num_civico~")WHERE(    EXP1 =~"~~~"sede~~~".~~~"id_azienda~~~"~"   OP =~"in~"    EXP2 =~"(0,1)~" ) ) ORDER(NAME=~"sede.tipo_sede~" ASC=yes ) " update="sede" updatewhere=1 updatekeyinplace=yes )
