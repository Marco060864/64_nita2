table(column=(type=char(5) updatewhereclause=yes name=banca_appoggio_cod_abi dbname="banca_appoggio.cod_abi" validation="match( gettext() , ~"[0-9][0-9][0-9][0-9][0-9]~")" validationmsg="'Immettere cinque cifre'" )
 column=(type=char(5) updatewhereclause=yes name=banca_appoggio_cod_cab dbname="banca_appoggio.cod_cab" validation="match( gettext() , ~"[0-9][0-9][0-9][0-9][0-9]~")" validationmsg="'Immettere cinque cifre'" )
