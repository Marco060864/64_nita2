 column=(type=long update=yes updatewhereclause=yes name=banca_azienda_id_banca_appoggio dbname="banca_azienda.id_banca_appoggio" )
 column=(type=long update=yes updatewhereclause=yes name=banca_azienda_id_conto dbname="banca_azienda.id_conto" )
 column=(type=long update=yes updatewhereclause=yes name=banca_azienda_id_azienda dbname="banca_azienda.id_azienda" initial="1" )
 column=(type=char(83) updatewhereclause=yes name=cc_abi_cab_des dbname="c_abi_cab_des" )
 column=(type=char(2) update=yes updatewhereclause=yes name=banca_azienda_iban_nazione dbname="banca_azienda.iban_nazione" )
 column=(type=char(2) update=yes updatewhereclause=yes name=banca_azienda_iban_contr_internazionale dbname="banca_azienda.iban_contr_internazionale" )
 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"banca_appoggio~" )  TABLE(NAME=~"banca_azienda~" )  TABLE(NAME=~"conto~" ) COLUMN(NAME=~"banca_appoggio.cod_abi~") COLUMN(NAME=~"banca_appoggio.cod_cab~") COLUMN(NAME=~"banca_appoggio.den_abi~") COLUMN(NAME=~"banca_appoggio.den_cab~") COLUMN(NAME=~"conto.codice~") COLUMN(NAME=~"conto.descrizione~") COLUMN(NAME=~"banca_azienda.conto_corrente~") COLUMN(NAME=~"banca_azienda.cin~") COLUMN(NAME=~"banca_azienda.codice_sia~") COLUMN(NAME=~"banca_azienda.id_banca_azienda~") COLUMN(NAME=~"banca_azienda.id_banca_appoggio~") COLUMN(NAME=~"banca_azienda.id_conto~") COLUMN(NAME=~"banca_azienda.id_azienda~") COMPUTE(NAME=~"cast('' as char(83)) As c_abi_cab_des~") COLUMN(NAME=~"banca_azienda.iban_nazione~") COLUMN(NAME=~"banca_azienda.iban_contr_internazionale~")    JOIN (LEFT=~"conto.id_conto~"    OP =~"=~"RIGHT=~"banca_azienda.id_conto~"    OUTER2 =~"banca_azienda.id_conto~" )    JOIN (LEFT=~"banca_azienda.id_banca_appoggio~"    OP =~"=~"RIGHT=~"banca_appoggio.id_banca_appoggio~" )) " update="banca_azienda" updatewhere=1 updatekeyinplace=yes )
