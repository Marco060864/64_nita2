table(column=(type=long updatewhereclause=yes identity=yes name=id_reg_pd dbname="reg_pd.id_reg_pd" )
 column=(type=decimal(0) updatewhereclause=yes name=num_progressivo dbname="reg_pd.num_progressivo" )
 column=(type=date updatewhereclause=yes name=data_registrazione dbname="reg_pd.data_registrazione" )
 column=(type=decimal(4) updatewhereclause=yes name=tot_reg dbname="reg_pd.importo" )
 column=(type=decimal(4) updatewhereclause=yes name=tot_reg_val dbname="reg_pd.imp_valuta" )
 column=(type=char(40) updatewhereclause=yes name=cdesc dbname="cdesc" )
 column=(type=char(8) updatewhereclause=yes name=ccodice dbname="ccodice" )
 column=(type=decimal(0) updatewhereclause=yes name=segno_reg_iva dbname="reg_pd.segno_reg_iva" )
 column=(type=long updatewhereclause=yes name=id_valuta dbname="reg_pd.id_valuta" )
 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"mov_contabile~" )  TABLE(NAME=~"mov_iva~" )  TABLE(NAME=~"reg_pd~" ) COLUMN(NAME=~"reg_pd.id_reg_pd~") COLUMN(NAME=~"reg_pd.num_progressivo~") COLUMN(NAME=~"reg_pd.data_registrazione~") COLUMN(NAME=~"reg_pd.importo~") COLUMN(NAME=~"reg_pd.imp_valuta~") COMPUTE(NAME=~"(select descrizione from conto where id_conto=~~~"reg_pd~~~".~~~"id_conto~~~" ) as cdesc~") COMPUTE(NAME=~"(select codice from conto where id_conto=~~~"reg_pd~~~".~~~"id_conto~~~" ) as ccodice~") COLUMN(NAME=~"reg_pd.segno_reg_iva~") COLUMN(NAME=~"reg_pd.id_valuta~")    JOIN (LEFT=~"reg_pd.id_reg_pd~"    OP =~"=~"RIGHT=~"mov_iva.id_reg_pd~"    OUTER1 =~"reg_pd.id_reg_pd~" )    JOIN (LEFT=~"reg_pd.id_reg_pd~"    OP =~"=~"RIGHT=~"mov_contabile.id_reg_pd~"    OUTER1 =~"reg_pd.id_reg_pd~" )WHERE(    EXP1 =~"(ceiling(~~~"mov_contabile~~~".~~~"dare~~~") - ~~~"mov_contabile~~~".~~~"dare~~~"~"   OP =~"<>~"    EXP2 =~"0~"    LOGIC =~"or~" ) WHERE(    EXP1 =~"ceiling(~~~"mov_contabile~~~".~~~"avere~~~") - ~~~"mov_contabile~~~".~~~"avere~~~"~"   OP =~"<>~"    EXP2 =~"0~"    LOGIC =~"or~" ) WHERE(    EXP1 =~"ceiling(~~~"mov_iva~~~".~~~"imposta~~~") - ~~~"mov_iva~~~".~~~"imposta~~~"~"   OP =~"<>~"    EXP2 =~"0~"    LOGIC =~"or~" ) WHERE(    EXP1 =~"ceiling(~~~"mov_iva~~~".~~~"imponibile~~~") - ~~~"mov_iva~~~".~~~"imponibile~~~"~"   OP =~"<>~"    EXP2 =~"0)~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"year(~~~"reg_pd~~~".~~~"data_registrazione~~~")~"   OP =~"=~"    EXP2 =~"2001~" ) ) ORDER(NAME=~"reg_pd.num_progressivo~" ASC=yes )  ORDER(NAME=~"reg_pd.data_registrazione~" ASC=yes ) "  sort="num_progressivo A " )
group(level=1 header.height=84 trailer.height=0 by=("id_reg_pd" ) header.color="536870912" trailer.color="536870912"  sort="id_reg_pd A " )
