footer(height=1 color="536870912" )
detail(height=73 color="553648127" )
table(column=(type=char(4) updatewhereclause=yes name=esercizio_codice dbname="esercizio.codice" )
 column=(type=char(2) updatewhereclause=yes name=registro_tipo_registro dbname="registro.tipo_registro" values="IVA acquisti	IA/IVA vendite	IV/Manageriale	MN/Prima nota	PN/Preventivi acquisti	PA/Preventivi vendite	PV/Ordini acquisti	OA/Ordini vendite	OV/DDT acquisti	DA/DDT vendite	DV/Liste prelievo acquisti	LA/Liste prelievo vendite	LV/Generico acquisti	GA/Generico vendite	GV/" validation=" gettext()  = 'IA' OR  gettext()  = 'IV' OR  gettext()  = 'MN' OR  gettext()  = 'PN' OR  gettext()  = 'PA' OR  gettext()  = 'PV' OR  gettext()  = 'OA' OR  gettext()  = 'OV' OR  gettext()  = 'DA' OR  gettext()  = 'DV' OR  gettext()  = 'LA' OR  gettext()  = 'LV' OR  gettext()  = 'GA' OR  gettext()  = 'GV'" validationmsg="'Immettere: IA, IV, MN, PN, OA, OP, DA, DV, LA, LP, GA, GV'" )
 column=(type=decimal(0) updatewhereclause=yes name=registro_numero dbname="registro.numero" validation=" real(gettext())  >= 0" validationmsg="'Immettere un valore >= 0'" )
 column=(type=char(40) updatewhereclause=yes name=attivita_descrizione dbname="attivita.descrizione" )
 column=(type=decimal(0) update=yes updatewhereclause=yes name=reg_pd_num_progressivo dbname="reg_pd.num_progressivo" validation=" real(gettext())  >= 0" validationmsg="'Immettere un valore >= 0'" )
 column=(type=date update=yes updatewhereclause=yes name=reg_pd_data_registrazione dbname="reg_pd.data_registrazione" )
 column=(type=date update=yes updatewhereclause=yes name=reg_pd_data_competenza dbname="reg_pd.data_competenza" )
 column=(type=char(8) updatewhereclause=yes name=prof_registrazione_codice dbname="prof_registrazione.codice" )
 column=(type=char(4) updatewhereclause=yes name=valuta_codice dbname="valuta.codice" )
 column=(type=decimal(4) update=yes updatewhereclause=yes name=reg_pd_cambio dbname="reg_pd.cambio" validation=" real(gettext())  >= 0" validationmsg="'Immettere un valore >= 0'" )
 column=(type=char(40) update=yes updatewhereclause=yes name=reg_pd_descrizione dbname="reg_pd.descrizione" )
 column=(type=date update=yes updatewhereclause=yes name=reg_pd_data_documento dbname="reg_pd.data_documento" )
 column=(type=char(16) update=yes updatewhereclause=yes name=reg_pd_num_documento dbname="reg_pd.num_documento" validation=" real(gettext())  >= 0" validationmsg="'Immettere un valore >= 0'" )
 column=(type=long update=yes updatewhereclause=yes name=reg_pd_id_azienda dbname="reg_pd.id_azienda" initial="1" )
 column=(type=long updatewhereclause=yes key=yes identity=yes name=id_reg_pd dbname="reg_pd.id_reg_pd" )
 column=(type=char(40) updatewhereclause=yes name=registro_descrizione dbname="registro.descrizione" )
 column=(type=decimal(0) update=yes updatewhereclause=yes name=reg_pd_importo dbname="reg_pd.importo" validation=" real(gettext())  >= 0" validationmsg="'Immettere un valore >= 0'" )
 column=(type=char(1) update=yes updatewhereclause=yes name=reg_pd_ges_oper_intracomunitarie dbname="reg_pd.ges_oper_intracomunitarie" initial="N" values="	S/	N" validation=" gettext()  = 'S' OR  gettext()  = 'N'" validationmsg="'Immettere: S, N'" )
 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"reg_pd~" )  TABLE(NAME=~"registro~" )  TABLE(NAME=~"attivita~" )  TABLE(NAME=~"esercizio~" )  TABLE(NAME=~"prof_registrazione~" )  TABLE(NAME=~"valuta~" ) COLUMN(NAME=~"esercizio.codice~") COLUMN(NAME=~"registro.tipo_registro~") COLUMN(NAME=~"registro.numero~") COLUMN(NAME=~"attivita.descrizione~") COLUMN(NAME=~"reg_pd.num_progressivo~") COLUMN(NAME=~"reg_pd.data_registrazione~") COLUMN(NAME=~"reg_pd.data_competenza~") COLUMN(NAME=~"prof_registrazione.codice~") COLUMN(NAME=~"valuta.codice~") COLUMN(NAME=~"reg_pd.cambio~") COLUMN(NAME=~"reg_pd.descrizione~") COLUMN(NAME=~"reg_pd.data_documento~") COLUMN(NAME=~"reg_pd.num_documento~") COLUMN(NAME=~"reg_pd.id_azienda~") COLUMN(NAME=~"reg_pd.id_reg_pd~") COLUMN(NAME=~"registro.descrizione~") COLUMN(NAME=~"reg_pd.importo~") COLUMN(NAME=~"reg_pd.ges_oper_intracomunitarie~")    JOIN (LEFT=~"registro.id_registro~"    OP =~"=~"RIGHT=~"reg_pd.id_registro~" )    JOIN (LEFT=~"attivita.id_attivita~"    OP =~"=~"RIGHT=~"registro.id_attivita~" )    JOIN (LEFT=~"prof_registrazione.id_prof_registrazione~"    OP =~"=~"RIGHT=~"reg_pd.id_prof_registrazione~" )    JOIN (LEFT=~"valuta.id_valuta~"    OP =~"=~"RIGHT=~"reg_pd.id_valuta~" )    JOIN (LEFT=~"registro.id_esercizio~"    OP =~"=~"RIGHT=~"esercizio.id_esercizio~" )WHERE(    EXP1 =~"~~~"reg_pd~~~".~~~"id_azienda~~~"~"   OP =~"in~"    EXP2 =~"(0,1)~" ) ) ORDER(NAME=~"esercizio.codice~" ASC=yes )  ORDER(NAME=~"registro.tipo_registro~" ASC=yes )  ORDER(NAME=~"registro.numero~" ASC=yes )  ORDER(NAME=~"reg_pd.num_progressivo~" ASC=no) " update="reg_pd" updatewhere=1 updatekeyinplace=yes )
