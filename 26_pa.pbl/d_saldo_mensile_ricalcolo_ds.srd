//objectcomments DataWindow usata per il DataStore di w_saldo_mensile_ricalcolo_ff.
release 5;
datawindow(units=0 timer_interval=0 color=79741120 processing=1 print.documentname="" print.orientation = 0 print.margin.left = 110 print.margin.right = 110 print.margin.top = 97 print.margin.bottom = 97 print.paper.source = 0 print.paper.size = 0 print.prompt=no grid.lines=0 )
header(height=125 color="553648127" )
summary(height=1 color="536870912" )
footer(height=1 color="536870912" )
detail(height=73 color="553648127" )
table(column=(type=decimal(0) updatewhereclause=yes name=reg_pd_num_progressivo dbname="reg_pd.num_progressivo" validation=" real(gettext())  >= 0" validationmsg="'Immettere un valore >= 0'" )
 column=(type=date updatewhereclause=yes name=reg_pd_data_registrazione dbname="reg_pd.data_registrazione" )
 column=(type=date updatewhereclause=yes name=reg_pd_data_competenza dbname="reg_pd.data_competenza" )
 column=(type=decimal(0) updatewhereclause=yes name=mov_contabile_numero dbname="mov_contabile.numero" validation=" real(gettext())  >= 0" validationmsg="'Immettere un valore >= 0'" )
 column=(type=decimal(4) updatewhereclause=yes name=mov_contabile_dare dbname="mov_contabile.dare" )
 column=(type=decimal(4) updatewhereclause=yes name=mov_contabile_avere dbname="mov_contabile.avere" )
 column=(type=date updatewhereclause=yes name=mov_contabile_data_inizio_competenza dbname="mov_contabile.data_inizio_competenza" )
 column=(type=date updatewhereclause=yes name=mov_contabile_data_fine_competenza dbname="mov_contabile.data_fine_competenza" )
 column=(type=long updatewhereclause=yes name=mov_contabile_id_conto dbname="mov_contabile.id_conto" )
 column=(type=long updatewhereclause=yes identity=yes name=mov_contabile_id_mov_contabile dbname="mov_contabile.id_mov_contabile" )
 column=(type=char(2) updatewhereclause=yes name=registro_tipo_registro dbname="registro.tipo_registro" values="IVA acquisti	IA/IVA vendite	IV/IVA corrispettivi	IC/Manageriale	MN/Prima nota	PN/Prima nota chiusure	PZ/Preventivi acquisti	PA/Preventivi vendite	PV/Ordini acquisti	OA/Ordini vendite	OV/DDT acquisti	DA/DDT vendite	DV/Liste prelievo acquisti	LA/Liste prelievo vendite	LV/Generico acquisti	GA/Generico vendite	GV/" validation=" gettext()  = 'IA' OR  gettext()  = 'IV' OR  gettext()  = 'IC' OR  gettext()  = 'MN' OR  gettext()  = 'PN' OR  gettext()  = 'PZ' OR  gettext()  = 'PA' OR  gettext()  = 'PV' OR  gettext()  = 'OA' OR  gettext()  = 'OV' OR  gettext()  = 'DA' OR  gettext()  = 'DV' OR  gettext()  = 'LA' OR  gettext()  = 'LV' OR  gettext()  = 'GA' OR  gettext()  = 'GV'" validationmsg="'Immettere: IA, IV,IC , MN, PN, OA, OP, DA, DV, LA, LP, GA, GV'" )
 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"mov_contabile~" )  TABLE(NAME=~"reg_pd~" )  TABLE(NAME=~"registro~" )  TABLE(NAME=~"conto~" ) COLUMN(NAME=~"reg_pd.num_progressivo~") COLUMN(NAME=~"reg_pd.data_registrazione~") COLUMN(NAME=~"reg_pd.data_competenza~") COLUMN(NAME=~"mov_contabile.numero~") COLUMN(NAME=~"mov_contabile.dare~") COLUMN(NAME=~"mov_contabile.avere~") COLUMN(NAME=~"mov_contabile.data_inizio_competenza~") COLUMN(NAME=~"mov_contabile.data_fine_competenza~") COLUMN(NAME=~"mov_contabile.id_conto~") COLUMN(NAME=~"mov_contabile.id_mov_contabile~") COLUMN(NAME=~"registro.tipo_registro~")    JOIN (LEFT=~"reg_pd.id_reg_pd~"    OP =~"=~"RIGHT=~"mov_contabile.id_reg_pd~" )    JOIN (LEFT=~"registro.id_registro~"    OP =~"=~"RIGHT=~"reg_pd.id_registro~" )    JOIN (LEFT=~"conto.id_conto~"    OP =~"=~"RIGHT=~"mov_contabile.id_conto~" )WHERE(    EXP1 =~"~~~"registro~~~".~~~"id_esercizio~~~"~"   OP =~"=~"    EXP2 =~":id_esercizio~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"conto~~~".~~~"codice~~~"~"   OP =~">=~"    EXP2 =~":conto_cod_da~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"conto~~~".~~~"codice~~~"~"   OP =~"<=~"    EXP2 =~":conto_cod_a~" ) ) ARG(NAME = ~"id_esercizio~" TYPE = number)  ARG(NAME = ~"conto_cod_da~" TYPE = string)  ARG(NAME = ~"conto_cod_a~" TYPE = string) " arguments=(("id_esercizio", number),("conto_cod_da", string),("conto_cod_a", string))  sort="reg_pd_data_registrazione A reg_pd_num_progressivo A mov_contabile_numero A " )
