detail(height=312 color="536870912" )
table(column=(type=long update=yes updatewhereclause=yes identity=yes name=id_esercizio dbname="esercizio.id_esercizio" )
 column=(type=char(4) update=yes updatewhereclause=yes key=yes name=codice dbname="esercizio.codice" )
 column=(type=date update=yes updatewhereclause=yes name=data_inizio dbname="esercizio.data_inizio" )
 column=(type=date update=yes updatewhereclause=yes name=data_fine dbname="esercizio.data_fine" validation="gettext() >string( data_inizio )" validationmsg="'La data di fine deve essere maggiore di quella d~"inizio'" )
 column=(type=char(1) update=yes updatewhereclause=yes name=bloccato dbname="esercizio.bloccato" initial="N" values="	S/	N" validation=" gettext()  = 'S' OR  gettext()  = 'N'" validationmsg="'Immettere: S, N'" )
 column=(type=date update=yes updatewhereclause=yes name=ult_data_stampa_bollato dbname="esercizio.ult_data_stampa_bollato" )
 column=(type=decimal(0) update=yes updatewhereclause=yes name=num_progressivo dbname="esercizio.num_progressivo" validation=" real(gettext())  >= 0" validationmsg="'Immettere un valore >= 0'" )
 column=(type=long update=yes updatewhereclause=yes key=yes name=id_azienda dbname="esercizio.id_azienda" initial="1" )
 column=(type=decimal(4) update=yes updatewhereclause=yes name=riporto dbname="esercizio.riporto" )
 column=(type=char(1) update=yes updatewhereclause=yes name=prog_scritture dbname="esercizio.prog_scritture" initial="N" values="	S/	N" )
 column=(type=long update=yes updatewhereclause=yes name=id_valuta dbname="esercizio.id_valuta" )
 column=(type=char(1) updatewhereclause=yes name=sblocca dbname="sblocca" initial="N" values="Sblocca Reg.	S/Sblocca Reg.	N" )
 column=(type=char(1) update=yes updatewhereclause=yes name=stato_cespite dbname="esercizio.stato_cespite" values="Amm. Non calcolato	N/Amm. Calcolato	C/Amm. Definito	D/" )
 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"esercizio~" ) COLUMN(NAME=~"esercizio.id_esercizio~") COLUMN(NAME=~"esercizio.codice~") COLUMN(NAME=~"esercizio.data_inizio~") COLUMN(NAME=~"esercizio.data_fine~") COLUMN(NAME=~"esercizio.bloccato~") COLUMN(NAME=~"esercizio.ult_data_stampa_bollato~") COLUMN(NAME=~"esercizio.num_progressivo~") COLUMN(NAME=~"esercizio.id_azienda~") COLUMN(NAME=~"esercizio.riporto~") COLUMN(NAME=~"esercizio.prog_scritture~") COLUMN(NAME=~"esercizio.id_valuta~") COMPUTE(NAME=~"cast('N' as char(1)) as sblocca~") COLUMN(NAME=~"esercizio.stato_cespite~")WHERE(    EXP1 =~"( ~~~"esercizio~~~".~~~"id_azienda~~~"~"   OP =~"in~"    EXP2 =~"(0,1) )~" ) ) ORDER(NAME=~"esercizio.codice~" ASC=yes ) " update="esercizio" updatewhere=1 updatekeyinplace=yes )
