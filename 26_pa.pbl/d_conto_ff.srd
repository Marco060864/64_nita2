 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"conto~" )  TABLE(NAME=~"sottomastro~" )  TABLE(NAME=~"mastro~" )  TABLE(NAME=~"bilancio_cee~" ) COLUMN(NAME=~"conto.id_conto~") COLUMN(NAME=~"sottomastro.id_mastro~") COLUMN(NAME=~"conto.id_sottomastro~") COLUMN(NAME=~"conto.codice~") COLUMN(NAME=~"conto.descrizione~") COLUMN(NAME=~"conto.id_gruppo~") COLUMN(NAME=~"conto.ges_par_aperte~") COLUMN(NAME=~"conto.id_azienda~") COLUMN(NAME=~"sottomastro.uso~") COMPUTE(NAME=~"Substr(~~~"conto~~~".~~~"codice~~~",5,4)~") COLUMN(NAME=~"conto.id_bilancio_cee~") COLUMN(NAME=~"bilancio_cee.riferimento~")    JOIN (LEFT=~"bilancio_cee.id_bilancio_cee~"    OP =~"=~"RIGHT=~"conto.id_bilancio_cee~"    OUTER2 =~"conto.id_bilancio_cee~" )   JOIN (LEFT=~"sottomastro.id_sottomastro~"    OP =~"=~"RIGHT=~"conto.id_sottomastro~" )    JOIN (LEFT=~"mastro.id_mastro~"    OP =~"=~"RIGHT=~"sottomastro.id_mastro~" ) WHERE(    EXP1 =~"~~~"conto~~~".~~~"id_azienda~~~"~"   OP =~"in~"    EXP2 =~"(0,1)~" ) ) ORDER(NAME=~"conto.codice~" ASC=yes ) " update="conto" updatewhere=1 updatekeyinplace=yes )
