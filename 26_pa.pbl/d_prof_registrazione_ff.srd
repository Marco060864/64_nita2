table(column=(type=long update=yes updatewhereclause=yes identity=yes name=id_prof_registrazione dbname="prof_registrazione.id_prof_registrazione" )
 column=(type=char(8) update=yes updatewhereclause=yes key=yes name=codice dbname="prof_registrazione.codice" )
 column=(type=char(40) update=yes updatewhereclause=yes name=descrizione dbname="prof_registrazione.descrizione" )
 column=(type=char(1) update=yes updatewhereclause=yes name=tipo_registrazione dbname="prof_registrazione.tipo_registrazione" values="IVA acquisti	A/IVA vendite	V/Manageriale	M/Prima nota	P/IVA Corrispettivi	C/" )
 column=(type=long update=yes updatewhereclause=yes name=tab_iva_descrizione dbname="prof_registrazione.id_tab_iva" )
 column=(type=long update=yes updatewhereclause=yes name=id_conto_iva dbname="prof_registrazione.id_conto_iva" )
 column=(type=char(40) update=yes updatewhereclause=yes name=des_contabile dbname="prof_registrazione.des_contabile" )
 column=(type=char(1) update=yes updatewhereclause=yes name=ges_oper_intracomunitarie dbname="prof_registrazione.ges_oper_intracomunitarie" initial="N" values="	S/	N" validation=" gettext()  = 'S' OR  gettext()  = 'N'" validationmsg="'Immettere: S, N'" )
 column=(type=long update=yes updatewhereclause=yes key=yes name=id_azienda dbname="prof_registrazione.id_azienda" initial="1" )
 column=(type=char(1) update=yes updatewhereclause=yes name=prof_registrazione_usa_pagamenti dbname="prof_registrazione.usa_pagamenti" initial="N" values="	S/	N" validation=" gettext()  = 'S' OR  gettext()  = 'N'" validationmsg="'Immettere: S, N'" )
 column=(type=char(8) updatewhereclause=yes name=conto_codice dbname="conto.codice" )
 column=(type=char(40) updatewhereclause=yes name=conto_descrizione dbname="conto.descrizione" )
 column=(type=char(1) update=yes updatewhereclause=yes name=prof_registrazione_crea_partita dbname="prof_registrazione.crea_partita" initial="S" values="	S/	N" )
 column=(type=long update=yes updatewhereclause=yes name=prof_registrazione_id_mod_registro dbname="prof_registrazione.id_mod_registro" )
 column=(type=char(1) update=yes updatewhereclause=yes name=prof_registrazione_tipo_fattura dbname="prof_registrazione.tipo_fattura" initial="N" values="Normale	N/Nota di Credito	C/Nota di Debito	D/" validation=" gettext()  = 'N' OR  gettext()  = 'C' OR  gettext()  = 'D'" validationmsg="'Immettere un valore compreso tra N, C, D'" )
 column=(type=char(1) update=yes updatewhereclause=yes name=prof_registrazione_usa_con_effetti dbname="prof_registrazione.usa_con_effetti" initial="N" values="	S/	N" )
 column=(type=char(1) update=yes updatewhereclause=yes name=prof_registrazione_usa_insoluti dbname="prof_registrazione.usa_insoluti" values="	S/	N" )
 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"prof_registrazione~" )  TABLE(NAME=~"conto~" ) COLUMN(NAME=~"prof_registrazione.id_prof_registrazione~") COLUMN(NAME=~"prof_registrazione.codice~") COLUMN(NAME=~"prof_registrazione.descrizione~") COLUMN(NAME=~"prof_registrazione.tipo_registrazione~") COLUMN(NAME=~"prof_registrazione.id_tab_iva~") COLUMN(NAME=~"prof_registrazione.id_conto_iva~") COLUMN(NAME=~"prof_registrazione.des_contabile~") COLUMN(NAME=~"prof_registrazione.ges_oper_intracomunitarie~") COLUMN(NAME=~"prof_registrazione.id_azienda~") COLUMN(NAME=~"prof_registrazione.usa_pagamenti~") COLUMN(NAME=~"conto.codice~") COLUMN(NAME=~"conto.descrizione~") COLUMN(NAME=~"prof_registrazione.crea_partita~") COLUMN(NAME=~"prof_registrazione.id_mod_registro~") COLUMN(NAME=~"prof_registrazione.tipo_fattura~") COLUMN(NAME=~"prof_registrazione.usa_con_effetti~") COLUMN(NAME=~"prof_registrazione.usa_insoluti~")    JOIN (LEFT=~"prof_registrazione.id_conto_iva~"    OP =~"=~"RIGHT=~"conto.id_conto~"    OUTER1 =~"prof_registrazione.id_conto_iva~" )WHERE(    EXP1 =~"( ~~~"prof_registrazione~~~".~~~"id_azienda~~~"~"   OP =~"in~"    EXP2 =~"(0,1) )~" ) ) ORDER(NAME=~"prof_registrazione.codice~" ASC=yes ) " update="prof_registrazione" updatewhere=1 updatekeyinplace=yes )
