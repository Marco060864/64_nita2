 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"riep_iva~" )  TABLE(NAME=~"attivita~" ) COLUMN(NAME=~"riep_iva.anno~") COLUMN(NAME=~"riep_iva.id_attivita~") COLUMN(NAME=~"riep_iva.id_riepilogo_iva~") COLUMN(NAME=~"riep_iva.per_prorata~") COLUMN(NAME=~"riep_iva.id_azienda~") COLUMN(NAME=~"riep_iva.mese~") COLUMN(NAME=~"riep_iva.trimestre~") COLUMN(NAME=~"riep_iva.iva_credito~") COLUMN(NAME=~"riep_iva.iva_debito~") COLUMN(NAME=~"riep_iva.data_liq~") COLUMN(NAME=~"riep_iva.ultima_liq~") COLUMN(NAME=~"riep_iva.interessi_trim~") COLUMN(NAME=~"attivita.descrizione~") COLUMN(NAME=~"riep_iva.credito_inizio_anno~") COLUMN(NAME=~"riep_iva.plafond~") COLUMN(NAME=~"riep_iva.acconto~")    JOIN (LEFT=~"attivita.id_attivita~"    OP =~"=~"RIGHT=~"riep_iva.id_attivita~" )) ORDER(NAME=~"riep_iva.data_liq~" ASC=no) " update="riep_iva" updatewhere=1 updatekeyinplace=yes )
