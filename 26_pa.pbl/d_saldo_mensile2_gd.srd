table(column=(type=decimal(0) updatewhereclause=yes name=saldo_mensile_anno dbname="saldo_mensile.anno" )
 column=(type=char(4) updatewhereclause=yes name=esercizio_codice dbname="esercizio.codice" )
 column=(type=decimal(0) updatewhereclause=yes name=saldo_mensile_mese dbname="saldo_mensile.mese" values="Gennaio	1/Febbraio	2/Marzo	3/Aprile	4/Maggio	5/Giugno	6/Luglio	7/Agosto	8/Settembre	9/Ottobre	10/Novembre	11/Dicembre	12/" validation=" real(gettext())  >= 1 AND  real(gettext())  <= 12" validationmsg="'Immettere un mese (fra 1 e 12)'" )
 column=(type=long updatewhereclause=yes name=id_conto dbname="saldo_mensile.id_conto" )
 column=(type=long updatewhereclause=yes name=id_esercizio dbname="saldo_mensile.id_esercizio" )
 column=(type=decimal(4) updatewhereclause=yes name=csaldopm dbname="saldopm" )
 column=(type=decimal(4) updatewhereclause=yes name=csaldopmc dbname="saldopmc" )
 column=(type=decimal(4) updatewhereclause=yes name=csaldomn dbname="saldomn" )
 column=(type=decimal(4) updatewhereclause=yes name=csaldopn dbname="saldopn" )
 column=(type=decimal(4) updatewhereclause=yes name=csaldopnc dbname="saldopnc" )
 column=(type=decimal(4) updatewhereclause=yes name=csaldomnc dbname="saldomnc" )
 column=(type=decimal(4) updatewhereclause=yes name=saldo_mensile_dare dbname="saldo_mensile.dare" )
 column=(type=decimal(4) updatewhereclause=yes name=saldo_mensile_avere dbname="saldo_mensile.avere" )
 column=(type=decimal(4) updatewhereclause=yes name=saldo_mensile_dare_mn dbname="saldo_mensile.dare_mn" )
 column=(type=decimal(4) updatewhereclause=yes name=saldo_mensile_avere_mn dbname="saldo_mensile.avere_mn" )
 column=(type=decimal(4) updatewhereclause=yes name=saldo_mensile_dare_competenza dbname="saldo_mensile.dare_competenza" )
 column=(type=decimal(4) updatewhereclause=yes name=saldo_mensile_avere_competenza dbname="saldo_mensile.avere_competenza" )
 column=(type=decimal(4) updatewhereclause=yes name=saldo_mensile_dare_mn_competenza dbname="saldo_mensile.dare_mn_competenza" )
 column=(type=decimal(4) updatewhereclause=yes name=saldo_mensile_avere_mn_competenza dbname="saldo_mensile.avere_mn_competenza" )
 column=(type=long updatewhereclause=yes name=id_valuta dbname="esercizio.id_valuta" )
 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"saldo_mensile~" )  TABLE(NAME=~"esercizio~" ) COLUMN(NAME=~"saldo_mensile.anno~") COLUMN(NAME=~"esercizio.codice~") COLUMN(NAME=~"saldo_mensile.mese~") COLUMN(NAME=~"saldo_mensile.id_conto~") COLUMN(NAME=~"saldo_mensile.id_esercizio~") COMPUTE(NAME=~"SaldoPN + SaldoMN As SaldoPM~") COMPUTE(NAME=~"SaldoPNC + SaldoMNC As SaldoPMC~") COMPUTE(NAME=~"~~~"saldo_mensile~~~".~~~"dare_mn~~~" - ~~~"saldo_mensile~~~".~~~"avere_mn~~~" As SaldoMN~") COMPUTE(NAME=~"~~~"saldo_mensile~~~".~~~"dare~~~" - ~~~"saldo_mensile~~~".~~~"avere~~~" As SaldoPN~") COMPUTE(NAME=~"~~~"saldo_mensile~~~".~~~"dare_competenza~~~" - ~~~"saldo_mensile~~~".~~~"avere_competenza~~~" As SaldoPNC~") COMPUTE(NAME=~"~~~"saldo_mensile~~~".~~~"dare_mn_competenza~~~" - ~~~"saldo_mensile~~~".~~~"avere_mn_competenza~~~" As SaldoMNC~") COLUMN(NAME=~"saldo_mensile.dare~") COLUMN(NAME=~"saldo_mensile.avere~") COLUMN(NAME=~"saldo_mensile.dare_mn~") COLUMN(NAME=~"saldo_mensile.avere_mn~") COLUMN(NAME=~"saldo_mensile.dare_competenza~") COLUMN(NAME=~"saldo_mensile.avere_competenza~") COLUMN(NAME=~"saldo_mensile.dare_mn_competenza~") COLUMN(NAME=~"saldo_mensile.avere_mn_competenza~") COLUMN(NAME=~"esercizio.id_valuta~")    JOIN (LEFT=~"saldo_mensile.id_esercizio~"    OP =~"=~"RIGHT=~"esercizio.id_esercizio~" )WHERE(    EXP1 =~"( ~~~"saldo_mensile~~~".~~~"id_conto~~~"~"   OP =~"=~"    EXP2 =~":ra_conto )~" ) ) ORDER(NAME=~"saldo_mensile.anno~" ASC=no)  ORDER(NAME=~"saldo_mensile.mese~" ASC=no) ARG(NAME = ~"ra_conto~" TYPE = number) " arguments=(("ra_conto", number)) )
