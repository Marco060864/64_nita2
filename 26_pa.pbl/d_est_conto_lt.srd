release 5;
datawindow(units=0 timer_interval=0 color=79741120 processing=1 print.documentname="" print.orientation = 0 print.margin.left = 110 print.margin.right = 110 print.margin.top = 97 print.margin.bottom = 97 print.paper.source = 0 print.paper.size = 0 print.prompt=no grid.lines=0 selected.mouse=no )
header(height=137 color="536870912" )
summary(height=1 color="536870912" )
footer(height=1 color="553648127" )
detail(height=73 color="553648127" )
table(column=(type=decimal(0) updatewhereclause=yes name=reg_pd_num_progressivo dbname="reg_pd.num_progressivo" validation=" real(gettext())  >= 0" validationmsg="'Immettere un valore >= 0'" )
 column=(type=char(2) updatewhereclause=yes name=registro_tipo_registro dbname="registro.tipo_registro" values="IVA acquisti	IA/IVA vendite	IV/Manageriale	MN/Prima nota	PN/Preventivi acquisti	PA/Preventivi vendite	PV/Ordini acquisti	OA/Ordini vendite	OV/DDT acquisti	DA/DDT vendite	DV/Liste prelievo acquisti	LA/Liste prelievo vendite	LV/Generico acquisti	GA/Generico vendite	GV/" validation=" gettext()  = 'IA' OR  gettext()  = 'IV' OR  gettext()  = 'MN' OR  gettext()  = 'PN' OR  gettext()  = 'PA' OR  gettext()  = 'PV' OR  gettext()  = 'OA' OR  gettext()  = 'OV' OR  gettext()  = 'DA' OR  gettext()  = 'DV' OR  gettext()  = 'LA' OR  gettext()  = 'LV' OR  gettext()  = 'GA' OR  gettext()  = 'GV'" validationmsg="'Immettere: IA, IV, MN, PN, OA, OP, DA, DV, LA, LP, GA, GV'" )
 column=(type=char(40) updatewhereclause=yes name=reg_pd_descrizione dbname="reg_pd.descrizione" )
 column=(type=char(16) updatewhereclause=yes name=reg_pd_num_documento dbname="reg_pd.num_documento" validation=" real(gettext())  >= 0" validationmsg="'Immettere un valore >= 0'" )
 column=(type=decimal(4) updatewhereclause=yes name=mov_contabile_dare dbname="mov_contabile.dare" )
 column=(type=decimal(4) updatewhereclause=yes name=mov_contabile_avere dbname="mov_contabile.avere" )
 column=(type=date updatewhereclause=yes name=reg_pd_data_registrazione dbname="reg_pd.data_registrazione" )
 column=(type=long updatewhereclause=yes name=registro_id_esercizio dbname="registro.id_esercizio" )
 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"mov_contabile~" )  TABLE(NAME=~"reg_pd~" )  TABLE(NAME=~"registro~" ) COLUMN(NAME=~"reg_pd.num_progressivo~") COLUMN(NAME=~"registro.tipo_registro~") COLUMN(NAME=~"reg_pd.descrizione~") COLUMN(NAME=~"reg_pd.num_documento~") COLUMN(NAME=~"mov_contabile.dare~") COLUMN(NAME=~"mov_contabile.avere~") COLUMN(NAME=~"reg_pd.data_registrazione~") COLUMN(NAME=~"registro.id_esercizio~")    JOIN (LEFT=~"reg_pd.id_reg_pd~"    OP =~"=~"RIGHT=~"mov_contabile.id_reg_pd~" )    JOIN (LEFT=~"registro.id_registro~"    OP =~"=~"RIGHT=~"reg_pd.id_registro~" )WHERE(    EXP1 =~"~~~"mov_contabile~~~".~~~"id_conto~~~"~"   OP =~"=~"    EXP2 =~":al_id_conto~" ) ) ARG(NAME = ~"al_id_conto~" TYPE = number) " arguments=(("al_id_conto", number))  sort="reg_pd_data_registrazione D reg_pd_num_progressivo A registro_tipo_registro A " )
