table(column=(type=char(4) updatewhereclause=yes name=esercizio_codice dbname="esercizio.codice" )
 column=(type=char(2) updatewhereclause=yes name=registro_tipo_registro dbname="registro.tipo_registro" values="IVA acquisti	IA/IVA vendite	IV/Manageriale	MN/Prima nota	PN/Preventivi acquisti	PA/Preventivi vendite	PV/Ordini acquisti	OA/Ordini vendite	OV/DDT acquisti	DA/DDT vendite	DV/Liste prelievo acquisti	LA/Liste prelievo vendite	LV/Generico acquisti	GA/Generico vendite	GV/" validation=" gettext()  = 'IA' OR  gettext()  = 'IV' OR  gettext()  = 'MN' OR  gettext()  = 'PN' OR  gettext()  = 'PA' OR  gettext()  = 'PV' OR  gettext()  = 'OA' OR  gettext()  = 'OV' OR  gettext()  = 'DA' OR  gettext()  = 'DV' OR  gettext()  = 'LA' OR  gettext()  = 'LV' OR  gettext()  = 'GA' OR  gettext()  = 'GV'" validationmsg="'Immettere: IA, IV, MN, PN, OA, OP, DA, DV, LA, LP, GA, GV'" )
 column=(type=decimal(0) updatewhereclause=yes name=registro_numero dbname="registro.numero" validation=" real(gettext())  >= 0" validationmsg="'Immettere un valore >= 0'" )
 column=(type=decimal(0) update=yes updatewhereclause=yes name=reg_pd_num_progressivo dbname="reg_pd.num_progressivo" validation=" real(gettext())  >= 0" validationmsg="'Immettere un valore >= 0'" )
