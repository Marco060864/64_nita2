 column=(type=char(1) update=yes updatewhereclause=yes name=reg_pd_ges_oper_intracomunitarie dbname="reg_pd.ges_oper_intracomunitarie" initial="N" values="	S/	N" validation=" gettext()  = 'S' OR  gettext()  = 'N'" validationmsg="'Immettere: S, N'" )
 column=(type=long updatewhereclause=yes name=reg_pd_id_conto dbname="reg_pd.id_conto" )
