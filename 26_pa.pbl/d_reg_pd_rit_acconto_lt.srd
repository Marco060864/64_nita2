 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"reg_pd~" )  TABLE(NAME=~"registro~" )  TABLE(NAME=~"esercizio~" )  TABLE(NAME=~"prof_registrazione~" )  TABLE(NAME=~"valuta~" )  TABLE(NAME=~"conto~" )  TABLE(NAME=~"sog_commerciale~" )  TABLE(NAME=~"anagrafica~" )  TABLE(NAME=~"tributo~" ) COLUMN(NAME=~"esercizio.codice~") COLUMN(NAME=~"registro.tipo_registro~") COLUMN(NAME=~"registro.numero~") COLUMN(NAME=~"reg_pd.num_progressivo~") COLUMN(NAME=~"reg_pd.data_registrazione~") COLUMN(NAME=~"reg_pd.data_competenza~") COLUMN(NAME=~"prof_registrazione.codice~") COLUMN(NAME=~"valuta.codice~") COLUMN(NAME=~"reg_pd.cambio~") COLUMN(NAME=~"reg_pd.descrizione~") COLUMN(NAME=~"reg_pd.data_documento~") COLUMN(NAME=~"reg_pd.num_documento~") COLUMN(NAME=~"reg_pd.id_azienda~") COLUMN(NAME=~"reg_pd.id_reg_pd~") COLUMN(NAME=~"registro.descrizione~") COLUMN(NAME=~"reg_pd.importo~") COLUMN(NAME=~"reg_pd.ges_oper_intracomunitarie~") COLUMN(NAME=~"reg_pd.id_conto~") COLUMN(NAME=~"conto.codice~") COLUMN(NAME=~"conto.descrizione~") COLUMN(NAME=~"reg_pd.tipo_fattura~") COLUMN(NAME=~"prof_registrazione.descrizione~") COLUMN(NAME=~"reg_pd.imp_valuta~") COLUMN(NAME=~"reg_pd.st_stampa_bollato~") COLUMN(NAME=~"reg_pd.st_liquidazione~") COLUMN(NAME=~"reg_pd.st_reg_iva~") COLUMN(NAME=~"reg_pd.st_data_bollato~") COLUMN(NAME=~"reg_pd.st_data_liquidazione~") COLUMN(NAME=~"reg_pd.st_data_reg_iva~") COLUMN(NAME=~"anagrafica.nat_giuridica~") COLUMN(NAME=~"registro.id_mod_registro~") COLUMN(NAME=~"registro.id_attivita~") COLUMN(NAME=~"tributo.codice~")    JOIN (LEFT=~"conto.id_conto~"    OP =~"=~"RIGHT=~"reg_pd.id_conto~"    OUTER2 =~"reg_pd.id_conto~" )    JOIN (LEFT=~"registro.id_registro~"    OP =~"=~"RIGHT=~"reg_pd.id_registro~" )    JOIN (LEFT=~"prof_registrazione.id_prof_registrazione~"    OP =~"=~"RIGHT=~"reg_pd.id_prof_registrazione~" )    JOIN (LEFT=~"valuta.id_valuta~"    OP =~"=~"RIGHT=~"reg_pd.id_valuta~" )    JOIN (LEFT=~"registro.id_esercizio~"    OP =~"=~"RIGHT=~"esercizio.id_esercizio~" )    JOIN (LEFT=~"sog_commerciale.id_conto~"    OP =~"=~"RIGHT=~"conto.id_conto~" )    JOIN (LEFT=~"anagrafica.id_anagrafica~"    OP =~"=~"RIGHT=~"sog_commerciale.id_anagrafica~" )    JOIN (LEFT=~"sog_commerciale.id_tributo~"    OP =~"=~"RIGHT=~"tributo.id_tributo~" )WHERE(    EXP1 =~"~~~"reg_pd~~~".~~~"id_azienda~~~"~"   OP =~"in~"    EXP2 =~"(0, 1)~" ) ) ORDER(NAME=~"reg_pd.data_registrazione~" ASC=yes )  ORDER(NAME=~"conto.codice~" ASC=yes ) "  sort="esercizio_codice A registro_tipo_registro A registro_numero A reg_pd_num_progressivo D " )
