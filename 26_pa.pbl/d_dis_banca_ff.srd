 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"dis_banca~" )  TABLE(NAME=~"esercizio~" ) COLUMN(NAME=~"dis_banca.id_distinta_banca~") COLUMN(NAME=~"esercizio.codice~") COLUMN(NAME=~"dis_banca.id_esercizio~") COLUMN(NAME=~"dis_banca.tipo~") COLUMN(NAME=~"dis_banca.num_distinta~") COLUMN(NAME=~"dis_banca.note~") COLUMN(NAME=~"dis_banca.id_azienda~") COLUMN(NAME=~"dis_banca.id_banca_azienda~") COLUMN(NAME=~"dis_banca.tipo_contabilizzazione~") COLUMN(NAME=~"dis_banca.data_distinta~") COLUMN(NAME=~"dis_banca.tot_distinta~") COLUMN(NAME=~"dis_banca.id_valuta~")    JOIN (LEFT=~"esercizio.id_esercizio~"    OP =~"=~"RIGHT=~"dis_banca.id_esercizio~" )WHERE(    EXP1 =~"~~~"dis_banca~~~".~~~"id_azienda~~~"~"   OP =~"in~"    EXP2 =~"(0,1)~" ) ) " update="dis_banca" updatewhere=1 updatekeyinplace=yes )
