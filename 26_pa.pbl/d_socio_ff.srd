//objectcomments datawindow (freeform) per gestire la tabella Socio in dettaglio
release 5;
datawindow(units=0 timer_interval=0 color=79741120 processing=0 print.documentname="" print.orientation = 0 print.margin.left = 110 print.margin.right = 110 print.margin.top = 97 print.margin.bottom = 97 print.paper.source = 0 print.paper.size = 0 print.prompt=no )
header(height=1 color="536870912" )
summary(height=1 color="536870912" )
footer(height=1 color="536870912" )
detail(height=1477 color="536870912" )
table(column=(type=long update=yes updatewhereclause=yes key=yes identity=yes name=id_socio dbname="socio.id_socio" )
 column=(type=char(40) update=yes updatewhereclause=yes name=socio dbname="socio.socio" )
 column=(type=long update=yes updatewhereclause=yes name=id_car_sociale dbname="socio.id_car_sociale" )
 column=(type=decimal(0) update=yes updatewhereclause=yes name=num_quote dbname="socio.num_quote" validation=" real(gettext())  >= 0" validationmsg="'Immettere un valore >= 0'" )
 column=(type=decimal(2) update=yes updatewhereclause=yes name=per_quota dbname="socio.per_quota" validation=" real(gettext())  >= 0 AND  real(gettext())  <= 100" validationmsg="'Immettere un valore fra 0 e 100'" )
 column=(type=decimal(0) update=yes updatewhereclause=yes name=val_quota dbname="socio.val_quota" validation=" real(gettext())  >= 0" validationmsg="'Immettere un valore >= 0'" )
 column=(type=decimal(0) update=yes updatewhereclause=yes name=rif_libro_soci dbname="socio.rif_libro_soci" validation=" real(gettext())  >= 0" validationmsg="'Immettere un valore >= 0'" )
 column=(type=date update=yes updatewhereclause=yes name=data_ingresso dbname="socio.data_ingresso" )
 column=(type=date update=yes updatewhereclause=yes name=data_uscita dbname="socio.data_uscita" )
 column=(type=char(16) update=yes updatewhereclause=yes name=cod_fiscale dbname="socio.cod_fiscale" )
 column=(type=char(1) update=yes updatewhereclause=yes name=sesso dbname="socio.sesso" values="Maschile	M/Femminile	F/Non Gestito	A/" validation=" gettext()  = 'M' OR  gettext()  = 'F' OR  gettext()  = 'A'" validationmsg="'Immettere: M, F, A'" )
 column=(type=date update=yes updatewhereclause=yes name=data_nascita dbname="socio.data_nascita" )
 column=(type=char(40) update=yes updatewhereclause=yes name=loc_nascita dbname="socio.loc_nascita" )
 column=(type=char(5) update=yes updatewhereclause=yes name=prov_nascita dbname="socio.prov_nascita" )
 column=(type=char(5) update=yes updatewhereclause=yes name=naz_nascita dbname="socio.naz_nascita" initial="IT" )
 column=(type=char(40) update=yes updatewhereclause=yes name=ind_abitazione dbname="socio.ind_abitazione" )
 column=(type=char(10) update=yes updatewhereclause=yes name=cap_abitazione dbname="socio.cap_abitazione" )
 column=(type=char(40) update=yes updatewhereclause=yes name=loc_abitazione dbname="socio.loc_abitazione" )
 column=(type=char(5) update=yes updatewhereclause=yes name=prov_abitazione dbname="socio.prov_abitazione" )
 column=(type=char(5) update=yes updatewhereclause=yes name=naz_abitazione dbname="socio.naz_abitazione" initial="IT" )
 column=(type=char(40) update=yes updatewhereclause=yes name=ind_residenza dbname="socio.ind_residenza" )
 column=(type=char(10) update=yes updatewhereclause=yes name=cap_residenza dbname="socio.cap_residenza" )
 column=(type=char(40) update=yes updatewhereclause=yes name=loc_residenza dbname="socio.loc_residenza" )
 column=(type=char(5) update=yes updatewhereclause=yes name=prov_residenza dbname="socio.prov_residenza" )
 column=(type=char(5) update=yes updatewhereclause=yes name=naz_residenza dbname="socio.naz_residenza" initial="IT" )
 column=(type=char(32766) update=yes updatewhereclause=no name=note dbname="socio.note" )
 column=(type=long update=yes updatewhereclause=yes name=id_azienda dbname="socio.id_azienda" initial="1" )
 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"socio~" ) COLUMN(NAME=~"socio.id_socio~") COLUMN(NAME=~"socio.socio~") COLUMN(NAME=~"socio.id_car_sociale~") COLUMN(NAME=~"socio.num_quote~") COLUMN(NAME=~"socio.per_quota~") COLUMN(NAME=~"socio.val_quota~") COLUMN(NAME=~"socio.rif_libro_soci~") COLUMN(NAME=~"socio.data_ingresso~") COLUMN(NAME=~"socio.data_uscita~") COLUMN(NAME=~"socio.cod_fiscale~") COLUMN(NAME=~"socio.sesso~") COLUMN(NAME=~"socio.data_nascita~") COLUMN(NAME=~"socio.loc_nascita~") COLUMN(NAME=~"socio.prov_nascita~") COLUMN(NAME=~"socio.naz_nascita~") COLUMN(NAME=~"socio.ind_abitazione~") COLUMN(NAME=~"socio.cap_abitazione~") COLUMN(NAME=~"socio.loc_abitazione~") COLUMN(NAME=~"socio.prov_abitazione~") COLUMN(NAME=~"socio.naz_abitazione~") COLUMN(NAME=~"socio.ind_residenza~") COLUMN(NAME=~"socio.cap_residenza~") COLUMN(NAME=~"socio.loc_residenza~") COLUMN(NAME=~"socio.prov_residenza~") COLUMN(NAME=~"socio.naz_residenza~") COLUMN(NAME=~"socio.note~") COLUMN(NAME=~"socio.id_azienda~")WHERE(    EXP1 =~"~~~"socio~~~".~~~"id_azienda~~~"~"   OP =~"in~"    EXP2 =~"(0,1)~" ) ) ORDER(NAME=~"socio.socio~" ASC=yes ) " update="socio" updatewhere=1 updatekeyinplace=yes )
