 column=(type=long updatewhereclause=yes name=sottomastro_id_bilancio_cee dbname="sottomastro.id_bilancio_cee" )
 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"conto~" )  TABLE(NAME=~"mastro~" )  TABLE(NAME=~"sottomastro~" )  TABLE(NAME=~"bilancio_cee~" ) COMPUTE(NAME=~"Substr(~~~"conto~~~".~~~"codice~~~", 5,4)~") COLUMN(NAME=~"conto.codice~") COLUMN(NAME=~"conto.descrizione~") COLUMN(NAME=~"sottomastro.descrizione~") COLUMN(NAME=~"mastro.descrizione~") COLUMN(NAME=~"conto.ges_par_aperte~") COLUMN(NAME=~"conto.id_conto~") COLUMN(NAME=~"mastro.codice~") COLUMN(NAME=~"sottomastro.codice~") COLUMN(NAME=~"conto.id_azienda~") COLUMN(NAME=~"sottomastro.id_mastro~") COLUMN(NAME=~"conto.id_sottomastro~") COLUMN(NAME=~"conto.id_bilancio_cee~") COLUMN(NAME=~"bilancio_cee.riferimento~") COLUMN(NAME=~"bilancio_cee.descrizione~") COLUMN(NAME=~"sottomastro.id_bilancio_cee~")    JOIN (LEFT=~"bilancio_cee.id_bilancio_cee~"    OP =~"=~"RIGHT=~"conto.id_bilancio_cee~"    OUTER2 =~"conto.id_bilancio_cee~" )    JOIN (LEFT=~"sottomastro.id_mastro~"    OP =~"=~"RIGHT=~"mastro.id_mastro~" )    JOIN (LEFT=~"sottomastro.id_sottomastro~"    OP =~"=~"RIGHT=~"conto.id_sottomastro~" )WHERE(    EXP1 =~"~~~"conto~~~".~~~"id_azienda~~~"~"   OP =~"in~"    EXP2 =~"(0,1)~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"conto~~~".~~~"id_sottomastro~~~"~"   OP =~"=~"    EXP2 =~":ra_id_sottomastro~" ) ) ORDER(NAME=~"conto.codice~" ASC=yes ) ARG(NAME = ~"ra_id_sottomastro~" TYPE = number) " update="conto" updatewhere=1 updatekeyinplace=yes arguments=(("ra_id_sottomastro", number)) )
