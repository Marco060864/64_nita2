table(column=(type=long update=yes updatewhereclause=yes key=yes identity=yes name=id_distinta_banca dbname="id_distinta_banca" )
 column=(type=long update=yes updatewhereclause=yes name=id_esercizio dbname="id_esercizio" )
 column=(type=char(1) update=yes updatewhereclause=yes name=tipo dbname="tipo" )
 column=(type=decimal(0) update=yes updatewhereclause=yes name=num_distinta dbname="num_distinta" )
 column=(type=date update=yes updatewhereclause=yes name=data_distinta dbname="data_distinta" )
 column=(type=char(32766) update=yes updatewhereclause=no name=note dbname="note" )
 column=(type=long update=yes updatewhereclause=yes name=id_azienda dbname="id_azienda" )
 column=(type=char(5) updatewhereclause=yes name=banca_appoggio_cod_abi dbname="cod_abi" validation="match( gettext() , ~"[0-9][0-9][0-9][0-9][0-9]~")" validationmsg="'Immettere cinque cifre'" )
 column=(type=char(40) updatewhereclause=yes name=banca_appoggio_den_abi dbname="den_abi" )
 column=(type=char(5) updatewhereclause=yes name=banca_appoggio_cod_cab dbname="cod_cab" validation="match( gettext() , ~"[0-9][0-9][0-9][0-9][0-9]~")" validationmsg="'Immettere cinque cifre'" )
 column=(type=char(40) updatewhereclause=yes name=banca_appoggio_den_cab dbname="den_cab" )
 column=(type=char(20) updatewhereclause=yes name=banca_azienda_conto_corrente dbname="conto_corrente" )
 column=(type=decimal(0) updatewhereclause=yes name=tp_cont dbname="tipo_contabilizzazione" )
 column=(type=long updatewhereclause=yes name=id_valuta dbname="id_valuta" )
 column=(type=decimal(4) update=yes updatewhereclause=yes name=tot_distinta dbname="tot_distinta" )
 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"dis_banca~" )  TABLE(NAME=~"banca_appoggio~" )  TABLE(NAME=~"banca_azienda~" )  TABLE(NAME=~"esercizio~" ) COLUMN(NAME=~"dis_banca.id_distinta_banca~") COLUMN(NAME=~"dis_banca.id_esercizio~") COLUMN(NAME=~"dis_banca.tipo~") COLUMN(NAME=~"dis_banca.num_distinta~") COLUMN(NAME=~"dis_banca.data_distinta~") COLUMN(NAME=~"dis_banca.note~") COLUMN(NAME=~"dis_banca.id_azienda~") COLUMN(NAME=~"banca_appoggio.cod_abi~") COLUMN(NAME=~"banca_appoggio.den_abi~") COLUMN(NAME=~"banca_appoggio.cod_cab~") COLUMN(NAME=~"banca_appoggio.den_cab~") COLUMN(NAME=~"banca_azienda.conto_corrente~") COLUMN(NAME=~"dis_banca.tipo_contabilizzazione~") COMPUTE(NAME=~"CAST( :rn_id_valuta AS INTEGER) AS id_valuta~") COMPUTE(NAME=~"CAST( fn_conv_valuta( ~~~"dis_banca~~~".~~~"id_valuta~~~",  ~~~"dis_banca~~~".~~~"tot_distinta~~~", :rn_id_valuta) AS NUMERIC(18,4) ) AS tot_distinta~")    JOIN (LEFT=~"banca_azienda.id_banca_azienda~"    OP =~"=~"RIGHT=~"dis_banca.id_banca_azienda~"    OUTER2 =~"dis_banca.id_banca_azienda~" )    JOIN (LEFT=~"banca_azienda.id_banca_appoggio~"    OP =~"=~"RIGHT=~"banca_appoggio.id_banca_appoggio~"    OUTER1 =~"banca_azienda.id_banca_appoggio~" )    JOIN (LEFT=~"esercizio.id_esercizio~"    OP =~"=~"RIGHT=~"dis_banca.id_esercizio~" )WHERE(    EXP1 =~"~~~"dis_banca~~~".~~~"id_esercizio~~~"~"   OP =~"=~"    EXP2 =~":ra_id_esercizio~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"dis_banca~~~".~~~"id_azienda~~~"~"   OP =~"in~"    EXP2 =~"(0,1)~" ) ) ORDER(NAME=~"dis_banca.tipo~" ASC=yes )  ORDER(NAME=~"dis_banca.num_distinta~" ASC=yes ) ARG(NAME = ~"ra_id_esercizio~" TYPE = number)  ARG(NAME = ~"rn_id_valuta~" TYPE = number) " update="dis_banca" updatewhere=1 updatekeyinplace=yes arguments=(("ra_id_esercizio", number),("rn_id_valuta", number)) )
