 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"reg_pd~" )  TABLE(NAME=~"scadenza~" )  TABLE(NAME=~"par_aperta~" )  TABLE(NAME=~"registro~" )  TABLE(NAME=~"sog_commerciale~" ) COLUMN(NAME=~"reg_pd.id_reg_pd~") COLUMN(NAME=~"reg_pd.id_registro~") COLUMN(NAME=~"reg_pd.num_progressivo~") COLUMN(NAME=~"reg_pd.data_registrazione~") COLUMN(NAME=~"reg_pd.num_documento~") COLUMN(NAME=~"reg_pd.data_documento~") COLUMN(NAME=~"reg_pd.id_conto~") COLUMN(NAME=~"reg_pd.segno_reg_iva~") COLUMN(NAME=~"par_aperta.id_par_aperta~") COLUMN(NAME=~"scadenza.data_scadenza~") COLUMN(NAME=~"scadenza.imp_valuta~") COLUMN(NAME=~"scadenza.stato_scadenza~") COLUMN(NAME=~"registro.tipo_registro~") COLUMN(NAME=~"par_aperta.importo~") COLUMN(NAME=~"sog_commerciale.id_con_pagamento~") COLUMN(NAME=~"sog_commerciale.id_sog_commerciale~")    JOIN (LEFT=~"par_aperta.id_par_aperta~"    OP =~"=~"RIGHT=~"scadenza.id_par_aperta~"    OUTER1 =~"par_aperta.id_par_aperta~" )    JOIN (LEFT=~"par_aperta.id_reg_pd~"    OP =~"=~"RIGHT=~"reg_pd.id_reg_pd~"    OUTER2 =~"reg_pd.id_reg_pd~" )    JOIN (LEFT=~"registro.id_registro~"    OP =~"=~"RIGHT=~"reg_pd.id_registro~" )    JOIN (LEFT=~"reg_pd.id_conto~"    OP =~"=~"RIGHT=~"sog_commerciale.id_conto~" )WHERE(    EXP1 =~"~~~"registro~~~".~~~"tipo_registro~~~"~"   OP =~"=~"    EXP2 =~"'IA'~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"reg_pd~~~".~~~"data_registrazione~~~"~"   OP =~">=~"    EXP2 =~"'2015-09-30'~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"scadenza~~~".~~~"id_scadenza~~~"~"   OP =~"is~"    EXP2 =~"null~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"sog_commerciale~~~".~~~"id_con_pagamento~~~"~"   OP =~">~"    EXP2 =~"0~" ) ) "  sort="reg_pd_data_registrazione A reg_pd_num_progressivo A " )
