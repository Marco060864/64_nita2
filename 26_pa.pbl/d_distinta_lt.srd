table(column=(type=date updatewhereclause=yes name=scadenza_data_scadenza dbname="data_scadenza" )
 column=(type=char(40) updatewhereclause=yes name=anagrafica_rag_soc_1 dbname="rag_soc_1" )
 column=(type=char(40) updatewhereclause=yes name=anagrafica_rag_soc_2 dbname="rag_soc_2" )
 column=(type=char(43) updatewhereclause=yes name=cdash_rag_soc_2 dbname="dash_rag_soc_2" )
 column=(type=char(83) updatewhereclause=yes name=crag_soc dbname="rag_soc" )
 column=(type=long updatewhereclause=yes identity=yes name=scadenza_id_scadenza dbname="id_scadenza" )
 column=(type=date updatewhereclause=yes name=documento_data_documento dbname="data_documento" )
 column=(type=char(1) updatewhereclause=yes name=scadenza_tipo_scadenza dbname="tipo_scadenza" )
 column=(type=long updatewhereclause=yes name=scadenza_id_tipo_pagamento_cod dbname="id_tipo_pagamento" )
 column=(type=long updatewhereclause=yes name=scadenza_id_banca_azienda dbname="id_banca_azienda" )
 column=(type=long updatewhereclause=yes name=scadenza_id_documento dbname="id_documento" )
 column=(type=long updatewhereclause=yes name=scadenza_id_par_aperta dbname="id_par_aperta" )
 column=(type=char(1) updatewhereclause=yes name=scadenza_esito_pagamento dbname="esito_pagamento" )
 column=(type=char(1) updatewhereclause=yes name=scadenza_scadenza_da_raggruppare dbname="scadenza_da_raggruppare" )
 column=(type=long updatewhereclause=yes name=scadenza_id_sog_commerciale dbname="id_sog_commerciale" )
 column=(type=long updatewhereclause=yes name=id_valuta_f dbname="id_valuta_f" )
 column=(type=decimal(4) updatewhereclause=yes name=scadenza_importo dbname="scadenza_importo" )
 column=(type=date updatewhereclause=yes name=data_registrazione dbname="data_registrazione" )
 column=(type=decimal(4) updatewhereclause=yes name=importo dbname="importo" )
 column=(type=char(5) updatewhereclause=yes name=cod_abi dbname="cod_abi" )
 column=(type=long updatewhereclause=yes name=id_valuta_i dbname="id_valuta_i" )
 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"scadenza~" )  TABLE(NAME=~"sog_commerciale~" )  TABLE(NAME=~"anagrafica~" )  TABLE(NAME=~"documento~" )  TABLE(NAME=~"banca_appoggio~" )  TABLE(NAME=~"banca_sog_commerciale~" ) COLUMN(NAME=~"scadenza.data_scadenza~") COLUMN(NAME=~"anagrafica.rag_soc_1~") COLUMN(NAME=~"anagrafica.rag_soc_2~") COMPUTE(NAME=~"cast (ifnull(~~~"anagrafica~~~".~~~"rag_soc_2~~~", '', (' - ' || ~~~"anagrafica~~~".~~~"rag_soc_2~~~")) as varchar(43)) as dash_rag_soc_2~") COMPUTE(NAME=~"(~~~"anagrafica~~~".~~~"rag_soc_1~~~" || dash_rag_soc_2) as rag_soc~") COLUMN(NAME=~"scadenza.id_scadenza~") COLUMN(NAME=~"documento.data_documento~") COLUMN(NAME=~"scadenza.tipo_scadenza~") COLUMN(NAME=~"scadenza.id_tipo_pagamento~") COLUMN(NAME=~"scadenza.id_banca_azienda~") COLUMN(NAME=~"scadenza.id_documento~") COLUMN(NAME=~"scadenza.id_par_aperta~") COLUMN(NAME=~"scadenza.esito_pagamento~") COLUMN(NAME=~"scadenza.scadenza_da_raggruppare~") COLUMN(NAME=~"scadenza.id_sog_commerciale~") COMPUTE(NAME=~"CAST( :rn_id_valuta AS INTEGER) AS id_valuta_f~") COMPUTE(NAME=~"CAST( fn_conv_valuta(id_valuta_i, ~~~"scadenza~~~".~~~"importo~~~", :rn_id_valuta) AS NUMERIC(18,4) ) AS scadenza_importo~") COLUMN(NAME=~"documento.data_registrazione~") COLUMN(NAME=~"scadenza.importo~") COLUMN(NAME=~"banca_appoggio.cod_abi~") COMPUTE(NAME=~"CAST( fn_val_distinta(~~~"documento~~~".~~~"data_documento~~~",~~~"documento~~~".~~~"data_registrazione~~~",~~~"scadenza~~~".~~~"data_scadenza~~~",~~~"scadenza~~~".~~~"id_par_aperta~~~") AS integer ) AS id_valuta_i~")    JOIN (LEFT=~"sog_commerciale.id_sog_commerciale~"    OP =~"=~"RIGHT=~"scadenza.id_sog_commerciale~"    OUTER2 =~"scadenza.id_sog_commerciale~" )    JOIN (LEFT=~"sog_commerciale.id_anagrafica~"    OP =~"=~"RIGHT=~"anagrafica.id_anagrafica~"    OUTER1 =~"sog_commerciale.id_anagrafica~" )    JOIN (LEFT=~"documento.id_documento~"    OP =~"=~"RIGHT=~"scadenza.id_documento~"    OUTER2 =~"scadenza.id_documento~" )    JOIN (LEFT=~"banca_sog_commerciale.id_banca_sog_commerciale~"    OP =~"=~"RIGHT=~"scadenza.id_banca_sog_commerciale~"    OUTER2 =~"scadenza.id_banca_sog_commerciale~" )    JOIN (LEFT=~"banca_appoggio.id_banca_appoggio~"    OP =~"=~"RIGHT=~"banca_sog_commerciale.id_banca_appoggio~"    OUTER2 =~"banca_sog_commerciale.id_banca_appoggio~" )WHERE(    EXP1 =~"~~~"scadenza~~~".~~~"esito_pagamento~~~"~"   OP =~"=~"    EXP2 =~"'E'~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"scadenza~~~".~~~"stato_scadenza~~~"~"   OP =~"=~"    EXP2 =~"'D'~" ) ) ORDER(NAME=~"scadenza.data_scadenza~" ASC=yes )  ORDER(NAME=~"scadenza.importo~" ASC=yes ) ARG(NAME = ~"rn_id_valuta~" TYPE = number) " arguments=(("rn_id_valuta", number)) )
