 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"reg_pd~" )  TABLE(NAME=~"registro~" )  TABLE(NAME=~"esercizio~" )  TABLE(NAME=~"conto~" )  TABLE(NAME=~"prof_registrazione~" )  TABLE(NAME=~"sog_commerciale~" )  TABLE(NAME=~"anagrafica~" ) COLUMN(NAME=~"reg_pd.id_reg_pd~") COLUMN(NAME=~"prof_registrazione.codice~") COLUMN(NAME=~"prof_registrazione.descrizione~") COLUMN(NAME=~"reg_pd.id_prof_registrazione~") COLUMN(NAME=~"reg_pd.id_registro~") COLUMN(NAME=~"reg_pd.num_progressivo~") COLUMN(NAME=~"reg_pd.data_competenza~") COLUMN(NAME=~"reg_pd.data_registrazione~") COLUMN(NAME=~"reg_pd.id_valuta~") COLUMN(NAME=~"reg_pd.descrizione~") COLUMN(NAME=~"reg_pd.cambio~") COLUMN(NAME=~"reg_pd.num_documento~") COLUMN(NAME=~"reg_pd.data_documento~") COLUMN(NAME=~"reg_pd.id_conto~") COLUMN(NAME=~"reg_pd.id_azienda~") COMPUTE(NAME=~"CAST (0 as decimal) as totale_imponibile~") COMPUTE(NAME=~"CAST (0 as decimal) as totale_imposta~") COLUMN(NAME=~"registro.tipo_registro~") COLUMN(NAME=~"registro.descrizione~") COLUMN(NAME=~"esercizio.codice~") COLUMN(NAME=~"conto.codice~") COLUMN(NAME=~"conto.descrizione~") COLUMN(NAME=~"conto.id_conto~") COMPUTE(NAME=~"'' as info_sc~") COLUMN(NAME=~"anagrafica.rag_soc_1~") COLUMN(NAME=~"anagrafica.rag_soc_2~") COLUMN(NAME=~"anagrafica.indirizzo~") COLUMN(NAME=~"anagrafica.cap~") COLUMN(NAME=~"anagrafica.localita~") COLUMN(NAME=~"anagrafica.provincia~") COLUMN(NAME=~"anagrafica.nazione~") COLUMN(NAME=~"anagrafica.cod_fiscale~") COLUMN(NAME=~"anagrafica.par_iva~") COLUMN(NAME=~"registro.numero~") COLUMN(NAME=~"reg_pd.ges_oper_intracomunitarie~") COLUMN(NAME=~"anagrafica.id_anagrafica~") COLUMN(NAME=~"reg_pd.imp_valuta~") COLUMN(NAME=~"reg_pd.id_reg_pd_padre~") COLUMN(NAME=~"esercizio.id_esercizio~") COMPUTE(NAME=~"'Tipo: ' || ~~~"registro~~~".~~~"tipo_registro~~~" || ' - Numero: ' || ~~~"registro~~~".~~~"numero~~~" as info_registro~") COLUMN(NAME=~"esercizio.data_inizio~") COLUMN(NAME=~"esercizio.data_fine~") COLUMN(NAME=~"reg_pd.tipo_fattura~") COLUMN(NAME=~"reg_pd.segno_reg_iva~") COMPUTE(NAME=~"cast(1 as real) as euro~") COLUMN(NAME=~"reg_pd.data_comp_liq_iva~") COLUMN(NAME=~"prof_registrazione.crea_partita~") COLUMN(NAME=~"reg_pd.importo~")    JOIN (LEFT=~"conto.id_conto~"    OP =~"=~"RIGHT=~"reg_pd.id_conto~"    OUTER2 =~"reg_pd.id_conto~" )    JOIN (LEFT=~"sog_commerciale.id_conto~"    OP =~"=~"RIGHT=~"conto.id_conto~"    OUTER2 =~"conto.id_conto~" )    JOIN (LEFT=~"anagrafica.id_anagrafica~"    OP =~"=~"RIGHT=~"sog_commerciale.id_anagrafica~"    OUTER2 =~"sog_commerciale.id_anagrafica~" )    JOIN (LEFT=~"registro.id_registro~"    OP =~"=~"RIGHT=~"reg_pd.id_registro~" )    JOIN (LEFT=~"esercizio.id_esercizio~"    OP =~"=~"RIGHT=~"registro.id_esercizio~" )    JOIN (LEFT=~"prof_registrazione.id_prof_registrazione~"    OP =~"=~"RIGHT=~"reg_pd.id_prof_registrazione~" )WHERE(    EXP1 =~"~~~"reg_pd~~~".~~~"id_azienda~~~"~"   OP =~"in~"    EXP2 =~"(0,1)~" ) ) " update="reg_pd" updatewhere=1 updatekeyinplace=yes )
