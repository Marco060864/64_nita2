 column=(type=decimal(0) update=yes updatewhereclause=yes name=reg_pd_segno_reg_iva dbname="segno_reg_iva" initial="1" values="Nota addebito	1/Nota accredito	-1/" validation=" real(gettext())  = 1 OR  real(gettext())  = -1" validationmsg="'Immetere il valore -1 o +1'" )
