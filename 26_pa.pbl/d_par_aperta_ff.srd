detail(height=1220 color="536870912" )
table(column=(type=long update=yes updatewhereclause=yes name=id_conto dbname="id_conto" )
 column=(type=char(8) updatewhereclause=yes name=conto_codice dbname="codice" )
 column=(type=char(40) updatewhereclause=yes name=conto_descrizione dbname="descrizione" )
 column=(type=decimal(4) update=yes updatewhereclause=yes name=importo dbname="importo" )
 column=(type=char(1) update=yes updatewhereclause=yes name=chiusa_forzatamente dbname="chiusa_forzatamente" initial="N" values="	S/	N" validation=" gettext()  = 'S' OR  gettext()  = 'N'" validationmsg="'Immettere: S, N'" )
 column=(type=long update=yes updatewhereclause=yes name=id_azienda dbname="id_azienda" initial="1" )
 column=(type=long update=yes updatewhereclause=yes key=yes identity=yes name=id_par_aperta dbname="id_par_aperta" )
 column=(type=decimal(4) updatewhereclause=yes name=cs dbname="s" )
 column=(type=long update=yes updatewhereclause=yes name=par_aperta_id_reg_pd dbname="id_reg_pd" )
 column=(type=date update=yes updatewhereclause=yes name=par_aperta_data_creazione dbname="data_creazione" )
 column=(type=date update=yes updatewhereclause=yes name=par_aperta_data_scadenza dbname="data_scadenza" )
 column=(type=char(32766) update=yes updatewhereclause=no name=par_aperta_note dbname="note" )
 column=(type=decimal(4) updatewhereclause=yes name=csaldo dbname="saldo" )
 column=(type=char(16) update=yes updatewhereclause=yes name=par_aperta_num_partita dbname="num_partita" )
 column=(type=date update=yes updatewhereclause=yes name=par_aperta_data_partita dbname="data_partita" )
 column=(type=char(47) updatewhereclause=yes name=cinfo_registro dbname="info_registro" )
 column=(type=char(1) update=yes updatewhereclause=yes name=stato dbname="stato" initial="A" values="Aperta	A/Chiusa	C/" )
 column=(type=char(1) update=yes updatewhereclause=yes name=tipo_fattura dbname="tipo_fattura" initial="N" values="Normale	N/Nota di Credito	C/Nota di Debito	D/" )
 column=(type=decimal(0) update=yes updatewhereclause=yes name=segno_iva dbname="segno_iva" initial="1" )
 column=(type=long update=yes updatewhereclause=yes name=id_valuta dbname="id_valuta" )
 retrieve="  SELECT ~"par_aperta~".~"id_conto~",   
         ~"conto~".~"codice~",   
         ~"conto~".~"descrizione~",   
         ~"par_aperta~".~"importo~",   
         ~"par_aperta~".~"chiusa_forzatamente~",   
         ~"par_aperta~".~"id_azienda~",   
         ~"par_aperta~".~"id_par_aperta~",   
         sum( 0 + ~"mov_partita~".~"importo~") S,   
         ~"par_aperta~".~"id_reg_pd~",   
         ~"par_aperta~".~"data_creazione~",   
         ~"par_aperta~".~"data_scadenza~",   
         ~"par_aperta~".~"note~",   
         (~"par_aperta~".~"importo~" - S) as Saldo,   
         ~"par_aperta~".~"num_partita~",   
         ~"par_aperta~".~"data_partita~",   
         IfNull(~"par_aperta~".~"id_reg_pd~",Null,'Esercizio: ' || ~"esercizio~".~"codice~" || ' - Tipo: ' || ~"registro~".~"tipo_registro~" || ' - Numero: ' || ~"registro~".~"numero~") as info_registro,   
         ~"par_aperta~".~"stato~",   
         ~"par_aperta~".~"tipo_fattura~",   
         ~"par_aperta~".~"segno_iva~",   
         ~"par_aperta~".~"id_valuta~"  
    FROM {oj {oj {oj ~"par_aperta~"  LEFT OUTER JOIN ~"reg_pd~"  ON ~"par_aperta~".~"id_reg_pd~" = ~"reg_pd~".~"id_reg_pd~"} LEFT OUTER JOIN ~"registro~"  ON ~"reg_pd~".~"id_registro~" = ~"registro~".~"id_registro~"} LEFT OUTER JOIN ~"esercizio~"  ON ~"registro~".~"id_esercizio~" = ~"esercizio~".~"id_esercizio~"}, {oj ~"par_aperta~"  LEFT OUTER JOIN ~"mov_partita~"  ON ~"par_aperta~".~"id_par_aperta~" = ~"mov_partita~".~"id_par_aperta~"},   
         ~"conto~"  
   WHERE ( ~"conto~".~"id_conto~" = ~"par_aperta~".~"id_conto~" ) and  
         ( ( ~"par_aperta~".~"id_azienda~" in (0, 1) ) )   
GROUP BY ~"par_aperta~".~"id_par_aperta~",   
         ~"par_aperta~".~"id_conto~",   
         ~"par_aperta~".~"stato~",   
         ~"par_aperta~".~"data_partita~",   
         ~"reg_pd~".~"data_registrazione~",   
         ~"par_aperta~".~"num_partita~",   
         ~"reg_pd~".~"num_progressivo~",   
         ~"conto~".~"descrizione~",   
         ~"conto~".~"codice~",   
         ~"par_aperta~".~"id_azienda~",   
         ~"par_aperta~".~"chiusa_forzatamente~",   
         ~"par_aperta~".~"importo~",   
         ~"par_aperta~".~"note~",   
         ~"par_aperta~".~"data_scadenza~",   
         ~"par_aperta~".~"data_creazione~",   
         ~"registro~".~"tipo_registro~",   
         ~"par_aperta~".~"id_reg_pd~",   
         ~"esercizio~".~"codice~",   
         ~"registro~".~"numero~",   
         ~"par_aperta~".~"tipo_fattura~",   
         ~"par_aperta~".~"segno_iva~" ,   
         ~"par_aperta~".~"id_valuta~"   
ORDER BY ~"par_aperta~".~"id_conto~" ASC   
" update="par_aperta" updatewhere=1 updatekeyinplace=yes )
