 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"compenso~" )  TABLE(NAME=~"reg_pd~" )  TABLE(NAME=~"registro~" ) COLUMN(NAME=~"registro.descrizione~") COLUMN(NAME=~"compenso.num_reg_progressivo~") COLUMN(NAME=~"compenso.data_competenza~") COLUMN(NAME=~"compenso.data_registrazione~") COLUMN(NAME=~"compenso.num_documento~") COLUMN(NAME=~"compenso.data_documento~") COLUMN(NAME=~"compenso.data_scadenza~") COLUMN(NAME=~"compenso.data_pagamento~") COLUMN(NAME=~"compenso.id_sog_commerciale~") COLUMN(NAME=~"compenso.id_compenso~") COLUMN(NAME=~"compenso.id_tributo~") COLUMN(NAME=~"compenso.com_totale~") COLUMN(NAME=~"compenso.cassa_previdenza~") COLUMN(NAME=~"compenso.imp_ritenuta~") COLUMN(NAME=~"compenso.rit_previdenziale~")    JOIN (LEFT=~"reg_pd.id_reg_pd~"    OP =~"=~"RIGHT=~"compenso.id_reg_pd~" )    JOIN (LEFT=~"registro.id_registro~"    OP =~"=~"RIGHT=~"reg_pd.id_registro~" )WHERE(    EXP1 =~"~~~"compenso~~~".~~~"id_sog_commerciale~~~"~"   OP =~"=~"    EXP2 =~":ra_id_sog_commerciale~" ) ) ARG(NAME = ~"ra_id_sog_commerciale~" TYPE = number) " update="compenso" updatewhere=1 updatekeyinplace=yes arguments=(("ra_id_sog_commerciale", number)) )
