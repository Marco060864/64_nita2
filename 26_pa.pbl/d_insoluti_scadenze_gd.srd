table(column=(type=char(16) updatewhereclause=yes name=par_aperta_num_partita dbname="num_partita" )
 column=(type=date updatewhereclause=yes name=par_aperta_data_partita dbname="data_partita" )
 column=(type=char(8) updatewhereclause=yes name=sog_commerciale_codice dbname="codice" )
 column=(type=char(40) updatewhereclause=yes name=anagrafica_rag_soc_1 dbname="rag_soc_1" )
 column=(type=date updatewhereclause=yes name=scadenza_data_scadenza dbname="data_scadenza" )
 column=(type=char(1) updatewhereclause=yes name=scadenza_tipo_scadenza dbname="tipo_scadenza" values="Attiva	A/Passiva	P/" validation=" gettext()  = 'A' OR  gettext()  = 'P'" validationmsg="'Immettere un valore tra A, P'" )
 column=(type=long updatewhereclause=yes name=scadenza_id_sog_commerciale dbname="id_sog_commerciale" )
 column=(type=long updatewhereclause=yes identity=yes name=scadenza_id_scadenza dbname="id_scadenza" )
 column=(type=char(1) updatewhereclause=yes name=scadenza_esito_pagamento dbname="esito_pagamento" initial="E" values="Emesso	E/Distinta	D/Pagato	P/Insoluto	I/Bloccato	B/" validation=" gettext()  = 'E' OR  gettext()  = 'D' OR  gettext()  = 'P' OR  gettext()  = 'I' OR  gettext()  = 'B' OR  gettext()  = 'R'" validationmsg="'Immettere un valore tra E, D, P, I, B, R'" )
 column=(type=char(1) updatewhereclause=yes name=scadenza_scadenza_da_raggruppare dbname="scadenza_da_raggruppare" initial="N" values="	S/	N" validation=" gettext()  = 'S' OR  gettext()  = 'N'" validationmsg="'Immettere: S, N'" )
 column=(type=long updatewhereclause=yes name=scadenza_id_riga_distinta_banca dbname="id_riga_distinta_banca" )
 column=(type=long updatewhereclause=yes name=scadenza_id_par_aperta dbname="id_par_aperta" )
 column=(type=long updatewhereclause=yes name=id_valuta dbname="id_valuta" )
 column=(type=decimal(6) updatewhereclause=yes name=scadenza_importo dbname="scadenza_importo" )
 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"par_aperta~" )  TABLE(NAME=~"scadenza~" )  TABLE(NAME=~"sog_commerciale~" )  TABLE(NAME=~"anagrafica~" ) COLUMN(NAME=~"par_aperta.num_partita~") COLUMN(NAME=~"par_aperta.data_partita~") COLUMN(NAME=~"sog_commerciale.codice~") COLUMN(NAME=~"anagrafica.rag_soc_1~") COLUMN(NAME=~"scadenza.data_scadenza~") COLUMN(NAME=~"scadenza.tipo_scadenza~") COLUMN(NAME=~"scadenza.id_sog_commerciale~") COLUMN(NAME=~"scadenza.id_scadenza~") COLUMN(NAME=~"scadenza.esito_pagamento~") COLUMN(NAME=~"scadenza.scadenza_da_raggruppare~") COLUMN(NAME=~"scadenza.id_riga_distinta_banca~") COLUMN(NAME=~"scadenza.id_par_aperta~") COLUMN(NAME=~"scadenza.id_valuta~") COMPUTE(NAME=~"fn_conv_valuta(fn_valuta_scadenza(0,~~~"scadenza~~~".~~~"id_par_aperta~~~",~~~"scadenza~~~".~~~"data_scadenza~~~"),~~~"scadenza~~~".~~~"importo~~~",:val_reg) as scadenza_importo~")    JOIN (LEFT=~"scadenza.id_par_aperta~"    OP =~"=~"RIGHT=~"par_aperta.id_par_aperta~"    OUTER1 =~"scadenza.id_par_aperta~" )    JOIN (LEFT=~"sog_commerciale.id_sog_commerciale~"    OP =~"=~"RIGHT=~"scadenza.id_sog_commerciale~"    OUTER2 =~"scadenza.id_sog_commerciale~" )    JOIN (LEFT=~"anagrafica.id_anagrafica~"    OP =~"=~"RIGHT=~"sog_commerciale.id_anagrafica~"    OUTER2 =~"sog_commerciale.id_anagrafica~" )) ARG(NAME = ~"val_reg~" TYPE = number) " arguments=(("val_reg", number)) )
