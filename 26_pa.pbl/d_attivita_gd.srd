//objectcomments Attività svolte dall'azienda.
release 6;
datawindow(units=0 timer_interval=0 color=79741120 processing=1 print.documentname="" print.orientation = 0 print.margin.left = 110 print.margin.right = 110 print.margin.top = 97 print.margin.bottom = 97 print.paper.source = 0 print.paper.size = 0 print.prompt=no print.buttons=no print.preview.buttons=no pointer="S:\pb\commonframework\Point.cur" grid.lines=0 selected.mouse=no )
header(height=136 color="536870912" )
summary(height=0 color="536870912" )
footer(height=0 color="536870912" )
detail(height=72 color="553648127" )
table(column=(type=long update=yes updatewhereclause=yes key=yes identity=yes name=id_attivita dbname="attivita.id_attivita" )
 column=(type=long update=yes updatewhereclause=yes name=id_tab_attivita_des dbname="attivita.id_tab_attivita" )
 column=(type=char(40) update=yes updatewhereclause=yes name=descrizione dbname="attivita.descrizione" )
 column=(type=char(1) update=yes updatewhereclause=yes name=ges_ventilazione dbname="attivita.ges_ventilazione" initial="N" values="	S/	N" validation=" gettext()  = 'S' OR  gettext()  = 'N'" validationmsg="'Immettere: S, N'" )
 column=(type=char(1) update=yes updatewhereclause=yes name=liq_iva dbname="attivita.liq_iva" values="Mensile	M/Trimestrale	T/" validation=" gettext()  = 'M' OR  gettext()  = 'T'" validationmsg="'Immettere: M, T'" )
 column=(type=char(1) update=yes updatewhereclause=yes name=tipo_contabilita dbname="attivita.tipo_contabilita" initial="O" values="Ordinaria	O/Semplificata	S/Agricola	A/" validation=" gettext()  = 'O' OR  gettext()  = 'S' OR  gettext()  = 'A'" validationmsg="'Immettere: O, S, A'" )
 column=(type=long update=yes updatewhereclause=yes name=id_azienda dbname="attivita.id_azienda" initial="1" )
 column=(type=char(8) updatewhereclause=yes name=tab_attivita_codice dbname="tab_attivita.codice" )
 column=(type=decimal(4) update=yes updatewhereclause=yes name=attivita_attuale_plafond dbname="attivita.attuale_plafond" )
 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"attivita~" )  TABLE(NAME=~"tab_attivita~" ) COLUMN(NAME=~"attivita.id_attivita~") COLUMN(NAME=~"attivita.id_tab_attivita~") COLUMN(NAME=~"attivita.descrizione~") COLUMN(NAME=~"attivita.ges_ventilazione~") COLUMN(NAME=~"attivita.liq_iva~") COLUMN(NAME=~"attivita.tipo_contabilita~") COLUMN(NAME=~"attivita.id_azienda~") COLUMN(NAME=~"tab_attivita.codice~") COLUMN(NAME=~"attivita.attuale_plafond~")    JOIN (LEFT=~"tab_attivita.id_tab_attivita~"    OP =~"=~"RIGHT=~"attivita.id_tab_attivita~"    OUTER2 =~"attivita.id_tab_attivita~" )WHERE(    EXP1 =~"~~~"attivita~~~".~~~"id_azienda~~~"~"   OP =~"in~"    EXP2 =~"(0,1)~" ) ) ORDER(NAME=~"tab_attivita.codice~" ASC=yes ) " update="attivita" updatewhere=1 updatekeyinplace=yes )
