table(column=(type=long updatewhereclause=yes name=id_azienda dbname="azienda.id_azienda" dbalias=".id_azienda" )
 column=(type=char(8) updatewhereclause=yes name=codice dbname="azienda.codice" dbalias=".codice" )
 column=(type=char(40) updatewhereclause=yes name=rag_soc_1 dbname="azienda.rag_soc_1" dbalias=".rag_soc_1" )
 column=(type=char(40) updatewhereclause=yes name=rag_soc_2 dbname="azienda.rag_soc_2" dbalias=".rag_soc_2" )
 column=(type=long updatewhereclause=yes name=id_pdc dbname="azienda.id_pdc" dbalias=".id_pdc" )
 column=(type=char(1) updatewhereclause=yes name=forma_giuridica dbname="azienda.forma_giuridica" dbalias=".forma_giuridica" values="S.N.C.	0/S.p.A.	1/S.R.L.	2/S.A.p.A.	3/S.S.	4/S.d.F.	5/Holding	6/S.C.R.L.	7/Coop.	8/" validation=" gettext()  = '0' OR  gettext()  = '1' OR  gettext()  = '2' OR  gettext()  = '3' OR  gettext()  = '4' OR  gettext()  = '5' OR  gettext()  = '6' OR  gettext()  = '7' OR  gettext()  = '8'" validationmsg="'Immettere: 0, 1, 2, 3, 4, 5, 6, 7, 8'" )
 column=(type=char(16) updatewhereclause=yes name=par_iva dbname="azienda.par_iva" dbalias=".par_iva" )
 column=(type=char(16) updatewhereclause=yes name=cod_fiscale dbname="azienda.cod_fiscale" dbalias=".cod_fiscale" )
 column=(type=long updatewhereclause=yes name=azienda_id_banca_azienda dbname="azienda.id_banca_azienda" dbalias=".id_banca_azienda" )
 column=(type=char(1) updatewhereclause=yes name=attiva dbname="azienda.attiva" dbalias=".attiva" initial="S" values="	S/	N" validation=" gettext()  = 'S' OR  gettext()  = 'N'" validationmsg="'Immettere: S, N'" )
 column=(type=long updatewhereclause=yes name=id_attivita dbname="azienda.id_attivita" dbalias=".id_attivita" )
 column=(type=char(6) updatewhereclause=yes name=cod_istat dbname="azienda.cod_istat" dbalias=".cod_istat" )
 column=(type=char(40) updatewhereclause=yes name=uff_iidd dbname="azienda.uff_iidd" dbalias=".uff_iidd" )
 column=(type=char(40) updatewhereclause=yes name=des_esattoria dbname="azienda.des_esattoria" dbalias=".des_esattoria" )
 column=(type=char(10) updatewhereclause=yes name=iden_inps dbname="azienda.iden_inps" dbalias=".iden_inps" )
 column=(type=char(10) updatewhereclause=yes name=iden_inail dbname="azienda.iden_inail" dbalias=".iden_inail" )
 column=(type=char(40) updatewhereclause=yes name=cciaa dbname="azienda.cciaa" dbalias=".cciaa" )
 column=(type=char(10) updatewhereclause=yes name=num_volume dbname="azienda.num_volume" dbalias=".num_volume" )
 column=(type=char(10) updatewhereclause=yes name=num_isc_albo dbname="azienda.num_isc_albo" dbalias=".num_isc_albo" )
 column=(type=date updatewhereclause=yes name=data_isc_albo dbname="azienda.data_isc_albo" dbalias=".data_isc_albo" )
 column=(type=date updatewhereclause=yes name=data_costituzione dbname="azienda.data_costituzione" dbalias=".data_costituzione" )
 column=(type=date updatewhereclause=yes name=data_termine dbname="azienda.data_termine" dbalias=".data_termine" )
 column=(type=char(40) updatewhereclause=yes name=trib_iscrizione dbname="azienda.trib_iscrizione" dbalias=".trib_iscrizione" )
 column=(type=decimal(0) updatewhereclause=yes name=num_soci dbname="azienda.num_soci" dbalias=".num_soci" validation=" real(gettext())  >= 0" validationmsg="'Immettere un valore >= 0'" )
 column=(type=decimal(4) updatewhereclause=yes name=tot_capitale dbname="azienda.tot_capitale" dbalias=".tot_capitale" validation=" real(gettext())  >= 0" validationmsg="'Immettere un valore >= 0'" )
 column=(type=long updatewhereclause=yes name=id_esercizio dbname="azienda.id_esercizio" dbalias=".id_esercizio" )
 column=(type=long updatewhereclause=yes name=id_ten_scr_contabili dbname="azienda.id_ten_scr_contabili" dbalias=".id_ten_scr_contabili" )
 column=(type=char(32766) updatewhereclause=no name=note dbname="azienda.note" dbalias=".note" )
 column=(type=char(40) updatewhereclause=yes name=azienda_num_cc_fiscale dbname="azienda.num_cc_fiscale" dbalias=".num_cc_fiscale" )
 column=(type=char(40) updatewhereclause=yes name=azienda_trib_competenza dbname="azienda.trib_competenza" dbalias=".trib_competenza" )
 column=(type=char(20) updatewhereclause=yes name=azienda_pas_blocco_doc dbname="azienda.pas_blocco_doc" dbalias=".pas_blocco_doc" )
 column=(type=char(20) updatewhereclause=yes name=azienda_pas_sosp_doc dbname="azienda.pas_sosp_doc" dbalias=".pas_sosp_doc" )
 column=(type=char(20) updatewhereclause=yes name=cc_pas_blocco dbname="c_pas_blocco" )
 column=(type=long updatewhereclause=yes name=id_esercizio_proposto dbname="azienda.id_esercizio_proposto" dbalias=".id_esercizio_proposto" )
 column=(type=char(20) updatewhereclause=yes name=cc_pas_sosp dbname="c_pas_sosp" )
 column=(type=long updatewhereclause=yes name=id_pdc_cen_costo dbname="azienda.id_pdc_cen_costo" dbalias=".id_pdc_cen_costo" )
 column=(type=char(1) updatewhereclause=yes name=tipo_aggreg_cen_costo dbname="azienda.tipo_aggreg_cen_costo" dbalias=".tipo_aggreg_cen_costo" )
 column=(type=char(255) updatewhereclause=yes name=logo dbname="azienda.logo" dbalias=".logo" )
 column=(type=char(1) updatewhereclause=yes name=ultimo_trasf dbname="azienda.ultimo_trasf" dbalias=".ultimo_trasf" )
 column=(type=char(32) updatewhereclause=yes name=tel_amministrazione dbname="azienda.tel_amministrazione" dbalias=".tel_amministrazione" )
 column=(type=char(32) updatewhereclause=yes name=fax_amministrazione dbname="azienda.fax_amministrazione" dbalias=".fax_amministrazione" )
 column=(type=char(64) updatewhereclause=yes name=email_amministrazione dbname="azienda.email_amministrazione" dbalias=".email_amministrazione" )
 column=(type=char(7) updatewhereclause=yes name=codice_interscambio_ae dbname="azienda.codice_interscambio_ae" dbalias=".codice_interscambio_ae" )
 column=(type=char(128) updatewhereclause=yes name=pec dbname="azienda.pec" dbalias=".pec" )
 column=(type=char(4) updatewhereclause=yes name=reg_fiscale dbname="azienda.reg_fiscale" dbalias=".reg_fiscale" )
 column=(type=char(128) updatewhereclause=yes name=hub_ae dbname="azienda.hub_ae" dbalias=".hub_ae" )
 column=(type=char(2) updatewhereclause=yes name=rea_provincia dbname="azienda.rea_provincia" dbalias=".rea_provincia" )
 column=(type=char(20) updatewhereclause=yes name=rea_numero dbname="azienda.rea_numero" dbalias=".rea_numero" )
 column=(type=decimal(2) updatewhereclause=yes name=rea_cap_sociale dbname="azienda.rea_cap_sociale" dbalias=".rea_cap_sociale" )
 column=(type=char(2) updatewhereclause=yes name=rea_socio_unico dbname="azienda.rea_socio_unico" dbalias=".rea_socio_unico" )
 column=(type=char(2) updatewhereclause=yes name=rea_stato_liquidazione dbname="azienda.rea_stato_liquidazione" dbalias=".rea_stato_liquidazione" )
 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"azienda~" ) COLUMN(NAME=~"azienda.id_azienda~") COLUMN(NAME=~"azienda.codice~") COLUMN(NAME=~"azienda.rag_soc_1~") COLUMN(NAME=~"azienda.rag_soc_2~") COLUMN(NAME=~"azienda.id_pdc~") COLUMN(NAME=~"azienda.forma_giuridica~") COLUMN(NAME=~"azienda.par_iva~") COLUMN(NAME=~"azienda.cod_fiscale~") COLUMN(NAME=~"azienda.id_banca_azienda~") COLUMN(NAME=~"azienda.attiva~") COLUMN(NAME=~"azienda.id_attivita~") COLUMN(NAME=~"azienda.cod_istat~") COLUMN(NAME=~"azienda.uff_iidd~") COLUMN(NAME=~"azienda.des_esattoria~") COLUMN(NAME=~"azienda.iden_inps~") COLUMN(NAME=~"azienda.iden_inail~") COLUMN(NAME=~"azienda.cciaa~") COLUMN(NAME=~"azienda.num_volume~") COLUMN(NAME=~"azienda.num_isc_albo~") COLUMN(NAME=~"azienda.data_isc_albo~") COLUMN(NAME=~"azienda.data_costituzione~") COLUMN(NAME=~"azienda.data_termine~") COLUMN(NAME=~"azienda.trib_iscrizione~") COLUMN(NAME=~"azienda.num_soci~") COLUMN(NAME=~"azienda.tot_capitale~") COLUMN(NAME=~"azienda.id_esercizio~") COLUMN(NAME=~"azienda.id_ten_scr_contabili~") COLUMN(NAME=~"azienda.note~") COLUMN(NAME=~"azienda.num_cc_fiscale~") COLUMN(NAME=~"azienda.trib_competenza~") COLUMN(NAME=~"azienda.pas_blocco_doc~") COLUMN(NAME=~"azienda.pas_sosp_doc~") COMPUTE(NAME=~"CAST ('' As Char(20)) As c_pas_blocco~") COLUMN(NAME=~"azienda.id_esercizio_proposto~") COMPUTE(NAME=~"CAST ('' As Char(20)) As c_pas_sosp~") COLUMN(NAME=~"azienda.id_pdc_cen_costo~") COLUMN(NAME=~"azienda.tipo_aggreg_cen_costo~") COLUMN(NAME=~"azienda.logo~") COLUMN(NAME=~"azienda.ultimo_trasf~") COLUMN(NAME=~"azienda.tel_amministrazione~") COLUMN(NAME=~"azienda.fax_amministrazione~") COLUMN(NAME=~"azienda.email_amministrazione~") COLUMN(NAME=~"azienda.codice_interscambio_ae~") COLUMN(NAME=~"azienda.pec~") COLUMN(NAME=~"azienda.reg_fiscale~") COLUMN(NAME=~"azienda.hub_ae~") COLUMN(NAME=~"azienda.rea_provincia~") COLUMN(NAME=~"azienda.rea_numero~") COLUMN(NAME=~"azienda.rea_cap_sociale~") COLUMN(NAME=~"azienda.rea_socio_unico~") COLUMN(NAME=~"azienda.rea_stato_liquidazione~")) " )
