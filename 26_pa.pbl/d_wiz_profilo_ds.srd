//objectcomments DataWindow utilizzata per i DataStore di uo_Wizard
release 5;
datawindow(units=0 timer_interval=0 color=79741120 processing=1 print.documentname="" print.orientation = 0 print.margin.left = 110 print.margin.right = 110 print.margin.top = 97 print.margin.bottom = 97 print.paper.source = 0 print.paper.size = 0 print.prompt=no grid.lines=0 )
header(height=125 color="553648127" )
summary(height=1 color="536870912" )
footer(height=1 color="536870912" )
detail(height=73 color="553648127" )
table(column=(type=decimal(0) updatewhereclause=yes name=wiz_profilo_num_ordine dbname="num_ordine" validation=" real(gettext())  >= 0" validationmsg="'Immettere un valore >= 0'" )
 column=(type=char(8) updatewhereclause=yes name=wizard_codice dbname="codice" )
 column=(type=char(40) updatewhereclause=yes name=wizard_nome dbname="nome" )
 column=(type=char(40) updatewhereclause=yes name=wizard_nome_window dbname="nome_window" )
 column=(type=date updatewhereclause=yes name=reg_pd_data_registrazione dbname="data_registrazione" )
 column=(type=decimal(0) updatewhereclause=yes name=reg_pd_num_progressivo dbname="num_progressivo" validation=" real(gettext())  >= 0" validationmsg="'Immettere un valore >= 0'" )
 column=(type=long updatewhereclause=yes name=registro_id_esercizio dbname="id_esercizio" )
 column=(type=long updatewhereclause=yes identity=yes name=wizard_id_wizard dbname="id_wizard" )
 column=(type=long updatewhereclause=yes name=reg_pd_id_registro dbname="id_registro" )
 column=(type=date updatewhereclause=yes name=reg_pd_data_competenza dbname="data_competenza" )
 column=(type=long updatewhereclause=yes name=reg_pd_id_prof_registrazione dbname="id_prof_registrazione" )
 column=(type=long updatewhereclause=yes name=reg_pd_id_valuta dbname="id_valuta" )
 column=(type=decimal(4) updatewhereclause=yes name=reg_pd_cambio dbname="cambio" validation=" real(gettext())  >= 0" validationmsg="'Immettere un valore >= 0'" )
 column=(type=decimal(0) updatewhereclause=yes name=reg_pd_importo dbname="importo" )
 column=(type=char(40) updatewhereclause=yes name=reg_pd_descrizione dbname="descrizione" )
 column=(type=char(1) updatewhereclause=yes name=reg_pd_ges_oper_intracomunitarie dbname="ges_oper_intracomunitarie" initial="N" values="	S/	N" validation=" gettext()  = 'S' OR  gettext()  = 'N'" validationmsg="'Immettere: S, N'" )
 column=(type=char(16) updatewhereclause=yes name=reg_pd_num_documento dbname="num_documento" )
 column=(type=date updatewhereclause=yes name=reg_pd_data_documento dbname="data_documento" )
 column=(type=long updatewhereclause=yes name=reg_pd_id_conto dbname="id_conto" )
 column=(type=long updatewhereclause=yes name=reg_pd_id_azienda dbname="id_azienda" initial="1" )
 column=(type=long updatewhereclause=yes identity=yes name=reg_pd_id_reg_pd dbname="id_reg_pd" )
 column=(type=char(283) updatewhereclause=yes name=cinfo_reg_pd dbname="info_reg_pd" )
 column=(type=char(237) updatewhereclause=yes name=cinfo_sc dbname="info_sc" )
 column=(type=decimal(4) updatewhereclause=yes name=reg_pd_imp_valuta dbname="imp_valuta" )
 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"prof_registrazione~" )  TABLE(NAME=~"reg_pd~" )  TABLE(NAME=~"wiz_profilo~" )  TABLE(NAME=~"wizard~" )  TABLE(NAME=~"registro~" )  TABLE(NAME=~"esercizio~" )  TABLE(NAME=~"conto~" )  TABLE(NAME=~"sog_commerciale~" )  TABLE(NAME=~"anagrafica~" ) COLUMN(NAME=~"wiz_profilo.num_ordine~") COLUMN(NAME=~"wizard.codice~") COLUMN(NAME=~"wizard.nome~") COLUMN(NAME=~"wizard.nome_window~") COLUMN(NAME=~"reg_pd.data_registrazione~") COLUMN(NAME=~"reg_pd.num_progressivo~") COLUMN(NAME=~"registro.id_esercizio~") COLUMN(NAME=~"wizard.id_wizard~") COLUMN(NAME=~"reg_pd.id_registro~") COLUMN(NAME=~"reg_pd.data_competenza~") COLUMN(NAME=~"reg_pd.id_prof_registrazione~") COLUMN(NAME=~"reg_pd.id_valuta~") COLUMN(NAME=~"reg_pd.cambio~") COLUMN(NAME=~"reg_pd.importo~") COLUMN(NAME=~"reg_pd.descrizione~") COLUMN(NAME=~"reg_pd.ges_oper_intracomunitarie~") COLUMN(NAME=~"reg_pd.num_documento~") COLUMN(NAME=~"reg_pd.data_documento~") COLUMN(NAME=~"reg_pd.id_conto~") COLUMN(NAME=~"reg_pd.id_azienda~") COLUMN(NAME=~"reg_pd.id_reg_pd~") COMPUTE(NAME=~"CAST (('Esercizio: ' + ~~~"esercizio~~~".~~~"codice~~~" + ' - Tipo Registro: ' + ~~~"registro~~~".~~~"tipo_registro~~~" + ' - N. Registro: ' + convert(char, ~~~"registro~~~".~~~"numero~~~") + '~~~~rNum. Progr.: ' + convert(char, ~~~"reg_pd~~~".~~~"num_progressivo~~~") + ' - Data Registraz.: ' + convert(char, ~~~"reg_pd~~~".~~~"data_registrazione~~~", 103) + ' - Data Comp.: ' + convert(char, ~~~"reg_pd~~~".~~~"data_competenza~~~", 103) + '~~~~rNum. Doc.: ' + ~~~"reg_pd~~~".~~~"num_documento~~~" + ' - Data Doc.: ' + convert(char, ~~~"reg_pd~~~".~~~"data_documento~~~", 103) + '~~~~rDes. Contabile: ' + ~~~"reg_pd~~~".~~~"descrizione~~~" + '~~~~rImporto: ' + convert(char, ~~~"reg_pd~~~".~~~"importo~~~")) as char) as info_reg_pd~") COMPUTE(NAME=~"CAST ((~~~"anagrafica~~~".~~~"rag_soc_1~~~" + ' - ' + ~~~"anagrafica~~~".~~~"rag_soc_2~~~" + '~~~~r' + ~~~"anagrafica~~~".~~~"indirizzo~~~" + '~~~~r' + ~~~"anagrafica~~~".~~~"cap~~~" + ' ' + ~~~"anagrafica~~~".~~~"localita~~~" + ' ' + ~~~"anagrafica~~~".~~~"provincia~~~" + ' ' + ~~~"anagrafica~~~".~~~"nazione~~~" + '~~~~rP.I.:' + ~~~"anagrafica~~~".~~~"par_iva~~~" + ' - C.F.:' + ~~~"anagrafica~~~".~~~"cod_fiscale~~~") as char) as info_sc~") COLUMN(NAME=~"reg_pd.imp_valuta~")    JOIN (LEFT=~"conto.id_conto~"    OP =~"=~"RIGHT=~"reg_pd.id_conto~"    OUTER2 =~"reg_pd.id_conto~" )    JOIN (LEFT=~"sog_commerciale.id_conto~"    OP =~"=~"RIGHT=~"conto.id_conto~"    OUTER2 =~"conto.id_conto~" )    JOIN (LEFT=~"anagrafica.id_anagrafica~"    OP =~"=~"RIGHT=~"sog_commerciale.id_anagrafica~"    OUTER2 =~"sog_commerciale.id_anagrafica~" )    JOIN (LEFT=~"reg_pd.id_prof_registrazione~"    OP =~"=~"RIGHT=~"prof_registrazione.id_prof_registrazione~" )    JOIN (LEFT=~"wiz_profilo.id_prof_registrazione~"    OP =~"=~"RIGHT=~"prof_registrazione.id_prof_registrazione~" )    JOIN (LEFT=~"wizard.id_wizard~"    OP =~"=~"RIGHT=~"wiz_profilo.id_wizard~" )    JOIN (LEFT=~"registro.id_registro~"    OP =~"=~"RIGHT=~"reg_pd.id_registro~" )    JOIN (LEFT=~"esercizio.id_esercizio~"    OP =~"=~"RIGHT=~"registro.id_esercizio~" )WHERE(    EXP1 =~"~~~"reg_pd~~~".~~~"id_reg_pd~~~"~"   OP =~"=~"    EXP2 =~":al_id_reg_pd~" ) ) ORDER(NAME=~"wiz_profilo.num_ordine~" ASC=yes ) ARG(NAME = ~"al_id_reg_pd~" TYPE = number) " arguments=(("al_id_reg_pd", number)) )
