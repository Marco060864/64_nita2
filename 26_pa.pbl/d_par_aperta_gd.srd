table(column=(type=long updatewhereclause=yes key=yes identity=yes name=id_par_aperta dbname="par_aperta.id_par_aperta" )
 column=(type=char(16) updatewhereclause=yes name=par_aperta_num_partita dbname="par_aperta.num_partita" )
 column=(type=date updatewhereclause=yes name=par_aperta_data_partita dbname="par_aperta.data_partita" )
 column=(type=long updatewhereclause=yes name=id_conto dbname="par_aperta.id_conto" )
 column=(type=decimal(0) updatewhereclause=yes name=par_aperta_segno_iva dbname="par_aperta.segno_iva" )
 column=(type=char(1) updatewhereclause=yes name=stato dbname="par_aperta.stato" )
 column=(type=long updatewhereclause=yes name=id_valuta dbname="par_aperta.id_valuta" )
 column=(type=long updatewhereclause=yes name=id_reg_pd dbname="id_reg_pd" )
 column=(type=char(40) updatewhereclause=yes name=note dbname="note" )
 column=(type=char(1) updatewhereclause=yes name=chiudi dbname="chiudi" initial="0" )
 column=(type=decimal(4) updatewhereclause=yes name=importo dbname="tab_importo" )
 column=(type=decimal(4) updatewhereclause=yes name=importo2 dbname="importo2" )
 column=(type=decimal(4) updatewhereclause=yes name=csaldo dbname="saldo" )
 column=(type=decimal(4) updatewhereclause=yes name=par_aperta_movimento dbname="importo" )
 retrieve="  SELECT ~"par_aperta~".~"id_par_aperta~",   
         ~"par_aperta~".~"num_partita~",   
         ~"par_aperta~".~"data_partita~",   
         ~"par_aperta~".~"id_conto~",   
         ~"par_aperta~".~"segno_iva~",   
         ~"par_aperta~".~"stato~",   
         ~"par_aperta~".~"id_valuta~",   
         cast(0 as integer) as id_reg_pd,   
         cast('' as char(40)) as note,   
         cast('' as char(1)) as chiudi,   
         fn_conv_valuta(~"par_aperta~".~"id_valuta~",~"par_aperta~".~"importo~",:rd_val_reg) as tab_importo,
         (select sum(ifnull(mov_partita.importo,0, fn_conv_valuta(~"par_aperta~".~"id_valuta~",mov_partita.importo,:rd_val_reg))) from ~"DBA~".mov_partita where mov_partita.id_par_aperta=par_aperta.id_par_aperta ) as importo2,   
         (tab_importo - ( ifnull( importo2 , 0 , importo2 ))) as saldo,   
         cast(0 as numeric(18,4) ) as importo  
    FROM ~"par_aperta~"  
   WHERE ( ~"par_aperta~".~"id_conto~" = :rn_id_conto ) AND  
         ( ~"par_aperta~".~"segno_iva~" = 1 )   
ORDER BY ~"par_aperta~".~"data_partita~" ASC,   
         ~"par_aperta~".~"num_partita~" ASC   
" update="par_aperta" updatewhere=0 updatekeyinplace=no arguments=(("rn_id_conto", number),("rd_val_reg", number))  sort="par_aperta_data_partita A par_aperta_num_partita A " )
