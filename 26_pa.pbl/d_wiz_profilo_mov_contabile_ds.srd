//objectcomments DataWindow utilizzata per i DataStore di uo_Wizard
release 6;
datawindow(units=0 timer_interval=0 color=79741120 processing=1 print.documentname="" print.orientation = 0 print.margin.left = 110 print.margin.right = 110 print.margin.top = 97 print.margin.bottom = 97 print.paper.source = 0 print.paper.size = 0 print.prompt=no print.buttons=no print.preview.buttons=no grid.lines=0 )
header(height=72 color="553648127" )
summary(height=0 color="536870912" )
footer(height=0 color="536870912" )
detail(height=72 color="553648127" )
table(column=(type=long update=yes updatewhereclause=yes identity=yes name=id_mov_contabile dbname="mov_contabile.id_mov_contabile" )
 column=(type=decimal(0) update=yes updatewhereclause=yes name=numero dbname="mov_contabile.numero" validation=" real(gettext())  >= 0" validationmsg="'Immettere un valore >= 0'" )
 column=(type=long update=yes updatewhereclause=yes name=id_conto dbname="mov_contabile.id_conto" )
 column=(type=long update=yes updatewhereclause=yes name=id_valuta dbname="mov_contabile.id_valuta" )
 column=(type=decimal(4) update=yes updatewhereclause=yes name=cambio dbname="mov_contabile.cambio" validation=" real(gettext())  >= 0" validationmsg="'Immettere un valore >= 0'" )
 column=(type=char(40) update=yes updatewhereclause=yes name=des_contabile dbname="mov_contabile.des_contabile" )
 column=(type=decimal(4) updatewhereclause=yes name=dare dbname="mov_contabile.dare" )
 column=(type=decimal(4) updatewhereclause=yes name=avere dbname="mov_contabile.avere" )
 column=(type=date update=yes updatewhereclause=yes name=data_val_banca dbname="mov_contabile.data_val_banca" )
 column=(type=date update=yes updatewhereclause=yes name=data_inizio_competenza dbname="mov_contabile.data_inizio_competenza" )
 column=(type=date update=yes updatewhereclause=yes name=data_fine_competenza dbname="mov_contabile.data_fine_competenza" )
 column=(type=decimal(0) update=yes updatewhereclause=yes name=prog_stampato dbname="mov_contabile.prog_stampato" validation=" real(gettext())  >= 0" validationmsg="'Immettere un valore >= 0'" )
 column=(type=char(1) update=yes updatewhereclause=yes name=rateo_risconto dbname="mov_contabile.rateo_risconto" initial="N" values="Non Gestito	N/Rateo	T/Risconto	S/" validation=" gettext()  = 'N' OR  gettext()  = 'T' OR  gettext()  = 'S'" validationmsg="'Immettere un valore tra N,T,S'" )
 column=(type=long update=yes updatewhereclause=yes name=id_azienda dbname="mov_contabile.id_azienda" initial="1" )
 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"mov_contabile~" ) COLUMN(NAME=~"mov_contabile.id_mov_contabile~") COLUMN(NAME=~"mov_contabile.numero~") COLUMN(NAME=~"mov_contabile.id_conto~") COLUMN(NAME=~"mov_contabile.id_valuta~") COLUMN(NAME=~"mov_contabile.cambio~") COLUMN(NAME=~"mov_contabile.des_contabile~") COLUMN(NAME=~"mov_contabile.dare~") COLUMN(NAME=~"mov_contabile.avere~") COLUMN(NAME=~"mov_contabile.data_val_banca~") COLUMN(NAME=~"mov_contabile.data_inizio_competenza~") COLUMN(NAME=~"mov_contabile.data_fine_competenza~") COLUMN(NAME=~"mov_contabile.prog_stampato~") COLUMN(NAME=~"mov_contabile.rateo_risconto~") COLUMN(NAME=~"mov_contabile.id_azienda~")WHERE(    EXP1 =~"~~~"mov_contabile~~~".~~~"id_reg_pd~~~"~"   OP =~"=~"    EXP2 =~":al_id_reg_pd~" ) ) ARG(NAME = ~"al_id_reg_pd~" TYPE = number) " arguments=(("al_id_reg_pd", number))  sort="numero A " )
