table(column=(type=long update=yes updatewhereclause=yes key=yes name=id_esercizio dbname="registro.id_esercizio" )
 column=(type=char(2) update=yes updatewhereclause=yes key=yes name=registro_tipo_registro dbname="registro.tipo_registro" values="IVA acquisti	IA/IVA vendite	IV/IVA corrispettivi	IC/Manageriale	MN/Prima nota	PN/Preventivi acquisti	PA/Preventivi vendite	PV/Ordini acquisti	OA/Ordini vendite	OV/DDT acquisti	DA/DDT vendite	DV/Liste prelievo acquisti	LA/Liste prelievo vendite	LV/Generico acquisti	GA/Generico vendite	GV/Conto lavorazione Clienti	LC/Conto lavorazione Fornitori	LF/Conto visione Clienti	VC/Conto visione Fornitori	VF/Scarico Lotti	SL/Carico Lotti	CL/" )
 column=(type=long update=yes updatewhereclause=yes identity=yes name=registro_id_registro dbname="registro.id_registro" )
 column=(type=decimal(0) update=yes updatewhereclause=yes key=yes name=registro_numero dbname="registro.numero" validation=" real(gettext())  >= 0" validationmsg="'Immettere un valore >= 0'" )
 column=(type=char(40) update=yes updatewhereclause=yes name=registro_descrizione dbname="registro.descrizione" )
 column=(type=long update=yes updatewhereclause=yes name=registro_id_attivita dbname="registro.id_attivita" )
 column=(type=long update=yes updatewhereclause=yes key=yes name=registro_id_azienda dbname="registro.id_azienda" initial="1" )
 column=(type=char(40) updatewhereclause=yes name=attivita_descrizione dbname="attivita.descrizione" )
 column=(type=long updatewhereclause=yes name=attivita_id_azienda dbname="attivita.id_azienda" initial="1" )
 column=(type=char(1) update=yes updatewhereclause=yes name=registro_ges_sco_giornaliero dbname="registro.ges_sco_giornaliero" initial="N" values="	S/	N" validation=" gettext()  = 'S' OR  gettext()  = 'N'" validationmsg="'Immettere: S, N'" )
 column=(type=long update=yes updatewhereclause=yes name=registro_id_mod_registro dbname="registro.id_mod_registro" )
 column=(type=decimal(2) update=yes updatewhereclause=yes name=registro_perc_prorata dbname="registro.perc_prorata" )
 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"registro~" )  TABLE(NAME=~"attivita~" ) COLUMN(NAME=~"registro.id_esercizio~") COLUMN(NAME=~"registro.tipo_registro~") COLUMN(NAME=~"registro.id_registro~") COLUMN(NAME=~"registro.numero~") COLUMN(NAME=~"registro.descrizione~") COLUMN(NAME=~"registro.id_attivita~") COLUMN(NAME=~"registro.id_azienda~") COLUMN(NAME=~"attivita.descrizione~") COLUMN(NAME=~"attivita.id_azienda~") COLUMN(NAME=~"registro.ges_sco_giornaliero~") COLUMN(NAME=~"registro.id_mod_registro~") COLUMN(NAME=~"registro.perc_prorata~")    JOIN (LEFT=~"attivita.id_attivita~"    OP =~"=~"RIGHT=~"registro.id_attivita~" )WHERE(    EXP1 =~"~~~"registro~~~".~~~"id_azienda~~~"~"   OP =~"in~"    EXP2 =~"(0,1)~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"registro~~~".~~~"id_esercizio~~~"~"   OP =~"=~"    EXP2 =~":rn_id_esercizio1~" ) ) ORDER(NAME=~"registro.tipo_registro~" ASC=yes )  ORDER(NAME=~"registro.numero~" ASC=yes ) ARG(NAME = ~"rn_id_esercizio1~" TYPE = number) " update="registro" updatewhere=0 updatekeyinplace=no arguments=(("rn_id_esercizio1", number)) )
