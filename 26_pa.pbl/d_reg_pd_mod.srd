 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"reg_pd~" )  TABLE(NAME=~"conto~" )  TABLE(NAME=~"registro~" ) COLUMN(NAME=~"reg_pd.id_reg_pd~") COLUMN(NAME=~"reg_pd.num_progressivo~") COLUMN(NAME=~"reg_pd.data_competenza~") COLUMN(NAME=~"reg_pd.data_registrazione~") COLUMN(NAME=~"reg_pd.num_documento~") COLUMN(NAME=~"reg_pd.data_documento~") COLUMN(NAME=~"reg_pd.importo~") COLUMN(NAME=~"reg_pd.tipo_fattura~") COLUMN(NAME=~"reg_pd.data_comp_liq_iva~") COLUMN(NAME=~"conto.codice~") COLUMN(NAME=~"conto.descrizione~") COLUMN(NAME=~"reg_pd.descrizione~")    JOIN (LEFT=~"conto.id_conto~"    OP =~"=~"RIGHT=~"reg_pd.id_conto~"    OUTER2 =~"reg_pd.id_conto~" )    JOIN (LEFT=~"registro.id_registro~"    OP =~"=~"RIGHT=~"reg_pd.id_registro~"    OUTER2 =~"reg_pd.id_registro~" )WHERE(    EXP1 =~"~~~"registro~~~".~~~"tipo_registro~~~"~"   OP =~"=~"    EXP2 =~":rs_registro~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"reg_pd~~~".~~~"data_registrazione~~~"~"   OP =~">=~"    EXP2 =~":rd_da~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"reg_pd~~~".~~~"data_registrazione~~~"~"   OP =~"<=~"    EXP2 =~":rd_a~" ) ) ARG(NAME = ~"rs_registro~" TYPE = string)  ARG(NAME = ~"rd_da~" TYPE = date)  ARG(NAME = ~"rd_a~" TYPE = date) " update="reg_pd" updatewhere=1 updatekeyinplace=yes arguments=(("rs_registro", string),("rd_da", date),("rd_a", date)) )
