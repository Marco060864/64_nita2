 column=(type=char(8) updatewhereclause=yes name=conto_codice dbname="conto.codice" )
 column=(type=char(40) updatewhereclause=yes name=conto_descrizione dbname="conto.descrizione" )
 column=(type=char(4) updatewhereclause=yes name=valuta_codice dbname="valuta.codice" )
 column=(type=char(40) updatewhereclause=yes name=valuta_descrizione dbname="valuta.descrizione" )
 column=(type=char(40) update=yes updatewhereclause=yes name=mov_contabile_des_contabile dbname="mov_contabile.des_contabile" )
 column=(type=char(1) update=yes updatewhereclause=yes name=mov_contabile_rateo_risconto dbname="mov_contabile.rateo_risconto" values="Non Gestito	N/Rateo	T/Risconto	S/" )
 column=(type=long updatewhereclause=yes name=cid_reg_app dbname="id_reg_app" )
 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"mov_contabile~" )  TABLE(NAME=~"conto~" )  TABLE(NAME=~"valuta~" ) COLUMN(NAME=~"mov_contabile.id_mov_contabile~") COLUMN(NAME=~"mov_contabile.id_reg_pd~") COLUMN(NAME=~"mov_contabile.numero~") COLUMN(NAME=~"mov_contabile.id_conto~") COLUMN(NAME=~"mov_contabile.id_valuta~") COLUMN(NAME=~"mov_contabile.cambio~") COLUMN(NAME=~"mov_contabile.dare~") COLUMN(NAME=~"mov_contabile.avere~") COLUMN(NAME=~"mov_contabile.data_val_banca~") COLUMN(NAME=~"mov_contabile.data_inizio_competenza~") COLUMN(NAME=~"mov_contabile.data_fine_competenza~") COLUMN(NAME=~"mov_contabile.id_azienda~") COLUMN(NAME=~"conto.codice~") COLUMN(NAME=~"conto.descrizione~") COLUMN(NAME=~"valuta.codice~") COLUMN(NAME=~"valuta.descrizione~") COLUMN(NAME=~"mov_contabile.des_contabile~") COLUMN(NAME=~"mov_contabile.rateo_risconto~") COMPUTE(NAME=~"cast(null as integer) as id_reg_app~")    JOIN (LEFT=~"conto.id_conto~"    OP =~"=~"RIGHT=~"mov_contabile.id_conto~" )    JOIN (LEFT=~"valuta.id_valuta~"    OP =~"=~"RIGHT=~"mov_contabile.id_valuta~" )WHERE(    EXP1 =~"~~~"mov_contabile~~~".~~~"id_azienda~~~"~"   OP =~"in~"    EXP2 =~"(0,1)~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"mov_contabile~~~".~~~"id_reg_pd~~~"~"   OP =~"=~"    EXP2 =~":ra_id_reg_pd~" ) ) ORDER(NAME=~"mov_contabile.numero~" ASC=yes ) ARG(NAME = ~"ra_id_reg_pd~" TYPE = number) " update="mov_contabile" updatewhere=1 updatekeyinplace=yes arguments=(("ra_id_reg_pd", number))  sort="numero A " )
