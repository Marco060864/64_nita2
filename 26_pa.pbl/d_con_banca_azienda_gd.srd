 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"con_banca_azienda~" ) COLUMN(NAME=~"con_banca_azienda.data_condizione~") COLUMN(NAME=~"con_banca_azienda.tasso_credito~") COLUMN(NAME=~"con_banca_azienda.tasso_debito~") COLUMN(NAME=~"con_banca_azienda.fido~") COLUMN(NAME=~"con_banca_azienda.spese_commissione~") COLUMN(NAME=~"con_banca_azienda.gg_val_contante~") COLUMN(NAME=~"con_banca_azienda.gg_val_piazza~") COLUMN(NAME=~"con_banca_azienda.gg_val_fuori_piazza~") COLUMN(NAME=~"con_banca_azienda.gg_min_cal_esposizione~") COLUMN(NAME=~"con_banca_azienda.cas_effetti~") COLUMN(NAME=~"con_banca_azienda.id_azienda~") COLUMN(NAME=~"con_banca_azienda.id_banca_azienda~")WHERE(    EXP1 =~"~~~"con_banca_azienda~~~".~~~"id_banca_azienda~~~"~"   OP =~"=~"    EXP2 =~":ra_id_banca_azienda~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"con_banca_azienda~~~".~~~"id_azienda~~~"~"   OP =~"in~"    EXP2 =~"(0, 1)~" ) ) ARG(NAME = ~"ra_id_banca_azienda~" TYPE = number) " update="con_banca_azienda" updatewhere=1 updatekeyinplace=yes arguments=(("ra_id_banca_azienda", number)) )
