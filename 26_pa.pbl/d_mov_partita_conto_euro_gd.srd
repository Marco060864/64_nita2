 column=(type=decimal(4) updatewhereclause=yes name=cimporto dbname="scadenza.importo" )
 column=(type=date updatewhereclause=yes name=cdata dbname="mov_scadenza.data" )
 column=(type=decimal(0) updatewhereclause=yes name=cimporto dbname="mov_scadenza.importo" )
 column=(type=real updatewhereclause=yes name=ceuro dbname="euro" )
 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"par_aperta~" )  TABLE(NAME=~"mov_partita~" )  TABLE(NAME=~"mov_scadenza~" )  TABLE(NAME=~"scadenza~" ) COLUMN(NAME=~"mov_partita.importo~") COLUMN(NAME=~"par_aperta.num_partita~") COLUMN(NAME=~"par_aperta.data_partita~") COLUMN(NAME=~"par_aperta.importo~") COMPUTE(NAME=~"(sum(~~~"mov_partita~~~".~~~"importo~~~")) as Tot_Mov_Partita~") COMPUTE(NAME=~"(ifnull(Tot_Mov_Partita, 0, Tot_Mov_Partita)) as SommaNN~") COMPUTE(NAME=~"(~~~"par_aperta~~~".~~~"importo~~~" - SommaNN) as Saldo~") COLUMN(NAME=~"scadenza.data_scadenza~") COLUMN(NAME=~"scadenza.importo~") COLUMN(NAME=~"mov_scadenza.data~") COLUMN(NAME=~"mov_scadenza.importo~") COMPUTE(NAME=~"cast( 1 as real) as euro~")    JOIN (LEFT=~"mov_scadenza.id_mov_partita~"    OP =~"=~"RIGHT=~"mov_partita.id_mov_partita~"    OUTER2 =~"mov_partita.id_mov_partita~" )    JOIN (LEFT=~"mov_scadenza.id_scadenza~"    OP =~"=~"RIGHT=~"scadenza.id_scadenza~"    OUTER1 =~"mov_scadenza.id_scadenza~" )    JOIN (LEFT=~"mov_partita.id_par_aperta~"    OP =~"=~"RIGHT=~"par_aperta.id_par_aperta~" )WHERE(    EXP1 =~"~~~"mov_partita~~~".~~~"id_mov_contabile~~~"~"   OP =~"=~"    EXP2 =~":rn_id_mov_contabile~" )  GROUP(NAME=~"mov_partita.importo~") GROUP(NAME=~"mov_partita.data~") GROUP(NAME=~"mov_scadenza.importo~") GROUP(NAME=~"mov_scadenza.data~") GROUP(NAME=~"scadenza.importo~") GROUP(NAME=~"par_aperta.importo~") GROUP(NAME=~"scadenza.data_scadenza~") GROUP(NAME=~"par_aperta.data_partita~") GROUP(NAME=~"par_aperta.num_partita~")) ORDER(NAME=~"par_aperta.num_partita~" ASC=yes ) ARG(NAME = ~"rn_id_mov_contabile~" TYPE = number) " arguments=(("rn_id_mov_contabile", number)) )
