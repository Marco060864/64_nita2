 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"compenso~" )  TABLE(NAME=~"reg_pd~" )  TABLE(NAME=~"conto~" ) COLUMN(NAME=~"conto.codice~") COLUMN(NAME=~"conto.descrizione~") COLUMN(NAME=~"compenso.num_reg_progressivo~") COLUMN(NAME=~"compenso.data_registrazione~") COLUMN(NAME=~"compenso.data_competenza~") COLUMN(NAME=~"compenso.num_documento~") COLUMN(NAME=~"compenso.data_documento~") COLUMN(NAME=~"compenso.id_tributo~") COLUMN(NAME=~"compenso.descrizione~") COLUMN(NAME=~"compenso.per_cassa_previdenza~") COLUMN(NAME=~"compenso.per_imp_ritenuta~") COLUMN(NAME=~"compenso.per_rit_acconto~") COLUMN(NAME=~"compenso.per_rit_previdenziale~") COLUMN(NAME=~"compenso.id_compenso~") COLUMN(NAME=~"compenso.id_reg_pd~") COLUMN(NAME=~"compenso.rimborsi~") COLUMN(NAME=~"compenso.cassa_previdenza~") COLUMN(NAME=~"compenso.imp_ritenuta~") COLUMN(NAME=~"compenso.rit_acconto~") COLUMN(NAME=~"compenso.rit_previdenziale~")    JOIN (LEFT=~"reg_pd.id_reg_pd~"    OP =~"=~"RIGHT=~"compenso.id_reg_pd~" )    JOIN (LEFT=~"conto.id_conto~"    OP =~"=~"RIGHT=~"reg_pd.id_conto~" )) " update="compenso" updatewhere=1 updatekeyinplace=yes )
