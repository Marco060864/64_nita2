table(column=(type=char(2) updatewhereclause=yes name=mastro_codice dbname="mastro.codice" validation="len( gettext() ) = 2" validationmsg="'Il codice ~~'' +  gettext()  + '~~' non è di 2 lettere.'" )
 column=(type=char(2) updatewhereclause=yes name=sottomastro_codice dbname="sottomastro.codice" validation="len( gettext() ) = 2" validationmsg="'Il codice ~~'' +  gettext()  + '~~' non è di 2 lettere.'" )
 column=(type=char(8) updatewhereclause=yes name=conto_codice dbname="conto.codice" )
 column=(type=char(4) updatewhereclause=yes name=esercizio_codice dbname="esercizio.codice" )
 column=(type=decimal(4) updatewhereclause=yes name=cdare dbname="dare" )
 column=(type=decimal(4) updatewhereclause=yes name=cavere dbname="avere" )
 column=(type=long updatewhereclause=yes name=id_conto dbname="conto.id_conto" )
 column=(type=long updatewhereclause=yes name=id_esercizio dbname="esercizio.id_esercizio" )
 column=(type=decimal(4) updatewhereclause=yes name=csaldo dbname="saldo" )
 column=(type=decimal(4) updatewhereclause=yes name=cdare_comp dbname="dare_comp" )
 column=(type=decimal(4) updatewhereclause=yes name=cavere_comp dbname="avere_comp" )
 column=(type=decimal(4) updatewhereclause=yes name=csaldo_comp dbname="saldo_comp" )
 column=(type=decimal(4) updatewhereclause=yes name=csaldo_tot dbname="saldo_tot" )
 column=(type=char(40) updatewhereclause=yes name=conto_descrizione dbname="conto.descrizione" )
 column=(type=long updatewhereclause=yes name=id_valuta dbname="esercizio.id_valuta" )
 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"azienda~" )  TABLE(NAME=~"conto~" )  TABLE(NAME=~"esercizio~" )  TABLE(NAME=~"mastro~" )  TABLE(NAME=~"saldo_mensile~" )  TABLE(NAME=~"sottomastro~" ) COLUMN(NAME=~"mastro.codice~") COLUMN(NAME=~"sottomastro.codice~") COLUMN(NAME=~"conto.codice~") COLUMN(NAME=~"esercizio.codice~") COMPUTE(NAME=~"sum(~~~"saldo_mensile~~~".~~~"dare~~~") as Dare~") COMPUTE(NAME=~"sum(~~~"saldo_mensile~~~".~~~"avere~~~") as Avere~") COLUMN(NAME=~"conto.id_conto~") COLUMN(NAME=~"esercizio.id_esercizio~") COMPUTE(NAME=~"Dare - Avere as Saldo~") COMPUTE(NAME=~"sum(~~~"saldo_mensile~~~".~~~"dare_competenza~~~") as Dare_Comp~") COMPUTE(NAME=~"sum(~~~"saldo_mensile~~~".~~~"avere_competenza~~~") as Avere_Comp~") COMPUTE(NAME=~"Dare_Comp - Avere_Comp as Saldo_Comp~") COMPUTE(NAME=~"Saldo + Saldo_Comp as Saldo_Tot~") COLUMN(NAME=~"conto.descrizione~") COLUMN(NAME=~"esercizio.id_valuta~")    JOIN (LEFT=~"esercizio.id_esercizio~"    OP =~"=~"RIGHT=~"azienda.id_esercizio~"    OUTER2 =~"azienda.id_esercizio~" )    JOIN (LEFT=~"saldo_mensile.id_conto~"    OP =~"=~"RIGHT=~"conto.id_conto~"    OUTER2 =~"conto.id_conto~" )    JOIN (LEFT=~"saldo_mensile.id_esercizio~"    OP =~"=~"RIGHT=~"esercizio.id_esercizio~" )    JOIN (LEFT=~"sottomastro.id_mastro~"    OP =~"=~"RIGHT=~"mastro.id_mastro~" )    JOIN (LEFT=~"sottomastro.id_sottomastro~"    OP =~"=~"RIGHT=~"conto.id_sottomastro~" )WHERE(    EXP1 =~"~~~"conto~~~".~~~"id_azienda~~~"~"   OP =~"in~"    EXP2 =~"(0, 1)~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"azienda~~~".~~~"id_azienda~~~"~"   OP =~"=~"    EXP2 =~"1~" )  GROUP(NAME=~"conto.id_conto~") GROUP(NAME=~"conto.codice~") GROUP(NAME=~"conto.descrizione~") GROUP(NAME=~"esercizio.id_esercizio~") GROUP(NAME=~"esercizio.codice~") GROUP(NAME=~"esercizio.id_valuta~") GROUP(NAME=~"mastro.codice~") GROUP(NAME=~"sottomastro.codice~")) " )
