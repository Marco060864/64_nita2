footer(height=0 color="536870912" )
detail(height=76 color="536870912" )
table(column=(type=long updatewhereclause=yes key=yes identity=yes name=id_par_aperta dbname="par_aperta.id_par_aperta" )
 column=(type=char(16) updatewhereclause=yes name=num_partita dbname="par_aperta.num_partita" )
 column=(type=date updatewhereclause=yes name=data_partita dbname="par_aperta.data_partita" )
 column=(type=decimal(6) updatewhereclause=yes name=importo dbname="importo" )
 column=(type=decimal(6) updatewhereclause=yes name=saldo dbname="saldo" )
 column=(type=long updatewhereclause=yes name=id_conto dbname="par_aperta.id_conto" )
 column=(type=decimal(0) updatewhereclause=yes name=segno_iva dbname="par_aperta.segno_iva" )
 column=(type=char(1) updatewhereclause=yes name=stato dbname="par_aperta.stato" )
 column=(type=long updatewhereclause=yes name=id_reg_pd dbname="id_reg_pd" )
 column=(type=char(20) updatewhereclause=yes name=codice dbname="codice" )
 column=(type=decimal(6) updatewhereclause=yes name=importo2 dbname="importo2" )
 column=(type=decimal(4) updatewhereclause=yes name=abbuono dbname="abbuono" )
 column=(type=decimal(4) updatewhereclause=yes name=tot_reg dbname="tot_reg" )
 column=(type=long updatewhereclause=yes name=test dbname="test" initial="0" values="	1/	0" )
 retrieve="  SELECT ~"par_aperta~".~"id_par_aperta~",   
         ~"par_aperta~".~"num_partita~",   
         ~"par_aperta~".~"data_partita~",   
         fn_conv_valuta(~"par_aperta~".~"id_valuta~",~"par_aperta~".~"importo~",:rd_val) as importo, 
         (fn_conv_valuta(~"par_aperta~".~"id_valuta~",~"par_aperta~".~"importo~",:rd_val) - ( ifnull( importo2 , 0 , importo2 ))) as saldo,    
         ~"par_aperta~".~"id_conto~",   
         ~"par_aperta~".~"segno_iva~",
         ~"par_aperta~".~"stato~",
 			cast(0 as integer) as id_reg_pd ,
   		cast((select codice from conto where id_conto=~"par_aperta~".~"id_conto~")  as char(20)) as codice,
   		(select sum(ifnull(mov_partita.importo,0,fn_conv_valuta(~"par_aperta~".~"id_valuta~",mov_partita.importo,:rd_val))) from ~"DBA~".mov_partita where mov_partita.id_par_aperta=par_aperta.id_par_aperta ) as importo2,
  			cast(0 as decimal(18,4)) as abbuono ,	
  			cast(0 as decimal(18,4)) as tot_reg,
         cast(0 as integer) as test	
    FROM ~"par_aperta~"
 	where ~"par_aperta~".~"data_partita~" >=:rd_da and 
			~"par_aperta~".~"data_partita~" <=:rd_a and
   		~"par_aperta~".~"stato~" = 'A' and 
			~"par_aperta~".~"segno_iva~"=1 and
         saldo > 0
order by  codice, ~"par_aperta~".~"data_partita~", saldo" update="par_aperta" updatewhere=0 updatekeyinplace=no arguments=(("rd_da", date),("rd_val", number),("rd_a", date)) )
