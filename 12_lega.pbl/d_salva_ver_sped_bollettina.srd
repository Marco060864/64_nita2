 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"ver_sped_bollettina~" ) COLUMN(NAME=~"ver_sped_bollettina.id_ver_sped_bollettina~") COLUMN(NAME=~"ver_sped_bollettina.data_spedizione~") COLUMN(NAME=~"ver_sped_bollettina.num_bollettina~") COLUMN(NAME=~"ver_sped_bollettina.data_richiesta~") COLUMN(NAME=~"ver_sped_bollettina.descrizione~") COLUMN(NAME=~"ver_sped_bollettina.data_urgenza~") COLUMN(NAME=~"ver_sped_bollettina.cliente~") COLUMN(NAME=~"ver_sped_bollettina.data_inserimento~") COLUMN(NAME=~"ver_sped_bollettina.provenienza~") COLUMN(NAME=~"ver_sped_bollettina.id_utenti~") COLUMN(NAME=~"ver_sped_bollettina.tipo~")WHERE(    EXP1 =~"( ~~~"ver_sped_bollettina~~~".~~~"data_inserimento~~~"~"   OP =~"=~"    EXP2 =~"GETDATE())~"    LOGIC =~"or~" ) WHERE(    EXP1 =~"( ~~~"ver_sped_bollettina~~~".~~~"data_inserimento~~~"~"   OP =~">=~"    EXP2 =~"CAST(DATEADD(DAY, -5, GETDATE()) as DATE) )~" ) ) " update="ver_sped_bollettina" updatewhere=1 updatekeyinplace=yes  sort="num_bollettina A " )
