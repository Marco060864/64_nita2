table(column=(type=long update=yes updatewhereclause=yes key=yes name=id_documento dbname="documento.id_documento" dbalias=".id_documento" )
 column=(type=decimal(0) update=yes updatewhereclause=yes name=num_progressivo dbname="documento.num_progressivo" dbalias=".num_progressivo" )
 column=(type=date updatewhereclause=yes name=data_registrazione dbname="documento.data_registrazione" dbalias=".data_registrazione" )
 column=(type=char(16) updatewhereclause=yes name=num_documento dbname="documento.num_documento" dbalias=".num_documento" )
 column=(type=date updatewhereclause=yes name=data_documento dbname="documento.data_documento" dbalias=".data_documento" )
 column=(type=long updatewhereclause=yes name=id_prof_documento dbname="documento.id_prof_documento" dbalias=".id_prof_documento" )
 column=(type=char(32766) updatewhereclause=no name=riga_documento_descrizione dbname="riga_documento.descrizione" dbalias=".descrizione" )
 column=(type=decimal(4) updatewhereclause=yes name=riga_documento_quantita dbname="riga_documento.quantita" dbalias=".quantita" )
 column=(type=decimal(4) updatewhereclause=yes name=riga_documento_peso_netto dbname="riga_documento.peso_netto" dbalias=".peso_netto" )
 column=(type=char(64) updatewhereclause=yes name=articolo_codice dbname="articolo.codice" dbalias=".codice" )
 column=(type=long updatewhereclause=yes name=riga_documento_id_riga_documento dbname="riga_documento.id_riga_documento" dbalias=".id_riga_documento" )
 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"documento~" )  TABLE(NAME=~"articolo~" )  TABLE(NAME=~"riga_documento~" ) COLUMN(NAME=~"documento.id_documento~") COLUMN(NAME=~"documento.num_progressivo~") COLUMN(NAME=~"documento.data_registrazione~") COLUMN(NAME=~"documento.num_documento~") COLUMN(NAME=~"documento.data_documento~") COLUMN(NAME=~"documento.id_prof_documento~") COLUMN(NAME=~"riga_documento.descrizione~") COLUMN(NAME=~"riga_documento.quantita~") COLUMN(NAME=~"riga_documento.peso_netto~") COLUMN(NAME=~"articolo.codice~") COLUMN(NAME=~"riga_documento.id_riga_documento~")    JOIN (LEFT=~"riga_documento.id_articolo~"    OP =~"=~"RIGHT=~"articolo.id_articolo~" )    JOIN (LEFT=~"documento.id_documento~"    OP =~"=~"RIGHT=~"riga_documento.id_documento~" )WHERE(    EXP1 =~"(~~~"documento~~~".~~~"id_prof_documento~~~"~"   OP =~"=~"    EXP2 =~"65~"    LOGIC =~"or~" ) WHERE(    EXP1 =~"~~~"documento~~~".~~~"id_prof_documento~~~"~"   OP =~"=~"    EXP2 =~"111)~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"documento~~~".~~~"num_progressivo~~~"~"   OP =~">~"    EXP2 =~"50000~" ) ) " update="documento" updatewhere=1 updatekeyinplace=yes )
