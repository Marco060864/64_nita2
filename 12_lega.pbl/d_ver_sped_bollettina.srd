table(column=(type=long updatewhereclause=yes identity=yes name=riga_documento_id_riga_documento dbname="riga_documento.id_riga_documento" dbalias=".id_riga_documento" )
 column=(type=char(40) updatewhereclause=yes name=num_bollettina dbname="riga_documento.sconto" dbalias=".sconto" )
 column=(type=long updatewhereclause=yes name=riga_documento_id_documento dbname="riga_documento.id_documento" dbalias=".id_documento" )
 column=(type=decimal(0) updatewhereclause=yes name=riga_documento_num_riga dbname="riga_documento.num_riga" dbalias=".num_riga" )
 column=(type=long updatewhereclause=yes name=riga_documento_id_articolo dbname="riga_documento.id_articolo" dbalias=".id_articolo" )
 column=(type=char(64) updatewhereclause=yes name=articolo_codice dbname="articolo.codice" dbalias=".codice" )
 column=(type=char(32766) updatewhereclause=no name=riga_documento_descrizione dbname="riga_documento.descrizione" dbalias=".descrizione" )
 column=(type=decimal(4) updatewhereclause=yes name=riga_documento_quantita dbname="riga_documento.quantita" dbalias=".quantita" )
 column=(type=decimal(4) updatewhereclause=yes name=riga_documento_peso_netto dbname="riga_documento.peso_netto" dbalias=".peso_netto" )
 column=(type=char(16) updatewhereclause=yes name=documento_num_documento dbname="documento.num_documento" dbalias=".num_documento" )
 column=(type=date updatewhereclause=yes name=documento_data_documento dbname="documento.data_documento" dbalias=".data_documento" )
 column=(type=char(8) updatewhereclause=yes name=prof_documento_codice dbname="prof_documento.codice" dbalias=".codice" )
 column=(type=char(10) updatewhereclause=yes name=c_data_richiesta dbname="c_data_richiesta" )
 column=(type=char(142) updatewhereclause=yes name=c_descrizione dbname="c_descrizione" )
 column=(type=date updatewhereclause=yes name=data_urgenza dbname="documento.data_trasporto" dbalias=".data_trasporto" initial="null" )
 column=(type=char(1) updatewhereclause=yes name=c_scelto dbname="c_scelto" values="	S/	N" )
 column=(type=char(6) updatewhereclause=yes name=pd_cliente dbname="prof_documento.int_consentiti" dbalias=".int_consentiti" )
 column=(type=char(1) updatewhereclause=yes name=giorno_rientro_silver dbname="riga_documento_2.giorno_rientro_silver" dbalias=".giorno_rientro_silver" )
 column=(type=char(1) updatewhereclause=yes name=c_provenienza dbname="c_provenienza" )
 column=(type=date updatewhereclause=yes name=c_data_inserimento dbname="c_data_inserimento" )
 column=(type=date updatewhereclause=yes name=data_prev_consegna dbname="documento.data_prev_consegna" dbalias=".data_prev_consegna" )
 column=(type=char(1) updatewhereclause=yes name=tipo dbname="tipo" )
 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"riga_documento~" )  TABLE(NAME=~"articolo~" )  TABLE(NAME=~"documento~" )  TABLE(NAME=~"prof_documento~" )  TABLE(NAME=~"riga_documento_2~" ) COLUMN(NAME=~"riga_documento.id_riga_documento~") COLUMN(NAME=~"riga_documento.sconto~") COLUMN(NAME=~"riga_documento.id_documento~") COLUMN(NAME=~"riga_documento.num_riga~") COLUMN(NAME=~"riga_documento.id_articolo~") COLUMN(NAME=~"articolo.codice~") COLUMN(NAME=~"riga_documento.descrizione~") COLUMN(NAME=~"riga_documento.quantita~") COLUMN(NAME=~"riga_documento.peso_netto~") COLUMN(NAME=~"documento.num_documento~") COLUMN(NAME=~"documento.data_documento~") COLUMN(NAME=~"prof_documento.codice~") COMPUTE(NAME=~"'----------' as c_data_richiesta~") COMPUTE(NAME=~"'                                                                                                                                              ' as c_descrizione~") COLUMN(NAME=~"documento.data_trasporto~") COMPUTE(NAME=~"' ' as c_scelto~") COLUMN(NAME=~"prof_documento.int_consentiti~") COLUMN(NAME=~"riga_documento_2.giorno_rientro_silver~") COMPUTE(NAME=~"'0' AS C_PROVENIENZA~") COMPUTE(NAME=~"date('1901-01-01') as c_data_inserimento~") COLUMN(NAME=~"documento.data_prev_consegna~") COMPUTE(NAME=~"'' as tipo~")    JOIN (LEFT=~"riga_documento.id_riga_documento~"    OP =~"=~"RIGHT=~"riga_documento_2.id_riga_documento~"    OUTER1 =~"riga_documento.id_riga_documento~" )    JOIN (LEFT=~"articolo.id_articolo~"    OP =~"=~"RIGHT=~"riga_documento.id_articolo~" )    JOIN (LEFT=~"documento.id_documento~"    OP =~"=~"RIGHT=~"riga_documento.id_documento~" )    JOIN (LEFT=~"prof_documento.id_prof_documento~"    OP =~"=~"RIGHT=~"documento.id_prof_documento~" )WHERE(    EXP1 =~"~~~"riga_documento~~~".~~~"id_riga_documento~~~"~"   OP =~"=~"    EXP2 =~":id_riga_bollettina~" ) ) ARG(NAME = ~"id_riga_bollettina~" TYPE = number) " arguments=(("id_riga_bollettina", number)) )
