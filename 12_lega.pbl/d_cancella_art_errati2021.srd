table(column=(type=long update=yes updatewhereclause=yes key=yes identity=yes name=articolo_id_articolo dbname="articolo.id_articolo" dbalias=".id_articolo" )
 column=(type=char(64) update=yes updatewhereclause=yes name=articolo_codice dbname="articolo.codice" dbalias=".codice" )
 column=(type=long updatewhereclause=yes name=unita_confezione_id_unita_confezione dbname="unita_confezione.id_unita_confezione" dbalias=".id_unita_confezione" )
 column=(type=char(255) updatewhereclause=yes name=prezzo_des_1 dbname="prezzo.des_1" dbalias=".des_1" )
 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"articolo~" )  TABLE(NAME=~"prezzo~" )  TABLE(NAME=~"unita_confezione~" ) COLUMN(NAME=~"articolo.id_articolo~") COLUMN(NAME=~"articolo.codice~") COLUMN(NAME=~"unita_confezione.id_unita_confezione~") COLUMN(NAME=~"prezzo.des_1~")    JOIN (LEFT=~"unita_confezione.id_unita_confezione~"    OP =~"=~"RIGHT=~"prezzo.id_unita_confezione~" )    JOIN (LEFT=~"unita_confezione.id_articolo~"    OP =~"=~"RIGHT=~"articolo.id_articolo~" )WHERE(    EXP1 =~"~~~"prezzo~~~".~~~"id_variazione~~~"~"   OP =~"=~"    EXP2 =~"15~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"prezzo~~~".~~~"des_1~~~"~"   OP =~"=~"    EXP2 =~"'AUTO_XLS 05_04_21'~" ) ) " update="articolo" updatewhere=1 updatekeyinplace=yes )
