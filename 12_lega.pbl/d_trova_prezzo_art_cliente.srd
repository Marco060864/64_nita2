table(column=(type=char(16) updatewhereclause=yes name=c_cliente1 dbname="c_cliente1" )
 column=(type=decimal(6) updatewhereclause=yes name=riga_documento_prezzo_netto dbname="riga_documento.prezzo_netto" )
 column=(type=char(32) updatewhereclause=yes name=articolo_codice dbname="articolo.codice" )
 column=(type=char(32766) updatewhereclause=no name=riga_documento_descrizione dbname="riga_documento.descrizione" )
 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"documento~" )  TABLE(NAME=~"riga_documento~" )  TABLE(NAME=~"articolo~" ) COMPUTE(NAME=~"(select num_documento from documento d, riga_documento r where d.id_documento=r.id_documento and id_riga_documento=~~~"riga_documento~~~".~~~"id_riga_doc_provenienza~~~") as c_cliente1~") COLUMN(NAME=~"riga_documento.prezzo_netto~") COLUMN(NAME=~"articolo.codice~") COLUMN(NAME=~"riga_documento.descrizione~")    JOIN (LEFT=~"documento.id_documento~"    OP =~"=~"RIGHT=~"riga_documento.id_documento~" )    JOIN (LEFT=~"riga_documento.id_articolo~"    OP =~"=~"RIGHT=~"articolo.id_articolo~" )WHERE(    EXP1 =~"~~~"documento~~~".~~~"data_documento~~~"~"   OP =~">~"    EXP2 =~"20190101~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"documento~~~".~~~"id_prof_documento~~~"~"   OP =~"=~"    EXP2 =~"66~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"locate((select num_documento from documento d, riga_documento r where d.id_documento=r.id_documento and id_riga_documento=~~~"riga_documento~~~".~~~"id_riga_doc_provenienza~~~"), '-') ~"   OP =~">~"    EXP2 =~"0~" ) ) "  sort="c_cliente1 A riga_documento_prezzo_netto A articolo_codice A " )
