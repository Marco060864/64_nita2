 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"riga_documento~" )  TABLE(NAME=~"catena_resa~" )  TABLE(NAME=~"documento~" ) COLUMN(NAME=~"riga_documento.id_riga_documento~") COLUMN(NAME=~"catena_resa.id_riga_documento~") COLUMN(NAME=~"documento.id_prof_documento~") COLUMN(NAME=~"documento.num_documento~") COLUMN(NAME=~"documento.data_documento~") COLUMN(NAME=~"riga_documento.num_riga~") COLUMN(NAME=~"riga_documento.id_articolo~") COLUMN(NAME=~"riga_documento.descrizione~") COLUMN(NAME=~"riga_documento.quantita~") COLUMN(NAME=~"riga_documento.peso_netto~") COLUMN(NAME=~"riga_documento.peso_lordo~") COLUMN(NAME=~"riga_documento.provv_imp_carea_2~") COLUMN(NAME=~"catena_resa.num_bollettina~") COLUMN(NAME=~"catena_resa.legato~") COLUMN(NAME=~"catena_resa.data_reso~") COLUMN(NAME=~"catena_resa.num_riga~") COLUMN(NAME=~"catena_resa.descrizione~") COLUMN(NAME=~"catena_resa.tara~") COLUMN(NAME=~"catena_resa.lacci~") COLUMN(NAME=~"catena_resa.data_ora_creazione~") COLUMN(NAME=~"catena_resa.tipo~") COLUMN(NAME=~"catena_resa.plus_01~") COLUMN(NAME=~"catena_resa.dato_01~") COLUMN(NAME=~"riga_documento.provv_imp_carea~")    JOIN (LEFT=~"riga_documento.provv_imp_carea_2~"    OP =~"=~"RIGHT=~"catena_resa.num_bollettina~"    OUTER1 =~"riga_documento.provv_imp_carea_2~" )    JOIN (LEFT=~"riga_documento.id_documento~"    OP =~"=~"RIGHT=~"documento.id_documento~" )WHERE(    EXP1 =~"( ~~~"documento~~~".~~~"id_prof_documento~~~"~"   OP =~"=~"    EXP2 =~"28 )~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"documento~~~".~~~"data_documento~~~"~"   OP =~">=~"    EXP2 =~" DATEADD(DAY, -30, CURRENT DATE)
~" ) ) " update="catena_resa" updatewhere=1 updatekeyinplace=yes )
