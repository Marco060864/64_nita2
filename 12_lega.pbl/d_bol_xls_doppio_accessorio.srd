table(column=(type=long updatewhereclause=yes identity=yes name=articolo_id_articolo dbname="articolo.id_articolo" dbalias=".id_articolo" )
 column=(type=char(7) updatewhereclause=yes name=cod_barre dbname="bollettine_excel.cod_barre" dbalias=".cod_barre" )
 column=(type=char(64) updatewhereclause=yes name=articolo dbname="bollettine_excel.articolo" dbalias=".articolo" )
 column=(type=char(32) updatewhereclause=yes name=accessorio dbname="bollettine_excel.accessorio" dbalias=".accessorio" )
 column=(type=char(255) updatewhereclause=yes name=cod_accessori_k_descrizione dbname="cod_accessori_k.descrizione" dbalias=".descrizione" )
 column=(type=decimal(6) updatewhereclause=yes name=c_prezzo dbname="c_prezzo" )
 column=(type=datetime updatewhereclause=yes name=bollettine_excel_data dbname="bollettine_excel.data" dbalias=".data" )
 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"bollettine_excel~" )  TABLE(NAME=~"articolo~" )  TABLE(NAME=~"cod_accessori_k~" ) COLUMN(NAME=~"articolo.id_articolo~") COLUMN(NAME=~"bollettine_excel.cod_barre~") COLUMN(NAME=~"bollettine_excel.articolo~") COLUMN(NAME=~"bollettine_excel.accessorio~") COLUMN(NAME=~"cod_accessori_k.descrizione~") COMPUTE(NAME=~"(select prezzo from dba.prezzo where id_variazione=15 and id_unita_confezione= (select id_unita_confezione from unita_confezione where id_articolo=articolo.id_articolo and unita_BASE='S')) as c_prezzo~") COLUMN(NAME=~"bollettine_excel.data~")    JOIN (LEFT=~"bollettine_excel.articolo~"    OP =~"=~"RIGHT=~"articolo.codice~" )    JOIN (LEFT=~"bollettine_excel.accessorio~"    OP =~"=~"RIGHT=~"cod_accessori_k.cod_accessorio~" )WHERE(    EXP1 =~"~~~"bollettine_excel~~~".~~~"accessorio~~~"~"   OP =~">~"    EXP2 =~"' '~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"bollettine_excel~~~".~~~"accessorio~~~"~"   OP =~"<>~"    EXP2 =~"'X'~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"bollettine_excel~~~".~~~"accessorio~~~"~"   OP =~"<>~"    EXP2 =~"'XXX'~" ) ) ORDER(NAME=~"bollettine_excel.accessorio~" ASC=no)  ORDER(NAME=~"bollettine_excel.data~" ASC=yes ) "  sort="articolo A bollettine_excel_data A " )
