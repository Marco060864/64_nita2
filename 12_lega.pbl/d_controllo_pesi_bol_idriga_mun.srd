table(column=(type=long updatewhereclause=yes name=documento_id_documento dbname="documento.id_documento" dbalias=".id_documento" )
 column=(type=decimal(0) updatewhereclause=yes name=documento_num_progressivo dbname="documento.num_progressivo" dbalias=".num_progressivo" )
 column=(type=char(16) updatewhereclause=yes name=documento_num_documento dbname="documento.num_documento" dbalias=".num_documento" )
 column=(type=date updatewhereclause=yes name=documento_data_documento dbname="documento.data_documento" dbalias=".data_documento" )
 column=(type=long updatewhereclause=yes name=riga_documento_id_riga_documento dbname="riga_documento.id_riga_documento" dbalias=".id_riga_documento" )
 column=(type=decimal(0) updatewhereclause=yes name=riga_documento_num_riga dbname="riga_documento.num_riga" dbalias=".num_riga" )
 column=(type=long updatewhereclause=yes name=riga_documento_id_articolo dbname="riga_documento.id_articolo" dbalias=".id_articolo" )
 column=(type=char(32766) updatewhereclause=no name=riga_documento_descrizione dbname="riga_documento.descrizione" dbalias=".descrizione" )
 column=(type=decimal(4) updatewhereclause=yes name=riga_documento_quantita dbname="riga_documento.quantita" dbalias=".quantita" )
 column=(type=decimal(4) updatewhereclause=yes name=riga_documento_peso_netto dbname="riga_documento.peso_netto" dbalias=".peso_netto" )
 column=(type=decimal(4) updatewhereclause=yes name=riga_documento_peso_lordo dbname="riga_documento.peso_lordo" dbalias=".peso_lordo" )
 column=(type=date update=yes updatewhereclause=yes key=yes name=data_reso dbname="catena_resa.data_reso" dbalias=".data_reso" )
 column=(type=char(7) update=yes updatewhereclause=yes key=yes name=num_bollettina dbname="catena_resa.num_bollettina" dbalias=".num_bollettina" )
 column=(type=decimal(2) update=yes updatewhereclause=yes name=legato dbname="catena_resa.legato" dbalias=".legato" )
 column=(type=long update=yes updatewhereclause=yes name=num_riga dbname="catena_resa.num_riga" dbalias=".num_riga" )
 column=(type=char(80) update=yes updatewhereclause=yes name=catena_resa_descrizione dbname="catena_resa.descrizione" dbalias=".descrizione" )
 column=(type=datetime update=yes updatewhereclause=yes name=data_ora_creazione dbname="catena_resa.data_ora_creazione" dbalias=".data_ora_creazione" initial="today" )
 column=(type=char(1) update=yes updatewhereclause=yes key=yes name=tipo dbname="catena_resa.tipo" dbalias=".tipo" )
 column=(type=decimal(5) updatewhereclause=yes name=provv_imp_carea_2 dbname="riga_documento.provv_imp_carea_2" dbalias=".provv_imp_carea_2" )
 column=(type=decimal(2) update=yes updatewhereclause=yes name=tara dbname="catena_resa.tara" dbalias=".tara" )
 column=(type=long update=yes updatewhereclause=yes name=lacci dbname="catena_resa.lacci" dbalias=".lacci" )
 column=(type=char(64) update=yes updatewhereclause=yes name=plus_01 dbname="catena_resa.plus_01" dbalias=".plus_01" initial="A+" )
 column=(type=decimal(2) update=yes updatewhereclause=yes name=dato_01 dbname="catena_resa.dato_01" dbalias=".dato_01" )
 column=(type=long update=yes updatewhereclause=yes name=catena_resa_id_riga_documento dbname="catena_resa.id_riga_documento" dbalias=".id_riga_documento" )
 column=(type=decimal(4) updatewhereclause=yes name=provv_imp_carea dbname="riga_documento.provv_imp_carea" dbalias=".provv_imp_carea" )
 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"catena_resa~" )  TABLE(NAME=~"documento~" )  TABLE(NAME=~"riga_documento~" ) COLUMN(NAME=~"documento.id_documento~") COLUMN(NAME=~"documento.num_progressivo~") COLUMN(NAME=~"documento.num_documento~") COLUMN(NAME=~"documento.data_documento~") COLUMN(NAME=~"riga_documento.id_riga_documento~") COLUMN(NAME=~"riga_documento.num_riga~") COLUMN(NAME=~"riga_documento.id_articolo~") COLUMN(NAME=~"riga_documento.descrizione~") COLUMN(NAME=~"riga_documento.quantita~") COLUMN(NAME=~"riga_documento.peso_netto~") COLUMN(NAME=~"riga_documento.peso_lordo~") COLUMN(NAME=~"catena_resa.data_reso~") COLUMN(NAME=~"catena_resa.num_bollettina~") COLUMN(NAME=~"catena_resa.legato~") COLUMN(NAME=~"catena_resa.num_riga~") COLUMN(NAME=~"catena_resa.descrizione~") COLUMN(NAME=~"catena_resa.data_ora_creazione~") COLUMN(NAME=~"catena_resa.tipo~") COLUMN(NAME=~"riga_documento.provv_imp_carea_2~") COLUMN(NAME=~"catena_resa.tara~") COLUMN(NAME=~"catena_resa.lacci~") COLUMN(NAME=~"catena_resa.plus_01~") COLUMN(NAME=~"catena_resa.dato_01~") COLUMN(NAME=~"catena_resa.id_riga_documento~") COLUMN(NAME=~"riga_documento.provv_imp_carea~")    JOIN (LEFT=~"riga_documento.id_riga_documento~"    OP =~"=~"RIGHT=~"catena_resa.id_riga_documento~"    OUTER1 =~"riga_documento.id_riga_documento~" )    JOIN (LEFT=~"riga_documento.id_documento~"    OP =~"=~"RIGHT=~"documento.id_documento~" )WHERE(    EXP1 =~"~~~"documento~~~".~~~"id_prof_documento~~~"~"   OP =~"=~"    EXP2 =~"28~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"(~~~"riga_documento~~~".~~~"provv_imp_carea_2~~~"~"   OP =~"=~"    EXP2 =~":num_bol5~"    LOGIC =~"or~" ) WHERE(    EXP1 =~"~~~"riga_documento~~~".~~~"provv_imp_carea~~~"~"   OP =~"=~"    EXP2 =~":num_bol)~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"documento~~~".~~~"data_documento~~~"~"   OP =~"=~"    EXP2 =~":adt_data~" ) ) ARG(NAME = ~"num_bol~" TYPE = number)  ARG(NAME = ~"adt_data~" TYPE = date)  ARG(NAME = ~"num_bol5~" TYPE = number) " update="catena_resa" updatewhere=1 updatekeyinplace=yes arguments=(("num_bol", number),("adt_data", date),("num_bol5", number))  sort="num_riga D " )
