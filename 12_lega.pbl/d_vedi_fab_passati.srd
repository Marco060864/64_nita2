 retrieve="PBSELECT( VERSION(400) DISTINCT ()TABLE(NAME=~"documento~" ALIAS=~"documento_a~" )  TABLE(NAME=~"fabbisogno_accessori_k~" )  TABLE(NAME=~"riga_documento~" )  TABLE(NAME=~"produzione_2011~" )  TABLE(NAME=~"documento~" ALIAS=~"documento_b~" )  TABLE(NAME=~"sog_commerciale_gen~" ) COLUMN(NAME=~"fabbisogno_accessori_k.data_lista~") COLUMN(NAME=~"fabbisogno_accessori_k.id_riga_bol_provenienza~") COLUMN(NAME=~"fabbisogno_accessori_k.id_doc_sald~") COLUMN(NAME=~"documento_a.num_progressivo~") COLUMN(NAME=~"documento_a.num_documento~") COLUMN(NAME=~"documento_a.data_documento~") COMPUTE(NAME=~"0 as c_scelto~") COLUMN(NAME=~"documento_b.num_documento~") COLUMN(NAME=~"documento_b.data_documento~") COLUMN(NAME=~"sog_commerciale_gen.rag_soc_1~") COLUMN(NAME=~"riga_documento.id_riga_documento~") COLUMN(NAME=~"documento_a.id_documento~") COLUMN(NAME=~"documento_b.num_progressivo~")    JOIN (LEFT=~"documento_a.id_documento~"    OP =~"=~"RIGHT=~"produzione_2011.id_bollettina~"    OUTER1 =~"documento_a.id_documento~" )    JOIN (LEFT=~"produzione_2011.id_doc_produzione~"    OP =~"=~"RIGHT=~"riga_documento.id_riga_documento~"    OUTER1 =~"produzione_2011.id_doc_produzione~" )    JOIN (LEFT=~"riga_documento.id_documento~"    OP =~"=~"RIGHT=~"documento_b.id_documento~"    OUTER1 =~"riga_documento.id_documento~" )    JOIN (LEFT=~"documento_b.id_sog_commerciale~"    OP =~"=~"RIGHT=~"sog_commerciale_gen.id_sog_commerciale~"    OUTER1 =~"documento_b.id_sog_commerciale~" )    JOIN (LEFT=~"fabbisogno_accessori_k.id_doc_sald~"    OP =~"=~"RIGHT=~"documento_a.id_documento~"    OUTER2 =~"documento_a.id_documento~" )WHERE(    EXP1 =~"(~~~"produzione_2011~~~".~~~"id_bollettina~~~"~"   OP =~">~"    EXP2 =~"0~"    LOGIC =~"or~" ) WHERE(    EXP1 =~"~~~"fabbisogno_accessori_k~~~".~~~"data_lista~~~"~"   OP =~"is not~"    EXP2 =~"null)~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"documento_b~~~".~~~"id_prof_documento~~~"~"   OP =~"=~"    EXP2 =~"130~" ) ) "  sort="documento_num_progressivo D documento_num_documento D documento_data_documento D " )
