table(column=(type=date updatewhereclause=yes name=data_lista dbname="fabbisogno_accessori_k.data_lista" )
 column=(type=long updatewhereclause=yes name=id_riga_bol_provenienza dbname="fabbisogno_accessori_k.id_riga_bol_provenienza" )
 column=(type=long updatewhereclause=yes name=fabbisogno_accessori_k_id_doc_sald dbname="fabbisogno_accessori_k.id_doc_sald" )
 column=(type=decimal(0) updatewhereclause=yes name=documento_num_progressivo dbname="documento.num_progressivo" )
 column=(type=char(16) updatewhereclause=yes name=documento_num_documento dbname="documento.num_documento" )
