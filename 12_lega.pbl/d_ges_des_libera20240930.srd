table(column=(type=long update=yes updatewhereclause=yes key=yes name=id_articolo dbname="des_libera_gestione.id_articolo" )
 column=(type=char(32766) update=yes updatewhereclause=no name=des_lib_riferimento dbname="des_libera_gestione.des_lib_riferimento" )
 column=(type=date update=yes updatewhereclause=yes key=yes name=data_inserimento dbname="des_libera_gestione.data_inserimento" )
 column=(type=char(32766) update=yes updatewhereclause=no name=des_lib_nuova dbname="des_libera_gestione.des_lib_nuova" )
 column=(type=char(2) update=yes updatewhereclause=yes key=yes name=tipo dbname="des_libera_gestione.tipo" )
 column=(type=char(7) update=yes updatewhereclause=yes name=num_bollettina dbname="des_libera_gestione.num_bollettina" )
 column=(type=date update=yes updatewhereclause=yes name=data_spedizione dbname="des_libera_gestione.data_spedizione" )
 column=(type=char(32) update=yes updatewhereclause=yes name=accessorio dbname="des_libera_gestione.accessorio" )
 column=(type=char(255) updatewhereclause=yes name=cod_accessori_k_descrizione dbname="cod_accessori_k.descrizione" )
 column=(type=char(1) update=yes updatewhereclause=yes name=controllato dbname="des_libera_gestione.controllato" values="	S/	N" )
 column=(type=char(255) updatewhereclause=yes name=prezzo_des_2 dbname="prezzo.des_2" )
 column=(type=char(32766) update=yes updatewhereclause=no name=nota dbname="des_libera_gestione.nota" )
 column=(type=datetime update=yes updatewhereclause=yes name=dt_giallo dbname="des_libera_gestione.dt_giallo" )
 column=(type=char(64) updatewhereclause=yes name=articolo_codice dbname="articolo.codice" )
 column=(type=char(5) updatewhereclause=yes name=bollettine_excel_cliente dbname="bollettine_excel.cliente" )
 column=(type=char(29) updatewhereclause=yes name=c_nd_nc dbname="c_nd_nc" )
 retrieve="  SELECT ~"des_libera_gestione~".~"id_articolo~",   
         ~"des_libera_gestione~".~"des_lib_riferimento~",   
         ~"des_libera_gestione~".~"data_inserimento~",   
         ~"des_libera_gestione~".~"des_lib_nuova~",   
         ~"des_libera_gestione~".~"tipo~",   
         ~"des_libera_gestione~".~"num_bollettina~",   
         ~"des_libera_gestione~".~"data_spedizione~",   
         ~"des_libera_gestione~".~"accessorio~",   
         ~"cod_accessori_k~".~"descrizione~",   
         ~"des_libera_gestione~".~"controllato~",   
         ~"prezzo~".~"des_2~",   
         ~"des_libera_gestione~".~"nota~",   
         ~"des_libera_gestione~".~"dt_giallo~",   
         ~"articolo~".~"codice~",   
         ~"bollettine_excel~".~"cliente~",   
           (select first(dnc.num_documento+' - '+string(dnc.data_documento)) from documento dnc,riga_documento rnc, riga_documento rpronc, riga_documento rfat, riga_documento rddt 
where rddt.id_riga_doc_provenienza=~"bollettine_excel~".~"id_riga_documento~" and rddt.id_riga_documento=rfat.id_riga_doc_provenienza and rfat.id_riga_documento=rpronc.id_riga_doc_provenienza and 
rpronc.id_riga_documento=rnc.id_riga_doc_provenienza
and rnc.id_documento=dnc.id_documento) as c_nd_nc 
    
FROM {oj ~"des_libera_gestione~" LEFT OUTER JOIN ~"cod_accessori_k~" ON ~"des_libera_gestione~".~"accessorio~" = ~"cod_accessori_k~".~"cod_accessorio~"}, {oj ~"unita_confezione~" LEFT OUTER JOIN ~"prezzo~" ON ~"unita_confezione~".~"id_unita_confezione~" = ~"prezzo~".~"id_unita_confezione~" RIGHT OUTER JOIN ~"des_libera_gestione~" ON ~"unita_confezione~".~"id_articolo~" = ~"des_libera_gestione~".~"id_articolo~" LEFT OUTER JOIN ~"bollettine_excel~" ON ~"des_libera_gestione~".~"num_bollettina~" = ~"bollettine_excel~".~"cod_barre~"},   
         ~"articolo~"  
   WHERE ( ~"des_libera_gestione~".~"id_articolo~" = ~"articolo~".~"id_articolo~" ) and  
         ( ( ~"prezzo~".~"id_variazione~" = 15 ) )    
" update="des_libera_gestione" updatewhere=1 updatekeyinplace=yes  sort="id_articolo A " )
