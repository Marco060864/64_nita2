table(column=(type=char(7) updatewhereclause=yes name=cod_barre dbname="bollettine_excel.cod_barre" )
 column=(type=char(5) updatewhereclause=yes name=cliente dbname="bollettine_excel.cliente" )
 column=(type=decimal(0) updatewhereclause=yes name=pezzi dbname="bollettine_excel.pezzi" )
 column=(type=char(64) updatewhereclause=yes name=articolo_non_completo dbname="bollettine_excel.articolo" )
 column=(type=decimal(2) updatewhereclause=yes name=peso dbname="bollettine_excel.peso" )
 column=(type=char(255) updatewhereclause=yes name=descrizione dbname="bollettine_excel.descrizione" )
 column=(type=datetime updatewhereclause=yes name=data dbname="bollettine_excel.data" )
 column=(type=char(3) updatewhereclause=yes name=galvanica dbname="bollettine_excel.galvanica" )
 column=(type=long updatewhereclause=yes name=id_riga_documento dbname="bollettine_excel.id_riga_documento" )
 column=(type=long updatewhereclause=yes name=num_riga dbname="bollettine_excel.num_riga" )
 column=(type=char(2) updatewhereclause=yes name=metallo dbname="bollettine_excel.metallo" )
 column=(type=decimal(2) updatewhereclause=yes name=titolo dbname="bollettine_excel.titolo" )
 column=(type=char(1) updatewhereclause=yes name=controllato dbname="bollettine_excel.controllato" values="	S/	N" )
 column=(type=char(1) updatewhereclause=yes name=tipo dbname="bollettine_excel.tipo" values="Bollettina	B/Reso	R/Correzzione	C/" )
 column=(type=decimal(2) updatewhereclause=yes name=dim_l_inch dbname="bollettine_excel.dim_l_inch" )
 column=(type=decimal(2) updatewhereclause=yes name=dim_l_cm dbname="bollettine_excel.dim_l_cm" )
 column=(type=char(32) updatewhereclause=yes name=accessorio dbname="bollettine_excel.accessorio" )
 column=(type=char(64) updatewhereclause=yes name=articolo dbname="bollettine_excel.cod_art_assegnato" )
 column=(type=char(8) updatewhereclause=yes name=bollo dbname="bollettine_excel.bollo" )
 column=(type=date updatewhereclause=yes name=data_scadenza dbname="bollettine_excel.data_scadenza" )
 column=(type=char(255) updatewhereclause=yes name=des_libera dbname="bollettine_excel.des_libera" )
 column=(type=char(255) updatewhereclause=yes name=cod_accessori_k_descrizione dbname="cod_accessori_k.descrizione" )
 column=(type=char(255) updatewhereclause=yes name=c_bollo dbname="c_bollo" )
 column=(type=char(5) updatewhereclause=yes name=cliente_da_saldare dbname="cliente_da_saldare.cliente" )
 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"bollettine_excel~" )  TABLE(NAME=~"cod_accessori_k~" )  TABLE(NAME=~"cliente_da_saldare~" ) COLUMN(NAME=~"bollettine_excel.cod_barre~") COLUMN(NAME=~"bollettine_excel.cliente~") COLUMN(NAME=~"bollettine_excel.pezzi~") COLUMN(NAME=~"bollettine_excel.articolo~") COLUMN(NAME=~"bollettine_excel.peso~") COLUMN(NAME=~"bollettine_excel.descrizione~") COLUMN(NAME=~"bollettine_excel.data~") COLUMN(NAME=~"bollettine_excel.galvanica~") COLUMN(NAME=~"bollettine_excel.id_riga_documento~") COLUMN(NAME=~"bollettine_excel.num_riga~") COLUMN(NAME=~"bollettine_excel.metallo~") COLUMN(NAME=~"bollettine_excel.titolo~") COLUMN(NAME=~"bollettine_excel.controllato~") COLUMN(NAME=~"bollettine_excel.tipo~") COLUMN(NAME=~"bollettine_excel.dim_l_inch~") COLUMN(NAME=~"bollettine_excel.dim_l_cm~") COLUMN(NAME=~"bollettine_excel.accessorio~") COLUMN(NAME=~"bollettine_excel.cod_art_assegnato~") COLUMN(NAME=~"bollettine_excel.bollo~") COLUMN(NAME=~"bollettine_excel.data_scadenza~") COLUMN(NAME=~"bollettine_excel.des_libera~") COLUMN(NAME=~"cod_accessori_k.descrizione~") COMPUTE(NAME=~"(select first(descrizione) from dba.cod_bolli_k where art_bollo like '%'+bollo) as c_bollo~") COLUMN(NAME=~"cliente_da_saldare.cliente~")    JOIN (LEFT=~"bollettine_excel.accessorio~"    OP =~"=~"RIGHT=~"cod_accessori_k.cod_accessorio~"    OUTER1 =~"bollettine_excel.accessorio~" )    JOIN (LEFT=~"bollettine_excel.cliente~"    OP =~"=~"RIGHT=~"cliente_da_saldare.cliente~"    OUTER1 =~"bollettine_excel.cliente~" )WHERE(    EXP1 =~"~~~"bollettine_excel~~~".~~~"id_riga_documento~~~"~"   OP =~"=~"    EXP2 =~":id_riga~" ) ) ARG(NAME = ~"id_riga~" TYPE = number) " arguments=(("id_riga", number)) )
