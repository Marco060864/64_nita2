table(column=(type=long updatewhereclause=yes name=id_documento dbname="documento.id_documento" )
 column=(type=decimal(0) updatewhereclause=yes name=num_progressivo dbname="documento.num_progressivo" )
 column=(type=char(16) updatewhereclause=yes name=num_documento dbname="documento.num_documento" )
 column=(type=date updatewhereclause=yes name=data_documento dbname="documento.data_documento" )
 column=(type=decimal(0) updatewhereclause=yes name=num_riga dbname="riga_documento.num_riga" )
 column=(type=long updatewhereclause=yes key=yes identity=yes name=id_riga_documento dbname="riga_documento.id_riga_documento" )
 column=(type=long update=yes updatewhereclause=yes name=id_articolo dbname="riga_documento.id_articolo" )
 column=(type=char(32766) update=yes updatewhereclause=no name=descrizione dbname="riga_documento.descrizione" )
 column=(type=long update=yes updatewhereclause=yes name=id_unita_confezione dbname="riga_documento.id_unita_confezione" )
 column=(type=char(40) updatewhereclause=yes name=des_contabile dbname="documento.des_contabile" )
 column=(type=decimal(4) updatewhereclause=yes name=riga_documento_quantita dbname="riga_documento.quantita" )
 column=(type=char(4) updatewhereclause=yes name=cat_codifica_codice dbname="cat_codifica.codice" )
 column=(type=decimal(6) updatewhereclause=yes name=prezzo dbname="riga_documento.prezzo" )
 column=(type=char(255) updatewhereclause=yes name=c_des_2 dbname="c_des_2" )
 column=(type=char(1) updatewhereclause=yes name=nok7 dbname="cat_codifica.lun_fissa" values="	1/	0" )
 column=(type=long updatewhereclause=yes name=c_281 dbname="c_281" values="	1/	0" )
 column=(type=long update=yes updatewhereclause=yes name=id_riga_lotto dbname="riga_documento.id_riga_lotto" )
 column=(type=long updatewhereclause=yes name=id_gruppo_agenti_2 dbname="riga_documento.id_gruppo_agenti_2" )
 column=(type=char(8) updatewhereclause=yes name=bollettine_excel_galv_k dbname="bollettine_excel.galv_k" )
 column=(type=decimal(4) updatewhereclause=yes name=riga_documento_qta_ordinata_fo dbname="riga_documento.qta_ordinata_fo" )
 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"documento~" )  TABLE(NAME=~"riga_documento~" )  TABLE(NAME=~"articolo~" )  TABLE(NAME=~"cat_codifica~" )  TABLE(NAME=~"bollettine_excel~" ) COLUMN(NAME=~"documento.id_documento~") COLUMN(NAME=~"documento.num_progressivo~") COLUMN(NAME=~"documento.num_documento~") COLUMN(NAME=~"documento.data_documento~") COLUMN(NAME=~"riga_documento.num_riga~") COLUMN(NAME=~"riga_documento.id_riga_documento~") COLUMN(NAME=~"riga_documento.id_articolo~") COLUMN(NAME=~"riga_documento.descrizione~") COLUMN(NAME=~"riga_documento.id_unita_confezione~") COLUMN(NAME=~"documento.des_contabile~") COLUMN(NAME=~"riga_documento.quantita~") COLUMN(NAME=~"cat_codifica.codice~") COLUMN(NAME=~"riga_documento.prezzo~") COMPUTE(NAME=~"cast('' as varchar(255)) as c_des_2~") COLUMN(NAME=~"cat_codifica.lun_fissa~") COMPUTE(NAME=~"0 as c_281~") COLUMN(NAME=~"riga_documento.id_riga_lotto~") COLUMN(NAME=~"riga_documento.id_gruppo_agenti_2~") COLUMN(NAME=~"bollettine_excel.galv_k~") COLUMN(NAME=~"riga_documento.qta_ordinata_fo~")    JOIN (LEFT=~"riga_documento.id_riga_documento~"    OP =~"=~"RIGHT=~"bollettine_excel.id_riga_documento~"    OUTER1 =~"riga_documento.id_riga_documento~" )    JOIN (LEFT=~"riga_documento.id_documento~"    OP =~"=~"RIGHT=~"documento.id_documento~" )    JOIN (LEFT=~"riga_documento.id_articolo~"    OP =~"=~"RIGHT=~"articolo.id_articolo~" )    JOIN (LEFT=~"cat_codifica.id_cat_codifica~"    OP =~"=~"RIGHT=~"articolo.id_cat_codifica~" )WHERE(    EXP1 =~"~~~"documento~~~".~~~"id_documento~~~"~"   OP =~"=~"    EXP2 =~":id_doc~" ) ) ARG(NAME = ~"id_doc~" TYPE = number) " update="riga_documento" updatewhere=1 updatekeyinplace=yes filter=" isnull(des_contabile ) or des_contabile<>~"V~""arguments=(("id_doc", number)) )
