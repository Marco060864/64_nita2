table(column=(type=char(64) updatewhereclause=yes name=c_art_new dbname="c_art_new" )
 column=(type=long updatewhereclause=yes identity=yes name=id_articolo dbname="articolo.id_articolo" dbalias=".id_articolo" )
 column=(type=char(64) update=yes updatewhereclause=yes name=articolo_codice dbname="articolo.codice" dbalias=".codice" )
 column=(type=char(255) updatewhereclause=yes name=prezzo_des_3 dbname="prezzo.des_3" dbalias=".des_3" )
 retrieve="PBSELECT( VERSION(400) DISTINCT ()TABLE(NAME=~"unita_confezione~" )  TABLE(NAME=~"prezzo~" )  TABLE(NAME=~"articolo~" ) COMPUTE(NAME=~"'                                                                ' as c_art_new~") COLUMN(NAME=~"articolo.id_articolo~") COLUMN(NAME=~"articolo.codice~") COLUMN(NAME=~"prezzo.des_3~")    JOIN (LEFT=~"unita_confezione.id_unita_confezione~"    OP =~"=~"RIGHT=~"prezzo.id_unita_confezione~"    OUTER1 =~"unita_confezione.id_unita_confezione~" )    JOIN (LEFT=~"articolo.id_articolo~"    OP =~"=~"RIGHT=~"unita_confezione.id_articolo~"    OUTER1 =~"articolo.id_articolo~" )WHERE(    EXP1 =~"( ( ~~~"prezzo~~~".~~~"id_variazione~~~"~"   OP =~"=~"    EXP2 =~"15 )~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"articolo~~~".~~~"codice~~~"~"   OP =~"like~"    EXP2 =~"'%_@%')~" ) ) " filter=" len(prezzo_des_3)<=5 or isnull( prezzo_des_3 )")
