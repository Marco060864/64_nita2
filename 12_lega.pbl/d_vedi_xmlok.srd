 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"xml_testa~" )  TABLE(NAME=~"xml_spese~" )  TABLE(NAME=~"xml_riepilogo~" )  TABLE(NAME=~"xml_righe~" ) COLUMN(NAME=~"xml_testa.id_xml~") COLUMN(NAME=~"xml_testa.id_trasmittente~") COLUMN(NAME=~"xml_testa.id_cedente~") COLUMN(NAME=~"xml_testa.f_nome~") COLUMN(NAME=~"xml_testa.f_cognome~") COLUMN(NAME=~"xml_testa.f_rag_sociale~") COLUMN(NAME=~"xml_testa.f_indirizzo~") COLUMN(NAME=~"xml_testa.f_cap~") COLUMN(NAME=~"xml_testa.f_comune~") COLUMN(NAME=~"xml_testa.f_provincia~") COLUMN(NAME=~"xml_testa.f_nazione~") COLUMN(NAME=~"xml_testa.id_committente~") COLUMN(NAME=~"xml_testa.c_nome~") COLUMN(NAME=~"xml_testa.c_cognome~") COLUMN(NAME=~"xml_testa.c_rag_sociale~") COLUMN(NAME=~"xml_testa.c_indirizzo~") COLUMN(NAME=~"xml_testa.c_cap~") COLUMN(NAME=~"xml_testa.c_comune~") COLUMN(NAME=~"xml_testa.c_provincia~") COLUMN(NAME=~"xml_testa.c_nazione~") COLUMN(NAME=~"xml_testa.tipo_documento~") COLUMN(NAME=~"xml_testa.data_documento~") COLUMN(NAME=~"xml_testa.num_documento~") COLUMN(NAME=~"xml_testa.spese_bollo~") COLUMN(NAME=~"xml_testa.causale~") COLUMN(NAME=~"xml_testa.imp_con_iva~") COLUMN(NAME=~"xml_testa.rag_soc_vettore~") COLUMN(NAME=~"xml_testa.p_iva_vettore~") COLUMN(NAME=~"xml_testa.caus_trasporto~") COLUMN(NAME=~"xml_testa.num_colli~") COLUMN(NAME=~"xml_testa.tras_a_mezzo~") COLUMN(NAME=~"xml_testa.cod_destinatario~") COLUMN(NAME=~"xml_testa.pec_destinatario~") COLUMN(NAME=~"xml_testa.f_cod_fiscale~") COLUMN(NAME=~"xml_testa.c_cod_fiscale~") COLUMN(NAME=~"xml_testa.bollo~") COLUMN(NAME=~"xml_testa.data_scadenza_1~") COLUMN(NAME=~"xml_testa.data_scadenza_2~") COLUMN(NAME=~"xml_testa.data_scadenza_3~") COLUMN(NAME=~"xml_testa.imp_scadenza_1~") COLUMN(NAME=~"xml_testa.imp_scadenza_2~") COLUMN(NAME=~"xml_testa.imp_scadenza_3~") COLUMN(NAME=~"xml_testa.f_p_iva~") COLUMN(NAME=~"xml_testa.tipo_ces_prestazione~") COLUMN(NAME=~"xml_righe.id_riga~") COLUMN(NAME=~"xml_righe.des_riga~") COLUMN(NAME=~"xml_righe.qta~") COLUMN(NAME=~"xml_righe.prezzo_unitario~") COLUMN(NAME=~"xml_righe.prezzo_totale~") COLUMN(NAME=~"xml_righe.al_iva~") COLUMN(NAME=~"xml_righe.natura~") COLUMN(NAME=~"xml_righe.rif_ddt~") COLUMN(NAME=~"xml_righe.num_riga_ddt~") COLUMN(NAME=~"xml_spese.tipo_spesa~") COLUMN(NAME=~"xml_spese.val_spesa~") COLUMN(NAME=~"xml_riepilogo.al_iva~") COLUMN(NAME=~"xml_riepilogo.imponibile~") COLUMN(NAME=~"xml_riepilogo.imposta~") COLUMN(NAME=~"xml_riepilogo.rif_normativo~") COLUMN(NAME=~"xml_testa.caus_descrizione~") COLUMN(NAME=~"xml_righe.data_ddt~") COLUMN(NAME=~"xml_righe.num_riga~") COLUMN(NAME=~"xml_righe.um~")    JOIN (LEFT=~"xml_testa.id_xml~"    OP =~"=~"RIGHT=~"xml_spese.id_xml~"    OUTER1 =~"xml_testa.id_xml~" )    JOIN (LEFT=~"xml_testa.id_xml~"    OP =~"=~"RIGHT=~"xml_riepilogo.id_xml~" )    JOIN (LEFT=~"xml_testa.id_xml~"    OP =~"=~"RIGHT=~"xml_righe.id_xml~" )WHERE(    EXP1 =~"( ( ~~~"xml_testa~~~".~~~"id_xml~~~"~"   OP =~"=~"    EXP2 =~":id_xml ) )~" ) ) ARG(NAME = ~"id_xml~" TYPE = number) " update="xml_testa" updatewhere=1 updatekeyinplace=yes arguments=(("id_xml", number)) )
