 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"bollettine_excel~" )  TABLE(NAME=~"articolo~" ALIAS=~"articolo_a~" )  TABLE(NAME=~"riga_documento~" )  TABLE(NAME=~"articolo~" ALIAS=~"articolo_b~" ) COLUMN(NAME=~"bollettine_excel.cod_barre~") COLUMN(NAME=~"bollettine_excel.cliente~") COLUMN(NAME=~"articolo_a.id_articolo~") COLUMN(NAME=~"bollettine_excel.accessorio~") COLUMN(NAME=~"bollettine_excel.des_libera~") COLUMN(NAME=~"bollettine_excel.data~") COLUMN(NAME=~"bollettine_excel.pezzi~") COLUMN(NAME=~"bollettine_excel.cod_art_assegnato~") COLUMN(NAME=~"bollettine_excel.peso~") COLUMN(NAME=~"bollettine_excel.num_riga~") COLUMN(NAME=~"bollettine_excel.num_ordine~") COLUMN(NAME=~"bollettine_excel.note_taglio~") COLUMN(NAME=~"articolo_b.id_articolo~") COMPUTE(NAME=~"(if ~~~"riga_documento~~~".~~~"id_articolo~~~">0 then ~~~"riga_documento~~~".~~~"id_articolo~~~" else ~~~"articolo_b~~~".~~~"codice~~~" end if) as c_id_art~") COMPUTE(NAME=~"(if ~~~"riga_documento~~~".~~~"id_articolo~~~">0 then ~~~"articolo_a~~~".~~~"codice~~~" else  ~~~"articolo_b~~~".~~~"codice~~~" end if) as c_cod_articolo~")    JOIN (LEFT=~"bollettine_excel.id_riga_documento~"    OP =~"=~"RIGHT=~"riga_documento.id_riga_documento~"    OUTER1 =~"bollettine_excel.id_riga_documento~" )    JOIN (LEFT=~"riga_documento.id_articolo~"    OP =~"=~"RIGHT=~"articolo_a.id_articolo~"    OUTER1 =~"riga_documento.id_articolo~" )    JOIN (LEFT=~"bollettine_excel.cod_art_assegnato~"    OP =~"=~"RIGHT=~"articolo_b.codice~"    OUTER1 =~"bollettine_excel.cod_art_assegnato~" )WHERE(    EXP1 =~"~~~"bollettine_excel~~~".~~~"cliente~~~"~"   OP =~"=~"    EXP2 =~":cliente~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"bollettine_excel~~~".~~~"data~~~"~"   OP =~">=~"    EXP2 =~":ADT_DATA_INIZIO~" ) ) ARG(NAME = ~"cliente~" TYPE = string)  ARG(NAME = ~"ADT_DATA_INIZIO~" TYPE = datetime) " arguments=(("cliente", string),("ADT_DATA_INIZIO", datetime))  sort="c_cod_articolo D data D num_riga A " )
