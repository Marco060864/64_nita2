 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"riga_documento~" )  TABLE(NAME=~"documento~" )  TABLE(NAME=~"prezzo~" )  TABLE(NAME=~"unita_confezione~" ) COLUMN(NAME=~"riga_documento.id_riga_documento~") COLUMN(NAME=~"riga_documento.num_riga~") COLUMN(NAME=~"riga_documento.descrizione~") COLUMN(NAME=~"documento.num_progressivo~") COLUMN(NAME=~"documento.num_documento~") COLUMN(NAME=~"documento.data_documento~") COLUMN(NAME=~"riga_documento.quantita~") COLUMN(NAME=~"riga_documento.peso_netto~") COLUMN(NAME=~"riga_documento.prezzo~") COLUMN(NAME=~"riga_documento.prezzo_manifattura~") COLUMN(NAME=~"riga_documento.prezzo_complessivo~") COLUMN(NAME=~"riga_documento.id_articolo~") COLUMN(NAME=~"prezzo.prezzo~") COLUMN(NAME=~"prezzo.confermato~") COLUMN(NAME=~"prezzo.id_unita_confezione~") COLUMN(NAME=~"prezzo.id_variazione~") COLUMN(NAME=~"riga_documento.id_unita_confezione~") COLUMN(NAME=~"prezzo.ultima_modifica~")    JOIN (LEFT=~"unita_confezione.id_unita_confezione~"    OP =~"=~"RIGHT=~"prezzo.id_unita_confezione~"    OUTER1 =~"unita_confezione.id_unita_confezione~" )    JOIN (LEFT=~"riga_documento.id_unita_confezione~"    OP =~"=~"RIGHT=~"unita_confezione.id_unita_confezione~"    OUTER1 =~"riga_documento.id_unita_confezione~" )    JOIN (LEFT=~"documento.id_documento~"    OP =~"=~"RIGHT=~"riga_documento.id_documento~" )WHERE(    EXP1 =~"~~~"riga_documento~~~".~~~"id_articolo~~~"~"   OP =~"=~"    EXP2 =~":il_art~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"prezzo~~~".~~~"id_variazione~~~"~"   OP =~"=~"    EXP2 =~":id_var~" ) ) ARG(NAME = ~"il_art~" TYPE = number)  ARG(NAME = ~"id_var~" TYPE = number) " arguments=(("il_art", number),("id_var", number))  sort="documento_data_documento D " )
