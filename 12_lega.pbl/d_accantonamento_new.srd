table(column=(type=decimal(0) updatewhereclause=yes name=documento_num_progressivo dbname="documento.num_progressivo" )
 column=(type=char(16) updatewhereclause=yes name=documento_num_documento dbname="documento.num_documento" )
 column=(type=date updatewhereclause=yes name=documento_data_documento dbname="documento.data_documento" )
 column=(type=char(8) updatewhereclause=yes name=sog_commerciale_gen_codice dbname="sog_commerciale_gen.codice" )
 column=(type=char(40) updatewhereclause=yes name=sog_commerciale_gen_rag_soc_1 dbname="sog_commerciale_gen.rag_soc_1" )
 column=(type=date updatewhereclause=yes name=data_lista dbname="fabbisogno_accessori_k.data_lista" )
 column=(type=long updatewhereclause=yes name=c_scegli dbname="c_scegli" values="	1/	0" )
 column=(type=long updatewhereclause=yes name=id_documento dbname="documento.id_documento" )
 column=(type=long updatewhereclause=yes name=id_sog_commerciale dbname="documento.id_sog_commerciale" )
 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"fabbisogno_accessori_k~" )  TABLE(NAME=~"documento~" )  TABLE(NAME=~"sog_commerciale_gen~" )  TABLE(NAME=~"produzione_2011~" )  TABLE(NAME=~"riga_documento~" ) COLUMN(NAME=~"documento.num_progressivo~") COLUMN(NAME=~"documento.num_documento~") COLUMN(NAME=~"documento.data_documento~") COLUMN(NAME=~"sog_commerciale_gen.codice~") COLUMN(NAME=~"sog_commerciale_gen.rag_soc_1~") COLUMN(NAME=~"fabbisogno_accessori_k.data_lista~") COMPUTE(NAME=~"0 as c_scegli~") COLUMN(NAME=~"documento.id_documento~") COLUMN(NAME=~"documento.id_sog_commerciale~")    JOIN (LEFT=~"fabbisogno_accessori_k.id_doc_sald~"    OP =~"=~"RIGHT=~"produzione_2011.id_bollettina~"    OUTER2 =~"produzione_2011.id_bollettina~" )    JOIN (LEFT=~"documento.id_sog_commerciale~"    OP =~"=~"RIGHT=~"sog_commerciale_gen.id_sog_commerciale~" )    JOIN (LEFT=~"riga_documento.id_riga_documento~"    OP =~"=~"RIGHT=~"produzione_2011.id_doc_produzione~" )    JOIN (LEFT=~"riga_documento.id_documento~"    OP =~"=~"RIGHT=~"documento.id_documento~" ) GROUP(NAME=~"fabbisogno_accessori_k.data_lista~") GROUP(NAME=~"documento.num_progressivo~") GROUP(NAME=~"documento.num_documento~") GROUP(NAME=~"documento.data_documento~") GROUP(NAME=~"sog_commerciale_gen.codice~") GROUP(NAME=~"sog_commerciale_gen.rag_soc_1~") GROUP(NAME=~"documento.id_documento~") GROUP(NAME=~"documento.id_sog_commerciale~")) "  sort="documento_data_documento D documento_num_documento D data_lista D " )
