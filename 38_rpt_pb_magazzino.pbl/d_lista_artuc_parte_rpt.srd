 column=(type=char(80) updatewhereclause=yes name=articolo_descrizione dbname="scelta_parte.descrizione" )
 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"articolo~" )  TABLE(NAME=~"cat_com_articolo~" )  TABLE(NAME=~"cat_fiscale~" )  TABLE(NAME=~"cat_merceologica~" )  TABLE(NAME=~"unita_confezione~" )  TABLE(NAME=~"unita_misura~" )  TABLE(NAME=~"tab_iva~" ) COLUMN(NAME=~"articolo.codice~") COLUMN(NAME=~"articolo.des_breve~") COLUMN(NAME=~"cat_com_articolo.codice~") COLUMN(NAME=~"cat_merceologica.codice~") COLUMN(NAME=~"cat_fiscale.codice~") COLUMN(NAME=~"unita_confezione.codice~") COLUMN(NAME=~"unita_misura.simbolo~") COLUMN(NAME=~"tab_iva.des_breve~") COMPUTE(NAME=~"CAST(SUBSTR(~~~"articolo~~~".~~~"codice~~~", :car_inizio, :lun_parte) AS CHAR(32)) AS parte_raggruppamento~") COMPUTE(NAME=~"CAST( (SELECT s.descrizione FROM scelta_parte s, cod_parte c WHERE c.id_cat_codifica = ~~~"articolo~~~".~~~"id_cat_codifica~~~" AND c.id_parte_regola = :id_parte_regola AND s.id_cod_parte = c.id_cod_parte AND s.scelta = parte_raggruppamento) AS CHAR(40)) AS des_parte_raggruppamento~") COLUMN(NAME=~"unita_confezione.unita_base~") COMPUTE(NAME=~"CAST(:ordinamento AS CHAR(1)) AS ordinamento~") COLUMN(NAME=~"articolo.descrizione~")    JOIN (LEFT=~"cat_fiscale.id_cat_fiscale~"    OP =~"=~"RIGHT=~"articolo.id_cat_fiscale~"    OUTER2 =~"articolo.id_cat_fiscale~" )    JOIN (LEFT=~"cat_merceologica.id_cat_merceologica~"    OP =~"=~"RIGHT=~"articolo.id_cat_merceologica~"    OUTER2 =~"articolo.id_cat_merceologica~" )    JOIN (LEFT=~"unita_misura.id_unita_misura~"    OP =~"=~"RIGHT=~"unita_confezione.id_unita_misura~"    OUTER2 =~"unita_confezione.id_unita_misura~" )    JOIN (LEFT=~"tab_iva.id_tab_iva~"    OP =~"=~"RIGHT=~"articolo.id_tab_iva~"    OUTER2 =~"articolo.id_tab_iva~" )    JOIN (LEFT=~"cat_com_articolo.id_cat_com_articolo~"    OP =~"=~"RIGHT=~"articolo.id_cat_com_articolo~" )    JOIN (LEFT=~"unita_confezione.id_articolo~"    OP =~"=~"RIGHT=~"articolo.id_articolo~" )WHERE(    EXP1 =~"~~~"articolo~~~".~~~"id_cat_codifica~~~"~"   OP =~"=~"    EXP2 =~":id_cat_codifica~" ) ) ARG(NAME = ~"id_cat_codifica~" TYPE = number)  ARG(NAME = ~"titolo~" TYPE = string)  ARG(NAME = ~"parametri~" TYPE = string)  ARG(NAME = ~"ordinamento~" TYPE = string)  ARG(NAME = ~"car_inizio~" TYPE = number)  ARG(NAME = ~"lun_parte~" TYPE = number)  ARG(NAME = ~"des_parte~" TYPE = string)  ARG(NAME = ~"id_parte_regola~" TYPE = number) " arguments=(("id_cat_codifica", number),("titolo", string),("parametri", string),("ordinamento", string),("car_inizio", number),("lun_parte", number),("des_parte", string),("id_parte_regola", number)) )
