 column=(type=char(100) updatewhereclause=yes name=ret_esi_attuale dbname="ret_esi_attuale" )
 column=(type=long updatewhereclause=yes name=n_decimali dbname="unita_misura.n_decimali" )
 column=(type=char(1) updatewhereclause=yes name=articolo_utilizzabile dbname="articolo.utilizzabile" )
 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"articolo~" )  TABLE(NAME=~"riepilogo~" )  TABLE(NAME=~"locazione~" )  TABLE(NAME=~"magazzino~" )  TABLE(NAME=~"unita_confezione~" )  TABLE(NAME=~"unita_misura~" ) COLUMN(NAME=~"articolo.codice~") COLUMN(NAME=~"articolo.des_breve~") COLUMN(NAME=~"magazzino.codice~") COLUMN(NAME=~"magazzino.descrizione~") COLUMN(NAME=~"articolo.id_articolo~") COLUMN(NAME=~"locazione.id_locazione~") COLUMN(NAME=~"magazzino.id_magazzino~") COMPUTE(NAME=~"CAST( SUBSTRING(ret_esi_attuale, 1, 20) AS NUMERIC(18,4) ) AS esi_fisica_attuale~") COMPUTE(NAME=~"CAST( SUBSTRING(ret_esi_attuale, 21, 20) AS NUMERIC(18,4) ) AS esi_fiscale_attuale~") COMPUTE(NAME=~"CAST( SUBSTRING(ret_esi_iniziale, 1, 20) AS NUMERIC(18,4) ) AS esi_fisica_iniziale~") COMPUTE(NAME=~"CAST( SUBSTRING(ret_esi_iniziale, 21, 20) AS NUMERIC(18,4) ) AS esi_fiscale_iniziale~") COMPUTE(NAME=~"CAST( SUBSTRING(ret_esi_attuale, 61, 20) AS NUMERIC(18,4) ) AS qta_caricata~") COMPUTE(NAME=~"CAST( SUBSTRING(ret_esi_attuale, 81, 20) AS NUMERIC(18,4) ) AS qta_scaricata~") COLUMN(NAME=~"articolo.id_sog_commerciale~") COMPUTE(NAME=~"CAST(fn_esi_disp2(1, ~~~"articolo~~~".~~~"id_articolo~~~", ~~~"magazzino~~~".~~~"id_magazzino~~~", YEAR(:da_data), MONTH(:da_data),0) AS CHAR(100)) AS ret_esi_iniziale~") COMPUTE(NAME=~"CAST(fn_esi_disp2(1, ~~~"articolo~~~".~~~"id_articolo~~~", ~~~"magazzino~~~".~~~"id_magazzino~~~", :anno, :mese,0) AS CHAR(100)) AS ret_esi_attuale~") COLUMN(NAME=~"unita_misura.n_decimali~") COLUMN(NAME=~"articolo.utilizzabile~")    JOIN (LEFT=~"unita_misura.id_unita_misura~"    OP =~"=~"RIGHT=~"unita_confezione.id_unita_misura~"    OUTER2 =~"unita_confezione.id_unita_misura~" )    JOIN (LEFT=~"riepilogo.id_articolo~"    OP =~"=~"RIGHT=~"articolo.id_articolo~" )    JOIN (LEFT=~"locazione.id_locazione~"    OP =~"=~"RIGHT=~"riepilogo.id_locazione~" )    JOIN (LEFT=~"magazzino.id_magazzino~"    OP =~"=~"RIGHT=~"locazione.id_magazzino~" )    JOIN (LEFT=~"unita_confezione.id_articolo~"    OP =~"=~"RIGHT=~"articolo.id_articolo~" )WHERE(    EXP1 =~"( ( ~~~"articolo~~~".~~~"codice~~~"~"   OP =~">=~"    EXP2 =~":da_articolo )~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"( ~~~"articolo~~~".~~~"codice~~~"~"   OP =~"<=~"    EXP2 =~":a_articolo )~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"( ~~~"magazzino~~~".~~~"codice~~~"~"   OP =~">=~"    EXP2 =~":da_magazzino )~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"( ~~~"magazzino~~~".~~~"codice~~~"~"   OP =~"<=~"    EXP2 =~":a_magazzino ) )~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"unita_confezione~~~".~~~"unita_base~~~"~"   OP =~"=~"    EXP2 =~"'S'~" ) ) ORDER(NAME=~"articolo.codice~" ASC=yes ) ARG(NAME = ~"da_articolo~" TYPE = string)  ARG(NAME = ~"a_articolo~" TYPE = string)  ARG(NAME = ~"da_data~" TYPE = datetime)  ARG(NAME = ~"anno~" TYPE = number)  ARG(NAME = ~"mese~" TYPE = number)  ARG(NAME = ~"parametri~" TYPE = string)  ARG(NAME = ~"da_magazzino~" TYPE = string)  ARG(NAME = ~"a_magazzino~" TYPE = string) " arguments=(("da_articolo", string),("a_articolo", string),("da_data", datetime),("anno", number),("mese", number),("parametri", string),("da_magazzino", string),("a_magazzino", string)) )
