table(column=(type=long updatewhereclause=yes name=riepilogo_id_esercizio dbname="riepilogo.id_esercizio" )
 column=(type=long updatewhereclause=yes name=riepilogo_id_attivita dbname="riepilogo.id_attivita" )
 column=(type=long updatewhereclause=yes name=id_articolo dbname="riepilogo.id_articolo" )
 column=(type=long updatewhereclause=yes name=riepilogo_id_locazione dbname="riepilogo.id_locazione" )
 column=(type=decimal(0) updatewhereclause=yes name=c_esistenza dbname="c_esistenza" )
 column=(type=decimal(0) updatewhereclause=yes name=c_esistenza_fisica dbname="c_esistenza_fisica" )
 column=(type=decimal(0) updatewhereclause=yes name=c_disponibilita dbname="c_disponibilita" )
 column=(type=char(32) updatewhereclause=yes name=articolo_codice dbname="articolo.codice" )
 column=(type=char(80) updatewhereclause=yes name=articolo_descrizione dbname="articolo.descrizione" )
 column=(type=long updatewhereclause=yes identity=yes name=unita_confezione_id_unita_confezione dbname="unita_confezione.id_unita_confezione" )
 column=(type=decimal(4) updatewhereclause=yes name=scorta_scorta_minima dbname="scorta.scorta_minima" )
 column=(type=long updatewhereclause=yes name=scorta_id_per_scorta dbname="scorta.id_per_scorta" )
 column=(type=decimal(0) updatewhereclause=yes name=per_scorta_giorno_inizio dbname="per_scorta.giorno_inizio" )
 column=(type=decimal(0) updatewhereclause=yes name=per_scorta_mese_inizio dbname="per_scorta.mese_inizio" )
 column=(type=decimal(0) updatewhereclause=yes name=per_scorta_giorno_fine dbname="per_scorta.giorno_fine" )
 column=(type=decimal(0) updatewhereclause=yes name=per_scorta_mese_fine dbname="per_scorta.mese_fine" )
 column=(type=decimal(4) updatewhereclause=yes name=scorta_scorta_massima dbname="scorta.scorta_massima" )
 column=(type=decimal(4) updatewhereclause=yes name=riepilogo_qta_ord_clienti dbname="riepilogo.qta_ord_clienti" )
 column=(type=decimal(4) updatewhereclause=yes name=riepilogo_qta_ord_fornitori dbname="riepilogo.qta_ord_fornitori" )
 column=(type=long updatewhereclause=yes name=articolo_id_sog_commerciale dbname="articolo.id_sog_commerciale" )
 retrieve="SELECT ~"riepilogo~".~"id_esercizio~",   
         ~"riepilogo~".~"id_attivita~",   
         ~"riepilogo~".~"id_articolo~",   
         ~"riepilogo~".~"id_locazione~",   
         Cast(0 as decimal) As c_esistenza,   
         Cast(0 as decimal) As c_esistenza_fisica,   
         Cast(0 as decimal) As c_disponibilita,   
         ~"articolo~".~"codice~",   
         ~"articolo~".~"descrizione~",   
         ~"unita_confezione~".~"id_unita_confezione~",   
         ~"scorta~".~"scorta_minima~",   
         ~"scorta~".~"id_per_scorta~",   
         ~"per_scorta~".~"giorno_inizio~",   
         ~"per_scorta~".~"mese_inizio~",   
         ~"per_scorta~".~"giorno_fine~",   
         ~"per_scorta~".~"mese_fine~",   
         ~"scorta~".~"scorta_massima~",   
         ~"riepilogo~".~"qta_ord_clienti~",   
         ~"riepilogo~".~"qta_ord_fornitori~",   
         ~"articolo~".~"id_sog_commerciale~"  
    FROM {oj ~"scorta~"  LEFT OUTER JOIN ~"per_scorta~"  ON ~"scorta~".~"id_per_scorta~" = ~"per_scorta~".~"id_per_scorta~"},   
         ~"riepilogo~",   
         ~"articolo~",   
         ~"unita_confezione~"  
   WHERE ( ~"unita_confezione~".~"id_unita_confezione~" = ~"scorta~".~"id_unita_confezione~" ) and  
         ( ~"articolo~".~"id_articolo~" = ~"riepilogo~".~"id_articolo~" ) and  
         ( ~"unita_confezione~".~"id_articolo~" = ~"articolo~".~"id_articolo~" ) and  
         (~"articolo~".~"codice~" <= :a_articolo AND  
         ~"articolo~".~"codice~" >= :da_articolo) AND  
         ~"riepilogo~".~"id_esercizio~" = :esercizio AND  
         ~"riepilogo~".~"id_attivita~" = :attivita AND  
         ~"riepilogo~".~"anno~" = :anno AND  
         ~"riepilogo~".~"mese~" = :mese AND  
         ~"unita_confezione~".~"unita_base~" = 'S' AND  
         ((((~"per_scorta~".~"giorno_inizio~" <= :giorno AND  
         ~"per_scorta~".~"mese_inizio~" <= :mese) AND  
         (~"per_scorta~".~"giorno_fine~" >= :giorno AND  
         ~"per_scorta~".~"mese_fine~" >= :mese)) AND  
         ~"scorta~".~"id_per_scorta~" is not null) OR  
         (~"scorta~".~"id_per_scorta~" is null))   
ORDER BY ~"articolo~".~"codice~" ASC   
" arguments=(("a_articolo", string),("da_articolo", string),("anno", number),("esercizio", number),("attivita", number),("mese", number),("giorno", number)) )
group(level=1 header.height=0 trailer.height=128 by=("id_articolo" ) header.color="536870912" trailer.color="536870912" )
