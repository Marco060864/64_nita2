 column=(type=char(255) updatewhereclause=yes name=cparametri dbname="parametri" )
 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"scadenza~" )  TABLE(NAME=~"documento~" )  TABLE(NAME=~"sog_commerciale_gen~" )  TABLE(NAME=~"par_sistema~" )  TABLE(NAME=~"valuta~" )  TABLE(NAME=~"prof_documento~" ) COLUMN(NAME=~"scadenza.data_scadenza~") COLUMN(NAME=~"documento.data_registrazione~") COLUMN(NAME=~"documento.num_progressivo~") COLUMN(NAME=~"sog_commerciale_gen.codice~") COLUMN(NAME=~"sog_commerciale_gen.rag_soc_1~") COLUMN(NAME=~"scadenza.importo~") COLUMN(NAME=~"valuta.parita_euro~") COLUMN(NAME=~"prof_documento.codice~") COMPUTE(NAME=~"cast(:parametri as char (255)) as parametri~")    JOIN (LEFT=~"documento.id_documento~"    OP =~"=~"RIGHT=~"scadenza.id_documento~" )    JOIN (LEFT=~"sog_commerciale_gen.id_sog_commerciale~"    OP =~"=~"RIGHT=~"documento.id_sog_commerciale~" )    JOIN (LEFT=~"valuta.id_valuta~"    OP =~"=~"RIGHT=~"par_sistema.id_val_lire~" )    JOIN (LEFT=~"prof_documento.id_prof_documento~"    OP =~"=~"RIGHT=~"documento.id_prof_documento~" )) ARG(NAME = ~"parametri~" TYPE = string) " arguments=(("parametri", string))  sort="scadenza_data_scadenza A documento_data_registrazione A documento_num_progressivo A sog_commerciale_gen_codice A " )
