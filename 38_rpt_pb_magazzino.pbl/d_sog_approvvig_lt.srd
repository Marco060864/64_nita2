 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"sog_commerciale_gen~" )  TABLE(NAME=~"sog_commerciale~" )  TABLE(NAME=~"approvvigionamento~" ) COLUMN(NAME=~"sog_commerciale_gen.id_sog_commerciale~") COLUMN(NAME=~"sog_commerciale_gen.codice~") COLUMN(NAME=~"sog_commerciale_gen.rag_soc_1~") COLUMN(NAME=~"sog_commerciale_gen.rag_soc_2~") COLUMN(NAME=~"sog_commerciale_gen.indirizzo~") COLUMN(NAME=~"sog_commerciale_gen.cap~") COLUMN(NAME=~"sog_commerciale_gen.localita~") COLUMN(NAME=~"sog_commerciale_gen.provincia~") COLUMN(NAME=~"sog_commerciale_gen.nazione~") COLUMN(NAME=~"sog_commerciale_gen.cod_fiscale~") COLUMN(NAME=~"sog_commerciale_gen.par_iva~") COLUMN(NAME=~"sog_commerciale_gen.tipo~") COLUMN(NAME=~"sog_commerciale_gen.id_anagrafica~") COLUMN(NAME=~"approvvigionamento.quantita~") COLUMN(NAME=~"approvvigionamento.giorni_consegna~") COLUMN(NAME=~"approvvigionamento.note~") COLUMN(NAME=~"approvvigionamento.id_unita_confezione~") COMPUTE(NAME=~"cast( ( select 1 from approvvigionamento where id_sog_commerciale=~~~"sog_commerciale~~~".~~~"id_sog_commerciale~~~" and id_unita_confezione=666 ) as integer ) as ordina~")    JOIN (LEFT=~"approvvigionamento.id_sog_commerciale~"    OP =~"=~"RIGHT=~"sog_commerciale.id_sog_commerciale~"    OUTER2 =~"sog_commerciale.id_sog_commerciale~" )   JOIN (LEFT=~"sog_commerciale_gen.id_sog_commerciale~"    OP =~"=~"RIGHT=~"sog_commerciale.id_sog_commerciale~" ) ) ORDER(NAME=~"sog_commerciale_gen.rag_soc_1~" ASC=yes ) " retrieve.asneeded=yes )
