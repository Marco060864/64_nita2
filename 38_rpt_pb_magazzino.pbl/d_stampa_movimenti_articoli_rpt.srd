 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"articolo~" )  TABLE(NAME=~"caus_magazzino~" )  TABLE(NAME=~"documento~" )  TABLE(NAME=~"magazzino~" )  TABLE(NAME=~"sog_commerciale~" )  TABLE(NAME=~"v_riga_doc_magazzino~" )  TABLE(NAME=~"azienda~" )  TABLE(NAME=~"cat_fiscale~" ) COLUMN(NAME=~"articolo.codice~") COLUMN(NAME=~"v_riga_doc_magazzino.data_registrazione~") COLUMN(NAME=~"v_riga_doc_magazzino.num_progressivo~") COLUMN(NAME=~"documento.num_documento~") COLUMN(NAME=~"documento.data_documento~") COLUMN(NAME=~"sog_commerciale.codice~") COLUMN(NAME=~"magazzino.codice~") COLUMN(NAME=~"caus_magazzino.codice~") COLUMN(NAME=~"v_riga_doc_magazzino.qta_un_base~") COLUMN(NAME=~"v_riga_doc_magazzino.quantita~") COLUMN(NAME=~"v_riga_doc_magazzino.prezzo_netto~") COLUMN(NAME=~"v_riga_doc_magazzino.tot_riga_val_az~") COLUMN(NAME=~"articolo.des_breve~") COLUMN(NAME=~"azienda.id_attivita~") COLUMN(NAME=~"articolo.id_articolo~") COLUMN(NAME=~"magazzino.id_magazzino~") COLUMN(NAME=~"documento.id_prof_documento~") COLUMN(NAME=~"caus_magazzino.mp_car_fiscali~") COLUMN(NAME=~"caus_magazzino.md_car_fiscali~") COLUMN(NAME=~"caus_magazzino.mp_scar_fiscali~") COLUMN(NAME=~"caus_magazzino.md_scar_fiscali~") COMPUTE(NAME=~"Cast(:ra_data_inizio as date) as data_ini~") COMPUTE(NAME=~"Cast(ifnull (~~~"caus_magazzino~~~".~~~"mp_car_fiscali~~~",ifnull(~~~"caus_magazzino~~~".~~~"md_car_fiscali~~~",'N','S'),'S') as char(1) ) as carico~") COMPUTE(NAME=~"Cast(ifnull (~~~"caus_magazzino~~~".~~~"mp_scar_fiscali~~~",ifnull(~~~"caus_magazzino~~~".~~~"md_scar_fiscali~~~",'N','S'),'S') as char(1) ) as scarico~") COLUMN(NAME=~"cat_fiscale.codice~") COMPUTE(NAME=~"Cast(''as decimal(18,4)) as esi_fisica~") COMPUTE(NAME=~"Cast(''as decimal(18,4)) as esi_fiscale~") COLUMN(NAME=~"documento.cambio~") COMPUTE(NAME=~"Cast(:ra_data_fine as date) as data_fine~") COLUMN(NAME=~"caus_magazzino.id_caus_magazzino~")    JOIN (LEFT=~"articolo.id_articolo~"    OP =~"=~"RIGHT=~"v_riga_doc_magazzino.id_articolo~" )    JOIN (LEFT=~"documento.id_documento~"    OP =~"=~"RIGHT=~"v_riga_doc_magazzino.id_documento~" )    JOIN (LEFT=~"sog_commerciale.id_sog_commerciale~"    OP =~"=~"RIGHT=~"v_riga_doc_magazzino.id_sog_commerciale~" )    JOIN (LEFT=~"magazzino.id_magazzino~"    OP =~"=~"RIGHT=~"v_riga_doc_magazzino.id_magazzino~" )    JOIN (LEFT=~"caus_magazzino.id_caus_magazzino~"    OP =~"=~"RIGHT=~"v_riga_doc_magazzino.id_caus_magazzino~" )    JOIN (LEFT=~"cat_fiscale.id_cat_fiscale~"    OP =~"=~"RIGHT=~"articolo.id_cat_fiscale~" )    JOIN (LEFT=~"azienda.id_azienda~"    OP =~"=~"RIGHT=~"articolo.id_azienda~" )WHERE(    EXP1 =~"~~~"azienda~~~".~~~"id_azienda~~~"~"   OP =~"=~"    EXP2 =~"1~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"v_riga_doc_magazzino~~~".~~~"data_registrazione~~~"~"   OP =~">=~"    EXP2 =~":ra_data_inizio~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"v_riga_doc_magazzino~~~".~~~"data_registrazione~~~"~"   OP =~"<=~"    EXP2 =~":ra_data_fine~" ) ) ARG(NAME = ~"ra_data_inizio~" TYPE = date)  ARG(NAME = ~"ra_data_fine~" TYPE = date)  ARG(NAME = ~"ra_flag~" TYPE = string) " arguments=(("ra_data_inizio", date),("ra_data_fine", date),("ra_flag", string))  sort="articolo_codice A " )
