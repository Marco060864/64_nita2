table(column=(type=char(32) updatewhereclause=yes name=codice dbname="prezzo.codice" )
 column=(type=char(40) updatewhereclause=yes name=des_breve dbname="prezzo.des_breve" )
 column=(type=char(5) updatewhereclause=yes name=simbolo dbname="prezzo.simbolo" )
 column=(type=char(20) updatewhereclause=yes name=des_breve dbname="prezzo.des_breve" )
