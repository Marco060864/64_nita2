 column=(type=char(32) updatewhereclause=yes name=parte_raggruppamento dbname="parte_raggruppamento" )
 column=(type=char(40) updatewhereclause=yes name=des_parte_raggruppamento dbname="des_parte_raggruppamento" )
 column=(type=decimal(4) updatewhereclause=yes name=cprezzo dbname="scelta_parte.prezzo" )
 column=(type=char(40) updatewhereclause=yes name=valuta_descrizione dbname="scelta_parte.descrizione" )
 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"unita_confezione~" )  TABLE(NAME=~"unita_misura~" )  TABLE(NAME=~"articolo~" )  TABLE(NAME=~"tab_iva~" )  TABLE(NAME=~"cat_com_articolo~" )  TABLE(NAME=~"cat_merceologica~" )  TABLE(NAME=~"cat_fiscale~" )  TABLE(NAME=~"prezzo~" )  TABLE(NAME=~"valuta~" )  TABLE(NAME=~"variazione~" )  TABLE(NAME=~"listino~" ) COLUMN(NAME=~"articolo.codice~") COLUMN(NAME=~"articolo.des_breve~") COLUMN(NAME=~"unita_misura.simbolo~") COLUMN(NAME=~"tab_iva.des_breve~") COMPUTE(NAME=~"CAST (:parametri as char(255)) as parametri~") COLUMN(NAME=~"cat_com_articolo.codice~") COLUMN(NAME=~"cat_merceologica.codice~") COLUMN(NAME=~"cat_fiscale.codice~") COMPUTE(NAME=~"CAST(:ordinamento as char(30)) as ordinamento~") COMPUTE(NAME=~"CAST(SUBSTR(~~~"articolo~~~".~~~"codice~~~", :car_inizio, :lun_parte) AS CHAR(32)) AS parte_raggruppamento~") COMPUTE(NAME=~"CAST( (SELECT s.descrizione FROM scelta_parte s, cod_parte c WHERE c.id_cat_codifica = ~~~"articolo~~~".~~~"id_cat_codifica~~~" AND c.id_parte_regola = :id_parte_regola AND s.id_cod_parte = c.id_cod_parte AND s.scelta = parte_raggruppamento) AS CHAR(40)) AS des_parte_raggruppamento~") COLUMN(NAME=~"prezzo.prezzo~") COLUMN(NAME=~"valuta.descrizione~")    JOIN (LEFT=~"unita_confezione.id_unita_misura~"    OP =~"=~"RIGHT=~"unita_misura.id_unita_misura~"    OUTER1 =~"unita_confezione.id_unita_misura~" )    JOIN (LEFT=~"articolo.id_tab_iva~"    OP =~"=~"RIGHT=~"tab_iva.id_tab_iva~"    OUTER1 =~"articolo.id_tab_iva~" )    JOIN (LEFT=~"cat_merceologica.id_cat_merceologica~"    OP =~"=~"RIGHT=~"articolo.id_cat_merceologica~"    OUTER2 =~"articolo.id_cat_merceologica~" )    JOIN (LEFT=~"cat_fiscale.id_cat_fiscale~"    OP =~"=~"RIGHT=~"articolo.id_cat_fiscale~"    OUTER2 =~"articolo.id_cat_fiscale~" )    JOIN (LEFT=~"unita_confezione.id_articolo~"    OP =~"=~"RIGHT=~"articolo.id_articolo~" )    JOIN (LEFT=~"cat_com_articolo.id_cat_com_articolo~"    OP =~"=~"RIGHT=~"articolo.id_cat_com_articolo~" )    JOIN (LEFT=~"prezzo.id_unita_confezione~"    OP =~"=~"RIGHT=~"unita_confezione.id_unita_confezione~" )    JOIN (LEFT=~"prezzo.id_variazione~"    OP =~"=~"RIGHT=~"variazione.id_variazione~" )    JOIN (LEFT=~"listino.id_listino~"    OP =~"=~"RIGHT=~"variazione.id_listino~" )    JOIN (LEFT=~"valuta.id_valuta~"    OP =~"=~"RIGHT=~"listino.id_valuta~" )WHERE(    EXP1 =~"~~~"articolo~~~".~~~"id_cat_codifica~~~"~"   OP =~"=~"    EXP2 =~":cat_codifica~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"unita_confezione~~~".~~~"unita_base~~~"~"   OP =~"=~"    EXP2 =~"'S'~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"prezzo~~~".~~~"id_variazione~~~"~"   OP =~"=~"    EXP2 =~":rl_id_variazione~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"prezzo~~~".~~~"prezzo~~~"~"   OP =~">~"    EXP2 =~"0~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"prezzo~~~".~~~"prezzo~~~"~"   OP =~"is not~"    EXP2 =~"NULL~" ) ) ARG(NAME = ~"rl_id_variazione~" TYPE = number)  ARG(NAME = ~"cat_codifica~" TYPE = number)  ARG(NAME = ~"rs_titolo~" TYPE = string)  ARG(NAME = ~"parametri~" TYPE = string)  ARG(NAME = ~"ordinamento~" TYPE = string)  ARG(NAME = ~"car_inizio~" TYPE = number)  ARG(NAME = ~"lun_parte~" TYPE = number)  ARG(NAME = ~"des_parte~" TYPE = string)  ARG(NAME = ~"arrotondamento~" TYPE = number)  ARG(NAME = ~"tipo_arrotondamento~" TYPE = string)  ARG(NAME = ~"id_parte_regola~" TYPE = number)  ARG(NAME = ~"az_rag_soc_1~" TYPE = string) " arguments=(("rl_id_variazione", number),("cat_codifica", number),("rs_titolo", string),("parametri", string),("ordinamento", string),("car_inizio", number),("lun_parte", number),("des_parte", string),("arrotondamento", number),("tipo_arrotondamento", string),("id_parte_regola", number),("az_rag_soc_1", string)) )
