 column=(type=char(1) update=yes updatewhereclause=yes name=tipo dbname="sog_commerciale_gen.tipo" values="Cliente	C/Fornitore	F/Agente	A/Vettore	V/Altro	Z/Cliente potenziale	P/" validation=" gettext()  = 'C' OR  gettext()  = 'F' OR  gettext()  = 'A' OR  gettext()  = 'V' OR  gettext()  = 'Z' OR  gettext()  = 'P'" validationmsg="'Inserire: C, F, A, V, P, Z'" )
 column=(type=long update=yes updatewhereclause=yes identity=yes name=id_anagrafica dbname="sog_commerciale_gen.id_anagrafica" )
 column=(type=decimal(4) updatewhereclause=yes name=approvvigionamento_quantita dbname="approvvigionamento.quantita" )
 column=(type=long updatewhereclause=yes name=id_unita_confezione dbname="approvvigionamento.id_unita_confezione" )
 column=(type=decimal(0) updatewhereclause=yes name=giorni_consegna dbname="approvvigionamento.giorni_consegna" )
 column=(type=char(32766) updatewhereclause=no name=approvvigionamento_note dbname="approvvigionamento.note" )
 column=(type=decimal(0) updatewhereclause=yes name=prezzo dbname="prezzo" )
 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"sog_commerciale_gen~" )  TABLE(NAME=~"sog_commerciale~" )  TABLE(NAME=~"approvvigionamento~" ) COLUMN(NAME=~"sog_commerciale_gen.id_sog_commerciale~") COLUMN(NAME=~"sog_commerciale_gen.codice~") COLUMN(NAME=~"sog_commerciale_gen.rag_soc_1~") COLUMN(NAME=~"sog_commerciale_gen.rag_soc_2~") COLUMN(NAME=~"sog_commerciale_gen.indirizzo~") COLUMN(NAME=~"sog_commerciale_gen.cap~") COLUMN(NAME=~"sog_commerciale_gen.localita~") COLUMN(NAME=~"sog_commerciale_gen.provincia~") COLUMN(NAME=~"sog_commerciale_gen.nazione~") COLUMN(NAME=~"sog_commerciale_gen.cod_fiscale~") COLUMN(NAME=~"sog_commerciale_gen.par_iva~") COLUMN(NAME=~"sog_commerciale_gen.tipo~") COLUMN(NAME=~"sog_commerciale_gen.id_anagrafica~") COLUMN(NAME=~"approvvigionamento.quantita~") COLUMN(NAME=~"approvvigionamento.id_unita_confezione~") COLUMN(NAME=~"approvvigionamento.giorni_consegna~") COLUMN(NAME=~"approvvigionamento.note~") COMPUTE(NAME=~"cast(0 as numeric) as prezzo~")    JOIN (LEFT=~"approvvigionamento.id_sog_commerciale~"    OP =~"=~"RIGHT=~"sog_commerciale.id_sog_commerciale~"    OUTER2 =~"sog_commerciale.id_sog_commerciale~" )    JOIN (LEFT=~"sog_commerciale_gen.id_sog_commerciale~"    OP =~"=~"RIGHT=~"sog_commerciale.id_sog_commerciale~" )) ORDER(NAME=~"sog_commerciale_gen.rag_soc_1~" ASC=yes ) " retrieve.asneeded=yes )
