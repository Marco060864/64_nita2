 column=(type=decimal(4) updatewhereclause=yes name=tot_merce_v dbname="tot_merce_v" )
 column=(type=decimal(4) updatewhereclause=yes name=tot_doc_v dbname="tot_doc_v" )
 column=(type=decimal(4) updatewhereclause=yes name=prezzo_v dbname="prezzo_v" )
 column=(type=decimal(4) updatewhereclause=yes name=sconto_riga_v dbname="sconto_riga_v" )
 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"prof_documento~" )  TABLE(NAME=~"documento~" )  TABLE(NAME=~"sog_commerciale_gen~" )  TABLE(NAME=~"riga_documento~" )  TABLE(NAME=~"articolo~" )  TABLE(NAME=~"unita_confezione~" )  TABLE(NAME=~"valuta~" ) COLUMN(NAME=~"prof_documento.codice~") COLUMN(NAME=~"prof_documento.descrizione~") COLUMN(NAME=~"documento.data_documento~") COLUMN(NAME=~"documento.num_documento~") COLUMN(NAME=~"sog_commerciale_gen.codice~") COLUMN(NAME=~"sog_commerciale_gen.rag_soc_1~") COLUMN(NAME=~"articolo.codice~") COLUMN(NAME=~"articolo.des_breve~") COLUMN(NAME=~"documento.sconto_finanziario~") COLUMN(NAME=~"documento.sconto_fin_incondizionato~") COLUMN(NAME=~"documento.sconto_fin_cassa~") COLUMN(NAME=~"unita_confezione.codice~") COLUMN(NAME=~"riga_documento.quantita~") COLUMN(NAME=~"riga_documento.prezzo~") COLUMN(NAME=~"riga_documento.sconto~") COLUMN(NAME=~"riga_documento.sconto_riga~") COLUMN(NAME=~"valuta.cambio~") COLUMN(NAME=~"riga_documento.id_valuta~") COLUMN(NAME=~"riga_documento.tot_riga_val_az~") COMPUTE(NAME=~"CAST( ( SELECT SUM(fn_conv_valuta( id_valuta, tot_riga_val_riga, :rn_id_valuta) ) FROM riga_documento WHERE id_documento = ~~~"documento~~~".~~~"id_documento~~~") AS NUMERIC(18,4)) AS tot_merce_v~") COMPUTE(NAME=~"CAST ( (SELECT SUM(fn_conv_valuta(d.id_valuta, c.val_tot_imp_v, :rn_id_valuta)) + SUM(fn_conv_valuta(d.id_valuta, val_tot_iva_v, :rn_id_valuta)) FROM cast_iva_documento c, documento d WHERE c.id_documento = d.id_documento AND d.id_documento = ~~~"documento~~~".~~~"id_documento~~~") AS NUMERIC(18,4)) AS tot_doc_v~") COMPUTE(NAME=~"CAST( fn_conv_valuta( ~~~"riga_documento~~~".~~~"id_valuta~~~", ~~~"riga_documento~~~".~~~"prezzo~~~", :rn_id_valuta) AS DECIMAL(18,4)) AS prezzo_v~") COMPUTE(NAME=~"CAST( fn_conv_valuta( ~~~"riga_documento~~~".~~~"id_valuta~~~", ~~~"riga_documento~~~".~~~"sconto_riga~~~", :rn_id_valuta) AS DECIMAL(18,4)) AS sconto_riga_v~")    JOIN (LEFT=~"documento.id_prof_documento~"    OP =~"=~"RIGHT=~"prof_documento.id_prof_documento~" )    JOIN (LEFT=~"sog_commerciale_gen.id_sog_commerciale~"    OP =~"=~"RIGHT=~"documento.id_sog_commerciale~" )    JOIN (LEFT=~"riga_documento.id_documento~"    OP =~"=~"RIGHT=~"documento.id_documento~" )    JOIN (LEFT=~"articolo.id_articolo~"    OP =~"=~"RIGHT=~"riga_documento.id_articolo~" )    JOIN (LEFT=~"unita_confezione.id_articolo~"    OP =~"=~"RIGHT=~"articolo.id_articolo~" )    JOIN (LEFT=~"valuta.id_valuta~"    OP =~"=~"RIGHT=~"riga_documento.id_valuta~" )) ARG(NAME = ~"parametri~" TYPE = string)  ARG(NAME = ~"rn_id_valuta~" TYPE = number) " arguments=(("parametri", string),("rn_id_valuta", number)) )
