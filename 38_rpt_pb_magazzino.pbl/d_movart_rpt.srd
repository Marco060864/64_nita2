table(column=(type=date updatewhereclause=yes name=documento_data_registrazione dbname="documento.data_registrazione" )
 column=(type=date updatewhereclause=yes name=documento_data_documento dbname="documento.data_documento" )
 column=(type=decimal(0) updatewhereclause=yes name=documento_num_progressivo dbname="documento.num_progressivo" )
 column=(type=char(40) updatewhereclause=yes name=registro_descrizione dbname="registro.descrizione" )
 column=(type=char(8) updatewhereclause=yes name=sog_commerciale_gen_codice dbname="sog_commerciale_gen.codice" )
 column=(type=char(40) updatewhereclause=yes name=sog_commerciale_gen_rag_soc_1 dbname="sog_commerciale_gen.rag_soc_1" )
 column=(type=char(32) updatewhereclause=yes name=articolo_codice dbname="articolo.codice" )
 column=(type=char(40) updatewhereclause=yes name=articolo_des_breve dbname="articolo.des_breve" )
 column=(type=char(8) updatewhereclause=yes name=unita_confezione_codice dbname="unita_confezione.codice" )
 column=(type=char(40) updatewhereclause=yes name=unita_confezione_descrizione dbname="unita_confezione.descrizione" )
 column=(type=char(8) updatewhereclause=yes name=caus_magazzino_codice dbname="caus_magazzino.codice" )
 column=(type=char(40) updatewhereclause=yes name=caus_magazzino_descrizione dbname="caus_magazzino.descrizione" )
 column=(type=char(1) updatewhereclause=yes name=unita_confezione_unita_base dbname="unita_confezione.unita_base" )
 column=(type=long updatewhereclause=yes name=riga_documento_id_riga_documento dbname="riga_documento.id_riga_documento" )
 column=(type=decimal(4) updatewhereclause=yes name=riga_documento_quantita dbname="riga_documento.quantita" )
 column=(type=char(1) updatewhereclause=yes name=ccarico dbname="carico" values="	S/	N" )
 column=(type=char(1) updatewhereclause=yes name=cscarico dbname="scarico" values="	S/	N" )
 column=(type=decimal(4) updatewhereclause=yes name=riga_documento_prezzo_netto dbname="riga_documento.prezzo_netto" )
 column=(type=decimal(4) updatewhereclause=yes name=riga_documento_tot_riga_val_az dbname="riga_documento.tot_riga_val_az" )
 column=(type=char(8) updatewhereclause=yes name=magazzino_codice dbname="magazzino.codice" )
 column=(type=decimal(4) updatewhereclause=yes name=valuta_cambio dbname="valuta.cambio" )
 column=(type=char(2) updatewhereclause=yes name=ctipo_movimento dbname="tipo_movimento" )
 column=(type=long updatewhereclause=yes name=id_val_euro dbname="id_val_euro" )
 column=(type=decimal(4) updatewhereclause=yes name=prezzo_netto_v dbname="prezzo_netto_v" )
 column=(type=decimal(4) updatewhereclause=yes name=tot_riga_val_riga_v dbname="tot_riga_val_riga_v" )
 column=(type=decimal(4) updatewhereclause=yes name=tot_riga_val_riga_e dbname="tot_riga_val_riga_e" )
 retrieve="  SELECT ~"documento~".~"data_registrazione~",   
			~"documento~".~"data_documento~",   
         ~"documento~".~"num_progressivo~",   
         ~"registro~".~"descrizione~",   
         ~"sog_commerciale_gen~".~"codice~",   
         ~"sog_commerciale_gen~".~"rag_soc_1~",   
         ~"articolo~".~"codice~",   
         ~"articolo~".~"des_breve~",   
         ~"unita_confezione~".~"codice~",   
         ~"unita_confezione~".~"descrizione~",   
         ~"caus_magazzino~".~"codice~",   
         ~"caus_magazzino~".~"descrizione~",   
         ~"unita_confezione~".~"unita_base~", 
         ~"riga_documento~".~"id_riga_documento~",  
         ~"riga_documento~".~"quantita~",   
         CAST('N' AS CHAR(1)) AS carico,   
         CAST('N' AS CHAR(1)) AS scarico,   
         ~"riga_documento~".~"prezzo_netto~",   
         ~"riga_documento~".~"tot_riga_val_az~",   
         ~"magazzino~".~"codice~",   
         ~"valuta~".~"cambio~",   
         CAST(FN_TIPO_MOVIMENTO(~"riga_documento~".~"id_caus_magazzino~", 'P') AS CHAR(2)) AS tipo_movimento,
			CAST( ( SELECT id_val_euro FROM par_sistema) AS INTEGER) AS id_val_euro,
			CAST( fn_conv_valuta(~"riga_documento~".~"id_valuta~", ~"riga_documento~".~"prezzo_netto~", :rn_id_valuta) AS DECIMAL(18,4) ) AS prezzo_netto_v,
			CAST( fn_conv_valuta(~"riga_documento~".~"id_valuta~", ~"riga_documento~".~"tot_riga_val_riga~", :rn_id_valuta) AS DECIMAL(18,4) ) AS tot_riga_val_riga_v,
			CAST( fn_conv_valuta(~"riga_documento~".~"id_valuta~", ~"riga_documento~".~"tot_riga_val_riga~", id_val_euro) AS DECIMAL(18,4) ) AS tot_riga_val_riga_e
    FROM ~"documento~",   
         ~"registro~",   
         ~"sog_commerciale_gen~",   
         ~"riga_documento~",   
         ~"articolo~",   
         ~"unita_confezione~",   
         ~"caus_magazzino~",   
         ~"locazione~",   
         ~"magazzino~",   
         ~"valuta~"  
   WHERE ( ~"sog_commerciale_gen~".~"id_sog_commerciale~" = ~"documento~".~"id_sog_commerciale~" ) and  
         ( ~"registro~".~"id_registro~" = ~"documento~".~"id_registro~" ) and  
         ( ~"articolo~".~"id_articolo~" = ~"riga_documento~".~"id_articolo~" ) and  
         ( ~"unita_confezione~".~"id_unita_confezione~" = ~"riga_documento~".~"id_unita_confezione~" ) and  
         ( ~"caus_magazzino~".~"id_caus_magazzino~" = ~"riga_documento~".~"id_caus_magazzino~" ) and  
         ( ~"magazzino~".~"id_magazzino~" = ~"locazione~".~"id_magazzino~" ) and  
         ( ~"valuta~".~"id_valuta~" = ~"riga_documento~".~"id_valuta~" ) and  
         ( ~"locazione~".~"id_locazione~" = ~"riga_documento~".~"id_locazione_1~" ) and  
         ( ~"riga_documento~".~"id_documento~" = ~"documento~".~"id_documento~" )   
   UNION   
  SELECT ~"documento~".~"data_registrazione~",   
			~"documento~".~"data_documento~",   
         ~"documento~".~"num_progressivo~",   
         ~"registro~".~"descrizione~",   
         ~"sog_commerciale_gen~".~"codice~",   
         ~"sog_commerciale_gen~".~"rag_soc_1~",   
         ~"articolo~".~"codice~",   
         ~"articolo~".~"des_breve~",   
         ~"unita_confezione~".~"codice~",   
         ~"unita_confezione~".~"descrizione~",   
         ~"caus_magazzino~".~"codice~",   
         ~"caus_magazzino~".~"descrizione~",   
         ~"unita_confezione~".~"unita_base~",  
         ~"riga_documento~".~"id_riga_documento~", 
         ~"riga_documento~".~"quantita~",   
         CAST('N' AS CHAR(1)) AS carico,   
         CAST('N' AS CHAR(1)) AS scarico,   
         ~"riga_documento~".~"prezzo_netto~",   
         ~"riga_documento~".~"tot_riga_val_az~",   
         ~"magazzino~".~"codice~",   
         ~"valuta~".~"cambio~",   
         CAST(FN_TIPO_MOVIMENTO(~"riga_documento~".~"id_caus_magazzino~", 'D') AS CHAR(2)) AS tipo_movimento  ,
			CAST( ( SELECT id_val_euro FROM par_sistema) AS INTEGER) AS id_val_euro,
			CAST( fn_conv_valuta(~"riga_documento~".~"id_valuta~", ~"riga_documento~".~"prezzo_netto~", :rn_id_valuta) AS DECIMAL(18,4) ) AS prezzo_netto_v,
			CAST( fn_conv_valuta(~"riga_documento~".~"id_valuta~", ~"riga_documento~".~"tot_riga_val_riga~", :rn_id_valuta) AS DECIMAL(18,4) ) AS tot_riga_val_riga_v,
			CAST( fn_conv_valuta(~"riga_documento~".~"id_valuta~", ~"riga_documento~".~"tot_riga_val_riga~", id_val_euro) AS DECIMAL(18,4) ) AS tot_riga_val_riga_e
    FROM ~"documento~",   
         ~"registro~",   
         ~"sog_commerciale_gen~",   
         ~"riga_documento~",   
         ~"articolo~",   
         ~"unita_confezione~",   
         ~"caus_magazzino~",   
         ~"locazione~",   
         ~"magazzino~",   
         ~"valuta~"  
   WHERE ( ~"sog_commerciale_gen~".~"id_sog_commerciale~" = ~"documento~".~"id_sog_commerciale~" ) and  
         ( ~"registro~".~"id_registro~" = ~"documento~".~"id_registro~" ) and  
         ( ~"articolo~".~"id_articolo~" = ~"riga_documento~".~"id_articolo~" ) and  
         ( ~"unita_confezione~".~"id_unita_confezione~" = ~"riga_documento~".~"id_unita_confezione~" ) and  
         ( ~"caus_magazzino~".~"id_caus_magazzino~" = ~"riga_documento~".~"id_caus_magazzino~" ) and  
         ( ~"magazzino~".~"id_magazzino~" = ~"locazione~".~"id_magazzino~" ) and  
         ( ~"valuta~".~"id_valuta~" = ~"riga_documento~".~"id_valuta~" ) and  
         ( ~"riga_documento~".~"id_documento~" = ~"documento~".~"id_documento~" ) and  
         ( ~"locazione~".~"id_locazione~" = ~"riga_documento~".~"id_locazione_2~" )    
" arguments=(("parametri", string),("parita_euro", number),("cifra_arrotondamento_E", number),("tipo_arrotondamento_E", string),("rn_id_valuta", number)) )
