 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"con_lis_articolo~" )  TABLE(NAME=~"listino~" )  TABLE(NAME=~"valuta~" )  TABLE(NAME=~"unita_confezione~" )  TABLE(NAME=~"anagrafica~" )  TABLE(NAME=~"sog_commerciale~" ALIAS=~"sog_commerciale_a~" )  TABLE(NAME=~"sog_commerciale~" ALIAS=~"sog_commerciale_b~" )  TABLE(NAME=~"articolo~" ALIAS=~"articolo_a~" )  TABLE(NAME=~"articolo~" ALIAS=~"articolo_b~" ) COLUMN(NAME=~"con_lis_articolo.tipo_applicazione~") COLUMN(NAME=~"listino.codice~") COLUMN(NAME=~"listino.descrizione~") COLUMN(NAME=~"valuta.codice~") COLUMN(NAME=~"con_lis_articolo.importo~") COLUMN(NAME=~"con_lis_articolo.percentuali~") COLUMN(NAME=~"con_lis_articolo.spesa~") COLUMN(NAME=~"con_lis_articolo.spesa_fissa~") COLUMN(NAME=~"unita_confezione.codice~") COLUMN(NAME=~"con_lis_articolo.id_cat_com_sc~") COLUMN(NAME=~"con_lis_articolo.id_cat_com_articolo~") COLUMN(NAME=~"con_lis_articolo.data_inizio~") COLUMN(NAME=~"con_lis_articolo.data_fine~") COLUMN(NAME=~"con_lis_articolo.qta_minima~") COLUMN(NAME=~"con_lis_articolo.qta_massima~") COLUMN(NAME=~"con_lis_articolo.applicazione~") COLUMN(NAME=~"anagrafica.rag_soc_1~") COLUMN(NAME=~"sog_commerciale_a.codice~") COLUMN(NAME=~"sog_commerciale_b.codice~") COLUMN(NAME=~"articolo_a.codice~") COLUMN(NAME=~"articolo_b.codice~")    JOIN (LEFT=~"unita_confezione.id_unita_confezione~"    OP =~"=~"RIGHT=~"con_lis_articolo.id_unita_confezione~"    OUTER2 =~"con_lis_articolo.id_unita_confezione~" )    JOIN (LEFT=~"listino.id_listino~"    OP =~"=~"RIGHT=~"con_lis_articolo.id_listino~"    OUTER2 =~"con_lis_articolo.id_listino~" )    JOIN (LEFT=~"valuta.id_valuta~"    OP =~"=~"RIGHT=~"con_lis_articolo.id_valuta~"    OUTER2 =~"con_lis_articolo.id_valuta~" )    JOIN (LEFT=~"anagrafica.id_anagrafica~"    OP =~"=~"RIGHT=~"con_lis_articolo.id_anagrafica~"    OUTER2 =~"con_lis_articolo.id_anagrafica~" )    JOIN (LEFT=~"sog_commerciale_a.id_sog_commerciale~"    OP =~"=~"RIGHT=~"con_lis_articolo.id_sog_commerciale~"    OUTER2 =~"con_lis_articolo.id_sog_commerciale~" )    JOIN (LEFT=~"sog_commerciale_b.id_sog_commerciale~"    OP =~"=~"RIGHT=~"con_lis_articolo.id_sog_commerciale_fornitore~"    OUTER2 =~"con_lis_articolo.id_sog_commerciale_fornitore~" )    JOIN (LEFT=~"articolo_a.id_articolo~"    OP =~"=~"RIGHT=~"con_lis_articolo.id_art_da~"    OUTER2 =~"con_lis_articolo.id_art_da~" )    JOIN (LEFT=~"articolo_b.id_articolo~"    OP =~"=~"RIGHT=~"con_lis_articolo.id_art_a~"    OUTER2 =~"con_lis_articolo.id_art_a~" )) "  sort="con_lis_articolo_tipo_applicazione A " )
