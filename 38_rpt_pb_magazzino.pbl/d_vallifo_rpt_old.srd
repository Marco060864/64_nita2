table(column=(type=char(32) updatewhereclause=yes name=articolo_codice dbname="articolo.codice" )
 column=(type=char(4) updatewhereclause=yes name=esercizio_codice dbname="esercizio.codice" )
 column=(type=decimal(4) updatewhereclause=yes name=carichi dbname="carichi" )
 column=(type=decimal(4) updatewhereclause=yes name=scarichi dbname="scarichi" )
 column=(type=decimal(4) updatewhereclause=yes name=val_caricato dbname="val_caricato" )
 column=(type=decimal(4) updatewhereclause=yes name=diff_car_scar dbname="diff_car_scar" )
 column=(type=long updatewhereclause=yes name=rimanenza_val dbname="articolo.rimanenza_val" )
 column=(type=long updatewhereclause=yes name=costo_medio_val dbname="articolo.costo_medio_val" )
 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"articolo~" )  TABLE(NAME=~"esercizio~" )  TABLE(NAME=~"riepilogo~" ) COLUMN(NAME=~"articolo.codice~") COLUMN(NAME=~"esercizio.codice~") COMPUTE(NAME=~"SUM(~~~"riepilogo~~~".~~~"qta_caricata~~~") CARICHI~") COMPUTE(NAME=~"SUM(~~~"riepilogo~~~".~~~"qta_scaricata~~~") SCARICHI~") COMPUTE(NAME=~"SUM(~~~"riepilogo~~~".~~~"val_caricato~~~") VAL_CARICATO~") COMPUTE(NAME=~"carichi - scarichi DIFF_CAR_SCAR~") COMPUTE(NAME=~"10 RIMANENZA_VAL~") COMPUTE(NAME=~"1200 COSTO_MEDIO_VAL~")    JOIN (LEFT=~"articolo.id_articolo~"    OP =~"=~"RIGHT=~"riepilogo.id_articolo~" )    JOIN (LEFT=~"esercizio.id_esercizio~"    OP =~"=~"RIGHT=~"riepilogo.id_esercizio~" ) GROUP(NAME=~"esercizio.codice~") GROUP(NAME=~"articolo.codice~")) ORDER(NAME=~"articolo.codice~" ASC=yes )  ORDER(NAME=~"esercizio.codice~" ASC=yes ) " )
