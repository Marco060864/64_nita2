 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"articolo~" )  TABLE(NAME=~"listino~" )  TABLE(NAME=~"prezzo~" )  TABLE(NAME=~"tab_iva~" )  TABLE(NAME=~"unita_confezione~" )  TABLE(NAME=~"valuta~" )  TABLE(NAME=~"variazione~" ) COLUMN(NAME=~"listino.codice~") COLUMN(NAME=~"listino.descrizione~") COLUMN(NAME=~"variazione.data_inizio~") COLUMN(NAME=~"variazione.data_fine~") COLUMN(NAME=~"valuta.descrizione~") COLUMN(NAME=~"articolo.codice~") COLUMN(NAME=~"articolo.des_breve~") COLUMN(NAME=~"unita_confezione.codice~") COLUMN(NAME=~"unita_confezione.descrizione~") COLUMN(NAME=~"prezzo.prezzo~") COLUMN(NAME=~"tab_iva.codice~") COLUMN(NAME=~"variazione.id_variazione~") COLUMN(NAME=~"listino.tipo~") COMPUTE(NAME=~"cast(:parametri as char(255)) as parametri~") COLUMN(NAME=~"valuta.cifra_arrotondamento~") COLUMN(NAME=~"valuta.tipo_arrotondamento~")    JOIN (LEFT=~"listino.id_listino~"    OP =~"=~"RIGHT=~"variazione.id_listino~" )    JOIN (LEFT=~"listino.id_valuta~"    OP =~"=~"RIGHT=~"valuta.id_valuta~" )    JOIN (LEFT=~"unita_confezione.id_unita_confezione~"    OP =~"=~"RIGHT=~"prezzo.id_unita_confezione~" )    JOIN (LEFT=~"articolo.id_articolo~"    OP =~"=~"RIGHT=~"unita_confezione.id_articolo~" )    JOIN (LEFT=~"articolo.id_tab_iva~"    OP =~"=~"RIGHT=~"tab_iva.id_tab_iva~" )    JOIN (LEFT=~"variazione.id_variazione~"    OP =~"=~"RIGHT=~"prezzo.id_variazione~" )WHERE(    EXP1 =~"~~~"listino~~~".~~~"codice~~~"~"   OP =~">=~"    EXP2 =~":da_listino~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"listino~~~".~~~"codice~~~"~"   OP =~"<=~"    EXP2 =~":a_listino~" ) ) ARG(NAME = ~"parametri~" TYPE = string)  ARG(NAME = ~"da_listino~" TYPE = string)  ARG(NAME = ~"a_listino~" TYPE = string) " arguments=(("parametri", string),("da_listino", string),("a_listino", string))  sort="listino_codice A variazione_id_variazione A articolo_codice A unita_confezione_codice A " )
