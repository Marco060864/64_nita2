 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"scadenza~" )  TABLE(NAME=~"tipo_pagamento~" )  TABLE(NAME=~"sog_commerciale_gen~" )  TABLE(NAME=~"valuta~" )  TABLE(NAME=~"documento~" )  TABLE(NAME=~"dis_banca~" )  TABLE(NAME=~"banca_appoggio~" )  TABLE(NAME=~"banca_sog_commerciale~" ) COLUMN(NAME=~"scadenza.data_scadenza~") COLUMN(NAME=~"sog_commerciale_gen.codice~") COLUMN(NAME=~"sog_commerciale_gen.rag_soc_1~") COLUMN(NAME=~"tipo_pagamento.codice~") COLUMN(NAME=~"valuta.codice~") COLUMN(NAME=~"scadenza.imp_valuta~") COLUMN(NAME=~"documento.num_progressivo~") COLUMN(NAME=~"dis_banca.num_distinta~") COLUMN(NAME=~"dis_banca.data_distinta~") COLUMN(NAME=~"banca_appoggio.cod_abi~") COLUMN(NAME=~"banca_appoggio.cod_cab~") COLUMN(NAME=~"banca_appoggio.den_abi~") COLUMN(NAME=~"banca_appoggio.den_cab~") COLUMN(NAME=~"valuta.parita_euro~") COLUMN(NAME=~"scadenza.importo~") COMPUTE(NAME=~"cast(:parametri as char(255))as parametri~")    JOIN (LEFT=~"sog_commerciale_gen.id_sog_commerciale~"    OP =~"=~"RIGHT=~"scadenza.id_sog_commerciale~"    OUTER2 =~"scadenza.id_sog_commerciale~" )    JOIN (LEFT=~"documento.id_documento~"    OP =~"=~"RIGHT=~"scadenza.id_documento~"    OUTER2 =~"scadenza.id_documento~" )    JOIN (LEFT=~"dis_banca.id_distinta_banca~"    OP =~"=~"RIGHT=~"scadenza.id_riga_distinta_banca~"    OUTER2 =~"scadenza.id_riga_distinta_banca~" )    JOIN (LEFT=~"scadenza.id_banca_sog_commerciale~"    OP =~"=~"RIGHT=~"banca_sog_commerciale.id_banca_sog_commerciale~"    OUTER1 =~"scadenza.id_banca_sog_commerciale~" )    JOIN (LEFT=~"banca_sog_commerciale.id_banca_appoggio~"    OP =~"=~"RIGHT=~"banca_appoggio.id_banca_appoggio~" )    JOIN (LEFT=~"tipo_pagamento.id_tipo_pagamento~"    OP =~"=~"RIGHT=~"scadenza.id_tipo_pagamento~" )    JOIN (LEFT=~"valuta.id_valuta~"    OP =~"=~"RIGHT=~"scadenza.id_valuta~" )) ARG(NAME = ~"parametri~" TYPE = string) " filter=" tipo_pagamento_codice ='RD'"arguments=(("parametri", string))  sort="banca_appoggio_cod_abi A banca_appoggio_cod_cab A scadenza_data_scadenza A sog_commerciale_gen_codice A documento_num_progressivo A " )
