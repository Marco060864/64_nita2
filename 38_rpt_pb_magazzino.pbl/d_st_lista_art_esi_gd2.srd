 column=(type=decimal(4) updatewhereclause=yes name=dispon dbname="dispon" )
 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"articolo~" )  TABLE(NAME=~"cat_com_articolo~" )  TABLE(NAME=~"cat_fiscale~" )  TABLE(NAME=~"cat_merceologica~" )  TABLE(NAME=~"unita_confezione~" )  TABLE(NAME=~"unita_misura~" )  TABLE(NAME=~"anagrafica~" )  TABLE(NAME=~"sog_commerciale_gen~" )  TABLE(NAME=~"prezzo~" )  TABLE(NAME=~"listino~" )  TABLE(NAME=~"variazione~" )  TABLE(NAME=~"locazione~" )  TABLE(NAME=~"magazzino~" )  TABLE(NAME=~"riepilogo~" ) COLUMN(NAME=~"articolo.codice~") COLUMN(NAME=~"articolo.des_breve~") COLUMN(NAME=~"cat_com_articolo.codice~") COLUMN(NAME=~"cat_merceologica.codice~") COLUMN(NAME=~"cat_fiscale.codice~") COLUMN(NAME=~"unita_misura.simbolo~") COMPUTE(NAME=~"CAST(:ordinamento AS CHAR(40)) AS ordinamento~") COLUMN(NAME=~"articolo.descrizione~") COLUMN(NAME=~"prezzo.prezzo~") COLUMN(NAME=~"magazzino.codice~") COLUMN(NAME=~"magazzino.descrizione~") COLUMN(NAME=~"magazzino.id_magazzino~") COLUMN(NAME=~"articolo.id_articolo~") COMPUTE(NAME=~"CAST(fn_esi_disp(1, ~~~"articolo~~~".~~~"id_articolo~~~", ~~~"magazzino~~~".~~~"id_magazzino~~~", :ri_anno, :ri_mese, :ri_prof) AS CHAR(100)) AS ret_esistenza~") COMPUTE(NAME=~"CAST( SUBSTRING(ret_esistenza, 1, 20) AS NUMERIC(18,4) ) AS esi_fisica_attuale~") COMPUTE(NAME=~"CAST( SUBSTRING(ret_esistenza, 21, 20) AS NUMERIC(18,4) ) AS esi_fiscale_attuale~") COMPUTE(NAME=~"CAST( SUBSTRING(ret_esistenza, 41, 20) AS NUMERIC(18,4) ) AS dispon~")    JOIN (LEFT=~"cat_fiscale.id_cat_fiscale~"    OP =~"=~"RIGHT=~"articolo.id_cat_fiscale~"    OUTER2 =~"articolo.id_cat_fiscale~" )    JOIN (LEFT=~"cat_merceologica.id_cat_merceologica~"    OP =~"=~"RIGHT=~"articolo.id_cat_merceologica~"    OUTER2 =~"articolo.id_cat_merceologica~" )    JOIN (LEFT=~"unita_misura.id_unita_misura~"    OP =~"=~"RIGHT=~"unita_confezione.id_unita_misura~"    OUTER2 =~"unita_confezione.id_unita_misura~" )    JOIN (LEFT=~"sog_commerciale_gen.id_sog_commerciale~"    OP =~"=~"RIGHT=~"articolo.id_sog_commerciale~"    OUTER2 =~"articolo.id_sog_commerciale~" )    JOIN (LEFT=~"anagrafica.id_anagrafica~"    OP =~"=~"RIGHT=~"articolo.id_anagrafica~"    OUTER2 =~"articolo.id_anagrafica~" )    JOIN (LEFT=~"prezzo.id_unita_confezione~"    OP =~"=~"RIGHT=~"unita_confezione.id_unita_confezione~"    OUTER2 =~"unita_confezione.id_unita_confezione~" )    JOIN (LEFT=~"cat_com_articolo.id_cat_com_articolo~"    OP =~"=~"RIGHT=~"articolo.id_cat_com_articolo~" )    JOIN (LEFT=~"unita_confezione.id_articolo~"    OP =~"=~"RIGHT=~"articolo.id_articolo~" )    JOIN (LEFT=~"variazione.id_listino~"    OP =~"=~"RIGHT=~"listino.id_listino~" )    JOIN (LEFT=~"variazione.id_variazione~"    OP =~"=~"RIGHT=~"prezzo.id_variazione~" )    JOIN (LEFT=~"magazzino.id_magazzino~"    OP =~"=~"RIGHT=~"locazione.id_magazzino~" )    JOIN (LEFT=~"riepilogo.id_locazione~"    OP =~"=~"RIGHT=~"locazione.id_locazione~" )    JOIN (LEFT=~"riepilogo.id_articolo~"    OP =~"=~"RIGHT=~"articolo.id_articolo~" )WHERE(    EXP1 =~"~~~"articolo~~~".~~~"codice~~~"~"   OP =~">=~"    EXP2 =~":rs_da_codice~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"articolo~~~".~~~"codice~~~"~"   OP =~"<=~"    EXP2 =~":rs_a_codice~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"unita_confezione~~~".~~~"unita_base~~~"~"   OP =~"=~"    EXP2 =~"'S'~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"magazzino~~~".~~~"codice~~~"~"   OP =~">=~"    EXP2 =~":da_magazzino~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"magazzino~~~".~~~"codice~~~"~"   OP =~"<=~"    EXP2 =~":a_magazzino~" ) ) ARG(NAME = ~"rs_da_codice~" TYPE = string)  ARG(NAME = ~"rs_a_codice~" TYPE = string)  ARG(NAME = ~"parametri~" TYPE = string)  ARG(NAME = ~"ordinamento~" TYPE = string)  ARG(NAME = ~"rl_id_magazzino~" TYPE = number)  ARG(NAME = ~"ri_anno~" TYPE = number)  ARG(NAME = ~"ri_mese~" TYPE = number)  ARG(NAME = ~"ri_prof~" TYPE = number)  ARG(NAME = ~"da_magazzino~" TYPE = string)  ARG(NAME = ~"a_magazzino~" TYPE = string) " arguments=(("rs_da_codice", string),("rs_a_codice", string),("parametri", string),("ordinamento", string),("rl_id_magazzino", number),("ri_anno", number),("ri_mese", number),("ri_prof", number),("da_magazzino", string),("a_magazzino", string)) )
