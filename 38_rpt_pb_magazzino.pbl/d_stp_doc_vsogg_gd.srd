 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"articolo~" )  TABLE(NAME=~"unita_confezione~" )  TABLE(NAME=~"documento~" )  TABLE(NAME=~"prof_documento~" )  TABLE(NAME=~"riga_documento~" )  TABLE(NAME=~"par_sistema~" )  TABLE(NAME=~"valuta~" )  TABLE(NAME=~"sog_commerciale_gen~" ) COLUMN(NAME=~"articolo.codice~") COLUMN(NAME=~"articolo.descrizione~") COLUMN(NAME=~"unita_confezione.codice~") COLUMN(NAME=~"unita_confezione.descrizione~") COLUMN(NAME=~"riga_documento.quantita~") COLUMN(NAME=~"documento.cambio~") COLUMN(NAME=~"riga_documento.prezzo_netto~") COLUMN(NAME=~"riga_documento.tot_riga_val_az~") COLUMN(NAME=~"prof_documento.codice~") COLUMN(NAME=~"riga_documento.qta_evasa~") COLUMN(NAME=~"valuta.parita_euro~") COLUMN(NAME=~"sog_commerciale_gen.codice~") COLUMN(NAME=~"sog_commerciale_gen.rag_soc_1~") COMPUTE(NAME=~"cast(:parametri as char(255))as parametri~") COLUMN(NAME=~"documento.data_documento~") COLUMN(NAME=~"documento.num_documento~")    JOIN (LEFT=~"unita_confezione.id_articolo~"    OP =~"=~"RIGHT=~"articolo.id_articolo~"    OUTER2 =~"articolo.id_articolo~" )    JOIN (LEFT=~"prof_documento.id_prof_documento~"    OP =~"=~"RIGHT=~"documento.id_prof_documento~" )    JOIN (LEFT=~"riga_documento.id_documento~"    OP =~"=~"RIGHT=~"documento.id_documento~" )    JOIN (LEFT=~"articolo.id_articolo~"    OP =~"=~"RIGHT=~"riga_documento.id_articolo~" )    JOIN (LEFT=~"valuta.id_valuta~"    OP =~"=~"RIGHT=~"par_sistema.id_val_lire~" )    JOIN (LEFT=~"sog_commerciale_gen.id_sog_commerciale~"    OP =~"=~"RIGHT=~"documento.id_sog_commerciale~" )WHERE(    EXP1 =~"~~~"sog_commerciale_gen~~~".~~~"codice~~~"~"   OP =~">=~"    EXP2 =~":da_sogg~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"sog_commerciale_gen~~~".~~~"codice~~~"~"   OP =~"<=~"    EXP2 =~":a_sogg~" ) ) ARG(NAME = ~"ra_stato_r~" TYPE = string)  ARG(NAME = ~"parametri~" TYPE = string)  ARG(NAME = ~"da_sogg~" TYPE = string)  ARG(NAME = ~"a_sogg~" TYPE = string) " arguments=(("ra_stato_r", string),("parametri", string),("da_sogg", string),("a_sogg", string))  sort="sog_commerciale_gen_codice A articolo_codice A unita_confezione_codice A documento_data_documento A documento_num_documento A " )
