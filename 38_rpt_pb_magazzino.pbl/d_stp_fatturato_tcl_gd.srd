 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"cast_iva_documento~" )  TABLE(NAME=~"documento~" )  TABLE(NAME=~"sog_commerciale~" )  TABLE(NAME=~"anagrafica~" )  TABLE(NAME=~"cat_com_sc~" )  TABLE(NAME=~"registro~" ) COLUMN(NAME=~"sog_commerciale.codice~") COLUMN(NAME=~"anagrafica.rag_soc_1~") COLUMN(NAME=~"cat_com_sc.codice~") COMPUTE(NAME=~"sum(~~~"cast_iva_documento~~~".~~~"val_tot_imp_l~~~")~") COMPUTE(NAME=~"sum(~~~"cast_iva_documento~~~".~~~"val_tot_imp_l~~~")+sum(~~~"cast_iva_documento~~~".~~~"val_tot_iva_l~~~")~") COMPUTE(NAME=~"cast(:parametri as char(255)) as parametri~")    JOIN (LEFT=~"cat_com_sc.id_cat_com_sc~"    OP =~"=~"RIGHT=~"sog_commerciale.id_cat_com_sc~"    OUTER2 =~"sog_commerciale.id_cat_com_sc~" )    JOIN (LEFT=~"cast_iva_documento.id_documento~"    OP =~"=~"RIGHT=~"documento.id_documento~" )    JOIN (LEFT=~"sog_commerciale.id_sog_commerciale~"    OP =~"=~"RIGHT=~"documento.id_sog_commerciale_fattura~" )    JOIN (LEFT=~"anagrafica.id_anagrafica~"    OP =~"=~"RIGHT=~"sog_commerciale.id_anagrafica~" )    JOIN (LEFT=~"registro.id_registro~"    OP =~"=~"RIGHT=~"documento.id_registro~" )WHERE(    EXP1 =~"( ( ~~~"sog_commerciale~~~".~~~"codice~~~"~"   OP =~">=~"    EXP2 =~":da_cliente )~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"( ~~~"sog_commerciale~~~".~~~"codice~~~"~"   OP =~"<=~"    EXP2 =~":a_cliente )~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"( ~~~"sog_commerciale~~~".~~~"tipo~~~"~"   OP =~"=~"    EXP2 =~"'C' )~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"( ~~~"documento~~~".~~~"data_registrazione~~~"~"   OP =~">=~"    EXP2 =~":da_data )~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"( ~~~"documento~~~".~~~"data_registrazione~~~"~"   OP =~"<=~"    EXP2 =~":a_data ) )~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"registro~~~".~~~"tipo_registro~~~"~"   OP =~"in~"    EXP2 =~"('IV','IC')~" )  GROUP(NAME=~"sog_commerciale.codice~") GROUP(NAME=~"anagrafica.rag_soc_1~") GROUP(NAME=~"cat_com_sc.codice~")) ARG(NAME = ~"da_cliente~" TYPE = string)  ARG(NAME = ~"a_cliente~" TYPE = string)  ARG(NAME = ~"parametri~" TYPE = string)  ARG(NAME = ~"iva~" TYPE = string)  ARG(NAME = ~"da_data~" TYPE = date)  ARG(NAME = ~"a_data~" TYPE = date) " arguments=(("da_cliente", string),("a_cliente", string),("parametri", string),("iva", string),("da_data", date),("a_data", date))  sort="cat_com_sc_codice A " )
