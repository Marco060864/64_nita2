 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"con_lis_articolo~" )  TABLE(NAME=~"destinazione~" )  TABLE(NAME=~"sog_commerciale_gen~" ALIAS=~"sog_commerciale_gen_a~" )  TABLE(NAME=~"sog_commerciale_gen~" ALIAS=~"sog_commerciale_gen_b~" )  TABLE(NAME=~"unita_confezione~" )  TABLE(NAME=~"articolo~" ALIAS=~"articolo_a~" )  TABLE(NAME=~"articolo~" ALIAS=~"articolo_b~" )  TABLE(NAME=~"anagrafica~" )  TABLE(NAME=~"sog_commerciale_gen~" ALIAS=~"sog_commerciale_gen_c~" ) COMPUTE(NAME=~"CAST( ~~~"sog_commerciale_gen_b~~~".~~~"codice~~~" AS CHAR(10) ) AS s_c_codice_1~") COMPUTE(NAME=~"CAST( ~~~"sog_commerciale_gen_b~~~".~~~"rag_soc_1~~~" AS CHAR(40) ) AS rag_soc_1~") COMPUTE(NAME=~"CAST(~~~"unita_confezione~~~".~~~"codice~~~" AS CHAR(10) ) AS u_c_codice~") COMPUTE(NAME=~"CAST(~~~"unita_confezione~~~".~~~"descrizione~~~" AS CHAR(40) ) AS u_c_descrizione~") COMPUTE(NAME=~"CAST(~~~"articolo_a~~~".~~~"codice~~~" AS CHAR(32) ) AS art_da_codice~") COMPUTE(NAME=~"CAST(~~~"articolo_a~~~".~~~"descrizione~~~" AS CHAR(40) ) AS art_da_descrizione~") COMPUTE(NAME=~"CAST(~~~"articolo_b~~~".~~~"codice~~~" AS CHAR(32) ) AS art_a_codice~") COMPUTE(NAME=~"CAST(~~~"articolo_b~~~".~~~"descrizione~~~" AS CHAR(40) ) AS art_a_descrizione~") COMPUTE(NAME=~"CAST(~~~"sog_commerciale_gen_c~~~".~~~"codice~~~" AS CHAR(10) ) AS codice_fornitore~") COMPUTE(NAME=~"CAST(~~~"sog_commerciale_gen_c~~~".~~~"rag_soc_1~~~" AS CHAR(40) ) AS descrizione_fornitore~") COMPUTE(NAME=~"CAST(~~~"anagrafica~~~".~~~"rag_soc_1~~~" AS CHAR(40) ) AS produttore~") COLUMN(NAME=~"con_lis_articolo.applicazione~") COLUMN(NAME=~"con_lis_articolo.data_inizio~") COLUMN(NAME=~"con_lis_articolo.data_fine~") COLUMN(NAME=~"con_lis_articolo.qta_minima~") COLUMN(NAME=~"con_lis_articolo.qta_massima~") COLUMN(NAME=~"con_lis_articolo.tipo_applicazione~") COLUMN(NAME=~"con_lis_articolo.cambio~") COLUMN(NAME=~"con_lis_articolo.importo~") COLUMN(NAME=~"con_lis_articolo.percentuali~") COLUMN(NAME=~"con_lis_articolo.spesa~") COLUMN(NAME=~"con_lis_articolo.spesa_fissa~") COLUMN(NAME=~"con_lis_articolo.priorita~") COMPUTE(NAME=~"CAST( (~~~"sog_commerciale_gen_a~~~".~~~"rag_soc_1~~~" || ' - ' || ~~~"destinazione~~~".~~~"rag_soc_1~~~" || ' - ' || ~~~"destinazione~~~".~~~"indirizzo~~~") AS CHAR(50)) AS c_destinazione_des~") COLUMN(NAME=~"con_lis_articolo.id_cat_com_sc~") COLUMN(NAME=~"con_lis_articolo.id_cat_com_articolo~") COLUMN(NAME=~"con_lis_articolo.id_listino~") COLUMN(NAME=~"con_lis_articolo.id_valuta~") COLUMN(NAME=~"con_lis_articolo.tras_mezzo~") COLUMN(NAME=~"con_lis_articolo.id_tipo_trasporto~")    JOIN (LEFT=~"destinazione.id_destinazione~"    OP =~"=~"RIGHT=~"con_lis_articolo.id_destinazione~"    OUTER2 =~"con_lis_articolo.id_destinazione~" )    JOIN (LEFT=~"destinazione.id_sog_commerciale~"    OP =~"=~"RIGHT=~"sog_commerciale_gen_a.id_sog_commerciale~"    OUTER1 =~"destinazione.id_sog_commerciale~" )    JOIN (LEFT=~"con_lis_articolo.id_sog_commerciale~"    OP =~"=~"RIGHT=~"sog_commerciale_gen_b.id_sog_commerciale~"    OUTER1 =~"con_lis_articolo.id_sog_commerciale~" )    JOIN (LEFT=~"unita_confezione.id_unita_confezione~"    OP =~"=~"RIGHT=~"con_lis_articolo.id_unita_confezione~"    OUTER2 =~"con_lis_articolo.id_unita_confezione~" )    JOIN (LEFT=~"articolo_a.id_articolo~"    OP =~"=~"RIGHT=~"con_lis_articolo.id_art_da~"    OUTER2 =~"con_lis_articolo.id_art_da~" )    JOIN (LEFT=~"con_lis_articolo.id_art_a~"    OP =~"=~"RIGHT=~"articolo_b.id_articolo~"    OUTER1 =~"con_lis_articolo.id_art_a~" )    JOIN (LEFT=~"anagrafica.id_anagrafica~"    OP =~"=~"RIGHT=~"con_lis_articolo.id_anagrafica~"    OUTER2 =~"con_lis_articolo.id_anagrafica~" )    JOIN (LEFT=~"con_lis_articolo.id_sog_commerciale_fornitore~"    OP =~"=~"RIGHT=~"sog_commerciale_gen_c.id_sog_commerciale~"    OUTER1 =~"con_lis_articolo.id_sog_commerciale_fornitore~" )) ORDER(NAME=~"con_lis_articolo.priorita~" ASC=yes ) " )
