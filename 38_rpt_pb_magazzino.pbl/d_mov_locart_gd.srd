 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"documento~" )  TABLE(NAME=~"sog_commerciale_gen~" )  TABLE(NAME=~"riga_documento~" )  TABLE(NAME=~"articolo~" )  TABLE(NAME=~"unita_confezione~" )  TABLE(NAME=~"caus_magazzino~" )  TABLE(NAME=~"locazione~" )  TABLE(NAME=~"magazzino~" )  TABLE(NAME=~"valuta~" )  TABLE(NAME=~"area~" ) COLUMN(NAME=~"documento.data_documento~") COLUMN(NAME=~"documento.num_documento~") COLUMN(NAME=~"sog_commerciale_gen.codice~") COLUMN(NAME=~"sog_commerciale_gen.rag_soc_1~") COLUMN(NAME=~"articolo.codice~") COLUMN(NAME=~"articolo.des_breve~") COLUMN(NAME=~"unita_confezione.codice~") COLUMN(NAME=~"unita_confezione.descrizione~") COLUMN(NAME=~"caus_magazzino.codice~") COLUMN(NAME=~"caus_magazzino.descrizione~") COLUMN(NAME=~"unita_confezione.unita_base~") COLUMN(NAME=~"riga_documento.prezzo_netto~") COLUMN(NAME=~"riga_documento.tot_riga_val_az~") COLUMN(NAME=~"magazzino.codice~") COLUMN(NAME=~"valuta.cambio~") COMPUTE(NAME=~"CAST(FN_TIPO_MOVIMENTO(~~~"riga_documento~~~".~~~"id_caus_magazzino~~~", 'P') AS CHAR(2)) AS tipo_movimento~") COMPUTE(NAME=~"~~~"magazzino~~~".~~~"descrizione~~~" + ' (' + ~~~"magazzino~~~".~~~"codice~~~" + ') - ' + ~~~"area~~~".~~~"codice~~~" + ' - ' + ~~~"locazione~~~".~~~"corsia~~~" + ' - ' + ~~~"locazione~~~".~~~"scaffale~~~" + ' - ' + ~~~"locazione~~~".~~~"ripiano~~~" + ' - ' + ~~~"locazione~~~".~~~"posizione~~~" As c_locazione_mag~") COLUMN(NAME=~"riga_documento.descrizione~") COMPUTE(NAME=~"CAST( ( SELECT fn_segno_movimento(tipo_movimento) ) AS INTEGER ) AS segno_movimento~") COLUMN(NAME=~"riga_documento.qta_un_base~") COLUMN(NAME=~"articolo.descrizione~")    JOIN (LEFT=~"sog_commerciale_gen.id_sog_commerciale~"    OP =~"=~"RIGHT=~"documento.id_sog_commerciale~" )    JOIN (LEFT=~"articolo.id_articolo~"    OP =~"=~"RIGHT=~"riga_documento.id_articolo~" )    JOIN (LEFT=~"unita_confezione.id_unita_confezione~"    OP =~"=~"RIGHT=~"riga_documento.id_unita_confezione~" )    JOIN (LEFT=~"caus_magazzino.id_caus_magazzino~"    OP =~"=~"RIGHT=~"riga_documento.id_caus_magazzino~" )    JOIN (LEFT=~"magazzino.id_magazzino~"    OP =~"=~"RIGHT=~"locazione.id_magazzino~" )    JOIN (LEFT=~"valuta.id_valuta~"    OP =~"=~"RIGHT=~"riga_documento.id_valuta~" )    JOIN (LEFT=~"locazione.id_locazione~"    OP =~"=~"RIGHT=~"riga_documento.id_locazione_1~" )    JOIN (LEFT=~"riga_documento.id_documento~"    OP =~"=~"RIGHT=~"documento.id_documento~" )    JOIN (LEFT=~"area.id_area~"    OP =~"=~"RIGHT=~"locazione.id_area~" )WHERE(    EXP1 =~"~~~"riga_documento~~~".~~~"id_locazione_1~~~"~"   OP =~"is not~"    EXP2 =~"NULL~" ) )    UNION (PBSELECT( VERSION(400) TABLE(NAME=~"documento~" )  TABLE(NAME=~"sog_commerciale_gen~" )  TABLE(NAME=~"riga_documento~" )  TABLE(NAME=~"articolo~" )  TABLE(NAME=~"unita_confezione~" )  TABLE(NAME=~"caus_magazzino~" )  TABLE(NAME=~"locazione~" )  TABLE(NAME=~"magazzino~" )  TABLE(NAME=~"valuta~" )  TABLE(NAME=~"area~" ) COLUMN(NAME=~"documento.data_documento~") COLUMN(NAME=~"documento.num_documento~") COLUMN(NAME=~"sog_commerciale_gen.codice~") COLUMN(NAME=~"sog_commerciale_gen.rag_soc_1~") COLUMN(NAME=~"articolo.codice~") COLUMN(NAME=~"articolo.des_breve~") COLUMN(NAME=~"unita_confezione.codice~") COLUMN(NAME=~"unita_confezione.descrizione~") COLUMN(NAME=~"caus_magazzino.codice~") COLUMN(NAME=~"caus_magazzino.descrizione~") COLUMN(NAME=~"unita_confezione.unita_base~") COLUMN(NAME=~"riga_documento.prezzo_netto~") COLUMN(NAME=~"riga_documento.tot_riga_val_az~") COLUMN(NAME=~"magazzino.codice~") COLUMN(NAME=~"valuta.cambio~") COMPUTE(NAME=~"CAST(FN_TIPO_MOVIMENTO(~~~"riga_documento~~~".~~~"id_caus_magazzino~~~", 'D') AS CHAR(2)) AS tipo_movimento~") COMPUTE(NAME=~"~~~"magazzino~~~".~~~"descrizione~~~" + ' (' + ~~~"magazzino~~~".~~~"codice~~~" + ') - ' + ~~~"area~~~".~~~"codice~~~" + ' - ' + ~~~"locazione~~~".~~~"corsia~~~" + ' - ' + ~~~"locazione~~~".~~~"scaffale~~~" + ' - ' + ~~~"locazione~~~".~~~"ripiano~~~" + ' - ' + ~~~"locazione~~~".~~~"posizione~~~" As c_locazione_mag~") COLUMN(NAME=~"riga_documento.descrizione~") COMPUTE(NAME=~"CAST( ( SELECT fn_segno_movimento(tipo_movimento) ) AS INTEGER ) AS segno_movimento~") COLUMN(NAME=~"riga_documento.qta_un_base~") COLUMN(NAME=~"articolo.descrizione~")    JOIN (LEFT=~"sog_commerciale_gen.id_sog_commerciale~"    OP =~"=~"RIGHT=~"documento.id_sog_commerciale~" )    JOIN (LEFT=~"articolo.id_articolo~"    OP =~"=~"RIGHT=~"riga_documento.id_articolo~" )    JOIN (LEFT=~"unita_confezione.id_unita_confezione~"    OP =~"=~"RIGHT=~"riga_documento.id_unita_confezione~" )    JOIN (LEFT=~"caus_magazzino.id_caus_magazzino~"    OP =~"=~"RIGHT=~"riga_documento.id_caus_magazzino~" )    JOIN (LEFT=~"magazzino.id_magazzino~"    OP =~"=~"RIGHT=~"locazione.id_magazzino~" )    JOIN (LEFT=~"valuta.id_valuta~"    OP =~"=~"RIGHT=~"riga_documento.id_valuta~" )    JOIN (LEFT=~"riga_documento.id_documento~"    OP =~"=~"RIGHT=~"documento.id_documento~" )    JOIN (LEFT=~"locazione.id_locazione~"    OP =~"=~"RIGHT=~"riga_documento.id_locazione_2~" )    JOIN (LEFT=~"area.id_area~"    OP =~"=~"RIGHT=~"locazione.id_area~" )WHERE(    EXP1 =~"~~~"riga_documento~~~".~~~"id_locazione_2~~~"~"   OP =~"is not~"    EXP2 =~"NULL~" ) )) ARG(NAME = ~"parametri~" TYPE = string)  ARG(NAME = ~"parita_euro~" TYPE = number)  ARG(NAME = ~"cifra_arrotondamento_E~" TYPE = number)  ARG(NAME = ~"tipo_arrotondamento_E~" TYPE = string) " arguments=(("parametri", string),("parita_euro", number),("cifra_arrotondamento_E", number),("tipo_arrotondamento_E", string)) )
