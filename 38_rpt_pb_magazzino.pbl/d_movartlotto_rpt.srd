 column=(type=decimal(4) updatewhereclause=yes name=riga_documento_tot_riga_val_riga_v dbname="riga_documento_tot_riga_val_riga_v" )
 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"lotto~" )  TABLE(NAME=~"riga_doc_lotto~" )  TABLE(NAME=~"riga_documento~" )  TABLE(NAME=~"documento~" )  TABLE(NAME=~"articolo~" )  TABLE(NAME=~"valuta~" )  TABLE(NAME=~"v_movimenti~" ) COLUMN(NAME=~"lotto.cod_esterno~") COLUMN(NAME=~"documento.data_documento~") COLUMN(NAME=~"articolo.codice~") COLUMN(NAME=~"articolo.des_breve~") COLUMN(NAME=~"riga_documento.quantita~") COLUMN(NAME=~"riga_documento.peso_netto~") COLUMN(NAME=~"riga_documento.prezzo~") COLUMN(NAME=~"riga_documento.tot_riga_val_az~") COLUMN(NAME=~"riga_documento.id_valuta~") COLUMN(NAME=~"valuta.cambio~") COLUMN(NAME=~"documento.id_documento~") COLUMN(NAME=~"v_movimenti.pd~") COMPUTE(NAME=~"CAST(fn_tipo_movimento(~~~"riga_documento~~~".~~~"id_caus_magazzino~~~",~~~"v_movimenti~~~".~~~"pd~~~") AS CHAR(2)) AS tipo_movimento~") COMPUTE(NAME=~"CAST((SELECT SUM(R.IMP_PROVV_DOCUMENTO) FROM RIEP_PROV_RIGHE R, RIEP_PROVVIGIONI T , RIGA_DOCUMENTO D WHERE T.ID_DOCUMENTO = D.ID_DOCUMENTO AND R.ID_RIEP_PROVVIGIONI = T.ID_RIEP_PROVVIGIONI AND D.ID_RIGA_DOC_PROVENIENZA = ~~~"riga_documento~~~".~~~"id_riga_documento~~~") AS NUMERIC(18,4)) AS imp_provvigioni~") COMPUTE(NAME=~"CAST( fn_conv_valuta( ~~~"documento~~~".~~~"id_valuta~~~", imp_provvigioni, :rn_id_valuta) AS DECIMAL(18,4) ) AS imp_provvigioni_v~") COMPUTE(NAME=~"CAST( fn_conv_valuta( ~~~"riga_documento~~~".~~~"id_valuta~~~", ~~~"riga_documento~~~".~~~"prezzo~~~" , :rn_id_valuta) AS DECIMAL(18,4) ) AS riga_documento_prezzo_v~") COMPUTE(NAME=~"CAST( ( SELECT id_val_euro FROM par_sistema) AS INTEGER) AS id_val_euro~") COMPUTE(NAME=~"CAST ( fn_conv_valuta( ~~~"riga_documento~~~".~~~"id_valuta~~~", ~~~"riga_documento~~~".~~~"tot_riga_val_riga~~~", :rn_id_valuta) AS DECIMAL(18,4) ) AS riga_documento_tot_riga_val_riga_v~")    JOIN (LEFT=~"riga_doc_lotto.id_lotto~"    OP =~"=~"RIGHT=~"lotto.id_lotto~" )    JOIN (LEFT=~"riga_documento.id_riga_lotto~"    OP =~"=~"RIGHT=~"riga_doc_lotto.id_riga_lotto~" )    JOIN (LEFT=~"riga_documento.id_documento~"    OP =~"=~"RIGHT=~"riga_doc_lotto.id_doc~" )    JOIN (LEFT=~"documento.id_documento~"    OP =~"=~"RIGHT=~"riga_documento.id_documento~" )    JOIN (LEFT=~"articolo.id_articolo~"    OP =~"=~"RIGHT=~"riga_documento.id_articolo~" )    JOIN (LEFT=~"valuta.id_valuta~"    OP =~"=~"RIGHT=~"riga_documento.id_valuta~" )    JOIN (LEFT=~"v_movimenti.id_documento~"    OP =~"=~"RIGHT=~"documento.id_documento~" )    JOIN (LEFT=~"v_movimenti.id_riga_documento~"    OP =~"=~"RIGHT=~"riga_documento.id_riga_documento~" )) ARG(NAME = ~"parametri~" TYPE = string)  ARG(NAME = ~"parita_euro~" TYPE = number)  ARG(NAME = ~"con_promozione~" TYPE = number)  ARG(NAME = ~"spese_varie~" TYPE = number)  ARG(NAME = ~"rn_id_valuta~" TYPE = number) " arguments=(("parametri", string),("parita_euro", number),("con_promozione", number),("spese_varie", number),("rn_id_valuta", number)) )
