 retrieve="  SELECT  Cast('' as char(20)) As c_articolo_cod,           Cast('' as char(80)) As c_articolo_des,           Cast('' as char(1)) As c_unita_conf_tipo_conversione,           Cast(0 as decimal) As c_unita_conf_molteplicita,           Cast(0 as integer) As c_arrot,           ~"riga_documento~".~"id_riga_documento~" ,           ~"riga_documento~".~"id_documento~" ,           ~"riga_documento~".~"num_riga~" ,           ~"riga_documento~".~"id_articolo~" ,           ~"riga_documento~".~"descrizione~" ,           ~"riga_documento~".~"id_des_articolo~" ,           ~"riga_documento~".~"id_unita_confezione~" ,           ~"riga_documento~".~"quantita~" ,           ~"riga_documento~".~"qta_sconto_merce~" ,           ~"riga_documento~".~"qta_evasa~" ,           ~"riga_documento~".~"fat_con_unita_base~" ,           ~"riga_documento~".~"fat_con_globale~" ,           ~"riga_documento~".~"qta_un_base~" ,           ~"riga_documento~".~"qta_evasa_un_base~" ,           ~"riga_documento~".~"id_caus_magazzino~" ,           ~"riga_documento~".~"id_locazione_1~" ,           ~"riga_documento~".~"id_locazione_2~" ,           ~"riga_documento~".~"id_valuta~" ,           ~"riga_documento~".~"cambio~" ,           ~"riga_documento~".~"id_listino~" ,           ~"riga_documento~".~"id_con_lis_articolo~" ,           ~"riga_documento~".~"prezzo~" ,           ~"riga_documento~".~"sconto~" ,           ~"riga_documento~".~"prezzo_netto~" ,           ~"riga_documento~".~"sconto_riga~" ,           ~"riga_documento~".~"data_prevista_consegna~" ,           ~"riga_documento~".~"peso_netto~" ,           ~"riga_documento~".~"peso_lordo~" ,           ~"riga_documento~".~"dim_l~" ,           ~"riga_documento~".~"dim_h~" ,           ~"riga_documento~".~"dim_p~" ,           ~"riga_documento~".~"num_colli~" ,           ~"riga_documento~".~"id_tab_iva~" ,           ~"riga_documento~".~"provv_agente~" ,           ~"riga_documento~".~"id_gruppo_agenti~" ,           ~"riga_documento~".~"val_attribuito~" ,           ~"riga_documento~".~"id_caus_trasporto~" ,           ~"riga_documento~".~"forza_chius_evasione~" ,           ~"riga_documento~".~"sospesa~" ,           ~"riga_documento~".~"da_stampare~" ,           ~"riga_documento~".~"data_inizio_competenza~" ,           ~"riga_documento~".~"data_fine_competenza~" ,           ~"riga_documento~".~"tot_riga_val_riga~" ,           ~"riga_documento~".~"tot_riga_val_doc~" ,           ~"riga_documento~".~"tot_riga_val_az~" ,           ~"riga_documento~".~"id_riga_doc_provenienza~" ,           ~"riga_documento~".~"id_conto~" ,           ~"riga_documento~".~"id_azienda~" ,           ~"riga_documento~".~"provv_subage~" ,           ~"riga_documento~".~"provv_carea~" ,           ~"unita_misura_a~".~"simbolo~" ,           ~"unita_misura_a~".~"descrizione~" ,           ~"articolo~".~"stato~" ,           cast(0 as numeric(18,4)) as cmc,           ~"unita_misura_b~".~"simbolo~" ,           ~"unita_misura_b~".~"descrizione~" ,           ~"unita_misura_a~".~"conversione~" ,           ~"unita_misura_b~".~"conversione~" ,           cast(0 as numeric(18,4)) as costo_ultimo,           cast(0 as numeric(18,4)) as costo_medio,           cast(null as integer) as ric1,           cast(null as integer) as ric2,           ~"riga_documento~".~"id_riga_doc_padre~" ,           ~"riga_documento~".~"provv_imp_agente~" ,           ~"riga_documento~".~"provv_imp_subage~" ,           ~"riga_documento~".~"provv_imp_carea~" ,           ~"unita_misura_c~".~"tipo~" ,           ~"sog_commerciale_gen~".~"rag_soc_1~" ,           ~"articolo~".~"prod_interna~" ,           ~"articolo~".~"id_sog_commerciale~" ,           ~"riga_documento~".~"ordinato_fo~" ,           ~"riga_documento~".~"qta_ordinata_fo~" ,           ~"riga_documento~".~"id_riga_lotto~" ,           ~"des_articolo~".~"codice~" ,           ~"des_articolo~".~"descrizione~" ,           ~"des_articolo~".~"des_estesa~" ,           ~"riga_documento~".~"id_gruppo_agenti_2~" ,           ~"riga_documento~".~"provv_agente_2~" ,           ~"riga_documento~".~"provv_subage_2~" ,           ~"riga_documento~".~"provv_carea_2~" ,           ~"riga_documento~".~"provv_imp_agente_2~" ,           ~"riga_documento~".~"provv_imp_subage_2~" ,           ~"riga_documento~".~"provv_imp_carea_2~" ,           Cast(0 as numeric(18,4)) As c_esistenza,           Cast(0 as numeric(18,4)) As c_disponibilita,           cast(0 as numeric(18,4)) as esistenza_fisica 
        FROM {oj {oj {oj {oj ~"unita_confezione~"  LEFT OUTER JOIN ~"unita_misura~" unita_misura_a  ON ~"unita_confezione~".~"id_unita_mis_peso~" = ~"unita_misura_a~".~"id_unita_misura~"} LEFT OUTER JOIN ~"unita_misura~" unita_misura_b  ON ~"unita_confezione~".~"id_unita_mis_volume~" = ~"unita_misura_b~".~"id_unita_misura~"} LEFT OUTER JOIN ~"unita_misura~" unita_misura_c  ON ~"unita_confezione~".~"id_unita_misura~" = ~"unita_misura_c~".~"id_unita_misura~"}, {oj ~"riga_documento~"  LEFT OUTER JOIN ~"unita_confezione~"  ON ~"riga_documento~".~"id_unita_confezione~" = ~"unita_confezione~".~"id_unita_confezione~"}, {oj ~"riga_documento~"  LEFT OUTER JOIN ~"articolo~"  ON ~"riga_documento~".~"id_articolo~" = ~"articolo~".~"id_articolo~"} LEFT OUTER JOIN ~"sog_commerciale_gen~"  ON ~"articolo~".~"id_sog_commerciale~" = ~"sog_commerciale_gen~".~"id_sog_commerciale~"}, {oj ~"riga_documento~"  LEFT OUTER JOIN ~"des_articolo~"  ON ~"riga_documento~".~"id_des_articolo~" = ~"des_articolo~".~"id_des_articolo~"}     
        WHERE ( ~"riga_documento~".~"id_documento~" = :ra_id_documento ) and          ( ~"riga_documento~".~"id_azienda~" in (0,1) )   " arguments=(("ra_id_documento", number))  sort="rag_soc_1 A id_documento A id_articolo A " )
