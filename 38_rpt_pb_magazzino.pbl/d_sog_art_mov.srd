 column=(type=char(16) updatewhereclause=yes name=par_iva dbname="sog_commerciale_gen.par_iva" )
 column=(type=decimal(4) updatewhereclause=yes name=tot_riga_val_riga dbname="riga_documento.tot_riga_val_riga" )
 column=(type=char(8) updatewhereclause=yes name=codice_prof dbname="prof_documento.codice" )
 column=(type=char(32) updatewhereclause=yes name=codice dbname="articolo.codice" )
 column=(type=char(1) updatewhereclause=yes name=tipo_fattura dbname="prof_documento.tipo_fattura" )
 column=(type=decimal(4) updatewhereclause=yes name=riga_documento_prezzo_netto dbname="riga_documento.prezzo_netto" )
 retrieve="  SELECT ~"documento~".~"num_documento~",   
         ~"documento~".~"data_documento~",   
         ~"prof_documento~".~"descrizione~",   
         ~"prof_documento~".~"des_stampa~",   
         ~"riga_documento~".~"quantita~",   
         ~"riga_documento~".~"prezzo~",   
         ~"riga_documento~".~"peso_netto~",   
         ~"riga_documento~".~"peso_lordo~",   
         ~"articolo~".~"descrizione~",   
         ~"sog_commerciale_gen~".~"rag_soc_1~",   
         ~"sog_commerciale_gen~".~"rag_soc_2~",   
         ~"sog_commerciale_gen~".~"indirizzo~",   
         ~"sog_commerciale_gen~".~"cap~",   
         ~"sog_commerciale_gen~".~"localita~",   
         ~"sog_commerciale_gen~".~"provincia~",   
         ~"sog_commerciale_gen~".~"nazione~",   
         ~"sog_commerciale_gen~".~"cod_fiscale~",   
         ~"sog_commerciale_gen~".~"par_iva~",   
         ~"riga_documento~".~"tot_riga_val_riga~",   
         ~"prof_documento~".~"codice~",   
         ~"articolo~".~"codice~",   
         ~"prof_documento~".~"tipo_fattura~",   
         ~"riga_documento~".~"prezzo_netto~"  
    FROM {oj ~"riga_documento~"  LEFT OUTER JOIN ~"articolo~"  ON ~"riga_documento~".~"id_articolo~" = ~"articolo~".~"id_articolo~"},   
         ~"documento~",   
         ~"prof_documento~",   
         ~"sog_commerciale_gen~",   
         ~"registro~"  
   WHERE ( ~"riga_documento~".~"id_documento~" = ~"documento~".~"id_documento~" ) and  
         ( ~"documento~".~"id_prof_documento~" = ~"prof_documento~".~"id_prof_documento~" ) and  
         ( ~"documento~".~"id_sog_commerciale~" = ~"sog_commerciale_gen~".~"id_sog_commerciale~" ) and  
         ( ~"registro~".~"id_registro~" = ~"documento~".~"id_registro~" ) and  
         ( ( ~"registro~".~"tipo_registro~" = 'IV' or ~"registro~".~"tipo_registro~" = 'IC' ) AND  
         (~"sog_commerciale_gen~".~"codice~" >= :rs_da_codice AND  
         ~"sog_commerciale_gen~".~"codice~" <= :rs_a_codice) AND  
         (~"articolo~".~"codice~" >= :da_art AND  
         ~"articolo~".~"codice~" <= :a_art) AND  
         (~"documento~".~"data_documento~" >= :da_data AND  
         ~"documento~".~"data_documento~" <= :a_data) )    
" arguments=(("rs_da_codice", string),("rs_a_codice", string),("da_art", string),("a_art", string),("da_data", date),("a_data", date))  sort="rag_soc_1 A codice A " )
