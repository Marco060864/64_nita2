//objectcomments FRANCESCO 18/09/98  Stampa delle esistenze di magazzino
release 5;
datawindow(units=0 timer_interval=0 color=16777215 processing=0 print.documentname="" print.orientation = 1 print.margin.left = 110 print.margin.right = 110 print.margin.top = 97 print.margin.bottom = 97 print.paper.source = 0 print.paper.size = 0 print.prompt=no )
header(height=509 color="536870912" )
summary(height=5 color="536870912" )
footer(height=81 color="536870912" )
detail(height=1 color="536870912" )
table(column=(type=char(32) updatewhereclause=yes name=articolo_codice dbname="articolo.codice" )
 column=(type=char(80) updatewhereclause=yes name=articolo_descrizione dbname="articolo.descrizione" )
 column=(type=decimal(4) updatewhereclause=yes name=riepilogo_qta_caricata dbname="riepilogo.qta_caricata" )
 column=(type=decimal(4) updatewhereclause=yes name=riepilogo_qta_scaricata dbname="riepilogo.qta_scaricata" )
 column=(type=date updatewhereclause=yes name=esercizio_data_inizio dbname="esercizio.data_inizio" )
 column=(type=date updatewhereclause=yes name=esercizio_data_fine dbname="esercizio.data_fine" )
 column=(type=decimal(4) updatewhereclause=yes name=riepilogo_qta_rim_iniziale dbname="riepilogo.qta_rim_iniziale" )
 column=(type=char(8) updatewhereclause=yes name=magazzino_codice dbname="magazzino.codice" )
 column=(type=char(40) updatewhereclause=yes name=magazzino_descrizione dbname="magazzino.descrizione" )
 column=(type=char(40) updatewhereclause=yes name=anagrafica_rag_soc_1 dbname="anagrafica.rag_soc_1" )
 column=(type=decimal(4) updatewhereclause=yes name=riepilogo_qta_vis_clienti dbname="riepilogo.qta_vis_clienti" )
 column=(type=decimal(4) updatewhereclause=yes name=riepilogo_qta_vis_fornitori dbname="riepilogo.qta_vis_fornitori" )
 column=(type=char(255) updatewhereclause=yes name=cparametri dbname="parametri" )
 retrieve="  SELECT ~"articolo~".~"codice~",   
         ~"articolo~".~"descrizione~",   
         ~"riepilogo~".~"qta_caricata~",   
         ~"riepilogo~".~"qta_scaricata~",   
         ~"esercizio~".~"data_inizio~",   
         ~"esercizio~".~"data_fine~",   
         ~"riepilogo~".~"qta_rim_iniziale~",   
         ~"magazzino~".~"codice~",   
         ~"magazzino~".~"descrizione~",   
         ~"anagrafica~".~"rag_soc_1~",   
         ~"riepilogo~".~"qta_vis_clienti~",   
         ~"riepilogo~".~"qta_vis_fornitori~",
			cast(:parametri as char(255))as parametri 
 
    FROM {oj ~"articolo~"  LEFT OUTER JOIN ~"anagrafica~"  ON ~"articolo~".~"id_anagrafica~" = ~"anagrafica~".~"id_anagrafica~"},   
         ~"esercizio~",   
         ~"magazzino~",   
         ~"riepilogo~",   
         ~"locazione~"  
   WHERE ( ~"riepilogo~".~"id_esercizio~" = ~"esercizio~".~"id_esercizio~" ) and  
         ( ~"riepilogo~".~"id_articolo~" = ~"articolo~".~"id_articolo~" ) and  
         ( ~"locazione~".~"id_locazione~" = ~"riepilogo~".~"id_locazione~" ) and  
         ( ~"locazione~".~"id_magazzino~" = ~"magazzino~".~"id_magazzino~" ) and 
         ( ~"esercizio~".~"id_esercizio~" = :esercizio )AND  
         ( ~"riepilogo~".~"anno~" <= :anno_fine ) AND  
         ( ~"riepilogo~".~"mese~" <= :mese_fine ) AND  
         ( ~"articolo~".~"codice~" >= :da_articolo ) AND  
         ( ~"articolo~".~"codice~" <= :a_articolo ) AND  
         (( ~"anagrafica~".~"rag_soc_1~" >= :da_produttore ) or (~"anagrafica~".~"rag_soc_1~" IS NULL))AND  
         (( ~"anagrafica~".~"rag_soc_1~" <= :a_produttore ) or (~"anagrafica~".~"rag_soc_1~" IS NULL))AND  
         ( ~"magazzino~".~"codice~" >= :da_magazzino ) AND  
         ( ~"magazzino~".~"codice~" <= :a_magazzino )
	  
" arguments=(("esercizio", number),("mese_fine", number),("anno_fine", number),("da_articolo", string),("a_articolo", string),("da_produttore", string),("a_produttore", string),("da_magazzino", string),("a_magazzino", string),("parametri", string))  sort="magazzino_codice A articolo_codice A " )
