 column=(type=char(30) updatewhereclause=yes name=ordinamento dbname="ordinamento" values="Articolo	A/Cat. Commerciale	C/Cat. Merceologica	M/Cat. Fiscale	F/" )
 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"unita_confezione~" )  TABLE(NAME=~"unita_misura~" )  TABLE(NAME=~"articolo~" )  TABLE(NAME=~"tab_iva~" )  TABLE(NAME=~"cat_com_articolo~" )  TABLE(NAME=~"cat_merceologica~" )  TABLE(NAME=~"cat_fiscale~" ) COLUMN(NAME=~"articolo.codice~") COLUMN(NAME=~"articolo.des_breve~") COLUMN(NAME=~"unita_misura.simbolo~") COLUMN(NAME=~"tab_iva.des_breve~") COMPUTE(NAME=~"CAST((SELECT ~~~"prezzo~~~" FROM ~~~"prezzo~~~" WHERE ~~~"id_variazione~~~" = :rl_id_variazione AND ~~~"id_unita_confezione~~~" = ~~~"unita_confezione~~~".~~~"id_unita_confezione~~~") AS FLOAT(4)) AS prezzo~") COMPUTE(NAME=~"CAST((SELECT ~~~"valuta~~~".~~~"descrizione~~~" FROM ~~~"valuta~~~", ~~~"variazione~~~", ~~~"listino~~~" WHERE ~~~"variazione~~~".~~~"id_variazione~~~" = :rl_id_variazione AND ~~~"listino~~~".~~~"id_listino~~~" = ~~~"variazione~~~".~~~"id_listino~~~" AND ~~~"valuta~~~".~~~"id_valuta~~~" = ~~~"listino~~~".~~~"id_valuta~~~") AS CHAR) AS Valuta~") COMPUTE(NAME=~"CAST (:parametri as char(255)) as parametri~") COMPUTE(NAME=~"CAST(:rs_da_codice as char(32)) as da_articolo~") COMPUTE(NAME=~"CAST(:rs_a_codice as char(32)) as a_articolo~") COLUMN(NAME=~"cat_com_articolo.codice~") COLUMN(NAME=~"unita_confezione.codice~") COLUMN(NAME=~"unita_confezione.descrizione~") COLUMN(NAME=~"cat_merceologica.codice~") COLUMN(NAME=~"cat_fiscale.codice~") COMPUTE(NAME=~"CAST(:ordinamento as Char(30)) as ordinamento~")    JOIN (LEFT=~"unita_confezione.id_unita_misura~"    OP =~"=~"RIGHT=~"unita_misura.id_unita_misura~"    OUTER1 =~"unita_confezione.id_unita_misura~" )    JOIN (LEFT=~"articolo.id_tab_iva~"    OP =~"=~"RIGHT=~"tab_iva.id_tab_iva~"    OUTER1 =~"articolo.id_tab_iva~" )    JOIN (LEFT=~"cat_merceologica.id_cat_merceologica~"    OP =~"=~"RIGHT=~"articolo.id_cat_merceologica~"    OUTER2 =~"articolo.id_cat_merceologica~" )    JOIN (LEFT=~"cat_fiscale.id_cat_fiscale~"    OP =~"=~"RIGHT=~"articolo.id_cat_fiscale~"    OUTER2 =~"articolo.id_cat_fiscale~" )    JOIN (LEFT=~"unita_confezione.id_articolo~"    OP =~"=~"RIGHT=~"articolo.id_articolo~" )    JOIN (LEFT=~"cat_com_articolo.id_cat_com_articolo~"    OP =~"=~"RIGHT=~"articolo.id_cat_com_articolo~" )WHERE(    EXP1 =~"~~~"articolo~~~".~~~"codice~~~"~"   OP =~">=~"    EXP2 =~":rs_da_codice~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"articolo~~~".~~~"codice~~~"~"   OP =~"<=~"    EXP2 =~":rs_a_codice~" ) ) ARG(NAME = ~"rl_id_variazione~" TYPE = number)  ARG(NAME = ~"rs_da_codice~" TYPE = string)  ARG(NAME = ~"rs_a_codice~" TYPE = string)  ARG(NAME = ~"parametri~" TYPE = string)  ARG(NAME = ~"ordinamento~" TYPE = string)  ARG(NAME = ~"cifra_arrotondamento~" TYPE = number)  ARG(NAME = ~"tipo_arrotondamento~" TYPE = string)  ARG(NAME = ~"az_rag_soc_1~" TYPE = string) " filter=" prezzo_valuta  > 0" arguments=(("rl_id_variazione", number),("rs_da_codice", string),("rs_a_codice", string),("parametri", string),("ordinamento", string),("cifra_arrotondamento", number),("tipo_arrotondamento", string),("az_rag_soc_1", string)) )
