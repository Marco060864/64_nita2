 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"articolo~" )  TABLE(NAME=~"unita_misura~" )  TABLE(NAME=~"riepilogo~" )  TABLE(NAME=~"locazione~" )  TABLE(NAME=~"magazzino~" )  TABLE(NAME=~"valuta~" )  TABLE(NAME=~"par_sistema~" )  TABLE(NAME=~"azienda~" )  TABLE(NAME=~"unita_confezione~" ) COLUMN(NAME=~"articolo.codice~") COLUMN(NAME=~"articolo.des_breve~") COLUMN(NAME=~"unita_misura.simbolo~") COMPUTE(NAME=~"cast(:parametri as char(255))as parametri~") COLUMN(NAME=~"riepilogo.ult_costo~") COLUMN(NAME=~"riepilogo.data_ult_costo~") COMPUTE(NAME=~"dateformat(:data,'dd/mm/yyyy')~") COLUMN(NAME=~"magazzino.codice~") COLUMN(NAME=~"magazzino.descrizione~") COLUMN(NAME=~"riepilogo.qta_caricata~") COLUMN(NAME=~"riepilogo.val_caricato~") COLUMN(NAME=~"valuta.parita_euro~") COLUMN(NAME=~"locazione.id_locazione~") COLUMN(NAME=~"articolo.id_articolo~") COLUMN(NAME=~"azienda.id_attivita~") COMPUTE(NAME=~"month(:data)~") COMPUTE(NAME=~"year(:data)~") COMPUTE(NAME=~"CAST((SELECT IfNull((Sum(Riepilogo.Qta_Caricata)*:li_car_fiscali), 0, Sum(Riepilogo.Qta_Caricata)*:li_car_fiscali) +IfNull((Sum(Riepilogo.Qta_Scaricata)*:li_sca_fiscali), 0, Sum(Riepilogo.Qta_Scaricata)*:li_sca_fiscali) + IfNull((Sum(Riepilogo.Qta_Ord_Clienti)*:li_ord_clienti), 0, Sum(Riepilogo.Qta_Ord_Clienti)*:li_ord_clienti) +	IfNull((Sum(Riepilogo.Qta_Ord_Fornitori)*:li_ord_fornitori), 0, Sum(Riepilogo.Qta_Ord_Fornitori)*:li_ord_fornitori) + IfNull((Sum(Riepilogo.Qta_Vis_Clienti)*:li_vis_clienti), 0, Sum(Riepilogo.Qta_Vis_Clienti)*:li_vis_clienti) + IfNull((Sum(Riepilogo.Qta_Vis_Fornitori)*:li_vis_fornitori), 0, Sum(Riepilogo.Qta_Vis_Fornitori)*+:li_vis_fornitori) + IfNull((Sum(Riepilogo.Qta_Imp_Produzione)*:li_imp_produzione), 0, Sum(Riepilogo.Qta_Imp_Produzione)*:li_imp_produzione)+ IfNull((Sum(Riepilogo.Qta_Ord_Produzione)*:li_ord_produzione), 0, Sum(Riepilogo.Qta_Ord_Produzione)*:li_ord_produzione)+ IfNull((Sum(Riepilogo.Qta_CL_Clienti)*:li_cl_clienti), 0, Sum(Riepilogo.Qta_CL_Clienti)*:li_cl_clienti)+IfNull((Sum(Riepilogo.Qta_CL_Fornitori)*:li_cl_fornitori), 0, Sum(Riepilogo.Qta_CL_Fornitori)*:li_cl_fornitori)+IfNull((Sum(Riepilogo.Qta_Gruppo_Lib_1)*:li_gr_lib_1), 0, Sum(Riepilogo.Qta_Gruppo_Lib_1)*:li_gr_lib_1) + IfNull((Sum(Riepilogo.Qta_Gruppo_Lib_2)*:li_gr_lib_2), 0, Sum(Riepilogo.Qta_Gruppo_Lib_2)*:li_gr_lib_2) +	IfNull((Sum(Riepilogo.Qta_Gruppo_Lib_3)*:li_gr_lib_3), 0, Sum(Riepilogo.Qta_Gruppo_Lib_3)*:li_gr_lib_3)+IfNull((Sum(Riepilogo.Qta_Gruppo_Lib_4)*:li_gr_lib_4), 0, Sum(Riepilogo.Qta_Gruppo_Lib_4)*:li_gr_lib_4)	FROM 	riepilogo WHERE 	riepilogo.id_attivita = ~~~"azienda~~~".~~~"id_attivita~~~" AND riepilogo.id_articolo = ~~~"articolo~~~".~~~"id_articolo~~~" AND riepilogo.anno <= year(:data) AND riepilogo.mese <= month(:data) AND riepilogo.id_locazione IN (SELECT id_locazione FROM locazione WHERE id_magazzino=~~~"magazzino~~~".~~~"id_magazzino~~~"      )                   ) AS decimal(4)) AS esi_attuale~")    JOIN (LEFT=~"articolo.id_articolo~"    OP =~"=~"RIGHT=~"riepilogo.id_articolo~" )    JOIN (LEFT=~"locazione.id_locazione~"    OP =~"=~"RIGHT=~"riepilogo.id_locazione~" )    JOIN (LEFT=~"magazzino.id_magazzino~"    OP =~"=~"RIGHT=~"locazione.id_magazzino~" )    JOIN (LEFT=~"valuta.id_valuta~"    OP =~"=~"RIGHT=~"par_sistema.id_val_lire~" )    JOIN (LEFT=~"unita_confezione.id_articolo~"    OP =~"=~"RIGHT=~"articolo.id_articolo~" )    JOIN (LEFT=~"unita_misura.id_unita_misura~"    OP =~"=~"RIGHT=~"unita_confezione.id_unita_misura~" )WHERE(    EXP1 =~"~~~"riepilogo~~~".~~~"data_ult_costo~~~"~"   OP =~"is not~"    EXP2 =~"null~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"riepilogo~~~".~~~"mese~~~"~"   OP =~"<=~"    EXP2 =~"month(:data)~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"riepilogo~~~".~~~"anno~~~"~"   OP =~"<=~"    EXP2 =~"year(:data)~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"azienda~~~".~~~"id_azienda~~~"~"   OP =~"=~"    EXP2 =~"1~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"unita_confezione~~~".~~~"unita_base~~~"~"   OP =~"=~"    EXP2 =~"'S'~" ) ) ARG(NAME = ~"parametri~" TYPE = string)  ARG(NAME = ~"data~" TYPE = date)  ARG(NAME = ~"costo~" TYPE = string)  ARG(NAME = ~"li_car_fiscali~" TYPE = number)  ARG(NAME = ~"li_sca_fiscali~" TYPE = number)  ARG(NAME = ~"li_ord_clienti~" TYPE = number)  ARG(NAME = ~"li_ord_fornitori~" TYPE = number)  ARG(NAME = ~"li_vis_clienti~" TYPE = number)  ARG(NAME = ~"li_vis_fornitori~" TYPE = number)  ARG(NAME = ~"li_imp_produzione~" TYPE = number)  ARG(NAME = ~"li_ord_produzione~" TYPE = number)  ARG(NAME = ~"li_cl_clienti~" TYPE = number)  ARG(NAME = ~"li_cl_fornitori~" TYPE = number)  ARG(NAME = ~"li_gr_lib_1~" TYPE = number)  ARG(NAME = ~"li_gr_lib_2~" TYPE = number)  ARG(NAME = ~"li_gr_lib_3~" TYPE = number)  ARG(NAME = ~"li_gr_lib_4~" TYPE = number) " arguments=(("parametri", string),("data", date),("costo", string),("li_car_fiscali", number),("li_sca_fiscali", number),("li_ord_clienti", number),("li_ord_fornitori", number),("li_vis_clienti", number),("li_vis_fornitori", number),("li_imp_produzione", number),("li_ord_produzione", number),("li_cl_clienti", number),("li_cl_fornitori", number),("li_gr_lib_1", number),("li_gr_lib_2", number),("li_gr_lib_3", number),("li_gr_lib_4", number))  sort="ccodice A articolo_codice A cdata_ult_costo D " )
