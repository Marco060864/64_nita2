 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"documento~" )  TABLE(NAME=~"sog_commerciale_gen~" )  TABLE(NAME=~"riga_documento~" )  TABLE(NAME=~"articolo~" )  TABLE(NAME=~"unita_confezione~" )  TABLE(NAME=~"caus_magazzino~" )  TABLE(NAME=~"unita_misura~" )  TABLE(NAME=~"registro~" )  TABLE(NAME=~"prof_documento~" ) COLUMN(NAME=~"documento.data_documento~") COLUMN(NAME=~"documento.num_documento~") COLUMN(NAME=~"sog_commerciale_gen.codice~") COLUMN(NAME=~"sog_commerciale_gen.rag_soc_1~") COLUMN(NAME=~"articolo.codice~") COLUMN(NAME=~"articolo.des_breve~") COLUMN(NAME=~"unita_confezione.codice~") COLUMN(NAME=~"unita_confezione.descrizione~") COLUMN(NAME=~"caus_magazzino.codice~") COLUMN(NAME=~"caus_magazzino.descrizione~") COLUMN(NAME=~"unita_confezione.unita_base~") COLUMN(NAME=~"riga_documento.prezzo_netto~") COLUMN(NAME=~"riga_documento.tot_riga_val_az~") COLUMN(NAME=~"riga_documento.descrizione~") COLUMN(NAME=~"riga_documento.qta_un_base~") COMPUTE(NAME=~"CAST(FN_TIPO_MOVIMENTO(~~~"riga_documento~~~".~~~"id_caus_magazzino~~~", 'P') AS CHAR(2)) AS tipo_movimento~") COLUMN(NAME=~"unita_misura.tipo~") COLUMN(NAME=~"riga_documento.peso_netto~") COLUMN(NAME=~"riga_documento.quantita~") COLUMN(NAME=~"riga_documento.id_riga_documento~") COLUMN(NAME=~"articolo.descrizione~") COMPUTE(NAME=~"CAST(( SELECT quantita FROM contatori_registri WHERE id_registro=9999) AS DECIMAL(18,4)) AS DEPOSITO_INIZIALE~") COMPUTE(NAME=~"CAST( ( SELECT fn_segno_causale_2(tipo_movimento) ) AS INTEGER ) AS segno_movimento~") COLUMN(NAME=~"registro.tipo_registro~") COLUMN(NAME=~"caus_magazzino.mp_car_fiscali~") COLUMN(NAME=~"caus_magazzino.mp_scar_fiscali~") COMPUTE(NAME=~"CAST( FN_DEPOSITO_FINALE(:a_data,1,1000000,1,1000000,1,1000,~~~"registro~~~".~~~"id_mod_registro~~~",~~~"unita_misura~~~".~~~"tipo~~~") AS DECIMAL(18,4)) AS DEPOSITO_FINALE~") COLUMN(NAME=~"prof_documento.descrizione~")    JOIN (LEFT=~"sog_commerciale_gen.id_sog_commerciale~"    OP =~"=~"RIGHT=~"documento.id_sog_commerciale~" )    JOIN (LEFT=~"articolo.id_articolo~"    OP =~"=~"RIGHT=~"riga_documento.id_articolo~" )    JOIN (LEFT=~"unita_confezione.id_unita_confezione~"    OP =~"=~"RIGHT=~"riga_documento.id_unita_confezione~" )    JOIN (LEFT=~"caus_magazzino.id_caus_magazzino~"    OP =~"=~"RIGHT=~"riga_documento.id_caus_magazzino~" )    JOIN (LEFT=~"riga_documento.id_documento~"    OP =~"=~"RIGHT=~"documento.id_documento~" )    JOIN (LEFT=~"unita_misura.id_unita_misura~"    OP =~"=~"RIGHT=~"unita_confezione.id_unita_misura~" )    JOIN (LEFT=~"registro.id_registro~"    OP =~"=~"RIGHT=~"documento.id_registro~" )    JOIN (LEFT=~"prof_documento.id_prof_documento~"    OP =~"=~"RIGHT=~"documento.id_prof_documento~" )WHERE(    EXP1 =~"(~~~"documento~~~".~~~"data_documento~~~"~"   OP =~">=~"    EXP2 =~":da_data )~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"( ~~~"documento~~~".~~~"data_documento~~~"~"   OP =~"<=~"    EXP2 =~":a_data )~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"registro~~~".~~~"id_mod_registro~~~"~"   OP =~"=~"    EXP2 =~":rd_mod_reg~" ) ) ARG(NAME = ~"da_data~" TYPE = date)  ARG(NAME = ~"a_data~" TYPE = date)  ARG(NAME = ~"rd_mod_reg~" TYPE = number) " arguments=(("da_data", date),("a_data", date),("rd_mod_reg", number))  sort="documento_data_documento A " )
