 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"scorta~" )  TABLE(NAME=~"per_scorta~" )  TABLE(NAME=~"riepilogo~" )  TABLE(NAME=~"articolo~" )  TABLE(NAME=~"unita_confezione~" ) COLUMN(NAME=~"riepilogo.id_esercizio~") COLUMN(NAME=~"riepilogo.id_attivita~") COLUMN(NAME=~"riepilogo.id_articolo~") COLUMN(NAME=~"riepilogo.id_locazione~") COMPUTE(NAME=~"Cast(0 as decimal) As c_esistenza~") COMPUTE(NAME=~"Cast(0 as decimal) As c_esistenza_fisica~") COMPUTE(NAME=~"Cast(0 as decimal) As c_disponibilita~") COLUMN(NAME=~"articolo.codice~") COLUMN(NAME=~"articolo.descrizione~") COLUMN(NAME=~"unita_confezione.id_unita_confezione~") COLUMN(NAME=~"scorta.scorta_minima~") COLUMN(NAME=~"scorta.id_per_scorta~") COLUMN(NAME=~"per_scorta.giorno_inizio~") COLUMN(NAME=~"per_scorta.mese_inizio~") COLUMN(NAME=~"per_scorta.giorno_fine~") COLUMN(NAME=~"per_scorta.mese_fine~") COLUMN(NAME=~"scorta.scorta_massima~") COLUMN(NAME=~"riepilogo.qta_ord_clienti~") COLUMN(NAME=~"riepilogo.qta_ord_fornitori~") COLUMN(NAME=~"articolo.id_sog_commerciale~") COMPUTE(NAME=~"cast(0 as decimal) as c_ordinato~")    JOIN (LEFT=~"scorta.id_per_scorta~"    OP =~"=~"RIGHT=~"per_scorta.id_per_scorta~"    OUTER1 =~"scorta.id_per_scorta~" )    JOIN (LEFT=~"unita_confezione.id_unita_confezione~"    OP =~"=~"RIGHT=~"scorta.id_unita_confezione~" )    JOIN (LEFT=~"articolo.id_articolo~"    OP =~"=~"RIGHT=~"riepilogo.id_articolo~" )    JOIN (LEFT=~"unita_confezione.id_articolo~"    OP =~"=~"RIGHT=~"articolo.id_articolo~" )WHERE(    EXP1 =~"(~~~"articolo~~~".~~~"codice~~~"~"   OP =~"<=~"    EXP2 =~":a_articolo~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"articolo~~~".~~~"codice~~~"~"   OP =~">=~"    EXP2 =~":da_articolo)~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"riepilogo~~~".~~~"id_esercizio~~~"~"   OP =~"=~"    EXP2 =~":esercizio~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"riepilogo~~~".~~~"id_attivita~~~"~"   OP =~"=~"    EXP2 =~":attivita~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"riepilogo~~~".~~~"anno~~~"~"   OP =~"=~"    EXP2 =~":anno~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"riepilogo~~~".~~~"mese~~~"~"   OP =~"=~"    EXP2 =~":mese~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"unita_confezione~~~".~~~"unita_base~~~"~"   OP =~"=~"    EXP2 =~"'S'~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"((((~~~"per_scorta~~~".~~~"giorno_inizio~~~"~"   OP =~"<=~"    EXP2 =~":giorno~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"per_scorta~~~".~~~"mese_inizio~~~"~"   OP =~"<=~"    EXP2 =~":mese)~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"(~~~"per_scorta~~~".~~~"giorno_fine~~~"~"   OP =~">=~"    EXP2 =~":giorno~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"per_scorta~~~".~~~"mese_fine~~~"~"   OP =~">=~"    EXP2 =~":mese))~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"scorta~~~".~~~"id_per_scorta~~~"~"   OP =~"is not~"    EXP2 =~"null)~"    LOGIC =~"or~" ) WHERE(    EXP1 =~"(~~~"scorta~~~".~~~"id_per_scorta~~~"~"   OP =~"is~"    EXP2 =~"null))~" ) ) ORDER(NAME=~"articolo.codice~" ASC=yes ) ARG(NAME = ~"a_articolo~" TYPE = string)  ARG(NAME = ~"da_articolo~" TYPE = string)  ARG(NAME = ~"anno~" TYPE = number)  ARG(NAME = ~"esercizio~" TYPE = number)  ARG(NAME = ~"attivita~" TYPE = number)  ARG(NAME = ~"mese~" TYPE = number)  ARG(NAME = ~"giorno~" TYPE = number) " arguments=(("a_articolo", string),("da_articolo", string),("anno", number),("esercizio", number),("attivita", number),("mese", number),("giorno", number)) )
