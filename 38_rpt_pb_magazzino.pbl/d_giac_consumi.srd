 column=(type=char(1) updatewhereclause=yes name=mp_scar_fiscali dbname="caus_magazzino.mp_scar_fiscali" )
 column=(type=date updatewhereclause=yes name=data_documento dbname="documento.data_documento" )
 column=(type=char(100) updatewhereclause=yes name=ret_esi_attuale dbname="ret_esi_attuale" )
 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"articolo~" )  TABLE(NAME=~"unita_confezione~" )  TABLE(NAME=~"unita_misura~" )  TABLE(NAME=~"caus_magazzino~" )  TABLE(NAME=~"documento~" )  TABLE(NAME=~"riga_documento~" ) COLUMN(NAME=~"articolo.codice~") COLUMN(NAME=~"articolo.des_breve~") COLUMN(NAME=~"articolo.id_articolo~") COLUMN(NAME=~"unita_misura.tipo~") COLUMN(NAME=~"unita_misura.simbolo~") COMPUTE(NAME=~"CAST( SUBSTRING(ret_esi_attuale, 1, 20) AS NUMERIC(18,4) ) AS esi_fisica_attuale~") COLUMN(NAME=~"riga_documento.quantita~") COLUMN(NAME=~"riga_documento.peso_netto~") COLUMN(NAME=~"caus_magazzino.mp_scar_fiscali~") COLUMN(NAME=~"documento.data_documento~") COMPUTE(NAME=~"CAST(fn_esi_disp2(1, ~~~"articolo~~~".~~~"id_articolo~~~", 0, year(:da_5),month(:da_5),0) AS CHAR(100)) AS ret_esi_attuale~")    JOIN (LEFT=~"articolo.id_articolo~"    OP =~"=~"RIGHT=~"unita_confezione.id_articolo~" )    JOIN (LEFT=~"unita_confezione.id_unita_misura~"    OP =~"=~"RIGHT=~"unita_misura.id_unita_misura~" )    JOIN (LEFT=~"articolo.id_articolo~"    OP =~"=~"RIGHT=~"riga_documento.id_articolo~" )    JOIN (LEFT=~"riga_documento.id_documento~"    OP =~"=~"RIGHT=~"documento.id_documento~" )    JOIN (LEFT=~"riga_documento.id_caus_magazzino~"    OP =~"=~"RIGHT=~"caus_magazzino.id_caus_magazzino~" )WHERE(    EXP1 =~"~~~"articolo~~~".~~~"codice~~~"~"   OP =~">=~"    EXP2 =~":da_articolo~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"articolo~~~".~~~"codice~~~"~"   OP =~"<=~"    EXP2 =~":a_articolo ~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"documento~~~".~~~"data_documento~~~"~"   OP =~">~"    EXP2 =~":da_1~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"(~~~"caus_magazzino~~~".~~~"mp_scar_fiscali~~~"~"   OP =~"=~"    EXP2 =~"'+'~"    LOGIC =~"or~" ) WHERE(    EXP1 =~"~~~"caus_magazzino~~~".~~~"mp_scar_fiscali~~~"~"   OP =~"=~"    EXP2 =~"'-')~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"documento~~~".~~~"data_documento~~~"~"   OP =~"<=~"    EXP2 =~":da_5~" ) ) ORDER(NAME=~"articolo.codice~" ASC=yes ) ARG(NAME = ~"da_articolo~" TYPE = string)  ARG(NAME = ~"a_articolo~" TYPE = string)  ARG(NAME = ~"da_1~" TYPE = datetime)  ARG(NAME = ~"da_2~" TYPE = datetime)  ARG(NAME = ~"da_3~" TYPE = datetime)  ARG(NAME = ~"da_4~" TYPE = datetime)  ARG(NAME = ~"da_5~" TYPE = datetime) " arguments=(("da_articolo", string),("a_articolo", string),("da_1", datetime),("da_2", datetime),("da_3", datetime),("da_4", datetime),("da_5", datetime))  sort="codice A " )
