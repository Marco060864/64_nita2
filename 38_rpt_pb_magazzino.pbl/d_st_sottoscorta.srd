 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"scorta~" )  TABLE(NAME=~"per_scorta~" )  TABLE(NAME=~"articolo~" )  TABLE(NAME=~"sog_commerciale_gen~" )  TABLE(NAME=~"unita_confezione~" )  TABLE(NAME=~"par_sistema~" )  TABLE(NAME=~"azienda~" )  TABLE(NAME=~"pers_par_sistema~" )  TABLE(NAME=~"unita_misura~" ) COLUMN(NAME=~"articolo.codice~") COLUMN(NAME=~"articolo.descrizione~") COLUMN(NAME=~"unita_confezione.id_unita_confezione~") COLUMN(NAME=~"scorta.scorta_minima~") COLUMN(NAME=~"scorta.id_per_scorta~") COLUMN(NAME=~"per_scorta.giorno_inizio~") COLUMN(NAME=~"per_scorta.mese_inizio~") COLUMN(NAME=~"per_scorta.giorno_fine~") COLUMN(NAME=~"per_scorta.mese_fine~") COLUMN(NAME=~"scorta.scorta_massima~") COLUMN(NAME=~"articolo.id_sog_commerciale~") COLUMN(NAME=~"sog_commerciale_gen.rag_soc_1~") COLUMN(NAME=~"articolo.id_articolo~") COLUMN(NAME=~"par_sistema.des_riep_gr1~") COLUMN(NAME=~"azienda.rag_soc_1~") COLUMN(NAME=~"pers_par_sistema.parigi~") COMPUTE(NAME=~"CAST( SUBSTRING(c_esi_disp, 1, 20) AS NUMERIC(18,4) ) AS c_esistenza_fisica~") COMPUTE(NAME=~"CAST(fn_esi_disp(1, ~~~"articolo~~~".~~~"id_articolo~~~", 0, 0, 0, 0) AS CHAR(100)) AS c_esi_disp~") COMPUTE(NAME=~"CAST( SUBSTRING(c_esi_disp, 21, 20) AS NUMERIC(18,4) ) AS c_esistenza~") COMPUTE(NAME=~"CAST( SUBSTRING(c_esi_disp, 41, 20) AS NUMERIC(18,4) ) AS c_disponibilita~") COMPUTE(NAME=~"CAST(TODAY(*) AS date) AS data_scadenza~") COMPUTE(NAME=~"CAST(0 AS NUMERIC(18,4) ) AS c_ordinato~") COMPUTE(NAME=~"CAST( SUBSTRING(c_ord_clifor, 21, 20) AS NUMERIC(18,4) ) AS qta_ord_fornitori~") COMPUTE(NAME=~"CAST( SUBSTRING(c_ord_clifor, 1, 20) AS NUMERIC(18,4) ) AS qta_ord_clienti~") COMPUTE(NAME=~"CAST(fn_gruppo_lib(1, ~~~"articolo~~~".~~~"id_articolo~~~", 0, 0, 0) AS NUMERIC(18,4)) AS c_gruppo_lib_1~") COMPUTE(NAME=~"CAST(fn_ordinato(1, ~~~"articolo~~~".~~~"id_articolo~~~", 0, 0, 0) AS CHAR(40)) AS c_ord_clifor~") COLUMN(NAME=~"unita_misura.n_decimali~")    JOIN (LEFT=~"scorta.id_per_scorta~"    OP =~"=~"RIGHT=~"per_scorta.id_per_scorta~"    OUTER1 =~"scorta.id_per_scorta~" )    JOIN (LEFT=~"articolo.id_sog_commerciale~"    OP =~"=~"RIGHT=~"sog_commerciale_gen.id_sog_commerciale~"    OUTER1 =~"articolo.id_sog_commerciale~" )    JOIN (LEFT=~"unita_misura.id_unita_misura~"    OP =~"=~"RIGHT=~"unita_confezione.id_unita_misura~"    OUTER2 =~"unita_confezione.id_unita_misura~" )   JOIN (LEFT=~"unita_confezione.id_unita_confezione~"    OP =~"=~"RIGHT=~"scorta.id_unita_confezione~" )    JOIN (LEFT=~"unita_confezione.id_articolo~"    OP =~"=~"RIGHT=~"articolo.id_articolo~" )    JOIN (LEFT=~"azienda.id_azienda~"    OP =~"=~"RIGHT=~"articolo.id_azienda~" ) WHERE(    EXP1 =~"(~~~"scorta~~~".~~~"id_magazzino~~~"~"   OP =~"=~"    EXP2 =~":rn_magazzino)~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"unita_confezione~~~".~~~"unita_base~~~"~"   OP =~"=~"    EXP2 =~"'S'~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"((((~~~"per_scorta~~~".~~~"giorno_inizio~~~"~"   OP =~"<=~"    EXP2 =~":giorno~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"per_scorta~~~".~~~"mese_inizio~~~"~"   OP =~"<=~"    EXP2 =~":mese)~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"(~~~"per_scorta~~~".~~~"giorno_fine~~~"~"   OP =~">=~"    EXP2 =~":giorno~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"per_scorta~~~".~~~"mese_fine~~~"~"   OP =~">=~"    EXP2 =~":mese))~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"scorta~~~".~~~"id_per_scorta~~~"~"   OP =~"is not~"    EXP2 =~"null)~"    LOGIC =~"or~" ) WHERE(    EXP1 =~"(~~~"scorta~~~".~~~"id_per_scorta~~~"~"   OP =~"is~"    EXP2 =~"null))~" ) ) ARG(NAME = ~"parametri~" TYPE = string)  ARG(NAME = ~"anno~" TYPE = number)  ARG(NAME = ~"mese~" TYPE = number)  ARG(NAME = ~"giorno~" TYPE = number)  ARG(NAME = ~"rn_magazzino~" TYPE = number) " arguments=(("parametri", string),("anno", number),("mese", number),("giorno", number),("rn_magazzino", number))  sort="articolo_codice A " )
