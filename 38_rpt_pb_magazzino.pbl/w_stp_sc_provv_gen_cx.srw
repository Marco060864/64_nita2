cb_ok cb_ok
cb_annulla cb_annulla
dw_1 dw_1
dw_2 dw_2
end type
global w_stp_sc_provv_gen_cx w_stp_sc_provv_gen_cx

type variables
date		id_data_registrazione
s_con_effetti	istr_struct
boolean		ib_feed_struct = FALSE

long il_id_esercizio
date il_data_da
date il_data_a
