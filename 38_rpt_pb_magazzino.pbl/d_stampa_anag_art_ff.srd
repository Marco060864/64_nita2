 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"articolo~" )  TABLE(NAME=~"cat_codifica~" )  TABLE(NAME=~"gruppo_articoli~" )  TABLE(NAME=~"cat_com_articolo~" )  TABLE(NAME=~"cat_merceologica~" )  TABLE(NAME=~"cat_fiscale~" )  TABLE(NAME=~"reparto~" )  TABLE(NAME=~"anagrafica~" )  TABLE(NAME=~"sog_commerciale_gen~" )  TABLE(NAME=~"tab_iva~" )  TABLE(NAME=~"valuta~" )  TABLE(NAME=~"cif~" )  TABLE(NAME=~"unita_confezione~" )  TABLE(NAME=~"unita_misura~" ALIAS=~"unita_misura_a~" )  TABLE(NAME=~"unita_misura~" ALIAS=~"unita_misura_b~" )  TABLE(NAME=~"unita_misura~" ALIAS=~"unita_misura_c~" ) COLUMN(NAME=~"articolo.codice~") COLUMN(NAME=~"articolo.descrizione~") COLUMN(NAME=~"cat_codifica.codice~") COLUMN(NAME=~"cat_codifica.descrizione~") COLUMN(NAME=~"articolo.rif_catalogo~") COLUMN(NAME=~"gruppo_articoli.codice~") COLUMN(NAME=~"gruppo_articoli.descrizione~") COLUMN(NAME=~"cat_com_articolo.codice~") COLUMN(NAME=~"cat_com_articolo.descrizione~") COLUMN(NAME=~"cat_merceologica.codice~") COLUMN(NAME=~"cat_merceologica.descrizione~") COLUMN(NAME=~"cat_fiscale.codice~") COLUMN(NAME=~"cat_fiscale.descrizione~") COLUMN(NAME=~"articolo.des_breve~") COLUMN(NAME=~"reparto.codice~") COLUMN(NAME=~"reparto.descrizione~") COLUMN(NAME=~"anagrafica.rag_soc_1~") COLUMN(NAME=~"sog_commerciale_gen.codice~") COLUMN(NAME=~"sog_commerciale_gen.rag_soc_1~") COLUMN(NAME=~"tab_iva.codice~") COLUMN(NAME=~"tab_iva.des_estesa~") COLUMN(NAME=~"articolo.cod_intrastat~") COLUMN(NAME=~"articolo.note~") COLUMN(NAME=~"articolo.utilizzabile~") COLUMN(NAME=~"articolo.stato~") COLUMN(NAME=~"valuta.codice~") COLUMN(NAME=~"valuta.descrizione~") COLUMN(NAME=~"articolo.costo_aggiuntivo~") COLUMN(NAME=~"cif.codice~") COLUMN(NAME=~"unita_confezione.codice~") COLUMN(NAME=~"unita_confezione.descrizione~") COLUMN(NAME=~"unita_confezione.molteplicita~") COLUMN(NAME=~"unita_confezione.qta_minima~") COLUMN(NAME=~"unita_confezione.qta_massima~") COLUMN(NAME=~"unita_confezione.num_colli~") COLUMN(NAME=~"unita_misura_b.descrizione~") COLUMN(NAME=~"unita_confezione.peso_netto~") COLUMN(NAME=~"unita_confezione.peso_lordo~") COLUMN(NAME=~"unita_misura_c.descrizione~") COLUMN(NAME=~"unita_confezione.dim_l~") COLUMN(NAME=~"unita_confezione.dim_p~") COLUMN(NAME=~"unita_confezione.dim_h~") COLUMN(NAME=~"unita_misura_a.descrizione~") COLUMN(NAME=~"unita_confezione.unita_base~") COMPUTE(NAME=~"cast(ifnull(unita_base,'N',unita_base)as char(1) )as unita_basec~") COMPUTE(NAME=~"cast(:ra_flag as char(1))as flag~") COLUMN(NAME=~"unita_confezione.id_unita_confezione~") COMPUTE(NAME=~"cast(:parametri as char(255))as parametri~")    JOIN (LEFT=~"cat_codifica.id_cat_codifica~"    OP =~"=~"RIGHT=~"articolo.id_cat_codifica~"    OUTER2 =~"articolo.id_cat_codifica~" )    JOIN (LEFT=~"gruppo_articoli.id_gruppo_articoli~"    OP =~"=~"RIGHT=~"articolo.id_gruppo_articoli~"    OUTER2 =~"articolo.id_gruppo_articoli~" )    JOIN (LEFT=~"cat_merceologica.id_cat_merceologica~"    OP =~"=~"RIGHT=~"articolo.id_cat_merceologica~"    OUTER2 =~"articolo.id_cat_merceologica~" )    JOIN (LEFT=~"cat_fiscale.id_cat_fiscale~"    OP =~"=~"RIGHT=~"articolo.id_cat_fiscale~"    OUTER2 =~"articolo.id_cat_fiscale~" )    JOIN (LEFT=~"reparto.id_reparto~"    OP =~"=~"RIGHT=~"articolo.id_reparto~"    OUTER2 =~"articolo.id_reparto~" )    JOIN (LEFT=~"anagrafica.id_anagrafica~"    OP =~"=~"RIGHT=~"articolo.id_anagrafica~"    OUTER2 =~"articolo.id_anagrafica~" )    JOIN (LEFT=~"sog_commerciale_gen.id_sog_commerciale~"    OP =~"=~"RIGHT=~"articolo.id_sog_commerciale~"    OUTER2 =~"articolo.id_sog_commerciale~" )    JOIN (LEFT=~"tab_iva.id_tab_iva~"    OP =~"=~"RIGHT=~"articolo.id_tab_iva~"    OUTER2 =~"articolo.id_tab_iva~" )    JOIN (LEFT=~"valuta.id_valuta~"    OP =~"=~"RIGHT=~"articolo.id_valuta~"    OUTER2 =~"articolo.id_valuta~" )    JOIN (LEFT=~"cif.id_cif~"    OP =~"=~"RIGHT=~"articolo.id_cif~"    OUTER2 =~"articolo.id_cif~" )    JOIN (LEFT=~"unita_misura_a.id_unita_misura~"    OP =~"=~"RIGHT=~"unita_confezione.id_unita_misura~"    OUTER2 =~"unita_confezione.id_unita_misura~" )    JOIN (LEFT=~"unita_misura_b.id_unita_misura~"    OP =~"=~"RIGHT=~"unita_confezione.id_unita_mis_peso~"    OUTER2 =~"unita_confezione.id_unita_mis_peso~" )    JOIN (LEFT=~"unita_misura_c.id_unita_misura~"    OP =~"=~"RIGHT=~"unita_confezione.id_unita_mis_volume~"    OUTER2 =~"unita_confezione.id_unita_mis_volume~" )    JOIN (LEFT=~"cat_com_articolo.id_cat_com_articolo~"    OP =~"=~"RIGHT=~"articolo.id_cat_com_articolo~" )    JOIN (LEFT=~"unita_confezione.id_articolo~"    OP =~"=~"RIGHT=~"articolo.id_articolo~" )WHERE(    EXP1 =~"~~~"articolo~~~".~~~"codice~~~"~"   OP =~">=~"    EXP2 =~":da_art~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"articolo~~~".~~~"codice~~~"~"   OP =~"<=~"    EXP2 =~":a_art~" ) ) ORDER(NAME=~"articolo.codice~" ASC=yes ) ARG(NAME = ~"ra_flag~" TYPE = string)  ARG(NAME = ~"parametri~" TYPE = string)  ARG(NAME = ~"da_art~" TYPE = string)  ARG(NAME = ~"a_art~" TYPE = string) " arguments=(("ra_flag", string),("parametri", string),("da_art", string),("a_art", string))  sort="articolo_codice A cunita_basec D unita_confezione_codice A " )
