 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"riepilogo~" )  TABLE(NAME=~"articolo~" )  TABLE(NAME=~"magazzino~" )  TABLE(NAME=~"locazione~" )  TABLE(NAME=~"par_sistema~" ) COLUMN(NAME=~"magazzino.codice~") COLUMN(NAME=~"riepilogo.anno~") COLUMN(NAME=~"riepilogo.mese~") COLUMN(NAME=~"articolo.codice~") COLUMN(NAME=~"riepilogo.qta_caricata~") COLUMN(NAME=~"riepilogo.qta_scaricata~") COLUMN(NAME=~"riepilogo.qta_cl_fornitori~") COLUMN(NAME=~"riepilogo.qta_gruppo_lib_1~") COLUMN(NAME=~"riepilogo.qta_gruppo_lib_2~") COLUMN(NAME=~"riepilogo.qta_gruppo_lib_3~") COLUMN(NAME=~"riepilogo.qta_gruppo_lib_4~") COLUMN(NAME=~"par_sistema.des_riep_gr1~") COLUMN(NAME=~"par_sistema.des_riep_gr3~") COLUMN(NAME=~"par_sistema.des_riep_gr2~") COLUMN(NAME=~"par_sistema.des_riep_gr4~")    JOIN (LEFT=~"articolo.id_articolo~"    OP =~"=~"RIGHT=~"riepilogo.id_articolo~" )    JOIN (LEFT=~"locazione.id_magazzino~"    OP =~"=~"RIGHT=~"magazzino.id_magazzino~" )    JOIN (LEFT=~"locazione.id_locazione~"    OP =~"=~"RIGHT=~"riepilogo.id_locazione~" )WHERE(    EXP1 =~" ( ~~~"articolo~~~".~~~"codice~~~"~"   OP =~">=~"    EXP2 =~":da_articolo )~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"( ~~~"articolo~~~".~~~"codice~~~"~"   OP =~"<=~"    EXP2 =~":a_articolo ) ~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"riepilogo~~~".~~~"anno~~~"~"   OP =~">=~"    EXP2 =~":da_anno~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"riepilogo~~~".~~~"anno~~~"~"   OP =~"<=~"    EXP2 =~":a_anno~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"magazzino~~~".~~~"codice~~~"~"   OP =~">=~"    EXP2 =~":da_mag~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"magazzino~~~".~~~"codice~~~"~"   OP =~"<=~"    EXP2 =~":a_mag~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"riepilogo~~~".~~~"mese~~~"~"   OP =~">=~"    EXP2 =~":da_mese~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"riepilogo~~~".~~~"mese~~~"~"   OP =~"<=~"    EXP2 =~":a_mese~" ) ) ARG(NAME = ~"da_articolo~" TYPE = string)  ARG(NAME = ~"a_articolo~" TYPE = string)  ARG(NAME = ~"da_mag~" TYPE = string)  ARG(NAME = ~"a_mag~" TYPE = string)  ARG(NAME = ~"da_anno~" TYPE = number)  ARG(NAME = ~"a_anno~" TYPE = number)  ARG(NAME = ~"da_mese~" TYPE = number)  ARG(NAME = ~"a_mese~" TYPE = number) " filter="(riepilogo_anno = a_anno and  riepilogo_mese >= da_mese and  riepilogo_mese<=a_mese)  or (riepilogo_anno <> a_anno and  riepilogo_mese >= 1 and  riepilogo_mese<=12)" arguments=(("da_articolo", string),("a_articolo", string),("da_mag", string),("a_mag", string),("da_anno", number),("a_anno", number),("da_mese", number),("a_mese", number))  sort="magazzino_codice A riepilogo_anno A riepilogo_mese A articolo_codice A " )
