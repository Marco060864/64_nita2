 column=(type=decimal(4) updatewhereclause=yes name=costo_medio_v dbname="costo_medio_v" )
 column=(type=decimal(4) updatewhereclause=yes name=esi_fiscale_v dbname="esi_fiscale_v" )
 column=(type=char(8) updatewhereclause=yes name=magazzino_codice dbname="valorizzazioni.codice" )
 column=(type=char(40) updatewhereclause=yes name=magazzino_descrizione dbname="valorizzazioni.descrizione" )
 column=(type=decimal(4) updatewhereclause=yes name=qta_raggiunta dbname="qta_raggiunta" )
 column=(type=date updatewhereclause=yes name=esercizio_data_inizio dbname="esercizio.data_inizio" )
 column=(type=char(100) updatewhereclause=yes name=esistenza dbname="esistenza" )
 column=(type=long updatewhereclause=yes name=id_val_euro dbname="id_val_euro" )
 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"valorizzazioni~" )  TABLE(NAME=~"esercizio~" )  TABLE(NAME=~"articolo~" )  TABLE(NAME=~"magazzino~" ) COLUMN(NAME=~"valorizzazioni.id_valorizzazioni~") COLUMN(NAME=~"valorizzazioni.id_esercizio~") COLUMN(NAME=~"valorizzazioni.id_attivita~") COLUMN(NAME=~"valorizzazioni.id_articolo~") COLUMN(NAME=~"valorizzazioni.id_magazzino~") COLUMN(NAME=~"valorizzazioni.cm_esercizio~") COLUMN(NAME=~"valorizzazioni.dif_car_scarico~") COLUMN(NAME=~"valorizzazioni.esi_fiscale~") COLUMN(NAME=~"articolo.codice~") COLUMN(NAME=~"articolo.des_breve~") COLUMN(NAME=~"esercizio.codice~") COMPUTE(NAME=~"CAST( (DATEFORMAT(~~~"esercizio~~~".~~~"data_inizio~~~", 'dd/mm/yyyy') + '   -   ' + DATEFORMAT(~~~"esercizio~~~".~~~"data_fine~~~", 'dd/mm/yyyy') ) AS CHAR(30)) AS per_esercizio~") COMPUTE(NAME=~"CAST(substr(esistenza, 41, 20) AS NUMERIC(18,4)) AS costo_medio_v~") COMPUTE(NAME=~"CAST(substr(esistenza, 21, 20) AS NUMERIC(18,4)) AS esi_fiscale_v~") COLUMN(NAME=~"magazzino.codice~") COLUMN(NAME=~"magazzino.descrizione~") COMPUTE(NAME=~"CAST( (SELECT SUM(v1.dif_car_scarico) FROM valorizzazioni v1, esercizio e1 WHERE v1.id_magazzino = ~~~"valorizzazioni~~~".~~~"id_magazzino~~~" AND v1.id_articolo = ~~~"valorizzazioni~~~".~~~"id_articolo~~~" AND e1.id_esercizio = v1.id_esercizio AND e1.data_inizio <= ~~~"esercizio~~~".~~~"data_inizio~~~") AS NUMERIC(18,4)) AS qta_raggiunta~") COLUMN(NAME=~"esercizio.data_inizio~") COMPUTE(NAME=~"fn_esistenza(1, ~~~"valorizzazioni~~~".~~~"id_articolo~~~", 0, YEAR(:data_val), MONTH(:data_val), :rn_id_valuta) AS esistenza~") COMPUTE(NAME=~"CAST( ( SELECT id_val_euro FROM par_sistema) AS INTEGER) AS id_val_euro~")    JOIN (LEFT=~"magazzino.id_magazzino~"    OP =~"=~"RIGHT=~"valorizzazioni.id_magazzino~"    OUTER2 =~"valorizzazioni.id_magazzino~" )    JOIN (LEFT=~"valorizzazioni.id_esercizio~"    OP =~"=~"RIGHT=~"esercizio.id_esercizio~" )    JOIN (LEFT=~"articolo.id_articolo~"    OP =~"=~"RIGHT=~"valorizzazioni.id_articolo~" )) ARG(NAME = ~"parametri~" TYPE = string)  ARG(NAME = ~"data_val~" TYPE = date)  ARG(NAME = ~"tipo_stampa~" TYPE = string)  ARG(NAME = ~"rn_id_valuta~" TYPE = number) " arguments=(("parametri", string),("data_val", date),("tipo_stampa", string),("rn_id_valuta", number)) )
