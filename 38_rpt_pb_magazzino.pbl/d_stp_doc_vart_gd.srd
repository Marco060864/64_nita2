 column=(type=decimal(4) updatewhereclause=yes name=valuta_parita_euro dbname="valuta.parita_euro" )
 column=(type=char(255) updatewhereclause=yes name=cparametri dbname="parametri" )
 column=(type=char(16) updatewhereclause=yes name=documento_num_documento dbname="documento.num_documento" )
 column=(type=date updatewhereclause=yes name=documento_data_documento dbname="documento.data_documento" )
 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"articolo~" )  TABLE(NAME=~"unita_confezione~" )  TABLE(NAME=~"documento~" )  TABLE(NAME=~"prof_documento~" )  TABLE(NAME=~"riga_documento~" )  TABLE(NAME=~"par_sistema~" )  TABLE(NAME=~"valuta~" ) COLUMN(NAME=~"articolo.codice~") COLUMN(NAME=~"articolo.descrizione~") COLUMN(NAME=~"unita_confezione.codice~") COLUMN(NAME=~"unita_confezione.descrizione~") COLUMN(NAME=~"riga_documento.quantita~") COLUMN(NAME=~"documento.cambio~") COLUMN(NAME=~"riga_documento.prezzo_netto~") COLUMN(NAME=~"riga_documento.tot_riga_val_az~") COLUMN(NAME=~"prof_documento.codice~") COLUMN(NAME=~"riga_documento.qta_evasa~") COLUMN(NAME=~"valuta.parita_euro~") COMPUTE(NAME=~"cast(:parametri as char (255))as parametri~") COLUMN(NAME=~"documento.num_documento~") COLUMN(NAME=~"documento.data_documento~")    JOIN (LEFT=~"unita_confezione.id_articolo~"    OP =~"=~"RIGHT=~"articolo.id_articolo~"    OUTER2 =~"articolo.id_articolo~" )    JOIN (LEFT=~"prof_documento.id_prof_documento~"    OP =~"=~"RIGHT=~"documento.id_prof_documento~" )    JOIN (LEFT=~"riga_documento.id_documento~"    OP =~"=~"RIGHT=~"documento.id_documento~" )    JOIN (LEFT=~"articolo.id_articolo~"    OP =~"=~"RIGHT=~"riga_documento.id_articolo~" )    JOIN (LEFT=~"valuta.id_valuta~"    OP =~"=~"RIGHT=~"par_sistema.id_val_lire~" )WHERE(    EXP1 =~"~~~"articolo~~~".~~~"codice~~~"~"   OP =~">=~"    EXP2 =~":da_art~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"articolo~~~".~~~"codice~~~"~"   OP =~"<=~"    EXP2 =~":a_art~" ) ) ARG(NAME = ~"ra_stato_r~" TYPE = string)  ARG(NAME = ~"parametri~" TYPE = string)  ARG(NAME = ~"da_art~" TYPE = string)  ARG(NAME = ~"a_art~" TYPE = string) " arguments=(("ra_stato_r", string),("parametri", string),("da_art", string),("a_art", string))  sort="articolo_codice A unita_confezione_codice A documento_data_documento A documento_num_documento A " )
