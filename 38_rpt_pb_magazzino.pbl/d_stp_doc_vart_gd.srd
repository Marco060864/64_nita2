 column=(type=char(40) updatewhereclause=yes name=unita_confezione_descrizione dbname="unita_confezione.descrizione" )
 column=(type=decimal(4) updatewhereclause=yes name=riga_documento_quantita dbname="riga_documento.quantita" )
