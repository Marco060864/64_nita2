text(band=footer alignment="1" text="alle"border="0" color="0" x="494" y="28" height="64" width="82"  font.face="Arial" font.height="-8" font.weight="400"  font.family="2" font.pitch="2" font.charset="0" font.italic="1" background.mode="1" background.color="536870912" )
