release 6;
datawindow(units=0 timer_interval=0 color=16777215 processing=0 print.documentname="" print.orientation = 0 print.margin.left = 110 print.margin.right = 110 print.margin.top = 96 print.margin.bottom = 96 print.paper.source = 0 print.paper.size = 0 print.prompt=no print.buttons=no print.preview.buttons=no )
header(height=564 color="536870912" )
summary(height=4 color="536870912" )
footer(height=104 color="536870912" )
detail(height=4 color="536870912" )
table(column=(type=long update=yes updatewhereclause=yes identity=yes name=id_valorizzazioni dbname="valorizzazioni.id_valorizzazioni" )
 column=(type=long update=yes updatewhereclause=yes name=id_esercizio dbname="valorizzazioni.id_esercizio" )
 column=(type=long update=yes updatewhereclause=yes name=id_attivita dbname="valorizzazioni.id_attivita" )
 column=(type=long update=yes updatewhereclause=yes name=id_articolo dbname="valorizzazioni.id_articolo" )
 column=(type=long update=yes updatewhereclause=yes name=id_magazzino dbname="valorizzazioni.id_magazzino" )
 column=(type=decimal(4) update=yes updatewhereclause=yes name=cm_esercizio dbname="valorizzazioni.cm_esercizio" )
 column=(type=decimal(4) update=yes updatewhereclause=yes name=dif_car_scarico dbname="valorizzazioni.dif_car_scarico" )
 column=(type=decimal(4) update=yes updatewhereclause=yes name=esi_fiscale dbname="valorizzazioni.esi_fiscale" )
 column=(type=char(32) updatewhereclause=yes name=articolo_codice dbname="articolo.codice" )
 column=(type=char(40) updatewhereclause=yes name=articolo_des_breve dbname="articolo.des_breve" )
 column=(type=char(4) updatewhereclause=yes name=esercizio_codice dbname="esercizio.codice" )
 column=(type=char(30) updatewhereclause=yes name=per_esercizio dbname="per_esercizio" )
 column=(type=decimal(4) updatewhereclause=yes name=costo_medio_v dbname="costo_medio_v" )
 column=(type=decimal(4) updatewhereclause=yes name=esi_fiscale_v dbname="esi_fiscale_v" )
 column=(type=char(8) updatewhereclause=yes name=magazzino_codice dbname="magazzino.codice" )
 column=(type=char(40) updatewhereclause=yes name=magazzino_descrizione dbname="magazzino.descrizione" )
 column=(type=char(100) updatewhereclause=yes name=esistenza dbname="esistenza" )
 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"valorizzazioni~" )  TABLE(NAME=~"esercizio~" )  TABLE(NAME=~"articolo~" )  TABLE(NAME=~"magazzino~" ) COLUMN(NAME=~"valorizzazioni.id_valorizzazioni~") COLUMN(NAME=~"valorizzazioni.id_esercizio~") COLUMN(NAME=~"valorizzazioni.id_attivita~") COLUMN(NAME=~"valorizzazioni.id_articolo~") COLUMN(NAME=~"valorizzazioni.id_magazzino~") COLUMN(NAME=~"valorizzazioni.cm_esercizio~") COLUMN(NAME=~"valorizzazioni.dif_car_scarico~") COLUMN(NAME=~"valorizzazioni.esi_fiscale~") COLUMN(NAME=~"articolo.codice~") COLUMN(NAME=~"articolo.des_breve~") COLUMN(NAME=~"esercizio.codice~") COMPUTE(NAME=~"CAST( (DATEFORMAT(~~~"esercizio~~~".~~~"data_inizio~~~", 'dd/mm/yyyy') + '   -   ' + DATEFORMAT(~~~"esercizio~~~".~~~"data_fine~~~", 'dd/mm/yyyy') ) AS CHAR(30)) AS per_esercizio~") COMPUTE(NAME=~"CAST(substr(esistenza, 41, 20) AS NUMERIC(18,4)) AS costo_medio_v~") COMPUTE(NAME=~"CAST(substr(esistenza, 21, 20) AS NUMERIC(18,4)) AS esi_fiscale_v~") COLUMN(NAME=~"magazzino.codice~") COLUMN(NAME=~"magazzino.descrizione~") COMPUTE(NAME=~"fn_esistenza(1, ~~~"valorizzazioni~~~".~~~"id_articolo~~~", 0, YEAR(:data_val), MONTH(:data_val), :rn_id_valuta) AS esistenza~")    JOIN (LEFT=~"magazzino.id_magazzino~"    OP =~"=~"RIGHT=~"valorizzazioni.id_magazzino~"    OUTER2 =~"valorizzazioni.id_magazzino~" )    JOIN (LEFT=~"valorizzazioni.id_esercizio~"    OP =~"=~"RIGHT=~"esercizio.id_esercizio~" )    JOIN (LEFT=~"articolo.id_articolo~"    OP =~"=~"RIGHT=~"valorizzazioni.id_articolo~" )) ARG(NAME = ~"parametri~" TYPE = string)  ARG(NAME = ~"data_val~" TYPE = date)  ARG(NAME = ~"tipo_stampa~" TYPE = string)  ARG(NAME = ~"rn_id_valuta~" TYPE = number) " arguments=(("parametri", string),("data_val", date),("tipo_stampa", string),("rn_id_valuta", number)) )
group(level=1 header.height=180 trailer.height=208 by=("magazzino_codice" , "articolo_codice" ) header.color="536870912" trailer.color="536870912" )
compute(band=header alignment="0" expression="parametri"border="0" color="0" x="503" y="444" height="68" width="2889" format="[general]"  name=parametri  font.face="Arial" font.height="-8" font.weight="400"  font.family="2" font.pitch="2" font.charset="0" font.italic="1" background.mode="1" background.color="536870912" )
line(band=header x1="0" y1="552" x2="3397" y2="552" pen.style="0" pen.width="5" pen.color="0"  background.mode="2" background.color="16777215" )
text(band=header.1 alignment="2" text="Valore"border="2" color="0" x="1275" y="44" height="120" width="549"  font.face="Arial" font.height="-8" font.weight="700"  font.family="2" font.pitch="2" font.charset="0" background.mode="1" background.color="536870912" )
rectangle(band=header.1 x="1275" y="44" height="120" width="549" brush.hatch="7" brush.color="553648127" pen.style="0" pen.width="9" pen.color="33554432"  background.mode="2" background.color="0" )
compute(band=trailer.1 alignment="1" expression="sum(  ( cm_esercizio *  dif_car_scarico ) for group 1 )"border="0" color="0" x="1275" y="24" height="68" width="549" format="~tf_valu_mask(  rn_id_valuta ) // BL#15064#"  font.face="Arial" font.height="-8" font.weight="700"  font.family="2" font.pitch="2" font.charset="0" background.mode="1" background.color="553648127" )
compute(band=trailer.1 alignment="1" expression="sum(  ( cm_esercizio *  dif_car_scarico ) for group 1 ) / 1936.27"border="0" color="0" x="1275" y="120" height="68" width="549" format="#,0.00"  font.face="Arial" font.height="-8" font.weight="700"  font.family="2" font.pitch="2" font.charset="0" background.mode="1" background.color="553648127" )
text(band=trailer.1 alignment="1" text="Totale:"border="0" color="0" x="1070" y="24" height="68" width="169"  font.face="Arial" font.height="-8" font.weight="700"  font.family="2" font.pitch="2" font.charset="0" background.mode="2" background.color="16777215" )
text(band=trailer.1 alignment="1" text="Totale (E):"border="0" color="0" x="992" y="124" height="68" width="247"  font.face="Arial" font.height="-8" font.weight="700"  font.family="2" font.pitch="2" font.charset="0" background.mode="2" background.color="16777215" )
line(band=footer x1="0" y1="8" x2="3397" y2="8" pen.style="0" pen.width="5" pen.color="0"  background.mode="2" background.color="16777215" )
text(band=footer alignment="1" text="Stampato il "border="0" color="0" x="5" y="28" height="64" width="265"  font.face="Arial" font.height="-8" font.weight="400"  font.family="2" font.pitch="2" font.charset="0" font.italic="1" background.mode="1" background.color="536870912" )
