table(column=(type=char(32) updatewhereclause=yes name=codice dbname="articolo.codice" )
 column=(type=char(40) updatewhereclause=yes name=des_breve dbname="articolo.des_breve" )
 column=(type=char(5) updatewhereclause=yes name=unita_misura_simbolo dbname="unita_misura.simbolo" )
 column=(type=decimal(4) updatewhereclause=yes name=cvalore_iniziale dbname="valore_iniziale" )
 column=(type=decimal(4) updatewhereclause=yes name=cvalore_attuale dbname="valore_attuale" )
 column=(type=decimal(4) updatewhereclause=yes name=cesi_fiscale_iniziale dbname="esi_fiscale_iniziale" )
 column=(type=decimal(4) updatewhereclause=yes name=cesi_fiscale_attuale dbname="esi_fiscale_attuale" )
 column=(type=char(100) updatewhereclause=yes name=cesi_iniziale dbname="esi_iniziale" )
 column=(type=decimal(4) updatewhereclause=yes name=cultimo_costo_iniziale dbname="ultimo_costo_iniziale" )
 column=(type=char(100) updatewhereclause=yes name=cesi_attuale dbname="esi_attuale" )
 column=(type=decimal(4) updatewhereclause=yes name=cultimo_costo_attuale dbname="ultimo_costo_attuale" )
 column=(type=long updatewhereclause=yes name=id_val_euro dbname="id_val_euro" )
 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"articolo~" )  TABLE(NAME=~"unita_confezione~" )  TABLE(NAME=~"unita_misura~" ) COLUMN(NAME=~"articolo.codice~") COLUMN(NAME=~"articolo.des_breve~") COLUMN(NAME=~"unita_misura.simbolo~") COMPUTE(NAME=~"CAST((esi_fiscale_iniziale * ultimo_costo_iniziale) AS NUMERIC(18,4)) AS valore_iniziale~") COMPUTE(NAME=~"CAST((esi_fiscale_attuale * ultimo_costo_attuale) AS NUMERIC(18,4)) AS valore_attuale~") COMPUTE(NAME=~"CAST(SUBSTR(esi_iniziale, 21, 20) AS NUMERIC(18,4)) AS esi_fiscale_iniziale~") COMPUTE(NAME=~"CAST(SUBSTR(esi_attuale, 21, 20) AS NUMERIC(18,4)) AS esi_fiscale_attuale~") COMPUTE(NAME=~"CAST(fn_esistenza(1, ~~~"articolo~~~".~~~"id_articolo~~~", 0, YEAR(:data_inizio), MONTH(:data_inizio), :rn_id_valuta) AS CHAR(100)) AS esi_iniziale~") COMPUTE(NAME=~"CAST(fn_ultimo_costo(1, ~~~"articolo~~~".~~~"id_articolo~~~", 0, YEAR(:data_inizio), MONTH(:data_inizio), :rn_id_valuta) AS NUMERIC(18,4)) AS ultimo_costo_iniziale~") COMPUTE(NAME=~"CAST(fn_esistenza(1, ~~~"articolo~~~".~~~"id_articolo~~~", 0, YEAR(:data_fine), MONTH(:data_fine), :rn_id_valuta) AS CHAR(100)) AS esi_attuale~") COMPUTE(NAME=~"CAST(fn_ultimo_costo(1, ~~~"articolo~~~".~~~"id_articolo~~~", 0, YEAR(:data_fine), MONTH(:data_fine), :rn_id_valuta) AS NUMERIC(18,4)) AS ultimo_costo_attuale~") COMPUTE(NAME=~"CAST ( ( SELECT id_val_euro FROM par_sistema ) AS INTEGER ) AS id_val_euro~")    JOIN (LEFT=~"unita_confezione.id_articolo~"    OP =~"=~"RIGHT=~"articolo.id_articolo~" )    JOIN (LEFT=~"unita_misura.id_unita_misura~"    OP =~"=~"RIGHT=~"unita_confezione.id_unita_misura~" )WHERE(    EXP1 =~"( ( ~~~"articolo~~~".~~~"id_azienda~~~"~"   OP =~"=~"    EXP2 =~"1 )~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"( ~~~"unita_confezione~~~".~~~"unita_base~~~"~"   OP =~"=~"    EXP2 =~"'S' ) )~" ) ) ARG(NAME = ~"data_inizio~" TYPE = date)  ARG(NAME = ~"data_fine~" TYPE = date)  ARG(NAME = ~"parametri~" TYPE = string)  ARG(NAME = ~"parita_euro~" TYPE = number)  ARG(NAME = ~"rn_id_valuta~" TYPE = number) " arguments=(("data_inizio", date),("data_fine", date),("parametri", string),("parita_euro", number),("rn_id_valuta", number)) )
