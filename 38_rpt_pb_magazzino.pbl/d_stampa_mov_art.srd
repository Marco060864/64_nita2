 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"riga_documento~" )  TABLE(NAME=~"articolo~" )  TABLE(NAME=~"documento~" )  TABLE(NAME=~"prof_documento~" )  TABLE(NAME=~"sog_commerciale_gen~" )  TABLE(NAME=~"registro~" )  TABLE(NAME=~"azienda~" ) COLUMN(NAME=~"documento.num_documento~") COLUMN(NAME=~"documento.data_documento~") COLUMN(NAME=~"prof_documento.descrizione~") COLUMN(NAME=~"prof_documento.des_stampa~") COLUMN(NAME=~"riga_documento.quantita~") COLUMN(NAME=~"riga_documento.prezzo~") COLUMN(NAME=~"riga_documento.peso_netto~") COLUMN(NAME=~"riga_documento.peso_lordo~") COLUMN(NAME=~"articolo.descrizione~") COLUMN(NAME=~"sog_commerciale_gen.rag_soc_1~") COLUMN(NAME=~"sog_commerciale_gen.rag_soc_2~") COLUMN(NAME=~"sog_commerciale_gen.indirizzo~") COLUMN(NAME=~"sog_commerciale_gen.cap~") COLUMN(NAME=~"sog_commerciale_gen.localita~") COLUMN(NAME=~"sog_commerciale_gen.provincia~") COLUMN(NAME=~"sog_commerciale_gen.nazione~") COLUMN(NAME=~"sog_commerciale_gen.cod_fiscale~") COLUMN(NAME=~"sog_commerciale_gen.par_iva~") COLUMN(NAME=~"riga_documento.tot_riga_val_riga~") COLUMN(NAME=~"prof_documento.codice~") COLUMN(NAME=~"articolo.codice~") COLUMN(NAME=~"prof_documento.tipo_fattura~") COLUMN(NAME=~"riga_documento.prezzo_netto~") COLUMN(NAME=~"azienda.codice~")    JOIN (LEFT=~"riga_documento.id_articolo~"    OP =~"=~"RIGHT=~"articolo.id_articolo~"    OUTER1 =~"riga_documento.id_articolo~" )    JOIN (LEFT=~"riga_documento.id_documento~"    OP =~"=~"RIGHT=~"documento.id_documento~" )    JOIN (LEFT=~"documento.id_prof_documento~"    OP =~"=~"RIGHT=~"prof_documento.id_prof_documento~" )    JOIN (LEFT=~"documento.id_sog_commerciale~"    OP =~"=~"RIGHT=~"sog_commerciale_gen.id_sog_commerciale~" )    JOIN (LEFT=~"registro.id_registro~"    OP =~"=~"RIGHT=~"documento.id_registro~" )    JOIN (LEFT=~"documento.id_azienda~"    OP =~"=~"RIGHT=~"azienda.id_azienda~" )WHERE(    EXP1 =~"( ( ~~~"registro~~~".~~~"tipo_registro~~~"~"   OP =~"=~"    EXP2 =~"'IV'~"    LOGIC =~"or~" ) WHERE(    EXP1 =~"~~~"registro~~~".~~~"tipo_registro~~~"~"   OP =~"=~"    EXP2 =~"'IC' )~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"(~~~"articolo~~~".~~~"codice~~~"~"   OP =~">=~"    EXP2 =~":rs_da_codice )~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"(~~~"articolo~~~".~~~"codice~~~"~"   OP =~"<=~"    EXP2 =~":rs_a_codice )~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"(~~~"documento~~~".~~~"data_documento~~~"~"   OP =~">=~"    EXP2 =~":da_data~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"documento~~~".~~~"data_documento~~~"~"   OP =~"<=~"    EXP2 =~":a_data) )~" ) ) ARG(NAME = ~"rs_da_codice~" TYPE = string)  ARG(NAME = ~"rs_a_codice~" TYPE = string)  ARG(NAME = ~"da_data~" TYPE = date)  ARG(NAME = ~"a_data~" TYPE = date) " arguments=(("rs_da_codice", string),("rs_a_codice", string),("da_data", date),("a_data", date))  sort="codice A " )
