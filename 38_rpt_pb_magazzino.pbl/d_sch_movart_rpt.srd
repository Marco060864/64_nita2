 column=(type=decimal(4) updatewhereclause=yes name=riga_documento_tot_riga_val_az_v dbname="riga_documento_tot_riga_val_az_v" )
 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"v_movimenti~" )  TABLE(NAME=~"documento~" )  TABLE(NAME=~"riga_documento~" )  TABLE(NAME=~"sog_commerciale_gen~" )  TABLE(NAME=~"caus_magazzino~" )  TABLE(NAME=~"magazzino~" )  TABLE(NAME=~"locazione~" )  TABLE(NAME=~"articolo~" ) COLUMN(NAME=~"documento.data_documento~") COLUMN(NAME=~"documento.num_documento~") COLUMN(NAME=~"documento.data_registrazione~") COLUMN(NAME=~"documento.num_progressivo~") COLUMN(NAME=~"sog_commerciale_gen.codice~") COLUMN(NAME=~"magazzino.codice~") COLUMN(NAME=~"caus_magazzino.codice~") COLUMN(NAME=~"riga_documento.qta_un_base~") COLUMN(NAME=~"riga_documento.quantita~") COLUMN(NAME=~"riga_documento.prezzo_netto~") COLUMN(NAME=~"riga_documento.tot_riga_val_az~") COLUMN(NAME=~"articolo.codice~") COLUMN(NAME=~"articolo.des_breve~") COLUMN(NAME=~"v_movimenti.pd~") COLUMN(NAME=~"caus_magazzino.mp_car_fiscali~") COLUMN(NAME=~"caus_magazzino.md_car_fiscali~") COLUMN(NAME=~"caus_magazzino.md_scar_fiscali~") COLUMN(NAME=~"caus_magazzino.mp_scar_fiscali~") COMPUTE(NAME=~"CAST('' AS NUMERIC(18,4)) AS esi_fiscale_prog~") COMPUTE(NAME=~"CAST('' AS NUMERIC(18,4)) AS esi_fisica_prog~") COMPUTE(NAME=~"CAST(fn_qta_esistenza(~~~"riga_documento~~~".~~~"id_caus_magazzino~~~", ~~~"riga_documento~~~".~~~"qta_un_base~~~", ~~~"v_movimenti~~~".~~~"pd~~~") AS CHAR(20)) AS qta_esistenza~") COMPUTE(NAME=~"CAST(SUBSTR(ritorno_fn_fine, 41, 20) AS NUMERIC(14)) AS costo_medio_fine~") COMPUTE(NAME=~"CAST(SUBSTR(ritorno_fn, 1, 20) AS NUMERIC(18,4)) AS esi_fisica~") COMPUTE(NAME=~"CAST(SUBSTR(ritorno_fn, 21, 20) AS NUMERIC(18,4)) AS esi_fiscale~") COMPUTE(NAME=~"CAST('N' AS CHAR(1)) AS carico~") COMPUTE(NAME=~"CAST('N' AS CHAR(1)) AS scarico~") COMPUTE(NAME=~"CAST(fn_tipo_movimento(~~~"caus_magazzino~~~".~~~"id_caus_magazzino~~~", ~~~"v_movimenti~~~".~~~"pd~~~") AS CHAR(3)) AS tipo_movimento~") COMPUTE(NAME=~"CAST(fn_esistenza(1, ~~~"riga_documento~~~".~~~"id_articolo~~~", 0, YEAR((Date(:da_data_doc) - 1)), MONTH((Date(:da_data_doc) - 1)), :rn_id_valuta) AS CHAR(60)) AS ritorno_fn~") COMPUTE(NAME=~"CAST(fn_esistenza(1, ~~~"riga_documento~~~".~~~"id_articolo~~~", 0, YEAR(Date(:a_data_doc)), MONTH(Date(:a_data_doc)), :rn_id_valuta) AS CHAR(60)) AS ritorno_fn_fine~") COMPUTE(NAME=~"CAST( ( SELECT id_val_euro FROM par_sistema) AS INTEGER) AS id_val_euro~") COMPUTE(NAME=~"CAST( fn_conv_valuta (~~~"riga_documento~~~".~~~"id_valuta~~~",  ~~~"riga_documento~~~".~~~"prezzo_netto~~~", :rn_id_valuta) AS DECIMAL(18, 4) ) AS riga_documento_prezzo_netto_v~") COMPUTE(NAME=~"CAST( fn_conv_valuta (~~~"riga_documento~~~".~~~"id_valuta~~~",  ~~~"riga_documento~~~".~~~"tot_riga_val_az~~~", :rn_id_valuta) AS DECIMAL(18, 4) ) AS riga_documento_tot_riga_val_az_v~")    JOIN (LEFT=~"documento.id_documento~"    OP =~"=~"RIGHT=~"v_movimenti.id_documento~" )    JOIN (LEFT=~"riga_documento.id_riga_documento~"    OP =~"=~"RIGHT=~"v_movimenti.id_riga_documento~" )    JOIN (LEFT=~"sog_commerciale_gen.id_sog_commerciale~"    OP =~"=~"RIGHT=~"documento.id_sog_commerciale~" )    JOIN (LEFT=~"locazione.id_magazzino~"    OP =~"=~"RIGHT=~"magazzino.id_magazzino~" )    JOIN (LEFT=~"locazione.id_locazione~"    OP =~"=~"RIGHT=~"v_movimenti.locazione~" )    JOIN (LEFT=~"caus_magazzino.id_caus_magazzino~"    OP =~"=~"RIGHT=~"riga_documento.id_caus_magazzino~" )    JOIN (LEFT=~"articolo.id_articolo~"    OP =~"=~"RIGHT=~"riga_documento.id_articolo~" )) ARG(NAME = ~"parametri~" TYPE = string)  ARG(NAME = ~"parita_euro~" TYPE = number)  ARG(NAME = ~"arrotondamento_e~" TYPE = number)  ARG(NAME = ~"tipo_arrotondamento_e~" TYPE = string)  ARG(NAME = ~"da_data_doc~" TYPE = date)  ARG(NAME = ~"a_data_doc~" TYPE = date)  ARG(NAME = ~"rn_id_valuta~" TYPE = number) " arguments=(("parametri", string),("parita_euro", number),("arrotondamento_e", number),("tipo_arrotondamento_e", string),("da_data_doc", date),("a_data_doc", date),("rn_id_valuta", number))  sort="documento_data_documento A documento_num_documento A documento_data_registrazione A documento_num_progressivo A sog_commerciale_gen_codice A magazzino_codice A caus_magazzino_codice A " )
