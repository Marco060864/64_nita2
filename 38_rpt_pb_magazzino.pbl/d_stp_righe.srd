 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"articolo~" )  TABLE(NAME=~"riga_documento~" )  TABLE(NAME=~"unita_confezione~" )  TABLE(NAME=~"documento~" )  TABLE(NAME=~"par_sistema~" )  TABLE(NAME=~"valuta~" ALIAS=~"valuta_a~" )  TABLE(NAME=~"valuta~" ALIAS=~"valuta_b~" ) COLUMN(NAME=~"articolo.codice~") COLUMN(NAME=~"riga_documento.descrizione~") COLUMN(NAME=~"unita_confezione.codice~") COLUMN(NAME=~"unita_confezione.descrizione~") COLUMN(NAME=~"riga_documento.quantita~") COLUMN(NAME=~"riga_documento.sconto~") COLUMN(NAME=~"riga_documento.sconto_riga~") COLUMN(NAME=~"riga_documento.prezzo_netto~") COLUMN(NAME=~"riga_documento.prezzo~") COLUMN(NAME=~"documento.sconto_finanziario~") COLUMN(NAME=~"documento.sconto_fin_incondizionato~") COLUMN(NAME=~"documento.sconto_fin_cassa~") COLUMN(NAME=~"documento.id_documento~") COLUMN(NAME=~"riga_documento.id_documento~") COLUMN(NAME=~"riga_documento.tot_riga_val_az~") COLUMN(NAME=~"par_sistema.id_val_lire~") COLUMN(NAME=~"documento.id_valuta~") COLUMN(NAME=~"valuta_a.cambio~") COLUMN(NAME=~"valuta_b.parita_euro~")    JOIN (LEFT=~"valuta_a.id_valuta~"    OP =~"=~"RIGHT=~"documento.id_valuta~"    OUTER2 =~"documento.id_valuta~" )    JOIN (LEFT=~"unita_confezione.id_unita_confezione~"    OP =~"=~"RIGHT=~"riga_documento.id_unita_confezione~" )    JOIN (LEFT=~"articolo.id_articolo~"    OP =~"=~"RIGHT=~"unita_confezione.id_articolo~" )    JOIN (LEFT=~"riga_documento.id_documento~"    OP =~"=~"RIGHT=~"documento.id_documento~" )    JOIN (LEFT=~"valuta_b.id_valuta~"    OP =~"=~"RIGHT=~"par_sistema.id_val_lire~" )WHERE(    EXP1 =~"~~~"riga_documento~~~".~~~"id_documento~~~"~"   OP =~"=~"    EXP2 =~":ri_li_id_documento~" ) ) ARG(NAME = ~"ri_li_id_documento~" TYPE = number) " arguments=(("ri_li_id_documento", number)) )
