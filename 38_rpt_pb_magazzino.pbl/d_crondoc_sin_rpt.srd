table(column=(type=char(8) updatewhereclause=yes name=prof_documento_codice dbname="prof_documento.codice" )
 column=(type=char(40) updatewhereclause=yes name=prof_documento_descrizione dbname="prof_documento.descrizione" )
 column=(type=date updatewhereclause=yes name=documento_data_documento dbname="documento.data_documento" )
 column=(type=char(16) updatewhereclause=yes name=documento_num_documento dbname="documento.num_documento" )
 column=(type=char(8) updatewhereclause=yes name=sog_commerciale_gen_codice dbname="sog_commerciale_gen.codice" )
 column=(type=char(40) updatewhereclause=yes name=sog_commerciale_gen_rag_soc_1 dbname="sog_commerciale_gen.rag_soc_1" )
 column=(type=decimal(4) updatewhereclause=yes name=tot_doc_v dbname="tot_doc_v" )
 column=(type=decimal(4) updatewhereclause=yes name=tot_merce_v dbname="tot_merce_v" )
 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"prof_documento~" )  TABLE(NAME=~"documento~" )  TABLE(NAME=~"sog_commerciale_gen~" ) COLUMN(NAME=~"prof_documento.codice~") COLUMN(NAME=~"prof_documento.descrizione~") COLUMN(NAME=~"documento.data_documento~") COLUMN(NAME=~"documento.num_documento~") COLUMN(NAME=~"sog_commerciale_gen.codice~") COLUMN(NAME=~"sog_commerciale_gen.rag_soc_1~") COMPUTE(NAME=~"CAST ( (SELECT SUM(fn_conv_valuta(d.id_valuta, c.val_tot_imp_v, :rn_id_valuta)) + SUM(fn_conv_valuta(d.id_valuta, val_tot_iva_v, :rn_id_valuta)) FROM cast_iva_documento c, documento d WHERE c.id_documento = d.id_documento AND d.id_documento = ~~~"documento~~~".~~~"id_documento~~~") AS NUMERIC(18,4)) AS tot_doc_v~") COMPUTE(NAME=~"CAST( ( SELECT SUM(fn_conv_valuta( id_valuta, tot_riga_val_riga, :rn_id_valuta) ) FROM riga_documento WHERE id_documento = ~~~"documento~~~".~~~"id_documento~~~") AS NUMERIC(18,4)) AS tot_merce_v~")    JOIN (LEFT=~"documento.id_prof_documento~"    OP =~"=~"RIGHT=~"prof_documento.id_prof_documento~" )    JOIN (LEFT=~"sog_commerciale_gen.id_sog_commerciale~"    OP =~"=~"RIGHT=~"documento.id_sog_commerciale~" )) ARG(NAME = ~"parametri~" TYPE = string)  ARG(NAME = ~"rn_id_valuta~" TYPE = number) " arguments=(("parametri", string),("rn_id_valuta", number)) )
