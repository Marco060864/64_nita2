 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"riep_provvigioni~" )  TABLE(NAME=~"documento~" )  TABLE(NAME=~"riep_prov_righe~" )  TABLE(NAME=~"valuta~" )  TABLE(NAME=~"gruppo_agenti~" )  TABLE(NAME=~"sog_commerciale_gen~" ALIAS=~"sog_commerciale_gen_a~" )  TABLE(NAME=~"sog_commerciale_gen~" ALIAS=~"sog_commerciale_gen_b~" )  TABLE(NAME=~"sog_commerciale~" )  TABLE(NAME=~"par_aperta~" )  TABLE(NAME=~"reg_pd~" )  TABLE(NAME=~"tab_iva~" )  TABLE(NAME=~"prog_enasarco~" )  TABLE(NAME=~"per_enasarco~" )  TABLE(NAME=~"tributo~" )  TABLE(NAME=~"sog_commerciale_gen~" ALIAS=~"sog_commerciale_gen_c~" )  TABLE(NAME=~"scag_enasarco~" ) COLUMN(NAME=~"documento.data_registrazione~") COLUMN(NAME=~"documento.num_progressivo~") COLUMN(NAME=~"riep_prov_righe.tipo_prov~") COLUMN(NAME=~"riep_prov_righe.provvigioni~") COLUMN(NAME=~"gruppo_agenti.rip_per_fatturato~") COLUMN(NAME=~"gruppo_agenti.rip_per_incassato~") COLUMN(NAME=~"sog_commerciale_gen_a.codice~") COLUMN(NAME=~"sog_commerciale_gen_a.rag_soc_1~") COLUMN(NAME=~"sog_commerciale_gen_b.codice~") COLUMN(NAME=~"sog_commerciale_gen_b.rag_soc_1~") COLUMN(NAME=~"valuta.codice~") COLUMN(NAME=~"riep_prov_righe.imp_provv_documento~") COLUMN(NAME=~"riep_prov_righe.imp_prov_incassato~") COLUMN(NAME=~"sog_commerciale.prec_elab_definitivo~") COLUMN(NAME=~"riep_provvigioni.imp_premi_penalita~") COLUMN(NAME=~"riep_provvigioni.liq_pagato~") COLUMN(NAME=~"par_aperta.importo~") COMPUTE(NAME=~"cast((select sum(riep_prov_star_credere.imp_star_credere) from riep_prov_star_credere where id_riep_provvigioni=riep_provvigioni.id_riep_provvigioni) as dec ) as star_credere~") COLUMN(NAME=~"riep_provvigioni.inc_precedente~") COLUMN(NAME=~"gruppo_agenti.fat_ult_elab~") COLUMN(NAME=~"riep_prov_righe.data_elab_fatturato~") COLUMN(NAME=~"sog_commerciale.ult_elab_definitivo~") COLUMN(NAME=~"sog_commerciale.imp_fisso_ult_elab~") COLUMN(NAME=~"sog_commerciale.imp_premio_budget~") COLUMN(NAME=~"sog_commerciale.id_tab_iva_fat_prov~") COLUMN(NAME=~"tab_iva.codice~") COLUMN(NAME=~"tab_iva.per_aliquota~") COLUMN(NAME=~"prog_enasarco.progressivo_enasarco~") COLUMN(NAME=~"prog_enasarco.imp_ver_ult_elab~") COLUMN(NAME=~"per_enasarco.per_car_azienda~") COLUMN(NAME=~"tributo.per_tributo~") COLUMN(NAME=~"scag_enasarco.imp_massimo~")    JOIN (LEFT=~"documento.id_sog_commerciale~"    OP =~"=~"RIGHT=~"sog_commerciale_gen_b.id_sog_commerciale~"    OUTER1 =~"documento.id_sog_commerciale~" )    JOIN (LEFT=~"tributo.id_tributo~"    OP =~"=~"RIGHT=~"sog_commerciale_gen_c.id_tributo~"    OUTER1 =~"tributo.id_tributo~" )    JOIN (LEFT=~"documento.id_documento~"    OP =~"=~"RIGHT=~"riep_provvigioni.id_documento~" )    JOIN (LEFT=~"riep_provvigioni.id_agente~"    OP =~"=~"RIGHT=~"sog_commerciale_gen_a.id_sog_commerciale~" )    JOIN (LEFT=~"riep_prov_righe.id_riep_provvigioni~"    OP =~"=~"RIGHT=~"riep_provvigioni.id_riep_provvigioni~" )    JOIN (LEFT=~"valuta.id_valuta~"    OP =~"=~"RIGHT=~"sog_commerciale_gen_a.id_val_prov_agente~" )    JOIN (LEFT=~"gruppo_agenti.id_gruppo_agenti~"    OP =~"=~"RIGHT=~"documento.id_gruppo_agenti~" )    JOIN (LEFT=~"sog_commerciale.id_sog_commerciale~"    OP =~"=~"RIGHT=~"sog_commerciale_gen_a.id_sog_commerciale~" )    JOIN (LEFT=~"par_aperta.id_reg_pd~"    OP =~"=~"RIGHT=~"reg_pd.id_reg_pd~" )    JOIN (LEFT=~"tab_iva.id_tab_iva~"    OP =~"=~"RIGHT=~"sog_commerciale.id_tab_iva_fat_prov~" )    JOIN (LEFT=~"prog_enasarco.id_sog_commerciale~"    OP =~"=~"RIGHT=~"sog_commerciale.id_sog_commerciale~" )    JOIN (LEFT=~"scag_enasarco.id_tipo_agente~"    OP =~"=~"RIGHT=~"sog_commerciale_gen_a.id_tipo_agente~" )WHERE(    EXP1 =~"( ( ~~~"sog_commerciale_gen_a~~~".~~~"codice~~~"~"   OP =~">=~"    EXP2 =~":ra_da_agente )~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"( ~~~"sog_commerciale_gen_a~~~".~~~"codice~~~"~"   OP =~"<=~"    EXP2 =~":ra_a_agente ) )~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"reg_pd~~~".~~~"num_progressivo~~~"~"   OP =~"=~"    EXP2 =~"~~~"documento~~~".~~~"num_progressivo~~~"~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"reg_pd~~~".~~~"data_registrazione~~~"~"   OP =~"=~"    EXP2 =~"~~~"documento~~~".~~~"data_registrazione~~~"~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"reg_pd~~~".~~~"id_registro~~~"~"   OP =~"=~"    EXP2 =~"~~~"documento~~~".~~~"id_registro~~~"~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"prog_enasarco~~~".~~~"anno~~~"~"   OP =~"=~"    EXP2 =~"year(~~~"sog_commerciale~~~".~~~"ult_elab_definitivo~~~")~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"per_enasarco~~~".~~~"data_inizio~~~"~"   OP =~"<=~"    EXP2 =~"~~~"sog_commerciale~~~".~~~"ult_elab_definitivo~~~"~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"per_enasarco~~~".~~~"data_fine~~~"~"   OP =~">=~"    EXP2 =~"~~~"sog_commerciale~~~".~~~"ult_elab_definitivo~~~"~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"sog_commerciale_gen_c~~~".~~~"id_anagrafica~~~"~"   OP =~"=~"    EXP2 =~"~~~"sog_commerciale_gen_a~~~".~~~"id_anagrafica~~~"~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"sog_commerciale_gen_c~~~".~~~"tipo~~~"~"   OP =~"=~"    EXP2 =~"'F'~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"scag_enasarco~~~".~~~"data_inizio~~~"~"   OP =~"<=~"    EXP2 =~"~~~"sog_commerciale~~~".~~~"ult_elab_definitivo~~~"~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"scag_enasarco~~~".~~~"data_fine~~~"~"   OP =~">=~"    EXP2 =~"~~~"sog_commerciale~~~".~~~"ult_elab_definitivo~~~"~" ) ) ORDER(NAME=~"documento.data_registrazione~" ASC=yes )  ORDER(NAME=~"documento.num_progressivo~" ASC=yes )  ORDER(NAME=~"riep_prov_righe.tipo_prov~" ASC=yes )  ORDER(NAME=~"riep_prov_righe.provvigioni~" ASC=yes ) ARG(NAME = ~"ra_da_agente~" TYPE = string)  ARG(NAME = ~"ra_a_agente~" TYPE = string) " arguments=(("ra_da_agente", string),("ra_a_agente", string))  sort="sog_commerciale_gen_codice A documento_data_registrazione A documento_num_progressivo A riep_prov_righe_provvigioni A " )
