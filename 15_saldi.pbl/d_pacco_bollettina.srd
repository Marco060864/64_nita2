table(column=(type=long update=yes updatewhereclause=yes key=yes name=id_pacco dbname="pacco_bollettina.id_pacco" )
 column=(type=long update=yes updatewhereclause=yes key=yes name=id_bollettina dbname="pacco_bollettina.id_bollettina" )
 column=(type=long updatewhereclause=yes name=documento_id_documento dbname="documento.id_documento" )
