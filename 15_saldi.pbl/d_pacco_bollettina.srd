 column=(type=char(16) updatewhereclause=yes name=documento_num_documento dbname="documento.num_documento" )
 column=(type=datetime updatewhereclause=yes name=riga_doc_estensione_data_ora_modifica dbname="riga_doc_estensione.data_ora_modifica" )
 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"pacco_bollettina~" )  TABLE(NAME=~"documento~" )  TABLE(NAME=~"riga_documento~" )  TABLE(NAME=~"riga_doc_estensione~" ) COLUMN(NAME=~"pacco_bollettina.id_pacco~") COLUMN(NAME=~"pacco_bollettina.id_bollettina~") COLUMN(NAME=~"documento.id_documento~") COLUMN(NAME=~"riga_documento.id_riga_documento~") COLUMN(NAME=~"riga_documento.id_unita_confezione~") COLUMN(NAME=~"riga_documento.num_riga~") COLUMN(NAME=~"riga_documento.id_articolo~") COLUMN(NAME=~"riga_documento.quantita~") COLUMN(NAME=~"riga_documento.peso_netto~") COLUMN(NAME=~"riga_documento.peso_lordo~") COLUMN(NAME=~"riga_documento.coef_calo~") COLUMN(NAME=~"riga_documento.calo~") COLUMN(NAME=~"riga_documento.fino~") COMPUTE(NAME=~"cast(0 as varchar(13)) as c_cod_barre~") COLUMN(NAME=~"documento.num_progressivo~") COLUMN(NAME=~"documento.num_documento~") COLUMN(NAME=~"riga_doc_estensione.data_ora_modifica~")    JOIN (LEFT=~"riga_documento.id_documento~"    OP =~"=~"RIGHT=~"documento.id_documento~"    OUTER2 =~"documento.id_documento~" )    JOIN (LEFT=~"pacco_bollettina.id_bollettina~"    OP =~"=~"RIGHT=~"riga_doc_estensione.id_riga_documento~"    OUTER1 =~"pacco_bollettina.id_bollettina~" )   JOIN (LEFT=~"pacco_bollettina.id_bollettina~"    OP =~"=~"RIGHT=~"riga_documento.id_riga_documento~" ) WHERE(    EXP1 =~"pacco_bollettina.id_pacco~"   OP =~"=~"    EXP2 =~":id_pacco~" ) ) ARG(NAME = ~"id_pacco~" TYPE = number) " update="pacco_bollettina" updatewhere=1 updatekeyinplace=yes arguments=(("id_pacco", number))  sort="riga_doc_estensione_data_ora_modifica A " )
