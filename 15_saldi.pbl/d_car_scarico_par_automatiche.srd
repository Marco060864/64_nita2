table(column=(type=long update=yes updatewhereclause=yes identity=yes name=id_riga_documento dbname="riga_documento.id_riga_documento" )
 column=(type=long update=yes updatewhereclause=yes name=id_documento dbname="riga_documento.id_documento" )
 column=(type=decimal(4) update=yes updatewhereclause=yes name=calo dbname="riga_documento.calo" )
 column=(type=decimal(4) update=yes updatewhereclause=yes name=fino dbname="riga_documento.fino" )
 column=(type=date updatewhereclause=yes name=documento_data_documento dbname="documento.data_documento" )
 column=(type=char(16) updatewhereclause=yes name=documento_num_documento dbname="documento.num_documento" )
 column=(type=long updatewhereclause=yes name=id_sog_commerciale dbname="documento.id_sog_commerciale" )
 column=(type=long updatewhereclause=yes name=scar_attuale dbname="scar_attuale" )
 column=(type=char(2) updatewhereclause=yes name=cod_metallo dbname="orafo_metallo.codice" )
 retrieve="  SELECT ~"riga_documento~".~"id_riga_documento~",   
         ~"riga_documento~".~"id_documento~",   
         ~"riga_documento~".~"calo~",   
         ~"riga_documento~".~"fino~",   
         ~"documento~".~"data_documento~",   
         ~"documento~".~"num_documento~",   
         ~"documento~".~"id_sog_commerciale~",
			ifnull((select sum(qta_scaricata) from dba.partite_automatiche where id_riga_doc_scarico=  ~"riga_documento~".~"id_riga_documento~"), 0) as
			scar_attuale,
			~"orafo_metallo~".~"codice~"
    FROM ~"riga_documento~",   
         ~"documento~",
			~"articolo~",
			~"orafo_metallo~",
			~"orafo_titolo~"  
   WHERE ( ~"documento~".~"id_documento~" = ~"riga_documento~".~"id_documento~" ) and 
			( ~"riga_documento~".~"id_articolo~"=~"articolo~".~"id_articolo~") and
			(~"articolo~".~"id_titolo~"=~"orafo_titolo~".~"id_titolo~") and
			(~"orafo_titolo~".~"id_metallo~"=~"orafo_metallo~".~"id_metallo~") and 
           (~"documento~".~"id_prof_documento~" = 114 OR  
         ~"documento~".~"id_prof_documento~" = 66 OR  
         ~"documento~".~"id_prof_documento~" = 58) AND  
         ~"documento~".~"data_documento~" >= :da_data AND  
         ~"documento~".~"data_documento~" <= :a_data  AND
			  scar_attuale < ~"riga_documento~".~"calo~" +  ~"riga_documento~".~"fino~" and
				~"riga_documento~".~"calo~" +  ~"riga_documento~".~"fino~" > 0.1
" arguments=(("da_data", date),("a_data", date))  sort="cod_metallo A id_sog_commerciale A documento_data_documento A documento_num_documento A id_documento A id_riga_documento A " )
