table(column=(type=long updatewhereclause=yes name=pa_id_riga_doc_carico dbname="partite_automatiche.id_riga_doc_carico" dbalias="p.id_riga_doc_carico" )
 column=(type=decimal(4) updatewhereclause=yes name=c_scarico dbname="compute_0002" )
 column=(type=decimal(4) updatewhereclause=yes name=riga_documento_peso_netto dbname="riga_documento.peso_netto" dbalias="R.peso_netto" )
 retrieve="SELECT id_riga_doc_carico,  sum(qta_scaricata) ,  r.peso_netto FROM partite_automatiche p, riga_documento R , documento d
where R.id_riga_documento=p.id_riga_doc_carico and  d.id_documento=r.id_documento and data_documento>=:da_data and data_documento<=:a_data
group by p.id_riga_doc_carico, r.peso_netto
" filter=" c_scarico < riga_documento_peso_netto "arguments=(("da_data", date),("a_data", date))  sort="pa_id_riga_doc_carico A " )
