global type f_trova_pacco_aperto from function_object
end type

forward prototypes
global function long f_trova_pacco_aperto (date adt_oggi)
end prototypes

global function long f_trova_pacco_aperto (date adt_oggi);long ll_id_pacco

select id_pacco into :ll_id_pacco
from dba.pacco 
where left(codice,1)='A' and 
(chiuso='N' or chiuso is null) and date(dataora)=:adt_oggi
;
//order by id_pacco desc;

return ll_id_pacco

