table(column=(type=long update=yes updatewhereclause=yes key=yes identity=yes name=id_pacco dbname="pacco.id_pacco" dbalias=".id_pacco" )
 column=(type=char(32) update=yes updatewhereclause=yes name=codice dbname="pacco.codice" dbalias=".codice" )
 column=(type=datetime update=yes updatewhereclause=yes name=dataora dbname="pacco.dataora" dbalias=".dataora" initial="today" )
 column=(type=char(40) update=yes updatewhereclause=yes name=descrizione dbname="pacco.descrizione" dbalias=".descrizione" )
 column=(type=char(1) updatewhereclause=yes name=chiuso dbname="pacco.chiuso" dbalias=".chiuso" initial="N" values="Chiuso	S/Aperto	N/" )
 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"pacco~" ) COLUMN(NAME=~"pacco.id_pacco~") COLUMN(NAME=~"pacco.codice~") COLUMN(NAME=~"pacco.dataora~") COLUMN(NAME=~"pacco.descrizione~") COLUMN(NAME=~"pacco.chiuso~")WHERE(    EXP1 =~"left(~~~"pacco~~~".~~~"codice~~~", 1)~"   OP =~"=~"    EXP2 =~"'A'~" ) ) " update="pacco" updatewhere=1 updatekeyinplace=yes  sort="dataora A codice A " )
