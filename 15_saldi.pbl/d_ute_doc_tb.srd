table(column=(type=long updatewhereclause=yes name=ute_documento_id_utente dbname="ute_documento.id_utente" )
 column=(type=long updatewhereclause=yes name=ute_documento_id_documento dbname="ute_documento.id_documento" )
 column=(type=char(2) updatewhereclause=yes name=ute_documento_operazione dbname="ute_documento.operazione" )
 column=(type=datetime updatewhereclause=yes name=ute_documento_dataora dbname="ute_documento.dataora" )
 column=(type=decimal(0) updatewhereclause=yes name=documento_num_progressivo dbname="documento.num_progressivo" )
 column=(type=date updatewhereclause=yes name=documento_data_registrazione dbname="documento.data_registrazione" )
 column=(type=char(16) updatewhereclause=yes name=documento_num_documento dbname="documento.num_documento" )
 column=(type=date updatewhereclause=yes name=documento_data_documento dbname="documento.data_documento" )
 column=(type=char(20) updatewhereclause=yes name=utenti_ut_utente dbname="utenti.ut_utente" )
 column=(type=char(40) updatewhereclause=yes name=ute_documento_descrizione dbname="ute_documento.descrizione" )
 column=(type=char(8) updatewhereclause=yes name=prof_documento_codice dbname="prof_documento.codice" )
 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"ute_documento~" )  TABLE(NAME=~"utenti~" )  TABLE(NAME=~"documento~" )  TABLE(NAME=~"prof_documento~" ) COLUMN(NAME=~"ute_documento.id_utente~") COLUMN(NAME=~"ute_documento.id_documento~") COLUMN(NAME=~"ute_documento.operazione~") COLUMN(NAME=~"ute_documento.dataora~") COLUMN(NAME=~"documento.num_progressivo~") COLUMN(NAME=~"documento.data_registrazione~") COLUMN(NAME=~"documento.num_documento~") COLUMN(NAME=~"documento.data_documento~") COLUMN(NAME=~"utenti.ut_utente~") COLUMN(NAME=~"ute_documento.descrizione~") COLUMN(NAME=~"prof_documento.codice~")    JOIN (LEFT=~"ute_documento.id_documento~"    OP =~"=~"RIGHT=~"documento.id_documento~"    OUTER1 =~"ute_documento.id_documento~" )    JOIN (LEFT=~"utenti.id_utenti~"    OP =~"=~"RIGHT=~"ute_documento.id_utente~" )    JOIN (LEFT=~"documento.id_prof_documento~"    OP =~"=~"RIGHT=~"prof_documento.id_prof_documento~" )) ORDER(NAME=~"ute_documento.dataora~" ASC=no) "  sort="documento_data_documento A documento_num_documento A documento_num_progressivo A " )
