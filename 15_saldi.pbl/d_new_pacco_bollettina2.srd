table(column=(type=long update=yes updatewhereclause=yes name=id_pacco dbname="pacco_bollettina.id_pacco" dbalias=".id_pacco" )
 column=(type=long update=yes updatewhereclause=yes name=id_bollettina dbname="pacco_bollettina.id_bollettina" dbalias=".id_bollettina" )
 column=(type=long updatewhereclause=yes identity=yes name=documento_id_documento dbname="documento.id_documento" dbalias=".id_documento" )
 column=(type=long updatewhereclause=yes identity=yes name=riga_documento_id_riga_documento dbname="riga_documento.id_riga_documento" dbalias=".id_riga_documento" )
 column=(type=long updatewhereclause=yes name=riga_documento_id_unita_confezione dbname="riga_documento.id_unita_confezione" dbalias=".id_unita_confezione" )
 column=(type=decimal(0) updatewhereclause=yes name=riga_documento_num_riga dbname="riga_documento.num_riga" dbalias=".num_riga" )
 column=(type=long updatewhereclause=yes name=riga_documento_id_articolo dbname="riga_documento.id_articolo" dbalias=".id_articolo" )
 column=(type=decimal(4) updatewhereclause=yes name=riga_documento_quantita dbname="riga_documento.quantita" dbalias=".quantita" )
 column=(type=decimal(4) updatewhereclause=yes name=riga_documento_peso_netto dbname="riga_documento.peso_netto" dbalias=".peso_netto" )
 column=(type=decimal(4) updatewhereclause=yes name=riga_documento_peso_lordo dbname="riga_documento.peso_lordo" dbalias=".peso_lordo" )
 column=(type=decimal(2) updatewhereclause=yes name=riga_documento_coef_calo dbname="riga_documento.coef_calo" dbalias=".coef_calo" )
 column=(type=decimal(4) updatewhereclause=yes name=riga_documento_calo dbname="riga_documento.calo" dbalias=".calo" )
 column=(type=decimal(4) updatewhereclause=yes name=riga_documento_fino dbname="riga_documento.fino" dbalias=".fino" )
 column=(type=char(13) updatewhereclause=yes name=c_cod_barre dbname="c_cod_barre" )
 column=(type=decimal(0) updatewhereclause=yes name=documento_num_progressivo dbname="documento.num_progressivo" dbalias=".num_progressivo" )
 column=(type=char(16) updatewhereclause=yes name=documento_num_documento dbname="documento.num_documento" dbalias=".num_documento" )
 column=(type=datetime updatewhereclause=yes name=riga_doc_estensione_data_ora_modifica dbname="riga_doc_estensione.data_ora_modifica" dbalias=".data_ora_modifica" )
 column=(type=decimal(5) updatewhereclause=yes name=riga_documento_provv_imp_carea_2 dbname="riga_documento.provv_imp_carea_2" dbalias=".provv_imp_carea_2" )
 column=(type=decimal(4) updatewhereclause=yes name=riga_documento_provv_imp_agente_2 dbname="riga_documento.provv_imp_agente_2" dbalias=".provv_imp_agente_2" )
 column=(type=char(32) updatewhereclause=yes name=pacco_codice dbname="pacco.codice" dbalias=".codice" )
 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"pacco_bollettina~" )  TABLE(NAME=~"documento~" )  TABLE(NAME=~"riga_documento~" )  TABLE(NAME=~"riga_doc_estensione~" )  TABLE(NAME=~"pacco~" ) COLUMN(NAME=~"pacco_bollettina.id_pacco~") COLUMN(NAME=~"pacco_bollettina.id_bollettina~") COLUMN(NAME=~"documento.id_documento~") COLUMN(NAME=~"riga_documento.id_riga_documento~") COLUMN(NAME=~"riga_documento.id_unita_confezione~") COLUMN(NAME=~"riga_documento.num_riga~") COLUMN(NAME=~"riga_documento.id_articolo~") COLUMN(NAME=~"riga_documento.quantita~") COLUMN(NAME=~"riga_documento.peso_netto~") COLUMN(NAME=~"riga_documento.peso_lordo~") COLUMN(NAME=~"riga_documento.coef_calo~") COLUMN(NAME=~"riga_documento.calo~") COLUMN(NAME=~"riga_documento.fino~") COMPUTE(NAME=~"cast(0 as varchar(13)) as c_cod_barre~") COLUMN(NAME=~"documento.num_progressivo~") COLUMN(NAME=~"documento.num_documento~") COLUMN(NAME=~"riga_doc_estensione.data_ora_modifica~") COLUMN(NAME=~"riga_documento.provv_imp_carea_2~") COLUMN(NAME=~"riga_documento.provv_imp_agente_2~") COLUMN(NAME=~"pacco.codice~")    JOIN (LEFT=~"riga_documento.id_documento~"    OP =~"=~"RIGHT=~"documento.id_documento~"    OUTER2 =~"documento.id_documento~" )    JOIN (LEFT=~"pacco_bollettina.id_bollettina~"    OP =~"=~"RIGHT=~"riga_doc_estensione.id_riga_documento~"    OUTER1 =~"pacco_bollettina.id_bollettina~" )    JOIN (LEFT=~"pacco_bollettina.id_bollettina~"    OP =~"=~"RIGHT=~"riga_documento.id_riga_documento~" )    JOIN (LEFT=~"pacco_bollettina.id_pacco~"    OP =~"=~"RIGHT=~"pacco.id_pacco~" )WHERE(    EXP1 =~"pacco_bollettina.id_pacco~"   OP =~"=~"    EXP2 =~":id_pacco~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"left(~~~"pacco~~~".~~~"codice~~~", 1)~"   OP =~"=~"    EXP2 =~"'A'~" ) ) ORDER(NAME=~"pacco.codice~" ASC=no) ARG(NAME = ~"id_pacco~" TYPE = number) " arguments=(("id_pacco", number))  sort="riga_doc_estensione_data_ora_modifica A " )
