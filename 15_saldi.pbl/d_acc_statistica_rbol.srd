 pos( cod_accessori_k_descrizione , ~"FBR~"),
if(pos( cod_accessori_k_descrizione , ~"+~", pos( cod_accessori_k_descrizione , ~"FBR~"))>0,
pos( cod_accessori_k_descrizione , ~"+~", pos( cod_accessori_k_descrizione , ~"FBR~")) - pos( cod_accessori_k_descrizione , ~"FBR~"), 100)),

if(pos( cod_accessori_k_descrizione , ~"FB~")>0,
mid(  cod_accessori_k_descrizione ,
 pos( cod_accessori_k_descrizione , ~"FB~"),
