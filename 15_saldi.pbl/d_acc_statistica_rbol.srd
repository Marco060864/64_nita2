pos( cod_accessori_k_descrizione , ~"+~", pos( cod_accessori_k_descrizione , ~"FB~")) - pos( cod_accessori_k_descrizione , ~"FB~"), 100)), 
if( pos( cod_accessori_k_descrizione , ~"FP~")>0, 
mid(  cod_accessori_k_descrizione ,
 pos( cod_accessori_k_descrizione , ~"FP~"),
if(pos( cod_accessori_k_descrizione , ~"+~", pos( cod_accessori_k_descrizione , ~"FP~"))>0,
pos( cod_accessori_k_descrizione , ~"+~", pos( cod_accessori_k_descrizione , ~"FP~")) - pos( cod_accessori_k_descrizione , ~"FP~"), 100)),

if( pos( cod_accessori_k_descrizione , ~"FT~")>0, 
mid(  cod_accessori_k_descrizione ,
 pos( cod_accessori_k_descrizione , ~"FT~"),
if(pos( cod_accessori_k_descrizione , ~"+~", pos( cod_accessori_k_descrizione , ~"FT~"))>0,
pos( cod_accessori_k_descrizione , ~"+~", pos( cod_accessori_k_descrizione , ~"FT~")) - pos( cod_accessori_k_descrizione , ~"FT~"), 100)), ~"~" ))))
