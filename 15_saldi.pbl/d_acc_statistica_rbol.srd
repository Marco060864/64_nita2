table(column=(type=long updatewhereclause=yes identity=yes name=documento_id_documento dbname="documento.id_documento" dbalias=".id_documento" )
 column=(type=char(16) updatewhereclause=yes name=documento_num_documento dbname="documento.num_documento" dbalias=".num_documento" )
 column=(type=date updatewhereclause=yes name=documento_data_documento dbname="documento.data_documento" dbalias=".data_documento" )
 column=(type=long updatewhereclause=yes identity=yes name=riga_documento_id_riga_documento dbname="riga_documento.id_riga_documento" dbalias=".id_riga_documento" )
 column=(type=long updatewhereclause=yes name=riga_documento_id_articolo dbname="riga_documento.id_articolo" dbalias=".id_articolo" )
 column=(type=decimal(4) updatewhereclause=yes name=riga_documento_quantita dbname="riga_documento.quantita" dbalias=".quantita" )
 column=(type=char(255) updatewhereclause=yes name=cod_accessori_k_descrizione dbname="cod_accessori_k.descrizione" dbalias=".descrizione" )
 column=(type=char(64) updatewhereclause=yes name=articolo_codice dbname="articolo.codice" dbalias=".codice" )
 column=(type=decimal(4) updatewhereclause=yes name=peso_netto dbname="riga_documento.peso_netto" dbalias=".peso_netto" )
 column=(type=decimal(2) updatewhereclause=yes name=riga_documento_coef_calo dbname="riga_documento.coef_calo" dbalias=".coef_calo" )
 retrieve="  SELECT ~"documento~".~"id_documento~",   
         ~"documento~".~"num_documento~",   
         ~"documento~".~"data_documento~",   
         ~"riga_documento~".~"id_riga_documento~",   
         ~"riga_documento~".~"id_articolo~",   
         ~"riga_documento~".~"quantita~",   
         ~"cod_accessori_k~".~"descrizione~",   
         ~"articolo~".~"codice~"  , ~"riga_documento~".~"peso_netto~", ~"riga_documento~".~"coef_calo~"
    FROM ~"documento~",   
         ~"riga_documento~",   
         ~"cod_accessori_k~",   
         ~"articolo~"  
   WHERE ( ~"riga_documento~".~"id_documento~" = ~"documento~".~"id_documento~" ) and  
         ( ~"riga_documento~".~"id_articolo~" = ~"articolo~".~"id_articolo~" ) and  
         ( ~"cod_accessori_k~".~"cod_accessorio~" = ~"articolo~".~"accessorio~" ) and  
          ( ~"documento~".~"data_documento~" >= :da_data ) AND  
         ( ~"documento~".~"data_documento~" <= :a_data ) AND  
         ( ~"documento~".~"id_prof_documento~" = 65 )     
" arguments=(("da_data", date),("a_data", date))  sort="c_gruppo A documento_data_documento A " )
