 retrieve="SELECT ~"orafo_metallo~".~"codice~",   
         ~"orafo_titolo~".~"titolo~",   
         ~"riga_documento~".~"qta_un_base~",   
         ~"riga_documento~".~"coef_calo~",   
         ~"riga_documento~".~"calo~",   
         ~"riga_documento~".~"fino~",   
         ~"riga_documento~".~"prezzo_metallo~",   
         ~"riga_documento~".~"prezzo_manifattura~",   
         ~"articolo~".~"codice~",   
         ~"documento~".~"num_progressivo~",   
         ~"documento~".~"data_registrazione~",   
         ~"caus_magazzino~".~"id_tipo_partita~",   
         ~"documento~".~"id_sog_commerciale~",   
         ~"riga_documento~".~"peso_netto~",   
         ~"caus_magazzino~".~"codice~",   
         ~"orafo_tipo_partita~".~"cod_tipo_partita~",   
         cast(substr(~"orafo_tipo_partita~".~"cod_tipo_partita~",2,2) as char(2)) as tipo_partita,   
         ~"riga_documento~".~"tot_riga_val_az~",   
         ~"caus_magazzino~".~"coef_vuoto~",   
         cast(null as numeric(18,2) ) as chius_fino_in,   
         cast(null as numeric(18,2) ) as chius_fino_out,   
         cast(null as numeric(18,2) ) as chius_calo_in,   
         cast(null as numeric(18,2) ) as chius_calo_out,   
         cast(null as numeric(18,2) ) as chius_lire_out,   
         cast(null as numeric(18,2) ) as chius_lire_in,   
         ~"documento~".~"ora_registrazione~",   
         ~"orafo_titolo~".~"id_titolo~",   
         ~"articolo~".~"id_articolo~",   
         ~"caus_magazzino~".~"id_caus_magazzino~",   
         ~"caus_magazzino~".~"saldi_cl_fino~",   
         ~"caus_magazzino~".~"saldi_cl_lire~",   
         ~"documento~".~"num_documento~",   
         ~"documento~".~"data_documento~",   
         ~"riga_documento~".~"importo_manifattura~",   
         ~"riga_documento~".~"importo_manifattura_val~",   
         cast(null as numeric(16,2)) as chius_manifattura,   
         ~"articolo~".~"id_cat_codifica~",   
         ~"prof_documento~".~"codice~",   
         cast(null as numeric(18,2) ) as fino_calo_saldo_old,   
         cast(null as numeric(18,2) ) as lire_saldo_old,   
         ~"riga_documento~".~"id_riga_partita~",   
         ~"orafo_scar_partita~".~"id_partita~",   
         ~"orafo_aper_partita~".~"id_partita~",   
         ~"orafo_aper_partita~".~"resto~"  
    FROM {oj {oj ~"caus_magazzino~"  LEFT OUTER JOIN ~"orafo_tipo_partita~"  ON ~"caus_magazzino~".~"id_tipo_partita~" = ~"orafo_tipo_partita~".~"id_tipo_partita~"}, {oj ~"riga_documento~"  LEFT OUTER JOIN ~"orafo_scar_partita~"  ON ~"riga_documento~".~"id_riga_partita~" = ~"orafo_scar_partita~".~"id_riga_documento~"} LEFT OUTER JOIN ~"orafo_aper_partita~"  ON ~"orafo_scar_partita~".~"id_partita~" = ~"orafo_aper_partita~".~"id_partita~"},   
         ~"documento~",   
         ~"orafo_metallo~",   
         ~"orafo_titolo~",   
         ~"articolo~",   
         ~"prof_documento~"  
   WHERE ( ~"riga_documento~".~"id_documento~" = ~"documento~".~"id_documento~" ) and  
         ( ~"articolo~".~"id_articolo~" = ~"riga_documento~".~"id_articolo~" ) and  
         ( ~"orafo_titolo~".~"id_titolo~" = ~"articolo~".~"id_titolo~" ) and  
         ( ~"orafo_metallo~".~"id_metallo~" = ~"orafo_titolo~".~"id_metallo~" ) and  
         ( ~"caus_magazzino~".~"id_caus_magazzino~" = ~"riga_documento~".~"id_caus_magazzino~" ) and  
         ( ~"documento~".~"id_prof_documento~" = ~"prof_documento~".~"id_prof_documento~" ) and  
         ( ~"documento~".~"id_sog_commerciale~" = :ra_id_sog_comm ) AND  
         ((~"caus_magazzino~".~"saldi_cl_fino~" is not null) OR  
         ( ~"caus_magazzino~".~"saldi_cl_lire~" is not null))   
ORDER BY ~"orafo_metallo~".~"codice~" ASC,   
         ~"documento~".~"data_registrazione~" ASC,   
         ~"documento~".~"num_progressivo~" ASC   
" arguments=(("ra_id_sog_comm", number))  sort="orafo_metallo_codice A data_documento A num_documento A num_progressivo A resto D id_riga_partita A " )
