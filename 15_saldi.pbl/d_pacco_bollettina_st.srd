 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"pacco_bollettina~" )  TABLE(NAME=~"documento~" )  TABLE(NAME=~"riga_documento~" )  TABLE(NAME=~"pacco~" )  TABLE(NAME=~"articolo~" ) COLUMN(NAME=~"pacco_bollettina.id_pacco~") COLUMN(NAME=~"pacco_bollettina.id_bollettina~") COLUMN(NAME=~"documento.id_documento~") COLUMN(NAME=~"riga_documento.id_riga_documento~") COLUMN(NAME=~"riga_documento.id_unita_confezione~") COLUMN(NAME=~"riga_documento.num_riga~") COLUMN(NAME=~"riga_documento.id_articolo~") COLUMN(NAME=~"riga_documento.quantita~") COLUMN(NAME=~"riga_documento.peso_netto~") COLUMN(NAME=~"riga_documento.peso_lordo~") COLUMN(NAME=~"riga_documento.coef_calo~") COLUMN(NAME=~"riga_documento.calo~") COLUMN(NAME=~"riga_documento.fino~") COMPUTE(NAME=~"cast(0 as varchar(13)) as c_cod_barre~") COLUMN(NAME=~"documento.num_progressivo~") COLUMN(NAME=~"documento.num_documento~") COLUMN(NAME=~"articolo.codice~") COLUMN(NAME=~"pacco.codice~") COLUMN(NAME=~"pacco.dataora~") COLUMN(NAME=~"riga_documento.provv_subage_2~")    JOIN (LEFT=~"riga_documento.id_documento~"    OP =~"=~"RIGHT=~"documento.id_documento~"    OUTER1 =~"riga_documento.id_documento~" )    JOIN (LEFT=~"articolo.id_articolo~"    OP =~"=~"RIGHT=~"riga_documento.id_articolo~"    OUTER2 =~"riga_documento.id_articolo~" )    JOIN (LEFT=~"pacco_bollettina.id_bollettina~"    OP =~"=~"RIGHT=~"riga_documento.id_riga_documento~"    OUTER1 =~"pacco_bollettina.id_bollettina~" )    JOIN (LEFT=~"pacco.id_pacco~"    OP =~"=~"RIGHT=~"pacco_bollettina.id_pacco~" )WHERE(    EXP1 =~"~~~"pacco_bollettina~~~".~~~"id_pacco~~~"~"   OP =~"=~"    EXP2 =~":id_pacco~" ) ) ARG(NAME = ~"id_pacco~" TYPE = number) " arguments=(("id_pacco", number))  sort="pacco_bollettina_id_pacco A provv_subage_2 A " )
