 column=(type=decimal(4) updatewhereclause=yes name=clire_saldo dbname="lire_saldo" )
 column=(type=decimal(2) updatewhereclause=yes name=caus_magazzino_coef_vuoto dbname="caus_magazzino.coef_vuoto" )
