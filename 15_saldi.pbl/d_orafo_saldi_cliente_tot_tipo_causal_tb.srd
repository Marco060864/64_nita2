 retrieve="  SELECT ~"orafo_metallo~".~"codice~",   
         ~"orafo_titolo~".~"titolo~",   
         ~"riga_documento~".~"qta_un_base~",   
         ~"riga_documento~".~"coef_calo~",   
         ~"riga_documento~".~"calo~",   
         ~"riga_documento~".~"fino~",   
         ~"riga_documento~".~"prezzo_metallo~",   
         ~"riga_documento~".~"prezzo_manifattura~",   
         ~"articolo~".~"codice~",   
         ~"documento~".~"num_progressivo~",   
         ~"documento~".~"data_registrazione~",   
         ~"caus_magazzino~".~"id_tipo_partita~",   
         ~"documento~".~"id_sog_commerciale~",   
         ~"riga_documento~".~"peso_netto~",   
         ~"caus_magazzino~".~"mp_car_fiscali~",   
         ~"caus_magazzino~".~"mp_scar_fiscali~",   
         ~"caus_magazzino~".~"mp_vis_clienti~",   
         ~"caus_magazzino~".~"mp_vis_fornitori~",   
         ~"caus_magazzino~".~"mp_qta_cl_clienti~",   
         ~"caus_magazzino~".~"mp_qta_cl_fornitori~",   
         ~"caus_magazzino~".~"mp_qta_rim_iniziale~",   
         ~"caus_magazzino~".~"mp_val_caricato~",   
         ~"caus_magazzino~".~"mp_val_scaricato~",   
         ~"caus_magazzino~".~"codice~",   
         ~"orafo_tipo_partita~".~"cod_tipo_partita~",   
         cast(substr(~"orafo_tipo_partita~".~"cod_tipo_partita~",2,2) as char(2)) as tipo_partita,   
         ~"riga_documento~".~"tot_riga_val_az~",   
         cast(0 as numeric(18,4) ) as fino_saldo,   
         cast(0 as numeric(18,4) ) as calo_saldo,   
         cast(0 as numeric(18,4) ) as fino_calo_saldo,   
         cast(0 as numeric(18,4) ) as lire_saldo,   
         ~"caus_magazzino~".~"coef_vuoto~",   
         ~"documento~".~"ora_registrazione~"  
    FROM {oj ~"caus_magazzino~"  LEFT OUTER JOIN ~"orafo_tipo_partita~"  ON ~"caus_magazzino~".~"id_tipo_partita~" = ~"orafo_tipo_partita~".~"id_tipo_partita~"},   
         ~"riga_documento~",   
         ~"documento~",   
         ~"orafo_metallo~",   
         ~"orafo_titolo~",   
         ~"articolo~"  
   WHERE ( ~"riga_documento~".~"id_documento~" = ~"documento~".~"id_documento~" ) and  
         ( ~"articolo~".~"id_articolo~" = ~"riga_documento~".~"id_articolo~" ) and  
         ( ~"orafo_titolo~".~"id_titolo~" = ~"articolo~".~"id_titolo~" ) and  
         ( ~"orafo_titolo~".~"id_metallo~" = ~"orafo_metallo~".~"id_metallo~" ) and  
         ( ~"caus_magazzino~".~"id_caus_magazzino~" = ~"riga_documento~".~"id_caus_magazzino~" ) and  
         ( ( ~"documento~".~"id_sog_commerciale~" = :ra_id_sog_comm ) ) AND  
         (((~"documento~".~"data_registrazione~" = :rd_datamax) AND (~"documento~".~"ora_registrazione~" >= :rt_timemax)) OR
         (~"documento~".~"data_registrazione~" > :rd_datamax)) AND
         (((~"documento~".~"data_registrazione~" = :rd_datamin) AND (~"documento~".~"ora_registrazione~" <= :rt_timemin)) OR
         (~"documento~".~"data_registrazione~" < :rd_datamin))
ORDER BY ~"orafo_metallo~".~"codice~" ASC,   
         ~"documento~".~"data_registrazione~" ASC,   
         ~"documento~".~"num_progressivo~" ASC   
" arguments=(("ra_id_sog_comm", number),("rd_datamax", date),("rt_timemax", time),("rd_datamin", date),("rt_timemin", time))  sort="orafo_metallo_codice A tipo_partita A " )
