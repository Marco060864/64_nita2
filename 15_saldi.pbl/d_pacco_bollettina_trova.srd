 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"pacco_bollettina~" )  TABLE(NAME=~"documento~" )  TABLE(NAME=~"riga_documento~" )  TABLE(NAME=~"pacco~" ) COLUMN(NAME=~"pacco_bollettina.id_pacco~") COLUMN(NAME=~"pacco_bollettina.id_bollettina~") COLUMN(NAME=~"documento.id_documento~") COLUMN(NAME=~"riga_documento.id_riga_documento~") COLUMN(NAME=~"riga_documento.id_unita_confezione~") COLUMN(NAME=~"riga_documento.num_riga~") COLUMN(NAME=~"riga_documento.id_articolo~") COLUMN(NAME=~"riga_documento.quantita~") COLUMN(NAME=~"riga_documento.peso_netto~") COLUMN(NAME=~"riga_documento.peso_lordo~") COLUMN(NAME=~"riga_documento.coef_calo~") COLUMN(NAME=~"riga_documento.calo~") COLUMN(NAME=~"riga_documento.fino~") COMPUTE(NAME=~"cast(0 as varchar(13)) as c_cod_barre~") COLUMN(NAME=~"documento.num_progressivo~") COLUMN(NAME=~"documento.num_documento~") COLUMN(NAME=~"pacco.codice~") COLUMN(NAME=~"pacco.dataora~") COLUMN(NAME=~"pacco.descrizione~") COLUMN(NAME=~"pacco.chiuso~")    JOIN (LEFT=~"riga_documento.id_documento~"    OP =~"=~"RIGHT=~"documento.id_documento~"    OUTER2 =~"documento.id_documento~" )    JOIN (LEFT=~"pacco_bollettina.id_bollettina~"    OP =~"=~"RIGHT=~"riga_documento.id_riga_documento~" )    JOIN (LEFT=~"pacco.id_pacco~"    OP =~"=~"RIGHT=~"pacco_bollettina.id_pacco~" )WHERE(    EXP1 =~"~~~"documento~~~".~~~"num_progressivo~~~"~"   OP =~"=~"    EXP2 =~":num_prog~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"year(~~~"documento~~~".~~~"data_documento~~~")~"   OP =~"=~"    EXP2 =~":anno~" ) ) ARG(NAME = ~"num_prog~" TYPE = number)  ARG(NAME = ~"anno~" TYPE = number) " arguments=(("num_prog", number),("anno", number)) )
