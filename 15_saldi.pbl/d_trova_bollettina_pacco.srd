table(column=(type=long updatewhereclause=yes identity=yes name=id_documento dbname="documento.id_documento" dbalias=".id_documento" )
 column=(type=decimal(0) updatewhereclause=yes name=num_progressivo dbname="documento.num_progressivo" dbalias=".num_progressivo" )
 column=(type=date updatewhereclause=yes name=data_registrazione dbname="documento.data_registrazione" dbalias=".data_registrazione" )
 column=(type=char(16) updatewhereclause=yes name=num_documento dbname="documento.num_documento" dbalias=".num_documento" )
 column=(type=date updatewhereclause=yes name=data_documento dbname="documento.data_documento" dbalias=".data_documento" )
 column=(type=long updatewhereclause=yes identity=yes name=id_riga_documento dbname="riga_documento.id_riga_documento" dbalias=".id_riga_documento" )
 column=(type=char(2) updatewhereclause=yes name=tipo_registro dbname="registro.tipo_registro" dbalias=".tipo_registro" )
 column=(type=char(4) updatewhereclause=yes name=esercizio_codice dbname="esercizio.codice" dbalias=".codice" )
 column=(type=char(1) updatewhereclause=yes name=ordinato_fo dbname="documento.ordinato_fo" dbalias=".ordinato_fo" )
 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"esercizio~" )  TABLE(NAME=~"registro~" )  TABLE(NAME=~"riga_documento~" )  TABLE(NAME=~"documento~" ) COLUMN(NAME=~"documento.id_documento~") COLUMN(NAME=~"documento.num_progressivo~") COLUMN(NAME=~"documento.data_registrazione~") COLUMN(NAME=~"documento.num_documento~") COLUMN(NAME=~"documento.data_documento~") COLUMN(NAME=~"riga_documento.id_riga_documento~") COLUMN(NAME=~"registro.tipo_registro~") COLUMN(NAME=~"esercizio.codice~") COLUMN(NAME=~"documento.ordinato_fo~")    JOIN (LEFT=~"registro.id_esercizio~"    OP =~"=~"RIGHT=~"esercizio.id_esercizio~" )    JOIN (LEFT=~"documento.id_documento~"    OP =~"=~"RIGHT=~"riga_documento.id_documento~" )    JOIN (LEFT=~"documento.id_registro~"    OP =~"=~"RIGHT=~"registro.id_registro~" )WHERE(    EXP1 =~"right(~~~"documento~~~".~~~"num_documento~~~", 7)~"   OP =~"=~"    EXP2 =~":as_bollettina~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"documento~~~".~~~"data_documento~~~"~"   OP =~">=~"    EXP2 =~":da_data~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"registro~~~".~~~"tipo_registro~~~"~"   OP =~"=~"    EXP2 =~"'GV'~" ) ) ARG(NAME = ~"as_bollettina~" TYPE = string)  ARG(NAME = ~"da_data~" TYPE = date) " arguments=(("as_bollettina", string),("da_data", date))  sort="data_documento D " )
