table(column=(type=long update=yes updatewhereclause=yes key=yes identity=yes name=id_documento dbname="documento.id_documento" dbalias=".id_documento" )
 column=(type=decimal(0) update=yes updatewhereclause=yes name=num_progressivo dbname="documento.num_progressivo" dbalias=".num_progressivo" )
 column=(type=date update=yes updatewhereclause=yes name=data_registrazione dbname="documento.data_registrazione" dbalias=".data_registrazione" )
 column=(type=char(16) update=yes updatewhereclause=yes name=num_documento dbname="documento.num_documento" dbalias=".num_documento" )
 column=(type=date update=yes updatewhereclause=yes name=data_documento dbname="documento.data_documento" dbalias=".data_documento" )
 column=(type=long update=yes updatewhereclause=yes name=id_sog_commerciale dbname="documento.id_sog_commerciale" dbalias=".id_sog_commerciale" )
 column=(type=decimal(4) update=yes updatewhereclause=yes name=c_tot_peso dbname="c_tot_peso" )
 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"documento~" ) COLUMN(NAME=~"documento.id_documento~") COLUMN(NAME=~"documento.num_progressivo~") COLUMN(NAME=~"documento.data_registrazione~") COLUMN(NAME=~"documento.num_documento~") COLUMN(NAME=~"documento.data_documento~") COLUMN(NAME=~"documento.id_sog_commerciale~") COMPUTE(NAME=~"(select sum(peso_netto) from riga_documento r where r.id_documento=documento.id_documento) as c_tot_peso~")WHERE(    EXP1 =~"~~~"documento~~~".~~~"id_prof_documento~~~"~"   OP =~"=~"    EXP2 =~":id_prof~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"documento~~~".~~~"data_documento~~~"~"   OP =~">=~"    EXP2 =~":da_data~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"documento~~~".~~~"data_documento~~~"~"   OP =~"<=~"    EXP2 =~":a_data~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"documento~~~".~~~"id_sog_commerciale~~~"~"   OP =~"=~"    EXP2 =~":id_sog~" ) ) ORDER(NAME=~"7~" ASC=yes ) ARG(NAME = ~"da_data~" TYPE = date)  ARG(NAME = ~"a_data~" TYPE = date)  ARG(NAME = ~"id_sog~" TYPE = number)  ARG(NAME = ~"id_prof~" TYPE = number) " update="documento" updatewhere=1 updatekeyinplace=no arguments=(("da_data", date),("a_data", date),("id_sog", number),("id_prof", number)) )
