 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"caus_magazzino~" )  TABLE(NAME=~"orafo_tipo_partita~" )  TABLE(NAME=~"riga_documento~" )  TABLE(NAME=~"documento~" )  TABLE(NAME=~"orafo_metallo~" )  TABLE(NAME=~"orafo_titolo~" )  TABLE(NAME=~"articolo~" )  TABLE(NAME=~"registro~" ) COLUMN(NAME=~"orafo_metallo.codice~") COLUMN(NAME=~"orafo_titolo.titolo~") COLUMN(NAME=~"riga_documento.qta_un_base~") COLUMN(NAME=~"riga_documento.coef_calo~") COLUMN(NAME=~"riga_documento.calo~") COLUMN(NAME=~"riga_documento.fino~") COLUMN(NAME=~"riga_documento.prezzo_metallo~") COLUMN(NAME=~"riga_documento.prezzo_manifattura~") COLUMN(NAME=~"articolo.codice~") COLUMN(NAME=~"documento.num_progressivo~") COLUMN(NAME=~"documento.data_registrazione~") COLUMN(NAME=~"caus_magazzino.id_tipo_partita~") COLUMN(NAME=~"documento.id_sog_commerciale~") COLUMN(NAME=~"riga_documento.peso_netto~") COLUMN(NAME=~"caus_magazzino.codice~") COLUMN(NAME=~"orafo_tipo_partita.cod_tipo_partita~") COMPUTE(NAME=~"cast(substr(~~~"orafo_tipo_partita~~~".~~~"cod_tipo_partita~~~",2,2) as char(2)) as tipo_partita~") COLUMN(NAME=~"riga_documento.tot_riga_val_az~") COLUMN(NAME=~"caus_magazzino.coef_vuoto~") COMPUTE(NAME=~"cast(null as numeric(18,2) ) as fino_calo_saldo~") COMPUTE(NAME=~"cast(null as numeric(18,2) ) as lire_saldo~") COMPUTE(NAME=~"cast(null as numeric(18,2) ) as chius_fino_in~") COMPUTE(NAME=~"cast(null as numeric(18,2) ) as chius_fino_out~") COMPUTE(NAME=~"cast(null as numeric(18,2) ) as chius_calo_in~") COMPUTE(NAME=~"cast(null as numeric(18,2) ) as chius_calo_out~") COMPUTE(NAME=~"cast(null as numeric(18,2) ) as chius_lire_out~") COMPUTE(NAME=~"cast(null as numeric(18,2) ) as chius_lire_in~") COLUMN(NAME=~"documento.ora_registrazione~") COLUMN(NAME=~"orafo_titolo.id_titolo~") COLUMN(NAME=~"articolo.id_articolo~") COLUMN(NAME=~"caus_magazzino.id_caus_magazzino~") COLUMN(NAME=~"caus_magazzino.saldi_cl_fino~") COLUMN(NAME=~"caus_magazzino.saldi_cl_lire~") COLUMN(NAME=~"documento.num_documento~") COLUMN(NAME=~"documento.data_documento~") COLUMN(NAME=~"riga_documento.importo_manifattura~") COLUMN(NAME=~"riga_documento.importo_manifattura_val~") COMPUTE(NAME=~"cast(null as numeric(16,2)) as chius_manifattura~") COLUMN(NAME=~"articolo.id_cat_codifica~") COLUMN(NAME=~"registro.descrizione~")    JOIN (LEFT=~"caus_magazzino.id_tipo_partita~"    OP =~"=~"RIGHT=~"orafo_tipo_partita.id_tipo_partita~"    OUTER1 =~"caus_magazzino.id_tipo_partita~" )    JOIN (LEFT=~"riga_documento.id_documento~"    OP =~"=~"RIGHT=~"documento.id_documento~" )    JOIN (LEFT=~"articolo.id_articolo~"    OP =~"=~"RIGHT=~"riga_documento.id_articolo~" )    JOIN (LEFT=~"orafo_titolo.id_titolo~"    OP =~"=~"RIGHT=~"articolo.id_titolo~" )    JOIN (LEFT=~"orafo_metallo.id_metallo~"    OP =~"=~"RIGHT=~"orafo_titolo.id_metallo~" )    JOIN (LEFT=~"caus_magazzino.id_caus_magazzino~"    OP =~"=~"RIGHT=~"riga_documento.id_caus_magazzino~" )    JOIN (LEFT=~"registro.id_registro~"    OP =~"=~"RIGHT=~"documento.id_registro~" )WHERE(    EXP1 =~"( ~~~"documento~~~".~~~"id_sog_commerciale~~~"~"   OP =~"=~"    EXP2 =~":ra_id_sog_comm )~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"((~~~"caus_magazzino~~~".~~~"saldi_cl_fino~~~"~"   OP =~"is not~"    EXP2 =~"null)~"    LOGIC =~"or~" ) WHERE(    EXP1 =~"( ~~~"caus_magazzino~~~".~~~"saldi_cl_lire~~~"~"   OP =~"is not~"    EXP2 =~"null))~" ) ) ORDER(NAME=~"orafo_metallo.codice~" ASC=yes )  ORDER(NAME=~"documento.data_registrazione~" ASC=yes )  ORDER(NAME=~"documento.num_progressivo~" ASC=yes ) ARG(NAME = ~"ra_id_sog_comm~" TYPE = number) " arguments=(("ra_id_sog_comm", number))  sort="orafo_metallo_codice A data_documento A num_documento A num_progressivo A " )
