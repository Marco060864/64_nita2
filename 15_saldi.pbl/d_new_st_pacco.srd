table(column=(type=long updatewhereclause=yes identity=yes name=pacco_id_pacco dbname="pacco.id_pacco" )
 column=(type=char(32) updatewhereclause=yes name=pacco_codice dbname="pacco.codice" )
 column=(type=datetime updatewhereclause=yes name=pacco_dataora dbname="pacco.dataora" )
 column=(type=char(1) updatewhereclause=yes name=pacco_chiuso dbname="pacco.chiuso" )
 column=(type=long updatewhereclause=yes name=pacco_bollettina_numero dbname="pacco_bollettina.numero" )
 column=(type=date updatewhereclause=yes name=pacco_bollettina_data_pacco dbname="pacco_bollettina.data_pacco" )
 column=(type=long updatewhereclause=yes name=riga_documento_id_articolo dbname="riga_documento.id_articolo" )
 column=(type=char(16) updatewhereclause=yes name=documento_num_documento dbname="documento.num_documento" )
 column=(type=long updatewhereclause=yes identity=yes name=riga_documento_id_riga_documento dbname="riga_documento.id_riga_documento" )
 column=(type=long updatewhereclause=yes identity=yes name=documento_id_documento dbname="documento.id_documento" )
 column=(type=decimal(4) updatewhereclause=yes name=quantita dbname="riga_documento.quantita" )
 column=(type=decimal(4) updatewhereclause=yes name=peso_netto dbname="riga_documento.peso_netto" )
 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"pacco~" )  TABLE(NAME=~"pacco_bollettina~" )  TABLE(NAME=~"riga_documento~" )  TABLE(NAME=~"documento~" ) COLUMN(NAME=~"pacco.id_pacco~") COLUMN(NAME=~"pacco.codice~") COLUMN(NAME=~"pacco.dataora~") COLUMN(NAME=~"pacco.chiuso~") COLUMN(NAME=~"pacco_bollettina.numero~") COLUMN(NAME=~"pacco_bollettina.data_pacco~") COLUMN(NAME=~"riga_documento.id_articolo~") COLUMN(NAME=~"documento.num_documento~") COLUMN(NAME=~"riga_documento.id_riga_documento~") COLUMN(NAME=~"documento.id_documento~") COLUMN(NAME=~"riga_documento.quantita~") COLUMN(NAME=~"riga_documento.peso_netto~")    JOIN (LEFT=~"pacco_bollettina.id_pacco~"    OP =~"=~"RIGHT=~"pacco.id_pacco~"    OUTER2 =~"pacco.id_pacco~" )    JOIN (LEFT=~"riga_documento.id_riga_documento~"    OP =~"=~"RIGHT=~"pacco_bollettina.id_bollettina~"    OUTER2 =~"pacco_bollettina.id_bollettina~" )    JOIN (LEFT=~"documento.id_documento~"    OP =~"=~"RIGHT=~"riga_documento.id_documento~" )WHERE(    EXP1 =~"left(~~~"pacco~~~".~~~"codice~~~", 1)~"   OP =~"=~"    EXP2 =~"'A'~" ) ) "  sort="pacco_codice A " )
