documento~"    OP =~"=~"RIGHT=~"documento.id_documento~" )    JOIN (LEFT=~"articolo.id_articolo~"    OP =~"=~"RIGHT=~"riga_documento.id_articolo~" )    JOIN (LEFT=~"orafo_titolo.id_titolo~"    OP =~"=~"RIGHT=~"articolo.id_titolo~" )    JOIN (LEFT=~"orafo_titolo.id_metallo~"    OP =~"=~"RIGHT=~"orafo_metallo.id_metallo~" )    JOIN (LEFT=~"caus_magazzino.id_caus_magazzino~"    OP =~"=~"RIGHT=~"riga_documento.id_caus_magazzino~" )    JOIN (LEFT=~"orafo_tipo_partita.id_tipo_partita~"    OP =~"=~"RIGHT=~"caus_magazzino.id_tipo_partita~" )WHERE(    EXP1 =~"~~~"documento~~~".~~~"id_sog_commerciale~~~"~"   OP =~"=~"    EXP2 =~":ra_id_sog_comm~" ) ) ORDER(NAME=~"orafo_metallo.codice~" ASC=yes ) ARG(NAME = ~"ra_id_sog_comm~" TYPE = number) " arguments=(("ra_id_sog_comm", number))  sort="orafo_metallo_codice A " )
