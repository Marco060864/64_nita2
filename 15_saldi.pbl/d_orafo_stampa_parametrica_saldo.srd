 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"documento~" )  TABLE(NAME=~"articolo~" )  TABLE(NAME=~"riga_documento~" )  TABLE(NAME=~"orafo_titolo~" )  TABLE(NAME=~"orafo_metallo~" ) COLUMN(NAME=~"documento.num_progressivo~") COLUMN(NAME=~"documento.data_registrazione~") COLUMN(NAME=~"riga_documento.id_riga_documento~") COLUMN(NAME=~"riga_documento.id_documento~") COLUMN(NAME=~"riga_documento.id_articolo~") COLUMN(NAME=~"riga_documento.qta_un_base~") COLUMN(NAME=~"riga_documento.id_caus_magazzino~") COLUMN(NAME=~"riga_documento.peso_netto~") COLUMN(NAME=~"riga_documento.tot_riga_val_doc~") COLUMN(NAME=~"riga_documento.tot_riga_val_az~") COLUMN(NAME=~"riga_documento.calo~") COLUMN(NAME=~"riga_documento.fino~") COLUMN(NAME=~"riga_documento.prezzo_metallo~") COLUMN(NAME=~"riga_documento.prezzo_manifattura~") COLUMN(NAME=~"articolo.codice~") COLUMN(NAME=~"articolo.descrizione~") COLUMN(NAME=~"articolo.id_titolo~") COLUMN(NAME=~"orafo_titolo.titolo~") COLUMN(NAME=~"documento.id_sog_commerciale~") COLUMN(NAME=~"orafo_metallo.codice~") COLUMN(NAME=~"orafo_metallo.id_metallo~") COMPUTE(NAME=~"cast(~~~"orafo_metallo~~~".~~~"codice~~~"+' '+string(~~~"orafo_titolo~~~".~~~"titolo~~~") as char(10)) as c_met_tit~") COLUMN(NAME=~"riga_documento.importo_manifattura~") COLUMN(NAME=~"documento.id_valuta~") COMPUTE(NAME=~"cast(0 as decimal) as somma_qta~") COMPUTE(NAME=~"cast (0 as decimal(18,2)) as somma_metallo~") COMPUTE(NAME=~"cast (0 as decimal(18,2)) as somma_manifattura~")    JOIN (LEFT=~"riga_documento.id_articolo~"    OP =~"=~"RIGHT=~"articolo.id_articolo~" )    JOIN (LEFT=~"riga_documento.id_documento~"    OP =~"=~"RIGHT=~"documento.id_documento~" )    JOIN (LEFT=~"orafo_titolo.id_titolo~"    OP =~"=~"RIGHT=~"articolo.id_titolo~" )    JOIN (LEFT=~"orafo_metallo.id_metallo~"    OP =~"=~"RIGHT=~"orafo_titolo.id_metallo~" )WHERE(    EXP1 =~"~~~"documento~~~".~~~"id_documento~~~"~"   OP =~"=~"    EXP2 =~"0~" ) ) "  sort="c_met_tit A " )
