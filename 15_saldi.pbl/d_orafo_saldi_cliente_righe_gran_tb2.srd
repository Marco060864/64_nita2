 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"riga_documento~" )  TABLE(NAME=~"documento~" )  TABLE(NAME=~"orafo_metallo~" )  TABLE(NAME=~"orafo_titolo~" )  TABLE(NAME=~"articolo~" )  TABLE(NAME=~"caus_magazzino~" )  TABLE(NAME=~"orafo_tipo_partita~" ) COLUMN(NAME=~"orafo_metallo.codice~") COLUMN(NAME=~"orafo_titolo.titolo~") COLUMN(NAME=~"riga_documento.qta_un_base~") COLUMN(NAME=~"riga_documento.coef_calo~") COLUMN(NAME=~"riga_documento.calo~") COLUMN(NAME=~"riga_documento.fino~") COLUMN(NAME=~"riga_documento.prezzo_metallo~") COLUMN(NAME=~"riga_documento.prezzo_manifattura~") COLUMN(NAME=~"articolo.codice~") COLUMN(NAME=~"documento.num_progressivo~") COLUMN(NAME=~"documento.data_registrazione~") COLUMN(NAME=~"caus_magazzino.id_tipo_partita~") COLUMN(NAME=~"documento.id_sog_commerciale~") COLUMN(NAME=~"riga_documento.peso_netto~") COLUMN(NAME=~"caus_magazzino.mp_car_fiscali~") COLUMN(NAME=~"caus_magazzino.mp_scar_fiscali~") COLUMN(NAME=~"caus_magazzino.mp_vis_clienti~") COLUMN(NAME=~"caus_magazzino.mp_vis_fornitori~") COLUMN(NAME=~"caus_magazzino.mp_qta_cl_clienti~") COLUMN(NAME=~"caus_magazzino.mp_qta_cl_fornitori~") COLUMN(NAME=~"caus_magazzino.mp_qta_cl_terzi~") COLUMN(NAME=~"caus_magazzino.mp_qta_rim_iniziale~") COLUMN(NAME=~"caus_magazzino.mp_ord_clienti~") COLUMN(NAME=~"caus_magazzino.mp_ord_fornitori~") COLUMN(NAME=~"caus_magazzino.mp_val_caricato~") COLUMN(NAME=~"caus_magazzino.mp_val_scaricato~") COLUMN(NAME=~"caus_magazzino.mp_imp_produzione~") COLUMN(NAME=~"caus_magazzino.mp_ord_produzione~") COLUMN(NAME=~"caus_magazzino.codice~") COLUMN(NAME=~"orafo_tipo_partita.cod_tipo_partita~") COMPUTE(NAME=~"cast(substr(~~~"orafo_tipo_partita~~~".~~~"cod_tipo_partita~~~",2,2) as char(2)) as tipo_partita~") COLUMN(NAME=~"riga_documento.tot_riga_val_az~") COMPUTE(NAME=~"cast(0 as numeric(18,4) ) as fino_saldo~") COMPUTE(NAME=~"cast(0 as numeric(18,4) ) as calo_saldo~") COMPUTE(NAME=~"cast(0 as numeric(18,4) ) as fino_calo_saldo~") COMPUTE(NAME=~"cast(0 as numeric(18,4) ) as lire_saldo~")    JOIN (LEFT=~"riga_documento.id_documento~"    OP =~"=~"RIGHT=~"documento.id_documento~" )    JOIN (LEFT=~"articolo.id_articolo~"    OP =~"=~"RIGHT=~"riga_documento.id_articolo~" )    JOIN (LEFT=~"orafo_titolo.id_titolo~"    OP =~"=~"RIGHT=~"articolo.id_titolo~" )    JOIN (LEFT=~"orafo_titolo.id_metallo~"    OP =~"=~"RIGHT=~"orafo_metallo.id_metallo~" )    JOIN (LEFT=~"caus_magazzino.id_caus_magazzino~"    OP =~"=~"RIGHT=~"riga_documento.id_caus_magazzino~" )    JOIN (LEFT=~"orafo_tipo_partita.id_tipo_partita~"    OP =~"=~"RIGHT=~"caus_magazzino.id_tipo_partita~" )WHERE(    EXP1 =~"~~~"documento~~~".~~~"id_sog_commerciale~~~"~"   OP =~"=~"    EXP2 =~":ra_id_sog_comm~" ) ) ORDER(NAME=~"orafo_metallo.codice~" ASC=yes )  ORDER(NAME=~"documento.data_registrazione~" ASC=yes )  ORDER(NAME=~"documento.num_progressivo~" ASC=yes ) ARG(NAME = ~"ra_id_sog_comm~" TYPE = number) " arguments=(("ra_id_sog_comm", number))  sort="orafo_metallo_codice A data_registrazione A num_progressivo A " )
