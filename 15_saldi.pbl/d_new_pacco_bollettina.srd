table(column=(type=long update=yes updatewhereclause=yes key=yes name=id_pacco dbname="pacco_bollettina.id_pacco" )
 column=(type=long update=yes updatewhereclause=yes key=yes name=id_bollettina dbname="pacco_bollettina.id_bollettina" )
 column=(type=long update=yes updatewhereclause=yes name=numero dbname="pacco_bollettina.numero" )
 column=(type=date update=yes updatewhereclause=yes name=data_pacco dbname="pacco_bollettina.data_pacco" )
 column=(type=char(32) updatewhereclause=yes name=pacco_codice dbname="pacco.codice" )
 column=(type=char(16) updatewhereclause=yes name=num_bollettina dbname="documento.num_documento" )
 column=(type=decimal(4) updatewhereclause=yes name=riga_documento_peso_netto dbname="riga_documento.peso_netto" )
 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"pacco_bollettina~" )  TABLE(NAME=~"pacco~" )  TABLE(NAME=~"documento~" )  TABLE(NAME=~"riga_documento~" ) COLUMN(NAME=~"pacco_bollettina.id_pacco~") COLUMN(NAME=~"pacco_bollettina.id_bollettina~") COLUMN(NAME=~"pacco_bollettina.numero~") COLUMN(NAME=~"pacco_bollettina.data_pacco~") COLUMN(NAME=~"pacco.codice~") COLUMN(NAME=~"documento.num_documento~") COLUMN(NAME=~"riga_documento.peso_netto~")    JOIN (LEFT=~"pacco_bollettina.id_pacco~"    OP =~"=~"RIGHT=~"pacco.id_pacco~" )    JOIN (LEFT=~"riga_documento.id_documento~"    OP =~"=~"RIGHT=~"documento.id_documento~" )    JOIN (LEFT=~"pacco_bollettina.id_bollettina~"    OP =~"=~"RIGHT=~"riga_documento.id_riga_documento~" )WHERE(    EXP1 =~"left(~~~"pacco~~~".~~~"codice~~~", 1)~"   OP =~"=~"    EXP2 =~"'A'~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"pacco_bollettina~~~".~~~"id_pacco~~~"~"   OP =~"=~"    EXP2 =~":id_pacco~" ) ) ARG(NAME = ~"id_pacco~" TYPE = number) " update="pacco_bollettina" updatewhere=1 updatekeyinplace=yes arguments=(("id_pacco", number))  sort="pacco_codice A numero A " )
