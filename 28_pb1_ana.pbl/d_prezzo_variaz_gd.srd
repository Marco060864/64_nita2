 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"articolo~" )  TABLE(NAME=~"prezzo~" )  TABLE(NAME=~"unita_confezione~" )  TABLE(NAME=~"variazione~" )  TABLE(NAME=~"listino~" ) COLUMN(NAME=~"articolo.codice~") COLUMN(NAME=~"articolo.descrizione~") COLUMN(NAME=~"prezzo.id_variazione~") COLUMN(NAME=~"unita_confezione.codice~") COLUMN(NAME=~"unita_confezione.descrizione~") COLUMN(NAME=~"prezzo.id_unita_confezione~") COLUMN(NAME=~"articolo.id_articolo~") COLUMN(NAME=~"prezzo.prezzo~") COLUMN(NAME=~"listino.id_valuta~")    JOIN (LEFT=~"unita_confezione.id_unita_confezione~"    OP =~"=~"RIGHT=~"prezzo.id_unita_confezione~" )    JOIN (LEFT=~"unita_confezione.id_articolo~"    OP =~"=~"RIGHT=~"articolo.id_articolo~" )    JOIN (LEFT=~"variazione.id_variazione~"    OP =~"=~"RIGHT=~"prezzo.id_variazione~" )    JOIN (LEFT=~"listino.id_listino~"    OP =~"=~"RIGHT=~"variazione.id_listino~" )WHERE(    EXP1 =~"( ( ~~~"prezzo~~~".~~~"id_variazione~~~"~"   OP =~"=~"    EXP2 =~":rn_id_variazione ) )~" ) ) ORDER(NAME=~"articolo.codice~" ASC=yes ) ARG(NAME = ~"rn_id_variazione~" TYPE = number) " update="prezzo" updatewhere=1 updatekeyinplace=yes arguments=(("rn_id_variazione", number)) )
