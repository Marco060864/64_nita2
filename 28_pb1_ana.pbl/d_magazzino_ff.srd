//objectcomments datawindow (freeform) per la gestione della tabella magazzino
release 5;
datawindow(units=0 timer_interval=0 color=79741120 processing=0 print.documentname="" print.orientation = 0 print.margin.left = 110 print.margin.right = 110 print.margin.top = 97 print.margin.bottom = 97 print.paper.source = 0 print.paper.size = 0 print.prompt=no )
header(height=1 color="536870912" )
summary(height=5 color="536870912" )
footer(height=1 color="536870912" )
detail(height=1077 color="536870912" )
table(column=(type=long update=yes updatewhereclause=yes key=yes identity=yes name=id_magazzino dbname="magazzino.id_magazzino" )
 column=(type=char(8) update=yes updatewhereclause=yes name=codice dbname="magazzino.codice" )
 column=(type=char(40) update=yes updatewhereclause=yes name=descrizione dbname="magazzino.descrizione" )
 column=(type=char(40) update=yes updatewhereclause=yes name=indirizzo dbname="magazzino.indirizzo" )
 column=(type=char(10) update=yes updatewhereclause=yes name=cap dbname="magazzino.cap" )
 column=(type=char(40) update=yes updatewhereclause=yes name=localita dbname="magazzino.localita" )
 column=(type=char(5) update=yes updatewhereclause=yes name=provincia dbname="magazzino.provincia" )
 column=(type=char(5) update=yes updatewhereclause=yes name=nazione dbname="magazzino.nazione" initial="IT" )
 column=(type=char(32766) update=yes updatewhereclause=no name=note dbname="magazzino.note" )
 column=(type=char(1) update=yes updatewhereclause=yes name=giac_globale dbname="magazzino.giac_globale" initial="S" values="	S/	N" validation=" gettext()  = 'S' OR  gettext()  = 'N'" validationmsg="'Immettere: S, N'" )
 column=(type=long update=yes updatewhereclause=yes name=id_azienda dbname="magazzino.id_azienda" initial="1" )
 column=(type=long update=yes updatewhereclause=yes name=id_tipo_magazzino_des dbname="magazzino.id_tipo_magazzino" )
 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"magazzino~" ) COLUMN(NAME=~"magazzino.id_magazzino~") COLUMN(NAME=~"magazzino.codice~") COLUMN(NAME=~"magazzino.descrizione~") COLUMN(NAME=~"magazzino.indirizzo~") COLUMN(NAME=~"magazzino.cap~") COLUMN(NAME=~"magazzino.localita~") COLUMN(NAME=~"magazzino.provincia~") COLUMN(NAME=~"magazzino.nazione~") COLUMN(NAME=~"magazzino.note~") COLUMN(NAME=~"magazzino.giac_globale~") COLUMN(NAME=~"magazzino.id_azienda~") COLUMN(NAME=~"magazzino.id_tipo_magazzino~")WHERE(    EXP1 =~"( ~~~"magazzino~~~".~~~"id_azienda~~~"~"   OP =~"in~"    EXP2 =~"(0,1) )~" ) ) ORDER(NAME=~"magazzino.codice~" ASC=yes ) " update="magazzino" updatewhere=1 updatekeyinplace=yes )
