 column=(type=decimal(4) updatewhereclause=yes name=riga_documento_peso_netto dbname="riga_documento.peso_netto" )
 column=(type=long updatewhereclause=yes name=documento_id_tipo_trasporto dbname="documento.id_tipo_trasporto" )
 column=(type=char(1) updatewhereclause=yes name=unita_misura_tipo dbname="unita_misura.tipo" )
