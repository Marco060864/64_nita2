 column=(type=decimal(6) updatewhereclause=yes name=riga_documento_prezzo dbname="riga_documento.prezzo" )
 column=(type=decimal(6) updatewhereclause=yes name=riga_documento_prezzo_netto dbname="riga_documento.prezzo_netto" )
 column=(type=long updatewhereclause=yes identity=yes name=valuta_id_valuta dbname="valuta.id_valuta" )
 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"caus_magazzino~" )  TABLE(NAME=~"documento~" )  TABLE(NAME=~"registro~" )  TABLE(NAME=~"riga_documento~" )  TABLE(NAME=~"unita_confezione~" )  TABLE(NAME=~"valuta~" )  TABLE(NAME=~"sog_commerciale_gen~" )  TABLE(NAME=~"unita_misura~" )  TABLE(NAME=~"tipo_trasporto~" ) COLUMN(NAME=~"registro.tipo_registro~") COLUMN(NAME=~"registro.id_mod_registro~") COLUMN(NAME=~"documento.num_progressivo~") COLUMN(NAME=~"documento.data_registrazione~") COLUMN(NAME=~"sog_commerciale_gen.codice~") COLUMN(NAME=~"sog_commerciale_gen.rag_soc_1~") COLUMN(NAME=~"riga_documento.quantita~") COLUMN(NAME=~"riga_documento.qta_sconto_merce~") COLUMN(NAME=~"unita_confezione.codice~") COLUMN(NAME=~"riga_documento.tot_riga_val_riga~") COLUMN(NAME=~"valuta.descrizione~") COLUMN(NAME=~"caus_magazzino.codice~") COLUMN(NAME=~"registro.numero~") COLUMN(NAME=~"caus_magazzino.mp_val_caricato~") COLUMN(NAME=~"caus_magazzino.mp_val_scaricato~") COLUMN(NAME=~"caus_magazzino.md_val_caricato~") COLUMN(NAME=~"caus_magazzino.md_val_scaricato~") COLUMN(NAME=~"riga_documento.sconto~") COLUMN(NAME=~"riga_documento.sconto_riga~") COLUMN(NAME=~"riga_documento.peso_netto~") COLUMN(NAME=~"documento.id_tipo_trasporto~") COLUMN(NAME=~"unita_misura.tipo~") COLUMN(NAME=~"tipo_trasporto.codice~") COLUMN(NAME=~"riga_documento.prezzo~") COLUMN(NAME=~"riga_documento.prezzo_netto~") COLUMN(NAME=~"valuta.id_valuta~")    JOIN (LEFT=~"unita_misura.id_unita_misura~"    OP =~"=~"RIGHT=~"unita_confezione.id_unita_misura~"    OUTER2 =~"unita_confezione.id_unita_misura~" )    JOIN (LEFT=~"tipo_trasporto.id_tipo_trasporto~"    OP =~"=~"RIGHT=~"documento.id_tipo_trasporto~"    OUTER2 =~"documento.id_tipo_trasporto~" )    JOIN (LEFT=~"registro.id_registro~"    OP =~"=~"RIGHT=~"documento.id_registro~" )    JOIN (LEFT=~"riga_documento.id_documento~"    OP =~"=~"RIGHT=~"documento.id_documento~" )    JOIN (LEFT=~"riga_documento.id_caus_magazzino~"    OP =~"=~"RIGHT=~"caus_magazzino.id_caus_magazzino~" )    JOIN (LEFT=~"unita_confezione.id_unita_confezione~"    OP =~"=~"RIGHT=~"riga_documento.id_unita_confezione~" )    JOIN (LEFT=~"valuta.id_valuta~"    OP =~"=~"RIGHT=~"riga_documento.id_valuta~" )    JOIN (LEFT=~"documento.id_sog_commerciale~"    OP =~"=~"RIGHT=~"sog_commerciale_gen.id_sog_commerciale~" )) ORDER(NAME=~"documento.data_registrazione~" ASC=no)  ORDER(NAME=~"documento.num_progressivo~" ASC=no) " )
