 column=(type=char(40) updatewhereclause=yes name=rag_sog_commerciale dbname="sog_commerciale_gen.rag_soc_1" )
 column=(type=char(8) updatewhereclause=yes name=cod_unita_confezione dbname="unita_confezione.codice" )
 column=(type=decimal(4) update=yes updatewhereclause=yes name=approvvigionamento_quantita dbname="approvvigionamento.quantita" )
 column=(type=decimal(0) update=yes updatewhereclause=yes name=approvvigionamento_giorni_consegna dbname="approvvigionamento.giorni_consegna" )
 column=(type=long update=yes updatewhereclause=yes key=yes identity=yes name=approvvigionamento_id_approvvigionamento dbname="approvvigionamento.id_approvvigionamento" )
 column=(type=long update=yes updatewhereclause=yes name=approvvigionamento_id_azienda dbname="approvvigionamento.id_azienda" initial="1" )
 column=(type=long update=yes updatewhereclause=yes name=approvvigionamento_id_sog_commerciale dbname="approvvigionamento.id_sog_commerciale" )
 column=(type=long update=yes updatewhereclause=yes name=approvvigionamento_id_unita_confezione dbname="approvvigionamento.id_unita_confezione" )
 column=(type=long updatewhereclause=yes name=id_articolo dbname="unita_confezione.id_articolo" )
 column=(type=long updatewhereclause=yes name=pers_par_sistema_id_tipo_ann_pa dbname="pers_par_sistema.id_tipo_ann_pa" )
 column=(type=long updatewhereclause=yes name=pers_par_sistema_id_tipo_ann_ca dbname="pers_par_sistema.id_tipo_ann_ca" )
 column=(type=long updatewhereclause=yes name=articolo_id_valuta dbname="articolo.id_valuta" )
 column=(type=char(32) updatewhereclause=yes name=dati_ultimo_costo_fornitore dbname="dati_ultimo_costo_fornitore" )
 column=(type=decimal(4) updatewhereclause=yes name=ultimo_costo_fornitore dbname="ultimo_costo_fornitore" )
 column=(type=char(20) updatewhereclause=yes name=c_prezzo_acquisto dbname="c_prezzo_acquisto" )
 column=(type=char(20) updatewhereclause=yes name=c_costo_aggiuntivo dbname="c_costo_aggiuntivo" )
 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"approvvigionamento~" )  TABLE(NAME=~"sog_commerciale_gen~" )  TABLE(NAME=~"unita_confezione~" )  TABLE(NAME=~"par_sistema~" )  TABLE(NAME=~"pers_par_sistema~" )  TABLE(NAME=~"articolo~" ) COLUMN(NAME=~"sog_commerciale_gen.codice~") COLUMN(NAME=~"sog_commerciale_gen.rag_soc_1~") COLUMN(NAME=~"unita_confezione.codice~") COLUMN(NAME=~"approvvigionamento.quantita~") COLUMN(NAME=~"approvvigionamento.giorni_consegna~") COLUMN(NAME=~"approvvigionamento.id_approvvigionamento~") COLUMN(NAME=~"approvvigionamento.id_azienda~") COLUMN(NAME=~"approvvigionamento.id_sog_commerciale~") COLUMN(NAME=~"approvvigionamento.id_unita_confezione~") COLUMN(NAME=~"unita_confezione.id_articolo~") COLUMN(NAME=~"pers_par_sistema.id_tipo_ann_pa~") COLUMN(NAME=~"pers_par_sistema.id_tipo_ann_ca~") COLUMN(NAME=~"articolo.id_valuta~") COMPUTE(NAME=~"CAST( fn_ultimo_costo_fornitore(1, ~~~"unita_confezione~~~".~~~"id_unita_confezione~~~", ~~~"approvvigionamento~~~".~~~"id_sog_commerciale~~~", ~~~"par_sistema~~~".~~~"id_valuta~~~") AS CHAR(32) ) AS dati_ultimo_costo_fornitore~") COMPUTE(NAME=~"CAST ( SUBSTRING(dati_ultimo_costo_fornitore,1 , 20)  AS DECIMAL(18,4) ) AS ultimo_costo_fornitore~") COMPUTE(NAME=~"CAST( (SELECT MIN(note) FROM annotazione WHERE id_tipo_annotazione = ~~~"pers_par_sistema~~~".~~~"id_tipo_ann_pa~~~" AND id_approvvigionamento = ~~~"approvvigionamento~~~".~~~"id_approvvigionamento~~~") AS CHAR(20)) AS c_prezzo_acquisto~") COMPUTE(NAME=~"CAST( (SELECT MIN(note) FROM annotazione WHERE id_tipo_annotazione = ~~~"pers_par_sistema~~~".~~~"id_tipo_ann_ca~~~" AND id_approvvigionamento = ~~~"approvvigionamento~~~".~~~"id_approvvigionamento~~~") AS CHAR(20)) AS c_costo_aggiuntivo~")    JOIN (LEFT=~"approvvigionamento.id_sog_commerciale~"    OP =~"=~"RIGHT=~"sog_commerciale_gen.id_sog_commerciale~" )    JOIN (LEFT=~"unita_confezione.id_unita_confezione~"    OP =~"=~"RIGHT=~"approvvigionamento.id_unita_confezione~" )    JOIN (LEFT=~"articolo.id_articolo~"    OP =~"=~"RIGHT=~"unita_confezione.id_articolo~" )WHERE(    EXP1 =~"( ( ~~~"approvvigionamento~~~".~~~"id_azienda~~~"~"   OP =~"in~"    EXP2 =~"(0,1) )~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"( ~~~"unita_confezione~~~".~~~"id_articolo~~~"~"   OP =~"=~"    EXP2 =~":rn_id_articolo ) )~" ) ) ARG(NAME = ~"rn_id_articolo~" TYPE = number) " update="approvvigionamento" updatewhere=1 updatekeyinplace=yes arguments=(("rn_id_articolo", number)) )
