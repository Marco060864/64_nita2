 column=(type=char(64) update=yes updatewhereclause=yes name=cod_parte_mas_input dbname="cod_parte.mas_input" )
 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"cod_parte~" )  TABLE(NAME=~"parte_regola~" ) COLUMN(NAME=~"parte_regola.num_sezione~") COLUMN(NAME=~"cod_parte.tipo_richiesta~") COLUMN(NAME=~"cod_parte.id_cat_codifica~") COLUMN(NAME=~"cod_parte.id_cod_parte~") COLUMN(NAME=~"parte_regola.descrizione~") COLUMN(NAME=~"cod_parte.id_parte_regola~") COLUMN(NAME=~"cod_parte.mas_input~")    JOIN (LEFT=~"parte_regola.id_parte_regola~"    OP =~"=~"RIGHT=~"cod_parte.id_parte_regola~" )WHERE(    EXP1 =~"~~~"cod_parte~~~".~~~"id_azienda~~~"~"   OP =~"in~"    EXP2 =~"(0,1)~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"cod_parte~~~".~~~"id_cat_codifica~~~"~"   OP =~"=~"    EXP2 =~":rn_id_cat_codifica~" ) ) ORDER(NAME=~"parte_regola.num_sezione~" ASC=yes ) ARG(NAME = ~"rn_id_cat_codifica~" TYPE = number) " update="cod_parte" updatewhere=0 updatekeyinplace=yes arguments=(("rn_id_cat_codifica", number)) )
