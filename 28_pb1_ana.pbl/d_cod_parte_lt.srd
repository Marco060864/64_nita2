table(column=(type=decimal(0) updatewhereclause=yes name=parte_regola_num_sezione dbname="parte_regola.num_sezione" validation=" real(gettext())  >= 0" validationmsg="'Immettere un valore >= 0'" )
 column=(type=char(1) update=yes updatewhereclause=yes name=cod_parte_tipo_richiesta dbname="cod_parte.tipo_richiesta" initial="R" values="Richiesto	R/Assegnato	A/Facoltativo	F/" validation=" gettext()  = 'R' OR  gettext()  = 'A' OR  gettext()  = 'F'" validationmsg="'Immettere: R, A, F'" )
 column=(type=long update=yes updatewhereclause=yes name=id_cat_codifica dbname="cod_parte.id_cat_codifica" )
