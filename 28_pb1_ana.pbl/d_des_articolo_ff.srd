detail(height=1096 color="536870912" )
table(column=(type=long update=yes updatewhereclause=yes identity=yes name=id_des_articolo dbname="des_articolo.id_des_articolo" )
 column=(type=long update=yes updatewhereclause=yes key=yes name=id_sog_commerciale dbname="des_articolo.id_sog_commerciale" )
 column=(type=char(8) updatewhereclause=yes name=c_sog_commerciale_codice dbname="_sog_commerciale_codice" )
 column=(type=char(40) updatewhereclause=yes name=c_anagrafica_rag_soc_1 dbname="_anagrafica_rag_soc_1" )
 column=(type=char(40) update=yes updatewhereclause=yes name=descrizione dbname="des_articolo.descrizione" )
 column=(type=long update=yes updatewhereclause=yes key=yes name=id_linguaggio_des dbname="des_articolo.id_linguaggio" )
 column=(type=char(32766) update=yes updatewhereclause=no name=des_estesa dbname="des_articolo.des_estesa" )
 column=(type=long update=yes updatewhereclause=yes name=id_azienda dbname="des_articolo.id_azienda" initial="1" )
 column=(type=long update=yes updatewhereclause=yes key=yes name=id_articolo dbname="des_articolo.id_articolo" )
 column=(type=long update=yes updatewhereclause=yes key=yes name=id_lingua_des dbname="des_articolo.id_lingua" )
 column=(type=char(32) update=yes updatewhereclause=yes name=codice dbname="des_articolo.codice" )
 column=(type=char(5) update=yes updatewhereclause=yes key=yes name=simbolo_um dbname="des_articolo.simbolo_um" initial="XX" )
 column=(type=decimal(4) update=yes updatewhereclause=yes key=yes name=lunghezza dbname="des_articolo.lunghezza" initial="0" )
 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"des_articolo~" ) COLUMN(NAME=~"des_articolo.id_des_articolo~") COLUMN(NAME=~"des_articolo.id_sog_commerciale~") COMPUTE(NAME=~"cast('' as char(8)) as _sog_commerciale_codice~") COMPUTE(NAME=~"cast('' as char(40)) as _anagrafica_rag_soc_1~") COLUMN(NAME=~"des_articolo.descrizione~") COLUMN(NAME=~"des_articolo.id_linguaggio~") COLUMN(NAME=~"des_articolo.des_estesa~") COLUMN(NAME=~"des_articolo.id_azienda~") COLUMN(NAME=~"des_articolo.id_articolo~") COLUMN(NAME=~"des_articolo.id_lingua~") COLUMN(NAME=~"des_articolo.codice~") COLUMN(NAME=~"des_articolo.simbolo_um~") COLUMN(NAME=~"des_articolo.lunghezza~")WHERE(    EXP1 =~"( ~~~"des_articolo~~~".~~~"id_azienda~~~"~"   OP =~"in~"    EXP2 =~"(0,1) )~" ) ) " update="des_articolo" updatewhere=1 updatekeyinplace=yes )
