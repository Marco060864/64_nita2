 column=(type=char(1) update=yes updatewhereclause=yes name=app_conversione dbname="unita_confezione.app_conversione" initial="F" values="Fattore Fisso	F/Fattore Variabile	V/Dalla Quantità	Q/" validation=" gettext()  = 'F' OR  gettext()  = 'V' OR  gettext()  = 'Q'" validationmsg="'Immettere: F, V, Q'" )
 column=(type=decimal(4) update=yes updatewhereclause=yes name=fat_conversione dbname="unita_confezione.fat_conversione" initial="1" validation=" real(gettext())  >= 0" validationmsg="'Immettere un valore >= 0'" )
