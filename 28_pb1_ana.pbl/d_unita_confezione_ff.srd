 column=(type=char(1) update=yes updatewhereclause=yes name=unita_prezzo dbname="unita_confezione.unita_prezzo" initial="N" values="	S/	N" validation=" gettext()  = 'S' OR  gettext()  = 'N'" validationmsg="'Immettere: S, N'" )
