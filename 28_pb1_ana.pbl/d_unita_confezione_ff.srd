table(column=(type=long update=yes updatewhereclause=yes identity=yes name=id_unita_confezione dbname="unita_confezione.id_unita_confezione" )
 column=(type=char(8) update=yes updatewhereclause=yes key=yes name=codice dbname="unita_confezione.codice" )
