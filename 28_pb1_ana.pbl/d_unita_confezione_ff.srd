 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"unita_confezione~" ) COLUMN(NAME=~"unita_confezione.id_unita_confezione~") COLUMN(NAME=~"unita_confezione.codice~") COLUMN(NAME=~"unita_confezione.id_unita_misura~") COLUMN(NAME=~"unita_confezione.descrizione~") COLUMN(NAME=~"unita_confezione.app_conversione~") COLUMN(NAME=~"unita_confezione.fat_conversione~") COLUMN(NAME=~"unita_confezione.tipo_conversione~") COLUMN(NAME=~"unita_confezione.molteplicita~") COLUMN(NAME=~"unita_confezione.qta_minima~") COLUMN(NAME=~"unita_confezione.qta_massima~") COLUMN(NAME=~"unita_confezione.id_unita_mis_peso~") COLUMN(NAME=~"unita_confezione.peso_netto~") COLUMN(NAME=~"unita_confezione.peso_lordo~") COLUMN(NAME=~"unita_confezione.id_unita_mis_volume~") COLUMN(NAME=~"unita_confezione.dim_l~") COLUMN(NAME=~"unita_confezione.dim_h~") COLUMN(NAME=~"unita_confezione.dim_p~") COLUMN(NAME=~"unita_confezione.unita_base~") COLUMN(NAME=~"unita_confezione.unita_prezzo~") COLUMN(NAME=~"unita_confezione.unita_documenti~") COLUMN(NAME=~"unita_confezione.unita_produzione~") COLUMN(NAME=~"unita_confezione.id_azienda~") COLUMN(NAME=~"unita_confezione.id_articolo~") COLUMN(NAME=~"unita_confezione.num_colli~")WHERE(    EXP1 =~"~~~"unita_confezione~~~".~~~"id_azienda~~~"~"   OP =~"in~"    EXP2 =~"(0,1)~" ) ) " update="unita_confezione" updatewhere=1 updatekeyinplace=yes )
