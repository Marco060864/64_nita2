 column=(type=long updatewhereclause=yes name=con_lis_articolo_id_valuta dbname="con_lis_articolo.id_valuta" )
 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"con_lis_articolo~" )  TABLE(NAME=~"articolo~" ALIAS=~"articolo_a~" )  TABLE(NAME=~"articolo~" ALIAS=~"articolo_b~" )  TABLE(NAME=~"articolo~" ALIAS=~"articolo_c~" )  TABLE(NAME=~"sog_commerciale~" )  TABLE(NAME=~"cat_com_sc~" ) COLUMN(NAME=~"con_lis_articolo.tipo_applicazione~") COLUMN(NAME=~"con_lis_articolo.percentuali~") COLUMN(NAME=~"con_lis_articolo.spesa~") COLUMN(NAME=~"con_lis_articolo.spesa_fissa~") COLUMN(NAME=~"con_lis_articolo.priorita~") COLUMN(NAME=~"con_lis_articolo.stato~") COLUMN(NAME=~"con_lis_articolo.data_inizio~") COLUMN(NAME=~"con_lis_articolo.data_fine~") COLUMN(NAME=~"sog_commerciale.codice~") COLUMN(NAME=~"cat_com_sc.codice~") COLUMN(NAME=~"con_lis_articolo.importo~") COLUMN(NAME=~"con_lis_articolo.id_valuta~")    JOIN (LEFT=~"articolo_b.id_articolo~"    OP =~"=~"RIGHT=~"con_lis_articolo.id_art_a~"    OUTER2 =~"con_lis_articolo.id_art_a~" )    JOIN (LEFT=~"sog_commerciale.id_sog_commerciale~"    OP =~"=~"RIGHT=~"con_lis_articolo.id_sog_commerciale~"    OUTER2 =~"con_lis_articolo.id_sog_commerciale~" )    JOIN (LEFT=~"cat_com_sc.id_cat_com_sc~"    OP =~"=~"RIGHT=~"con_lis_articolo.id_cat_com_sc~"    OUTER2 =~"con_lis_articolo.id_cat_com_sc~" )    JOIN (LEFT=~"articolo_a.id_articolo~"    OP =~"=~"RIGHT=~"con_lis_articolo.id_art_da~" )WHERE(    EXP1 =~"~~~"articolo_a~~~".~~~"codice~~~"~"   OP =~">=~"    EXP2 =~"~~~"articolo_c~~~".~~~"codice~~~"~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"( ~~~"articolo_b~~~".~~~"codice~~~"~"   OP =~"is~"    EXP2 =~"NULL~"    LOGIC =~"or~" ) WHERE(    EXP1 =~"~~~"articolo_b~~~".~~~"codice~~~"~"   OP =~"<=~"    EXP2 =~"~~~"articolo_c~~~".~~~"codice~~~" )~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"articolo_c~~~".~~~"id_articolo~~~"~"   OP =~"=~"    EXP2 =~":rn_id_articolo~" ) ) ARG(NAME = ~"rn_id_articolo~" TYPE = number) " arguments=(("rn_id_articolo", number)) )
