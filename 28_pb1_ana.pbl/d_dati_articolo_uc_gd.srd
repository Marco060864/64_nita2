 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"unita_confezione~" )  TABLE(NAME=~"cod_barre~" )  TABLE(NAME=~"unita_misura~" ) COLUMN(NAME=~"unita_confezione.id_unita_confezione~") COLUMN(NAME=~"unita_confezione.id_articolo~") COLUMN(NAME=~"unita_confezione.codice~") COLUMN(NAME=~"unita_confezione.descrizione~") COLUMN(NAME=~"cod_barre.id_cod_barre~") COLUMN(NAME=~"cod_barre.id_tipo_cod_barre~") COLUMN(NAME=~"cod_barre.codice~") COLUMN(NAME=~"cod_barre.gen_automatica~") COLUMN(NAME=~"unita_confezione.unita_base~") COLUMN(NAME=~"unita_confezione.id_unita_misura~") COLUMN(NAME=~"unita_misura.descrizione~") COLUMN(NAME=~"unita_misura.tipo~")    JOIN (LEFT=~"cod_barre.id_unita_confezione~"    OP =~"=~"RIGHT=~"unita_confezione.id_unita_confezione~"    OUTER2 =~"unita_confezione.id_unita_confezione~" )    JOIN (LEFT=~"unita_misura.id_unita_misura~"    OP =~"=~"RIGHT=~"unita_confezione.id_unita_misura~"    OUTER2 =~"unita_confezione.id_unita_misura~" )WHERE(    EXP1 =~"~~~"unita_confezione~~~".~~~"id_articolo~~~"~"   OP =~"=~"    EXP2 =~":rn_id_articolo~" ) ) ARG(NAME = ~"rn_id_articolo~" TYPE = number) " arguments=(("rn_id_articolo", number)) )
