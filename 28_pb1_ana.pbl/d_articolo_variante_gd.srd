 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"articolo~" )  TABLE(NAME=~"sog_commerciale_gen~" )  TABLE(NAME=~"cat_codifica~" )  TABLE(NAME=~"parte_regola~" )  TABLE(NAME=~"anagrafica~" )  TABLE(NAME=~"sog_commerciale~" ) COLUMN(NAME=~"articolo.id_articolo~") COLUMN(NAME=~"articolo.id_cat_codifica~") COLUMN(NAME=~"articolo.codice~") COLUMN(NAME=~"articolo.descrizione~") COLUMN(NAME=~"articolo.des_breve~") COLUMN(NAME=~"articolo.prod_interna~") COLUMN(NAME=~"parte_regola.variante~") COLUMN(NAME=~"cat_codifica.codice~") COLUMN(NAME=~"sog_commerciale_gen.codice~") COLUMN(NAME=~"sog_commerciale_gen.rag_soc_1~") COLUMN(NAME=~"articolo.id_sog_comm_variante~") COLUMN(NAME=~"sog_commerciale.id_sog_commerciale~") COLUMN(NAME=~"anagrafica.id_lingua~") COLUMN(NAME=~"anagrafica.id_linguaggio~") COMPUTE(NAME=~"cast((select codice from des_articolo where id_articolo=~~~"articolo~~~".~~~"id_articolo~~~" and id_sog_commerciale=~~~"articolo~~~".~~~"id_sog_comm_variante~~~" and id_lingua=~~~"anagrafica~~~".~~~"id_lingua~~~" and simbolo_um='XX' ) as varchar(32)) as descodice~")    JOIN (LEFT=~"articolo.id_sog_comm_variante~"    OP =~"=~"RIGHT=~"sog_commerciale_gen.id_sog_commerciale~"    OUTER1 =~"articolo.id_sog_comm_variante~" )    JOIN (LEFT=~"sog_commerciale.id_anagrafica~"    OP =~"=~"RIGHT=~"anagrafica.id_anagrafica~"    OUTER1 =~"sog_commerciale.id_anagrafica~" )    JOIN (LEFT=~"sog_commerciale.id_sog_commerciale~"    OP =~"=~"RIGHT=~"articolo.id_sog_comm_variante~"    OUTER2 =~"articolo.id_sog_comm_variante~" )    JOIN (LEFT=~"cat_codifica.id_cat_codifica~"    OP =~"=~"RIGHT=~"articolo.id_cat_codifica~" )    JOIN (LEFT=~"parte_regola.id_scomposizione~"    OP =~"=~"RIGHT=~"cat_codifica.id_scomposizione~" )WHERE(    EXP1 =~"( ~~~"parte_regola~~~".~~~"variante~~~"~"   OP =~"=~"    EXP2 =~"'S' )~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"articolo~~~".~~~"codice~~~"~"   OP =~"like~"    EXP2 =~":rs_codice~" ) ) ARG(NAME = ~"rs_codice~" TYPE = string) " arguments=(("rs_codice", string))  sort="sog_commerciale_gen_codice A sog_commerciale_gen_rag_soc_1 A " )
