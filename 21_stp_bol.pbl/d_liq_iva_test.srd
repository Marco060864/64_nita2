(18,4)) as ult_iva_credito~") COLUMN(NAME=~"sede.indirizzo~") COLUMN(NAME=~"sede.cap~") COLUMN(NAME=~"sede.localita~") COLUMN(NAME=~"sede.provincia~") COLUMN(NAME=~"azienda.par_iva~") COLUMN(NAME=~"azienda.cciaa~") COLUMN(NAME=~"azienda.trib_iscrizione~")    JOIN (LEFT=~"ws_liquidazione_iva.id_attivita~"    OP =~"=~"RIGHT=~"attivita.id_attivita~" )    JOIN (LEFT=~"azienda.id_attivita~"    OP =~"=~"RIGHT=~"attivita.id_attivita~" )    JOIN (LEFT=~"azienda.id_azienda~"    OP =~"=~"RIGHT=~"par_sistema.id_azienda~" )    JOIN (LEFT=~"azienda.id_azienda~"    OP =~"=~"RIGHT=~"sede.id_azienda~" )WHERE(    EXP1 =~"( ~~~"ws_liquidazione_iva~~~".~~~"id_attivita~~~"~"   OP =~"=~"    EXP2 =~":rn_id_attivita )~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"( ( ~~~"ws_liquidazione_iva~~~".~~~"data_comp_liq_iva~~~"~"   OP =~">=~"    EXP2 =~":rn_data_in )~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"( ~~~"ws_liquidazione_iva~~~".~~~"data_comp_liq_iva~~~"~"   OP =~"<=~"    EXP2 =~":rn_data_fin ) )~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"azienda~~~".~~~"id_azienda~~~"~"   OP =~"=~"    EXP2 =~"1~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"ws_liquidazione_iva~~~".~~~"st_liquidazione~~~"~"   OP =~"=~"    EXP2 =~"'N'~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"ws_liquidazione_iva~~~".~~~"id_mod_registro~~~"~"   OP =~"<>~"    EXP2 =~":reg_sosp~" ) ) ORDER(NAME=~"ws_liquidazione_iva.codice~" ASC=yes )  ORDER(NAME=~"ws_liquidazione_iva.tipo_registro~" ASC=yes ) ARG(NAME = ~"rn_flag~" TYPE = string)  ARG(NAME = ~"rn_id_attivita~" TYPE = number)  ARG(NAME = ~"rn_data_in~" TYPE = date)  ARG(NAME = ~"rn_data_fin~" TYPE = date)  ARG(NAME = ~"rn_c_imposta~" TYPE = number)  ARG(NAME = ~"rn_acconto~" TYPE = number)  ARG(NAME = ~"rn_c_periodo~" TYPE = number)  ARG(NAME = ~"rn_ges_periodo~" TYPE = string)  ARG(NAME = ~"reg_sosp~" TYPE = number) " arguments=(("rn_flag", string),("rn_id_attivita", number),("rn_data_in", date),("rn_data_fin", date),("rn_c_imposta", number),("rn_acconto", number),("rn_c_periodo", 