 column=(type=decimal(4) updatewhereclause=yes name=tot_corr dbname="tot_corr" )
 column=(type=decimal(4) updatewhereclause=yes name=cc_imposta dbname="c_imposta" )
 column=(type=decimal(4) updatewhereclause=yes name=cc_periodo dbname="c_periodo" )
 column=(type=decimal(4) updatewhereclause=yes name=cacconto dbname="acconto" )
 column=(type=char(1) updatewhereclause=yes name=cges_periodo dbname="ges_periodo" )
 retrieve="  SELECT ~"ws_liquidazione_iva~".~"id_esercizio~",   
         ~"ws_liquidazione_iva~".~"id_attivita~",   
         ~"ws_liquidazione_iva~".~"tipo_registro~",   
         ~"ws_liquidazione_iva~".~"data_comp_liq_iva~",   
         ~"ws_liquidazione_iva~".~"id_reg_pd~",   
         ~"ws_liquidazione_iva~".~"segno_reg_iva~",   
         ~"ws_liquidazione_iva~".~"imponibile~",   
         ~"ws_liquidazione_iva~".~"imposta~",   
         ~"ws_liquidazione_iva~".~"id_tab_iva~",   
         ~"ws_liquidazione_iva~".~"codice~",   
         ~"ws_liquidazione_iva~".~"descrizione~",   
         ~"ws_liquidazione_iva~".~"des_breve~",   
         ~"ws_liquidazione_iva~".~"tipo_iva~",   
         ~"ws_liquidazione_iva~".~"per_aliquota~",   
         ~"ws_liquidazione_iva~".~"per_detrazione~",   
         ~"ws_liquidazione_iva~".~"per_ventilazione~",   
         ~"ws_liquidazione_iva~".~"ges_plafond~",   
         ~"attivita~".~"descrizione~",   
         ~"azienda~".~"rag_soc_1~",   
         ~"ws_liquidazione_iva~".~"usa_prorata~",   
         ~"ws_liquidazione_iva~".~"ges_sco_giornaliero~",   
         ~"ws_liquidazione_iva~".~"ges_beni_strumentali~",   
         ~"ws_liquidazione_iva~".~"ges_beni_rivendita~",   
         ~"attivita~".~"liq_iva~",   
         ~"par_sistema~".~"per_iva_trimestrale~",   
         ~"ws_liquidazione_iva~".~"st_liquidazione~",   
         ~"attivita~".~"attuale_plafond~",   
         cast(0 as decimal(18,4)) as per_prorata,   
         cast(0 as decimal(18,4)) as ult_iva_credito,   
         cast(0 as decimal(18,4)) as deb_prec,   
         cast(0 as decimal(18,4)) as tot_corr,   
         cast(:rn_c_imposta as decimal(18,4)) as c_imposta,   
         cast(:rn_c_periodo as decimal(18,4)) as c_periodo,   
         cast(:rn_acconto as decimal(18,4)) as acconto,   
         cast(:rn_ges_periodo as char) as ges_periodo  
    FROM ~"ws_liquidazione_iva~",   
         ~"attivita~",   
         ~"azienda~",   
         ~"par_sistema~"  
   WHERE ( ~"ws_liquidazione_iva~".~"id_attivita~" = ~"attivita~".~"id_attivita~" ) and  
         ( ~"azienda~".~"id_attivita~" = ~"attivita~".~"id_attivita~" ) and  
         ( ~"azienda~".~"id_azienda~" = ~"par_sistema~".~"id_azienda~" ) and  
         ( ~"ws_liquidazione_iva~".~"id_attivita~" = :rn_id_attivita ) AND  
         ( ( ~"ws_liquidazione_iva~".~"data_comp_liq_iva~" >= :rn_data_in ) AND  
         ( ~"ws_liquidazione_iva~".~"data_comp_liq_iva~" <= :rn_data_fin ) ) AND  
         ~"azienda~".~"id_azienda~" = 1 AND  
         ~"ws_liquidazione_iva~".~"st_liquidazione~" = :rn_flag AND  
         ~"ws_liquidazione_iva~".~"id_mod_registro~" <> :reg_sosp AND  
         ~"ws_liquidazione_iva~".~"tipo_registro~" <>'IC'   
ORDER BY ~"ws_liquidazione_iva~".~"codice~" ASC,   
         ~"ws_liquidazione_iva~".~"tipo_registro~" ASC   
" arguments=(("rn_flag", string),("rn_id_attivita", number),("rn_data_in", date),("rn_data_fin", date),("rn_c_imposta", number),("rn_acconto", number),("rn_c_periodo", number),("rn_ges_periodo", string),("reg_sosp", number),("rd_corr", number)) )
group(level=1 header.height=352 trailer.height=76 by=("tipo_registro" ) header.color="553648127" trailer.color="553648127"  sort="tipo_registro D " )
group(level=2 header.height=0 trailer.height=76 by=("tipo_registro" , "codice" ) header.color="536870912" trailer.color="536870912"  sort="tipo_registro A codice A " )
