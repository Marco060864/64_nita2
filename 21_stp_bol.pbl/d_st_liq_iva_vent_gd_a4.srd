 column=(type=char(2) updatewhereclause=yes name=tipo_registro dbname="ws_liquidazione_iva.tipo_registro" )
 column=(type=date updatewhereclause=yes name=data_comp_liq_iva dbname="ws_liquidazione_iva.data_comp_liq_iva" )
 column=(type=long updatewhereclause=yes identity=yes name=id_reg_pd dbname="ws_liquidazione_iva.id_reg_pd" )
 column=(type=decimal(0) updatewhereclause=yes name=segno dbname="ws_liquidazione_iva.segno_reg_iva" )
