 column=(type=decimal(6) updatewhereclause=yes name=riga_documento_tot_riga_val_az dbname="riga_documento.tot_riga_val_az" dbalias="Riga_Documento.tot_riga_val_az" )
 column=(type=long updatewhereclause=yes name=riga_documento_id_riga_doc_provenienza dbname="riga_documento.id_riga_doc_provenienza" dbalias="Riga_Documento.id_riga_doc_provenienza" )
