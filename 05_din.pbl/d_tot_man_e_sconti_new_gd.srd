table(column=(type=long updatewhereclause=yes identity=yes name=id_documento dbname="documento.id_documento" )
 column=(type=long updatewhereclause=yes name=id_valuta dbname="documento.id_valuta" )
 column=(type=decimal(4) updatewhereclause=yes name=sconto_fin_incondizionato dbname="documento.sconto_fin_incondizionato" )
 column=(type=decimal(2) updatewhereclause=yes name=sconto_fin_cassa dbname="documento.sconto_fin_cassa" )
 column=(type=decimal(6) updatewhereclause=yes name=tot_riga_val_riga dbname="riga_documento.tot_riga_val_riga" )
 column=(type=decimal(4) updatewhereclause=yes name=importo_manifattura dbname="riga_documento.importo_manifattura" )
 column=(type=decimal(4) updatewhereclause=yes name=importo_manifattura_val dbname="riga_documento.importo_manifattura_val" )
 column=(type=char(1) updatewhereclause=yes name=cod_int_met dbname="orafo_metallo.cod_int_met" )
 column=(type=char(2) updatewhereclause=yes name=orafo_metallo_codice dbname="orafo_metallo.codice" )
 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"DBA.documento~" ALIAS=~"documento~" )  TABLE(NAME=~"DBA.riga_documento~" ALIAS=~"riga_documento~" )  TABLE(NAME=~"DBA.articolo~" ALIAS=~"articolo~" )  TABLE(NAME=~"DBA.orafo_titolo~" ALIAS=~"orafo_titolo~" )  TABLE(NAME=~"DBA.orafo_metallo~" ALIAS=~"orafo_metallo~" ) COLUMN(NAME=~"documento.id_documento~") COLUMN(NAME=~"documento.id_valuta~") COLUMN(NAME=~"documento.sconto_fin_incondizionato~") COLUMN(NAME=~"documento.sconto_fin_cassa~") COLUMN(NAME=~"riga_documento.tot_riga_val_riga~") COLUMN(NAME=~"riga_documento.importo_manifattura~") COLUMN(NAME=~"riga_documento.importo_manifattura_val~") COLUMN(NAME=~"orafo_metallo.cod_int_met~") COLUMN(NAME=~"orafo_metallo.codice~")    JOIN (LEFT=~"documento.id_documento~"    OP =~"=~"RIGHT=~"riga_documento.id_documento~"    OUTER1 =~"documento.id_documento~" )    JOIN (LEFT=~"riga_documento.id_articolo~"    OP =~"=~"RIGHT=~"articolo.id_articolo~"    OUTER1 =~"riga_documento.id_articolo~" )    JOIN (LEFT=~"articolo.id_titolo~"    OP =~"=~"RIGHT=~"orafo_titolo.id_titolo~"    OUTER1 =~"articolo.id_titolo~" )    JOIN (LEFT=~"orafo_titolo.id_metallo~"    OP =~"=~"RIGHT=~"orafo_metallo.id_metallo~"    OUTER1 =~"orafo_titolo.id_metallo~" )WHERE(    EXP1 =~"documento.~~~"id_documento~~~"~"   OP =~"=~"    EXP2 =~":ra_id_doc~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"orafo_metallo.~~~"cod_int_met~~~"~"   OP =~">~"    EXP2 =~"''~" ) ) ORDER(NAME=~"documento.id_documento~" ASC=yes ) ARG(NAME = ~"ra_id_doc~" TYPE = number) " arguments=(("ra_id_doc", number))  sort="orafo_metallo_codice A cod_int_met A " )
