 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"articolo~" )  TABLE(NAME=~"documento~" ALIAS=~"documento_a~" )  TABLE(NAME=~"riga_documento~" ALIAS=~"riga_documento_a~" )  TABLE(NAME=~"documento~" ALIAS=~"documento_b~" )  TABLE(NAME=~"riga_documento~" ALIAS=~"riga_documento_b~" )  TABLE(NAME=~"sog_commerciale_gen~" )  TABLE(NAME=~"prof_documento~" )  TABLE(NAME=~"orafo_titolo~" ) COLUMN(NAME=~"documento_a.id_documento~") COLUMN(NAME=~"documento_a.num_progressivo~") COLUMN(NAME=~"documento_a.num_documento~") COLUMN(NAME=~"documento_a.data_documento~") COLUMN(NAME=~"riga_documento_a.id_riga_documento~") COLUMN(NAME=~"riga_documento_a.id_unita_confezione~") COLUMN(NAME=~"riga_documento_a.num_riga~") COLUMN(NAME=~"riga_documento_a.quantita~") COLUMN(NAME=~"articolo.id_articolo~") COLUMN(NAME=~"articolo.codice~") COLUMN(NAME=~"riga_documento_a.descrizione~") COLUMN(NAME=~"riga_documento_a.peso_netto~") COLUMN(NAME=~"documento_a.id_prof_documento~") COLUMN(NAME=~"documento_b.num_documento~") COLUMN(NAME=~"documento_b.data_prev_consegna~") COLUMN(NAME=~"riga_documento_b.id_gruppo_agenti_2~") COLUMN(NAME=~"documento_a.data_ora_creazione~") COLUMN(NAME=~"sog_commerciale_gen.codice~") COLUMN(NAME=~"sog_commerciale_gen.rag_soc_1~") COLUMN(NAME=~"prof_documento.codice~") COLUMN(NAME=~"riga_documento_a.provv_imp_carea_2~") COLUMN(NAME=~"riga_documento_a.provv_imp_agente_2~") COLUMN(NAME=~"orafo_titolo.titolo~") COMPUTE(NAME=~"(select data_ora_modifica from dba.riga_doc_estensione where id_riga_documento=riga_documento_a.provv_imp_subage_2) as c_data_ora~")    JOIN (LEFT=~"documento_b.id_documento~"    OP =~"=~"RIGHT=~"riga_documento_b.id_documento~"    OUTER2 =~"riga_documento_b.id_documento~" )    JOIN (LEFT=~"riga_documento_a.provv_imp_subage_2~"    OP =~"=~"RIGHT=~"riga_documento_b.id_riga_documento~"    OUTER1 =~"riga_documento_a.provv_imp_subage_2~" )    JOIN (LEFT=~"riga_documento_a.id_articolo~"    OP =~"=~"RIGHT=~"articolo.id_articolo~"    OUTER1 =~"riga_documento_a.id_articolo~" )    JOIN (LEFT=~"articolo.id_titolo~"    OP =~"=~"RIGHT=~"orafo_titolo.id_titolo~"    OUTER1 =~"articolo.id_titolo~" )    JOIN (LEFT=~"riga_documento_a.id_documento~"    OP =~"=~"RIGHT=~"documento_a.id_documento~" )    JOIN (LEFT=~"documento_a.id_sog_commerciale~"    OP =~"=~"RIGHT=~"sog_commerciale_gen.id_sog_commerciale~" )    JOIN (LEFT=~"documento_a.id_prof_documento~"    OP =~"=~"RIGHT=~"prof_documento.id_prof_documento~" )WHERE(    EXP1 =~"~~~"documento_a~~~".~~~"id_documento~~~"~"   OP =~"=~"    EXP2 =~":id_doc~" ) ) ARG(NAME = ~"id_doc~" TYPE = number) " arguments=(("id_doc", number)) )
