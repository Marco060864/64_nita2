summary(height=1629 color="536870912" )
footer(height=4995 color="536870912" )
detail(height=0 color="553648127"  height.autosize=yes)
table(column=(type=long updatewhereclause=yes identity=yes name=id_documento dbname="documento.id_documento" )
 column=(type=char(16) updatewhereclause=yes name=num_documento dbname="documento.num_documento" )
 column=(type=date updatewhereclause=yes name=data_documento dbname="documento.data_documento" )
 column=(type=char(40) updatewhereclause=yes name=asp_beni dbname="documento.asp_beni" )
 column=(type=char(1) updatewhereclause=yes name=tras_mezzo dbname="documento.tras_mezzo" )
 column=(type=decimal(0) updatewhereclause=yes name=num_riga dbname="documento.num_riga" )
 column=(type=char(32766) updatewhereclause=no name=des_riga dbname="documento.des_riga" )
 column=(type=decimal(4) updatewhereclause=yes name=quantita dbname="documento.quantita" )
 column=(type=decimal(4) updatewhereclause=yes name=peso_netto dbname="documento.peso_netto" )
 column=(type=decimal(6) updatewhereclause=yes name=tot_riga_val_riga dbname="documento.tot_riga_val_riga" )
