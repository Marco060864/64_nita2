 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"cast_iva_documento~" )  TABLE(NAME=~"documento~" )  TABLE(NAME=~"valuta~" )  TABLE(NAME=~"lingua~" )  TABLE(NAME=~"tab_iva~" ) COLUMN(NAME=~"valuta.codice~") COLUMN(NAME=~"valuta.simbolo~") COLUMN(NAME=~"cast_iva_documento.val_tot_imp_v~") COLUMN(NAME=~"cast_iva_documento.val_tot_iva_v~") COLUMN(NAME=~"valuta.id_valuta~") COLUMN(NAME=~"documento.imp_acconto~") COLUMN(NAME=~"documento.cambio~") COLUMN(NAME=~"cast_iva_documento.val_tot_imp_l~") COLUMN(NAME=~"cast_iva_documento.val_tot_iva_l~") COLUMN(NAME=~"lingua.codice~") COLUMN(NAME=~"tab_iva.per_aliquota~") COLUMN(NAME=~"valuta.parita_euro~") COLUMN(NAME=~"documento.id_prof_documento~") COLUMN(NAME=~"documento.id_sog_commerciale~") COLUMN(NAME=~"valuta.cambio~")    JOIN (LEFT=~"lingua.id_lingua~"    OP =~"=~"RIGHT=~"documento.id_lingua~"    OUTER2 =~"documento.id_lingua~" )    JOIN (LEFT=~"documento.id_documento~"    OP =~"=~"RIGHT=~"cast_iva_documento.id_documento~" )    JOIN (LEFT=~"valuta.id_valuta~"    OP =~"=~"RIGHT=~"documento.id_valuta~" )    JOIN (LEFT=~"cast_iva_documento.id_tab_iva~"    OP =~"=~"RIGHT=~"tab_iva.id_tab_iva~" )WHERE(    EXP1 =~"~~~"cast_iva_documento~~~".~~~"id_documento~~~"~"   OP =~"=~"    EXP2 =~":ra_id_doc~" ) ) ARG(NAME = ~"ra_id_doc~" TYPE = number) " arguments=(("ra_id_doc", number)) )
