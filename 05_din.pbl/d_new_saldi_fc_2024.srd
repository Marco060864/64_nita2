table(column=(type=decimal(4) updatewhereclause=yes name=riga_documento_peso_netto dbname="riga_documento.peso_netto" )
 column=(type=decimal(2) updatewhereclause=yes name=riga_documento_coef_calo dbname="riga_documento.coef_calo" )
 column=(type=decimal(4) updatewhereclause=yes name=riga_documento_peso_non_prezioso dbname="riga_documento.peso_non_prezioso" )
 column=(type=decimal(2) updatewhereclause=yes name=orafo_titolo_titolo dbname="orafo_titolo.titolo" )
 column=(type=char(2) updatewhereclause=yes name=orafo_metallo_codice dbname="orafo_metallo.codice" )
 column=(type=char(4) updatewhereclause=yes name=c_tipo_partita dbname="c_tipo_partita" )
 column=(type=char(1) updatewhereclause=yes name=caus_magazzino_saldi_cl_fino dbname="caus_magazzino.saldi_cl_fino" )
 column=(type=date updatewhereclause=yes name=documento_data_documento dbname="documento.data_documento" )
 column=(type=char(32) updatewhereclause=yes name=documento_num_documento dbname="documento.num_documento" )
 column=(type=decimal(0) updatewhereclause=yes name=riga_documento_num_riga dbname="riga_documento.num_riga" )
 retrieve="    SELECT  ~"riga_documento~".~"peso_netto~",   ~"riga_documento~".~"coef_calo~",   ~"riga_documento~".~"peso_non_prezioso~",
         ~"orafo_titolo~".~"titolo~",  ~"orafo_metallo~".~"codice~",   
      (select cod_tipo_partita from orafo_tipo_partita where orafo_tipo_partita.id_tipo_partita = caus_magazzino.id_tipo_partita) as c_tipo_partita ,
	~"caus_magazzino~".~"saldi_cl_fino~", ~"documento~".~"data_documento~",~"documento~".~"num_documento~",~"riga_documento~".~"num_riga~"
   FROM   (~"sog_commerciale~" LEFT OUTER JOIN ~"per_saldo_legato_o_fino~" ON ~"sog_commerciale~".~"id_sog_commerciale~" = ~"per_saldo_legato_o_fino~".~"id_sog_commerciale~"), 
~"dba~".~"riga_documento~",            ~"dba~".~"documento~",           ~"dba~".~"articolo~",           ~"dba~".~"orafo_metallo~",   
         ~"dba~".~"orafo_titolo~" ,     ~"dba~".~"caus_magazzino~", ~"dba~".~"sog_commerciale~"
   WHERE ( ~"caus_magazzino~".~"id_caus_magazzino~" = ~"riga_documento~".~"id_caus_magazzino~" ) and  
         ( ~"documento~".~"id_documento~" = ~"riga_documento~".~"id_documento~" ) and  
         ( ~"articolo~".~"id_articolo~" = ~"riga_documento~".~"id_articolo~" ) and  
         ( ~"orafo_titolo~".~"id_metallo~" = ~"orafo_metallo~".~"id_metallo~" ) and  
         ( ~"orafo_titolo~".~"id_titolo~" = ~"articolo~".~"id_titolo~" ) and  
          ( ~"caus_magazzino~".~"saldi_cl_fino~" >' ' ) AND  
		(~"sog_commerciale~".~"id_sog_commerciale~"=~"documento~".~"id_sog_commerciale~") and  ~"documento~".~"id_sog_commerciale~"=:id_sog and
         (~"documento~".~"data_documento~" >= :da_data AND  
         ~"documento~".~"data_documento~" <= :a_data) 
order by   ~"orafo_metallo~".~"codice~",  ~"documento~".~"data_documento~",  ~"documento~".~"num_documento~",  ~"riga_documento~".~"num_riga~"

" arguments=(("da_data", date),("a_data", date),("id_sog", number))  sort="orafo_metallo_codice A c_tipo_partita_3 A documento_data_documento A documento_num_documento A riga_documento_num_riga A " )
group(level=1 header.height=0 trailer.height=0 trailer.height.autosize=yes by=("orafo_metallo_codice" , "c_tipo_partita_3" ) header.color="536870912" header.transparency="0" header.gradient.color="8421504" header.gradient.transparency="0" header.gradient.angle="0" header.brushmode="0" header.gradient.repetition.mode="0" header.gradient.repetition.count="0" header.gradient.repetition.length="100" header.gradient.focus="0" header.gradient.scale="100" header.gradient.spread="100" trailer.color="536870912" trailer.transparency="0" trailer.gradient.color="8421504" trailer.gradient.transparency="0" trailer.gradient.angle="0" trailer.brushmode="0" trailer.gradient.repetition.mode="0" trailer.gradient.repetition.count="0" trailer.gradient.repetition.length="100" trailer.gradient.focus="0" trailer.gradient.scale="100" trailer.gradient.spread="100" )
