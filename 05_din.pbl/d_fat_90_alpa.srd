 column=(type=char(1) updatewhereclause=yes name=unita_misura_tipo dbname="unita_misura.tipo" )
 column=(type=char(2) updatewhereclause=yes name=orafo_metallo_cod_metallo dbname="orafo_metallo.cod_metallo" )
 column=(type=decimal(2) updatewhereclause=yes name=titolo dbname="orafo_titolo.titolo" )
 column=(type=char(32766) updatewhereclause=no name=note_intestazione dbname="documento.note_intestazione" )
 column=(type=char(10) updatewhereclause=yes name=num_ns_prot_documenti dbname="sog_commerciale.num_ns_prot_documenti" )
 column=(type=date updatewhereclause=yes name=data_ns_prot_documenti dbname="sog_commerciale.data_ns_prot_documenti" )
 column=(type=char(10) updatewhereclause=yes name=num_lr_prot_documenti dbname="sog_commerciale.num_lr_prot_documenti" )
 column=(type=date updatewhereclause=yes name=data_lr_prot_documenti dbname="sog_commerciale.data_lr_prot_documenti" )
 column=(type=char(8) updatewhereclause=yes name=codice dbname="sog_commerciale.codice" )
 column=(type=long updatewhereclause=yes name=id_tab_iva dbname="sog_commerciale.id_tab_iva" )
 column=(type=decimal(6) updatewhereclause=yes name=prezzo_complessivo dbname="riga_documento.prezzo_complessivo" )
