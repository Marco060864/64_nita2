 column=(type=decimal(4) updatewhereclause=yes name=riga_documento_importo_manifattura_val dbname="riga_documento.importo_manifattura_val" )
 column=(type=long updatewhereclause=yes name=id_cat_attivita dbname="sog_commerciale.id_cat_attivita" )
 column=(type=decimal(0) updatewhereclause=yes name=azienda_rag_soc_1 dbname="documento.num_colli" )
 column=(type=char(40) updatewhereclause=yes name=descrizione dbname="tipo_trasporto.descrizione" )
 column=(type=long updatewhereclause=yes name=id_prof_documento dbname="documento.id_prof_documento" )
 column=(type=char(40) updatewhereclause=yes name=sconto dbname="riga_documento.sconto" )
 column=(type=char(40) updatewhereclause=yes name=descrizione dbname="caus_trasporto.descrizione" )
 column=(type=char(40) updatewhereclause=yes name=azienda_rag_soc_1 dbname="azienda.rag_soc_1" )
 column=(type=char(16) updatewhereclause=yes name=azienda_par_iva dbname="azienda.par_iva" )
 column=(type=char(16) updatewhereclause=yes name=azienda_cod_fiscale dbname="azienda.cod_fiscale" )
 column=(type=char(40) updatewhereclause=yes name=azienda_cciaa dbname="azienda.cciaa" )
 column=(type=decimal(4) updatewhereclause=yes name=azienda_tot_capitale dbname="azienda.tot_capitale" )
 column=(type=char(32766) updatewhereclause=no name=azienda_note dbname="azienda.note" )
 column=(type=char(40) updatewhereclause=yes name=sede_indirizzo dbname="sede.indirizzo" )
 column=(type=char(10) updatewhereclause=yes name=sede_cap dbname="sede.cap" )
 column=(type=char(40) updatewhereclause=yes name=sede_localita dbname="sede.localita" )
 column=(type=char(5) updatewhereclause=yes name=sede_provincia dbname="sede.provincia" )
 column=(type=long updatewhereclause=yes identity=yes name=documento_b_id_documento dbname="documento.id_documento" )
 column=(type=long updatewhereclause=yes name=articolo_id_cat_fiscale dbname="articolo.id_cat_fiscale" )
 column=(type=char(2) updatewhereclause=yes name=banca_sog_commerciale_iban_nazione dbname="banca_sog_commerciale.iban_nazione" )
 column=(type=char(2) updatewhereclause=yes name=banca_sog_commerciale_iban_contr_internazionale dbname="banca_sog_commerciale.iban_contr_internazionale" )
 column=(type=char(1) updatewhereclause=yes name=banca_sog_commerciale_cin dbname="banca_sog_commerciale.cin" )
 column=(type=char(20) updatewhereclause=yes name=banca_sog_commerciale_conto_corrente dbname="banca_sog_commerciale.conto_corrente" )
 column=(type=char(11) updatewhereclause=yes name=banca_sog_commerciale_swift dbname="banca_sog_commerciale.swift" )
 column=(type=long updatewhereclause=yes identity=yes name=id_anagrafica dbname="anagrafica.id_anagrafica" )
 column=(type=decimal(4) updatewhereclause=yes name=valuta_cambio dbname="valuta.cambio" )
 column=(type=long updatewhereclause=yes name=documento_id_sog_commerciale dbname="documento.id_sog_commerciale" )
 retrieve="  SELECT ~"documento_a~".~"id_documento~",   
         ~"documento_a~".~"num_documento~",   
         ~"documento_a~".~"data_documento~",   
         ~"documento_a~".~"asp_beni~",   
         ~"documento_a~".~"tras_mezzo~",   
         ~"riga_documento_a~".~"num_riga~",   
         ~"riga_documento_a~".~"descrizione~" as des_riga,   
         ~"riga_documento_a~".~"quantita~",   
         ~"riga_documento_a~".~"peso_netto~",   
         ~"riga_documento_a~".~"tot_riga_val_riga~",   
         ~"riga_documento_a~".~"coef_calo~",   
         ~"riga_documento_a~".~"prezzo_manifattura~",   
         ~"prof_documento~".~"des_stampa~",   
         ~"anagrafica_a~".~"rag_soc_1~",   
         ~"anagrafica_a~".~"rag_soc_2~",   
            ~"anagrafica_a~".~"indirizzo~",
         ~"anagrafica_a~".~"cap~",   
         ~"anagrafica_a~".~"localita~",   
         ~"anagrafica_a~".~"provincia~",   
         ~"anagrafica_a~".~"nazione~",   
         ~"anagrafica_a~".~"cod_fiscale~",   
         ~"anagrafica_a~".~"par_iva~",   
         ~"anagrafica_b~".~"rag_soc_1~" as rag_soc_vett,   
         ~"anagrafica_b~".~"rag_soc_2~"as rag_soc_2_vett,   
         ~"anagrafica_b~".~"indirizzo~"as indirizzo_vett,   
         ~"anagrafica_b~".~"cap~" as cap_vett,   
         ~"anagrafica_b~".~"localita~" as localita_vett,   
         ~"anagrafica_b~".~"provincia~" as provincia_vett,   
         ~"anagrafica_b~".~"nazione~" as nazione_vett,   
         ~"con_pagamento~".~"descrizione~" as des_cond_pagamento,   
         ~"banca_appoggio~".~"cod_abi~" ,   
         ~"banca_appoggio~".~"den_abi~" ,   
         ~"banca_appoggio~".~"cod_cab~",   
         ~"banca_appoggio~".~"den_cab~",   
         ~"destinazione~".~"rag_soc_1~" as rag_soc_dest,   
         ~"destinazione~".~"rag_soc_2~" as rag_soc_2_dest,   
         ~"destinazione~".~"indirizzo~" as indirizzo_dest,   
         ~"destinazione~".~"cap~" as cap_dest,   
         ~"destinazione~".~"localita~" as localita_dest,   
         ~"destinazione~".~"provincia~" as provincia_dest,   
         ~"destinazione~".~"nazione~" as nazione_dest,   
         ~"documento_b~".~"num_documento~" as num_doc_origine,   
         ~"documento_b~".~"data_documento~" as data_doc_origine,   
         ~"articolo~".~"codice~" as cod_articolo,   
         ~"unita_misura~".~"simbolo~" ,   
         ~"unita_misura~".~"tipo~",   
         ~"orafo_metallo~".~"codice~" as cod_metallo,   
         ~"orafo_titolo~".~"titolo~",
			~"documento_a~".~"note_intestazione~",
			~"sog_commerciale_a~".~"num_ns_prot_documenti~",
			~"sog_commerciale_a~".~"data_ns_prot_documenti~",
			~"sog_commerciale_a~".~"num_lr_prot_documenti~",
			~"sog_commerciale_a~".~"data_lr_prot_documenti~",
			~"sog_commerciale_a~".~"codice~",
			~"sog_commerciale_a~".~"id_tab_iva~",
			~"riga_documento_a~".~"prezzo_complessivo~",
~"documento_a~".~"CAMBIO~",
~"riga_documento_a~".~"IMPORTO_manifattura_VAL~",
~"sog_commerciale_a~".~"id_cat_attivita~",
 ~"documento_a~".~"num_colli~", 
	~"tipo_trasporto~".~"descrizione~",
 ~"documento_b~".~"ID_PROF_DOCUMENTO~",
~"riga_documento_a~".~"SCONTO~",
~"caus_trasporto~".~"descrizione~",
~"azienda~".~"rag_soc_1~",
  			~"azienda~".~"par_iva~",
			~"azienda~".~"cod_fiscale~",
			~"azienda~".~"cciaa~",
			~"azienda~".~"tot_capitale~",
			~"azienda~".~"note~",
			~"sede~".~"indirizzo~",
			~"sede~".~"cap~",
			~"sede~".~"localita~",
			~"sede~".~"provincia~",
~"documento_b~".~"id_documento~",
~"articolo~".~"id_cat_fiscale~",
~"banca_sog_commerciale~".~"iban_nazione~", ~"banca_sog_commerciale~".~"iban_contr_internazionale~", ~"banca_sog_commerciale~".~"cin~", ~"banca_sog_commerciale~".~"conto_corrente~",
~"banca_sog_commerciale~".~"swift~",
  ~"anagrafica_a~".~"id_anagrafica~"   , valuta.cambio,    ~"documento_a~".~"id_sog_commerciale~"  

 
    FROM   ~"documento~" documento_a  LEFT OUTER JOIN ~"con_pagamento~"  ON ~"documento_a~".~"id_con_pagamento~" = ~"con_pagamento~".~"id_con_pagamento~",
 
~"documento~" documento_a LEFT OUTER JOIN ~"banca_sog_commerciale~"  ON ~"documento_a~".~"id_banca_sog_commerciale~" = ~"banca_sog_commerciale~".~"id_banca_sog_commerciale~",
 
banca_sog_commerciale LEFT OUTER JOIN ~"banca_appoggio~"  ON ~"banca_sog_commerciale~".~"id_banca_appoggio~" = ~"banca_appoggio~".~"id_banca_appoggio~",
~"documento~" documento_a LEFT OUTER JOIN ~"destinazione~"  ON ~"documento_a~".~"id_destinazione~" = ~"destinazione~".~"id_destinazione~",



~"riga_documento~" riga_documento_b  LEFT OUTER JOIN ~"documento~" documento_b  ON ~"riga_documento_b~".~"id_documento~" = ~"documento_b~".~"id_documento~",

~"riga_documento~" riga_documento_a  LEFT OUTER JOIN ~"riga_documento~" riga_documento_b  ON ~"riga_documento_a~".~"id_riga_doc_provenienza~" = ~"riga_documento_b~".~"id_riga_documento~",
~"riga_documento~" riga_documento_a LEFT OUTER JOIN ~"articolo~"  ON ~"riga_documento_a~".~"id_articolo~" = ~"articolo~".~"id_articolo~",
~"riga_documento~" riga_documento_a LEFT OUTER JOIN ~"unita_confezione~"  ON ~"riga_documento_a~".~"id_unita_confezione~" = ~"unita_confezione~".~"id_unita_confezione~", 
unita_confezione LEFT OUTER JOIN ~"unita_misura~"  ON ~"unita_confezione~".~"id_unita_misura~" = ~"unita_misura~".~"id_unita_misura~", 
~"articolo~"  LEFT OUTER JOIN ~"orafo_titolo~"  ON ~"articolo~".~"id_titolo~" = ~"orafo_titolo~".~"id_titolo~", 
orafo_titolo LEFT OUTER JOIN ~"orafo_metallo~"  ON ~"orafo_titolo~".~"id_metallo~" = ~"orafo_metallo~".~"id_metallo~",

~"documento~" documento_a LEFT OUTER JOIN ~"sog_commerciale~" ~"sog_commerciale_b~" ON  documento_a.~"id_sog_commerciale_vettore~" = ~"sog_commerciale_b~".~"id_sog_commerciale~" ,
~"sog_commerciale~" ~"sog_commerciale_b~" LEFT OUTER JOIN ~"anagrafica~" ~"anagrafica_b~" ON ~"sog_commerciale_b~".~"id_anagrafica~" = ~"anagrafica_b~".~"id_anagrafica~",

~"documento~" documento_a LEFT OUTER JOIN ~"tipo_trasporto~"  ON ~"documento_a~".~"id_tipo_trasporto~" = ~"tipo_trasporto~".~"id_tipo_trasporto~",
 ~"documento~" documento_a LEFT OUTER JOIN ~"caus_trasporto~"  ON ~"documento_a~".~"id_caus_trasporto~" = ~"caus_trasporto~".~"id_caus_trasporto~",
			         
         ~"sog_commerciale~" ~"sog_commerciale_a~",   
         ~"anagrafica~" ~"anagrafica_a~",   ~"valuta~",
           
        
         ~"prof_documento~", ~"tipo_trasporto~", ~"caus_trasporto~", ~"azienda~", ~"sede~"

   WHERE ( ~"riga_documento_a~".~"id_documento~" = ~"documento_a~".~"id_documento~" ) and  
         ( ~"anagrafica_a~".~"id_anagrafica~" = ~"sog_commerciale_a~".~"id_anagrafica~" ) and  
         ( ~"documento_a~".~"id_sog_commerciale~" = ~"sog_commerciale_a~".~"id_sog_commerciale~" ) and  
        
         ( ~"documento_a~".~"id_prof_documento~" = ~"prof_documento~".~"id_prof_documento~" ) and
			
			(~"documento_a~".~"id_azienda~"=~"azienda~".~"id_azienda~") and (documento_a.id_valuta=valuta.id_valuta) and
			(~"azienda~".~"id_azienda~"=~"sede~".~"id_azienda~") 
			and (~"documento_a~".~"id_documento~"=:rd_doc)
" arguments=(("rd_doc", number))  sort="riga_documento_num_riga A " )
