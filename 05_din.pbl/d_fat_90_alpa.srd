 column=(type=char(40) updatewhereclause=yes name=des_cond_pagamento dbname="con_pagamento.des_cond_pagamento" )
 column=(type=char(5) updatewhereclause=yes name=cod_abi dbname="banca_appoggio.cod_abi" )
 column=(type=char(40) updatewhereclause=yes name=den_abi dbname="banca_appoggio.den_abi" )
 column=(type=char(5) updatewhereclause=yes name=cod_cab dbname="banca_appoggio.cod_cab" )
 column=(type=char(40) updatewhereclause=yes name=den_cab dbname="banca_appoggio.den_cab" )
 column=(type=char(40) updatewhereclause=yes name=destinazione_rag_soc_dest dbname="destinazione.rag_soc_dest" )
 column=(type=char(40) updatewhereclause=yes name=destinazione_rag_soc_2_dest dbname="destinazione.rag_soc_2_dest" )
 column=(type=char(40) updatewhereclause=yes name=destinazione_indirizzo_dest dbname="destinazione.indirizzo_dest" )
 column=(type=char(10) updatewhereclause=yes name=destinazione_cap_dest dbname="destinazione.cap_dest" )
 column=(type=char(40) updatewhereclause=yes name=destinazione_localita_dest dbname="destinazione.localita_dest" )
 column=(type=char(5) updatewhereclause=yes name=destinazione_provincia_dest dbname="destinazione.provincia_dest" )
