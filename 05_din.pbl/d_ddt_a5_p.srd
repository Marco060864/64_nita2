 column=(type=char(40) updatewhereclause=yes name=banca_sog_commerciale_gen_den_abi dbname="den_abi" )
 column=(type=char(2) updatewhereclause=yes name=registro_tipo_registro dbname="tipo_registro" )
 column=(type=char(40) updatewhereclause=yes name=azienda_rag_soc_1 dbname="rag_soc_1" )
 column=(type=char(40) updatewhereclause=yes name=azienda_rag_soc_2 dbname="rag_soc_2" )
 column=(type=char(16) updatewhereclause=yes name=azienda_par_iva dbname="par_iva" )
 column=(type=char(16) updatewhereclause=yes name=azienda_cod_fiscale dbname="cod_fiscale" )
 column=(type=char(32766) updatewhereclause=no name=azienda_note dbname="note" )
 column=(type=char(40) updatewhereclause=yes name=sede_indirizzo dbname="indirizzo" )
 column=(type=char(10) updatewhereclause=yes name=sede_cap dbname="cap" )
 column=(type=char(40) updatewhereclause=yes name=sede_localita dbname="localita" )
 column=(type=char(5) updatewhereclause=yes name=sede_provincia dbname="provincia" )
 column=(type=char(8) updatewhereclause=yes name=tab_iva_codice dbname="codice" )
 column=(type=char(32) updatewhereclause=yes name=articolo_codice dbname="codice" )
 column=(type=char(20) updatewhereclause=yes name=sog_commerciale_ns_cod_soggetto dbname="ns_cod_soggetto" )
 column=(type=long updatewhereclause=yes name=sog_commerciale_id_cat_attivita dbname="id_cat_attivita" )
 column=(type=long updatewhereclause=yes name=sog_commerciale_id_tab_iva dbname="id_tab_iva" )
 column=(type=char(10) updatewhereclause=yes name=sog_commerciale_num_ns_prot_documenti dbname="num_ns_prot_documenti" )
