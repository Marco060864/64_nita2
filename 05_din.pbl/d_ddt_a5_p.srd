 column=(type=char(10) updatewhereclause=yes name=sog_commerciale_num_lr_prot_documenti dbname="num_lr_prot_documenti" )
 column=(type=date updatewhereclause=yes name=sog_commerciale_data_lr_prot_documenti dbname="data_lr_prot_documenti" )
