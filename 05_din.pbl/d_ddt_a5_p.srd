 column=(type=decimal(6) updatewhereclause=yes name=riga_documento_tot_riga_val_az dbname="tot_riga_val_az" )
 column=(type=long updatewhereclause=yes name=riga_documento_id_riga_doc_provenienza dbname="id_riga_doc_provenienza" )
 column=(type=decimal(2) updatewhereclause=yes name=riga_documento_coef_calo dbname="coef_calo" )
