 column=(type=char(10) updatewhereclause=yes name=destinazione_cap dbname="cap" )
 column=(type=char(40) updatewhereclause=yes name=destinazione_localita dbname="localita" )
 column=(type=char(5) updatewhereclause=yes name=destinazione_provincia dbname="provincia" )
