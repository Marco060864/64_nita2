 column=(type=char(40) updatewhereclause=yes name=documento_asp_beni dbname="documento.asp_beni" )
 column=(type=char(1) updatewhereclause=yes name=documento_tras_mezzo dbname="documento.tras_mezzo" )
 column=(type=char(8) updatewhereclause=yes name=sog_commerciale_gen_codice dbname="sog_commerciale_gen.codice" )
 column=(type=char(40) updatewhereclause=yes name=sog_commerciale_gen_rag_soc_1 dbname="sog_commerciale_gen.rag_soc_1" )
 column=(type=char(40) updatewhereclause=yes name=sog_commerciale_gen_rag_soc_2 dbname="sog_commerciale_gen.rag_soc_2" )
