table(column=(type=char(12) updatewhereclause=yes name=galvanica_lavorazione dbname="galvanica.lavorazione" )
 column=(type=decimal(4) updatewhereclause=yes name=galvanica_prezzo_gr dbname="galvanica.prezzo_gr" )
 column=(type=decimal(4) updatewhereclause=yes name=c_sum_peso dbname="c_sum_peso" )
 column=(type=char(32) updatewhereclause=yes name=galvanica_descrizione dbname="galvanica.descrizione" )
 column=(type=decimal(6) updatewhereclause=yes name=riga_documento_prezzo_metallo dbname="riga_documento.prezzo_metallo" )
 column=(type=decimal(4) updatewhereclause=yes name=c_sum_qta dbname="c_sum_qta" )
 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"galvanica~" )  TABLE(NAME=~"riga_documento~" ) COLUMN(NAME=~"galvanica.lavorazione~") COLUMN(NAME=~"galvanica.prezzo_gr~") COMPUTE(NAME=~"sum(~~~"riga_documento~~~".~~~"peso_netto~~~" ) as c_sum_peso~") COLUMN(NAME=~"galvanica.descrizione~") COLUMN(NAME=~"riga_documento.prezzo_metallo~") COMPUTE(NAME=~"sum(~~~"riga_documento~~~".~~~"quantita~~~") as c_sum_qta~")    JOIN (LEFT=~"galvanica.id_galvanica~"    OP =~"=~"RIGHT=~"riga_documento.id_gruppo_agenti_2~" )WHERE(    EXP1 =~"~~~"riga_documento~~~".~~~"id_documento~~~"~"   OP =~"=~"    EXP2 =~":id_doc~" )  GROUP(NAME=~"galvanica.lavorazione~") GROUP(NAME=~"galvanica.prezzo_gr~") GROUP(NAME=~"galvanica.descrizione~") GROUP(NAME=~"riga_documento.prezzo_metallo~")) ORDER(NAME=~"galvanica.prezzo_gr~" ASC=yes ) ARG(NAME = ~"id_doc~" TYPE = number) " arguments=(("id_doc", number)) )
