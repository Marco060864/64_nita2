table(column=(type=char(15) updatewhereclause=yes name=compute_0001 dbname="compute_0001" )
 column=(type=decimal(6) updatewhereclause=yes name=compute_0002 dbname="compute_0002" )
 retrieve=" SELECT right(~"orafo_tipo_partita~".~"cod_tipo_partita~", 3)+'-'+ ~"orafo_metallo~".~"codice~"+string(~"orafo_titolo~".~"titolo~")  ,
      SUM(CASE 
       WHEN left(~"orafo_tipo_partita~".~"cod_tipo_partita~", 1) = 'A' 
       THEN ~"riga_documento~".~"peso_netto~" * ~"riga_documento~".~"coef_calo~" / 1000 
       ELSE -1 * ~"riga_documento~".~"peso_netto~" * ~"riga_documento~".~"coef_calo~" / 1000 
    END)
	 


			
    FROM ~"caus_magazzino~",  
         ~"documento~",   
         ~"riga_documento~",   
         ~"orafo_tipo_partita~",   
         ~"articolo~",   
         ~"orafo_metallo~",   
         ~"orafo_titolo~"  
   WHERE ( ~"riga_documento~".~"id_documento~" = ~"documento~".~"id_documento~" ) and  
         ( ~"riga_documento~".~"id_caus_magazzino~" = ~"caus_magazzino~".~"id_caus_magazzino~" ) and  
         ( ~"orafo_tipo_partita~".~"id_tipo_partita~" = ~"caus_magazzino~".~"id_tipo_partita~" ) and  
         ( ~"articolo~".~"id_articolo~" = ~"riga_documento~".~"id_articolo~" ) and  
         ( ~"orafo_titolo~".~"id_metallo~" = ~"orafo_metallo~".~"id_metallo~" ) and  
         ( ~"orafo_titolo~".~"id_titolo~" = ~"articolo~".~"id_titolo~" ) and 
			( ( ~"documento~".~"data_ora_creazione~" > :adt_da_data_ora ) AND  
         ( ~"documento~".~"data_ora_creazione~" <= :adt_a_data_ora ) AND  
         ( ~"documento~".~"id_sog_commerciale~" = :al_id_sog ) 
and orafo_metallo.prezioso='S'
) 
 group by right(~"orafo_tipo_partita~".~"cod_tipo_partita~", 3), ~"orafo_metallo~".~"codice~",~"orafo_titolo~".~"titolo~"
order by right(~"orafo_tipo_partita~".~"cod_tipo_partita~", 3), ~"orafo_metallo~".~"codice~",~"orafo_titolo~".~"titolo~";
" arguments=(("adt_da_data_ora", datetime),("adt_a_data_ora", datetime),("al_id_sog", number)) )
