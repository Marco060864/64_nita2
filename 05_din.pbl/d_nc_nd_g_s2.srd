 column=(type=char(16) updatewhereclause=yes name=documento_num_documento dbname="documento.num_documento" dbalias="documento.num_documento" )
 column=(type=date updatewhereclause=yes name=documento_data_documento dbname="documento.data_documento" dbalias="documento.data_documento" )
 column=(type=char(32766) updatewhereclause=no name=documento_note_intestazione dbname="documento.note_intestazione" dbalias="documento.note_intestazione" )
 column=(type=char(8) updatewhereclause=yes name=sog_commerciale_gen_codice dbname="sog_commerciale_gen.codice" dbalias="sog_commerciale_gen.codice" )
