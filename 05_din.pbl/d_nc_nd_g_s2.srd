 column=(type=char(40) updatewhereclause=yes name=prof_documento_des_stampa dbname="prof_documento.des_stampa" dbalias="prof_documento.des_stampa" )
 column=(type=char(40) updatewhereclause=yes name=con_pagamento_descrizione dbname="con_pagamento.descrizione" dbalias="con_pagamento.descrizione" )
 column=(type=char(40) updatewhereclause=yes name=banca_sog_commerciale_gen_den_abi dbname="banca_sog_commerciale_gen.den_abi" dbalias="banca_sog_commerciale_gen.den_abi" )
 column=(type=char(40) updatewhereclause=yes name=azienda_rag_soc_1 dbname="azienda.rag_soc_1" dbalias="azienda.rag_soc_1" )
 column=(type=char(40) updatewhereclause=yes name=azienda_rag_soc_2 dbname="azienda.rag_soc_2" dbalias="azienda.rag_soc_2" )
 column=(type=char(16) updatewhereclause=yes name=azienda_par_iva dbname="azienda.par_iva" dbalias="azienda.par_iva" )
 column=(type=char(16) updatewhereclause=yes name=azienda_cod_fiscale dbname="azienda.cod_fiscale" dbalias="azienda.cod_fiscale" )
 column=(type=char(32766) updatewhereclause=no name=azienda_note dbname="azienda.note" dbalias="azienda.note" )
 column=(type=char(40) updatewhereclause=yes name=sede_indirizzo dbname="sede.indirizzo" dbalias="sede.indirizzo" )
 column=(type=char(10) updatewhereclause=yes name=sede_cap dbname="sede.cap" dbalias="sede.cap" )
 column=(type=char(40) updatewhereclause=yes name=sede_localita dbname="sede.localita" dbalias="sede.localita" )
 column=(type=char(5) updatewhereclause=yes name=sede_provincia dbname="sede.provincia" dbalias="sede.provincia" )
 column=(type=char(8) updatewhereclause=yes name=tab_iva_codice dbname="tab_iva.codice" dbalias="tab_iva.codice" )
 column=(type=char(32766) updatewhereclause=no name=sum_des_riga dbname="sum_des_riga" )
 column=(type=decimal(4) updatewhereclause=yes name=qta dbname="qta" )
 column=(type=decimal(6) updatewhereclause=yes name=tot_riga dbname="tot_riga" )
 column=(type=decimal(6) updatewhereclause=yes name=riga_documento_prezzo_complessivo dbname="riga_documento.prezzo_complessivo" dbalias="Riga_Documento.prezzo_complessivo" )
 column=(type=long updatewhereclause=yes name=riga_documento_id_articolo dbname="riga_documento.id_articolo" dbalias="Riga_Documento.id_articolo" )
 column=(type=char(40) updatewhereclause=yes name=prof_documento_des_stampa dbname="prof_documento.des_stampa" dbalias="prof_documento.des_stampa" )
 column=(type=char(2) updatewhereclause=yes name=prof_documento_tipo_registro dbname="prof_documento.tipo_registro" dbalias="prof_documento.tipo_registro" )
 retrieve="SELECT
    documento.~"id_documento~", documento.~"id_prof_documento~", documento.~"num_documento~", documento.~"data_documento~", documento.~"note_intestazione~", 
    sog_commerciale_gen.~"codice~", sog_commerciale_gen.~"rag_soc_1~", sog_commerciale_gen.~"rag_soc_2~", sog_commerciale_gen.~"indirizzo~", sog_commerciale_gen.~"cap~", sog_commerciale_gen.~"localita~", sog_commerciale_gen.~"provincia~", sog_commerciale_gen.~"nazione~",
    sog_commerciale_gen.~"cod_fiscale~", sog_commerciale_gen.~"par_iva~", prof_documento.~"des_stampa~", con_pagamento.~"descrizione~", banca_sog_commerciale_gen.~"den_abi~",
   
    azienda.~"rag_soc_1~", azienda.~"rag_soc_2~", azienda.~"par_iva~", azienda.~"cod_fiscale~", azienda.~"note~",
    sede.~"indirizzo~", sede.~"cap~", sede.~"localita~", sede.~"provincia~",
    tab_iva.~"codice~",

     list(Riga_Documento.~"descrizione~")as sum_des_riga, sum(Riga_Documento.~"quantita~") as qta, sum(riga_documento.tot_riga_val_riga) as tot_riga,
     riga_documento.prezzo_complessivo,
  Riga_Documento.~"id_articolo~", prof_documento.des_stampa, prof_documento.tipo_registro

FROM
    ~"DBA~".~"documento~" documento LEFT OUTER JOIN ~"DBA~".~"sog_commerciale_gen~" sog_commerciale_gen ON
        documento.~"id_sog_commerciale~" = sog_commerciale_gen.~"id_sog_commerciale~",
    ~"DBA~".~"documento~" documento LEFT OUTER JOIN ~"DBA~".~"prof_documento~" prof_documento ON
        documento.~"id_prof_documento~" = prof_documento.~"id_prof_documento~",
     ~"DBA~".~"documento~" documento LEFT OUTER JOIN ~"DBA~".~"riga_documento~" Riga_Documento ON
        documento.~"id_documento~" = Riga_Documento.~"id_documento~",
    ~"DBA~".~"documento~" documento LEFT OUTER JOIN ~"DBA~".~"con_pagamento~" con_pagamento ON
        documento.~"id_con_pagamento~" = con_pagamento.~"id_con_pagamento~",
    ~"DBA~".~"documento~" documento LEFT OUTER JOIN ~"DBA~".~"banca_sog_commerciale_gen~" banca_sog_commerciale_gen ON
        documento.~"id_banca_sog_commerciale~" = banca_sog_commerciale_gen.~"id_banca_sog_commerciale~",
     ~"DBA~".~"riga_documento~" Riga_Documento LEFT OUTER JOIN ~"DBA~".~"tab_iva~" tab_iva ON
        Riga_Documento.~"id_tab_iva~" = tab_iva.~"id_tab_iva~",
   
    ~"DBA~".~"azienda~" azienda,
    ~"DBA~".~"sede~" sede, dba.prof_documento
		//dba.caus_magazzino
WHERE
	//riga_documento.id_caus_magazzino=caus_magazzino.id_caus_magazzino and
   prof_documento.id_prof_documento=documento.id_prof_documento and
    documento.~"id_azienda~" = azienda.~"id_azienda~" AND
    documento.~"id_azienda~" = sede.~"id_azienda~" 
and documento.id_documento=:ll_doc
group by 
  documento.~"id_documento~", documento.~"id_prof_documento~", documento.~"num_documento~", documento.~"data_documento~", documento.~"note_intestazione~", 
    sog_commerciale_gen.~"codice~", sog_commerciale_gen.~"rag_soc_1~", sog_commerciale_gen.~"rag_soc_2~", sog_commerciale_gen.~"indirizzo~", sog_commerciale_gen.~"cap~", sog_commerciale_gen.~"localita~", sog_commerciale_gen.~"provincia~", sog_commerciale_gen.~"nazione~",
    sog_commerciale_gen.~"cod_fiscale~", sog_commerciale_gen.~"par_iva~", prof_documento.~"des_stampa~", con_pagamento.~"descrizione~", banca_sog_commerciale_gen.~"den_abi~",
   
    azienda.~"rag_soc_1~", azienda.~"rag_soc_2~", azienda.~"par_iva~", azienda.~"cod_fiscale~", azienda.~"note~",
    sede.~"indirizzo~", sede.~"cap~", sede.~"localita~", sede.~"provincia~",
    tab_iva.~"codice~",
     riga_documento.prezzo_complessivo,
  Riga_Documento.~"id_articolo~",  prof_documento.tipo_registro

ORDER BY
Riga_Documento.~"id_articolo~",  riga_documento.prezzo_complessivo
    ASC" arguments=(("ll_doc", number)) )
