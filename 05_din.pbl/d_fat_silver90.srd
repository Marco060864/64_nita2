 column=(type=char(40) updatewhereclause=yes name=con_pagamento_descrizione dbname="con_pagamento.descrizione" dbalias="con_pagamento.descrizione" )
 column=(type=char(40) updatewhereclause=yes name=banca_sog_commerciale_gen_den_abi dbname="banca_sog_commerciale_gen.den_abi" dbalias="banca_sog_commerciale_gen.den_abi" )
 column=(type=char(2) updatewhereclause=yes name=registro_tipo_registro dbname="registro.tipo_registro" dbalias="registro.tipo_registro" )
