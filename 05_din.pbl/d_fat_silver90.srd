 column=(type=char(16) updatewhereclause=yes name=azienda_par_iva dbname="azienda.par_iva" dbalias="azienda.par_iva" )
 column=(type=char(16) updatewhereclause=yes name=azienda_cod_fiscale dbname="azienda.cod_fiscale" dbalias="azienda.cod_fiscale" )
 column=(type=char(32766) updatewhereclause=no name=azienda_note dbname="azienda.note" dbalias="azienda.note" )
 column=(type=char(40) updatewhereclause=yes name=sede_indirizzo dbname="sede.indirizzo" dbalias="sede.indirizzo" )
