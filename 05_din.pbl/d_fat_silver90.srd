 column=(type=decimal(6) updatewhereclause=yes name=riga_documento_tot_riga_val_doc dbname="riga_documento.tot_riga_val_doc" dbalias="Riga_Documento.tot_riga_val_doc" )
 column=(type=decimal(6) updatewhereclause=yes name=riga_documento_tot_riga_val_az dbname="riga_documento.tot_riga_val_az" dbalias="Riga_Documento.tot_riga_val_az" )
 column=(type=long updatewhereclause=yes name=riga_documento_id_riga_doc_provenienza dbname="riga_documento.id_riga_doc_provenienza" dbalias="Riga_Documento.id_riga_doc_provenienza" )
 column=(type=decimal(2) updatewhereclause=yes name=riga_documento_coef_calo dbname="riga_documento.coef_calo" dbalias="Riga_Documento.coef_calo" )
 column=(type=decimal(6) updatewhereclause=yes name=riga_documento_prezzo_manifattura dbname="riga_documento.prezzo_manifattura" dbalias="Riga_Documento.prezzo_manifattura" )
 column=(type=decimal(4) updatewhereclause=yes name=riga_documento_peso_non_prezioso dbname="riga_documento.peso_non_prezioso" dbalias="Riga_Documento.peso_non_prezioso" )
