 column=(type=char(8) updatewhereclause=yes name=tab_iva_codice dbname="tab_iva.codice" )
 column=(type=char(32) updatewhereclause=yes name=articolo_codice dbname="articolo.codice" )
 column=(type=char(20) updatewhereclause=yes name=sog_commerciale_ns_cod_soggetto dbname="sog_commerciale.ns_cod_soggetto" )
 column=(type=long updatewhereclause=yes name=sog_commerciale_id_cat_attivita dbname="sog_commerciale.id_cat_attivita" )
 column=(type=long updatewhereclause=yes name=sog_commerciale_id_tab_iva dbname="sog_commerciale.id_tab_iva" )
 column=(type=char(10) updatewhereclause=yes name=sog_commerciale_num_ns_prot_documenti dbname="sog_commerciale.num_ns_prot_documenti" )
 column=(type=date updatewhereclause=yes name=sog_commerciale_data_ns_prot_documenti dbname="sog_commerciale.data_ns_prot_documenti" )
 column=(type=char(10) updatewhereclause=yes name=sog_commerciale_num_lr_prot_documenti dbname="sog_commerciale.num_lr_prot_documenti" )
 column=(type=date updatewhereclause=yes name=sog_commerciale_data_lr_prot_documenti dbname="sog_commerciale.data_lr_prot_documenti" )
 column=(type=char(40) updatewhereclause=yes name=anagrafica_rag_soc_1 dbname="anagrafica.rag_soc_1" )
 column=(type=char(40) updatewhereclause=yes name=anagrafica_indirizzo dbname="anagrafica.indirizzo" )
 column=(type=char(10) updatewhereclause=yes name=anagrafica_cap dbname="anagrafica.cap" )
 column=(type=char(40) updatewhereclause=yes name=anagrafica_localita dbname="anagrafica.localita" )
 column=(type=char(5) updatewhereclause=yes name=anagrafica_provincia dbname="anagrafica.provincia" )
 column=(type=char(32) updatewhereclause=yes name=des_articolo_codice dbname="des_articolo.codice" )
 column=(type=char(40) updatewhereclause=yes name=des_articolo_descrizione dbname="des_articolo.descrizione" )
 column=(type=char(2) updatewhereclause=yes name=galvanica_lavorazione dbname="galvanica.lavorazione" )
 column=(type=long updatewhereclause=yes identity=yes name=documento_id_documento_1 dbname="documento.id_documento" )
 column=(type=char(16) updatewhereclause=yes name=documento_num_documento_1 dbname="documento.num_documento" )
 column=(type=date updatewhereclause=yes name=documento_data_documento_1 dbname="documento.data_documento" )
 column=(type=char(5) updatewhereclause=yes name=unita_misura_simbolo dbname="unita_misura.simbolo" )
 column=(type=char(2) updatewhereclause=yes name=prof_documento_tipo_registro_1 dbname="prof_documento.tipo_registro" )
 column=(type=decimal(6) updatewhereclause=yes name=riga_documento_prezzo_complessivo dbname="riga_documento.prezzo_complessivo" )
 column=(type=decimal(6) updatewhereclause=yes name=riga_documento_prezzo_metallo dbname="riga_documento.prezzo_metallo" )
 column=(type=time updatewhereclause=yes name=documento_ora_trasporto dbname="documento.ora_trasporto" )
 column=(type=date updatewhereclause=yes name=documento_data_trasporto dbname="documento.data_trasporto" )
 column=(type=char(1) updatewhereclause=yes name=sog_commerciale_gen_tipo dbname="sog_commerciale_gen.tipo" )
 column=(type=char(8) updatewhereclause=yes name=prof_documento_codice dbname="prof_documento.codice" )
 column=(type=decimal(2) updatewhereclause=yes name=orafo_titolo_titolo dbname="orafo_titolo.titolo" )
 column=(type=char(2) updatewhereclause=yes name=orafo_metallo_codice dbname="orafo_metallo.codice" )
 column=(type=long updatewhereclause=yes identity=yes name=riga_documento_id_riga_documento dbname="riga_documento.id_riga_documento" )
 retrieve="SELECT
    documento.~"id_documento~", documento.~"id_prof_documento~", documento.~"num_documento~", documento.~"data_documento~",
 documento.~"note_intestazione~", documento.~"num_colli~", documento.~"asp_beni~", documento.~"tras_mezzo~",
    sog_commerciale_gen.~"codice~", sog_commerciale_gen.~"rag_soc_1~", sog_commerciale_gen.~"rag_soc_2~", 
sog_commerciale_gen.~"indirizzo~", sog_commerciale_gen.~"cap~", sog_commerciale_gen.~"localita~", sog_commerciale_gen.~"provincia~", 
sog_commerciale_gen.~"nazione~", sog_commerciale_gen.~"cod_fiscale~", sog_commerciale_gen.~"par_iva~",
    prof_documento.~"des_stampa~", prof_documento.~"tipo_registro~",
    tipo_trasporto.~"descrizione~",
    caus_trasporto.~"descrizione~",
    destinazione.~"id_destinazione~", destinazione.~"rag_soc_1~", destinazione.~"rag_soc_2~", destinazione.~"indirizzo~", 
destinazione.~"cap~", destinazione.~"localita~", destinazione.~"provincia~", destinazione.~"nazione~",
    Riga_Documento.~"num_riga~", Riga_Documento.~"descrizione~", Riga_Documento.~"quantita~", Riga_Documento.~"prezzo~", 
Riga_Documento.~"peso_netto~", Riga_Documento.~"peso_lordo~",
 Riga_Documento.~"tot_riga_val_doc~", Riga_Documento.~"tot_riga_val_az~", Riga_Documento.~"id_riga_doc_provenienza~", 
Riga_Documento.~"coef_calo~", Riga_Documento.~"prezzo_manifattura~",
 Riga_Documento.~"peso_non_prezioso~", Riga_Documento.~"provv_subage_2~",
    con_pagamento.~"descrizione~",
    banca_sog_commerciale_gen.~"den_abi~",
    registro.~"tipo_registro~",
    azienda.~"rag_soc_1~", azienda.~"rag_soc_2~", azienda.~"par_iva~", azienda.~"cod_fiscale~", azienda.~"note~",
    sede.~"indirizzo~", sede.~"cap~", sede.~"localita~", sede.~"provincia~",
    tab_iva.~"codice~",
    Articolo.~"codice~",
    sog_commerciale_ok.~"ns_cod_soggetto~", sog_commerciale_ok.~"id_cat_attivita~", sog_commerciale_ok.~"id_tab_iva~", 
sog_commerciale_ok.~"num_ns_prot_documenti~", sog_commerciale_ok.~"data_ns_prot_documenti~", sog_commerciale_ok.~"num_lr_prot_documenti~", 
sog_commerciale_ok.~"data_lr_prot_documenti~",
    anagrafica.~"rag_soc_1~", anagrafica.~"indirizzo~", anagrafica.~"cap~", anagrafica.~"localita~", anagrafica.~"provincia~",
    des_articolo.~"codice~", des_articolo.~"descrizione~",
    galvanica.~"lavorazione~",
    documento_padre.~"id_documento~", documento_padre.~"num_documento~", documento_padre.~"data_documento~",
    unita_misura.~"simbolo~",
    prof_documento_padre.~"tipo_registro~", riga_documento.prezzo_complessivo,
Riga_Documento.~"prezzo_metallo~", documento.~"ORA_TRASPORTO~",documento.~"DATA_TRASPORTO~",
sog_commerciale_gen.~"tipo~", prof_documento.~"codice~",
orafo_titolo.titolo, orafo_metallo.codice,
Riga_Documento.~"id_riga_documento~"
	

FROM
    ~"DBA~".~"documento~" documento LEFT OUTER JOIN ~"DBA~".~"sog_commerciale_gen~" sog_commerciale_gen ON
        documento.~"id_sog_commerciale~" = sog_commerciale_gen.~"id_sog_commerciale~",
    ~"DBA~".~"documento~" documento LEFT OUTER JOIN ~"DBA~".~"prof_documento~" prof_documento ON
        documento.~"id_prof_documento~" = prof_documento.~"id_prof_documento~",
    ~"DBA~".~"documento~" documento LEFT OUTER JOIN ~"DBA~".~"tipo_trasporto~" tipo_trasporto ON
        documento.~"id_tipo_trasporto~" = tipo_trasporto.~"id_tipo_trasporto~",
    ~"DBA~".~"documento~" documento LEFT OUTER JOIN ~"DBA~".~"caus_trasporto~" caus_trasporto ON
        documento.~"id_caus_trasporto~" = caus_trasporto.~"id_caus_trasporto~",
    ~"DBA~".~"documento~" documento LEFT OUTER JOIN ~"DBA~".~"sog_commerciale~" sog_commerciale ON
        documento.~"id_sog_commerciale_vettore~" = sog_commerciale.~"id_sog_commerciale~",
    ~"DBA~".~"documento~" documento LEFT OUTER JOIN ~"DBA~".~"destinazione~" destinazione ON
        documento.~"id_destinazione~" = destinazione.~"id_destinazione~",
    ~"DBA~".~"documento~" documento LEFT OUTER JOIN ~"DBA~".~"riga_documento~" Riga_Documento ON
        documento.~"id_documento~" = Riga_Documento.~"id_documento~",
    ~"DBA~".~"documento~" documento LEFT OUTER JOIN ~"DBA~".~"con_pagamento~" con_pagamento ON
        documento.~"id_con_pagamento~" = con_pagamento.~"id_con_pagamento~",
    ~"DBA~".~"documento~" documento LEFT OUTER JOIN ~"DBA~".~"banca_sog_commerciale_gen~" banca_sog_commerciale_gen ON
        documento.~"id_banca_sog_commerciale~" = banca_sog_commerciale_gen.~"id_banca_sog_commerciale~",
    ~"DBA~".~"riga_documento~" Riga_Documento LEFT OUTER JOIN ~"DBA~".~"unita_confezione~" unita_confezione ON
        Riga_Documento.~"id_unita_confezione~" = unita_confezione.~"id_unita_confezione~",
    ~"DBA~".~"riga_documento~" Riga_Documento LEFT OUTER JOIN ~"DBA~".~"tab_iva~" tab_iva ON
        Riga_Documento.~"id_tab_iva~" = tab_iva.~"id_tab_iva~",
    ~"DBA~".~"riga_documento~" Riga_Documento LEFT OUTER JOIN ~"DBA~".~"riga_documento~" riga_documento_padre ON
        Riga_Documento.~"id_riga_doc_provenienza~" = riga_documento_padre.~"id_riga_documento~",
    ~"DBA~".~"riga_documento~" Riga_Documento LEFT OUTER JOIN ~"DBA~".~"Articolo~" Articolo ON
        Riga_Documento.~"id_articolo~" = Articolo.~"id_articolo~",
    ~"DBA~".~"sog_commerciale~" sog_commerciale LEFT OUTER JOIN ~"DBA~".~"anagrafica~" anagrafica ON
        sog_commerciale.~"id_anagrafica~" = anagrafica.~"id_anagrafica~",
    ~"DBA~".~"riga_documento~" Riga_Documento LEFT OUTER JOIN ~"DBA~".~"des_articolo~" des_articolo ON
        Riga_Documento.~"id_des_articolo~" = des_articolo.~"id_des_articolo~",
    ~"DBA~".~"riga_documento~" Riga_Documento LEFT OUTER JOIN ~"DBA~".~"galvanica~" galvanica ON
        Riga_Documento.~"id_gruppo_Agenti_2~" = galvanica.~"id_galvanica~",
    ~"DBA~".~"riga_documento~" riga_documento_padre LEFT OUTER JOIN ~"DBA~".~"documento~" documento_padre ON
        riga_documento_padre.~"id_documento~" = documento_padre.~"id_documento~",
    ~"DBA~".~"unita_confezione~" unita_confezione LEFT OUTER JOIN ~"DBA~".~"unita_misura~" unita_misura ON
        unita_confezione.~"id_unita_misura~" = unita_misura.~"id_unita_misura~",
    ~"DBA~".~"documento~" documento_padre LEFT OUTER JOIN ~"DBA~".~"prof_documento~" prof_documento_padre ON
        documento_padre.~"id_prof_documento~" = prof_documento_padre.~"id_prof_documento~",
~"DBA~".~"Articolo~" Articolo LEFT OUTER JOIN ~"DBA~".~"orafo_titolo~" orafo_titolo ON
        Articolo.~"id_titolo~" = orafo_titolo.~"id_titolo~",

~"DBA~".~"orafo_titolo~" orafo_titolo LEFT OUTER JOIN ~"DBA~".~"orafo_metallo~" orafo_metallo ON
        orafo_titolo.~"id_metallo~" = orafo_metallo.~"id_metallo~",

    ~"DBA~".~"registro~" registro,
    ~"DBA~".~"azienda~" azienda,
    ~"DBA~".~"sede~" sede,
    ~"DBA~".~"sog_commerciale~" sog_commerciale_ok
WHERE
    documento.~"id_registro~" = registro.~"id_registro~" AND
    documento.~"id_azienda~" = azienda.~"id_azienda~" AND
    documento.~"id_azienda~" = sede.~"id_azienda~" AND
    sog_commerciale_gen.~"id_sog_commerciale~" = sog_commerciale_ok.~"id_sog_commerciale~"
AND riga_documento.~"id_riga_doc_padre~" is null
and documento.id_documento=:ll_doc
ORDER BY
    Riga_Documento.~"provv_subage_2~" ASC" arguments=(("ll_doc", number))  sort="riga_documento_num_riga A " )
