table(column=(type=long updatewhereclause=yes identity=yes name=id_documento dbname="id_documento" )
 column=(type=long updatewhereclause=yes name=id_valuta dbname="id_valuta" )
 column=(type=decimal(4) updatewhereclause=yes name=sconto_fin_incondizionato dbname="sconto_fin_incondizionato" )
 column=(type=decimal(2) updatewhereclause=yes name=sconto_fin_cassa dbname="sconto_fin_cassa" )
 column=(type=decimal(6) updatewhereclause=yes name=tot_riga_val_riga dbname="tot_riga_val_riga" )
 column=(type=decimal(4) updatewhereclause=yes name=importo_manifattura dbname="importo_manifattura" )
 column=(type=decimal(4) updatewhereclause=yes name=importo_manifattura_val dbname="importo_manifattura_val" )
 column=(type=char(1) updatewhereclause=yes name=cod_int_met dbname="cod_int_met" )
 retrieve="SELECT
    documento.~"id_documento~", documento.~"id_valuta~", documento.~"sconto_fin_incondizionato~", documento.~"sconto_fin_cassa~",
    riga_documento.~"tot_riga_val_riga~", riga_documento.~"importo_manifattura~", riga_documento.~"importo_manifattura_val~",
    orafo_metallo.~"cod_int_met~"
FROM
    ~"DBA~".~"documento~" documento LEFT OUTER JOIN ~"DBA~".~"riga_documento~" riga_documento ON
        documento.~"id_documento~" = riga_documento.~"id_documento~",
    ~"DBA~".~"riga_documento~" riga_documento LEFT OUTER JOIN ~"DBA~".~"articolo~" articolo ON
        riga_documento.~"id_articolo~" = articolo.~"id_articolo~",
    ~"DBA~".~"articolo~" articolo LEFT OUTER JOIN ~"DBA~".~"orafo_titolo~" orafo_titolo ON
        articolo.~"id_titolo~" = orafo_titolo.~"id_titolo~",
    ~"DBA~".~"orafo_titolo~" orafo_titolo LEFT OUTER JOIN ~"DBA~".~"orafo_metallo~" orafo_metallo ON
        orafo_titolo.~"id_metallo~" = orafo_metallo.~"id_metallo~"
WHERE
    documento.~"id_documento~" = :ra_id_doc
and  orafo_metallo.~"cod_int_met~" > ''
ORDER BY
    documento.~"id_documento~" ASC" arguments=(("ra_id_doc", number))  sort="cod_int_met A " )
