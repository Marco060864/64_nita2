table(column=(type=long update=yes updatewhereclause=yes identity=yes name=id_riga_documento dbname="riga_documento.id_riga_documento" )
 column=(type=long update=yes updatewhereclause=yes name=id_documento dbname="riga_documento.id_documento" )
 column=(type=long update=yes updatewhereclause=yes name=id_articolo dbname="riga_documento.id_articolo" )
 column=(type=decimal(4) update=yes updatewhereclause=yes name=peso_netto dbname="riga_documento.peso_netto" )
 column=(type=decimal(4) update=yes updatewhereclause=yes name=peso_lordo dbname="riga_documento.peso_lordo" )
 column=(type=decimal(5) update=yes updatewhereclause=yes name=provv_imp_carea_2 dbname="riga_documento.provv_imp_carea_2" )
 column=(type=decimal(4) update=yes updatewhereclause=yes name=provv_imp_agente_2 dbname="riga_documento.provv_imp_agente_2" )
 column=(type=decimal(2) updatewhereclause=yes name=coef_calo dbname="riga_documento.coef_calo" )
 column=(type=decimal(0) updatewhereclause=yes name=num_riga dbname="riga_documento.num_riga" )
 column=(type=long updatewhereclause=yes name=articolo_id_titolo dbname="articolo.id_titolo" )
 column=(type=decimal(2) updatewhereclause=yes name=c_prezzo_laccio dbname="c_prezzo_laccio" )
 column=(type=decimal(2) updatewhereclause=yes name=c_prezzo_filo_rame dbname="c_prezzo_filo_rame" )
 column=(type=date updatewhereclause=yes name=c_data_doc dbname="c_data_doc" )
 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"riga_documento~" )  TABLE(NAME=~"articolo~" ) COLUMN(NAME=~"riga_documento.id_riga_documento~") COLUMN(NAME=~"riga_documento.id_documento~") COLUMN(NAME=~"riga_documento.id_articolo~") COLUMN(NAME=~"riga_documento.peso_netto~") COLUMN(NAME=~"riga_documento.peso_lordo~") COLUMN(NAME=~"riga_documento.provv_imp_carea_2~") COLUMN(NAME=~"riga_documento.provv_imp_agente_2~") COLUMN(NAME=~"riga_documento.coef_calo~") COLUMN(NAME=~"riga_documento.num_riga~") COLUMN(NAME=~"articolo.id_titolo~") COMPUTE(NAME=~"fn_rec_prezzo_filo_rame('L', (select data_documento from dba.documento where id_documento=~~~"riga_documento~~~".~~~"id_documento~~~")) as c_prezzo_laccio~") COMPUTE(NAME=~"fn_rec_prezzo_filo_rame('F', (select data_documento from dba.documento where id_documento=~~~"riga_documento~~~".~~~"id_documento~~~")) as c_prezzo_filo_rame~") COMPUTE(NAME=~"(select data_documento from documento where id_documento=~~~"riga_documento~~~".~~~"id_documento~~~") as c_data_doc~")    JOIN (LEFT=~"riga_documento.id_articolo~"    OP =~"=~"RIGHT=~"articolo.id_articolo~" )WHERE(    EXP1 =~"~~~"riga_documento~~~".~~~"id_documento~~~"~"   OP =~"=~"    EXP2 =~":id_doc~" ) ) ARG(NAME = ~"id_doc~" TYPE = number) " arguments=(("id_doc", number))  sort="articolo_id_titolo A coef_calo A " )
