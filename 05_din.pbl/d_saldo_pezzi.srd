table(column=(type=char(8) updatewhereclause=yes name=prof_documento_codice dbname="prof_documento.codice" dbalias=".codice" )
 column=(type=decimal(4) updatewhereclause=yes name=riga_documento_quantita dbname="riga_documento.quantita" dbalias=".quantita" )
 column=(type=long updatewhereclause=yes name=riga_documento_id_articolo dbname="riga_documento.id_articolo" dbalias=".id_articolo" )
 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"documento~" )  TABLE(NAME=~"riga_documento~" )  TABLE(NAME=~"prof_documento~" ) COLUMN(NAME=~"prof_documento.codice~") COLUMN(NAME=~"riga_documento.quantita~") COLUMN(NAME=~"riga_documento.id_articolo~")    JOIN (LEFT=~"riga_documento.id_documento~"    OP =~"=~"RIGHT=~"documento.id_documento~" )    JOIN (LEFT=~"prof_documento.id_prof_documento~"    OP =~"=~"RIGHT=~"documento.id_prof_documento~" )WHERE(    EXP1 =~"(~~~"prof_documento~~~".~~~"codice~~~"~"   OP =~"=~"    EXP2 =~"'ACLCPZ'~"    LOGIC =~"or~" ) WHERE(    EXP1 =~"~~~"prof_documento~~~".~~~"codice~~~"~"   OP =~"=~"    EXP2 =~"'RCLCPZ')~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"documento~~~".~~~"data_documento~~~"~"   OP =~">=~"    EXP2 =~":da_data~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"documento~~~".~~~"data_documento~~~"~"   OP =~"<=~"    EXP2 =~":a_data~" ) ) ARG(NAME = ~"da_data~" TYPE = date)  ARG(NAME = ~"a_data~" TYPE = date) " arguments=(("da_data", date),("a_data", date)) )
