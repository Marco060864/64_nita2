table(column=(type=char(80) updatewhereclause=yes name=rif dbname="rif" )
 column=(type=decimal(4) updatewhereclause=yes name=c_val_scarico dbname="c_val_scarico" )
 retrieve="PBSELECT( VERSION(400) DISTINCT ()TABLE(NAME=~"DBA.orafo_scar_partita~" ALIAS=~"orafo_scar_partita~" )  TABLE(NAME=~"DBA.orafo_aper_partita~" ALIAS=~"orafo_aper_partita~" )  TABLE(NAME=~"DBA.riga_documento~" ALIAS=~"riga_documento~" )  TABLE(NAME=~"DBA.documento~" ALIAS=~"documento~" ) COMPUTE(NAME=~"cast(('Rif.Doc. '+documento.~~~"num_documento~~~"+' del '+convert(char(20), ifnull(~~~"documento~~~".~~~"data_prev_consegna~~~", documento.~~~"data_documento~~~", ~~~"documento~~~".~~~"data_prev_consegna~~~") )+' - g.'+string(sum(orafo_scar_partita.val_scarico) ) )as char(80)) as rif~") COMPUTE(NAME=~"sum(orafo_scar_partita.val_scarico) as c_val_scarico~")    JOIN (LEFT=~"orafo_scar_partita.id_partita~"    OP =~"=~"RIGHT=~"orafo_aper_partita.id_partita~" )    JOIN (LEFT=~"riga_documento.id_riga_partita~"    OP =~"=~"RIGHT=~"orafo_scar_partita.id_riga_documento~" )    JOIN (LEFT=~"orafo_aper_partita.id_documento~"    OP =~"=~"RIGHT=~"documento.id_documento~" )WHERE(    EXP1 =~"( ( riga_documento.~~~"id_documento~~~"~"   OP =~"=~"    EXP2 =~":rd_doc ) )~" )  GROUP(NAME=~"orafo_scar_partita.id_partita~") GROUP(NAME=~"documento.data_prev_consegna~") GROUP(NAME=~"documento.data_documento~") GROUP(NAME=~"documento.num_documento~")) ARG(NAME = ~"rd_doc~" TYPE = number) " arguments=(("rd_doc", number)) )
