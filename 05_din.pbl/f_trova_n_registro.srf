global type f_trova_n_registro from function_object
end type

forward prototypes
global function string f_trova_n_registro (long al_id_doc)
end prototypes

global function string f_trova_n_registro (long al_id_doc);string ls_des

select descrizione
into :ls_des
from registro r, documento d
where d.id_registro=r.id_registro
and d.id_documento=:al_id_doc
;

if right(ls_des, 1)='3' or right(ls_des, 1)='4' or right(ls_des, 1)='D' then
	ls_des="/"+right(ls_des, 1)
else
	ls_des=""
end if
return ls_des
end function

