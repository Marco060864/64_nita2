 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"DBA.riga_documento~" ALIAS=~"riga_documento~" )  TABLE(NAME=~"DBA.articolo~" ALIAS=~"articolo~" )  TABLE(NAME=~"DBA.orafo_titolo~" ALIAS=~"orafo_titolo~" )  TABLE(NAME=~"orafo_metallo~" ) COLUMN(NAME=~"riga_documento.id_documento~") COLUMN(NAME=~"riga_documento.peso_netto~") COLUMN(NAME=~"riga_documento.calo~") COLUMN(NAME=~"riga_documento.fino~") COLUMN(NAME=~"riga_documento.prezzo_metallo~") COLUMN(NAME=~"orafo_titolo.titolo~") COLUMN(NAME=~"orafo_titolo.id_titolo~") COLUMN(NAME=~"orafo_metallo.codice~")    JOIN (LEFT=~"riga_documento.id_articolo~"    OP =~"=~"RIGHT=~"articolo.id_articolo~" )    JOIN (LEFT=~"articolo.id_titolo~"    OP =~"=~"RIGHT=~"orafo_titolo.id_titolo~" )    JOIN (LEFT=~"orafo_metallo.id_metallo~"    OP =~"=~"RIGHT=~"orafo_titolo.id_metallo~" )WHERE(    EXP1 =~"riga_documento.~~~"id_documento~~~"~"   OP =~"=~"    EXP2 =~":ra_id_doc~" ) ) ARG(NAME = ~"ra_id_doc~" TYPE = number) " arguments=(("ra_id_doc", number))  sort="orafo_titolo_id_titolo A " )
