compute(band=detail alignment="0" expression="~"El proveedor garantiza que los productos suministratos a la sociedad arriba indicada cumplen escupulosamente la normativa legal y reglamentaria de aplicaciones y, en especial, la relativa al Derecho de Propiedad Industrial (Registro de Marcas y Patentes …). El fabricante responderà frente a la sociedad de cuantos danos y perjuicios se les ocasiones como consecuencia de actos contrarios a dicha normativa en todos los ordenes jurisdiccionales.~""border="0" color="0" x="238" y="979" height="1455" width="18838" format="[general]" html.valueishtml="0"  name=c_note visible="1~tif( ROWCOUNT()=GETROW() AND  id_cat_attivita =7, 1, 0)"  font.face="Arial" font.height="-8" font.weight="400"  font.family="2" font.pitch="2" font.charset="0" background.mode="1" background.color="553648127" )
