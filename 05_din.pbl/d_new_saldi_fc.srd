table(column=(type=decimal(4) updatewhereclause=yes name=riga_documento_peso_netto dbname="riga_documento.peso_netto" dbalias=".peso_netto" )
 column=(type=decimal(2) updatewhereclause=yes name=riga_documento_coef_calo dbname="riga_documento.coef_calo" dbalias=".coef_calo" )
 column=(type=decimal(4) updatewhereclause=yes name=riga_documento_peso_non_prezioso dbname="riga_documento.peso_non_prezioso" dbalias=".peso_non_prezioso" )
 column=(type=decimal(2) updatewhereclause=yes name=orafo_titolo_titolo dbname="orafo_titolo.titolo" dbalias=".titolo" )
 column=(type=char(2) updatewhereclause=yes name=orafo_metallo_codice dbname="orafo_metallo.codice" dbalias=".codice" )
 column=(type=char(4) updatewhereclause=yes name=c_tipo_partita dbname="c_tipo_partita" )
 column=(type=char(1) updatewhereclause=yes name=caus_magazzino_saldi_cl_fino dbname="caus_magazzino.saldi_cl_fino" dbalias=".saldi_cl_fino" )
 retrieve="    SELECT  ~"riga_documento~".~"peso_netto~",   ~"riga_documento~".~"coef_calo~",   ~"riga_documento~".~"peso_non_prezioso~",
         ~"orafo_titolo~".~"titolo~",  ~"orafo_metallo~".~"codice~",   
      (select cod_tipo_partita from orafo_tipo_partita where orafo_tipo_partita.id_tipo_partita = caus_magazzino.id_tipo_partita) as c_tipo_partita ,
	~"caus_magazzino~".~"saldi_cl_fino~"
   FROM   (~"sog_commerciale~" LEFT OUTER JOIN ~"per_saldo_legato_o_fino~" ON ~"sog_commerciale~".~"id_sog_commerciale~" = ~"per_saldo_legato_o_fino~".~"id_sog_commerciale~"), 
~"dba~".~"riga_documento~",            ~"dba~".~"documento~",           ~"dba~".~"articolo~",           ~"dba~".~"orafo_metallo~",   
         ~"dba~".~"orafo_titolo~" ,     ~"dba~".~"caus_magazzino~", ~"dba~".~"sog_commerciale~"
   WHERE ( ~"caus_magazzino~".~"id_caus_magazzino~" = ~"riga_documento~".~"id_caus_magazzino~" ) and  
         ( ~"documento~".~"id_documento~" = ~"riga_documento~".~"id_documento~" ) and  
         ( ~"articolo~".~"id_articolo~" = ~"riga_documento~".~"id_articolo~" ) and  
         ( ~"orafo_titolo~".~"id_metallo~" = ~"orafo_metallo~".~"id_metallo~" ) and  
         ( ~"orafo_titolo~".~"id_titolo~" = ~"articolo~".~"id_titolo~" ) and  
          ( ~"caus_magazzino~".~"saldi_cl_fino~" >' ' ) AND  
		(~"sog_commerciale~".~"id_sog_commerciale~"=~"documento~".~"id_sog_commerciale~") and  ~"documento~".~"id_sog_commerciale~"=441 and
         (~"documento~".~"data_documento~" >= 20240101 AND  
         ~"documento~".~"data_documento~" <= 20240318) 
order by   ~"orafo_metallo~".~"codice~",  ~"documento~".~"data_documento~",  ~"documento~".~"num_documento~",  ~"riga_documento~".~"num_riga~"

" )
