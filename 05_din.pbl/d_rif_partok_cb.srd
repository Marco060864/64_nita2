 retrieve="PBSELECT( VERSION(400) DISTINCT ()TABLE(NAME=~"DBA.orafo_scar_partita~" ALIAS=~"orafo_scar_partita~" )  TABLE(NAME=~"DBA.orafo_aper_partita~" ALIAS=~"orafo_aper_partita~" )  TABLE(NAME=~"DBA.riga_documento~" ALIAS=~"riga_documento~" )  TABLE(NAME=~"DBA.documento~" ALIAS=~"documento~" )  TABLE(NAME=~"riga_documento~" ALIAS=~"riga_mio_ddt~" ) COMPUTE(NAME=~"cast(('Rif. Vs. Doc. '+ documento.~~~"num_documento~~~"+' del '+if documento.~~~"data_documento~~~"=20210101 then   convert(char(20), documento.~~~"data_prev_consegna~~~", 103) else convert(char(20),documento.~~~"data_documento~~~", 103) end if ) as char(50)) as rif~")    JOIN (LEFT=~"orafo_scar_partita.id_partita~"    OP =~"=~"RIGHT=~"orafo_aper_partita.id_partita~"    OUTER1 =~"orafo_scar_partita.id_partita~" )    JOIN (LEFT=~"riga_documento.id_riga_partita~"    OP =~"=~"RIGHT=~"orafo_scar_partita.id_riga_documento~" )    JOIN (LEFT=~"orafo_aper_partita.id_documento~"    OP =~"=~"RIGHT=~"documento.id_documento~" )    JOIN (LEFT=~"riga_mio_ddt.id_riga_doc_provenienza~"    OP =~"=~"RIGHT=~"riga_documento.id_riga_documento~" )WHERE(    EXP1 =~"~~~"riga_mio_ddt~~~".~~~"id_documento~~~"~"   OP =~"=~"    EXP2 =~":rd_doc~" ) ) ARG(NAME = ~"rd_doc~" TYPE = number) " arguments=(("rd_doc", number))  sort="right(rif, 4) + mid( rif, len(rif) - 6, 2 ) + mid( rif, len(rif) - 9, 2 ) A " )
