table(column=(type=long updatewhereclause=yes name=riga_documento_id_documento dbname="riga_documento.id_documento" )
 column=(type=decimal(4) updatewhereclause=yes name=riga_documento_peso_netto dbname="riga_documento.peso_netto" )
 column=(type=decimal(4) updatewhereclause=yes name=riga_documento_calo dbname="riga_documento.calo" )
 column=(type=decimal(4) updatewhereclause=yes name=riga_documento_fino dbname="riga_documento.fino" )
 column=(type=decimal(6) updatewhereclause=yes name=riga_documento_prezzo_metallo dbname="riga_documento.prezzo_metallo" )
 column=(type=decimal(2) updatewhereclause=yes name=orafo_titolo_titolo dbname="orafo_titolo.titolo" )
 column=(type=long updatewhereclause=yes identity=yes name=orafo_titolo_id_titolo dbname="orafo_titolo.id_titolo" )
 column=(type=char(2) updatewhereclause=yes name=orafo_metallo_codice dbname="orafo_metallo.codice" )
 column=(type=decimal(2) updatewhereclause=yes name=riga_documento_coef_calo dbname="riga_documento.coef_calo" )
 column=(type=decimal(4) updatewhereclause=yes name=riga_documento_peso_lordo dbname="riga_documento.peso_lordo" )
 column=(type=decimal(4) updatewhereclause=yes name=provv_imp_agente_2 dbname="riga_documento.provv_imp_agente_2" )
 column=(type=decimal(5) updatewhereclause=yes name=provv_imp_carea_2 dbname="riga_documento.provv_imp_carea_2" )
 column=(type=decimal(2) updatewhereclause=yes name=c_prezzo_laccio dbname="c_prezzo_laccio" )
 column=(type=decimal(2) updatewhereclause=yes name=c_prezzo_filo_rame dbname="c_prezzo_filo_rame" )
 column=(type=date updatewhereclause=yes name=c_data_doc dbname="c_data_doc" )
 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"DBA.riga_documento~" ALIAS=~"riga_documento~" )  TABLE(NAME=~"DBA.articolo~" ALIAS=~"articolo~" )  TABLE(NAME=~"DBA.orafo_titolo~" ALIAS=~"orafo_titolo~" )  TABLE(NAME=~"orafo_metallo~" ) COLUMN(NAME=~"riga_documento.id_documento~") COLUMN(NAME=~"riga_documento.peso_netto~") COLUMN(NAME=~"riga_documento.calo~") COLUMN(NAME=~"riga_documento.fino~") COLUMN(NAME=~"riga_documento.prezzo_metallo~") COLUMN(NAME=~"orafo_titolo.titolo~") COLUMN(NAME=~"orafo_titolo.id_titolo~") COLUMN(NAME=~"orafo_metallo.codice~") COLUMN(NAME=~"riga_documento.coef_calo~") COLUMN(NAME=~"riga_documento.peso_lordo~") COLUMN(NAME=~"riga_documento.provv_imp_agente_2~") COLUMN(NAME=~"riga_documento.provv_imp_carea_2~") COMPUTE(NAME=~"fn_rec_prezzo_filo_rame('L', (select data_documento from dba.documento where id_documento=~~~"riga_documento~~~".~~~"id_documento~~~")) as c_prezzo_laccio~") COMPUTE(NAME=~"fn_rec_prezzo_filo_rame('F', (select data_documento from dba.documento where id_documento=~~~"riga_documento~~~".~~~"id_documento~~~")) as c_prezzo_filo_rame~") COMPUTE(NAME=~"(select data_documento from documento where id_documento=~~~"riga_documento~~~".~~~"id_documento~~~") as c_data_doc~")    JOIN (LEFT=~"riga_documento.id_articolo~"    OP =~"=~"RIGHT=~"articolo.id_articolo~" )    JOIN (LEFT=~"articolo.id_titolo~"    OP =~"=~"RIGHT=~"orafo_titolo.id_titolo~" )    JOIN (LEFT=~"orafo_metallo.id_metallo~"    OP =~"=~"RIGHT=~"orafo_titolo.id_metallo~" )WHERE(    EXP1 =~"riga_documento.~~~"id_documento~~~"~"   OP =~"=~"    EXP2 =~":ra_id_doc~" ) ) ARG(NAME = ~"ra_id_doc~" TYPE = number) " arguments=(("ra_id_doc", number))  sort="orafo_titolo_id_titolo A riga_documento_coef_calo A " )
