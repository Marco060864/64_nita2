 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"DBA.documento~" ALIAS=~"documento~" )  TABLE(NAME=~"DBA.cast_iva_documento~" ALIAS=~"cast_iva_documento~" )  TABLE(NAME=~"DBA.tab_iva~" ALIAS=~"tab_iva~" )  TABLE(NAME=~"sog_commerciale~" )  TABLE(NAME=~"anagrafica~" )  TABLE(NAME=~"lingua~" ) COLUMN(NAME=~"documento.id_valuta~") COLUMN(NAME=~"cast_iva_documento.id_documento~") COLUMN(NAME=~"cast_iva_documento.val_tot_imp_v~") COLUMN(NAME=~"cast_iva_documento.val_tot_iva_v~") COLUMN(NAME=~"tab_iva.per_aliquota~") COLUMN(NAME=~"cast_iva_documento.id_tab_iva~") COLUMN(NAME=~"tab_iva.codice~") COLUMN(NAME=~"lingua.codice~")    JOIN (LEFT=~"documento.id_sog_commerciale~"    OP =~"=~"RIGHT=~"sog_commerciale.id_sog_commerciale~"    OUTER1 =~"documento.id_sog_commerciale~" )    JOIN (LEFT=~"anagrafica.id_anagrafica~"    OP =~"=~"RIGHT=~"sog_commerciale.id_anagrafica~"    OUTER2 =~"sog_commerciale.id_anagrafica~" )    JOIN (LEFT=~"lingua.id_lingua~"    OP =~"=~"RIGHT=~"anagrafica.id_lingua~"    OUTER2 =~"anagrafica.id_lingua~" )   JOIN (LEFT=~"documento.id_documento~"    OP =~"=~"RIGHT=~"cast_iva_documento.id_documento~" )    JOIN (LEFT=~"cast_iva_documento.id_tab_iva~"    OP =~"=~"RIGHT=~"tab_iva.id_tab_iva~" ) WHERE(    EXP1 =~"~~~"cast_iva_documento~~~".~~~"id_documento~~~"~"   OP =~"=~"    EXP2 =~":ra_id_doc~" ) ) ARG(NAME = ~"ra_id_doc~" TYPE = number) " arguments=(("ra_id_doc", number))  sort="cast_iva_documento_id_tab_iva A " )
