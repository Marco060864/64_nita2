 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"DBA.documento~" ALIAS=~"documento~" )  TABLE(NAME=~"DBA.sog_commerciale_gen~" ALIAS=~"sog_commerciale_gen~" )  TABLE(NAME=~"DBA.destinazione~" ALIAS=~"destinazione~" )  TABLE(NAME=~"DBA.riga_documento~" ALIAS=~"Riga_Documento~" )  TABLE(NAME=~"DBA.articolo~" ALIAS=~"Articolo~" )  TABLE(NAME=~"DBA.riga_documento~" ALIAS=~"riga_documento_origine~" )  TABLE(NAME=~"DBA.documento~" ALIAS=~"documento_origine~" )  TABLE(NAME=~"DBA.orafo_titolo~" ALIAS=~"orafo_titolo~" )  TABLE(NAME=~"DBA.prof_documento~" ALIAS=~"prof_documento_origine~" ) COLUMN(NAME=~"documento.id_documento~") COLUMN(NAME=~"documento.num_progressivo~") COLUMN(NAME=~"documento.num_documento~") COLUMN(NAME=~"documento.data_documento~") COLUMN(NAME=~"documento.data_prev_consegna~") COLUMN(NAME=~"documento.note_intestazione~") COLUMN(NAME=~"documento.bollo~") COLUMN(NAME=~"sog_commerciale_gen.codice~") COLUMN(NAME=~"sog_commerciale_gen.rag_soc_1~") COLUMN(NAME=~"destinazione.rag_soc_1~") COLUMN(NAME=~"Riga_Documento.num_riga~") COLUMN(NAME=~"Riga_Documento.id_articolo~") COLUMN(NAME=~"Riga_Documento.descrizione~") COLUMN(NAME=~"Riga_Documento.quantita~") COLUMN(NAME=~"Riga_Documento.peso_netto~") COLUMN(NAME=~"Riga_Documento.dim_l~") COLUMN(NAME=~"Articolo.codice~") COLUMN(NAME=~"documento_origine.num_documento~") COLUMN(NAME=~"orafo_titolo.titolo~") COLUMN(NAME=~"prof_documento_origine.codice~")    JOIN (LEFT=~"documento.id_sog_commerciale~"    OP =~"=~"RIGHT=~"sog_commerciale_gen.id_sog_commerciale~"    OUTER1 =~"documento.id_sog_commerciale~" )    JOIN (LEFT=~"documento.id_destinazione~"    OP =~"=~"RIGHT=~"destinazione.id_destinazione~"    OUTER1 =~"documento.id_destinazione~" )    JOIN (LEFT=~"documento.id_documento~"    OP =~"=~"RIGHT=~"Riga_Documento.id_documento~"    OUTER1 =~"documento.id_documento~" )    JOIN (LEFT=~"Riga_Documento.id_articolo~"    OP =~"=~"RIGHT=~"Articolo.id_articolo~"    OUTER1 =~"Riga_Documento.id_articolo~" )    JOIN (LEFT=~"Riga_Documento.id_riga_doc_provenienza~"    OP =~"=~"RIGHT=~"riga_documento_origine.id_riga_documento~"    OUTER1 =~"Riga_Documento.id_riga_doc_provenienza~" )    JOIN (LEFT=~"riga_documento_origine.id_documento~"    OP =~"=~"RIGHT=~"documento_origine.id_documento~"    OUTER1 =~"riga_documento_origine.id_documento~" )    JOIN (LEFT=~"Articolo.id_titolo~"    OP =~"=~"RIGHT=~"orafo_titolo.id_titolo~"    OUTER1 =~"Articolo.id_titolo~" )    JOIN (LEFT=~"documento_origine.id_prof_documento~"    OP =~"=~"RIGHT=~"prof_documento_origine.id_prof_documento~"    OUTER1 =~"documento_origine.id_prof_documento~" )WHERE(    EXP1 =~"riga_documento.id_riga_doc_padre~"   OP =~"is~"    EXP2 =~"null~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"documento~~~".~~~"id_documento~~~"~"   OP =~"=~"    EXP2 =~":id_doc~" ) ) ORDER(NAME=~"Riga_Documento.num_riga~" ASC=yes )  ORDER(NAME=~"documento.id_documento~" ASC=yes ) ARG(NAME = ~"id_doc~" TYPE = number) " arguments=(("id_doc", number)) )
