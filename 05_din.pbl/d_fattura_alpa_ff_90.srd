 column=(type=decimal(4) updatewhereclause=yes name=azienda_tot_capitale dbname="azienda.tot_capitale" dbalias=".tot_capitale" )
 column=(type=char(32766) updatewhereclause=no name=azienda_note dbname="azienda.note" dbalias=".note" )
