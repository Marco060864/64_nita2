 column=(type=char(40) updatewhereclause=yes name=azienda_rag_soc_1 dbname="azienda.rag_soc_1" dbalias=".rag_soc_1" )
 column=(type=char(16) updatewhereclause=yes name=azienda_par_iva dbname="azienda.par_iva" dbalias=".par_iva" )
 column=(type=char(16) updatewhereclause=yes name=azienda_cod_fiscale dbname="azienda.cod_fiscale" dbalias=".cod_fiscale" )
