table(column=(type=long updatewhereclause=yes name=riga_documento_id_documento dbname="riga_documento.id_documento" )
 column=(type=decimal(6) updatewhereclause=yes name=prezzo_metallo dbname="riga_documento.prezzo_metallo" )
 column=(type=decimal(2) updatewhereclause=yes name=orafo_titolo_titolo dbname="orafo_titolo.titolo" )
 column=(type=long updatewhereclause=yes name=orafo_titolo_id_titolo dbname="orafo_titolo.id_titolo" )
 column=(type=char(2) updatewhereclause=yes name=orafo_metallo_codice dbname="orafo_metallo.codice" )
 column=(type=decimal(4) updatewhereclause=yes name=c_peso_netto dbname="c_peso_netto" )
 column=(type=decimal(4) updatewhereclause=yes name=c_fino dbname="c_fino" )
 column=(type=decimal(4) updatewhereclause=yes name=c_calo dbname="c_calo" )
 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"DBA.riga_documento~" ALIAS=~"riga_documento~" )  TABLE(NAME=~"DBA.articolo~" ALIAS=~"articolo~" )  TABLE(NAME=~"DBA.orafo_titolo~" ALIAS=~"orafo_titolo~" )  TABLE(NAME=~"orafo_metallo~" ) COLUMN(NAME=~"riga_documento.id_documento~") COLUMN(NAME=~"riga_documento.prezzo_metallo~") COLUMN(NAME=~"orafo_titolo.titolo~") COLUMN(NAME=~"orafo_titolo.id_titolo~") COLUMN(NAME=~"orafo_metallo.codice~") COMPUTE(NAME=~"sum(case when peso_netto >0 then peso_netto else 0 end case) as c_peso_netto~") COMPUTE(NAME=~"sum(fino ) as c_fino~") COMPUTE(NAME=~"sum(calo) as c_calo~")    JOIN (LEFT=~"riga_documento.id_articolo~"    OP =~"=~"RIGHT=~"articolo.id_articolo~" )    JOIN (LEFT=~"articolo.id_titolo~"    OP =~"=~"RIGHT=~"orafo_titolo.id_titolo~" )    JOIN (LEFT=~"orafo_metallo.id_metallo~"    OP =~"=~"RIGHT=~"orafo_titolo.id_metallo~" )WHERE(    EXP1 =~"riga_documento.~~~"id_documento~~~"~"   OP =~"=~"    EXP2 =~":ra_id_doc~" )  GROUP(NAME=~"riga_documento.id_documento~") GROUP(NAME=~"orafo_metallo.codice~") GROUP(NAME=~"orafo_titolo.id_titolo~") GROUP(NAME=~"orafo_titolo.titolo~") GROUP(NAME=~"riga_documento.prezzo_metallo~")) ARG(NAME = ~"ra_id_doc~" TYPE = number) " arguments=(("ra_id_doc", number))  sort="orafo_titolo_titolo A " )
