footer(height=5000 color="536870912" )
detail(height=0 color="553648127"  height.autosize=yes)
table(column=(type=long updatewhereclause=yes identity=yes name=id_documento dbname="documento.id_documento" )
 column=(type=char(16) updatewhereclause=yes name=num_documento dbname="documento.num_documento" )
