 column=(type=decimal(4) updatewhereclause=yes name=peso_laccio dbname="orafo_par_sistema.peso_laccio" )
 column=(type=decimal(4) updatewhereclause=yes name=peso_filo_rame dbname="orafo_par_sistema.peso_filo_rame" )
