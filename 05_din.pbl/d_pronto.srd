 column=(type=char(40) updatewhereclause=yes name=anagrafica_rag_soc_1 dbname="anagrafica.rag_soc_1" dbalias="anagrafica.rag_soc_1" )
 column=(type=char(40) updatewhereclause=yes name=anagrafica_indirizzo dbname="anagrafica.indirizzo" dbalias="anagrafica.indirizzo" )
