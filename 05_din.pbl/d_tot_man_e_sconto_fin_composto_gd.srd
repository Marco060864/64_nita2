 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"DBA.documento~" ALIAS=~"documento~" )  TABLE(NAME=~"DBA.riga_documento~" ALIAS=~"riga_documento~" )  TABLE(NAME=~"DBA.articolo~" ALIAS=~"articolo~" )  TABLE(NAME=~"DBA.orafo_titolo~" ALIAS=~"orafo_titolo~" )  TABLE(NAME=~"DBA.orafo_metallo~" ALIAS=~"orafo_metallo~" )  TABLE(NAME=~"lingua~" ) COLUMN(NAME=~"documento.id_documento~") COLUMN(NAME=~"documento.id_valuta~") COLUMN(NAME=~"documento.sconto_fin_incondizionato~") COLUMN(NAME=~"documento.sconto_fin_cassa~") COLUMN(NAME=~"riga_documento.tot_riga_val_riga~") COLUMN(NAME=~"riga_documento.importo_manifattura~") COLUMN(NAME=~"riga_documento.importo_manifattura_val~") COLUMN(NAME=~"orafo_metallo.cod_int_met~") COLUMN(NAME=~"orafo_metallo.codice~") COLUMN(NAME=~"lingua.codice~")    JOIN (LEFT=~"documento.id_documento~"    OP =~"=~"RIGHT=~"riga_documento.id_documento~"    OUTER1 =~"documento.id_documento~" )    JOIN (LEFT=~"riga_documento.id_articolo~"    OP =~"=~"RIGHT=~"articolo.id_articolo~"    OUTER1 =~"riga_documento.id_articolo~" )    JOIN (LEFT=~"articolo.id_titolo~"    OP =~"=~"RIGHT=~"orafo_titolo.id_titolo~"    OUTER1 =~"articolo.id_titolo~" )    JOIN (LEFT=~"orafo_titolo.id_metallo~"    OP =~"=~"RIGHT=~"orafo_metallo.id_metallo~"    OUTER1 =~"orafo_titolo.id_metallo~" )    JOIN (LEFT=~"lingua.id_lingua~"    OP =~"=~"RIGHT=~"documento.id_lingua~"    OUTER2 =~"documento.id_lingua~" )WHERE(    EXP1 =~"documento.~~~"id_documento~~~"~"   OP =~"=~"    EXP2 =~":ra_id_doc~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"orafo_metallo.~~~"cod_int_met~~~"~"   OP =~">~"    EXP2 =~"''~" ) ) ORDER(NAME=~"documento.id_documento~" ASC=yes ) ARG(NAME = ~"ra_id_doc~" TYPE = number) " arguments=(("ra_id_doc", number))  sort="cod_int_met A " )
