table(column=(type=date updatewhereclause=yes name=scadenza_data_scadenza dbname="scadenza.data_scadenza" )
 column=(type=decimal(4) updatewhereclause=yes name=scadenza_importo dbname="scadenza.importo" )
 column=(type=char(32766) updatewhereclause=no name=scadenza_note dbname="scadenza.note" )
 column=(type=char(1) updatewhereclause=yes name=scadenza_stato_scadenza dbname="scadenza.stato_scadenza" )
 column=(type=char(1) updatewhereclause=yes name=scadenza_esito_pagamento dbname="scadenza.esito_pagamento" values="EMESSO	E/DISTINTA	D/PAGATO	P/INSOLUTO	I/BLOCCATO	B/" )
 column=(type=long updatewhereclause=yes name=scadenza_id_riga_distinta_banca dbname="scadenza.id_riga_distinta_banca" )
 column=(type=long updatewhereclause=yes name=scadenza_id_par_aperta dbname="scadenza.id_par_aperta" )
 column=(type=char(8) updatewhereclause=yes name=sog_commerciale_codice dbname="sog_commerciale.codice" )
 column=(type=char(4) updatewhereclause=yes name=tipo_pagamento_codice dbname="tipo_pagamento.codice" )
 column=(type=long updatewhereclause=yes identity=yes name=documento_id_documento dbname="documento.id_documento" )
 column=(type=char(16) updatewhereclause=yes name=documento_num_documento dbname="documento.num_documento" )
 column=(type=date updatewhereclause=yes name=documento_data_documento dbname="documento.data_documento" )
 column=(type=char(40) updatewhereclause=yes name=anagrafica_rag_soc_1 dbname="anagrafica.rag_soc_1" )
 column=(type=decimal(0) updatewhereclause=yes name=reg_pd_num_progressivo dbname="reg_pd.num_progressivo" )
 column=(type=date updatewhereclause=yes name=reg_pd_data_registrazione dbname="reg_pd.data_registrazione" )
 column=(type=char(16) updatewhereclause=yes name=reg_pd_num_documento dbname="reg_pd.num_documento" )
 column=(type=date updatewhereclause=yes name=reg_pd_data_documento dbname="reg_pd.data_documento" )
 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"scadenza~" ALIAS=~"Scadenza~" )  TABLE(NAME=~"DBA.documento~" ALIAS=~"documento~" )  TABLE(NAME=~"par_aperta~" )  TABLE(NAME=~"reg_pd~" )  TABLE(NAME=~"DBA.sog_commerciale~" ALIAS=~"Sog_Commerciale~" )  TABLE(NAME=~"DBA.anagrafica~" ALIAS=~"Anagrafica~" )  TABLE(NAME=~"DBA.tipo_pagamento~" ALIAS=~"Tipo_Pagamento~" )  TABLE(NAME=~"azienda~" ) COLUMN(NAME=~"Scadenza.data_scadenza~") COLUMN(NAME=~"Scadenza.importo~") COLUMN(NAME=~"Scadenza.note~") COLUMN(NAME=~"Scadenza.stato_scadenza~") COLUMN(NAME=~"Scadenza.esito_pagamento~") COLUMN(NAME=~"Scadenza.id_riga_distinta_banca~") COLUMN(NAME=~"Scadenza.id_par_aperta~") COLUMN(NAME=~"Sog_Commerciale.codice~") COLUMN(NAME=~"Tipo_Pagamento.codice~") COLUMN(NAME=~"documento.id_documento~") COLUMN(NAME=~"documento.num_documento~") COLUMN(NAME=~"documento.data_documento~") COLUMN(NAME=~"Anagrafica.rag_soc_1~") COLUMN(NAME=~"reg_pd.num_progressivo~") COLUMN(NAME=~"reg_pd.data_registrazione~") COLUMN(NAME=~"reg_pd.num_documento~") COLUMN(NAME=~"reg_pd.data_documento~")    JOIN (LEFT=~"Scadenza.id_documento~"    OP =~"=~"RIGHT=~"documento.id_documento~"    OUTER1 =~"Scadenza.id_documento~" )    JOIN (LEFT=~"par_aperta.id_par_aperta~"    OP =~"=~"RIGHT=~"Scadenza.id_par_aperta~"    OUTER2 =~"Scadenza.id_par_aperta~" )    JOIN (LEFT=~"reg_pd.id_reg_pd~"    OP =~"=~"RIGHT=~"par_aperta.id_reg_pd~"    OUTER2 =~"par_aperta.id_reg_pd~" )    JOIN (LEFT=~"Scadenza.id_sog_commerciale~"    OP =~"=~"RIGHT=~"Sog_Commerciale.id_sog_commerciale~" )    JOIN (LEFT=~"Sog_Commerciale.id_anagrafica~"    OP =~"=~"RIGHT=~"Anagrafica.id_anagrafica~" )    JOIN (LEFT=~"Scadenza.id_tipo_pagamento~"    OP =~"=~"RIGHT=~"Tipo_Pagamento.id_tipo_pagamento~" )    JOIN (LEFT=~"Scadenza.id_azienda~"    OP =~"=~"RIGHT=~"azienda.id_azienda~" )) ORDER(NAME=~"Scadenza.data_scadenza~" ASC=yes )  ORDER(NAME=~"Anagrafica.rag_soc_1~" ASC=yes ) " )
