 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"ws_registri_iva~" )  TABLE(NAME=~"tab_ali_dich_per~" )  TABLE(NAME=~"tab_iva~" ) COLUMN(NAME=~"ws_registri_iva.codice_iva~") COLUMN(NAME=~"ws_registri_iva.per_aliquota~") COLUMN(NAME=~"ws_registri_iva.per_detrazione~") COLUMN(NAME=~"ws_registri_iva.id_tab_iva~") COLUMN(NAME=~"ws_registri_iva.imponibile~") COLUMN(NAME=~"ws_registri_iva.numero~") COLUMN(NAME=~"ws_registri_iva.tipo_registro~") COLUMN(NAME=~"ws_registri_iva.data_registrazione~") COLUMN(NAME=~"ws_registri_iva.des_breve~") COLUMN(NAME=~"ws_registri_iva.segno_reg_iva~") COLUMN(NAME=~"ws_registri_iva.ges_sco_giornaliero~") COLUMN(NAME=~"ws_registri_iva.importo~") COLUMN(NAME=~"ws_registri_iva.ges_beni_rivendita~") COLUMN(NAME=~"ws_registri_iva.ges_beni_strumentali~") COLUMN(NAME=~"ws_registri_iva.imposta~") COLUMN(NAME=~"ws_registri_iva.ges_oper_intracomunitarie~") COLUMN(NAME=~"tab_ali_dich_per.nome~") COLUMN(NAME=~"tab_ali_dich_per.id_tab_iva~") COLUMN(NAME=~"tab_ali_dich_per.segno~") COLUMN(NAME=~"tab_ali_dich_per.id_tab_ali_dich_per~") COLUMN(NAME=~"ws_registri_iva.id_valuta~") COLUMN(NAME=~"ws_registri_iva.data_comp_liq_iva~") COLUMN(NAME=~"ws_registri_iva.id_prof_registrazione~") COLUMN(NAME=~"tab_iva.ges_oper_intracomunitarie~")    JOIN (LEFT=~"ws_registri_iva.id_tab_iva~"    OP =~"=~"RIGHT=~"tab_ali_dich_per.id_tab_iva~" )    JOIN (LEFT=~"tab_iva.id_tab_iva~"    OP =~"=~"RIGHT=~"tab_ali_dich_per.id_tab_iva~" )WHERE(    EXP1 =~"~~~"ws_registri_iva~~~".~~~"tipo_registro~~~"~"   OP =~"=~"    EXP2 =~":ra_tipo_registro~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"((~~~"ws_registri_iva~~~".~~~"data_registrazione~~~"~"   OP =~">=~"    EXP2 =~":ra_dalla_data~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"ws_registri_iva~~~".~~~"data_registrazione~~~"~"   OP =~"<=~"    EXP2 =~":ra_alla_data)~"    LOGIC =~"or~" ) WHERE(    EXP1 =~"(~~~"ws_registri_iva~~~".~~~"data_comp_liq_iva~~~"~"   OP =~">=~"    EXP2 =~":ra_dalla_data~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"ws_registri_iva~~~".~~~"data_comp_liq_iva~~~"~"   OP =~"<=~"    EXP2 =~":ra_alla_data))~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"tab_ali_dich_per~~~".~~~"nome~~~"~"   OP =~"=~"    EXP2 =~":ra_nome~" ) ) ORDER(NAME=~"ws_registri_iva.codice_iva~" ASC=yes ) ARG(NAME = ~"ra_tipo_registro~" TYPE = string)  ARG(NAME = ~"ra_dalla_data~" TYPE = date)  ARG(NAME = ~"ra_alla_data~" TYPE = date)  ARG(NAME = ~"ra_nome~" TYPE = string) " arguments=(("ra_tipo_registro", string),("ra_dalla_data", date),("ra_alla_data", date),("ra_nome", string))  sort="ges_beni_rivendita D ges_beni_strumentali D codice_iva A " )
group(level=1 header.height=112 trailer.height=0 by=("ges_beni_rivendita" , "ges_beni_strumentali" ) header.color="553648127" trailer.color="553648127" )
group(level=2 header.height=4 trailer.height=88 by=("codice_iva" ) header.color="536870912" trailer.color="536870912" )
