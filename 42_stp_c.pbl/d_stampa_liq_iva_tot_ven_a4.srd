 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"ws_liquidazione_iva~" )  TABLE(NAME=~"attivita~" )  TABLE(NAME=~"azienda~" )  TABLE(NAME=~"par_sistema~" ) COLUMN(NAME=~"ws_liquidazione_iva.id_esercizio~") COLUMN(NAME=~"ws_liquidazione_iva.id_attivita~") COLUMN(NAME=~"ws_liquidazione_iva.tipo_registro~") COLUMN(NAME=~"ws_liquidazione_iva.data_comp_liq_iva~") COLUMN(NAME=~"ws_liquidazione_iva.id_reg_pd~") COLUMN(NAME=~"ws_liquidazione_iva.segno_reg_iva~") COLUMN(NAME=~"ws_liquidazione_iva.id_tab_iva~") COLUMN(NAME=~"ws_liquidazione_iva.codice~") COLUMN(NAME=~"ws_liquidazione_iva.des_breve~") COLUMN(NAME=~"ws_liquidazione_iva.tipo_iva~") COLUMN(NAME=~"ws_liquidazione_iva.per_aliquota~") COLUMN(NAME=~"ws_liquidazione_iva.per_detrazione~") COLUMN(NAME=~"ws_liquidazione_iva.per_ventilazione~") COLUMN(NAME=~"ws_liquidazione_iva.ges_plafond~") COLUMN(NAME=~"attivita.descrizione~") COLUMN(NAME=~"azienda.rag_soc_1~") COLUMN(NAME=~"ws_liquidazione_iva.usa_prorata~") COLUMN(NAME=~"ws_liquidazione_iva.ges_sco_giornaliero~") COLUMN(NAME=~"attivita.liq_iva~") COLUMN(NAME=~"par_sistema.per_iva_trimestrale~") COLUMN(NAME=~"ws_liquidazione_iva.st_liquidazione~") COLUMN(NAME=~"attivita.attuale_plafond~") COMPUTE(NAME=~"cast(null as char) as mese~") COMPUTE(NAME=~"cast(:rn_ges_periodo as char) as ges_periodo~") COMPUTE(NAME=~"CAST((SELECT ID_VALUTA FROM ESERCIZIO WHERE ID_ESERCIZIO=:rn_id_esercizio) AS INTEGER) AS VALUTA~") COMPUTE(NAME=~"cast((select id_valuta from esercizio where id_esercizio=~~~"ws_liquidazione_iva~~~".~~~"id_esercizio~~~") as integer) as val_reg~") COMPUTE(NAME=~"CAST ( FN_CONV_VALUTA ( VAL_REG, ~~~"ws_liquidazione_iva~~~".~~~"imponibile~~~", VALUTA ) AS DECIMAL (18,4) ) AS IMPONIBILE~") COMPUTE(NAME=~"CAST ( FN_CONV_VALUTA ( VAL_REG, ~~~"ws_liquidazione_iva~~~".~~~"imposta~~~", VALUTA ) AS DECIMAL (18,4) ) AS IMPOSTA~") COMPUTE(NAME=~"cast(0 as decimal(18,4)) as per_prorata~") COMPUTE(NAME=~"cast(0 as decimal(18,4)) as ult_iva_credito~") COMPUTE(NAME=~"cast(0 as decimal(18,4)) as trimestre~") COMPUTE(NAME=~"cast(:rn_c_imposta as decimal(18,4)) as c_imposta~") COMPUTE(NAME=~"cast(:rn_c_periodo as decimal(18,4)) as c_periodo~") COMPUTE(NAME=~"cast(:rn_acconto as decimal(18,4)) as acconto~") COMPUTE(NAME=~"cast(0 as decimal(18,4)) as deb_prec~")    JOIN (LEFT=~"ws_liquidazione_iva.id_attivita~"    OP =~"=~"RIGHT=~"attivita.id_attivita~" )    JOIN (LEFT=~"azienda.id_attivita~"    OP =~"=~"RIGHT=~"attivita.id_attivita~" )    JOIN (LEFT=~"azienda.id_azienda~"    OP =~"=~"RIGHT=~"par_sistema.id_azienda~" )WHERE(    EXP1 =~"( ~~~"ws_liquidazione_iva~~~".~~~"id_attivita~~~"~"   OP =~"=~"    EXP2 =~":rn_id_attivita )~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"( ( ~~~"ws_liquidazione_iva~~~".~~~"data_comp_liq_iva~~~"~"   OP =~">=~"    EXP2 =~":rn_data_in )~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"( ~~~"ws_liquidazione_iva~~~".~~~"data_comp_liq_iva~~~"~"   OP =~"<=~"    EXP2 =~":rn_data_fin ) )~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"azienda~~~".~~~"id_azienda~~~"~"   OP =~"=~"    EXP2 =~"1~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"ws_liquidazione_iva~~~".~~~"id_mod_registro~~~"~"   OP =~"<>~"    EXP2 =~":rd_reg_sos~" ) ) ORDER(NAME=~"ws_liquidazione_iva.codice~" ASC=yes )  ORDER(NAME=~"ws_liquidazione_iva.tipo_registro~" ASC=yes ) ARG(NAME = ~"rn_flag~" TYPE = string)  ARG(NAME = ~"rn_id_esercizio~" TYPE = number)  ARG(NAME = ~"rn_id_attivita~" TYPE = number)  ARG(NAME = ~"rn_data_in~" TYPE = date)  ARG(NAME = ~"rn_data_fin~" TYPE = date)  ARG(NAME = ~"rn_c_imposta~" TYPE = number)  ARG(NAME = ~"rn_acconto~" TYPE = number)  ARG(NAME = ~"rn_c_periodo~" TYPE = number)  ARG(NAME = ~"rn_ges_periodo~" TYPE = string)  ARG(NAME = ~"rd_tot_iva~" TYPE = number)  ARG(NAME = ~"rd_reg_sos~" TYPE = number) " arguments=(("rn_flag", string),("rn_id_esercizio", number),("rn_id_attivita", number),("rn_data_in", date),("rn_data_fin", date),("rn_c_imposta", number),("rn_acconto", number),("rn_c_periodo", number),("rn_ges_periodo", string),("rd_tot_iva", number),("rd_reg_sos", number)) )
