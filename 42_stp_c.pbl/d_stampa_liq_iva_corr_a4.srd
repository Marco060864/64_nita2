//objectcomments iva ventilata
release 6;
datawindow(units=3 timer_interval=0 color=16777215 processing=0 print.documentname="" print.orientation = 0 print.margin.left = 635 print.margin.right = 635 print.margin.top = 635 print.margin.bottom = 635 print.paper.source = 0 print.paper.size = 0 print.prompt=no print.buttons=no print.preview.buttons=no )
header(height=1534 color="536870912" )
summary(height=1084 color="553648127" )
footer(height=0 color="553648127" )
detail(height=502 color="553648127" )
table(column=(type=long updatewhereclause=yes name=id_tab_iva dbname="esercizio.id_tab_iva" )
 column=(type=decimal(4) updatewhereclause=yes name=per_imp dbname="esercizio.per_imp" )
 column=(type=decimal(4) updatewhereclause=yes name=per_iva dbname="esercizio.per_iva" )
 column=(type=char(8) updatewhereclause=yes name=codice dbname="esercizio.codice" )
 column=(type=char(20) updatewhereclause=yes name=des_breve dbname="esercizio.des_breve" )
 column=(type=char(1) updatewhereclause=yes name=tipo_iva dbname="esercizio.tipo_iva" )
 column=(type=decimal(2) updatewhereclause=yes name=per_aliquota dbname="esercizio.per_aliquota" )
 column=(type=decimal(2) updatewhereclause=yes name=per_detrazione dbname="esercizio.per_detrazione" )
 column=(type=long updatewhereclause=yes name=valuta dbname="valuta" )
 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"tmp_iva~" )  TABLE(NAME=~"tab_iva~" ) COLUMN(NAME=~"tmp_iva.id_tab_iva~") COLUMN(NAME=~"tmp_iva.per_imp~") COLUMN(NAME=~"tmp_iva.per_iva~") COLUMN(NAME=~"tab_iva.codice~") COLUMN(NAME=~"tab_iva.des_breve~") COLUMN(NAME=~"tab_iva.tipo_iva~") COLUMN(NAME=~"tab_iva.per_aliquota~") COLUMN(NAME=~"tab_iva.per_detrazione~") COMPUTE(NAME=~"CAST((SELECT ID_VALUTA FROM ESERCIZIO WHERE ID_ESERCIZIO=:rn_id_esercizio) AS INTEGER) AS VALUTA~")    JOIN (LEFT=~"tmp_iva.id_tab_iva~"    OP =~"=~"RIGHT=~"tab_iva.id_tab_iva~"    OUTER1 =~"tmp_iva.id_tab_iva~" )) ARG(NAME = ~"rn_flag~" TYPE = string)  ARG(NAME = ~"rn_id_esercizio~" TYPE = number)  ARG(NAME = ~"rn_id_attivita~" TYPE = number)  ARG(NAME = ~"rn_data_in~" TYPE = date)  ARG(NAME = ~"rn_data_fin~" TYPE = date) " arguments=(("rn_flag", string),("rn_id_esercizio", number),("rn_id_attivita", number),("rn_data_in", date),("rn_data_fin", date)) )
