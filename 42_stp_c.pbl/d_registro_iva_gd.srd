table(column=(type=char(4) updatewhereclause=yes name=esercizio_codice dbname="esercizio.codice" )
 column=(type=long update=yes updatewhereclause=yes name=registro_id_esercizio dbname="registro.id_esercizio" )
 column=(type=char(2) update=yes updatewhereclause=yes name=registro_tipo_registro dbname="registro.tipo_registro" values="IVA acquisti	IA/IVA vendite	IV/Manageriale	MN/Prima nota	PN/Preventivi acquisti	PA/Preventivi vendite	PV/Ordini acquisti	OA/Ordini vendite	OV/DDT acquisti	DA/DDT vendite	DV/Liste prelievo acquisti	LA/Liste prelievo vendite	LV/Generico acquisti	GA/Generico vendite	GV/" )
 column=(type=long update=yes updatewhereclause=yes identity=yes name=registro_id_registro dbname="registro.id_registro" )
 column=(type=decimal(0) update=yes updatewhereclause=yes name=registro_numero dbname="registro.numero" validation=" real(gettext())  >= 0" validationmsg="'Immettere un valore >= 0'" )
 column=(type=char(40) update=yes updatewhereclause=yes name=registro_descrizione dbname="registro.descrizione" )
 column=(type=long update=yes updatewhereclause=yes name=registro_id_attivita dbname="registro.id_attivita" )
 column=(type=long update=yes updatewhereclause=yes name=registro_id_azienda dbname="registro.id_azienda" initial="1" )
 column=(type=char(40) updatewhereclause=yes name=attivita_descrizione dbname="attivita.descrizione" )
 column=(type=long updatewhereclause=yes name=attivita_id_azienda dbname="attivita.id_azienda" initial="1" )
 column=(type=long updatewhereclause=yes name=esercizio_id_azienda dbname="esercizio.id_azienda" initial="1" )
 column=(type=char(1) update=yes updatewhereclause=yes name=registro_usa_prorata dbname="registro.usa_prorata" initial="N" values="	S/	N" validation=" gettext()  = 'S' OR  gettext()  = 'N'" validationmsg="'Immettere: S, N'" )
 column=(type=char(1) update=yes updatewhereclause=yes name=registro_iva_sospensione dbname="registro.iva_sospensione" initial="N" values="	S/	N" validation=" gettext()  = 'S' OR  gettext()  = 'N'" validationmsg="'Immettere: S, N'" )
 column=(type=char(1) update=yes updatewhereclause=yes name=registro_ges_sco_giornaliero dbname="registro.ges_sco_giornaliero" initial="N" values="	S/	N" validation=" gettext()  = 'S' OR  gettext()  = 'N'" validationmsg="'Immettere: S, N'" )
 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"registro~" )  TABLE(NAME=~"attivita~" )  TABLE(NAME=~"esercizio~" ) COLUMN(NAME=~"esercizio.codice~") COLUMN(NAME=~"registro.id_esercizio~") COLUMN(NAME=~"registro.tipo_registro~") COLUMN(NAME=~"registro.id_registro~") COLUMN(NAME=~"registro.numero~") COLUMN(NAME=~"registro.descrizione~") COLUMN(NAME=~"registro.id_attivita~") COLUMN(NAME=~"registro.id_azienda~") COLUMN(NAME=~"attivita.descrizione~") COLUMN(NAME=~"attivita.id_azienda~") COLUMN(NAME=~"esercizio.id_azienda~") COLUMN(NAME=~"registro.usa_prorata~") COLUMN(NAME=~"registro.iva_sospensione~") COLUMN(NAME=~"registro.ges_sco_giornaliero~")    JOIN (LEFT=~"esercizio.id_esercizio~"    OP =~"=~"RIGHT=~"registro.id_esercizio~" )    JOIN (LEFT=~"attivita.id_attivita~"    OP =~"=~"RIGHT=~"registro.id_attivita~" )WHERE(    EXP1 =~"~~~"registro~~~".~~~"id_azienda~~~"~"   OP =~"in~"    EXP2 =~"(0,1)~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"(~~~"registro~~~".~~~"tipo_registro~~~"~"   OP =~"=~"    EXP2 =~"'IV'~"    LOGIC =~"or~" ) WHERE(    EXP1 =~"~~~"registro~~~".~~~"tipo_registro~~~"~"   OP =~"=~"    EXP2 =~"'IC'~"    LOGIC =~"or~" ) WHERE(    EXP1 =~"~~~"registro~~~".~~~"tipo_registro~~~"~"   OP =~"=~"    EXP2 =~"'IA')~" ) ) ORDER(NAME=~"esercizio.codice~" ASC=yes )  ORDER(NAME=~"registro.tipo_registro~" ASC=yes )  ORDER(NAME=~"registro.numero~" ASC=yes ) " )
