 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"libro_giornale~" )  TABLE(NAME=~"reg_pd~" )  TABLE(NAME=~"esercizio~" )  TABLE(NAME=~"registro~" ) COLUMN(NAME=~"libro_giornale.id_reg_pd~") COLUMN(NAME=~"libro_giornale.num_prog~") COLUMN(NAME=~"libro_giornale.data_registrazione~") COLUMN(NAME=~"libro_giornale.num_documento~") COLUMN(NAME=~"libro_giornale.data_documento~") COLUMN(NAME=~"libro_giornale.descrizione~") COLUMN(NAME=~"libro_giornale.codice~") COLUMN(NAME=~"libro_giornale.descrizione_a~") COLUMN(NAME=~"libro_giornale.dare~") COLUMN(NAME=~"libro_giornale.avere~") COLUMN(NAME=~"libro_giornale.saldo_dare~") COLUMN(NAME=~"libro_giornale.saldo_avere~") COLUMN(NAME=~"libro_giornale.saldo_riga~") COLUMN(NAME=~"esercizio.codice~") COLUMN(NAME=~"esercizio.ult_data_stampa_bollato~") COLUMN(NAME=~"esercizio.riporto~") COLUMN(NAME=~"libro_giornale.id_mov_contabile~") COLUMN(NAME=~"registro.tipo_registro~")    JOIN (LEFT=~"libro_giornale.id_reg_pd~"    OP =~"=~"RIGHT=~"reg_pd.id_reg_pd~" )    JOIN (LEFT=~"esercizio.id_esercizio~"    OP =~"=~"RIGHT=~"registro.id_esercizio~" )    JOIN (LEFT=~"reg_pd.id_registro~"    OP =~"=~"RIGHT=~"registro.id_registro~" )WHERE(    EXP1 =~"~~~"libro_giornale~~~".~~~"num_prog~~~"~"   OP =~">=~"    EXP2 =~":rn_num_prog~" ) ) ORDER(NAME=~"libro_giornale.num_prog~" ASC=yes )  ORDER(NAME=~"libro_giornale.data_registrazione~" ASC=yes )  ORDER(NAME=~"libro_giornale.id_mov_contabile~" ASC=yes ) ARG(NAME = ~"rn_num_prog~" TYPE = number) " arguments=(("rn_num_prog", number)) )
