 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"reg_pd~" )  TABLE(NAME=~"mov_contabile~" )  TABLE(NAME=~"conto~" )  TABLE(NAME=~"mod_registro~" )  TABLE(NAME=~"registro~" ) COLUMN(NAME=~"reg_pd.data_registrazione~") COLUMN(NAME=~"reg_pd.data_competenza~") COLUMN(NAME=~"reg_pd.num_documento~") COLUMN(NAME=~"reg_pd.data_documento~") COLUMN(NAME=~"reg_pd.descrizione~") COLUMN(NAME=~"mov_contabile.avere~") COLUMN(NAME=~"conto.codice~") COLUMN(NAME=~"conto.descrizione~") COLUMN(NAME=~"mov_contabile.dare~") COLUMN(NAME=~"reg_pd.id_reg_pd~") COLUMN(NAME=~"reg_pd.id_registro~") COLUMN(NAME=~"mod_registro.tipo_registro~")    JOIN (LEFT=~"mov_contabile.id_reg_pd~"    OP =~"=~"RIGHT=~"reg_pd.id_reg_pd~" )    JOIN (LEFT=~"conto.id_conto~"    OP =~"=~"RIGHT=~"mov_contabile.id_conto~" )    JOIN (LEFT=~"registro.id_mod_registro~"    OP =~"=~"RIGHT=~"mod_registro.id_mod_registro~" )    JOIN (LEFT=~"registro.id_registro~"    OP =~"=~"RIGHT=~"reg_pd.id_registro~" )WHERE(    EXP1 =~"~~~"mod_registro~~~".~~~"tipo_registro~~~"~"   OP =~"<>~"    EXP2 =~"'MN'~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"reg_pd~~~".~~~"data_registrazione~~~"~"   OP =~"<=~"    EXP2 =~":rn_data_registrazione~" ) ) ORDER(NAME=~"reg_pd.data_registrazione~" ASC=yes ) ARG(NAME = ~"rn_data_registrazione~" TYPE = date) " arguments=(("rn_data_registrazione", date)) )
