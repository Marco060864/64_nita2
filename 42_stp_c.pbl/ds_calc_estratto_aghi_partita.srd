 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"mov_contabile~" )  TABLE(NAME=~"reg_pd~" )  TABLE(NAME=~"conto~" )  TABLE(NAME=~"registro~" )  TABLE(NAME=~"prof_registrazione~" ) COLUMN(NAME=~"reg_pd.data_registrazione~") COLUMN(NAME=~"mov_contabile.dare~") COLUMN(NAME=~"mov_contabile.avere~") COLUMN(NAME=~"conto.codice~") COLUMN(NAME=~"conto.descrizione~") COLUMN(NAME=~"conto.id_conto~") COLUMN(NAME=~"registro.tipo_registro~") COLUMN(NAME=~"mov_contabile.des_contabile~") COLUMN(NAME=~"prof_registrazione.codice~") COLUMN(NAME=~"reg_pd.num_progressivo~") COLUMN(NAME=~"mov_contabile.numero~") COLUMN(NAME=~"reg_pd.id_reg_pd~") COMPUTE(NAME=~"cast((select id_valuta from esercizio where id_esercizio=~~~"registro~~~".~~~"id_esercizio~~~") as numeric ) as val_es~") COMPUTE(NAME=~"cast(fn_conv_valuta(val_es,~~~"mov_contabile~~~".~~~"avere~~~",:rn_cambio) as decimal(18,4) ) as cavere~") COMPUTE(NAME=~"cast(fn_conv_valuta(val_es,~~~"mov_contabile~~~".~~~"dare~~~",:rn_cambio) as decimal(18,4) ) as cdare~")    JOIN (LEFT=~"reg_pd.id_reg_pd~"    OP =~"=~"RIGHT=~"mov_contabile.id_reg_pd~" )    JOIN (LEFT=~"mov_contabile.id_conto~"    OP =~"=~"RIGHT=~"conto.id_conto~" )    JOIN (LEFT=~"registro.id_registro~"    OP =~"=~"RIGHT=~"reg_pd.id_registro~" )    JOIN (LEFT=~"reg_pd.id_prof_registrazione~"    OP =~"=~"RIGHT=~"prof_registrazione.id_prof_registrazione~" )WHERE(    EXP1 =~"( ( ~~~"reg_pd~~~".~~~"data_competenza~~~"~"   OP =~">=~"    EXP2 =~":da_data )~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"( ~~~"reg_pd~~~".~~~"data_competenza~~~"~"   OP =~"<=~"    EXP2 =~":a_data )~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"conto~~~".~~~"codice~~~"~"   OP =~"=~"    EXP2 =~":rs_conto ~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"( ~~~"registro~~~".~~~"tipo_registro~~~"~"   OP =~"<>~"    EXP2 =~"'MN' ) )~" ) ) ORDER(NAME=~"reg_pd.data_registrazione~" ASC=yes )  ORDER(NAME=~"reg_pd.num_progressivo~" ASC=yes )  ORDER(NAME=~"mov_contabile.numero~" ASC=yes ) ARG(NAME = ~"rs_conto~" TYPE = string)  ARG(NAME = ~"da_data~" TYPE = date)  ARG(NAME = ~"a_data~" TYPE = date)  ARG(NAME = ~"rn_prof_apertura~" TYPE = number)  ARG(NAME = ~"rn_prof_chiusura~" TYPE = number)  ARG(NAME = ~"rn_decimali~" TYPE = number)  ARG(NAME = ~"rn_cambio~" TYPE = number)  ARG(NAME = ~"rs_valuta~" TYPE = string)  ARG(NAME = ~"rn_saldo_iniziale~" TYPE = number)  ARG(NAME = ~"rn_saldo_finale~" TYPE = number)  ARG(NAME = ~"rs_vis_num~" TYPE = string)  ARG(NAME = ~"data_stampa~" TYPE = date) " arguments=(("rs_conto", string),("da_data", date),("a_data", date),("rn_prof_apertura", number),("rn_prof_chiusura", number),("rn_decimali", number),("rn_cambio", number),("rs_valuta", string),("rn_saldo_iniziale", number),("rn_saldo_finale", number),("rs_vis_num", string),("data_stampa", date))  sort="conto_id_conto A reg_pd_data_registrazione A num_progressivo A " )
