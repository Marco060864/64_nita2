 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"ws_registri_iva~" )  TABLE(NAME=~"esercizio~" )  TABLE(NAME=~"azienda~" )  TABLE(NAME=~"sede~" ) COLUMN(NAME=~"ws_registri_iva.data_registrazione~") COLUMN(NAME=~"ws_registri_iva.num_progressivo~") COLUMN(NAME=~"ws_registri_iva.tipo_registro~") COLUMN(NAME=~"ws_registri_iva.numero~") COLUMN(NAME=~"ws_registri_iva.data_documento~") COLUMN(NAME=~"ws_registri_iva.num_documento~") COLUMN(NAME=~"ws_registri_iva.descrizione~") COLUMN(NAME=~"ws_registri_iva.descrizione_a~") COLUMN(NAME=~"ws_registri_iva.importo~") COLUMN(NAME=~"ws_registri_iva.segno_reg_iva~") COLUMN(NAME=~"ws_registri_iva.imponibile~") COLUMN(NAME=~"ws_registri_iva.des_breve~") COLUMN(NAME=~"ws_registri_iva.per_aliquota~") COLUMN(NAME=~"ws_registri_iva.imposta~") COLUMN(NAME=~"ws_registri_iva.cambio~") COLUMN(NAME=~"ws_registri_iva.descrizione_b~") COLUMN(NAME=~"ws_registri_iva.simbolo~") COLUMN(NAME=~"ws_registri_iva.id_valuta~") COLUMN(NAME=~"ws_registri_iva.imp_valuta~") COLUMN(NAME=~"ws_registri_iva.ges_sco_giornaliero~") COLUMN(NAME=~"esercizio.id_esercizio~") COLUMN(NAME=~"ws_registri_iva.ges_oper_intracomunitarie~") COLUMN(NAME=~"ws_registri_iva.id_valuta_es~") COMPUTE(NAME=~"cast(:ra_dalla_data as date) as dat1~") COMPUTE(NAME=~"cast(:ra_alla_data as date) as dat2~") COMPUTE(NAME=~"cast(:ra_tipo_registro as char) as tipo~") COLUMN(NAME=~"azienda.rag_soc_1~") COLUMN(NAME=~"ws_registri_iva.id_reg_pd~") COLUMN(NAME=~"ws_registri_iva.registro_des~") COLUMN(NAME=~"esercizio.id_valuta~") COLUMN(NAME=~"sede.indirizzo~") COLUMN(NAME=~"sede.cap~") COLUMN(NAME=~"sede.localita~") COLUMN(NAME=~"sede.provincia~") COLUMN(NAME=~"azienda.par_iva~") COLUMN(NAME=~"azienda.cod_fiscale~") COLUMN(NAME=~"azienda.cciaa~") COLUMN(NAME=~"azienda.trib_iscrizione~") COMPUTE(NAME=~"0 as c_pag_preparate~") COMPUTE(NAME=~"0 as c_pag_usate~")    JOIN (LEFT=~"esercizio.id_azienda~"    OP =~"=~"RIGHT=~"azienda.id_azienda~" )    JOIN (LEFT=~"azienda.id_azienda~"    OP =~"=~"RIGHT=~"sede.id_azienda~" )WHERE(    EXP1 =~"~~~"ws_registri_iva~~~".~~~"tipo_registro~~~"~"   OP =~"=~"    EXP2 =~":ra_tipo_registro~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"ws_registri_iva~~~".~~~"data_registrazione~~~"~"   OP =~">=~"    EXP2 =~":ra_dalla_data~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"ws_registri_iva~~~".~~~"data_registrazione~~~"~"   OP =~"<=~"    EXP2 =~":ra_alla_data~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"esercizio~~~".~~~"id_esercizio~~~"~"   OP =~"=~"    EXP2 =~":ra_id_esercizio~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"ws_registri_iva~~~".~~~"numero~~~"~"   OP =~">=~"    EXP2 =~":reg_num_ini~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"ws_registri_iva~~~".~~~"numero~~~"~"   OP =~"<=~"    EXP2 =~":reg_num_fine~" ) ) ORDER(NAME=~"ws_registri_iva.data_registrazione~" ASC=yes )  ORDER(NAME=~"ws_registri_iva.numero~" ASC=yes ) ARG(NAME = ~"ra_tipo_registro~" TYPE = string)  ARG(NAME = ~"ra_dalla_data~" TYPE = date)  ARG(NAME = ~"ra_alla_data~" TYPE = date)  ARG(NAME = ~"ra_id_esercizio~" TYPE = number)  ARG(NAME = ~"rn_ult_prot_stampato~" TYPE = number)  ARG(NAME = ~"reg_num_ini~" TYPE = number)  ARG(NAME = ~"reg_num_fine~" TYPE = number) " arguments=(("ra_tipo_registro", string),("ra_dalla_data", date),("ra_alla_data", date),("ra_id_esercizio", number),("rn_ult_prot_stampato", number),("reg_num_ini", number),("reg_num_fine", number))  sort="data_registrazione A num_progressivo A numero A " )
