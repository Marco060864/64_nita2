 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"par_aperta~" )  TABLE(NAME=~"mov_partita~" )  TABLE(NAME=~"mov_scadenza~" ) COLUMN(NAME=~"par_aperta.id_par_aperta~") COLUMN(NAME=~"par_aperta.id_conto~") COLUMN(NAME=~"par_aperta.num_partita~") COLUMN(NAME=~"par_aperta.data_partita~") COLUMN(NAME=~"mov_partita.data~") COLUMN(NAME=~"mov_partita.importo~") COLUMN(NAME=~"mov_scadenza.data~") COLUMN(NAME=~"mov_scadenza.importo~") COLUMN(NAME=~"mov_partita.id_mov_partita~") COLUMN(NAME=~"par_aperta.importo~")    JOIN (LEFT=~"mov_scadenza.id_mov_partita~"    OP =~"=~"RIGHT=~"mov_partita.id_mov_partita~"    OUTER2 =~"mov_partita.id_mov_partita~" )    JOIN (LEFT=~"mov_partita.id_par_aperta~"    OP =~"=~"RIGHT=~"par_aperta.id_par_aperta~" )WHERE(    EXP1 =~"~~~"par_aperta~~~".~~~"id_par_aperta~~~"~"   OP =~"=~"    EXP2 =~":rn_id_pa~" ) ) ARG(NAME = ~"rn_id_pa~" TYPE = number) " arguments=(("rn_id_pa", number)) )
