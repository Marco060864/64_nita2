 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"ws_liquidazione_iva~" )  TABLE(NAME=~"attivita~" )  TABLE(NAME=~"azienda~" )  TABLE(NAME=~"par_sistema~" ) COLUMN(NAME=~"ws_liquidazione_iva.id_esercizio~") COLUMN(NAME=~"ws_liquidazione_iva.id_attivita~") COLUMN(NAME=~"ws_liquidazione_iva.tipo_registro~") COLUMN(NAME=~"ws_liquidazione_iva.data_comp_liq_iva~") COLUMN(NAME=~"ws_liquidazione_iva.id_reg_pd~") COLUMN(NAME=~"ws_liquidazione_iva.segno_reg_iva~") COLUMN(NAME=~"ws_liquidazione_iva.imponibile~") COLUMN(NAME=~"ws_liquidazione_iva.imposta~") COLUMN(NAME=~"ws_liquidazione_iva.id_tab_iva~") COLUMN(NAME=~"ws_liquidazione_iva.codice~") COLUMN(NAME=~"ws_liquidazione_iva.des_breve~") COLUMN(NAME=~"ws_liquidazione_iva.tipo_iva~") COLUMN(NAME=~"ws_liquidazione_iva.per_aliquota~") COLUMN(NAME=~"ws_liquidazione_iva.per_detrazione~") COLUMN(NAME=~"ws_liquidazione_iva.per_ventilazione~") COLUMN(NAME=~"ws_liquidazione_iva.ges_plafond~") COLUMN(NAME=~"attivita.descrizione~") COLUMN(NAME=~"azienda.rag_soc_1~") COLUMN(NAME=~"ws_liquidazione_iva.usa_prorata~") COLUMN(NAME=~"ws_liquidazione_iva.ges_sco_giornaliero~") COLUMN(NAME=~"attivita.liq_iva~") COLUMN(NAME=~"par_sistema.per_iva_trimestrale~") COMPUTE(NAME=~"cast(0 as dec) as acconto~") COLUMN(NAME=~"ws_liquidazione_iva.st_liquidazione~") COLUMN(NAME=~"attivita.attuale_plafond~") COMPUTE(NAME=~"cast(0 as dec) as per_prorata~")    JOIN (LEFT=~"ws_liquidazione_iva.id_attivita~"    OP =~"=~"RIGHT=~"attivita.id_attivita~" )    JOIN (LEFT=~"azienda.id_attivita~"    OP =~"=~"RIGHT=~"attivita.id_attivita~" )    JOIN (LEFT=~"azienda.id_azienda~"    OP =~"=~"RIGHT=~"par_sistema.id_azienda~" )WHERE(    EXP1 =~"( ~~~"ws_liquidazione_iva~~~".~~~"id_esercizio~~~"~"   OP =~"=~"    EXP2 =~":rn_id_esercizio )~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"( ~~~"ws_liquidazione_iva~~~".~~~"id_attivita~~~"~"   OP =~"=~"    EXP2 =~":rn_id_attivita )~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"( ( ~~~"ws_liquidazione_iva~~~".~~~"data_comp_liq_iva~~~"~"   OP =~">=~"    EXP2 =~":rn_data_in )~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"( ~~~"ws_liquidazione_iva~~~".~~~"data_comp_liq_iva~~~"~"   OP =~"<=~"    EXP2 =~":rn_data_fin ) )~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"azienda~~~".~~~"id_azienda~~~"~"   OP =~"=~"    EXP2 =~"1~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"ws_liquidazione_iva~~~".~~~"st_liquidazione~~~"~"   OP =~"=~"    EXP2 =~":rn_flag~" ) ) ORDER(NAME=~"ws_liquidazione_iva.codice~" ASC=yes )  ORDER(NAME=~"ws_liquidazione_iva.tipo_registro~" ASC=yes ) ARG(NAME = ~"rn_flag~" TYPE = string)  ARG(NAME = ~"rn_id_esercizio~" TYPE = number)  ARG(NAME = ~"rn_id_attivita~" TYPE = number)  ARG(NAME = ~"rn_data_in~" TYPE = date)  ARG(NAME = ~"rn_data_fin~" TYPE = date) " arguments=(("rn_flag", string),("rn_id_esercizio", number),("rn_id_attivita", number),("rn_data_in", date),("rn_data_fin", date)) )
