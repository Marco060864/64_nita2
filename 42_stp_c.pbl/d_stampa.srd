 retrieve="PBSELECT( VERSION(400) DISTINCT ()TABLE(NAME=~"conto~" )  TABLE(NAME=~"sog_commerciale~" )  TABLE(NAME=~"anagrafica~" )  TABLE(NAME=~"azienda~" ) COLUMN(NAME=~"conto.codice~") COLUMN(NAME=~"conto.descrizione~") COMPUTE(NAME=~"cast(null as date) dat1~") COMPUTE(NAME=~"cast(null as date) dat2~") COLUMN(NAME=~"anagrafica.rag_soc_1~") COLUMN(NAME=~"anagrafica.rag_soc_2~") COLUMN(NAME=~"anagrafica.indirizzo~") COLUMN(NAME=~"anagrafica.cap~") COLUMN(NAME=~"anagrafica.localita~") COLUMN(NAME=~"anagrafica.provincia~") COLUMN(NAME=~"anagrafica.nazione~") COLUMN(NAME=~"anagrafica.cod_fiscale~") COLUMN(NAME=~"anagrafica.par_iva~") COLUMN(NAME=~"sog_commerciale.data_acquisizione~") COLUMN(NAME=~"conto.id_conto~") COLUMN(NAME=~"azienda.rag_soc_1~")    JOIN (LEFT=~"anagrafica.id_anagrafica~"    OP =~"=~"RIGHT=~"sog_commerciale.id_anagrafica~"    OUTER2 =~"sog_commerciale.id_anagrafica~" )    JOIN (LEFT=~"conto.id_conto~"    OP =~"=~"RIGHT=~"sog_commerciale.id_conto~"    OUTER1 =~"conto.id_conto~" )    JOIN (LEFT=~"conto.id_azienda~"    OP =~"=~"RIGHT=~"azienda.id_azienda~" )WHERE(    EXP1 =~"~~~"conto~~~".~~~"codice~~~"~"   OP =~">=~"    EXP2 =~":rs_da_conto~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"conto~~~".~~~"codice~~~"~"   OP =~"<=~"    EXP2 =~":rs_a_conto~" ) ) ORDER(NAME=~"conto.codice~" ASC=yes ) ARG(NAME = ~"rs_da_conto~" TYPE = string)  ARG(NAME = ~"rs_a_conto~" TYPE = string)  ARG(NAME = ~"rd_data_saldo_iniziale~" TYPE = date)  ARG(NAME = ~"rd_data_saldo_attivo~" TYPE = date)  ARG(NAME = ~"rd_da_estratto~" TYPE = date)  ARG(NAME = ~"rd_a_estratto~" TYPE = date)  ARG(NAME = ~"rn_prof_apertura~" TYPE = number)  ARG(NAME = ~"rn_prof_chiusura~" TYPE = number)  ARG(NAME = ~"rs_valuta~" TYPE = string)  ARG(NAME = ~"rn_decimali~" TYPE = number)  ARG(NAME = ~"rd_cambio~" TYPE = number)  ARG(NAME = ~"data_stampa~" TYPE = date) " arguments=(("rs_da_conto", string),("rs_a_conto", string),("rd_data_saldo_iniziale", date),("rd_data_saldo_attivo", date),("rd_da_estratto", date),("rd_a_estratto", date),("rn_prof_apertura", number),("rn_prof_chiusura", number),("rs_valuta", string),("rn_decimali", number),("rd_cambio", number),("data_stampa", date))  sort="conto_codice A " )
