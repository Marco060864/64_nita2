 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"reg_pd~" )  TABLE(NAME=~"esercizio~" )  TABLE(NAME=~"registro~" )  TABLE(NAME=~"prof_registrazione~" )  TABLE(NAME=~"mov_contabile~" )  TABLE(NAME=~"azienda~" )  TABLE(NAME=~"ws_lib_gior_manageriale~" ) COLUMN(NAME=~"esercizio.codice~") COLUMN(NAME=~"esercizio.ult_data_stampa_bollato~") COLUMN(NAME=~"esercizio.riporto~") COLUMN(NAME=~"registro.tipo_registro~") COLUMN(NAME=~"prof_registrazione.codice~") COLUMN(NAME=~"mov_contabile.des_contabile~") COLUMN(NAME=~"reg_pd.num_progressivo~") COLUMN(NAME=~"prof_registrazione.descrizione~") COLUMN(NAME=~"esercizio.num_progressivo~") COLUMN(NAME=~"azienda.rag_soc_1~") COLUMN(NAME=~"ws_lib_gior_manageriale.id_reg_pd~") COLUMN(NAME=~"ws_lib_gior_manageriale.data_registrazione~") COLUMN(NAME=~"ws_lib_gior_manageriale.num_documento~") COLUMN(NAME=~"ws_lib_gior_manageriale.data_documento~") COLUMN(NAME=~"ws_lib_gior_manageriale.descrizione~") COLUMN(NAME=~"ws_lib_gior_manageriale.id_mov_contabile~") COLUMN(NAME=~"ws_lib_gior_manageriale.codice~") COLUMN(NAME=~"ws_lib_gior_manageriale.descrizione_a~") COLUMN(NAME=~"ws_lib_gior_manageriale.dare~") COLUMN(NAME=~"ws_lib_gior_manageriale.avere~") COLUMN(NAME=~"ws_lib_gior_manageriale.prog_stampato~") COMPUTE(NAME=~"cast(null as integer) as aa~") COLUMN(NAME=~"mov_contabile.numero~") COLUMN(NAME=~"esercizio.id_valuta~")    JOIN (LEFT=~"esercizio.id_esercizio~"    OP =~"=~"RIGHT=~"registro.id_esercizio~" )    JOIN (LEFT=~"reg_pd.id_registro~"    OP =~"=~"RIGHT=~"registro.id_registro~" )    JOIN (LEFT=~"prof_registrazione.id_prof_registrazione~"    OP =~"=~"RIGHT=~"reg_pd.id_prof_registrazione~" )    JOIN (LEFT=~"azienda.id_azienda~"    OP =~"=~"RIGHT=~"reg_pd.id_azienda~" )    JOIN (LEFT=~"ws_lib_gior_manageriale.id_reg_pd~"    OP =~"=~"RIGHT=~"reg_pd.id_reg_pd~" )    JOIN (LEFT=~"ws_lib_gior_manageriale.id_mov_contabile~"    OP =~"=~"RIGHT=~"mov_contabile.id_mov_contabile~" )WHERE(    EXP1 =~"( ( ~~~"ws_lib_gior_manageriale~~~".~~~"data_registrazione~~~"~"   OP =~">=~"    EXP2 =~":rdt_da_data )~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"( ~~~"ws_lib_gior_manageriale~~~".~~~"data_registrazione~~~"~"   OP =~"<=~"    EXP2 =~":rdt_a_data )~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"( ~~~"reg_pd~~~".~~~"num_progressivo~~~"~"   OP =~">=~"    EXP2 =~":d_num )~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"( ~~~"reg_pd~~~".~~~"num_progressivo~~~"~"   OP =~"<=~"    EXP2 =~":a_num ) )~" ) ) ARG(NAME = ~"rdt_da_data~" TYPE = date)  ARG(NAME = ~"rdt_a_data~" TYPE = date)  ARG(NAME = ~"d_num~" TYPE = number)  ARG(NAME = ~"a_num~" TYPE = number)  ARG(NAME = ~"elab_def~" TYPE = string) " arguments=(("rdt_da_data", date),("rdt_a_data", date),("d_num", number),("a_num", number),("elab_def", string))  sort="ws_lib_gior_manageriale_id_reg_pd A mov_contabile_numero A " )
