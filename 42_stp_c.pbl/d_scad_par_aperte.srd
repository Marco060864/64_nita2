summary(height=0 color="536870912" )
footer(height=0 color="536870912" )
detail(height=76 color="536870912" )
table(column=(type=long updatewhereclause=yes identity=yes name=id_par_aperta dbname="par_aperta.id_par_aperta" )
 column=(type=char(16) updatewhereclause=yes name=num_partita dbname="par_aperta.num_partita" )
 column=(type=date updatewhereclause=yes name=data_scadenza dbname="scadenza.data_scadenza" )
 column=(type=decimal(4) updatewhereclause=yes name=importo dbname="scadenza.importo" )
