 column=(type=decimal(0) updatewhereclause=yes name=reg_pd_num_progressivo dbname="reg_pd.num_progressivo" )
 column=(type=date updatewhereclause=yes name=reg_pd_data_registrazione dbname="reg_pd.data_registrazione" )
 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"par_aperta~" )  TABLE(NAME=~"scadenza~" )  TABLE(NAME=~"mov_scadenza~" )  TABLE(NAME=~"reg_pd~" )  TABLE(NAME=~"mov_partita~" ) COLUMN(NAME=~"par_aperta.id_par_aperta~") COLUMN(NAME=~"par_aperta.num_partita~") COLUMN(NAME=~"scadenza.data_scadenza~") COLUMN(NAME=~"scadenza.importo~") COLUMN(NAME=~"mov_scadenza.data~") COLUMN(NAME=~"mov_scadenza.importo~") COLUMN(NAME=~"scadenza.id_scadenza~") COLUMN(NAME=~"par_aperta.id_conto~") COLUMN(NAME=~"reg_pd.num_progressivo~") COLUMN(NAME=~"reg_pd.data_registrazione~")    JOIN (LEFT=~"mov_scadenza.id_scadenza~"    OP =~"=~"RIGHT=~"scadenza.id_scadenza~"    OUTER2 =~"scadenza.id_scadenza~" )    JOIN (LEFT=~"scadenza.id_par_aperta~"    OP =~"=~"RIGHT=~"par_aperta.id_par_aperta~" )    JOIN (LEFT=~"mov_partita.id_reg_pd~"    OP =~"=~"RIGHT=~"reg_pd.id_reg_pd~" )    JOIN (LEFT=~"mov_scadenza.id_mov_partita~"    OP =~"=~"RIGHT=~"mov_partita.id_mov_partita~" )WHERE(    EXP1 =~"~~~"scadenza~~~".~~~"id_par_aperta~~~"~"   OP =~"=~"    EXP2 =~":rn_id_pa~" ) ) ARG(NAME = ~"rn_id_pa~" TYPE = number) " arguments=(("rn_id_pa", number)) )
