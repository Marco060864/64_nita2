detail(height=104 color="536870912"  height.autosize=yes)
table(column=(type=long updatewhereclause=yes key=yes name=par_aperta_id_par_aperta dbname="par_aperta.id_par_aperta" )
 column=(type=long updatewhereclause=yes name=par_aperta_id_conto dbname="par_aperta.id_conto" )
 column=(type=char(16) updatewhereclause=yes name=par_aperta_num_partita dbname="par_aperta.num_partita" )
 column=(type=date updatewhereclause=yes name=par_aperta_data_partita dbname="par_aperta.data_partita" )
 column=(type=date updatewhereclause=yes name=mov_partita_data dbname="mov_partita.data" )
 column=(type=decimal(0) updatewhereclause=yes name=mov_partita_importo dbname="mov_partita.importo" )
 column=(type=long updatewhereclause=yes identity=yes name=mov_partita_id_mov_partita dbname="mov_partita.id_mov_partita" )
 column=(type=decimal(0) updatewhereclause=yes name=par_aperta_importo dbname="par_aperta.importo" )
 column=(type=long updatewhereclause=yes name=par_aperta_id_par_aperta_padre dbname="par_aperta.id_par_aperta_padre" )
 column=(type=decimal(0) updatewhereclause=yes name=par_aperta_segno_iva dbname="par_aperta.segno_iva" )
 column=(type=char(1) updatewhereclause=yes name=par_aperta_chiusa_forzatamente dbname="par_aperta.chiusa_forzatamente" )
 column=(type=char(8) updatewhereclause=yes name=conto_codice dbname="conto.codice" )
 column=(type=char(1) update=yes updatewhereclause=yes name=par_aperta_stato dbname="par_aperta.stato" )
 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"par_aperta~" )  TABLE(NAME=~"mov_partita~" )  TABLE(NAME=~"conto~" ) COLUMN(NAME=~"par_aperta.id_par_aperta~") COLUMN(NAME=~"par_aperta.id_conto~") COLUMN(NAME=~"par_aperta.num_partita~") COLUMN(NAME=~"par_aperta.data_partita~") COLUMN(NAME=~"mov_partita.data~") COLUMN(NAME=~"mov_partita.importo~") COLUMN(NAME=~"mov_partita.id_mov_partita~") COLUMN(NAME=~"par_aperta.importo~") COLUMN(NAME=~"par_aperta.id_par_aperta_padre~") COLUMN(NAME=~"par_aperta.segno_iva~") COLUMN(NAME=~"par_aperta.chiusa_forzatamente~") COLUMN(NAME=~"conto.codice~") COLUMN(NAME=~"par_aperta.stato~")    JOIN (LEFT=~"mov_partita.id_par_aperta~"    OP =~"=~"RIGHT=~"par_aperta.id_par_aperta~" )    JOIN (LEFT=~"conto.id_conto~"    OP =~"=~"RIGHT=~"par_aperta.id_conto~" )WHERE(    EXP1 =~"(~~~"par_aperta~~~".~~~"data_partita~~~"~"   OP =~">=~"    EXP2 =~":rn_dat1~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"par_aperta~~~".~~~"data_partita~~~"~"   OP =~"<=~"    EXP2 =~":rn_dat2)~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"conto~~~".~~~"codice~~~"~"   OP =~">=~"    EXP2 =~":rn_cc1~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"conto~~~".~~~"codice~~~"~"   OP =~"<=~"    EXP2 =~":rn_cc2~" ) ) ARG(NAME = ~"rn_dat1~" TYPE = date)  ARG(NAME = ~"rn_dat2~" TYPE = date)  ARG(NAME = ~"rn_cc1~" TYPE = string)  ARG(NAME = ~"rn_cc2~" TYPE = string) " update="par_aperta" updatewhere=1 updatekeyinplace=yes arguments=(("rn_dat1", date),("rn_dat2", date),("rn_cc1", string),("rn_cc2", string)) )
