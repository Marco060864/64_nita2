 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"par_aperta~" )  TABLE(NAME=~"mov_partita~" )  TABLE(NAME=~"reg_pd~" ) COLUMN(NAME=~"par_aperta.id_par_aperta~") COLUMN(NAME=~"par_aperta.id_conto~") COLUMN(NAME=~"par_aperta.num_partita~") COLUMN(NAME=~"par_aperta.data_partita~") COLUMN(NAME=~"mov_partita.data~") COLUMN(NAME=~"mov_partita.importo~") COLUMN(NAME=~"mov_partita.id_mov_partita~") COLUMN(NAME=~"par_aperta.importo~") COLUMN(NAME=~"par_aperta.id_par_aperta_padre~") COLUMN(NAME=~"par_aperta.segno_iva~") COLUMN(NAME=~"reg_pd.num_progressivo~") COLUMN(NAME=~"reg_pd.data_registrazione~") COLUMN(NAME=~"reg_pd.descrizione~")    JOIN (LEFT=~"mov_partita.id_par_aperta~"    OP =~"=~"RIGHT=~"par_aperta.id_par_aperta~" )    JOIN (LEFT=~"mov_partita.id_reg_pd~"    OP =~"=~"RIGHT=~"reg_pd.id_reg_pd~" )WHERE(    EXP1 =~"~~~"par_aperta~~~".~~~"id_par_aperta~~~"~"   OP =~"=~"    EXP2 =~":rn_id_pa~" ) ) ARG(NAME = ~"rn_id_pa~" TYPE = number) " arguments=(("rn_id_pa", number)) )
