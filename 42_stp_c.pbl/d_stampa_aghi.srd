 retrieve="PBSELECT( VERSION(400) DISTINCT ()TABLE(NAME=~"conto~" )  TABLE(NAME=~"sog_commerciale~" )  TABLE(NAME=~"anagrafica~" )  TABLE(NAME=~"azienda~" ) COLUMN(NAME=~"conto.codice~") COLUMN(NAME=~"conto.descrizione~") COMPUTE(NAME=~"cast(null as date) dat1~") COMPUTE(NAME=~"cast(null as date) dat2~") COLUMN(NAME=~"anagrafica.rag_soc_1~") COLUMN(NAME=~"anagrafica.rag_soc_2~") COLUMN(NAME=~"anagrafica.indirizzo~") COLUMN(NAME=~"anagrafica.cap~") COLUMN(NAME=~"anagrafica.localita~") COLUMN(NAME=~"anagrafica.provincia~") COLUMN(NAME=~"anagrafica.nazione~") COLUMN(NAME=~"anagrafica.cod_fiscale~") COLUMN(NAME=~"anagrafica.par_iva~") COLUMN(NAME=~"sog_commerciale.data_acquisizione~") COLUMN(NAME=~"conto.id_conto~") COLUMN(NAME=~"azienda.rag_soc_1~")    JOIN (LEFT=~"anagrafica.id_anagrafica~"    OP =~"=~"RIGHT=~"sog_commerciale.id_anagrafica~"    OUTER2 =~"sog_commerciale.id_anagrafica~" )    JOIN (LEFT=~"conto.id_conto~"    OP =~"=~"RIGHT=~"sog_commerciale.id_conto~"    OUTER1 =~"conto.id_conto~" )    JOIN (LEFT=~"conto.id_azienda~"    OP =~"=~"RIGHT=~"azienda.id_azienda~" )WHERE(    EXP1 =~"~~~"conto~~~".~~~"codice~~~"~"   OP =~"=~"    EXP2 =~":rs_da_conto~" ) ) ORDER(NAME=~"conto.codice~" ASC=yes ) ARG(NAME = ~"rs_da_conto~" TYPE = string)  ARG(NAME = ~"rd_da_estratto~" TYPE = date)  ARG(NAME = ~"rd_a_estratto~" TYPE = date)  ARG(NAME = ~"rs_valuta~" TYPE = string)  ARG(NAME = ~"data_stampa~" TYPE = date) " arguments=(("rs_da_conto", string),("rd_da_estratto", date),("rd_a_estratto", date),("rs_valuta", string),("data_stampa", date))  sort="conto_codice A " )
