 column=(type=decimal(2) updatewhereclause=yes name=per_aliquota dbname="ws_liquidazione_iva.per_aliquota" )
 column=(type=decimal(2) updatewhereclause=yes name=per_detrazione dbname="ws_liquidazione_iva.per_detrazione" )
