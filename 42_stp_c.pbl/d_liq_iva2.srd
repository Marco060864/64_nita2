 column=(type=char(40) updatewhereclause=yes name=azienda_rag_soc_1 dbname="azienda.rag_soc_1" )
 column=(type=char(1) updatewhereclause=yes name=iva_usa_prorata dbname="ws_liquidazione_iva.usa_prorata" )
