 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"ws_registri_iva~" ) COLUMN(NAME=~"ws_registri_iva.codice_iva~") COLUMN(NAME=~"ws_registri_iva.per_aliquota~") COLUMN(NAME=~"ws_registri_iva.per_detrazione~") COLUMN(NAME=~"ws_registri_iva.id_tab_iva~") COLUMN(NAME=~"ws_registri_iva.imponibile~") COLUMN(NAME=~"ws_registri_iva.numero~") COLUMN(NAME=~"ws_registri_iva.tipo_registro~") COLUMN(NAME=~"ws_registri_iva.data_registrazione~") COLUMN(NAME=~"ws_registri_iva.des_breve~") COLUMN(NAME=~"ws_registri_iva.segno_reg_iva~") COLUMN(NAME=~"ws_registri_iva.ges_sco_giornaliero~") COLUMN(NAME=~"ws_registri_iva.importo~") COLUMN(NAME=~"ws_registri_iva.ges_beni_rivendita~") COLUMN(NAME=~"ws_registri_iva.ges_beni_strumentali~") COLUMN(NAME=~"ws_registri_iva.imposta~") COLUMN(NAME=~"ws_registri_iva.id_valuta~") COMPUTE(NAME=~"cast((select id_valuta from esercizio where id_esercizio=:ra_esercizio) as numeric) as valuta~")WHERE(    EXP1 =~"~~~"ws_registri_iva~~~".~~~"tipo_registro~~~"~"   OP =~"=~"    EXP2 =~":ra_tipo_registro~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"ws_registri_iva~~~".~~~"data_registrazione~~~"~"   OP =~">=~"    EXP2 =~":ra_dalla_data~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"ws_registri_iva~~~".~~~"data_registrazione~~~"~"   OP =~"<=~"    EXP2 =~":ra_alla_data~" ) ) ORDER(NAME=~"ws_registri_iva.codice_iva~" ASC=yes ) ARG(NAME = ~"ra_tipo_registro~" TYPE = string)  ARG(NAME = ~"ra_dalla_data~" TYPE = date)  ARG(NAME = ~"ra_alla_data~" TYPE = date)  ARG(NAME = ~"ra_esercizio~" TYPE = number) " arguments=(("ra_tipo_registro", string),("ra_dalla_data", date),("ra_alla_data", date),("ra_esercizio", number))  sort="ges_beni_rivendita D ges_beni_strumentali D codice_iva A " )
