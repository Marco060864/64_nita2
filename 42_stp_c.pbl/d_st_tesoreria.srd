 column=(type=long updatewhereclause=yes identity=yes name=conto_id_conto dbname="conto.id_conto" )
 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"banca_azienda~" )  TABLE(NAME=~"con_banca_azienda~" )  TABLE(NAME=~"conto~" ) COLUMN(NAME=~"conto.codice~") COLUMN(NAME=~"conto.descrizione~") COLUMN(NAME=~"con_banca_azienda.fido~") COLUMN(NAME=~"con_banca_azienda.tasso_credito~") COLUMN(NAME=~"con_banca_azienda.tasso_debito~") COLUMN(NAME=~"con_banca_azienda.spese_commissione~") COMPUTE(NAME=~"cast (0 as decimal(18,4)) as saldo~") COLUMN(NAME=~"conto.id_conto~")    JOIN (LEFT=~"con_banca_azienda.id_banca_azienda~"    OP =~"=~"RIGHT=~"banca_azienda.id_banca_azienda~"    OUTER2 =~"banca_azienda.id_banca_azienda~" )    JOIN (LEFT=~"conto.id_conto~"    OP =~"=~"RIGHT=~"banca_azienda.id_conto~" )WHERE(    EXP1 =~"~~~"conto~~~".~~~"codice~~~"~"   OP =~">=~"    EXP2 =~":da_conto~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"conto~~~".~~~"codice~~~"~"   OP =~"<=~"    EXP2 =~":a_conto~" ) ) ARG(NAME = ~"da_conto~" TYPE = string)  ARG(NAME = ~"a_conto~" TYPE = string)  ARG(NAME = ~"data~" TYPE = date) " arguments=(("da_conto", string),("a_conto", string),("data", date)) )
