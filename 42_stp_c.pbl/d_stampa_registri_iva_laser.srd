 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"ws_registri_iva~" )  TABLE(NAME=~"par_sistema~" )  TABLE(NAME=~"esercizio~" ) COLUMN(NAME=~"ws_registri_iva.data_registrazione~") COLUMN(NAME=~"ws_registri_iva.num_progressivo~") COLUMN(NAME=~"ws_registri_iva.tipo_registro~") COLUMN(NAME=~"ws_registri_iva.numero~") COLUMN(NAME=~"ws_registri_iva.data_documento~") COLUMN(NAME=~"ws_registri_iva.num_documento~") COLUMN(NAME=~"ws_registri_iva.descrizione~") COLUMN(NAME=~"ws_registri_iva.descrizione_a~") COLUMN(NAME=~"ws_registri_iva.importo~") COLUMN(NAME=~"ws_registri_iva.segno_reg_iva~") COLUMN(NAME=~"ws_registri_iva.imponibile~") COLUMN(NAME=~"ws_registri_iva.des_breve~") COLUMN(NAME=~"ws_registri_iva.per_aliquota~") COLUMN(NAME=~"ws_registri_iva.imposta~") COLUMN(NAME=~"ws_registri_iva.cambio~") COLUMN(NAME=~"ws_registri_iva.descrizione_b~") COLUMN(NAME=~"ws_registri_iva.simbolo~") COLUMN(NAME=~"ws_registri_iva.id_valuta~") COLUMN(NAME=~"par_sistema.id_valuta~") COLUMN(NAME=~"ws_registri_iva.imp_valuta~") COLUMN(NAME=~"ws_registri_iva.ges_sco_giornaliero~") COLUMN(NAME=~"esercizio.id_valuta~") COLUMN(NAME=~"ws_registri_iva.data_comp_liq_iva~") COLUMN(NAME=~"ws_registri_iva.ges_oper_intracomunitarie~") COMPUTE(NAME=~"cast(null as char) az~") COMPUTE(NAME=~"cast(null as date) dat1~") COMPUTE(NAME=~"cast(null as date) dat2~") COMPUTE(NAME=~"cast(null as char) as tipo~")WHERE(    EXP1 =~"~~~"ws_registri_iva~~~".~~~"tipo_registro~~~"~"   OP =~"=~"    EXP2 =~":ra_tipo_registro~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"ws_registri_iva~~~".~~~"data_registrazione~~~"~"   OP =~">=~"    EXP2 =~":ra_dalla_data~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"ws_registri_iva~~~".~~~"data_registrazione~~~"~"   OP =~"<=~"    EXP2 =~":ra_alla_data~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"esercizio~~~".~~~"id_esercizio~~~"~"   OP =~"=~"    EXP2 =~":ra_id_esercizio~" ) ) ORDER(NAME=~"ws_registri_iva.data_registrazione~" ASC=yes )  ORDER(NAME=~"ws_registri_iva.numero~" ASC=yes ) ARG(NAME = ~"ra_tipo_registro~" TYPE = string)  ARG(NAME = ~"ra_dalla_data~" TYPE = date)  ARG(NAME = ~"ra_alla_data~" TYPE = date)  ARG(NAME = ~"ra_id_esercizio~" TYPE = number) " arguments=(("ra_tipo_registro", string),("ra_dalla_data", date),("ra_alla_data", date),("ra_id_esercizio", number))  sort="data_registrazione A num_progressivo A " )
