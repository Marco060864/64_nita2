 column=(type=char(5) updatewhereclause=yes name=anagrafica_nazione dbname="anagrafica.nazione" )
 column=(type=char(16) updatewhereclause=yes name=anagrafica_cod_fiscale dbname="anagrafica.cod_fiscale" )
 column=(type=char(16) updatewhereclause=yes name=anagrafica_par_iva dbname="anagrafica.par_iva" )
 column=(type=date updatewhereclause=yes name=dat1 dbname="dat1" )
 column=(type=date updatewhereclause=yes name=dat2 dbname="dat2" )
 column=(type=decimal(0) updatewhereclause=yes name=saldo_partite dbname="saldo_partite" )
 column=(type=char(40) updatewhereclause=yes name=azienda_rag_soc_1 dbname="azienda.rag_soc_1" )
 retrieve="  SELECT ~"anagrafica~".~"rag_soc_1~",   
         ~"conto~".~"id_conto~",   
         ~"conto~".~"codice~",   
         ~"conto~".~"descrizione~",   
         ~"par_aperta~".~"num_partita~",   
         ~"par_aperta~".~"data_partita~",   
         ~"par_aperta~".~"importo~",   
         ~"par_aperta~".~"imp_valuta~",   
         ~"par_aperta~".~"segno_iva~",   
         ~"par_aperta~".~"chiusa_forzatamente~",   
         ~"par_aperta~".~"tipo_fattura~",   
         ~"par_aperta~".~"id_par_aperta~",   
         ~"reg_pd~".~"num_progressivo~",   
         ~"reg_pd~".~"data_registrazione~",   
         ~"reg_pd~".~"num_documento~",   
         ~"reg_pd~".~"data_documento~",   
         ~"reg_pd~".~"descrizione~",   
         ~"anagrafica~".~"rag_soc_2~",   
         ~"anagrafica~".~"indirizzo~",   
         ~"anagrafica~".~"cap~",   
         ~"anagrafica~".~"localita~",   
         ~"anagrafica~".~"provincia~",   
         ~"anagrafica~".~"nazione~",   
         ~"anagrafica~".~"cod_fiscale~",   
         ~"anagrafica~".~"par_iva~",   
         cast(null as date) dat1,   
         cast(null as date) dat2,   
         cast(0 as decimal) saldo_partite,   
         ~"azienda~".~"rag_soc_1~"  
    FROM ~"par_aperta~",   
         ~"conto~",   
         ~"sog_commerciale~",   
         ~"anagrafica~",   
         ~"reg_pd~",   
         ~"azienda~"  
   WHERE ( ~"conto~".~"id_conto~" = ~"par_aperta~".~"id_conto~" ) and  
         ( ~"sog_commerciale~".~"id_conto~" = ~"conto~".~"id_conto~" ) and  
         ( ~"anagrafica~".~"id_anagrafica~" = ~"sog_commerciale~".~"id_anagrafica~" ) and  
         ( ~"par_aperta~".~"id_reg_pd~" = ~"reg_pd~".~"id_reg_pd~" ) and  
         ( ~"reg_pd~".~"id_azienda~" = ~"azienda~".~"id_azienda~" ) and  
         ( ( ~"par_aperta~".~"id_par_aperta_padre~" is null ) AND  
         (~"conto~".~"codice~" >= :rn_conto1 AND  
         ~"conto~".~"codice~" <= :rn_conto2) AND  
         (~"par_aperta~".~"data_partita~" >= :rn_dat1 AND  
         ~"par_aperta~".~"data_partita~" <= :rn_dat2) AND  
         ~"par_aperta~".~"stato~" = :rn_stato )    
" arguments=(("rn_conto1", string),("rn_conto2", string),("rn_dat1", date),("rn_dat2", date),("rn_stato", string))  sort="conto_codice A par_aperta_num_partita A " )
