table(column=(type=date updatewhereclause=yes name=reg_pd_data_registrazione dbname="reg_pd.data_registrazione" )
 column=(type=decimal(4) updatewhereclause=yes name=mov_contabile_dare dbname="mov_contabile.dare" )
 column=(type=decimal(4) updatewhereclause=yes name=mov_contabile_avere dbname="mov_contabile.avere" )
 column=(type=char(8) updatewhereclause=yes name=conto_codice dbname="conto.codice" )
 column=(type=char(40) updatewhereclause=yes name=conto_descrizione dbname="conto.descrizione" )
 column=(type=long updatewhereclause=yes identity=yes name=conto_id_conto dbname="conto.id_conto" )
 column=(type=char(2) updatewhereclause=yes name=registro_tipo_registro dbname="registro.tipo_registro" )
 column=(type=long updatewhereclause=yes name=id_prof_reg dbname="reg_pd.id_prof_registrazione" )
 column=(type=decimal(0) updatewhereclause=yes name=val_es dbname="val_es" )
 column=(type=decimal(4) updatewhereclause=yes name=cavere dbname="cavere" )
 column=(type=decimal(4) updatewhereclause=yes name=cdare dbname="cdare" )
 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"mov_contabile~" )  TABLE(NAME=~"reg_pd~" )  TABLE(NAME=~"conto~" )  TABLE(NAME=~"registro~" ) COLUMN(NAME=~"reg_pd.data_registrazione~") COLUMN(NAME=~"mov_contabile.dare~") COLUMN(NAME=~"mov_contabile.avere~") COLUMN(NAME=~"conto.codice~") COLUMN(NAME=~"conto.descrizione~") COLUMN(NAME=~"conto.id_conto~") COLUMN(NAME=~"registro.tipo_registro~") COLUMN(NAME=~"reg_pd.id_prof_registrazione~") COMPUTE(NAME=~"cast((select id_valuta from esercizio where id_esercizio=~~~"registro~~~".~~~"id_esercizio~~~") as numeric ) as val_es~") COMPUTE(NAME=~"cast(fn_conv_valuta(val_es,~~~"mov_contabile~~~".~~~"avere~~~",:rd_val_es) as decimal(18,4) ) as cavere~") COMPUTE(NAME=~"cast(fn_conv_valuta(val_es,~~~"mov_contabile~~~".~~~"dare~~~",:rd_val_es) as decimal(18,4) ) as cdare~")    JOIN (LEFT=~"reg_pd.id_reg_pd~"    OP =~"=~"RIGHT=~"mov_contabile.id_reg_pd~" )    JOIN (LEFT=~"mov_contabile.id_conto~"    OP =~"=~"RIGHT=~"conto.id_conto~" )    JOIN (LEFT=~"registro.id_registro~"    OP =~"=~"RIGHT=~"reg_pd.id_registro~" )WHERE(    EXP1 =~"~~~"reg_pd~~~".~~~"data_competenza~~~"~"   OP =~">=~"    EXP2 =~":da_data~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"conto~~~".~~~"id_conto~~~"~"   OP =~"=~"    EXP2 =~":rn_conto~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"registro~~~".~~~"tipo_registro~~~"~"   OP =~"<>~"    EXP2 =~"'MN'~" ) ) ORDER(NAME=~"reg_pd.data_registrazione~" ASC=yes ) ARG(NAME = ~"rn_conto~" TYPE = number)  ARG(NAME = ~"da_data~" TYPE = date)  ARG(NAME = ~"rn_cambio~" TYPE = number)  ARG(NAME = ~"rn_decimali~" TYPE = number)  ARG(NAME = ~"rd_val_es~" TYPE = number) " arguments=(("rn_conto", number),("da_data", date),("rn_cambio", number),("rn_decimali", number),("rd_val_es", number))  sort="conto_id_conto A reg_pd_data_registrazione A " )
