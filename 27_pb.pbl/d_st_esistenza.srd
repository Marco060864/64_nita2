 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"riepilogo~" )  TABLE(NAME=~"articolo~" )  TABLE(NAME=~"unita_confezione~" )  TABLE(NAME=~"sog_commerciale_gen~" )  TABLE(NAME=~"locazione~" )  TABLE(NAME=~"magazzino~" )  TABLE(NAME=~"cat_com_articolo~" ) COLUMN(NAME=~"riepilogo.id_esercizio~") COLUMN(NAME=~"riepilogo.id_attivita~") COLUMN(NAME=~"riepilogo.id_articolo~") COLUMN(NAME=~"riepilogo.id_locazione~") COLUMN(NAME=~"articolo.codice~") COLUMN(NAME=~"articolo.descrizione~") COLUMN(NAME=~"unita_confezione.id_unita_confezione~") COLUMN(NAME=~"riepilogo.qta_ord_clienti~") COLUMN(NAME=~"riepilogo.qta_ord_fornitori~") COLUMN(NAME=~"articolo.id_sog_commerciale~") COLUMN(NAME=~"sog_commerciale_gen.rag_soc_1~") COLUMN(NAME=~"riepilogo.mese~") COLUMN(NAME=~"articolo.id_articolo~") COLUMN(NAME=~"cat_com_articolo.codice~") COMPUTE(NAME=~"Cast(0 as decimal) As c_esistenza~") COMPUTE(NAME=~"Cast(0 as decimal) As c_esistenza_fisica~") COMPUTE(NAME=~"Cast(0 as decimal) As c_disponibilita~") COMPUTE(NAME=~"cast(0 as decimal) as c_ordinato~") COLUMN(NAME=~"articolo.id_tab_iva~")    JOIN (LEFT=~"articolo.id_sog_commerciale~"    OP =~"=~"RIGHT=~"sog_commerciale_gen.id_sog_commerciale~"    OUTER1 =~"articolo.id_sog_commerciale~" )    JOIN (LEFT=~"cat_com_articolo.id_cat_com_articolo~"    OP =~"=~"RIGHT=~"articolo.id_cat_com_articolo~" )    JOIN (LEFT=~"articolo.id_articolo~"    OP =~"=~"RIGHT=~"riepilogo.id_articolo~" )    JOIN (LEFT=~"unita_confezione.id_articolo~"    OP =~"=~"RIGHT=~"articolo.id_articolo~" )    JOIN (LEFT=~"locazione.id_locazione~"    OP =~"=~"RIGHT=~"riepilogo.id_locazione~" )    JOIN (LEFT=~"magazzino.id_magazzino~"    OP =~"=~"RIGHT=~"locazione.id_magazzino~" )WHERE(    EXP1 =~"~~~"magazzino~~~".~~~"id_magazzino~~~"~"   OP =~"=~"    EXP2 =~":rn_magazzino~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"articolo~~~".~~~"codice~~~"~"   OP =~"<=~"    EXP2 =~":a_articolo~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"articolo~~~".~~~"codice~~~"~"   OP =~">=~"    EXP2 =~":da_articolo~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"riepilogo~~~".~~~"anno~~~"~"   OP =~"<=~"    EXP2 =~":anno~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"riepilogo~~~".~~~"id_attivita~~~"~"   OP =~"=~"    EXP2 =~":attivita~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"unita_confezione~~~".~~~"unita_base~~~"~"   OP =~"=~"    EXP2 =~"'S'~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"cat_com_articolo~~~".~~~"codice~~~"~"   OP =~">=~"    EXP2 =~":da_cat_com~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"cat_com_articolo~~~".~~~"codice~~~"~"   OP =~"<=~"    EXP2 =~":a_cat_com~" ) ) ORDER(NAME=~"articolo.codice~" ASC=yes ) ARG(NAME = ~"a_articolo~" TYPE = string)  ARG(NAME = ~"da_articolo~" TYPE = string)  ARG(NAME = ~"anno~" TYPE = number)  ARG(NAME = ~"attivita~" TYPE = number)  ARG(NAME = ~"rn_magazzino~" TYPE = number)  ARG(NAME = ~"da_cat_com~" TYPE = string)  ARG(NAME = ~"a_cat_com~" TYPE = string) " arguments=(("a_articolo", string),("da_articolo", string),("anno", number),("attivita", number),("rn_magazzino", number),("da_cat_com", string),("a_cat_com", string)) )
