 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"articolo~" )  TABLE(NAME=~"locazione~" )  TABLE(NAME=~"riepilogo~" ) COLUMN(NAME=~"riepilogo.qta_caricata~") COLUMN(NAME=~"riepilogo.qta_scaricata~") COLUMN(NAME=~"riepilogo.qta_ord_clienti~") COLUMN(NAME=~"riepilogo.qta_ord_fornitori~") COLUMN(NAME=~"riepilogo.qta_vis_clienti~") COLUMN(NAME=~"riepilogo.qta_vis_fornitori~") COLUMN(NAME=~"riepilogo.mese~") COLUMN(NAME=~"riepilogo.val_caricato~") COLUMN(NAME=~"riepilogo.val_scaricato~") COLUMN(NAME=~"articolo.codice~") COLUMN(NAME=~"locazione.id_magazzino~") COLUMN(NAME=~"riepilogo.peso_caricato~") COLUMN(NAME=~"riepilogo.peso_scaricato~") COLUMN(NAME=~"riepilogo.peso_ord_clienti~") COLUMN(NAME=~"riepilogo.peso_ord_fornitori~") COLUMN(NAME=~"riepilogo.peso_vis_clienti~") COLUMN(NAME=~"riepilogo.peso_vis_fornitori~")    JOIN (LEFT=~"riepilogo.id_locazione~"    OP =~"=~"RIGHT=~"locazione.id_locazione~" )    JOIN (LEFT=~"riepilogo.id_articolo~"    OP =~"=~"RIGHT=~"articolo.id_articolo~" )WHERE(    EXP1 =~"~~~"articolo~~~".~~~"id_articolo~~~"~"   OP =~"=~"    EXP2 =~":rd_articolo~" ) ) ORDER(NAME=~"riepilogo.mese~" ASC=yes ) ARG(NAME = ~"rd_articolo~" TYPE = number)  ARG(NAME = ~"rd_magazzino~" TYPE = number)  ARG(NAME = ~"rd_tipo~" TYPE = string) " arguments=(("rd_articolo", number),("rd_magazzino", number),("rd_tipo", string))  sort="mese A " )
