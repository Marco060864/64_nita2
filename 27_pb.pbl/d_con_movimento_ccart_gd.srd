 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"con_movimento~" )  TABLE(NAME=~"conto~" )  TABLE(NAME=~"cat_com_articolo~" ) COLUMN(NAME=~"con_movimento.id_con_movimento~") COLUMN(NAME=~"con_movimento.applicazione~") COLUMN(NAME=~"con_movimento.id_gruppo_agenti~") COLUMN(NAME=~"con_movimento.id_sog_commerciale~") COLUMN(NAME=~"con_movimento.id_cat_com_sc~") COLUMN(NAME=~"con_movimento.id_articolo~") COLUMN(NAME=~"con_movimento.id_cat_com_articolo~") COLUMN(NAME=~"con_movimento.id_conto~") COLUMN(NAME=~"con_movimento.priorita~") COLUMN(NAME=~"con_movimento.id_azienda~") COLUMN(NAME=~"conto.codice~") COLUMN(NAME=~"conto.descrizione~") COLUMN(NAME=~"cat_com_articolo.codice~") COLUMN(NAME=~"cat_com_articolo.descrizione~") COLUMN(NAME=~"con_movimento.id_caus_magazzino~")    JOIN (LEFT=~"cat_com_articolo.id_cat_com_articolo~"    OP =~"=~"RIGHT=~"con_movimento.id_cat_com_articolo~"    OUTER2 =~"con_movimento.id_cat_com_articolo~" )    JOIN (LEFT=~"conto.id_conto~"    OP =~"=~"RIGHT=~"con_movimento.id_conto~" )WHERE(    EXP1 =~"~~~"con_movimento~~~".~~~"id_azienda~~~"~"   OP =~"in~"    EXP2 =~"(0,1)~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"con_movimento~~~".~~~"id_gruppo_agenti~~~"~"   OP =~"is~"    EXP2 =~"null~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"con_movimento~~~".~~~"id_sog_commerciale~~~"~"   OP =~"is~"    EXP2 =~"null~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"con_movimento~~~".~~~"id_cat_com_sc~~~"~"   OP =~"is~"    EXP2 =~"null~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"con_movimento~~~".~~~"id_articolo~~~"~"   OP =~"is~"    EXP2 =~"null~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"con_movimento~~~".~~~"id_caus_magazzino~~~"~"   OP =~"is~"    EXP2 =~"null~" ) ) " update="con_movimento" updatewhere=1 updatekeyinplace=yes )
