table(column=(type=char(32) updatewhereclause=yes name=codice dbname="articolo.codice" )
 column=(type=char(80) updatewhereclause=yes name=descrizione dbname="articolo.descrizione" )
 column=(type=decimal(4) updatewhereclause=yes name=quantita dbname="quantita" )
 column=(type=decimal(4) updatewhereclause=yes name=peso dbname="peso" )
 column=(type=long updatewhereclause=yes identity=yes name=id_articolo dbname="articolo.id_articolo" )
 column=(type=char(255) updatewhereclause=yes name=immagine dbname="articolo.immagine" )
 column=(type=long updatewhereclause=yes name=id_sog_commerciale dbname="articolo.id_sog_commerciale" )
 column=(type=char(1) updatewhereclause=yes name=tipo dbname="unita_misura.tipo" )
 column=(type=long updatewhereclause=yes identity=yes name=id_prof_doc dbname="prof_documento.id_prof_documento" )
 column=(type=char(8) updatewhereclause=yes name=prof_cod dbname="prof_documento.codice" )
 column=(type=char(40) updatewhereclause=yes name=prof_des dbname="prof_documento.descrizione" )
 column=(type=long updatewhereclause=yes identity=yes name=id_prof_doc_b dbname="prof_documento.id_prof_documento" )
 column=(type=char(8) updatewhereclause=yes name=prof_cod_b dbname="prof_documento.codice" )
 column=(type=char(40) updatewhereclause=yes name=prof_des_b dbname="prof_documento.descrizione" )
 column=(type=date updatewhereclause=yes name=data_reg dbname="data_reg" )
 column=(type=long updatewhereclause=yes name=id_tab_iva dbname="articolo.id_tab_iva" )
 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"articolo~" )  TABLE(NAME=~"unita_confezione~" )  TABLE(NAME=~"unita_misura~" )  TABLE(NAME=~"prof_documento~" ALIAS=~"prof_documento_a~" )  TABLE(NAME=~"prof_documento~" ALIAS=~"prof_documento_b~" ) COLUMN(NAME=~"articolo.codice~") COLUMN(NAME=~"articolo.descrizione~") COMPUTE(NAME=~"cast(null as numeric(18,4)) as quantita~") COMPUTE(NAME=~"cast(null as numeric(18,4)) as peso~") COLUMN(NAME=~"articolo.id_articolo~") COLUMN(NAME=~"articolo.immagine~") COLUMN(NAME=~"articolo.id_sog_commerciale~") COLUMN(NAME=~"unita_misura.tipo~") COLUMN(NAME=~"prof_documento_a.id_prof_documento~") COLUMN(NAME=~"prof_documento_a.codice~") COLUMN(NAME=~"prof_documento_a.descrizione~") COLUMN(NAME=~"prof_documento_b.id_prof_documento~") COLUMN(NAME=~"prof_documento_b.codice~") COLUMN(NAME=~"prof_documento_b.descrizione~") COMPUTE(NAME=~"cast(today() as date) as data_reg~") COLUMN(NAME=~"articolo.id_tab_iva~")    JOIN (LEFT=~"unita_confezione.id_articolo~"    OP =~"=~"RIGHT=~"articolo.id_articolo~" )    JOIN (LEFT=~"unita_confezione.id_unita_misura~"    OP =~"=~"RIGHT=~"unita_misura.id_unita_misura~" )WHERE(    EXP1 =~"~~~"unita_confezione~~~".~~~"unita_base~~~"~"   OP =~"=~"    EXP2 =~"'S'~" ) ) " )
