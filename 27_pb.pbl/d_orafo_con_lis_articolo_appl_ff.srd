 column=(type=char(80) updatewhereclause=yes name=unita_confezione_descrizione dbname="descrizione" )
 column=(type=char(32) updatewhereclause=yes name=articolo_codice dbname="codice" )
 column=(type=char(80) updatewhereclause=yes name=articolo_descrizione dbname="descrizione" )
 column=(type=long updatewhereclause=yes name=id_cat_com_sc dbname="id_cat_com_sc" )
 column=(type=long updatewhereclause=yes name=id_cat_com_articolo dbname="id_cat_com_articolo" )
