table(column=(type=long updatewhereclause=yes identity=yes name=id_con_lis_articolo dbname="id_con_lis_articolo" )
 column=(type=char(1) updatewhereclause=yes name=applicazione dbname="applicazione" values="Acquisti	A/Vendite	V/" validation=" gettext()  = 'A' OR  gettext()  = 'V'" validationmsg="'Immettere: A, V'" )
 column=(type=char(8) updatewhereclause=yes name=sog_commerciale_codice dbname="codice" )
