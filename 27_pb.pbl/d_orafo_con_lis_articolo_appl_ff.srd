 column=(type=date updatewhereclause=yes name=data_fine dbname="data_fine" )
 column=(type=decimal(4) updatewhereclause=yes name=qta_minima dbname="qta_minima" validation=" real(gettext())  >= 0" validationmsg="'Immettere un valore >= 0'" )
 column=(type=decimal(4) updatewhereclause=yes name=qta_massima dbname="qta_massima" validation=" real(gettext())  >= 0" validationmsg="'Immettere un valore >= 0'" )
 column=(type=char(1) updatewhereclause=yes name=tipo_applicazione dbname="tipo_applicazione" initial="P" values="Percentuali di  sconto	P/Importo di sconto	I/percentuali di Sconto riga	S/importo di sconto Riga	R/percentuali di sconto Documento	D/Costo medio continuo	C/" )
 column=(type=long updatewhereclause=yes name=id_valuta_des dbname="id_valuta" )
 column=(type=decimal(4) updatewhereclause=yes name=cambio dbname="cambio" validation=" real(gettext())  >= 0" validationmsg="'Immettere un valore >= 0'" )
 column=(type=decimal(4) updatewhereclause=yes name=importo dbname="importo" )
 column=(type=char(40) updatewhereclause=yes name=percentuali dbname="percentuali" )
 column=(type=char(40) updatewhereclause=yes name=spesa dbname="spesa" )
 column=(type=decimal(4) updatewhereclause=yes name=spesa_fissa dbname="spesa_fissa" )
 column=(type=decimal(0) updatewhereclause=yes name=con_lis_articolo_priorita dbname="priorita" )
 column=(type=long updatewhereclause=yes name=id_azienda dbname="id_azienda" initial="1" )
 column=(type=char(40) updatewhereclause=yes name=anagrafica_rag_soc_1 dbname="rag_soc_1" )
 column=(type=char(8) updatewhereclause=yes name=sog_commerciale_codice dbname="codice" )
 column=(type=char(40) updatewhereclause=yes name=anagrafica_rag_soc_1 dbname="rag_soc_1" )
 column=(type=long updatewhereclause=yes name=id_unita_confezione dbname="id_unita_confezione" )
 column=(type=long updatewhereclause=yes name=id_sog_commerciale dbname="id_sog_commerciale" )
 column=(type=long updatewhereclause=yes name=id_art_da dbname="id_art_da" )
 column=(type=long updatewhereclause=yes name=id_sog_commerciale_fornitore dbname="id_sog_commerciale_fornitore" )
 column=(type=long updatewhereclause=yes name=id_anagrafica dbname="id_anagrafica" )
 column=(type=long updatewhereclause=yes name=id_art_a dbname="id_art_a" )
 column=(type=decimal(2) updatewhereclause=yes name=coef_calo dbname="coef_calo" )
 retrieve="  SELECT ~"con_lis_articolo~".~"id_con_lis_articolo~",   
         ~"con_lis_articolo~".~"applicazione~",   
         ~"unita_confezione~".~"codice~",   
         ~"unita_confezione~".~"descrizione~",   
         ~"sog_commerciale_a~".~"codice~",   
         ~"anagrafica_a~".~"rag_soc_1~",   
         ~"articolo_a~".~"codice~",   
         ~"articolo_a~".~"descrizione~",   
         ~"articolo_b~".~"codice~",   
         ~"articolo_b~".~"descrizione~",   
         ~"con_lis_articolo~".~"id_cat_com_sc~",   
         ~"con_lis_articolo~".~"id_cat_com_articolo~",   
         ~"con_lis_articolo~".~"id_listino~",   
         ~"con_lis_articolo~".~"data_inizio~",   
         ~"con_lis_articolo~".~"data_fine~",   
         ~"con_lis_articolo~".~"qta_minima~",   
         ~"con_lis_articolo~".~"qta_massima~",   
         ~"con_lis_articolo~".~"tipo_applicazione~",   
         ~"con_lis_articolo~".~"id_valuta~",   
         ~"con_lis_articolo~".~"cambio~",   
         ~"con_lis_articolo~".~"importo~",   
         ~"con_lis_articolo~".~"percentuali~",   
         ~"con_lis_articolo~".~"spesa~",   
           ~"con_lis_articolo~".~"spesa_fissa~", 
         ~"con_lis_articolo~".~"priorita~",   
         ~"con_lis_articolo~".~"id_azienda~",   
         ~"anagrafica_b~".~"rag_soc_1~",   
         ~"sog_commerciale_b~".~"codice~",   
         ~"anagrafica_c~".~"rag_soc_1~",   
         ~"con_lis_articolo~".~"id_unita_confezione~",   
         ~"con_lis_articolo~".~"id_sog_commerciale~",   
         ~"con_lis_articolo~".~"id_art_da~",   
         ~"con_lis_articolo~".~"id_sog_commerciale_fornitore~",   
         ~"con_lis_articolo~".~"id_anagrafica~",   
         ~"con_lis_articolo~".~"id_art_a~",
         ~"con_lis_articolo~".~"coef_calo~"  
    FROM {oj {oj ~"con_lis_articolo~"  LEFT OUTER JOIN ~"unita_confezione~"  ON ~"con_lis_articolo~".~"id_unita_confezione~" = ~"unita_confezione~".~"id_unita_confezione~"}, {oj ~"con_lis_articolo~"  LEFT OUTER JOIN ~"sog_commerciale~" sog_commerciale_a  ON ~"con_lis_articolo~".~"id_sog_commerciale~" = ~"sog_commerciale_a~".~"id_sog_commerciale~"} LEFT OUTER JOIN ~"anagrafica~" anagrafica_a  ON ~"sog_commerciale_a~".~"id_anagrafica~" = ~"anagrafica_a~".~"id_anagrafica~"}, {oj ~"sog_commerciale~" sog_commerciale_b  LEFT OUTER JOIN ~"anagrafica~" anagrafica_b  ON ~"sog_commerciale_b~".~"id_anagrafica~" = ~"anagrafica_b~".~"id_anagrafica~"}, {oj ~"con_lis_articolo~"  LEFT OUTER JOIN ~"sog_commerciale~" sog_commerciale_b  ON ~"con_lis_articolo~".~"id_sog_commerciale_fornitore~" = ~"sog_commerciale_b~".~"id_sog_commerciale~"}, {oj ~"con_lis_articolo~"  LEFT OUTER JOIN ~"articolo~" articolo_a  ON ~"con_lis_articolo~".~"id_art_da~" = ~"articolo_a~".~"id_articolo~"}, {oj ~"con_lis_articolo~"  LEFT OUTER JOIN ~"articolo~" articolo_b  ON ~"con_lis_articolo~".~"id_art_a~" = ~"articolo_b~".~"id_articolo~"}, {oj ~"con_lis_articolo~"  LEFT OUTER JOIN ~"anagrafica~" anagrafica_c  ON ~"con_lis_articolo~".~"id_anagrafica~" = ~"anagrafica_c~".~"id_anagrafica~"}  
   WHERE ~"con_lis_articolo~".~"id_con_lis_articolo~" = :ra_id_con_lis_articolo    
" arguments=(("ra_id_con_lis_articolo", number)) )
