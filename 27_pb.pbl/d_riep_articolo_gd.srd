table(column=(type=decimal(4) updatewhereclause=yes name=qta_caricata dbname="riepilogo.qta_caricata" )
 column=(type=decimal(4) updatewhereclause=yes name=qta_scaricata dbname="riepilogo.qta_scaricata" )
 column=(type=decimal(4) updatewhereclause=yes name=qta_ord_clienti dbname="riepilogo.qta_ord_clienti" )
