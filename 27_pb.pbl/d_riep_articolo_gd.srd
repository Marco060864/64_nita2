 column=(type=decimal(4) updatewhereclause=yes name=peso_vis_fornitori dbname="riepilogo.peso_vis_fornitori" )
 column=(type=decimal(4) updatewhereclause=yes name=qta_gruppo_lib_1 dbname="riepilogo.qta_gruppo_lib_1" )
 column=(type=decimal(4) updatewhereclause=yes name=qta_gruppo_lib_2 dbname="riepilogo.qta_gruppo_lib_2" )
 column=(type=decimal(4) updatewhereclause=yes name=peso_gruppo_lib_1 dbname="riepilogo.peso_gruppo_lib_1" )
 column=(type=decimal(4) updatewhereclause=yes name=peso_gruppo_lib_2 dbname="riepilogo.peso_gruppo_lib_2" )
 column=(type=decimal(0) updatewhereclause=yes name=valuta dbname="valuta" )
 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"articolo~" )  TABLE(NAME=~"locazione~" )  TABLE(NAME=~"riepilogo~" ) COLUMN(NAME=~"riepilogo.qta_caricata~") COLUMN(NAME=~"riepilogo.qta_scaricata~") COLUMN(NAME=~"riepilogo.qta_ord_clienti~") COLUMN(NAME=~"riepilogo.qta_ord_fornitori~") COLUMN(NAME=~"riepilogo.qta_vis_clienti~") COLUMN(NAME=~"riepilogo.qta_vis_fornitori~") COLUMN(NAME=~"riepilogo.mese~") COLUMN(NAME=~"riepilogo.val_caricato~") COLUMN(NAME=~"riepilogo.val_scaricato~") COLUMN(NAME=~"articolo.codice~") COLUMN(NAME=~"locazione.id_magazzino~") COLUMN(NAME=~"riepilogo.peso_caricato~") COLUMN(NAME=~"riepilogo.peso_scaricato~") COLUMN(NAME=~"riepilogo.peso_ord_clienti~") COLUMN(NAME=~"riepilogo.peso_ord_fornitori~") COLUMN(NAME=~"riepilogo.peso_vis_clienti~") COLUMN(NAME=~"riepilogo.peso_vis_fornitori~") COLUMN(NAME=~"riepilogo.qta_gruppo_lib_1~") COLUMN(NAME=~"riepilogo.qta_gruppo_lib_2~") COLUMN(NAME=~"riepilogo.peso_gruppo_lib_1~") COLUMN(NAME=~"riepilogo.peso_gruppo_lib_2~") COMPUTE(NAME=~"cast(( select id_valuta from esercizio where id_esercizio=~~~"riepilogo~~~".~~~"id_esercizio~~~" ) as numeric ) as valuta~")    JOIN (LEFT=~"riepilogo.id_locazione~"    OP =~"=~"RIGHT=~"locazione.id_locazione~" )    JOIN (LEFT=~"riepilogo.id_articolo~"    OP =~"=~"RIGHT=~"articolo.id_articolo~" )WHERE(    EXP1 =~"~~~"articolo~~~".~~~"id_articolo~~~"~"   OP =~"=~"    EXP2 =~":rd_articolo~" ) ) ORDER(NAME=~"riepilogo.mese~" ASC=yes ) ARG(NAME = ~"rd_articolo~" TYPE = number)  ARG(NAME = ~"rd_magazzino~" TYPE = number)  ARG(NAME = ~"rd_tipo~" TYPE = string) " arguments=(("rd_articolo", number),("rd_magazzino", number),("rd_tipo", string))  sort="mese A " )
group(level=1 header.height=64 trailer.height=0 by=("mese" ) header.color="536870912" trailer.color="536870912"  sort="mese A " )
report(band=header dataobject="d_testa_riep" x="5" y="12" height="452" width="3003" border="0"  height.autosize=yes criteria="" nest_arguments=(("articolo_codice"),("rd_magazzino")) trail_footer = yes  slideup=directlyabove )
