 column=(type=char(32) updatewhereclause=yes name=articolo_codice dbname="articolo.codice" )
 column=(type=long updatewhereclause=yes name=locazione_id_magazzino dbname="locazione.id_magazzino" )
 column=(type=decimal(4) updatewhereclause=yes name=peso_caricato dbname="riepilogo.peso_caricato" )
 column=(type=decimal(4) updatewhereclause=yes name=peso_scaricato dbname="riepilogo.peso_scaricato" )
 column=(type=decimal(4) updatewhereclause=yes name=peso_ord_clienti dbname="riepilogo.peso_ord_clienti" )
 column=(type=decimal(4) updatewhereclause=yes name=peso_ord_fornitori dbname="riepilogo.peso_ord_fornitori" )
