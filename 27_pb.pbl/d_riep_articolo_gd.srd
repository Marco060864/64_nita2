 column=(type=decimal(0) updatewhereclause=yes name=mese dbname="riepilogo.mese" values="Gen	1/Feb	2/Mar	3/Apr	4/Mag	5/Giu	6/Lug	7/Ago	8/Set	9/Ott	10/Nov	11/Dic	12/" )
 column=(type=decimal(4) updatewhereclause=yes name=val_caricato dbname="riepilogo.val_caricato" )
