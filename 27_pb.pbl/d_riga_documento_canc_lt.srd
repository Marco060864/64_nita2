release 5;
datawindow(units=0 timer_interval=0 color=79741120 processing=1 print.documentname="" print.orientation = 0 print.margin.left = 110 print.margin.right = 110 print.margin.top = 97 print.margin.bottom = 97 print.paper.source = 0 print.paper.size = 0 print.prompt=no grid.lines=0 selected.mouse=no )
header(height=137 color="553648127" )
summary(height=1 color="536870912" )
footer(height=1 color="536870912" )
detail(height=73 color="553648127" )
table(column=(type=decimal(0) updatewhereclause=yes name=riga_documento_num_riga dbname="num_riga" validation=" real(gettext())  >= 0" validationmsg="'Immettere un valore >= 0'" )
 column=(type=char(20) updatewhereclause=yes name=articolo_codice dbname="codice" )
 column=(type=char(32766) updatewhereclause=yes name=riga_documento_descrizione dbname="descrizione" )
 column=(type=decimal(4) updatewhereclause=yes name=riga_documento_quantita dbname="quantita" validation=" real(gettext())  >= 0" validationmsg="'Immettere un valore >= 0'" )
 column=(type=decimal(4) updatewhereclause=yes name=riga_documento_prezzo dbname="prezzo" validation=" real(gettext())  >= 0" validationmsg="'Immettere un valore >= 0'" )
 column=(type=long updatewhereclause=yes name=riga_documento_id_azienda dbname="id_azienda" initial="1" )
 column=(type=decimal(6) updatewhereclause=yes name=totale_riga dbname="compute_0007" )
 column=(type=char(1) updatewhereclause=yes name=riga_documento_sospesa dbname="sospesa" values="	S/	N" validation=" gettext()  = 'S' OR  gettext()  = 'N'" validationmsg="'Immettere: S, N'" )
 column=(type=char(8) updatewhereclause=yes name=unita_confezione_codice dbname="codice" )
 column=(type=long updatewhereclause=yes name=id_riga_documento dbname="id_riga_documento" )
 column=(type=long updatewhereclause=yes name=id_documento dbname="id_documento" )
 column=(type=decimal(4) updatewhereclause=yes name=cqta_evasa dbname="qta_evasa" )
 column=(type=decimal(0) updatewhereclause=yes name=c_filtro dbname="c_filtro" initial="0" )
 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"riga_documento~" )  TABLE(NAME=~"articolo~" )  TABLE(NAME=~"unita_confezione~" ) COLUMN(NAME=~"riga_documento.num_riga~") COLUMN(NAME=~"articolo.codice~") COLUMN(NAME=~"riga_documento.descrizione~") COLUMN(NAME=~"riga_documento.quantita~") COLUMN(NAME=~"riga_documento.prezzo~") COLUMN(NAME=~"riga_documento.id_azienda~") COMPUTE(NAME=~"~~~"riga_documento~~~".~~~"quantita~~~" * ~~~"riga_documento~~~".~~~"prezzo~~~"~") COLUMN(NAME=~"riga_documento.sospesa~") COLUMN(NAME=~"unita_confezione.codice~") COLUMN(NAME=~"riga_documento.id_riga_documento~") COLUMN(NAME=~"riga_documento.id_documento~") COLUMN(NAME=~"riga_documento.qta_evasa~") COMPUTE(NAME=~"cast(0 as numeric(1)) As c_filtro~")    JOIN (LEFT=~"riga_documento.id_unita_confezione~"    OP =~"=~"RIGHT=~"unita_confezione.id_unita_confezione~"    OUTER1 =~"riga_documento.id_unita_confezione~" )    JOIN (LEFT=~"riga_documento.id_articolo~"    OP =~"=~"RIGHT=~"articolo.id_articolo~"    OUTER1 =~"riga_documento.id_articolo~" )WHERE(    EXP1 =~"( ~~~"articolo~~~".~~~"id_azienda~~~"~"   OP =~"in~"    EXP2 =~"(0, 1) )~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"( ~~~"riga_documento~~~".~~~"id_documento~~~"~"   OP =~"=~"    EXP2 =~":ra_documento )~" ) ) ARG(NAME = ~"ra_documento~" TYPE = number) " arguments=(("ra_documento", number)) )
