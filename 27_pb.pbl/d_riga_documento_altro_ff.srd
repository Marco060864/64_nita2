riga_documento.tot_riga_val_riga~") COLUMN(NAME=~"riga_documento.tot_riga_val_doc~") COLUMN(NAME=~"riga_documento.tot_riga_val_az~") COLUMN(NAME=~"riga_documento.id_riga_doc_provenienza~") COLUMN(NAME=~"riga_documento.id_conto~") COLUMN(NAME=~"riga_documento.id_azienda~") COMPUTE(NAME=~"Cast('' as char(20)) as c_articolo_cod~") COMPUTE(NAME=~"Cast('' as char(80)) as c_articolo_des~") COMPUTE(NAME=~"Cast('' as char(8)) as c_conto_cod~") COMPUTE(NAME=~"Cast('' as char(20)) as c_des_articolo_cod~") COMPUTE(NAME=~"Cast('' as char(40)) as c_des_articolo_des~") COMPUTE(NAME=~"Cast('' as char(8)) as c_unita_confezione_cod~") COMPUTE(NAME=~"Cast('' as char(40)) as c_unita_confezione_des~") COMPUTE(NAME=~"Cast('' as char(8)) as c_sog_commerciale_agente_cod~") COMPUTE(NAME=~"Cast('' as char(80)) as c_lis_articolo~") COMPUTE(NAME=~"Cast('' as char(40)) as c_sog_commerciale_agente_des~")WHERE(    EXP1 =~"( ~~~"riga_documento~~~".~~~"id_azienda~~~"~"   OP =~"in~"    EXP2 =~"(0, 1) )~" ) ) ORDER(NAME=~"riga_documento.num_riga~" ASC=yes ) " )
