a_documento.data_inizio_competenza~") COLUMN(NAME=~"riga_documento.data_fine_competenza~") COLUMN(NAME=~"riga_documento.tot_riga_val_riga~") COLUMN(NAME=~"riga_documento.tot_riga_val_doc~") COLUMN(NAME=~"riga_documento.tot_riga_val_az~") COLUMN(NAME=~"riga_documento.id_riga_doc_provenienza~") COLUMN(NAME=~"riga_documento.id_conto~") COLUMN(NAME=~"riga_documento.id_azienda~") COMPUTE(NAME=~"Cast('' as char(1)) As c_unita_conf_tipo_conversione~") COMPUTE(NAME=~"Cast(0 as decimal) As c_unita_conf_fat_conversione~") COMPUTE(NAME=~"Cast(0 as decimal) As c_unita_conf_molteplicita    ~")WHERE(    EXP1 =~"( ~~~"riga_documento~~~".~~~"id_documento~~~"~"   OP =~"=~"    EXP2 =~":ra_id_documento )~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"( ~~~"riga_documento~~~".~~~"id_azienda~~~"~"   OP =~"in~"    EXP2 =~"(0,1) )~" ) ) ARG(NAME = ~"ra_id_documento~" TYPE = number) " update="riga_documento" updatewhere=1 updatekeyinplace=yes arguments=(("ra_id_documento", number)) )
