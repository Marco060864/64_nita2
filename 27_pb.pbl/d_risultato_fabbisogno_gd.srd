 column=(type=datetime updatewhereclause=yes name=fabbisogno_data_generazione dbname="fabbisogno.data_generazione" )
 retrieve="  SELECT  ~"articolo~".~"codice~" ,           ~"articolo~".~"descrizione~" ,           ~"unita_confezione~".~"codice~" ,           ~"fabbisogno~".~"disponibilita~" ,           ~"fabbisogno~".~"esistenza~" ,           ~"fabbisogno~".~"qta_riordino~" ,           ~"fabbisogno~".~"id_fabbisogno~" ,           ~"fabbisogno~".~"id_magazzino~" ,           ~"fabbisogno~".~"id_sog_commerciale~" ,           ~"fabbisogno~".~"id_unita_confezione~" ,           ~"fabbisogno~".~"id_articolo~" ,           ~"fabbisogno~".~"qta_ord_fornitore~" ,           ~"fabbisogno~".~"qta_ord_cliente~" ,           ~"fabbisogno~".~"disp_globale~" ,           ~"fabbisogno~".~"esist_globale~" ,           ~"fabbisogno~".~"data_generazione~"     
        FROM ~"fabbisogno~" ,           ~"articolo~" ,           ~"unita_confezione~"     
        WHERE ( ~"articolo~".~"id_articolo~" = ~"fabbisogno~".~"id_articolo~" ) and          ( ~"unita_confezione~".~"id_articolo~" = ~"articolo~".~"id_articolo~" ) and          ( ~"unita_confezione~".~"id_unita_confezione~" = ~"fabbisogno~".~"id_unita_confezione~" )   " update="fabbisogno" updatewhere=1 updatekeyinplace=yes )
