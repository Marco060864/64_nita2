 column=(type=char(1) updatewhereclause=yes name=bloccato dbname="documento.bloccato" initial="N" values="	S/	N" validation=" gettext()  = 'S' OR  gettext()  = 'N'" validationmsg="'Immettere: S, N'" )
 retrieve="  SELECT Cast ('' as char(8))  As c_prof_documento_cod,   
         ~"documento~".~"id_documento~",   
         ~"documento~".~"id_prof_documento~",   
         ~"documento~".~"id_registro~",   
         ~"documento~".~"num_progressivo~",   
         ~"documento~".~"data_registrazione~",   
         ~"documento~".~"num_documento~",   
         ~"documento~".~"data_documento~",   
         ~"documento~".~"data_competenza~",   
         ~"documento~".~"id_sog_commerciale~",   
         ~"documento~".~"id_destinazione~",   
         ~"documento~".~"id_caus_magazzino~",   
         ~"documento~".~"id_magazzino~",   
         ~"documento~".~"id_magazzino_2~",   
         ~"documento~".~"id_sog_commerciale_fattura~",   
         ~"documento~".~"id_linguaggio~",   
         ~"documento~".~"id_valuta~",   
         ~"documento~".~"cambio~",   
         ~"documento~".~"id_listino~",   
         ~"documento~".~"id_con_pagamento~",   
         ~"documento~".~"id_banca_appoggio~",   
         ~"documento~".~"id_gruppo_agenti~",   
         ~"documento~".~"origine~",   
         ~"documento~".~"interlocutore~",   
         ~"documento~".~"data_prev_consegna~",   
         ~"documento~".~"note_intestazione~",   
         ~"documento~".~"num_colli~",   
         ~"documento~".~"id_unita_misura_peso~",   
         ~"documento~".~"peso_netto~",   
         ~"documento~".~"peso_lordo~",   
         ~"documento~".~"id_unita_misura_volume~",   
         ~"documento~".~"volume~",   
         ~"documento~".~"id_tipo_trasporto~",   
         ~"documento~".~"id_caus_trasporto~",   
         ~"documento~".~"asp_beni~",   
         ~"documento~".~"tras_mezzo~",   
         ~"documento~".~"id_sog_commerciale_vettore~",   
         ~"documento~".~"id_sog_commerciale_vettore_2~",   
         ~"documento~".~"mezzo_trasporto~",   
         ~"documento~".~"targa_mezzo_trasporto~",   
         ~"documento~".~"data_trasporto~",   
         ~"documento~".~"ora_trasporto~",   
         ~"documento~".~"sconto_finanziario~",   
         ~"documento~".~"sconto_fin_incondizionato~",   
         ~"documento~".~"sconto_fin_cassa~",   
         ~"documento~".~"data_dec_pagamento~",   
         ~"documento~".~"imp_acconto~",   
         ~"documento~".~"id_tipo_pagamento~",   
         ~"documento~".~"stampato~",   
         ~"documento~".~"contabilizzato~",   
         ~"documento~".~"evaso_totalmente~",   
         ~"documento~".~"chius_forzata~",   
         ~"documento~".~"sospeso~",   
         ~"documento~".~"data_scadenza~",   
         ~"documento~".~"creato_in_esenzione~",   
         ~"documento~".~"id_azienda~",   
         ~"documento~".~"id_lingua~",   
         Cast ('' as char(40))  As c_registro_cod,   
         Cast ('' as char(40))  As c_registro_des,   
         Cast ('' as char(40))  As c_intestatario_des,   
         Cast ('' as char(8))  As c_mag_partenza_cod,   
         Cast ('' as char(40))  As c_mag_partenza_des,   
         Cast ('' as char(8))  As c_mag_dest_cod,   
         Cast ('' as char(40))  As c_mag_dest_des,   
         Cast ('' as char(8))   As c_intestatario_cod,   
         Cast ('' as char(40))  As c_destinazione_des,   
         Cast ('' as char(40))  As c_prof_documento_des,   
         Cast ('' as char(8))  As c_vettore_cod,   
         Cast ('' as char(40))  As c_vettore_des,   
         Cast ('' as char(40))  As c_vettore_2_des,   
         Cast ('' as char(8))  As c_vettore_2_cod,   
         Cast ('' as char(8))  As c_agente_cod,   
         Cast ('' as char(40))  As c_agente_des,   
         Cast ('' as char(8))  As c_fattura_cod,   
         Cast ('' as char(40))  As c_fattura_des,   
         ~"documento~".~"bloccato~"  
    FROM ~"documento~"   
" update="documento" updatewhere=0 updatekeyinplace=no )
