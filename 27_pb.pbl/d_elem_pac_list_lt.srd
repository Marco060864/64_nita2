 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"elem_pac_list~" ) COLUMN(NAME=~"elem_pac_list.id_elem_pac_list~") COLUMN(NAME=~"elem_pac_list.id_documento~") COLUMN(NAME=~"elem_pac_list.dal_numero~") COLUMN(NAME=~"elem_pac_list.al_numero~") COLUMN(NAME=~"elem_pac_list.des_imballo~") COLUMN(NAME=~"elem_pac_list.peso_netto~") COLUMN(NAME=~"elem_pac_list.peso_lordo~") COLUMN(NAME=~"elem_pac_list.dim_l~") COLUMN(NAME=~"elem_pac_list.dim_h~") COLUMN(NAME=~"elem_pac_list.dim_p~") COLUMN(NAME=~"elem_pac_list.id_azienda~")WHERE(    EXP1 =~"~~~"elem_pac_list~~~".~~~"id_azienda~~~"~"   OP =~"in~"    EXP2 =~"(0,1)~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"elem_pac_list~~~".~~~"id_documento~~~"~"   OP =~"=~"    EXP2 =~":rn_id_documento~" ) ) ORDER(NAME=~"elem_pac_list.dal_numero~" ASC=yes ) ARG(NAME = ~"rn_id_documento~" TYPE = number) " update="elem_pac_list" updatewhere=1 updatekeyinplace=no arguments=(("rn_id_documento", number)) )
