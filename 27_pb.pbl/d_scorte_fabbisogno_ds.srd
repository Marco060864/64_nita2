release 5;
datawindow(units=0 timer_interval=0 color=79741120 processing=1 print.documentname="" print.orientation = 0 print.margin.left = 110 print.margin.right = 110 print.margin.top = 97 print.margin.bottom = 97 print.paper.source = 0 print.paper.size = 0 print.prompt=no grid.lines=0 )
header(height=77 color="536870912" )
summary(height=1 color="536870912" )
footer(height=1 color="536870912" )
detail(height=89 color="536870912" )
table(column=(type=long updatewhereclause=yes identity=yes name=scorta_id_scorta dbname="scorta.id_scorta" )
 column=(type=long updatewhereclause=yes name=scorta_id_unita_confezione dbname="scorta.id_unita_confezione" )
 column=(type=long updatewhereclause=yes name=scorta_id_per_scorta dbname="scorta.id_per_scorta" )
 column=(type=long updatewhereclause=yes name=scorta_id_magazzino dbname="scorta.id_magazzino" )
 column=(type=decimal(4) updatewhereclause=yes name=scorta_scorta_minima dbname="scorta.scorta_minima" )
 column=(type=decimal(4) updatewhereclause=yes name=scorta_scorta_massima dbname="scorta.scorta_massima" )
 column=(type=decimal(0) updatewhereclause=yes name=per_scorta_giorno_inizio dbname="per_scorta.giorno_inizio" validation=" real(gettext())  >= 1 AND  real(gettext())  <= 31" validationmsg="'Immettere un giorno (fra 1 e 31)'" )
 column=(type=decimal(0) updatewhereclause=yes name=per_scorta_mese_inizio dbname="per_scorta.mese_inizio" validation=" real(gettext())  >= 1 AND  real(gettext())  <= 12" validationmsg="'Immettere un mese (fra 1 e 12)'" )
 column=(type=decimal(0) updatewhereclause=yes name=per_scorta_giorno_fine dbname="per_scorta.giorno_fine" validation=" real(gettext())  >= 1 AND  real(gettext())  <= 31" validationmsg="'Immettere un giorno (fra 1 e 31)'" )
 column=(type=decimal(0) updatewhereclause=yes name=per_scorta_mese_fine dbname="per_scorta.mese_fine" validation=" real(gettext())  >= 1 AND  real(gettext())  <= 12" validationmsg="'Immettere un mese (fra 1 e 12)'" )
 column=(type=long updatewhereclause=yes name=scorta_id_azienda dbname="scorta.id_azienda" initial="1" )
 column=(type=long updatewhereclause=yes name=cc_ordine dbname="c_ordine" )
 column=(type=decimal(0) updatewhereclause=yes name=per_scorta_priorita dbname="per_scorta.priorita" initial="0" validation=" real(gettext())  >= 0" validationmsg="'Immettere un valore >= 0'" )
 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"scorta~" )  TABLE(NAME=~"per_scorta~" ) COLUMN(NAME=~"scorta.id_scorta~") COLUMN(NAME=~"scorta.id_unita_confezione~") COLUMN(NAME=~"scorta.id_per_scorta~") COLUMN(NAME=~"scorta.id_magazzino~") COLUMN(NAME=~"scorta.scorta_minima~") COLUMN(NAME=~"scorta.scorta_massima~") COLUMN(NAME=~"per_scorta.giorno_inizio~") COLUMN(NAME=~"per_scorta.mese_inizio~") COLUMN(NAME=~"per_scorta.giorno_fine~") COLUMN(NAME=~"per_scorta.mese_fine~") COLUMN(NAME=~"scorta.id_azienda~") COMPUTE(NAME=~"CAST ( 0 as integer ) as c_ordine~") COLUMN(NAME=~"per_scorta.priorita~")    JOIN (LEFT=~"per_scorta.id_per_scorta~"    OP =~"=~"RIGHT=~"scorta.id_per_scorta~" )WHERE(    EXP1 =~"~~~"scorta~~~".~~~"id_unita_confezione~~~"~"   OP =~"=~"    EXP2 =~":ra_id_unita_confezione~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"scorta~~~".~~~"id_azienda~~~"~"   OP =~"=~"    EXP2 =~"1~" ) ) ARG(NAME = ~"ra_id_unita_confezione~" TYPE = number) " arguments=(("ra_id_unita_confezione", number))  sort="cc_ordine A " )
