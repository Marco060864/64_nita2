table(column=(type=long updatewhereclause=yes key=yes identity=yes name=id_prof_documento dbname="prof_documento.id_prof_documento" dbalias=".id_prof_documento" )
 column=(type=char(8) updatewhereclause=yes name=codice dbname="prof_documento.codice" dbalias=".codice" )
