 column=(type=char(2) updatewhereclause=yes name=tipo_registro dbname="prof_documento.tipo_registro" dbalias=".tipo_registro" values="IVA acquisti	IA/IVA vendite	IV/Manageriale	MN/Prima nota	PN/Preventivi acquisti	PA/Preventivi vendite	PV/Ordini acquisti	OA/Ordini vendite	OV/DDT acquisti	DA/DDT vendite	DV/Liste prelievo acquisti	LA/Liste prelievo vendite	LV/Generico acquisti	GA/Generico vendite	GV/" validation=" gettext()  = 'IA' OR  gettext()  = 'IV' OR  gettext()  = 'MN' OR  gettext()  = 'PN' OR  gettext()  = 'PA' OR  gettext()  = 'PV' OR  gettext()  = 'OA' OR  gettext()  = 'OV' OR  gettext()  = 'DA' OR  gettext()  = 'DV' OR  gettext()  = 'LA' OR  gettext()  = 'LV' OR  gettext()  = 'GA' OR  gettext()  = 'GV'" validationmsg="'Immettere: IA, IV, MN, PN, OA, OP, DA, DV, LA, LP, GA, GV'" )
 column=(type=char(1) updatewhereclause=yes name=ric_id_registro dbname="prof_documento.ric_id_registro" dbalias=".ric_id_registro" initial="M" values="Non Visibile	N/Sola Lettura	L/Modificabile	M/Obbligatorio	O/" validation=" gettext()  = 'N' OR  gettext()  = 'L' OR  gettext()  = 'M' OR  gettext()  = 'O'" validationmsg="'Immettere: N, L, M, O'" )
