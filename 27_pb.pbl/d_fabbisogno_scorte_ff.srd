 column=(type=char(40) updatewhereclause=yes name=unita_confezione_descrizione dbname="unita_confezione.descrizione" )
 column=(type=char(8) updatewhereclause=yes name=magazzino_codice dbname="magazzino.codice" )
 column=(type=char(40) updatewhereclause=yes name=magazzino_descrizione dbname="magazzino.descrizione" )
 retrieve="  SELECT ~"fabbisogno~".~"id_fabbisogno~",   
         ~"fabbisogno~".~"id_sog_commerciale~",   
         ~"fabbisogno~".~"id_magazzino~",   
         ~"fabbisogno~".~"id_unita_confezione~",   
         ~"fabbisogno~".~"id_articolo~",   
         ~"fabbisogno~".~"data_generazione~",   
         ~"fabbisogno~".~"qta_riordino~",   
         ~"fabbisogno~".~"disponibilita~",   
         ~"fabbisogno~".~"esistenza~",   
         ~"fabbisogno~".~"qta_ord_fornitore~",   
         ~"fabbisogno~".~"qta_ord_cliente~",   
         ~"fabbisogno~".~"disp_globale~",   
         ~"fabbisogno~".~"esist_globale~",   
         ~"articolo~".~"codice~",   
         ~"articolo~".~"descrizione~",   
         ~"sog_commerciale_gen~".~"codice~",   
         ~"sog_commerciale_gen~".~"rag_soc_1~",   
         ~"unita_confezione~".~"codice~",   
         ~"unita_confezione~".~"descrizione~",   
         ~"magazzino~".~"codice~",   
         ~"magazzino~".~"descrizione~"  
    FROM {oj ~"fabbisogno~"  LEFT OUTER JOIN ~"sog_commerciale_gen~"  ON ~"fabbisogno~".~"id_sog_commerciale~" = ~"sog_commerciale_gen~".~"id_sog_commerciale~"},   
         ~"articolo~",   
         ~"unita_confezione~",   
         ~"magazzino~"  
   WHERE ( ~"articolo~".~"id_articolo~" = ~"fabbisogno~".~"id_articolo~" ) and  
         ( ~"unita_confezione~".~"id_unita_confezione~" = ~"fabbisogno~".~"id_unita_confezione~" ) and  
         ( ~"magazzino~".~"id_magazzino~" = ~"fabbisogno~".~"id_magazzino~" )    
" update="fabbisogno" updatewhere=1 updatekeyinplace=yes )
