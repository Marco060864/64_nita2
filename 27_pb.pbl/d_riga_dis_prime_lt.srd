 column=(type=char(1) updatewhereclause=yes name=tipo dbname="unita_misura.tipo" )
 column=(type=long updatewhereclause=yes name=id_tab_iva dbname="articolo.id_tab_iva" )
 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"riga_distinta~" )  TABLE(NAME=~"articolo~" )  TABLE(NAME=~"unita_confezione~" )  TABLE(NAME=~"unita_misura~" ) COLUMN(NAME=~"riga_distinta.num_riga~") COLUMN(NAME=~"riga_distinta.id_riga_distinta~") COLUMN(NAME=~"riga_distinta.id_distinta~") COLUMN(NAME=~"riga_distinta.id_articolo~") COLUMN(NAME=~"riga_distinta.id_dis_figlio~") COLUMN(NAME=~"riga_distinta.tipo_riga~") COLUMN(NAME=~"riga_distinta.costo~") COLUMN(NAME=~"riga_distinta.calo~") COLUMN(NAME=~"riga_distinta.note~") COLUMN(NAME=~"riga_distinta.data_inizio~") COLUMN(NAME=~"riga_distinta.data_fine~") COLUMN(NAME=~"riga_distinta.id_dis_var~") COLUMN(NAME=~"articolo.codice~") COLUMN(NAME=~"articolo.descrizione~") COLUMN(NAME=~"riga_distinta.quantita~") COLUMN(NAME=~"riga_distinta.varie~") COLUMN(NAME=~"riga_distinta.id_componente~") COLUMN(NAME=~"riga_distinta.peso_netto~") COMPUTE(NAME=~"cast(:rd_liv as integer) as livello~") COLUMN(NAME=~"unita_misura.tipo~") COLUMN(NAME=~"articolo.id_tab_iva~")    JOIN (LEFT=~"articolo.id_articolo~"    OP =~"=~"RIGHT=~"riga_distinta.id_articolo~" )    JOIN (LEFT=~"unita_confezione.id_articolo~"    OP =~"=~"RIGHT=~"articolo.id_articolo~" )    JOIN (LEFT=~"unita_confezione.id_unita_misura~"    OP =~"=~"RIGHT=~"unita_misura.id_unita_misura~" )WHERE(    EXP1 =~"( ( ~~~"riga_distinta~~~".~~~"id_distinta~~~"~"   OP =~"=~"    EXP2 =~":rn_id_distinta ) )~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"unita_confezione~~~".~~~"unita_base~~~"~"   OP =~"=~"    EXP2 =~"'S'~" ) ) ORDER(NAME=~"19~" ASC=yes )  ORDER(NAME=~"riga_distinta.num_riga~" ASC=yes ) ARG(NAME = ~"rn_id_distinta~" TYPE = number)  ARG(NAME = ~"rd_liv~" TYPE = number)  ARG(NAME = ~"rd_qta~" TYPE = number) " filter=" riga_distinta_tipo_riga <>'F'" arguments=(("rn_id_distinta", number),("rd_liv", number),("rd_qta", number)) )
