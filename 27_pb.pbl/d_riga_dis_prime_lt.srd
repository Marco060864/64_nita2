 column=(type=char(1) update=yes updatewhereclause=yes name=riga_distinta_varie dbname="riga_distinta.varie" values="Lunghezza Var.	L/Chiusura	C/Infilatura	I/Inf.+ Lung. Var:	J/" )
 column=(type=long update=yes updatewhereclause=yes name=id_componente dbname="riga_distinta.id_componente" )
 column=(type=decimal(4) update=yes updatewhereclause=yes name=riga_distinta_peso_netto dbname="riga_distinta.peso_netto" )
