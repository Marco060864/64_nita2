compute(band=foreground alignment="0" expression="sum(   imponibile_scontato  for all )"border="0" color="0" x="69" y="532" height="57" width="778" format="[general]"  name=c_tot_imp_scontato visible="1~t0"  font.face="Arial" font.height="-8" font.weight="400"  font.family="2" font.pitch="2" font.charset="0" background.mode="2" background.color="16777215" )
