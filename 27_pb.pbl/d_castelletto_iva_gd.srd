compute(band=detail alignment="1" expression="( if( isNull( imponibile_scontato ), 0, imponibile_scontato  ) + if( isNull(  spesa ), 0,  spesa )  + if( isNull(  omaggi_merce ), 0,  omaggi_merce ) ) *  aliquota_iva  / 100"border="0" color="0" x="2483" y="4" height="65" width="389" format="#,0"  name=c_imposta  font.face="Arial" font.height="-8" font.weight="400"  font.family="2" font.pitch="2" font.charset="0" background.mode="2" background.color="16777215" )
compute(band=detail alignment="0" expression=" imponibile  / c_tot_imponibile "border="0" color="0" x="2881" y="4" height="65" width="151" format="[general]"  name=c_proporzionale  font.face="Arial" font.height="-8" font.weight="400"  font.family="2" font.pitch="2" font.charset="0" background.mode="2" background.color="16777215" )
compute(band=detail alignment="0" expression="( if( isNull( imponibile_scontato ), 0, imponibile_scontato  ) + if( isNull(  spesa ), 0,  spesa )  + if( isNull(  omaggi_merce ), 0,  omaggi_merce ) )"border="0" color="0" x="3041" y="4" height="65" width="179" format="[general]"  name=c_imp_spesa_omaggi  font.face="Arial" font.height="-8" font.weight="400"  font.family="2" font.pitch="2" font.charset="0" background.mode="2" background.color="16777215" )
compute(band=detail alignment="1" expression="case(  Describe(~"c_tipo_arrotondamento.text~")  when  'M'  then Round(( c_iva_lire / c_cambio) * (10^c_arrotondamento), 0) /  (10^c_arrotondamento) when 'I'  then Truncate (( c_iva_lire / c_cambio) * (10^c_arrotondamento), 0) /  (10^c_arrotondamento) when  'S'  then  Ceiling( (c_iva_lire / c_cambio) * (10^c_arrotondamento)) /  (10^c_arrotondamento) else Round(( c_iva_lire / c_cambio) * (10^c_arrotondamento), 0) /  (10^c_arrotondamento))"border="0" color="0" x="2071" y="4" height="65" width="403" format="[general]"  name=c_iva_val  font.face="Arial" font.height="-8" font.weight="400"  font.family="2" font.pitch="2" font.charset="0" background.mode="2" background.color="16777215" )
compute(band=detail alignment="1" expression="Ceiling( ( c_imp_spesa_omaggi  * c_cambio )) *  aliquota_iva  / 100"border="0" color="0" x="1655" y="4" height="65" width="407" format="[general]"  name=c_iva_lire  font.face="Arial" font.height="-8" font.weight="400"  font.family="2" font.pitch="2" font.charset="0" background.mode="2" background.color="16777215" )
compute(band=detail alignment="1" expression="if( isNull(  imponibile_scontato ),  0,  imponibile_scontato )  +  if( isNull(  spesa ),  0,  spesa )"border="0" color="0" x="581" y="4" height="65" width="426" format="#,0"  name=c_imponibile_spesa  font.face="Arial" font.height="-8" font.weight="400"  font.family="2" font.pitch="2" font.charset="0" background.mode="2" background.color="1090519039" )
compute(band=detail alignment="1" expression=" Round( c_imponibile_spesa * c_cambio, 0)"border="0" color="0" x="1015" y="4" height="65" width="426" format="[general]"  name=c_imponibile_spesa_lire  font.face="Arial" font.height="-8" font.weight="400"  font.family="2" font.pitch="2" font.charset="0" background.mode="2" background.color="1090519039" )
compute(band=foreground alignment="0" expression="sum(  imponibile  for all )"border="0" color="0" x="69" y="680" height="57" width="769" format="[general]"  name=c_tot_imponibile visible="1~t0"  font.face="Arial" font.height="-8" font.weight="400"  font.family="2" font.pitch="2" font.charset="0" background.mode="2" background.color="16777215" )
