 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"riepilogo~" )  TABLE(NAME=~"articolo~" )  TABLE(NAME=~"esercizio~" )  TABLE(NAME=~"attivita~" )  TABLE(NAME=~"locazione~" )  TABLE(NAME=~"magazzino~" )  TABLE(NAME=~"unita_confezione~" ) COLUMN(NAME=~"riepilogo.id_esercizio~") COLUMN(NAME=~"riepilogo.id_attivita~") COLUMN(NAME=~"riepilogo.id_articolo~") COLUMN(NAME=~"riepilogo.id_locazione~") COLUMN(NAME=~"riepilogo.anno~") COLUMN(NAME=~"riepilogo.mese~") COLUMN(NAME=~"articolo.codice~") COLUMN(NAME=~"riepilogo.data_ult_costo~") COLUMN(NAME=~"riepilogo.data_primo_costo~") COLUMN(NAME=~"riepilogo.qta_rim_iniziale~") COLUMN(NAME=~"riepilogo.val_rim_iniziale~") COLUMN(NAME=~"riepilogo.qta_caricata~") COLUMN(NAME=~"riepilogo.qta_scaricata~") COLUMN(NAME=~"riepilogo.val_caricato~") COLUMN(NAME=~"riepilogo.val_scaricato~") COLUMN(NAME=~"riepilogo.qta_ord_clienti~") COLUMN(NAME=~"riepilogo.qta_ord_fornitori~") COLUMN(NAME=~"riepilogo.qta_vis_clienti~") COLUMN(NAME=~"riepilogo.qta_vis_fornitori~") COLUMN(NAME=~"riepilogo.qta_imp_produzione~") COLUMN(NAME=~"riepilogo.qta_ord_produzione~") COLUMN(NAME=~"riepilogo.qta_cl_clienti~") COLUMN(NAME=~"riepilogo.qta_cl_fornitori~") COLUMN(NAME=~"riepilogo.qta_cl_terzi~") COLUMN(NAME=~"riepilogo.qta_gruppo_lib_1~") COLUMN(NAME=~"riepilogo.qta_gruppo_lib_2~") COLUMN(NAME=~"riepilogo.qta_gruppo_lib_3~") COLUMN(NAME=~"riepilogo.qta_gruppo_lib_4~") COLUMN(NAME=~"riepilogo.id_azienda~") COLUMN(NAME=~"articolo.descrizione~") COLUMN(NAME=~"esercizio.codice~") COLUMN(NAME=~"esercizio.data_inizio~") COLUMN(NAME=~"esercizio.data_fine~") COLUMN(NAME=~"attivita.descrizione~") COLUMN(NAME=~"locazione.corsia~") COLUMN(NAME=~"locazione.scaffale~") COLUMN(NAME=~"locazione.ripiano~") COLUMN(NAME=~"locazione.posizione~") COLUMN(NAME=~"locazione.id_azienda~") COLUMN(NAME=~"magazzino.codice~") COLUMN(NAME=~"magazzino.descrizione~") COLUMN(NAME=~"riepilogo.data_ult_scarico~") COLUMN(NAME=~"riepilogo.peso_caricato~") COLUMN(NAME=~"riepilogo.peso_scaricato~") COLUMN(NAME=~"riepilogo.peso_ord_clienti~") COLUMN(NAME=~"riepilogo.peso_ord_fornitori~") COLUMN(NAME=~"riepilogo.peso_vis_clienti~") COLUMN(NAME=~"riepilogo.peso_vis_fornitori~") COLUMN(NAME=~"riepilogo.peso_imp_produzione~") COLUMN(NAME=~"riepilogo.peso_ord_produzione~") COLUMN(NAME=~"riepilogo.peso_cl_clienti~") COLUMN(NAME=~"riepilogo.peso_cl_fornitori~") COLUMN(NAME=~"riepilogo.peso_gruppo_lib_1~") COLUMN(NAME=~"riepilogo.peso_gruppo_lib_2~") COLUMN(NAME=~"riepilogo.peso_gruppo_lib_3~") COLUMN(NAME=~"riepilogo.peso_gruppo_lib_4~") COLUMN(NAME=~"unita_confezione.id_unita_misura~") COLUMN(NAME=~"riepilogo.id_valuta~") COLUMN(NAME=~"riepilogo.ult_costo~") COLUMN(NAME=~"riepilogo.primo_costo~")    JOIN (LEFT=~"articolo.id_articolo~"    OP =~"=~"RIGHT=~"riepilogo.id_articolo~" )    JOIN (LEFT=~"esercizio.id_esercizio~"    OP =~"=~"RIGHT=~"riepilogo.id_esercizio~" )    JOIN (LEFT=~"attivita.id_attivita~"    OP =~"=~"RIGHT=~"riepilogo.id_attivita~" )    JOIN (LEFT=~"locazione.id_locazione~"    OP =~"=~"RIGHT=~"riepilogo.id_locazione~" )    JOIN (LEFT=~"magazzino.id_magazzino~"    OP =~"=~"RIGHT=~"locazione.id_magazzino~" )    JOIN (LEFT=~"unita_confezione.id_articolo~"    OP =~"=~"RIGHT=~"articolo.id_articolo~" )WHERE(    EXP1 =~"~~~"unita_confezione~~~".~~~"unita_base~~~"~"   OP =~"=~"    EXP2 =~"'S'~" ) ) " )
