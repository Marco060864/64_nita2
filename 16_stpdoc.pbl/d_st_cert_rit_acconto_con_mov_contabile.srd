to~"    OP =~"=~"RIGHT=~"conto.id_conto~" )    JOIN (LEFT=~"reg_pd.id_azienda~"    OP =~"=~"RIGHT=~"azienda.id_azienda~" )    JOIN (LEFT=~"tab_iva.id_tab_iva~"    OP =~"=~"RIGHT=~"mov_iva.id_tab_iva~" )WHERE(    EXP1 =~"~~~"prof_registrazione~~~".~~~"codice~~~"~"   OP =~"=~"    EXP2 =~"'004'~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"year(~~~"reg_pd~~~".~~~"data_registrazione~~~")~"   OP =~"=~"    EXP2 =~":anno~" ) ) ARG(NAME = ~"anno~" TYPE = number)  ARG(NAME = ~"aliquota_ritenuta~" TYPE = number) " arguments=(("anno", number),("aliquota_ritenuta", number))  sort="anagrafica_rag_soc_1 A reg_pd_data_registrazione A " )
