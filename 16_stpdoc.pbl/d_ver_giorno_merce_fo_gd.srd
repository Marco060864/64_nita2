 column=(type=char(7) update=yes updatewhereclause=yes name=num_bollettina dbname="ver_giorno_merce_fo.num_bollettina" )
 column=(type=long update=yes updatewhereclause=yes name=provenienza dbname="ver_giorno_merce_fo.provenienza" )
 column=(type=long update=yes updatewhereclause=yes key=yes identity=yes name=id_ver_giorno_merce_fo dbname="ver_giorno_merce_fo.id_ver_giorno_merce_fo" )
 column=(type=char(8) updatewhereclause=yes name=c_prof_ultimo dbname="c_prof_ultimo" )
 column=(type=char(40) update=yes updatewhereclause=yes name=ver_giorno_merce_fo_fo_des_libera dbname="ver_giorno_merce_fo.fo_des_libera" )
 column=(type=long updatewhereclause=yes name=c_scegli dbname="c_scegli" values="	1/	0" )
 column=(type=long update=yes updatewhereclause=yes name=id_sog_commerciale dbname="ver_giorno_merce_fo.id_sog_commerciale" )
 column=(type=date updatewhereclause=yes name=documento_data_prev_consegna dbname="documento.data_prev_consegna" )
 column=(type=datetime update=yes updatewhereclause=yes name=ver_giorno_merce_fo_data_ora dbname="ver_giorno_merce_fo.data_ora" )
 column=(type=long update=yes updatewhereclause=yes name=id_utenti dbname="ver_giorno_merce_fo.id_utenti" )
 column=(type=long updatewhereclause=yes name=bollettine_excel_id_riga_documento dbname="bollettine_excel.id_riga_documento" )
 column=(type=decimal(4) updatewhereclause=yes name=quantita dbname="riga_documento.quantita" )
 column=(type=char(12) updatewhereclause=yes name=galvanica_lavorazione dbname="galvanica.lavorazione" )
 column=(type=char(12) updatewhereclause=yes name=bollettine_excel_galvanica dbname="bollettine_excel.galvanica" )
 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"ver_giorno_merce_fo~" )  TABLE(NAME=~"bollettine_excel~" )  TABLE(NAME=~"riga_documento~" )  TABLE(NAME=~"documento~" )  TABLE(NAME=~"galvanica~" ) COLUMN(NAME=~"bollettine_excel.cod_barre~") COLUMN(NAME=~"bollettine_excel.data~") COLUMN(NAME=~"bollettine_excel.cod_art_assegnato~") COLUMN(NAME=~"riga_documento.peso_lordo~") COLUMN(NAME=~"riga_documento.provv_imp_carea_2~") COLUMN(NAME=~"riga_documento.peso_netto~") COLUMN(NAME=~"bollettine_excel.cliente~") COLUMN(NAME=~"bollettine_excel.num_ordine~") COLUMN(NAME=~"bollettine_excel.metallo~") COLUMN(NAME=~"bollettine_excel.titolo~") COLUMN(NAME=~"ver_giorno_merce_fo.data_spedizione~") COLUMN(NAME=~"ver_giorno_merce_fo.num_bollettina~") COLUMN(NAME=~"ver_giorno_merce_fo.provenienza~") COLUMN(NAME=~"ver_giorno_merce_fo.id_ver_giorno_merce_fo~") COMPUTE(NAME=~"(select first( p.codice) from prof_documento p, documento d, riga_documento r where r.id_documento=d.id_documento and p.id_prof_documento=d.id_prof_documento and provv_imp_subage_2=~~~"riga_documento~~~".~~~"id_riga_documento~~~" and d.id_prof_documento<>187  order by data_documento desc, d.id_documento desc) as c_prof_ultimo~") COLUMN(NAME=~"ver_giorno_merce_fo.fo_des_libera~") COMPUTE(NAME=~"0 as c_scegli~") COLUMN(NAME=~"ver_giorno_merce_fo.id_sog_commerciale~") COLUMN(NAME=~"documento.data_prev_consegna~") COLUMN(NAME=~"ver_giorno_merce_fo.data_ora~") COLUMN(NAME=~"ver_giorno_merce_fo.id_utenti~") COLUMN(NAME=~"bollettine_excel.id_riga_documento~") COLUMN(NAME=~"riga_documento.quantita~") COLUMN(NAME=~"galvanica.lavorazione~") COLUMN(NAME=~"bollettine_excel.galvanica~")    JOIN (LEFT=~"bollettine_excel.cod_barre~"    OP =~"=~"RIGHT=~"ver_giorno_merce_fo.num_bollettina~"    OUTER2 =~"ver_giorno_merce_fo.num_bollettina~" )    JOIN (LEFT=~"riga_documento.id_gruppo_agenti_2~"    OP =~"=~"RIGHT=~"galvanica.id_galvanica~"    OUTER1 =~"riga_documento.id_gruppo_agenti_2~" )    JOIN (LEFT=~"bollettine_excel.id_riga_documento~"    OP =~"=~"RIGHT=~"riga_documento.id_riga_documento~" )    JOIN (LEFT=~"riga_documento.id_documento~"    OP =~"=~"RIGHT=~"documento.id_documento~" )WHERE(    EXP1 =~"~~~"ver_giorno_merce_fo~~~".~~~"data_spedizione~~~"~"   OP =~">=~"    EXP2 =~":data_sped~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"riga_documento~~~".~~~"id_riga_documento~~~"~"   OP =~"not in~"    EXP2 =~"(SELECT r.id_riga_doc_provenienza FROM RIGA_DOCUMENTO r , documento d where d.id_documento=r.id_documento  and (d.id_prof_documento=66 or d.id_prof_documento=114) and r.id_riga_doc_provenienza>0 )~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"ver_giorno_merce_fo~~~".~~~"data_spedizione~~~"~"   OP =~"<=~"    EXP2 =~":a_data_sped~" ) ) ARG(NAME = ~"data_sped~" TYPE = date)  ARG(NAME = ~"a_data_sped~" TYPE = date) " update="ver_giorno_merce_fo" updatewhere=1 updatekeyinplace=yes arguments=(("data_sped", date),("a_data_sped", date)) )
