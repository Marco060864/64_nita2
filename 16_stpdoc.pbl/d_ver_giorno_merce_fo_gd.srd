 column=(type=char(64) updatewhereclause=yes name=bollettine_excel_cod_art_assegnato dbname="bollettine_excel.cod_art_assegnato" )
 column=(type=decimal(4) updatewhereclause=yes name=riga_documento_peso_lordo dbname="riga_documento.peso_lordo" )
 column=(type=decimal(5) updatewhereclause=yes name=riga_documento_provv_imp_carea_2 dbname="riga_documento.provv_imp_carea_2" )
 column=(type=decimal(4) updatewhereclause=yes name=riga_documento_peso_netto dbname="riga_documento.peso_netto" )
 column=(type=char(5) updatewhereclause=yes name=bollettine_excel_cliente dbname="bollettine_excel.cliente" )
