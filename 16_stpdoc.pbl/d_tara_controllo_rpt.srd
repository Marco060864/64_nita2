table(column=(type=long updatewhereclause=yes identity=yes name=documento_id_documento dbname="documento.id_documento" )
 column=(type=decimal(0) updatewhereclause=yes name=documento_num_progressivo dbname="documento.num_progressivo" )
 column=(type=char(16) updatewhereclause=yes name=documento_num_documento dbname="documento.num_documento" )
 column=(type=date updatewhereclause=yes name=documento_data_documento dbname="documento.data_documento" )
 column=(type=long updatewhereclause=yes identity=yes name=riga_documento_id_riga_documento dbname="riga_documento.id_riga_documento" )
 column=(type=decimal(0) updatewhereclause=yes name=riga_documento_num_riga dbname="riga_documento.num_riga" )
 column=(type=char(32766) updatewhereclause=no name=riga_documento_descrizione dbname="riga_documento.descrizione" )
 column=(type=decimal(4) updatewhereclause=yes name=riga_documento_quantita dbname="riga_documento.quantita" )
 column=(type=decimal(4) updatewhereclause=yes name=riga_documento_peso_netto dbname="riga_documento.peso_netto" )
 column=(type=long updatewhereclause=yes name=riga_documento_id_gruppo_agenti_2 dbname="riga_documento.id_gruppo_agenti_2" )
 column=(type=char(2) updatewhereclause=yes name=galvanica_lavorazione dbname="galvanica.lavorazione" )
 column=(type=decimal(4) updatewhereclause=yes name=riga_documento_peso_lordo dbname="riga_documento.peso_lordo" )
 column=(type=decimal(0) updatewhereclause=yes name=num_fat dbname="num_fat" )
 column=(type=char(255) updatewhereclause=yes name=c_des_2 dbname="c_des_2" )
 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"documento~" )  TABLE(NAME=~"riga_documento~" )  TABLE(NAME=~"galvanica~" ) COLUMN(NAME=~"documento.id_documento~") COLUMN(NAME=~"documento.num_progressivo~") COLUMN(NAME=~"documento.num_documento~") COLUMN(NAME=~"documento.data_documento~") COLUMN(NAME=~"riga_documento.id_riga_documento~") COLUMN(NAME=~"riga_documento.num_riga~") COLUMN(NAME=~"riga_documento.descrizione~") COLUMN(NAME=~"riga_documento.quantita~") COLUMN(NAME=~"riga_documento.peso_netto~") COLUMN(NAME=~"riga_documento.id_gruppo_agenti_2~") COLUMN(NAME=~"galvanica.lavorazione~") COLUMN(NAME=~"riga_documento.peso_lordo~") COMPUTE(NAME=~"(select num_progressivo from documento d, riga_documento r where d.id_documento=r.id_documento and  r.id_riga_doc_provenienza=~~~"riga_documento~~~".~~~"id_riga_documento~~~") as num_fat~") COMPUTE(NAME=~"(select des_2 from prezzo where id_unita_confezione=~~~"riga_documento~~~".~~~"id_unita_confezione~~~" and id_variazione=15) as c_des_2~")    JOIN (LEFT=~"riga_documento.id_gruppo_agenti_2~"    OP =~"=~"RIGHT=~"galvanica.id_galvanica~"    OUTER1 =~"riga_documento.id_gruppo_agenti_2~" )    JOIN (LEFT=~"riga_documento.id_documento~"    OP =~"=~"RIGHT=~"documento.id_documento~" )WHERE(    EXP1 =~"~~~"documento~~~".~~~"id_prof_documento~~~"~"   OP =~"=~"    EXP2 =~":id_prof~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"riga_documento~~~".~~~"peso_lordo~~~"~"   OP =~">~"    EXP2 =~"0.1~" ) ) ARG(NAME = ~"id_prof~" TYPE = number) " arguments=(("id_prof", number))  sort="documento_data_documento A documento_num_progressivo A documento_num_documento A riga_documento_num_riga A " )
