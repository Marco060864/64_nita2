 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"articolo~" )  TABLE(NAME=~"documento~" )  TABLE(NAME=~"riga_documento~" ALIAS=~"riga_documento_a~" )  TABLE(NAME=~"sog_commerciale~" )  TABLE(NAME=~"caus_magazzino~" )  TABLE(NAME=~"ord_cli_fornitore~" )  TABLE(NAME=~"riga_documento~" ALIAS=~"riga_documento_b~" )  TABLE(NAME=~"riga_documento~" ALIAS=~"riga_documento_c~" )  TABLE(NAME=~"anagrafica~" ) COLUMN(NAME=~"documento.num_documento~") COLUMN(NAME=~"documento.data_documento~") COLUMN(NAME=~"sog_commerciale.codice~") COLUMN(NAME=~"articolo.codice~") COLUMN(NAME=~"riga_documento_a.quantita~") COLUMN(NAME=~"riga_documento_a.qta_evasa~") COLUMN(NAME=~"caus_magazzino.mp_ord_produzione~") COLUMN(NAME=~"caus_magazzino.mp_ord_clienti~") COLUMN(NAME=~"riga_documento_a.peso_netto_evaso~") COLUMN(NAME=~"riga_documento_a.peso_netto~") COLUMN(NAME=~"documento.id_registro~") COLUMN(NAME=~"documento.id_documento~") COLUMN(NAME=~"riga_documento_c.quantita~") COLUMN(NAME=~"riga_documento_c.peso_netto~") COLUMN(NAME=~"anagrafica.rag_soc_1~") COLUMN(NAME=~"riga_documento_a.id_riga_documento~")    JOIN (LEFT=~"riga_documento_a.id_riga_documento~"    OP =~"=~"RIGHT=~"ord_cli_fornitore.id_riga_ord_cliente~"    OUTER1 =~"riga_documento_a.id_riga_documento~" )    JOIN (LEFT=~"ord_cli_fornitore.id_riga_ord_fornitore~"    OP =~"=~"RIGHT=~"riga_documento_b.id_riga_documento~"    OUTER1 =~"ord_cli_fornitore.id_riga_ord_fornitore~" )    JOIN (LEFT=~"riga_documento_b.id_riga_documento~"    OP =~"=~"RIGHT=~"riga_documento_c.id_riga_doc_provenienza~"    OUTER1 =~"riga_documento_b.id_riga_documento~" )    JOIN (LEFT=~"riga_documento_a.id_documento~"    OP =~"=~"RIGHT=~"documento.id_documento~" )    JOIN (LEFT=~"riga_documento_a.id_articolo~"    OP =~"=~"RIGHT=~"articolo.id_articolo~" )    JOIN (LEFT=~"sog_commerciale.id_sog_commerciale~"    OP =~"=~"RIGHT=~"documento.id_sog_commerciale~" )    JOIN (LEFT=~"caus_magazzino.id_caus_magazzino~"    OP =~"=~"RIGHT=~"riga_documento_a.id_caus_magazzino~" )    JOIN (LEFT=~"anagrafica.id_anagrafica~"    OP =~"=~"RIGHT=~"sog_commerciale.id_anagrafica~" )WHERE(    EXP1 =~"~~~"caus_magazzino~~~".~~~"mp_ord_clienti~~~"~"   OP =~"=~"    EXP2 =~"'+'~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"anagrafica~~~".~~~"rag_soc_1~~~"~"   OP =~"<=~"    EXP2 =~":a_sog~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"documento~~~".~~~"data_documento~~~"~"   OP =~">=~"    EXP2 =~":da_data~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"documento~~~".~~~"data_documento~~~"~"   OP =~"<=~"    EXP2 =~":a_data~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"anagrafica~~~".~~~"rag_soc_1~~~"~"   OP =~">=~"    EXP2 =~":da_sog~" ) ) ARG(NAME = ~"da_data~" TYPE = date)  ARG(NAME = ~"a_data~" TYPE = date)  ARG(NAME = ~"da_sog~" TYPE = string)  ARG(NAME = ~"a_sog~" TYPE = string)  ARG(NAME = ~"tipo_registro~" TYPE = string)  ARG(NAME = ~"nota~" TYPE = string) " arguments=(("da_data", date),("a_data", date),("da_sog", string),("a_sog", string),("tipo_registro", string),("nota", string))  sort="sog_commerciale_codice A articolo_codice A documento_data_documento A documento_num_documento A " )
