PBSELECT( VERSION(400) TABLE(NAME="orafo_aper_partita" )  TABLE(NAME="orafo_scar_partita" )  TABLE(NAME="documento" ALIAS="documento_a" )  TABLE(NAME="riga_documento" ALIAS="riga_documento_a" )  TABLE(NAME="riga_documento" ALIAS="riga_documento_b" )  TABLE(NAME="documento" ALIAS="documento_b" ) COLUMN(NAME="orafo_aper_partita.id_partita") COLUMN(NAME="orafo_aper_partita.stato") COLUMN(NAME="orafo_aper_partita.val_apertura") COLUMN(NAME="orafo_aper_partita.val_scarico") COLUMN(NAME="orafo_aper_partita.id_titolo") COLUMN(NAME="orafo_scar_partita.val_scarico") COLUMN(NAME="riga_documento_b.id_riga_documento") COLUMN(NAME="documento_b.id_documento") COLUMN(NAME="documento_b.num_progressivo") COLUMN(NAME="documento_b.num_documento") COLUMN(NAME="documento_b.data_documento") COLUMN(NAME="documento_a.id_documento") COLUMN(NAME="documento_a.num_progressivo") COLUMN(NAME="documento_a.num_documento") COLUMN(NAME="documento_a.data_documento") COLUMN(NAME="riga_documento_a.num_riga") COLUMN(NAME="riga_documento_a.peso_netto") COLUMN(NAME="riga_documento_a.calo") COLUMN(NAME="riga_documento_a.fino") COLUMN(NAME="riga_documento_b.peso_netto") COLUMN(NAME="riga_documento_b.calo") COLUMN(NAME="riga_documento_b.fino")    JOIN (LEFT="orafo_scar_partita.id_partita"    OP ="="RIGHT="orafo_aper_partita.id_partita" )    JOIN (LEFT="documento_a.id_documento"    OP ="="RIGHT="orafo_aper_partita.id_documento" )    JOIN (LEFT="riga_documento_b.id_documento"    OP ="="RIGHT="documento_b.id_documento" )    JOIN (LEFT="documento_a.id_documento"    OP ="="RIGHT="riga_documento_a.id_documento" )    JOIN (LEFT="orafo_scar_partita.id_riga_documento"    OP ="="RIGHT="riga_documento_b.id_riga_documento" )WHERE(    EXP1 ="~"documento_a~".~"data_documento~""   OP =">="    EXP2 ="" ) ) ARG(NAME = "da_data" TYPE = date)  ARG(NAME = "a_data" TYPE = date) 