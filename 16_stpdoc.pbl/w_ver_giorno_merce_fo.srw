type dw_1 from w_semplice_gd`dw_1 within w_ver_giorno_merce_fo
boolean visible = false
integer x = 46
integer y = 312
integer width = 5495
string dataobject = "d_ver_giorno_merce_fo_gd"
end type

event dw_1::itemchanged;call super::itemchanged;integer i
date ldt_data_sped
datetime ldt_data_ora
long ll_id_utente,ll_test,ll_id_riga_bol

if string(dwo.name) = "c_scegli" then
	if data='1' and row=1 then
		if messagebox("Attenzione!", "Vuoi selezionare tutte le righe?", stopsign!, yesno! )=1 then
			for i= 1 to rowcount()
				setitem(i, "c_scegli", 1)
			next
		end if
	elseif data<>'1' and row=1 then
		if messagebox("Attenzione!", "Vuoi DEselezionare tutte le righe?", stopsign!, yesno! )=1 then
			for i= 1 to rowcount()
				setitem(i, "c_scegli", 0)
			next
		end if
	end if
elseif string(dwo.name) = "bollettine_excel_cod_barre" then
	ll_test=0 //
	ldt_data_sped= dw_2.getitemdate(1, "dt_data")
	//20250422 controllo eventuale inserimento doppio (gia esistente) (modificato in righe "//") //SERENA: se metto una bol già esistente mi butta fuori (ora controllo l'errore)
	select id_ver_giorno_merce_fo into :ll_test from  dba.ver_giorno_merce_fo where num_bollettina=:data and data_spedizione=:ldt_data_sped ;  //
	if ll_test>0 then  //
		messagebox("Attenzione!", "bol.: "+data+" ESISTE già in ver_giorno_merce_fo!") //
		dw_1.post setitem(row, "bollettine_excel_cod_barre", "")
		dw_1.post setcolumn("bollettine_excel_cod_barre")
	else //
		//controllo se la bollettina NON sia stata già spedita
		ll_test=0
		select id_riga_documento into :ll_id_riga_bol from documento d, riga_documento r 
		where r.id_documento=d.id_documento and d.num_documento like '%'+:data ;
		SELECT r.id_riga_documento into :ll_test FROM RIGA_DOCUMENTO r , documento d where d.id_documento=r.id_documento  
		and d.id_prof_documento=66 and r.id_riga_doc_provenienza>0 and id_riga_doc_provenienza=:ll_id_riga_bol;
		if ll_test>0 then
			messagebox("Attenzione!", "bol.: "+data+" già in RBOL!") //
			dw_1.post setitem(row, "bollettine_excel_cod_barre", "")
			dw_1.post setcolumn("bollettine_excel_cod_barre")
			//fine controllo 20250422
		else
			dw_1.setitem(row, "provenienza", 0)
			dw_1.setitem(row, "ver_giorno_merce_fo_data_spedizione", ldt_data_sped)
			dw_1.setitem(row, "num_bollettina", data)
			ll_id_utente=u_freddie.s_utenti.i_idutente
			dw_1.setitem(row, "id_utenti", ll_id_utente)
			ldt_data_ora=datetime(today(), now())
			dw_1.setitem(row, "ver_giorno_merce_fo_data_ora", ldt_data_ora)
			dw_1.trigger event ue_update()
			DW_1.RESET()
			DW_1.RETRIEVE(ldt_data_sped)
		end if
	end if
elseif string(dwo.name) = "ver_giorno_merce_fo_fo_des_libera" then
	post event ue_update()
end if
end event

event dw_1::retrieveend;call super::retrieveend;long ll_id_sog

//if rowcount> 0 then
//	ll_id_sog=dw_1.getitemnumber(1, "id_sog_commerciale")
//	dw_2.setitem(1, "id_sog", ll_id_sog)
//end if
end event

event dw_1::retrievestart;call super::retrievestart;return 2
end event

