cbx_4 cbx_4
cb_34 cb_34
cb_ins_gf cb_ins_gf
cb_15 cb_15
cb_14 cb_14
cb_13 cb_13
cb_12 cb_12
cb_6 cb_6
sle_gf sle_gf
cb_4 cb_4
dw_6 dw_6
end type

on tabpage_1.create
this.cb_cnac_gf=create cb_cnac_gf
this.cbx_4=create cbx_4
this.cb_34=create cb_34
this.cb_ins_gf=create cb_ins_gf
this.cb_15=create cb_15
this.cb_14=create cb_14
this.cb_13=create cb_13
this.cb_12=create cb_12
this.cb_6=create cb_6
this.sle_gf=create sle_gf
this.cb_4=create cb_4
this.dw_6=create dw_6
this.Control[]={this.cb_cnac_gf,&
this.cbx_4,&
this.cb_34,&
this.cb_ins_gf,&
this.cb_15,&
this.cb_14,&
this.cb_13,&
this.cb_12,&
this.cb_6,&
this.sle_gf,&
this.cb_4,&
this.dw_6}
end on

on tabpage_1.destroy
destroy(this.cb_cnac_gf)
destroy(this.cbx_4)
destroy(this.cb_34)
destroy(this.cb_ins_gf)
destroy(this.cb_15)
destroy(this.cb_14)
destroy(this.cb_13)
destroy(this.cb_12)
destroy(this.cb_6)
destroy(this.sle_gf)
destroy(this.cb_4)
destroy(this.dw_6)
end on

