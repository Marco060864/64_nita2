event ue_postopen;call super::ue_postopen;if tab_1.tabpage_5.dw_11.rowcount()>0 then
	tab_1.SelectedTab = 5
end if
end event

type cb_stampa from w_semplice_gd`cb_stampa within w_ver_giorno_merce_fo
integer x = 5211
integer y = 136
end type

event cb_stampa::clicked;string ls_data, ls_num_doc
integer li_ret

dw_5.reset()
li_ret=tab_1.tabpage_1.dw_6.rowscopy(1,tab_1.tabpage_1.dw_6.rowcount(), primary!, dw_5, dw_5.rowcount()+1, primary!)
li_ret=tab_1.tabpage_2.dw_7.rowscopy(1,tab_1.tabpage_2.dw_7.rowcount(), primary!, dw_5, dw_5.rowcount()+1, primary!)
li_ret=tab_1.tabpage_3.dw_9.rowscopy(1,tab_1.tabpage_3.dw_9.rowcount(), primary!, dw_5, dw_5.rowcount()+1, primary!)
li_ret=tab_1.tabpage_4.dw_10.rowscopy(1,tab_1.tabpage_4.dw_10.rowcount(), primary!, dw_5, dw_5.rowcount()+1, primary!)
li_ret=tab_1.tabpage_5.dw_11.rowscopy(1,tab_1.tabpage_5.dw_11.rowcount(), primary!, dw_5, dw_5.rowcount()+1, primary!)

ls_num_doc=parent.classname()
		
ls_data=string(today(), "dd-mm-yy")
ls_num_doc+="_"+ls_data+"TUTTI"
	
dw_5.Modify("DataWindow.Print.DocumentName='"+ls_num_doc+"'")

dw_5.modify("ver_giorno_merce_fo_data_ora.visible=0")
dw_5.modify("id_utenti.visible=0")
