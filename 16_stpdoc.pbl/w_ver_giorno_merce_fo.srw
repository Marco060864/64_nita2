forward prototypes
public subroutine wf_invia_ver_spedizione (udw_001 adw_scelti)
public subroutine wf_ins_des_lib_in_selezionati (string as_des_lib, integer ai_tabpage)
public subroutine wf_carica_dw (string as_data)
end prototypes

public subroutine wf_invia_ver_spedizione (udw_001 adw_scelti);integer i, li_test
string ls_num_bol,ls_des,ls_cliente, ls_rag_soc
date ls_data_richiesta
datetime ldt_data
long ll_riga_trovata, ll_riga_ins_2, ll_id_sog, ll_test
string ls_tipo
//
for i=1 to adw_scelti.rowcount()
	li_test=0
	li_test=adw_scelti.getitemnumber(i, "c_scegli")
	if li_test=1 then
		//
		//adw_scelti.reset()
			ls_tipo='A'
			ls_num_bol=adw_scelti.getitemstring(i, "bollettine_excel_cod_barre")
			if ls_num_bol>"0" then
				ldt_data=adw_scelti.getitemdatetime(i, "bollettine_excel_data")
				//ldt_data_urge=adw_scelti.getitemdate(i, "data_urgenza")
				ls_cliente=adw_scelti.getitemstring(i, "bollettine_excel_cliente")
				//20250227: occorre riportare su sped_bollettina anche descrizione e 8 caratteri del fornitore se c'è
				ls_des=adw_scelti.getitemstring(i, "ver_giorno_merce_fo_fo_des_libera")
				ll_id_sog=adw_scelti.getitemnumber(i, "id_sog_commerciale")
				ll_test=0
				select id_ver_sped_bollettina into :ll_test from dba.ver_sped_bollettina where num_bollettina=:ls_num_bol;
				if ll_test>0 then
					if messagebox("Attenzione!", "La bollettina n. "+ls_num_bol+" è già stata inviata al fornitore! Vuoi inviarla un'altra volta?", stopsign!, yesno!)=1 then
						ll_riga_ins_2=dw_4.insertrow(0)
						ls_tipo='B' //20250428 metto la b su tipo
					else
						continue  //20250428 salta questa e continua con le altre
					end if
				//ll_riga_trovata=dw_4.find("num_bollettina='"+ls_num_bol+"'", 1, 9999999)
				//if ll_riga_trovata>0 then //20250428 si cambia: l'indice NON è più num_bollettina, ma num_bollettina e Tipo!!!!
					//ll_riga_ins_2=ll_riga_trovata
//					if messagebox("Attenzione!", "La bollettina n. "+ls_num_bol+" è già stata inviata al fornitore! Vuoi inviarla un'altra volta?", stopsign!, yesno!)=1 then
//						ll_riga_ins_2=dw_4.insertrow(0)
//						dw_4.setitem(ll_riga_ins_2, "tipo", "B") //20250428 metto la b su tipo
//					else
//						continue  //20250428 salta questa e continua con le altre
//					end if
				else
					ll_riga_ins_2=dw_4.insertrow(0)
				end if 
				dw_4.setitem(ll_riga_ins_2, "num_bollettina", ls_num_bol)
				//20250428 metto tipo
				dw_4.setitem(ll_riga_ins_2, "tipo", ls_tipo)
				//select data_scadenza into :ldt_data_scadenza_bol from dba.bollettine_excel where cod_barre=:ls_num_bol; //20231122 no! questa è la data del giorno in cui si lavora la bollettina/e
				dw_4.setitem(ll_riga_ins_2, "data_spedizione", today() )
				dw_4.setitem(ll_riga_ins_2, "descrizione", ls_des )
				dw_4.setitem(ll_riga_ins_2, "data_richiesta", date(ldt_data) )
				adw_scelti.setitem(i, "provenienza", 2) 
				dw_4.setitem(ll_riga_ins_2, "cliente", ls_cliente) 
				
				//20250227: occorre riportare su sped_bollettina anche descrizione e 8 caratteri del fornitore se c'è
				if ll_id_sog>0 then
					select rag_soc_1 into :ls_rag_soc from dba.sog_commerciale_gen where id_sog_commerciale=:ll_id_sog;
					if isnull(ls_des) then ls_des=""
					ls_des+=" - "+upper(left(ls_rag_soc, 8))
				end if
				dw_4.setitem(ll_riga_ins_2, "descrizione", ls_des )
				dw_4.update()
				adw_scelti.trigger event ue_update()
				adw_scelti.setitem(i, "c_scegli", 0)  //20250625 Serena: dopo invio deve togliere la spunta c_scegli
//				
			
			end if 
	
		//
	end if
next
end subroutine

public subroutine wf_ins_des_lib_in_selezionati (string as_des_lib, integer ai_tabpage);integer i, li_scegli

if ai_tabpage=1 or ai_tabpage=100 then
	tab_1.tabpage_1.dw_6.accepttext()
	for i= 1 to tab_1.tabpage_1.dw_6.rowcount()
		li_scegli=tab_1.tabpage_1.dw_6.getitemnumber(i, "c_scegli")
		if li_scegli=1 then 	tab_1.tabpage_1.dw_6.setitem(i, "ver_giorno_merce_fo_fo_des_libera", as_des_lib)
		tab_1.tabpage_1.dw_6.setitem(i, "c_scegli", 0)
	next
end if
if ai_tabpage=2 or ai_tabpage=100 then
	tab_1.tabpage_2.dw_7.accepttext()
	for i= 1 to tab_1.tabpage_2.dw_7.rowcount()
		li_scegli=tab_1.tabpage_2.dw_7.getitemnumber(i, "c_scegli")
		if li_scegli=1 then 	tab_1.tabpage_2.dw_7.setitem(i, "ver_giorno_merce_fo_fo_des_libera", as_des_lib)
		tab_1.tabpage_2.dw_7.setitem(i, "c_scegli", 0)
	next
end if
if ai_tabpage=3 or ai_tabpage=100 then
	tab_1.tabpage_3.dw_9.accepttext()
	for i= 1 to tab_1.tabpage_3.dw_9.rowcount()
		li_scegli=tab_1.tabpage_3.dw_9.getitemnumber(i, "c_scegli")
		if li_scegli=1 then 	tab_1.tabpage_3.dw_9.setitem(i, "ver_giorno_merce_fo_fo_des_libera", as_des_lib)
		tab_1.tabpage_3.dw_9.setitem(i, "c_scegli", 0)
	next
end if
if ai_tabpage=4 or ai_tabpage=100 then
	tab_1.tabpage_4.dw_10.accepttext()
	for i= 1 to tab_1.tabpage_4.dw_10.rowcount()
		li_scegli=tab_1.tabpage_4.dw_10.getitemnumber(i, "c_scegli")
		if li_scegli=1 then 	tab_1.tabpage_4.dw_10.setitem(i, "ver_giorno_merce_fo_fo_des_libera", as_des_lib)
		tab_1.tabpage_4.dw_10.setitem(i, "c_scegli", 0)
	next
end if
if ai_tabpage=5 or ai_tabpage=100 then
	tab_1.tabpage_5.dw_11.accepttext()
	for i= 1 to tab_1.tabpage_5.dw_11.rowcount()
		li_scegli=tab_1.tabpage_5.dw_11.getitemnumber(i, "c_scegli")
		if li_scegli=1 then 	tab_1.tabpage_5.dw_11.setitem(i, "ver_giorno_merce_fo_fo_des_libera", as_des_lib)
		tab_1.tabpage_5.dw_11.setitem(i, "c_scegli", 0)
	next
end if
end subroutine

public subroutine wf_carica_dw (string as_data);date ldt_a_data,ldt_data
	
if date(as_data)=date("01/01/01") then
	ldt_a_data=today()
	ldt_data=relativedate(ldt_a_data, -30)
else
	ldt_data=date(as_data)
	ldt_a_data=date(as_data)
end if
tab_1.tabpage_1.dw_6.reset()
tab_1.tabpage_2.dw_7.reset()  //20250618 aggiutno tabpage e dw nuove
tab_1.tabpage_3.dw_9.reset()
tab_1.tabpage_4.dw_10.reset()
tab_1.tabpage_5.dw_11.reset()
tab_1.tabpage_1.dw_6.retrieve(ldt_data,ldt_a_data)
tab_1.tabpage_2.dw_7.retrieve(ldt_data, ldt_a_data)
tab_1.tabpage_3.dw_9.retrieve(ldt_data,ldt_a_data)
tab_1.tabpage_4.dw_10.retrieve(ldt_data,ldt_a_data)
tab_1.tabpage_5.dw_11.retrieve(ldt_data,ldt_a_data)
	


end subroutine

on w_ver_giorno_merce_fo.create
int iCurrent
call super::create
this.cb_da_excel=create cb_da_excel
this.dw_2=create dw_2
this.cb_aggiorna=create cb_aggiorna
this.cb_lista=create cb_lista
this.cb_sped=create cb_sped
this.cb_assegna_sog=create cb_assegna_sog
this.cb_filtra=create cb_filtra
this.st_1=create st_1
this.st_2=create st_2
this.st_3=create st_3
this.st_4=create st_4
this.cb_st_selezionati=create cb_st_selezionati
this.dw_5=create dw_5
this.tab_1=create tab_1
this.dw_3=create dw_3
this.dw_8=create dw_8
this.dw_4=create dw_4
iCurrent=UpperBound(this.Control)
this.Control[iCurrent+1]=this.cb_da_excel
this.Control[iCurrent+2]=this.dw_2
this.Control[iCurrent+3]=this.cb_aggiorna
this.Control[iCurrent+4]=this.cb_lista
this.Control[iCurrent+5]=this.cb_sped
this.Control[iCurrent+6]=this.cb_assegna_sog
this.Control[iCurrent+7]=this.cb_filtra
this.Control[iCurrent+8]=this.st_1
this.Control[iCurrent+9]=this.st_2
this.Control[iCurrent+10]=this.st_3
this.Control[iCurrent+11]=this.st_4
this.Control[iCurrent+12]=this.cb_st_selezionati
this.Control[iCurrent+13]=this.dw_5
this.Control[iCurrent+14]=this.tab_1
this.Control[iCurrent+15]=this.dw_3
this.Control[iCurrent+16]=this.dw_8
this.Control[iCurrent+17]=this.dw_4
end on

on w_ver_giorno_merce_fo.destroy
call super::destroy
destroy(this.cb_da_excel)
destroy(this.dw_2)
destroy(this.cb_aggiorna)
destroy(this.cb_lista)
destroy(this.cb_sped)
destroy(this.cb_assegna_sog)
destroy(this.cb_filtra)
destroy(this.st_1)
destroy(this.st_2)
destroy(this.st_3)
destroy(this.st_4)
destroy(this.cb_st_selezionati)
destroy(this.dw_5)
destroy(this.tab_1)
destroy(this.dw_3)
destroy(this.dw_8)
destroy(this.dw_4)
end on

event open;tab_1.tabpage_1.dw_6.settransobject(sqlca)

tab_1.tabpage_2.dw_7.settransobject(sqlca)

tab_1.tabpage_3.dw_9.settransobject(sqlca)

tab_1.tabpage_4.dw_10.settransobject(sqlca)
tab_1.tabpage_5.dw_11.settransobject(sqlca)

tab_1.tabpage_1.dw_6.retrieve(today(), today())
tab_1.tabpage_2.dw_7.retrieve(today(), today())
tab_1.tabpage_3.dw_9.retrieve(today(), today())
tab_1.tabpage_4.dw_10.retrieve(today(), today())

tab_1.tabpage_5.dw_11.retrieve(today(), today())


dw_2.insertrow(1)
dw_2.setitem(1, "dt_data", today())

dw_4.settransobject(sqlca)
dw_5.settransobject(sqlca)
datawindowchild dwc_fo
dw_2.getchild("id_sog", dwc_fo)
CONNECT USING SQLCA;
dwc_fo.settransobject(sqlca)
dwc_fo.retrieve()


post event ue_postopen()
end event

