type cb_da_excel from commandbutton within w_ver_giorno_merce_fo
boolean visible = false
integer x = 1312
integer width = 261
integer height = 88
integer taborder = 80
boolean bringtotop = true
integer textsize = -8
integer weight = 700
fontcharset fontcharset = ansi!
fontpitch fontpitch = variable!
fontfamily fontfamily = swiss!
string facename = "Arial"
string text = "CSV"
end type

event clicked;string ls_path, ls_file, ls_bol
integer i
date ldt_data, ldt_data_sped
long ll_null, ll_test, ll_id_utente, ll_id_sog

setnull(ll_null)
getfileopenname("Cerca report", ls_path, ls_file, "Excel, *.csv", "csv" , "C:\nita\exp_doc") //20230519 xls diventa xlsx .... proviamo
if  not(trim(ls_file)="" or isnull(ls_file)) then
	//tab_1.tabpage_1.dw_6.reset()
	tab_1.tabpage_2.dw_7.reset()
	//tab_1.tabpage_3.dw_9.reset()
	//tab_1.tabpage_4.dw_10.reset()
	dw_3.importfile(Text!,ls_file)
	for i= 2 to dw_3.rowcount()
		ls_bol=dw_3.getitemstring(i, "bollettina")
		ll_test=0
		ldt_data_sped= dw_2.getitemdate(1, "dt_data")
		select id_ver_giorno_merce_fo into :ll_test from  dba.ver_giorno_merce_fo where num_bollettina=:ls_bol and data_spedizione=:ldt_data_sped ;
		if ll_test>0 then
			messagebox("Attenzione!", "bol.: "+ls_bol+" ESISTE già in ver_giorno_merce_fo!")
			continue
		end if
		ll_id_utente=u_freddie.s_utenti.i_idutente
		ll_id_sog=  2026    //20250620 Per ora c'è solo Munna 
		insert into dba.ver_giorno_merce_fo (id_ver_giorno_merce_fo, num_bollettina, data_spedizione, provenienza, id_utenti, id_sog_commerciale)
		values (:ll_null, :ls_bol, :ldt_data_sped, 0, :ll_id_utente, :ll_id_sog);
		if sqlca.sqlNrows>0 then
			commit;
		else
			rollback;
			messagebox("Attenzione!", "bol.: "+ls_bol+" NON inserita in ver_giorno_merce_fo!")
			//return
		end if
	next
	//tab_1.tabpage_1.dw_6.post retrieve(ldt_data_sped)
	tab_1.tabpage_2.dw_7.post retrieve(ldt_data_sped)
	//tab_1.tabpage_3.dw_9.post retrieve(ldt_data_sped)
	//tab_1.tabpage_4.dw_10.post retrieve(ldt_data_sped)
end if	 

end event

