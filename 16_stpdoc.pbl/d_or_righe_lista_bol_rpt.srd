 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"riga_documento~" ALIAS=~"riga_documento_a~" )  TABLE(NAME=~"articolo~" )  TABLE(NAME=~"riga_documento~" ALIAS=~"riga_documento_b~" )  TABLE(NAME=~"documento~" ) COLUMN(NAME=~"riga_documento_a.id_riga_documento~") COLUMN(NAME=~"riga_documento_a.id_documento~") COLUMN(NAME=~"riga_documento_a.id_unita_confezione~") COLUMN(NAME=~"riga_documento_a.num_riga~") COLUMN(NAME=~"riga_documento_a.id_articolo~") COLUMN(NAME=~"riga_documento_a.descrizione~") COLUMN(NAME=~"riga_documento_a.quantita~") COLUMN(NAME=~"riga_documento_a.prezzo~") COLUMN(NAME=~"riga_documento_a.peso_netto~") COLUMN(NAME=~"riga_documento_a.tot_riga_val_az~") COLUMN(NAME=~"riga_documento_a.coef_calo~") COLUMN(NAME=~"riga_documento_a.calo~") COLUMN(NAME=~"riga_documento_a.fino~") COLUMN(NAME=~"riga_documento_a.prezzo_metallo~") COLUMN(NAME=~"riga_documento_a.prezzo_manifattura~") COLUMN(NAME=~"riga_documento_a.prezzo_complessivo~") COLUMN(NAME=~"articolo.codice~") COLUMN(NAME=~"documento.num_progressivo~") COLUMN(NAME=~"documento.num_documento~") COLUMN(NAME=~"documento.data_documento~")    JOIN (LEFT=~"documento.id_documento~"    OP =~"=~"RIGHT=~"riga_documento_b.id_documento~"    OUTER2 =~"riga_documento_b.id_documento~" )    JOIN (LEFT=~"riga_documento_a.id_riga_doc_provenienza~"    OP =~"=~"RIGHT=~"riga_documento_b.id_riga_documento~"    OUTER1 =~"riga_documento_a.id_riga_doc_provenienza~" )   JOIN (LEFT=~"articolo.id_articolo~"    OP =~"=~"RIGHT=~"riga_documento_a.id_articolo~" ) WHERE(    EXP1 =~"~~~"riga_documento_a~~~".~~~"id_documento~~~"~"   OP =~"=~"    EXP2 =~":id_doc~" ) ) ARG(NAME = ~"id_doc~" TYPE = number) " arguments=(("id_doc", number))  sort="num_riga A " )
