release 6;
datawindow(units=0 timer_interval=0 color=16777215 processing=0 print.documentname="" print.orientation = 0 print.margin.left = 110 print.margin.right = 110 print.margin.top = 96 print.margin.bottom = 96 print.paper.source = 0 print.paper.size = 0 print.prompt=no print.buttons=no print.preview.buttons=no )
header(height=120 color="536870912" )
summary(height=0 color="536870912" )
footer(height=0 color="536870912" )
detail(height=0 color="536870912" )
table(column=(type=char(16) updatewhereclause=yes name=documento_num_documento dbname="documento.num_documento" )
 column=(type=date updatewhereclause=yes name=documento_data_documento dbname="documento.data_documento" )
 column=(type=char(8) updatewhereclause=yes name=sog_commerciale_codice dbname="sog_commerciale.codice" )
 column=(type=char(32) updatewhereclause=yes name=articolo_codice dbname="articolo.codice" )
 column=(type=decimal(4) updatewhereclause=yes name=riga_documento_quantita dbname="riga_documento.quantita" )
 column=(type=decimal(4) updatewhereclause=yes name=riga_documento_qta_evasa dbname="riga_documento.qta_evasa" )
 column=(type=char(1) updatewhereclause=yes name=caus_magazzino_mp_ord_produzione dbname="caus_magazzino.mp_ord_produzione" )
 column=(type=char(1) updatewhereclause=yes name=caus_magazzino_mp_ord_clienti dbname="caus_magazzino.mp_ord_clienti" )
 column=(type=decimal(4) updatewhereclause=yes name=riga_documento_peso_netto_evaso dbname="riga_documento.peso_netto_evaso" )
 column=(type=decimal(4) updatewhereclause=yes name=riga_documento_peso_netto dbname="riga_documento.peso_netto" )
 retrieve="  SELECT ~"documento~".~"num_documento~",   
         ~"documento~".~"data_documento~",   
         ~"sog_commerciale~".~"codice~",   
         ~"articolo~".~"codice~",   
         ~"riga_documento_a~".~"quantita~",   
         ~"riga_documento_a~".~"qta_evasa~",   
         ~"caus_magazzino~".~"mp_ord_produzione~",   
         ~"caus_magazzino~".~"mp_ord_clienti~",   
         ~"riga_documento_a~".~"peso_netto_evaso~",   
         ~"riga_documento_a~".~"peso_netto~"  
    FROM ~"articolo~",   
         ~"documento~",   
         ~"riga_documento~" ~"riga_documento_a~",   
         ~"sog_commerciale~",   
         ~"caus_magazzino~"  
   WHERE ( ~"riga_documento_a~".~"id_documento~" = ~"documento~".~"id_documento~" ) and  
         ( ~"riga_documento_a~".~"id_articolo~" = ~"articolo~".~"id_articolo~" ) and  
         ( ~"sog_commerciale~".~"id_sog_commerciale~" = ~"documento~".~"id_sog_commerciale~" ) and  
         ( ~"caus_magazzino~".~"id_caus_magazzino~" = ~"riga_documento_a~".~"id_caus_magazzino~" ) and  
         (~"caus_magazzino~".~"mp_ord_clienti~" = '+' OR  
         ~"caus_magazzino~".~"mp_ord_produzione~" = '+' OR  
         ~"caus_magazzino~".~"mp_ord_produzione~" = '-') AND  
         ~"sog_commerciale~".~"codice~" <= :a_sog AND  
         ~"documento~".~"data_documento~" >= :da_data AND  
         ~"documento~".~"data_documento~" <= :a_data AND  
         ~"sog_commerciale~".~"codice~" >= :da_sog    
" arguments=(("da_data", date),("a_data", date),("da_sog", string),("a_sog", string),("tipo_registro", string),("nota", string))  sort="sog_commerciale_codice A articolo_codice A " )
group(level=1 header.height=0 trailer.height=80 by=("sog_commerciale_codice" ) header.color="536870912" trailer.color="536870912" )
group(level=2 header.height=0 trailer.height=80 by=("sog_commerciale_codice" , "articolo_codice" ) header.color="536870912" trailer.color="536870912" )
