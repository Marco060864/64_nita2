table(column=(type=char(16) updatewhereclause=yes name=documento_num_aper dbname="documento.num_aper" dbalias="documento_a.num_aper" )
 column=(type=date updatewhereclause=yes name=documento_data_aper dbname="documento.data_aper" dbalias="documento_a.data_aper" )
 column=(type=long updatewhereclause=yes identity=yes name=orafo_aper_partita_id_partita dbname="orafo_aper_partita.id_partita" dbalias=".id_partita" )
 column=(type=decimal(4) updatewhereclause=yes name=val_apertura dbname="orafo_aper_partita.val_apertura" dbalias=".val_apertura" )
 column=(type=decimal(4) updatewhereclause=yes name=val_scarico dbname="orafo_scar_partita.val_scarico" dbalias=".val_scarico" )
 column=(type=long updatewhereclause=yes identity=yes name=articolo_id_articolo dbname="articolo.id_articolo" dbalias=".id_articolo" )
 column=(type=long updatewhereclause=yes name=articolo_id_titolo dbname="articolo.id_titolo" dbalias=".id_titolo" )
 column=(type=decimal(0) updatewhereclause=yes name=riga_documento_num_riga dbname="riga_documento.num_riga" dbalias=".num_riga" )
 column=(type=decimal(4) updatewhereclause=yes name=riga_documento_peso_netto dbname="riga_documento.peso_netto" dbalias=".peso_netto" )
 column=(type=decimal(4) updatewhereclause=yes name=riga_documento_calo dbname="riga_documento.calo" dbalias=".calo" )
 column=(type=decimal(4) updatewhereclause=yes name=riga_documento_fino dbname="riga_documento.fino" dbalias=".fino" )
 column=(type=char(16) updatewhereclause=yes name=documento_num_scar dbname="documento.num_scar" dbalias="documento_b.num_scar" )
 column=(type=date updatewhereclause=yes name=documento_data_scar dbname="documento.data_scar" dbalias="documento_b.data_scar" )
 column=(type=long updatewhereclause=yes identity=yes name=documento_id_doc_scar dbname="documento.id_doc_scar" dbalias="documento_b.id_doc_scar" )
 column=(type=long updatewhereclause=yes identity=yes name=documento_id_doc_aper dbname="documento.id_doc_aper" dbalias="documento_a.id_doc_aper" )
 column=(type=char(2) updatewhereclause=yes name=orafo_metallo_codice dbname="orafo_metallo.codice" dbalias=".codice" )
 column=(type=decimal(2) updatewhereclause=yes name=orafo_titolo_titolo dbname="orafo_titolo.titolo" dbalias=".titolo" )
 column=(type=char(40) updatewhereclause=yes name=c_rag_sociale dbname="c_rag_sociale" )
 column=(type=char(11) updatewhereclause=yes name=c_rtit_riga dbname="c_rtit_riga" )
 retrieve="  SELECT ~"documento_a~".~"num_documento~" as num_aper ,   
         ~"documento_a~".~"data_documento~" as data_aper,   
         ~"orafo_aper_partita~".~"id_partita~",   
         ~"orafo_aper_partita~".~"val_apertura~",   
         ~"orafo_scar_partita~".~"val_scarico~",   
         ~"articolo~".~"id_articolo~",   
         ~"articolo~".~"id_titolo~",   
         ~"riga_documento~".~"num_riga~",   
         ~"riga_documento~".~"peso_netto~",   
         ~"riga_documento~".~"calo~",   
         ~"riga_documento~".~"fino~",   
         ~"documento_b~".~"num_documento~" as num_scar,   
         ~"documento_b~".~"data_documento~"  as data_scar,
		 ~"documento_b~".~"id_documento~" as id_doc_scar,  ~"documento_a~".~"id_documento~" as id_doc_aper,
		~"orafo_metallo~".~"codice~", ~"orafo_titolo~".~"titolo~",  (select rag_soc_1 from sog_commerciale_gen WHERE id_sog_commerciale=documento_a.id_sog_commerciale) AS c_rag_sociale,
		 (select m.codice+string(t.titolo) from orafo_titolo t, orafo_metallo m WHERE m.id_metallo=t.id_metallo and t.id_titolo=~"articolo~".~"id_titolo~") AS c_rtit_riga
    FROM  {oj ~"orafo_aper_partita~" LEFT OUTER JOIN ~"orafo_scar_partita~" ON ~"orafo_aper_partita~".~"id_partita~" = ~"orafo_scar_partita~".~"id_partita~"   },
			 {oj ~"orafo_scar_partita~" LEFT OUTER JOIN ~"riga_documento~" ON  ~"orafo_scar_partita~".~"id_riga_documento~" = ~"riga_documento~".~"id_riga_partita~"  },
			 {oj  ~"documento~" ~"documento_a~" LEFT OUTER JOIN ~"orafo_aper_partita~" ON  ~"documento_a~".~"id_documento~" = ~"orafo_aper_partita~".~"id_documento~"   },
			 {oj	~"riga_documento~" LEFT OUTER JOIN  ~"documento~" ~"documento_b~" ON	~"riga_documento~".~"id_documento~" = ~"documento_b~".~"id_documento~"},
			 {oj	~"riga_documento~" LEFT OUTER JOIN ~"articolo~" ON	   ~"riga_documento~".~"id_articolo~" = ~"articolo~".~"id_articolo~"},
			 {oj	~"articolo~" LEFT OUTER JOIN ~"orafo_titolo~" ON	    ~"articolo~".~"id_titolo~" =  ~"orafo_titolo~".~"id_titolo~"},
 			 {oj	~"orafo_titolo~" LEFT OUTER JOIN ~"orafo_metallo~" ON	     ~"orafo_titolo~".~"id_metallo~" = ~"orafo_metallo~".~"id_metallo~"}

WHERE  ( ~"documento_a~".~"data_documento~">=20240410)
 
    "  sort="c_rag_sociale A orafo_aper_partita_id_partita A documento_id_doc_scar A " )
