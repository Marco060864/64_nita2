table(column=(type=char(32) updatewhereclause=yes name=articolo_codice dbname="articolo.codice" dbalias=".codice" )
 column=(type=long updatewhereclause=yes identity=yes name=riga_documento_id_riga_documento dbname="riga_documento.id_riga_documento" dbalias=".id_riga_documento" )
 column=(type=decimal(0) updatewhereclause=yes name=riga_documento_num_riga dbname="riga_documento.num_riga" dbalias=".num_riga" )
 column=(type=char(32766) updatewhereclause=no name=riga_documento_descrizione dbname="riga_documento.descrizione" dbalias=".descrizione" )
 column=(type=decimal(4) updatewhereclause=yes name=riga_documento_quantita dbname="riga_documento.quantita" dbalias=".quantita" )
 column=(type=decimal(4) updatewhereclause=yes name=riga_documento_qta_evasa dbname="riga_documento.qta_evasa" dbalias=".qta_evasa" )
 column=(type=decimal(4) updatewhereclause=yes name=riga_documento_peso_netto dbname="riga_documento.peso_netto" dbalias=".peso_netto" )
 column=(type=decimal(6) updatewhereclause=yes name=riga_documento_prezzo_manifattura dbname="riga_documento.prezzo_manifattura" dbalias=".prezzo_manifattura" )
 column=(type=decimal(6) updatewhereclause=yes name=riga_documento_prezzo_complessivo dbname="riga_documento.prezzo_complessivo" dbalias=".prezzo_complessivo" )
 column=(type=decimal(4) updatewhereclause=yes name=riga_documento_peso_netto_evaso dbname="riga_documento.peso_netto_evaso" dbalias=".peso_netto_evaso" )
 column=(type=char(16) updatewhereclause=yes name=documento_num_documento dbname="documento.num_documento" dbalias=".num_documento" )
 column=(type=date updatewhereclause=yes name=documento_data_documento dbname="documento.data_documento" dbalias=".data_documento" )
 column=(type=decimal(0) updatewhereclause=yes name=documento_num_progressivo dbname="documento.num_progressivo" dbalias=".num_progressivo" )
 column=(type=decimal(6) updatewhereclause=yes name=tot_riga_val_riga dbname="riga_documento.tot_riga_val_riga" dbalias=".tot_riga_val_riga" )
 column=(type=char(16) updatewhereclause=yes name=c_num_bollettina dbname="c_num_bollettina" )
 column=(type=decimal(6) updatewhereclause=yes name=riga_documento_prezzo_metallo dbname="riga_documento.prezzo_metallo" dbalias=".prezzo_metallo" )
 column=(type=char(8) updatewhereclause=yes name=sog_commerciale_gen_codice dbname="sog_commerciale_gen.codice" dbalias=".codice" )
 column=(type=char(40) updatewhereclause=yes name=sog_commerciale_gen_rag_soc_1 dbname="sog_commerciale_gen.rag_soc_1" dbalias=".rag_soc_1" )
 column=(type=long updatewhereclause=yes name=id_articolo dbname="riga_documento.id_articolo" dbalias=".id_articolo" )
 column=(type=long updatewhereclause=yes identity=yes name=documento_id_documento dbname="documento.id_documento" dbalias=".id_documento" )
 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"articolo~" )  TABLE(NAME=~"documento~" )  TABLE(NAME=~"riga_documento~" )  TABLE(NAME=~"sog_commerciale_gen~" ) COLUMN(NAME=~"articolo.codice~") COLUMN(NAME=~"riga_documento.id_riga_documento~") COLUMN(NAME=~"riga_documento.num_riga~") COLUMN(NAME=~"riga_documento.descrizione~") COLUMN(NAME=~"riga_documento.quantita~") COLUMN(NAME=~"riga_documento.qta_evasa~") COLUMN(NAME=~"riga_documento.peso_netto~") COLUMN(NAME=~"riga_documento.prezzo_manifattura~") COLUMN(NAME=~"riga_documento.prezzo_complessivo~") COLUMN(NAME=~"riga_documento.peso_netto_evaso~") COLUMN(NAME=~"documento.num_documento~") COLUMN(NAME=~"documento.data_documento~") COLUMN(NAME=~"documento.num_progressivo~") COLUMN(NAME=~"riga_documento.tot_riga_val_riga~") COMPUTE(NAME=~"(select num_documento from documento d, riga_documento r where r.id_riga_documento=~~~"riga_documento~~~".~~~"id_riga_doc_provenienza~~~" and id_prof_documento=65and r.id_documento=d.id_documento)as c_num_bollettina~") COLUMN(NAME=~"riga_documento.prezzo_metallo~") COLUMN(NAME=~"sog_commerciale_gen.codice~") COLUMN(NAME=~"sog_commerciale_gen.rag_soc_1~") COLUMN(NAME=~"riga_documento.id_articolo~") COLUMN(NAME=~"documento.id_documento~")    JOIN (LEFT=~"riga_documento.id_documento~"    OP =~"=~"RIGHT=~"documento.id_documento~" )    JOIN (LEFT=~"riga_documento.id_articolo~"    OP =~"=~"RIGHT=~"articolo.id_articolo~" )    JOIN (LEFT=~"documento.id_sog_commerciale~"    OP =~"=~"RIGHT=~"sog_commerciale_gen.id_sog_commerciale~" )WHERE(    EXP1 =~"( ( ~~~"riga_documento~~~".~~~"id_riga_documento~~~"~"   OP =~"not in~"    EXP2 =~"( select id_riga_doc_provenienza from riga_documento where id_riga_doc_provenienza>0 ) )~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"( ~~~"documento~~~".~~~"id_prof_documento~~~"~"   OP =~"=~"    EXP2 =~"66 ) )~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"(~~~"riga_documento~~~".~~~"quantita~~~"~"   OP =~">~"    EXP2 =~"0~"    LOGIC =~"or~" ) WHERE(    EXP1 =~"~~~"riga_documento~~~".~~~"peso_netto~~~"~"   OP =~">~"    EXP2 =~"0)~" ) ) "  sort="documento_data_documento A " )
