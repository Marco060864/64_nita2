+if(c_conta_righe_peso>10, 
if( c_rag_sociale ='KARIZIA SPA'
and ( documento_id_prof_documento =114 or documento_id_prof_documento =150 or documento_id_prof_documento =66 and  orafo_metallo_codice =~"AG~" ),
 if(peso_lordo>0, peso_lordo,0) 
+ if( provv_imp_carea_2 >0,  provv_imp_carea_2 *
c_prezzo_laccio
, 0) 
+if( provv_imp_agente_2 >0,  provv_imp_agente_2 *c_prezzo_filo_rame
,0)
,0),0)

+if(isnull(c_correzione),0,c_correzione)
, 2)
