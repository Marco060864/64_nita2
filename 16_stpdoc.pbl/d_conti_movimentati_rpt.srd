 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"conto~" )  TABLE(NAME=~"mov_contabile~" )  TABLE(NAME=~"reg_pd~" )  TABLE(NAME=~"par_sistema~" )  TABLE(NAME=~"registro~" )  TABLE(NAME=~"sottomastro~" )  TABLE(NAME=~"mastro~" ) COLUMN(NAME=~"conto.id_conto~") COLUMN(NAME=~"conto.codice~") COLUMN(NAME=~"conto.descrizione~") COLUMN(NAME=~"reg_pd.id_reg_pd~") COLUMN(NAME=~"reg_pd.id_prof_registrazione~") COLUMN(NAME=~"mov_contabile.id_mov_contabile~") COLUMN(NAME=~"mov_contabile.numero~") COLUMN(NAME=~"mov_contabile.dare~") COLUMN(NAME=~"mov_contabile.avere~") COLUMN(NAME=~"par_sistema.id_prof_reg_apertura~") COLUMN(NAME=~"registro.id_esercizio~") COLUMN(NAME=~"reg_pd.data_registrazione~") COLUMN(NAME=~"reg_pd.id_valuta~") COLUMN(NAME=~"mastro.tipo~") COLUMN(NAME=~"mastro.codice~") COLUMN(NAME=~"mastro.descrizione~") COMPUTE(NAME=~"cast(0 as decimal(18,4)) as c_saldo_manuale~") COLUMN(NAME=~"reg_pd.num_progressivo~")    JOIN (LEFT=~"reg_pd.id_reg_pd~"    OP =~"=~"RIGHT=~"mov_contabile.id_reg_pd~" )    JOIN (LEFT=~"conto.id_conto~"    OP =~"=~"RIGHT=~"mov_contabile.id_conto~" )    JOIN (LEFT=~"registro.id_registro~"    OP =~"=~"RIGHT=~"reg_pd.id_registro~" )    JOIN (LEFT=~"sottomastro.id_sottomastro~"    OP =~"=~"RIGHT=~"conto.id_sottomastro~" )    JOIN (LEFT=~"mastro.id_mastro~"    OP =~"=~"RIGHT=~"sottomastro.id_mastro~" )WHERE(    EXP1 =~"~~~"reg_pd~~~".~~~"data_documento~~~"~"   OP =~"<=~"    EXP2 =~":a_data~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"reg_pd~~~".~~~"data_documento~~~"~"   OP =~">=~"    EXP2 =~":da_data~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"reg_pd~~~".~~~"id_prof_registrazione~~~"~"   OP =~"<>~"    EXP2 =~"~~~"par_sistema~~~".~~~"id_prof_reg_chiusura~~~"~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"reg_pd~~~".~~~"id_prof_registrazione~~~"~"   OP =~"<>~"    EXP2 =~"~~~"par_sistema~~~".~~~"id_prof_reg_apertura~~~"~" ) ) ARG(NAME = ~"da_data~" TYPE = date)  ARG(NAME = ~"a_data~" TYPE = date)  ARG(NAME = ~"as_filtro~" TYPE = string) " arguments=(("da_data", date),("a_data", date),("as_filtro", string))  sort="conto_codice A " )
