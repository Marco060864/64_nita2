table(column=(type=char(8) updatewhereclause=yes name=caus_magazzino_codice dbname="caus_magazzino.codice" dbalias=".codice" )
 column=(type=decimal(4) updatewhereclause=yes name=c_peso_movimentato dbname="c_peso_movimentato" )
 column=(type=long updatewhereclause=yes name=c_num_righe dbname="c_num_righe" )
 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"caus_magazzino~" )  TABLE(NAME=~"riga_documento~" )  TABLE(NAME=~"documento~" )  TABLE(NAME=~"articolo~" )  TABLE(NAME=~"orafo_titolo~" )  TABLE(NAME=~"orafo_metallo~" )  TABLE(NAME=~"sog_commerciale~" ) COLUMN(NAME=~"caus_magazzino.codice~") COMPUTE(NAME=~"sum(~~~"riga_documento~~~".~~~"peso_netto~~~") as c_peso_movimentato~") COMPUTE(NAME=~"count(ID_RIGA_DOCUMENTO) as c_num_righe~")    JOIN (LEFT=~"riga_documento.id_caus_magazzino~"    OP =~"=~"RIGHT=~"caus_magazzino.id_caus_magazzino~" )    JOIN (LEFT=~"documento.id_documento~"    OP =~"=~"RIGHT=~"riga_documento.id_documento~" )    JOIN (LEFT=~"orafo_titolo.id_titolo~"    OP =~"=~"RIGHT=~"articolo.id_titolo~" )    JOIN (LEFT=~"riga_documento.id_articolo~"    OP =~"=~"RIGHT=~"articolo.id_articolo~" )    JOIN (LEFT=~"orafo_metallo.id_metallo~"    OP =~"=~"RIGHT=~"orafo_titolo.id_metallo~" )    JOIN (LEFT=~"documento.id_sog_commerciale~"    OP =~"=~"RIGHT=~"sog_commerciale.id_sog_commerciale~" ) GROUP(NAME=~"caus_magazzino.codice~")) " )
