 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"anagrafica~" )  TABLE(NAME=~"sog_commerciale~" )  TABLE(NAME=~"cat_zona~" )  TABLE(NAME=~"documento~" )  TABLE(NAME=~"riga_documento~" )  TABLE(NAME=~"articolo~" )  TABLE(NAME=~"orafo_titolo~" )  TABLE(NAME=~"registro~" ) COLUMN(NAME=~"cat_zona.codice~") COLUMN(NAME=~"anagrafica.rag_soc_1~") COLUMN(NAME=~"documento.num_documento~") COLUMN(NAME=~"documento.data_documento~") COLUMN(NAME=~"articolo.codice~") COLUMN(NAME=~"riga_documento.quantita~") COLUMN(NAME=~"riga_documento.peso_netto~") COLUMN(NAME=~"riga_documento.tot_riga_val_riga~") COLUMN(NAME=~"riga_documento.coef_calo~") COLUMN(NAME=~"riga_documento.calo~") COLUMN(NAME=~"riga_documento.fino~") COLUMN(NAME=~"riga_documento.importo_manifattura~") COLUMN(NAME=~"orafo_titolo.titolo~") COLUMN(NAME=~"sog_commerciale.codice~") COLUMN(NAME=~"registro.tipo_registro~") COLUMN(NAME=~"documento.id_documento~") COLUMN(NAME=~"documento.tipo_fattura~") COLUMN(NAME=~"riga_documento.prezzo_manifattura~") COLUMN(NAME=~"riga_documento.prezzo_complessivo~") COLUMN(NAME=~"documento.id_valuta~")    JOIN (LEFT=~"sog_commerciale.id_cat_zona~"    OP =~"=~"RIGHT=~"cat_zona.id_cat_zona~"    OUTER1 =~"sog_commerciale.id_cat_zona~" )    JOIN (LEFT=~"sog_commerciale.id_anagrafica~"    OP =~"=~"RIGHT=~"anagrafica.id_anagrafica~" )    JOIN (LEFT=~"riga_documento.id_documento~"    OP =~"=~"RIGHT=~"documento.id_documento~" )    JOIN (LEFT=~"documento.id_sog_commerciale~"    OP =~"=~"RIGHT=~"sog_commerciale.id_sog_commerciale~" )    JOIN (LEFT=~"articolo.id_articolo~"    OP =~"=~"RIGHT=~"riga_documento.id_articolo~" )    JOIN (LEFT=~"orafo_titolo.id_titolo~"    OP =~"=~"RIGHT=~"articolo.id_titolo~" )    JOIN (LEFT=~"registro.id_registro~"    OP =~"=~"RIGHT=~"documento.id_registro~" )WHERE(    EXP1 =~"~~~"documento~~~".~~~"data_documento~~~"~"   OP =~">=~"    EXP2 =~":da_data~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"documento~~~".~~~"data_documento~~~"~"   OP =~"<=~"    EXP2 =~":a_data~" ) ) ARG(NAME = ~"da_data~" TYPE = date)  ARG(NAME = ~"a_data~" TYPE = date) " arguments=(("da_data", date),("a_data", date))  sort="articolo_codice A sog_commerciale_codice A " )
