 column=(type=decimal(4) updatewhereclause=yes name=riga_documento_provv_imp_subage_2 dbname="riga_documento.provv_imp_subage_2" )
 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"riga_documento~" )  TABLE(NAME=~"documento~" )  TABLE(NAME=~"sog_commerciale_gen~" )  TABLE(NAME=~"prof_documento~" )  TABLE(NAME=~"registro~" ) COLUMN(NAME=~"documento.num_progressivo~") COLUMN(NAME=~"documento.num_documento~") COLUMN(NAME=~"documento.data_documento~") COLUMN(NAME=~"documento.id_documento~") COLUMN(NAME=~"riga_documento.id_riga_documento~") COLUMN(NAME=~"riga_documento.num_riga~") COLUMN(NAME=~"riga_documento.descrizione~") COLUMN(NAME=~"riga_documento.quantita~") COLUMN(NAME=~"riga_documento.peso_netto~") COLUMN(NAME=~"documento.id_sog_commerciale~") COLUMN(NAME=~"sog_commerciale_gen.rag_soc_1~") COLUMN(NAME=~"sog_commerciale_gen.codice~") COLUMN(NAME=~"prof_documento.codice~") COLUMN(NAME=~"registro.id_registro~") COLUMN(NAME=~"registro.tipo_registro~") COLUMN(NAME=~"riga_documento.id_riga_doc_provenienza~") COLUMN(NAME=~"riga_documento.provv_imp_subage_2~")    JOIN (LEFT=~"riga_documento.id_documento~"    OP =~"=~"RIGHT=~"documento.id_documento~" )    JOIN (LEFT=~"documento.id_sog_commerciale~"    OP =~"=~"RIGHT=~"sog_commerciale_gen.id_sog_commerciale~" )    JOIN (LEFT=~"documento.id_prof_documento~"    OP =~"=~"RIGHT=~"prof_documento.id_prof_documento~" )    JOIN (LEFT=~"documento.id_registro~"    OP =~"=~"RIGHT=~"registro.id_registro~" )WHERE(    EXP1 =~"id_riga_doc_provenienza~"   OP =~"=~"    EXP2 =~":id_riga~"    LOGIC =~"or~" ) WHERE(    EXP1 =~"provv_imp_subage_2~"   OP =~"=~"    EXP2 =~":id_riga~"    LOGIC =~"or~" ) WHERE(    EXP1 =~"~~~"riga_documento~~~".~~~"id_riga_documento~~~"~"   OP =~"=~"    EXP2 =~":id_riga~"    LOGIC =~"or~" ) WHERE(    EXP1 =~"~~~"documento~~~".~~~"num_documento~~~"~"   OP =~"like~"    EXP2 =~"'%'+:num_bollettina~" ) ) ARG(NAME = ~"id_riga~" TYPE = number)  ARG(NAME = ~"num_bollettina~" TYPE = string) " arguments=(("id_riga", number),("num_bollettina", string))  sort="documento_data_documento A registro_tipo_registro D documento_num_progressivo A " )
