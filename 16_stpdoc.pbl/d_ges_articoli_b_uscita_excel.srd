 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"articolo~" )  TABLE(NAME=~"orafo_metallo~" )  TABLE(NAME=~"orafo_titolo~" )  TABLE(NAME=~"cat_merceologica~" ) COLUMN(NAME=~"articolo.codice~") COLUMN(NAME=~"articolo.descrizione~") COLUMN(NAME=~"articolo.data_ora_creazione~") COLUMN(NAME=~"articolo.data_ora_ult_cambiamento~") COLUMN(NAME=~"articolo.data_ora_ult_var_stato~") COLUMN(NAME=~"orafo_metallo.codice~") COLUMN(NAME=~"orafo_titolo.titolo~") COLUMN(NAME=~"cat_merceologica.descrizione~")    JOIN (LEFT=~"articolo.id_cat_merceologica~"    OP =~"=~"RIGHT=~"cat_merceologica.id_cat_merceologica~"    OUTER1 =~"articolo.id_cat_merceologica~" )    JOIN (LEFT=~"orafo_titolo.id_metallo~"    OP =~"=~"RIGHT=~"orafo_metallo.id_metallo~" )    JOIN (LEFT=~"articolo.id_titolo~"    OP =~"=~"RIGHT=~"orafo_titolo.id_titolo~" )) "  sort="articolo_codice A " )
