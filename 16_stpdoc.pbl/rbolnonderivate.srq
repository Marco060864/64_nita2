PBSELECT( VERSION(400) TABLE(NAME="articolo" )  TABLE(NAME="documento" )  TABLE(NAME="riga_documento" ) COLUMN(NAME="articolo.codice") COLUMN(NAME="riga_documento.id_riga_documento") COLUMN(NAME="riga_documento.num_riga") COLUMN(NAME="riga_documento.descrizione") COLUMN(NAME="riga_documento.quantita") COLUMN(NAME="riga_documento.qta_evasa") COLUMN(NAME="riga_documento.peso_netto") COLUMN(NAME="riga_documento.prezzo_manifattura") COLUMN(NAME="riga_documento.prezzo_complessivo") COLUMN(NAME="riga_documento.peso_netto_evaso") COLUMN(NAME="documento.num_documento") COLUMN(NAME="documento.data_documento") COLUMN(NAME="documento.num_progressivo") COLUMN(NAME="riga_documento.tot_riga_val_riga") COMPUTE(NAME="(select num_documento from documento d, riga_documento r where r.id_riga_documento=~"riga_documento~".~"id_riga_doc_provenienza~" and id_prof_documento=65and r.id_documento=d.id_documento)as c_num_bollettina")    JOIN (LEFT="riga_documento.id_documento"    OP ="="RIGHT="documento.id_documento" )    JOIN (LEFT="riga_documento.id_articolo"    OP ="="RIGHT="articolo.id_articolo" )WHERE(    EXP1 ="( ( ~"riga_documento~".~"id_riga_documento~""   OP ="not in"    EXP2 ="( select id_riga_doc_provenienza from riga_documento where id_riga_doc_provenienza>0 ) )"    LOGIC ="and" ) WHERE(    EXP1 ="( ~"documento~".~"id_prof_documento~""   OP ="="    EXP2 ="66 ) )"    LOGIC ="and" ) WHERE(    EXP1 ="(~"riga_documento~".~"quantita~""   OP =">"    EXP2 ="0"    LOGIC ="or" ) WHERE(    EXP1 ="~"riga_documento~".~"peso_netto~""   OP =">"    EXP2 ="0)" ) ) 