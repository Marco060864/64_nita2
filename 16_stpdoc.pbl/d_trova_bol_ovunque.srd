table(column=(type=decimal(0) updatewhereclause=yes name=num_progressivo dbname="documento.num_progressivo" dbalias=".num_progressivo" )
 column=(type=char(16) updatewhereclause=yes name=num_documento dbname="documento.num_documento" dbalias=".num_documento" )
 column=(type=date updatewhereclause=yes name=data_documento dbname="documento.data_documento" dbalias=".data_documento" )
 column=(type=long updatewhereclause=yes identity=yes name=documento_id_documento dbname="documento.id_documento" dbalias=".id_documento" )
 column=(type=long update=yes updatewhereclause=yes identity=yes name=id_riga_documento dbname="riga_documento.id_riga_documento" dbalias=".id_riga_documento" )
 column=(type=decimal(0) update=yes updatewhereclause=yes name=num_riga dbname="riga_documento.num_riga" dbalias=".num_riga" )
 column=(type=char(32766) update=yes updatewhereclause=no name=descrizione dbname="riga_documento.descrizione" dbalias=".descrizione" )
 column=(type=decimal(4) update=yes updatewhereclause=yes name=quantita dbname="riga_documento.quantita" dbalias=".quantita" )
 column=(type=decimal(4) update=yes updatewhereclause=yes name=peso_netto dbname="riga_documento.peso_netto" dbalias=".peso_netto" )
 column=(type=long updatewhereclause=yes name=documento_id_sog_commerciale dbname="documento.id_sog_commerciale" dbalias=".id_sog_commerciale" )
 column=(type=char(40) updatewhereclause=yes name=rag_soc_1 dbname="sog_commerciale_gen.rag_soc_1" dbalias=".rag_soc_1" )
 column=(type=char(8) updatewhereclause=yes name=sog_commerciale_gen_codice dbname="sog_commerciale_gen.codice" dbalias=".codice" )
 column=(type=char(8) updatewhereclause=yes name=prof_documento_codice dbname="prof_documento.codice" dbalias=".codice" )
 column=(type=long updatewhereclause=yes identity=yes name=registro_id_registro dbname="registro.id_registro" dbalias=".id_registro" )
 column=(type=char(2) updatewhereclause=yes name=registro_tipo_registro dbname="registro.tipo_registro" dbalias=".tipo_registro" )
 column=(type=long updatewhereclause=yes name=riga_documento_id_riga_doc_provenienza dbname="riga_documento.id_riga_doc_provenienza" dbalias=".id_riga_doc_provenienza" )
 column=(type=decimal(4) updatewhereclause=yes name=riga_documento_provv_imp_subage_2 dbname="riga_documento.provv_imp_subage_2" dbalias=".provv_imp_subage_2" )
 column=(type=date updatewhereclause=yes name=documento_data_prev_consegna dbname="documento.data_prev_consegna" dbalias=".data_prev_consegna" )
 column=(type=long updatewhereclause=yes name=riga_documento_id_articolo dbname="riga_documento.id_articolo" dbalias=".id_articolo" )
 column=(type=char(1) updatewhereclause=yes name=documento_ordinato_fo dbname="documento.ordinato_fo" dbalias=".ordinato_fo" values="	S/	N" )
 column=(type=datetime updatewhereclause=yes name=data_ora_creazione dbname="documento.data_ora_creazione" dbalias=".data_ora_creazione" )
 column=(type=long updatewhereclause=yes name=c_vgmf dbname="c_sposta_in_ver_sped_bollettina" values="	1/	0" )
 column=(type=long updatewhereclause=yes name=c_vgmf dbname="c_vgmf" values="	1/	0" )
 column=(type=long updatewhereclause=yes name=id_utenti dbname="documento.id_utenti" dbalias=".id_utenti" )
 column=(type=decimal(4) updatewhereclause=yes name=dim_l dbname="riga_documento.dim_l" dbalias=".dim_l" )
 column=(type=char(12) updatewhereclause=yes name=c_galvanica dbname="c_galvanica" )
 column=(type=decimal(6) updatewhereclause=yes name=imp_avanzo_acconto dbname="documento.imp_avanzo_acconto" dbalias=".imp_avanzo_acconto" )
 column=(type=datetime updatewhereclause=yes name=riga_doc_estensione_data_ora_modifica dbname="riga_doc_estensione.data_ora_modifica" dbalias=".data_ora_modifica" )
 retrieve="  SELECT ~"documento~".~"num_progressivo~",   
         ~"documento~".~"num_documento~",   
         ~"documento~".~"data_documento~",   
         ~"documento~".~"id_documento~",   
         ~"riga_documento~".~"id_riga_documento~",   
         ~"riga_documento~".~"num_riga~",   
         ~"riga_documento~".~"descrizione~",   
         ~"riga_documento~".~"quantita~",   
         ~"riga_documento~".~"peso_netto~",   
         ~"documento~".~"id_sog_commerciale~",   
         ~"sog_commerciale_gen~".~"rag_soc_1~",   
         ~"sog_commerciale_gen~".~"codice~",   
         ~"prof_documento~".~"codice~",   
         ~"registro~".~"id_registro~",   
         ~"registro~".~"tipo_registro~",   
         ~"riga_documento~".~"id_riga_doc_provenienza~",   
         ~"riga_documento~".~"provv_imp_subage_2~",   
         ~"documento~".~"data_prev_consegna~",   
         ~"riga_documento~".~"id_articolo~",
 ~"documento~".~"ordinato_fo~" , documento.data_ora_creazione   , (0) as c_sposta_in_ver_sped_bollettina, 0 as c_vgmf, documento.id_utenti,
 ~"riga_documento~".~"dim_l~",  
(select lavorazione from galvanica where id_galvanica=~"riga_documento~".~"id_gruppo_agenti_2~") as c_galvanica,
documento.imp_avanzo_acconto, riga_doc_estensione.data_ora_modifica

    FROM ~"riga_documento~" left outer join    riga_doc_estensione on riga_documento.id_riga_documento=riga_doc_estensione.id_riga_documento,
         ~"documento~",   
         ~"sog_commerciale_gen~",   
         ~"prof_documento~",   
         ~"registro~"  
   WHERE ( ~"riga_documento~".~"id_documento~" = ~"documento~".~"id_documento~" ) and  
         ( ~"documento~".~"id_sog_commerciale~" = ~"sog_commerciale_gen~".~"id_sog_commerciale~" ) and  
         ( ~"documento~".~"id_prof_documento~" = ~"prof_documento~".~"id_prof_documento~" ) and  
	
         ( ~"documento~".~"id_registro~" = ~"registro~".~"id_registro~" ) and  ( ~"documento~".~"data_documento~">=(select  data_documento   from documento where id_documento=:id_doc_bollettina)) and
         ( ( id_riga_doc_provenienza = :id_riga ) OR  
         ( provv_imp_subage_2 = :id_riga ) OR  
         ( ~"riga_documento~".~"id_riga_documento~" = :id_riga ) OR  
         ( ~"riga_documento~".~"provv_imp_carea_2~" = :id_riga ) OR  
         ( ~"documento~".~"id_documento~" = :id_doc_bollettina ) or
		(~"riga_documento~".~"provv_imp_carea_2~" = (select right(num_documento, 7) from documento where id_documento=:id_doc_bollettina)) or
(~"riga_documento~".~"provv_imp_carea_2~" = (select right(num_documento, 5) from documento where id_documento=:id_doc_bollettina))
 )    
" arguments=(("id_riga", number),("id_doc_bollettina", number))  sort="data_ora_creazione A data_documento A num_progressivo A registro_tipo_registro A " )
