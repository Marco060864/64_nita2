 column=(type=long updatewhereclause=yes identity=yes name=orafo_aper_partita_id_partita dbname="orafo_aper_partita.id_partita" )
 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"orafo_aper_partita~" )  TABLE(NAME=~"orafo_scar_partita~" )  TABLE(NAME=~"riga_documento~" )  TABLE(NAME=~"documento~" )  TABLE(NAME=~"articolo~" ) COLUMN(NAME=~"riga_documento.id_riga_partita~") COLUMN(NAME=~"riga_documento.id_riga_documento~") COLUMN(NAME=~"riga_documento.num_riga~") COLUMN(NAME=~"riga_documento.id_articolo~") COLUMN(NAME=~"riga_documento.peso_netto~") COLUMN(NAME=~"riga_documento.coef_calo~") COLUMN(NAME=~"orafo_scar_partita.val_scarico~") COLUMN(NAME=~"orafo_aper_partita.stato~") COLUMN(NAME=~"orafo_aper_partita.val_apertura~") COLUMN(NAME=~"documento.num_progressivo~") COLUMN(NAME=~"documento.num_documento~") COLUMN(NAME=~"documento.data_documento~") COLUMN(NAME=~"documento.id_documento~") COLUMN(NAME=~"orafo_aper_partita.id_partita~")    JOIN (LEFT=~"orafo_scar_partita.id_partita~"    OP =~"=~"RIGHT=~"orafo_aper_partita.id_partita~" )    JOIN (LEFT=~"riga_documento.id_riga_partita~"    OP =~"=~"RIGHT=~"orafo_scar_partita.id_riga_documento~" )    JOIN (LEFT=~"documento.id_documento~"    OP =~"=~"RIGHT=~"orafo_aper_partita.id_documento~" )    JOIN (LEFT=~"riga_documento.id_articolo~"    OP =~"=~"RIGHT=~"articolo.id_articolo~" )WHERE(    EXP1 =~"~~~"riga_documento~~~".~~~"id_documento~~~"~"   OP =~"=~"    EXP2 =~":al_id_doc_scarico~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"articolo~~~".~~~"id_titolo~~~"~"   OP =~"=~"    EXP2 =~":al_id_titolo~" ) ) ARG(NAME = ~"al_id_doc_scarico~" TYPE = number)  ARG(NAME = ~"al_id_titolo~" TYPE = number) " arguments=(("al_id_doc_scarico", number),("al_id_titolo", number)) )
