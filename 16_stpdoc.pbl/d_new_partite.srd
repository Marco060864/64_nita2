table(column=(type=long updatewhereclause=yes identity=yes name=orafo_aper_partita_id_partita dbname="orafo_aper_partita.id_partita" )
 column=(type=char(1) updatewhereclause=yes name=orafo_aper_partita_stato dbname="orafo_aper_partita.stato" )
 column=(type=decimal(4) updatewhereclause=yes name=orafo_aper_partita_val_apertura dbname="orafo_aper_partita.val_apertura" )
 column=(type=decimal(4) updatewhereclause=yes name=orafo_aper_partita_val_scarico dbname="orafo_aper_partita.val_scarico" )
 column=(type=long updatewhereclause=yes name=orafo_aper_partita_id_titolo dbname="orafo_aper_partita.id_titolo" )
 column=(type=long updatewhereclause=yes identity=yes name=ap_id_documento dbname="documento.id_documento" )
 column=(type=decimal(0) updatewhereclause=yes name=ap_num_progressivo dbname="documento.num_progressivo" )
 column=(type=char(16) updatewhereclause=yes name=ap_num_documento dbname="documento.num_documento" )
 column=(type=date updatewhereclause=yes name=ap_data_documento dbname="documento.data_documento" )
 column=(type=char(2) updatewhereclause=yes name=orafo_metallo_codice dbname="orafo_metallo.codice" )
 column=(type=decimal(4) updatewhereclause=yes name=c_sum_scarichi dbname="c_sum_scarichi" )
 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"orafo_aper_partita~" )  TABLE(NAME=~"documento~" )  TABLE(NAME=~"orafo_metallo~" )  TABLE(NAME=~"orafo_titolo~" ) COLUMN(NAME=~"orafo_aper_partita.id_partita~") COLUMN(NAME=~"orafo_aper_partita.stato~") COLUMN(NAME=~"orafo_aper_partita.val_apertura~") COLUMN(NAME=~"orafo_aper_partita.val_scarico~") COLUMN(NAME=~"orafo_aper_partita.id_titolo~") COLUMN(NAME=~"documento.id_documento~") COLUMN(NAME=~"documento.num_progressivo~") COLUMN(NAME=~"documento.num_documento~") COLUMN(NAME=~"documento.data_documento~") COLUMN(NAME=~"orafo_metallo.codice~") COMPUTE(NAME=~"ifnull((select sum(s.val_scarico) from orafo_scar_partita s, documento d, riga_documento r where id_partita=orafo_aper_partita.id_partita and r.id_riga_partita=s.id_riga_documento and  d.id_documento=r.id_documento and d.data_documento<=:a_data), 0,(select sum(s.val_scarico) from orafo_scar_partita s, documento d, riga_documento r where id_partita=orafo_aper_partita.id_partita and r.id_riga_partita=s.id_riga_documento and  d.id_documento=r.id_documento and d.data_documento<=:a_data))  as c_sum_scarichi~")    JOIN (LEFT=~"documento.id_documento~"    OP =~"=~"RIGHT=~"orafo_aper_partita.id_documento~" )    JOIN (LEFT=~"orafo_titolo.id_metallo~"    OP =~"=~"RIGHT=~"orafo_metallo.id_metallo~" )    JOIN (LEFT=~"orafo_aper_partita.id_titolo~"    OP =~"=~"RIGHT=~"orafo_titolo.id_titolo~" )WHERE(    EXP1 =~"~~~"documento~~~".~~~"data_documento~~~"~"   OP =~">=~"    EXP2 =~":da_data~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"documento~~~".~~~"data_documento~~~"~"   OP =~"<=~"    EXP2 =~":a_data~" ) ) ARG(NAME = ~"da_data~" TYPE = date)  ARG(NAME = ~"a_data~" TYPE = date) " arguments=(("da_data", date),("a_data", date))  sort="ap_data_documento A ap_num_progressivo A " )
