 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"documento~" )  TABLE(NAME=~"cast_iva_documento~" )  TABLE(NAME=~"registro~" )  TABLE(NAME=~"sog_commerciale_gen~" )  TABLE(NAME=~"prof_documento~" )  TABLE(NAME=~"valuta~" ) COLUMN(NAME=~"prof_documento.codice~") COLUMN(NAME=~"sog_commerciale_gen.codice~") COLUMN(NAME=~"sog_commerciale_gen.rag_soc_1~") COLUMN(NAME=~"registro.tipo_registro~") COLUMN(NAME=~"documento.num_progressivo~") COLUMN(NAME=~"documento.data_registrazione~") COLUMN(NAME=~"documento.num_documento~") COLUMN(NAME=~"documento.data_documento~") COLUMN(NAME=~"cast_iva_documento.val_tot_imp_v~") COLUMN(NAME=~"cast_iva_documento.val_tot_iva_v~") COLUMN(NAME=~"cast_iva_documento.val_spese~") COLUMN(NAME=~"documento.id_documento~") COLUMN(NAME=~"registro.id_esercizio~") COLUMN(NAME=~"registro.id_registro~") COLUMN(NAME=~"documento.cambio~") COLUMN(NAME=~"cast_iva_documento.val_tot_imp_l~") COLUMN(NAME=~"cast_iva_documento.val_tot_iva_l~") COMPUTE(NAME=~"cast((select sum(quantita) from riga_documento where id_documento=~~~"documento~~~".~~~"id_documento~~~") as decimal) as qta~") COMPUTE(NAME=~"cast((select sum(qta_evasa) from riga_documento where id_documento=~~~"documento~~~".~~~"id_documento~~~") as decimal) as qta_evasa~") COMPUTE(NAME=~"cast((select sum(peso_netto) from riga_documento where id_documento=~~~"documento~~~".~~~"id_documento~~~") as decimal) as peso_n~") COMPUTE(NAME=~"cast((select sum(peso_netto_evaso) from riga_documento where id_documento=~~~"documento~~~".~~~"id_documento~~~") as decimal) as peso_n_evaso~") COLUMN(NAME=~"valuta.simbolo~") COLUMN(NAME=~"valuta.cifra_arrotondamento~") COLUMN(NAME=~"documento.id_valuta~")    JOIN (LEFT=~"documento.id_documento~"    OP =~"=~"RIGHT=~"cast_iva_documento.id_documento~"    OUTER1 =~"documento.id_documento~" )    JOIN (LEFT=~"documento.id_documento~"    OP =~"=~"RIGHT=~"documento.id_documento~" )    JOIN (LEFT=~"documento.id_registro~"    OP =~"=~"RIGHT=~"registro.id_registro~" )    JOIN (LEFT=~"documento.id_sog_commerciale~"    OP =~"=~"RIGHT=~"sog_commerciale_gen.id_sog_commerciale~" )    JOIN (LEFT=~"documento.id_prof_documento~"    OP =~"=~"RIGHT=~"prof_documento.id_prof_documento~" )    JOIN (LEFT=~"documento.id_valuta~"    OP =~"=~"RIGHT=~"valuta.id_valuta~" )WHERE(    EXP1 =~"~~~"documento~~~".~~~"id_registro~~~"~"   OP =~">=~"    EXP2 =~":ll_reg_ini~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"documento~~~".~~~"id_registro~~~"~"   OP =~"<=~"    EXP2 =~":ll_reg_fine~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"documento~~~".~~~"data_documento~~~"~"   OP =~">=~"    EXP2 =~":ldt_da_data~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"documento~~~".~~~"data_documento~~~"~"   OP =~"<=~"    EXP2 =~":ldt_a_data~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"sog_commerciale_gen~~~".~~~"codice~~~"~"   OP =~">=~"    EXP2 =~":da_sog~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"sog_commerciale_gen~~~".~~~"codice~~~"~"   OP =~"<=~"    EXP2 =~":a_sog~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"registro~~~".~~~"id_esercizio~~~"~"   OP =~">=~"    EXP2 =~":da_esercizio~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"registro~~~".~~~"id_esercizio~~~"~"   OP =~"<=~"    EXP2 =~":a_esercizio~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"prof_documento~~~".~~~"codice~~~"~"   OP =~">=~"    EXP2 =~":da_prof~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"prof_documento~~~".~~~"codice~~~"~"   OP =~"<=~"    EXP2 =~":a_prof~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"registro~~~".~~~"tipo_registro~~~"~"   OP =~">=~"    EXP2 =~":tipo_reg_da~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"registro~~~".~~~"tipo_registro~~~"~"   OP =~"<=~"    EXP2 =~":tipo_reg_a~" ) ) ARG(NAME = ~"ll_reg_ini~" TYPE = number)  ARG(NAME = ~"ll_reg_fine~" TYPE = number)  ARG(NAME = ~"ldt_da_data~" TYPE = date)  ARG(NAME = ~"ldt_a_data~" TYPE = date)  ARG(NAME = ~"da_sog~" TYPE = string)  ARG(NAME = ~"a_sog~" TYPE = string)  ARG(NAME = ~"da_esercizio~" TYPE = number)  ARG(NAME = ~"a_esercizio~" TYPE = number)  ARG(NAME = ~"da_prof~" TYPE = string)  ARG(NAME = ~"a_prof~" TYPE = string)  ARG(NAME = ~"tipo_reg_da~" TYPE = string)  ARG(NAME = ~"tipo_reg_a~" TYPE = string) " arguments=(("ll_reg_ini", number),("ll_reg_fine", number),("ldt_da_data", date),("ldt_a_data", date),("da_sog", string),("a_sog", string),("da_esercizio", number),("a_esercizio", number),("da_prof", string),("a_prof", string),("tipo_reg_da", string),("tipo_reg_a", string)) )
