table(column=(type=char(64) updatewhereclause=yes name=articolo_codice dbname="articolo.codice" dbalias=".codice" )
 column=(type=decimal(0) updatewhereclause=yes name=documento_num_progressivo dbname="documento.num_progressivo" dbalias=".num_progressivo" )
 column=(type=date updatewhereclause=yes name=documento_data_registrazione dbname="documento.data_registrazione" dbalias=".data_registrazione" )
 column=(type=char(16) updatewhereclause=yes name=documento_num_documento dbname="documento.num_documento" dbalias=".num_documento" )
 column=(type=date updatewhereclause=yes name=documento_data_documento dbname="documento.data_documento" dbalias=".data_documento" )
 column=(type=long updatewhereclause=yes identity=yes name=documento_id_documento dbname="documento.id_documento" dbalias=".id_documento" )
 column=(type=long updatewhereclause=yes identity=yes name=articolo_id_articolo dbname="articolo.id_articolo" dbalias=".id_articolo" )
 column=(type=long updatewhereclause=yes identity=yes name=riga_documento_id_riga_documento dbname="riga_documento.id_riga_documento" dbalias=".id_riga_documento" )
 column=(type=long updatewhereclause=yes name=riga_documento_id_unita_confezione dbname="riga_documento.id_unita_confezione" dbalias=".id_unita_confezione" )
 column=(type=decimal(0) updatewhereclause=yes name=riga_documento_num_riga dbname="riga_documento.num_riga" dbalias=".num_riga" )
 column=(type=char(32766) updatewhereclause=no name=riga_documento_descrizione dbname="riga_documento.descrizione" dbalias=".descrizione" )
 column=(type=decimal(4) updatewhereclause=yes name=riga_documento_quantita dbname="riga_documento.quantita" dbalias=".quantita" )
 column=(type=decimal(4) updatewhereclause=yes name=riga_documento_peso_netto dbname="riga_documento.peso_netto" dbalias=".peso_netto" )
 column=(type=char(8) updatewhereclause=yes name=prof_documento_codice dbname="prof_documento.codice" dbalias=".codice" )
 column=(type=long updatewhereclause=yes name=c_tot_qta_rbol dbname="c_tot_qta_rbol" )
 column=(type=long updatewhereclause=yes name=c_visibile dbname="c_visibile" )
 column=(type=date updatewhereclause=yes name=documento_data_prev_consegna dbname="documento.data_prev_consegna" dbalias=".data_prev_consegna" )
 column=(type=decimal(4) updatewhereclause=yes name=dim_l dbname="riga_documento.dim_l" dbalias=".dim_l" )
 column=(type=char(174) updatewhereclause=yes name=c_buratto dbname="c_buratto" )
 column=(type=char(174) updatewhereclause=yes name=c_tlaser dbname="c_tlaser" )
 column=(type=char(174) updatewhereclause=yes name=c_sald dbname="c_sald" )
 column=(type=char(174) updatewhereclause=yes name=c_inv_ceramico dbname="c_inv_ceramico" )
 retrieve="  SELECT ~"articolo~".~"codice~",   
         ~"documento~".~"num_progressivo~",   
         ~"documento~".~"data_registrazione~",   
         ~"documento~".~"num_documento~",   
         ~"documento~".~"data_documento~",   
         ~"documento~".~"id_documento~",   
         ~"articolo~".~"id_articolo~",   
         ~"riga_documento~".~"id_riga_documento~",   
         ~"riga_documento~".~"id_unita_confezione~",   
         ~"riga_documento~".~"num_riga~",   
         ~"riga_documento~".~"descrizione~",   
         ~"riga_documento~".~"quantita~",   
         ~"riga_documento~".~"peso_netto~",   
         ~"prof_documento~".~"codice~",   
         0 as c_tot_qta_rbol,   
         0 as c_visibile,   
         ~"documento~".~"data_prev_consegna~",   
         ~"riga_documento~".~"dim_l~"  ,     (select first(p.codice+' -  '+num_documento+ ' - '+string(data_documento)+' qt. '+str(r.quantita,6)) from documento d, riga_documento r, prof_documento p 
where r.id_documento=d.id_documento and p.id_prof_documento=d.id_prof_documento 
and r.provv_imp_subage_2=riga_documento.id_riga_documento and d.id_prof_documento=184) as c_buratto, 
 (select first(p.codice+' -  '+num_documento+ ' - '+string(data_documento)+' qt. '+str(r.quantita,6)) from documento d, riga_documento r, prof_documento p where r.id_documento=d.id_documento and p.id_prof_documento=d.id_prof_documento 
and r.provv_imp_subage_2=riga_documento.id_riga_documento and d.id_prof_documento=194) as c_TLASER,
(select p.codice+' -  '+num_documento+ ' - '+string(data_documento)+' qt. '+str(r.quantita,6) from documento d, riga_documento r, prof_documento p , produzione_2011 p2011
where r.id_documento=d.id_documento and p.id_prof_documento=d.id_prof_documento 
and p2011.id_doc_produzione=riga_documento.id_riga_documento and d.id_prof_documento=130) as c_sald,
 (select first(p.codice+' -  '+num_documento+ ' - '+string(data_documento)+' qt. '+str(r.quantita,6)) from documento d, riga_documento r, prof_documento p where r.id_documento=d.id_documento and p.id_prof_documento=d.id_prof_documento 
and r.provv_imp_subage_2=riga_documento.id_riga_documento and d.id_prof_documento=224) as c_inv_ceramico

    FROM ~"articolo~",   
         ~"documento~",   
         ~"riga_documento~",   
         ~"prof_documento~",   
         ~"registro~"  
   WHERE ( ~"riga_documento~".~"id_documento~" = ~"documento~".~"id_documento~" ) and  
         ( ~"riga_documento~".~"id_articolo~" = ~"articolo~".~"id_articolo~" ) and  
         ( ~"prof_documento~".~"id_prof_documento~" = ~"documento~".~"id_prof_documento~" ) and  
         ( ~"registro~".~"id_registro~" = ~"documento~".~"id_registro~" ) and  
         ( ( ~"documento~".~"data_documento~" >= :da_data ) AND  
         ( ~"documento~".~"data_documento~" <= :a_data ) AND  
         ( ~"registro~".~"id_mod_registro~" = 54 ) )    
" arguments=(("da_data", date),("a_data", date))  sort="documento_data_documento A documento_num_progressivo A documento_num_documento A " )
