table(column=(type=char(2) updatewhereclause=yes name=orafo_metallo_metallo dbname="orafo_metallo.metallo" dbalias="om.metallo" )
 column=(type=char(2) updatewhereclause=yes name=tipo_partita dbname="tipo_partita" )
 column=(type=char(40) updatewhereclause=yes name=sog_commerciale_gen_soggetto_commerciale dbname="sog_commerciale_gen.soggetto_commerciale" dbalias="sc.soggetto_commerciale" )
 column=(type=decimal(4) updatewhereclause=yes name=totale_carico dbname="totale_carico" )
 column=(type=decimal(4) updatewhereclause=yes name=totale_scarico dbname="totale_scarico" )
 column=(type=decimal(6) updatewhereclause=yes name=totale_car_fc dbname="totale_car_fc" )
 column=(type=decimal(6) updatewhereclause=yes name=totale_scar_fc dbname="totale_scar_fc" )
 retrieve="SELECT 
    om.codice AS metallo,
    SUBSTRING(
        (SELECT cod_tipo_partita 
         FROM orafo_tipo_partita 
         WHERE id_tipo_partita = cm.id_tipo_partita),
        2, 2
    ) AS tipo_partita,
    sc.rag_soc_1 AS soggetto_commerciale,
   -- Totale carico
SUM(
  CASE 
    WHEN sc.id_sog_commerciale = 43 AND cm.segno = 'C' THEN rd.peso_netto
    WHEN sc.id_sog_commerciale <> 43 AND cm.saldi_cl_fino = '-' THEN rd.peso_netto
    ELSE 0 
  END
) AS totale_carico,

-- Totale scarico
SUM(
  CASE 
    WHEN sc.id_sog_commerciale = 43 AND cm.segno =  'S' THEN rd.peso_netto
    WHEN sc.id_sog_commerciale <> 43 AND cm.saldi_cl_fino = '+' THEN rd.peso_netto
    ELSE 0 
  END
) AS totale_scarico,

-- Totale carico con coefficiente di calo
ROUND(
  SUM(
    CASE 
      WHEN sc.id_sog_commerciale = 43 AND cm.segno = 'C' AND rd.coef_calo <> 0 THEN rd.peso_netto * rd.coef_calo / 1000
      WHEN sc.id_sog_commerciale <> 43 AND cm.saldi_cl_fino = '-' AND rd.coef_calo <> 0 THEN rd.peso_netto * rd.coef_calo / 1000
      ELSE 0 
    END
  ), 2
) AS totale_car_fc,

-- Totale scarico con coefficiente di calo
ROUND(
  SUM(
    CASE 
      WHEN sc.id_sog_commerciale = 43 AND cm.segno = 'S' AND rd.coef_calo <> 0 THEN rd.peso_netto * rd.coef_calo / 1000
      WHEN sc.id_sog_commerciale <> 43 AND cm.saldi_cl_fino = '+' AND rd.coef_calo <> 0 THEN rd.peso_netto * rd.coef_calo / 1000
      ELSE 0 
    END
  ), 2
) AS totale_scar_fc


FROM dba.riga_documento rd
JOIN dba.documento d ON d.id_documento = rd.id_documento
JOIN dba.articolo a ON a.id_articolo = rd.id_articolo
JOIN dba.orafo_titolo ot ON ot.id_titolo = a.id_titolo
JOIN dba.orafo_metallo om ON om.id_metallo = ot.id_metallo
JOIN dba.caus_magazzino cm ON cm.id_caus_magazzino = rd.id_caus_magazzino
JOIN dba.sog_commerciale_gen sc ON sc.id_sog_commerciale = d.id_sog_commerciale
WHERE 
  CASE 
    WHEN sc.id_sog_commerciale = 43 THEN 
      CASE WHEN cm.segno IN ('C', 'S') THEN 1 ELSE 0 END
    ELSE 
      CASE WHEN cm.saldi_cl_fino IN ('+', '-') THEN 1 ELSE 0 END
  END = 1

  AND d.data_documento BETWEEN :da_data AND :a_data
and  sc.id_sog_commerciale=:id_sog
  AND d.id_sog_commerciale NOT IN (143, 2145, 1985)
  AND cm.id_tipo_partita > 0
GROUP BY om.codice, tipo_partita, sc.rag_soc_1
ORDER BY om.codice, tipo_partita, sc.rag_soc_1


" arguments=(("da_data", date),("a_data", date),("id_sog", number)) )
