table(column=(type=long updatewhereclause=yes identity=yes name=documento_id_documento dbname="documento.id_documento" dbalias="documento_a.id_documento" )
 column=(type=long updatewhereclause=yes name=documento_id_prof_documento dbname="documento.id_prof_documento" dbalias="documento_a.id_prof_documento" )
 column=(type=long updatewhereclause=yes name=documento_id_registro dbname="documento.id_registro" dbalias="documento_a.id_registro" )
 column=(type=decimal(0) updatewhereclause=yes name=documento_num_progressivo dbname="documento.num_progressivo" dbalias="documento_a.num_progressivo" )
 column=(type=date updatewhereclause=yes name=documento_data_registrazione dbname="documento.data_registrazione" dbalias="documento_a.data_registrazione" )
 column=(type=char(16) updatewhereclause=yes name=num_documento dbname="documento.num_documento" dbalias="documento_a.num_documento" )
 column=(type=date updatewhereclause=yes name=data_documento dbname="documento.data_documento" dbalias="documento_a.data_documento" )
 column=(type=long updatewhereclause=yes name=documento_id_sog_commerciale dbname="documento.id_sog_commerciale" dbalias="documento_a.id_sog_commerciale" )
 column=(type=date updatewhereclause=yes name=data_prev_consegna dbname="documento.data_prev_consegna" dbalias="documento_a.data_prev_consegna" )
 column=(type=long updatewhereclause=yes identity=yes name=riga_documento_id_riga_documento dbname="riga_documento.id_riga_documento" dbalias="riga_documento_a.id_riga_documento" )
 column=(type=char(32766) updatewhereclause=no name=riga_documento_descrizione dbname="riga_documento.descrizione" dbalias="riga_documento_a.descrizione" )
 column=(type=char(32766) updatewhereclause=no name=riga_documento_descrizione dbname="riga_documento.descrizione" dbalias="riga_documento_b.descrizione" )
 column=(type=long updatewhereclause=yes name=documento_id_prof_documento dbname="documento.id_prof_documento" dbalias="documento_b.id_prof_documento" )
 column=(type=char(16) updatewhereclause=yes name=documento_num_documento dbname="documento.num_documento" dbalias="documento_b.num_documento" )
 column=(type=date updatewhereclause=yes name=documento_data_documento dbname="documento.data_documento" dbalias="documento_b.data_documento" )
 column=(type=char(8) updatewhereclause=yes name=prof_bol dbname="prof_documento.codice" dbalias="prof_documento_a.codice" )
 column=(type=char(8) updatewhereclause=yes name=prof_rbol dbname="prof_documento.codice" dbalias="prof_documento_b.codice" )
 column=(type=decimal(4) updatewhereclause=yes name=riga_documento_provv_imp_subage_2 dbname="riga_documento.provv_imp_subage_2" dbalias="riga_documento_a.provv_imp_subage_2" )
 column=(type=char(27) updatewhereclause=yes name=c_galvint dbname="c_galvint" )
 column=(type=char(27) updatewhereclause=yes name=c_num_sald dbname="c_num_sald" )
 column=(type=char(27) updatewhereclause=yes name=c_buratto dbname="c_buratto" )
 column=(type=decimal(4) updatewhereclause=yes name=quantita_bol dbname="riga_documento.quantita" dbalias="riga_documento_a.quantita" )
 column=(type=decimal(4) updatewhereclause=yes name=quantita_rbol dbname="riga_documento.quantita" dbalias="riga_documento_b.quantita" )
 column=(type=decimal(4) updatewhereclause=yes name=riga_documento_peso_netto dbname="riga_documento.peso_netto" dbalias="riga_documento_a.peso_netto" )
 column=(type=long updatewhereclause=yes name=riga_documento_id_articolo dbname="riga_documento.id_articolo" dbalias="riga_documento_a.id_articolo" )
 column=(type=long updatewhereclause=yes name=c_visibile dbname="c_visibile" )
 column=(type=long updatewhereclause=yes name=c_id_sog_com_sald dbname="c_id_sog_com_sald" )
 column=(type=char(25) updatewhereclause=yes name=c_xsald dbname="c_xsald" )
 column=(type=long updatewhereclause=yes name=c_id_riga_doc_der_sald dbname="c_id_riga_doc_der_sald" )
 column=(type=char(14) updatewhereclause=yes name=data_sped_k dbname="data_sped_k" )
 column=(type=char(27) updatewhereclause=yes name=c_ripara dbname="c_ripara" )
 column=(type=long updatewhereclause=yes name=c_num_ordine dbname="c_num_ordine" )
 column=(type=char(2) updatewhereclause=yes name=c_metallo dbname="c_metallo" )
 column=(type=char(1) updatewhereclause=yes name=documento_ordinato_fo dbname="documento.ordinato_fo" dbalias="documento_a.ordinato_fo" values="	S/	N" )
 column=(type=char(25) updatewhereclause=yes name=c_num_tlaser dbname="c_num_tlaser" )
 column=(type=long updatewhereclause=yes name=c_id_sog_2 dbname="c_id_sog_2" )
 column=(type=char(1) updatewhereclause=yes name=c_giorno_rientro_silver dbname="c_giorno_rientro_silver" )
 column=(type=long updatewhereclause=yes name=c_sposta_in_ver_sped_bollettina dbname="c_sposta_in_ver_sped_bollettina" values="	1/	0" )
 column=(type=long updatewhereclause=yes name=c_vgmf dbname="c_va_in_ver_merce" values="	1/	0" )
 column=(type=datetime updatewhereclause=yes name=c_data_ora dbname="c_data_ora" )
 column=(type=long updatewhereclause=yes identity=yes name=id_riga_derivata dbname="riga_documento.id_riga_derivata" dbalias="riga_documento_b.id_riga_derivata" )
 retrieve="  SELECT ~"documento_a~".~"id_documento~",   
         ~"documento_a~".~"id_prof_documento~",   
         ~"documento_a~".~"id_registro~",   
         ~"documento_a~".~"num_progressivo~",   
         ~"documento_a~".~"data_registrazione~",   
         ~"documento_a~".~"num_documento~",   
         ~"documento_a~".~"data_documento~",   
         ~"documento_a~".~"id_sog_commerciale~",   
         ~"documento_a~".~"data_prev_consegna~",   
         ~"riga_documento_a~".~"id_riga_documento~",   
         ~"riga_documento_a~".~"descrizione~",   
         ~"riga_documento_b~".~"descrizione~",   
         ~"documento_b~".~"id_prof_documento~",   
         ~"documento_b~".~"num_documento~",   
         ~"documento_b~".~"data_documento~",   
         ~"prof_documento_a~".~"codice~",   
         ~"prof_documento_b~".~"codice~",   
       	~"riga_documento_a~".~"provv_imp_subage_2~",
         (select first(num_documento+ '-'+string(data_documento)) from documento d, riga_documento r, prof_documento p where r.id_documento=d.id_documento and p.id_prof_documento=d.id_prof_documento 
		and r.provv_imp_subage_2=riga_documento_a.id_riga_documento and d.id_prof_documento=170 order by d.data_documento desc) as c_galvint,   
         (select first(num_documento+ '-'+string(data_documento)) from documento d, riga_documento r, prof_documento p , sog_commerciale s, anagrafica a
where r.id_documento=d.id_documento and p.id_prof_documento=d.id_prof_documento and r.provv_imp_subage_2=riga_documento_a.id_riga_documento and s.id_sog_commerciale=d.id_sog_commerciale and a.id_anagrafica=s.id_anagrafica
 and d.id_prof_documento=130 order by d.data_documento desc) as c_num_sald,   
  
         (select first(num_documento+ '-'+string(data_documento)) from documento d, riga_documento r, prof_documento p where r.id_documento=d.id_documento and p.id_prof_documento=d.id_prof_documento
 and r.provv_imp_subage_2=riga_documento_a.id_riga_documento and d.id_prof_documento=184 order by d.data_documento desc) as c_buratto,   
         ~"riga_documento_a~".~"quantita~",   
         ~"riga_documento_b~".~"quantita~",   
         ~"riga_documento_a~".~"peso_netto~",   
         ~"riga_documento_a~".~"id_articolo~",   
         0 as c_visibile ,

	(select first( d.id_sog_commerciale) from documento d, riga_documento r where r.id_documento=d.id_documento and  r.provv_imp_subage_2=riga_documento_a.id_riga_documento and 
	 (d.id_prof_documento=130 or   d.id_prof_documento=204) order by d.data_documento desc) as C_ID_SOG_COM_SALD,

(SELECT string(d2.num_progressivo)+ '-'+string(d2.data_documento) from riga_documento r,documento d, riga_documento r2, documento d2  //questa
where r.id_riga_documento=r2.id_riga_doc_provenienza and d2.id_documento=r2.id_documento
and r.id_documento=d.id_documento and  r.provv_imp_subage_2=riga_documento_a.id_riga_documento
 and d.id_prof_documento=130)  as c_xsald,

(select first(r2.id_riga_documento) from documento d2, riga_documento r, riga_documento r2
where r2.id_documento=d2.id_documento and r.provv_imp_subage_2=riga_documento_a.id_riga_documento and r2.id_riga_doc_provenienza=r.id_riga_documento
 and d2.id_prof_documento=191 order by d2.data_documento desc) as c_id_riga_doc_der_sald,
 
(SELECT first(convert(char(8),s_data, 5)+'-'+cliente) from sped_lista_k where s_data>= ~"documento_a~".~"data_prev_consegna~" and  left(~"documento_a~".~"num_documento~", 5) like '%'+cliente+'%' order by s_data ) as data_sped_k,

 (select first(num_documento+ '-'+string(data_documento)) from documento d, riga_documento r, prof_documento p where r.id_documento=d.id_documento and p.id_prof_documento=d.id_prof_documento 
		and r.provv_imp_subage_2=riga_documento_a.id_riga_documento and d.id_prof_documento=204 order by d.data_documento desc) as c_ripara,

(select first(num_ordine) from bollettine_excel b where num_ordine>0 and b.cod_barre=right(documento_a.num_documento, 7) and tipo='B' order by num_ordine desc )as c_num_ordine,

(select m.codice from dba.orafo_metallo m, orafo_titolo t, articolo a where a.id_articolo=riga_documento_a.id_articolo and a.id_titolo=t.id_titolo and m.id_metallo=t.id_metallo) as c_metallo,
 ~"documento_a~".~"ordinato_fo~" ,

(select first(num_documento+ '-'+convert(char(8),data_documento,5)) from documento d, riga_documento r
where r.id_documento=d.id_documento  and r.provv_imp_subage_2=riga_documento_a.id_riga_documento 
 and d.id_prof_documento=196 order by d.data_documento desc) as c_num_tlaser ,

(select first(d.id_sog_commerciale) from documento d, riga_documento r
where r.id_documento=d.id_documento and r.provv_imp_subage_2=riga_documento_a.id_riga_documento  and d.id_prof_documento=196
 order by d.data_documento desc) as c_id_sog_2,
(select giorno_rientro_silver from dba.riga_documento_2 where id_riga_documento=~"riga_documento_a~".~"id_riga_documento~") as c_giorno_rientro_silver,
(0) as c_sposta_in_ver_sped_bollettina, (0) as c_va_in_ver_merce, 
(select first(data_ora) from dba.ver_giorno_merce_fo where num_bollettina= right(~"documento_a~".~"num_documento~", 7) order by id_ver_giorno_merce_fo desc) as c_data_ora,
 ~"riga_documento_b~".~"id_riga_documento~" as id_riga_derivata

    FROM {oj ~"riga_documento~" ~"riga_documento_a~" RIGHT OUTER JOIN ~"documento~" ~"documento_a~" ON ~"riga_documento_a~".~"id_documento~" = ~"documento_a~".~"id_documento~" LEFT OUTER JOIN ~"riga_documento~" ~"riga_documento_b~" ON
 ~"riga_documento_a~".~"id_riga_documento~" = ~"riga_documento_b~".~"id_riga_doc_provenienza~" LEFT OUTER JOIN ~"riga_documento~" ~"riga_documento_c~" ON ~"riga_documento_b~".~"id_riga_documento~" = ~"riga_documento_c~".~"id_riga_doc_provenienza~" 
LEFT OUTER JOIN ~"documento~" ~"documento_b~" ON ~"riga_documento_b~".~"id_documento~" = ~"documento_b~".~"id_documento~"
 LEFT OUTER JOIN ~"prof_documento~" ~"prof_documento_b~" 
ON ~"documento_b~".~"id_prof_documento~" = ~"prof_documento_b~".~"id_prof_documento~" LEFT OUTER JOIN ~"prof_documento~" ~"prof_documento_a~" ON ~"documento_a~".~"id_prof_documento~" = ~"prof_documento_a~".~"id_prof_documento~"} ,
registro 
   WHERE ( ~"documento_a~".~"data_documento~" >= :DA_DATA  ) AND  
         ( ~"documento_a~".~"data_documento~" <= :A_DATA  ) AND  
         (  ~"documento_a~".~"id_registro~" = registro.id_registro  )
and  (registro.id_mod_registro=54  or registro.id_mod_registro=76  )   //or registro.id_mod_registro=62
and (~"riga_documento_a~".~"qta_evasa~"=0 or ~"riga_documento_a~".~"qta_evasa~"=null)
" arguments=(("DA_DATA", date),("A_DATA", date))  sort="data_prev_consegna A c_data_sped_k A left(documento_num_documento, 4) D " )
