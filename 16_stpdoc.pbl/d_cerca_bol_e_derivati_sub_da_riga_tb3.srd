 retrieve="  SELECT 'XSALD', d.num_documento, d.data_documento, r.num_riga  FROM riga_documento r,documento d
where  d.id_documento=r.id_documento 
and r.id_riga_doc_provenienza=:id_riga and d.id_prof_documento=187
" arguments=(("id_riga", number))  sort="documento_data_documento A documento_num_documento A " )
