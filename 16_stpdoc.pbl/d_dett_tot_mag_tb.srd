 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"tot_magazzino~" )  TABLE(NAME=~"tot_mag_configurazione~" )  TABLE(NAME=~"riga_documento~" )  TABLE(NAME=~"documento~" )  TABLE(NAME=~"articolo~" )  TABLE(NAME=~"orafo_metallo~" )  TABLE(NAME=~"orafo_titolo~" )  TABLE(NAME=~"sog_commerciale_gen~" )  TABLE(NAME=~"caus_magazzino~" )  TABLE(NAME=~"tab_iva~" ) COLUMN(NAME=~"tot_magazzino.id_tot_magazzino~") COLUMN(NAME=~"tot_magazzino.id_caus_magazzino~") COLUMN(NAME=~"tot_magazzino.segno~") COLUMN(NAME=~"riga_documento.peso_netto~") COLUMN(NAME=~"riga_documento.calo~") COLUMN(NAME=~"riga_documento.fino~") COLUMN(NAME=~"tot_mag_configurazione.pesata~") COLUMN(NAME=~"tot_mag_configurazione.calo~") COLUMN(NAME=~"tot_mag_configurazione.fino~") COLUMN(NAME=~"tot_mag_configurazione.fino_calo~") COLUMN(NAME=~"tot_mag_configurazione.ordine~") COLUMN(NAME=~"tot_mag_configurazione.descrizione~") COLUMN(NAME=~"orafo_titolo.titolo~") COLUMN(NAME=~"orafo_metallo.codice~") COLUMN(NAME=~"orafo_metallo.prezioso~") COLUMN(NAME=~"riga_documento.tot_riga_val_riga~") COLUMN(NAME=~"documento.num_documento~") COLUMN(NAME=~"documento.data_documento~") COLUMN(NAME=~"sog_commerciale_gen.codice~") COLUMN(NAME=~"sog_commerciale_gen.rag_soc_1~") COLUMN(NAME=~"caus_magazzino.codice~") COLUMN(NAME=~"tab_iva.per_aliquota~") COLUMN(NAME=~"articolo.codice~") COLUMN(NAME=~"documento.id_documento~") COLUMN(NAME=~"documento.sconto_finanziario~") COLUMN(NAME=~"documento.sconto_fin_incondizionato~") COLUMN(NAME=~"documento.sconto_fin_cassa~") COMPUTE(NAME=~"(select sum(val_spese) from cast_iva_documento  where id_documento=~~~"documento~~~".~~~"id_documento~~~") as tot_spese~") COMPUTE(NAME=~"(select sum(val_tot_iva_l) from cast_iva_documento where id_documento=~~~"documento~~~".~~~"id_documento~~~") as tot_iva~") COMPUTE(NAME=~"(select sum(val_tot_imp_l) from cast_iva_documento where id_documento=~~~"documento~~~".~~~"id_documento~~~") as tot_imponibile~") COLUMN(NAME=~"documento.num_progressivo~")    JOIN (LEFT=~"tot_magazzino.id_tot_magazzino~"    OP =~"=~"RIGHT=~"tot_mag_configurazione.id_tot_magazzino~"    OUTER1 =~"tot_magazzino.id_tot_magazzino~" )    JOIN (LEFT=~"tab_iva.id_tab_iva~"    OP =~"=~"RIGHT=~"riga_documento.id_tab_iva~"    OUTER2 =~"riga_documento.id_tab_iva~" )    JOIN (LEFT=~"riga_documento.id_caus_magazzino~"    OP =~"=~"RIGHT=~"tot_magazzino.id_caus_magazzino~" )    JOIN (LEFT=~"documento.id_documento~"    OP =~"=~"RIGHT=~"riga_documento.id_documento~" )    JOIN (LEFT=~"articolo.id_articolo~"    OP =~"=~"RIGHT=~"riga_documento.id_articolo~" )    JOIN (LEFT=~"orafo_titolo.id_metallo~"    OP =~"=~"RIGHT=~"orafo_metallo.id_metallo~" )    JOIN (LEFT=~"orafo_titolo.id_titolo~"    OP =~"=~"RIGHT=~"articolo.id_titolo~" )    JOIN (LEFT=~"documento.id_sog_commerciale~"    OP =~"=~"RIGHT=~"sog_commerciale_gen.id_sog_commerciale~" )    JOIN (LEFT=~"caus_magazzino.id_caus_magazzino~"    OP =~"=~"RIGHT=~"riga_documento.id_caus_magazzino~" )WHERE(    EXP1 =~"( ( ~~~"documento~~~".~~~"data_documento~~~"~"   OP =~">=~"    EXP2 =~":da_data )~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"( ~~~"documento~~~".~~~"data_documento~~~"~"   OP =~"<=~"    EXP2 =~":a_data ) )~" ) ) ARG(NAME = ~"da_data~" TYPE = date)  ARG(NAME = ~"a_data~" TYPE = date) " arguments=(("da_data", date),("a_data", date))  sort="documento_data_documento A documento_num_progressivo A " )
