 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"documento~" )  TABLE(NAME=~"orafo_scar_partita~" )  TABLE(NAME=~"riga_documento~" ) COLUMN(NAME=~"documento.id_documento~") COLUMN(NAME=~"documento.num_progressivo~") COLUMN(NAME=~"documento.num_documento~") COLUMN(NAME=~"documento.data_documento~") COLUMN(NAME=~"orafo_scar_partita.val_scarico~") COLUMN(NAME=~"riga_documento.peso_netto~") COLUMN(NAME=~"riga_documento.coef_calo~") COLUMN(NAME=~"riga_documento.num_riga~")    JOIN (LEFT=~"riga_documento.id_documento~"    OP =~"=~"RIGHT=~"documento.id_documento~" )    JOIN (LEFT=~"orafo_scar_partita.id_riga_documento~"    OP =~"=~"RIGHT=~"riga_documento.id_riga_partita~" )WHERE(    EXP1 =~"~~~"orafo_scar_partita~~~".~~~"id_partita~~~"~"   OP =~"=~"    EXP2 =~":id_partita~" ) ) ARG(NAME = ~"id_partita~" TYPE = number) " arguments=(("id_partita", number)) )
