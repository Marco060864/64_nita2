 column=(type=date updatewhereclause=yes name=documento_data_documento dbname="documento.data_documento" )
 column=(type=long updatewhereclause=yes identity=yes name=riga_documento_id_riga_documento dbname="riga_documento.id_riga_documento" )
 column=(type=decimal(0) updatewhereclause=yes name=riga_documento_num_riga dbname="riga_documento.num_riga" )
 column=(type=long updatewhereclause=yes identity=yes name=sog_commerciale_gen_id_sog_commerciale dbname="sog_commerciale_gen.id_sog_commerciale" )
 column=(type=char(8) updatewhereclause=yes name=sog_commerciale_gen_codice dbname="sog_commerciale_gen.codice" )
 column=(type=char(40) updatewhereclause=yes name=sog_commerciale_gen_rag_soc_1 dbname="sog_commerciale_gen.rag_soc_1" )
 column=(type=long updatewhereclause=yes identity=yes name=prof_documento_id_prof_documento dbname="prof_documento.id_prof_documento" )
 column=(type=char(8) updatewhereclause=yes name=prof_documento_codice dbname="prof_documento.codice" )
 column=(type=decimal(4) updatewhereclause=yes name=riga_documento_quantita dbname="riga_documento.quantita" )
 column=(type=decimal(4) updatewhereclause=yes name=riga_documento_peso_netto dbname="riga_documento.peso_netto" )
 column=(type=char(32) updatewhereclause=yes name=articolo_codice dbname="articolo.codice" )
 column=(type=char(2) updatewhereclause=yes name=orafo_metallo_codice dbname="orafo_metallo.codice" )
 column=(type=decimal(2) updatewhereclause=yes name=orafo_titolo_titolo dbname="orafo_titolo.titolo" )
 column=(type=decimal(4) updatewhereclause=yes name=riga_documento_calo dbname="riga_documento.calo" )
 column=(type=decimal(4) updatewhereclause=yes name=riga_documento_fino dbname="riga_documento.fino" )
 retrieve="  SELECT ~"documento~".~"id_documento~",   
         ~"documento~".~"num_progressivo~",   
         ~"documento~".~"data_registrazione~",   
         ~"documento~".~"num_documento~",   
         ~"documento~".~"data_documento~",   
         ~"riga_documento~".~"id_riga_documento~",   
         ~"riga_documento~".~"num_riga~",   
         ~"sog_commerciale_gen~".~"id_sog_commerciale~",   
         ~"sog_commerciale_gen~".~"codice~",   
         ~"sog_commerciale_gen~".~"rag_soc_1~",   
         ~"prof_documento~".~"id_prof_documento~",   
         ~"prof_documento~".~"codice~",   
         ~"riga_documento~".~"quantita~",   
         ~"riga_documento~".~"peso_netto~",   
         ~"articolo~".~"codice~",   
         ~"orafo_metallo~".~"codice~",   
         ~"orafo_titolo~".~"titolo~",   
         ~"riga_documento~".~"calo~",   
         ~"riga_documento~".~"fino~"  
    FROM ~"documento~",   
         ~"riga_documento~",   
         ~"sog_commerciale_gen~",   
         ~"prof_documento~",   
         ~"articolo~",   
         ~"orafo_metallo~",   
         ~"orafo_titolo~", 
			~"registro~"
   WHERE ( ~"riga_documento~".~"id_documento~" = ~"documento~".~"id_documento~" ) and  
         ( ~"documento~".~"id_sog_commerciale~" = ~"sog_commerciale_gen~".~"id_sog_commerciale~" ) and  
         ( ~"prof_documento~".~"id_prof_documento~" = ~"documento~".~"id_prof_documento~" ) and  
         ( ~"articolo~".~"id_articolo~" = ~"riga_documento~".~"id_articolo~" ) and  
         ( ~"orafo_titolo~".~"id_metallo~" = ~"orafo_metallo~".~"id_metallo~" ) and  
         ( ~"orafo_titolo~".~"id_titolo~" = ~"articolo~".~"id_titolo~" ) and 

			(~"registro~".~"id_registro~"=~"documento~".~"id_registro~") AND
 			
         ( ~"documento~".~"id_registro~" = :id_registro ) AND
 			( ~"documento~".~"id_registro~" <= :ll_reg_fine) AND  
         ( ~"documento~".~"data_documento~" >= :da_data ) AND  
         ( ~"documento~".~"data_documento~" <= :a_data )  AND   


         ( ~"sog_commerciale_gen~".~"codice~" >= :da_sog ) AND  
         ( ~"sog_commerciale_gen~".~"codice~" <= :a_sog ) AND  
         
         ( ~"prof_documento~".~"codice~" >= :da_prof ) AND  
         ( ~"prof_documento~".~"codice~" <= :a_prof ) AND  
         ( ~"registro~".~"tipo_registro~" >= :tipo_reg_da ) AND  
         ( ~"registro~".~"tipo_registro~" <= :tipo_reg_a )   




" arguments=(("id_registro", number),("ll_reg_fine", number),("da_data", date),("a_data", date),("da_sog", string),("a_sog", string),("da_prof", string),("a_prof", string),("tipo_reg_da", string),("tipo_reg_a", number))  sort="documento_data_documento A documento_num_documento A documento_id_documento A orafo_metallo_codice A " )
