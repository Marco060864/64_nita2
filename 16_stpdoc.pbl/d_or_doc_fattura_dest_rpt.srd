 column=(type=decimal(4) updatewhereclause=yes name=cast_iva_documento_val_spese dbname="cast_iva_documento.val_spese" )
 column=(type=long updatewhereclause=yes identity=yes name=id_documento dbname="documento.id_documento" )
 column=(type=long updatewhereclause=yes name=registro_id_esercizio dbname="registro.id_esercizio" )
 column=(type=long updatewhereclause=yes identity=yes name=registro_id_registro dbname="registro.id_registro" )
 column=(type=decimal(4) updatewhereclause=yes name=documento_cambio dbname="documento.cambio" )
 column=(type=decimal(4) updatewhereclause=yes name=cast_iva_documento_val_tot_imp_l dbname="cast_iva_documento.val_tot_imp_l" )
 column=(type=decimal(4) updatewhereclause=yes name=cast_iva_documento_val_tot_iva_l dbname="cast_iva_documento.val_tot_iva_l" )
 column=(type=decimal(4) updatewhereclause=yes name=qta dbname="qta" )
 column=(type=decimal(4) updatewhereclause=yes name=qta_evasa dbname="qta_evasa" )
 column=(type=decimal(4) updatewhereclause=yes name=peso_n dbname="peso_n" )
 column=(type=decimal(4) updatewhereclause=yes name=peso_n_evaso dbname="peso_n_evaso" )
 column=(type=char(5) updatewhereclause=yes name=valuta_simbolo dbname="valuta.simbolo" )
 column=(type=decimal(0) updatewhereclause=yes name=valuta_cifra_arrotondamento dbname="valuta.cifra_arrotondamento" )
 column=(type=long updatewhereclause=yes name=documento_id_valuta dbname="documento.id_valuta" )
 column=(type=long updatewhereclause=yes name=documento_id_destinazione dbname="documento.id_destinazione" )
 retrieve="SELECT ~"prof_documento~".~"codice~",   
         ~"sog_commerciale_gen~".~"codice~",   
         ~"sog_commerciale_gen~".~"rag_soc_1~",   
         ~"registro~".~"tipo_registro~",   
         ~"documento~".~"num_progressivo~",   
         ~"documento~".~"data_registrazione~",   
         ~"documento~".~"num_documento~",   
         ~"documento~".~"data_documento~",   
         ~"cast_iva_documento~".~"val_tot_imp_v~",   
         ~"cast_iva_documento~".~"val_tot_iva_v~",   
         ~"cast_iva_documento~".~"val_spese~",   
         ~"documento~".~"id_documento~",   
         ~"registro~".~"id_esercizio~",   
         ~"registro~".~"id_registro~",   
         ~"documento~".~"cambio~",   
         ~"cast_iva_documento~".~"val_tot_imp_l~",   
         ~"cast_iva_documento~".~"val_tot_iva_l~",   
         cast((select sum(quantita) from riga_documento where id_documento=~"documento~".~"id_documento~") as decimal) as qta,   
         cast((select sum(qta_evasa) from riga_documento where id_documento=~"documento~".~"id_documento~") as decimal) as qta_evasa,   
         cast((select sum(peso_netto) from riga_documento where id_documento=~"documento~".~"id_documento~") as decimal) as peso_n,   
         cast((select sum(peso_netto_evaso) from riga_documento where id_documento=~"documento~".~"id_documento~") as decimal) as peso_n_evaso,
			~"valuta~".~"simbolo~",
			~"valuta~".~"cifra_arrotondamento~",
			~"documento~".~"id_valuta~",
			~"documento~".~"id_destinazione~"

    FROM {oj ~"documento~"  LEFT OUTER JOIN ~"cast_iva_documento~"  ON ~"documento~".~"id_documento~" = ~"cast_iva_documento~".~"id_documento~"},   
         ~"registro~",   
         ~"sog_commerciale_gen~",   
         ~"prof_documento~",
			~"valuta~"  
   WHERE ( ~"registro~".~"id_registro~" = ~"documento~".~"id_registro~" ) and  
         ( ~"documento~".~"id_sog_commerciale~" = ~"sog_commerciale_gen~".~"id_sog_commerciale~" ) and  
         ( ~"prof_documento~".~"id_prof_documento~" = ~"documento~".~"id_prof_documento~" ) and  
         ( ~"documento~".~"id_valuta~"=~"valuta~".~"id_valuta~" ) and
			( ~"documento~".~"id_registro~" >= :ll_reg_ini ) AND  
         ( ~"documento~".~"id_registro~" <= :ll_reg_fine) AND  
         ( ~"documento~".~"data_documento~" >= :ldt_da_data ) AND  
         ( ~"documento~".~"data_documento~" <= :ldt_a_data ) AND  
         ( ~"sog_commerciale_gen~".~"codice~" >= :da_sog ) AND  
         ( ~"sog_commerciale_gen~".~"codice~" <= :a_sog ) AND  
         ( ~"registro~".~"id_esercizio~" >= :da_esercizio ) AND  
         ( ~"registro~".~"id_esercizio~" <= :a_esercizio ) AND  
         ( ~"prof_documento~".~"codice~" >= :da_prof ) AND  
         ( ~"prof_documento~".~"codice~" <= :a_prof ) AND  
         ( ~"registro~".~"tipo_registro~" >= :tipo_reg_da ) AND  
         ( ~"registro~".~"tipo_registro~" <= :tipo_reg_a )    
" arguments=(("ll_reg_ini", number),("ll_reg_fine", number),("ldt_da_data", date),("ldt_a_data", date),("da_sog", string),("a_sog", string),("da_esercizio", number),("a_esercizio", number),("da_prof", string),("a_prof", string),("tipo_reg_da", string),("tipo_reg_a", string))  sort="documento_data_documento A documento_data_documento A documento_num_progressivo A " )
