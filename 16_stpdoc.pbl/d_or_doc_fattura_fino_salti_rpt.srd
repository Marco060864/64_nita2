compute(band=detail alignment="1" expression="if(c_tipo_fattura<>'C',  if(isnull(calo_au), fino_au, fino_au+calo_au) ,  if(isnull(calo_au), fino_au, fino_au+calo_au) * - 1)"border="0" color="0" x="2560" y="4" height="64" width="311" format="#,0.00" html.valueishtml="0"  name=compute_1 visible="1~tif(peso_au<=0 or  id_documento = id_documento [-1],  0, 1)"  font.face="Arial" font.height="-8" font.weight="400"  font.family="2" font.pitch="2" font.charset="0" background.mode="2" background.color="16777215" )
compute(band=detail alignment="1" expression="if(c_tipo_fattura<>'C',  if(isnull(calo_ag), fino_ag, fino_ag+calo_ag) ,  if(isnull(calo_ag), fino_ag, fino_ag+calo_ag) * - 1)"border="0" color="0" x="3209" y="4" height="64" width="311" format="#,0.00" html.valueishtml="0"  name=compute_2 visible="1~tif(peso_ag<=0 or  id_documento = id_documento[-1] , 0, 1)"  font.face="Arial" font.height="-8" font.weight="400"  font.family="2" font.pitch="2" font.charset="0" background.mode="2" background.color="16777215" )
