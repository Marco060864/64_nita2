 column=(type=decimal(4) updatewhereclause=yes name=calo_ag dbname="calo_ag" )
 column=(type=decimal(4) updatewhereclause=yes name=calo_pt dbname="calo_pt" )
 column=(type=decimal(4) updatewhereclause=yes name=peso_au dbname="peso_au" )
 column=(type=decimal(4) updatewhereclause=yes name=peso_ag dbname="peso_ag" )
 column=(type=decimal(4) updatewhereclause=yes name=peso_pt dbname="peso_pt" )
 column=(type=char(5) updatewhereclause=yes name=valuta_simbolo dbname="valuta.simbolo" )
 column=(type=decimal(0) updatewhereclause=yes name=valuta_cifra_arrotondamento dbname="valuta.cifra_arrotondamento" )
 column=(type=long updatewhereclause=yes name=documento_id_valuta dbname="documento.id_valuta" )
 column=(type=decimal(4) updatewhereclause=yes name=tot_imp_valuta dbname="tot_imp_valuta" )
 column=(type=decimal(4) updatewhereclause=yes name=tot_iva_valuta dbname="tot_iva_valuta" )
 column=(type=decimal(4) updatewhereclause=yes name=tot_spese_valuta dbname="tot_spese_valuta" )
 column=(type=decimal(4) updatewhereclause=yes name=tot_imp_euro dbname="tot_imp_euro" )
 column=(type=decimal(4) updatewhereclause=yes name=tot_iva_euro dbname="tot_iva_euro" )
 column=(type=long updatewhereclause=yes name=c_bol_generate dbname="c_bol_generate" )
 column=(type=long updatewhereclause=yes name=c_num_righe_ordine dbname="c_num_righe_ordine" )
 column=(type=date updatewhereclause=yes name=documento_data_prev_consegna dbname="documento.data_prev_consegna" )
 retrieve="  SELECT ~"prof_documento~".~"codice~",   
         ~"sog_commerciale_gen~".~"codice~",   
         ~"sog_commerciale_gen~".~"rag_soc_1~",   
         ~"registro~".~"tipo_registro~",   
         ~"documento~".~"num_progressivo~",   
         ~"documento~".~"data_registrazione~",   
         ~"documento~".~"num_documento~",   
         ~"documento~".~"data_documento~",   
         
         ~"documento~".~"id_documento~",   
         ~"registro~".~"id_esercizio~",   
         ~"registro~".~"id_registro~",   
         ~"documento~".~"cambio~",   
           
         cast((select sum(quantita) from riga_documento where id_documento=~"documento~".~"id_documento~") as decimal) as qta,   
         cast((select sum(qta_evasa) from riga_documento where id_documento=~"documento~".~"id_documento~") as decimal) as qta_evasa,   
         cast((select sum(peso_netto) from riga_documento where id_documento=~"documento~".~"id_documento~") as decimal) as peso_n,   
         cast((select sum(peso_netto_evaso) from riga_documento where id_documento=~"documento~".~"id_documento~") as decimal) as peso_n_evaso,
cast((select sum(fino) from riga_documento, orafo_metallo, orafo_titolo, articolo where id_documento=~"documento~".~"id_documento~" 
			and orafo_metallo.id_metallo=orafo_titolo.id_metallo and riga_documento.id_articolo=articolo.id_articolo and 
			articolo.id_titolo=orafo_titolo.id_titolo
			and orafo_metallo.cod_int_met='O') as decimal) as fino_AU,
cast((select sum(fino) from riga_documento, orafo_metallo, orafo_titolo, articolo where id_documento=~"documento~".~"id_documento~" 
			and orafo_metallo.id_metallo=orafo_titolo.id_metallo and riga_documento.id_articolo=articolo.id_articolo and 
			articolo.id_titolo=orafo_titolo.id_titolo
			and orafo_metallo.cod_int_met='A') as decimal) as fino_AG,
cast((select sum(fino) from riga_documento, orafo_metallo, orafo_titolo, articolo where id_documento=~"documento~".~"id_documento~" 
			and orafo_metallo.id_metallo=orafo_titolo.id_metallo and riga_documento.id_articolo=articolo.id_articolo and 
			articolo.id_titolo=orafo_titolo.id_titolo
			and orafo_metallo.cod_int_met='P') as decimal) as fino_PT,
cast((select sum(calo) from riga_documento, orafo_metallo, orafo_titolo, articolo where id_documento=~"documento~".~"id_documento~" 
			and orafo_metallo.id_metallo=orafo_titolo.id_metallo and riga_documento.id_articolo=articolo.id_articolo and 
			articolo.id_titolo=orafo_titolo.id_titolo
			and orafo_metallo.cod_int_met='O') as decimal) as calo_AU,
cast((select sum(calo) from riga_documento, orafo_metallo, orafo_titolo, articolo where id_documento=~"documento~".~"id_documento~" 
			and orafo_metallo.id_metallo=orafo_titolo.id_metallo and riga_documento.id_articolo=articolo.id_articolo and 
			articolo.id_titolo=orafo_titolo.id_titolo
			and orafo_metallo.cod_int_met='A') as decimal) as calo_AG,
cast((select sum(calo) from riga_documento, orafo_metallo, orafo_titolo, articolo where id_documento=~"documento~".~"id_documento~" 
			and orafo_metallo.id_metallo=orafo_titolo.id_metallo and riga_documento.id_articolo=articolo.id_articolo and 
			articolo.id_titolo=orafo_titolo.id_titolo
			and orafo_metallo.cod_int_met='P') as decimal) as calo_PT,   	
cast((select sum(peso_netto) from riga_documento, orafo_metallo, orafo_titolo, articolo where id_documento=~"documento~".~"id_documento~" 
			and orafo_metallo.id_metallo=orafo_titolo.id_metallo and riga_documento.id_articolo=articolo.id_articolo and 
			articolo.id_titolo=orafo_titolo.id_titolo
			and orafo_metallo.cod_int_met='O') as decimal) as peso_AU,
cast((select sum(peso_netto) from riga_documento, orafo_metallo, orafo_titolo, articolo where id_documento=~"documento~".~"id_documento~" 
			and orafo_metallo.id_metallo=orafo_titolo.id_metallo and riga_documento.id_articolo=articolo.id_articolo and 
			articolo.id_titolo=orafo_titolo.id_titolo
			and orafo_metallo.cod_int_met='A') as decimal) as peso_AG,
cast((select sum(peso_netto) from riga_documento, orafo_metallo, orafo_titolo, articolo where id_documento=~"documento~".~"id_documento~" 
			and orafo_metallo.id_metallo=orafo_titolo.id_metallo and riga_documento.id_articolo=articolo.id_articolo and 
			articolo.id_titolo=orafo_titolo.id_titolo
			and orafo_metallo.cod_int_met='P') as decimal) as peso_PT,
		~"valuta~".~"simbolo~",
			~"valuta~".~"cifra_arrotondamento~",
			~"documento~".~"id_valuta~",
cast((select sum(val_tot_imp_v) from cast_iva_documento
 where id_documento=~"documento~".~"id_documento~") as decimal) as tot_imp_valuta, 
         cast((select sum(val_tot_iva_v) from cast_iva_documento
 where id_documento=~"documento~".~"id_documento~") as decimal) as tot_iva_valuta,   
         cast((select sum(val_spese) from cast_iva_documento
 where id_documento=~"documento~".~"id_documento~") as decimal) as tot_spese_valuta,  
 cast((select sum(val_tot_imp_l) from cast_iva_documento
 where id_documento=~"documento~".~"id_documento~") as decimal) as tot_imp_euro,  
          cast((select sum(val_tot_iva_l) from cast_iva_documento
 where id_documento=~"documento~".~"id_documento~") as decimal) as tot_iva_euro,

cast(( SELECT count(r2.id_riga_documento)
    FROM produzione_2011 p,   
         riga_documento r,   
         caus_magazzino,
produzione_2011 p2,
         riga_documento r2
   WHERE  r.id_documento = ~"documento~".~"id_documento~" and
            p.id_doc_produzione = r.id_riga_documento  AND  
         p.id_bollettina= p2.id_bollettina and
        p2.id_doc_produzione=r2.id_riga_documento and
caus_magazzino.id_caus_magazzino = r2.id_caus_magazzino  and  
             caus_magazzino.step_produzione = 'X'  ) as integer) as c_bol_generate,

cast((select count(riga_documento.id_riga_documento) from riga_documento where 
riga_documento.id_documento=~"documento~".~"id_documento~") as integer) as c_num_righe_ordine,
~"documento~".~"data_prev_consegna~"
		

    FROM ~"documento~",   
         ~"registro~",   
         ~"sog_commerciale_gen~",   
         ~"prof_documento~",
			~"valuta~"  
   WHERE ( ~"registro~".~"id_registro~" = ~"documento~".~"id_registro~" ) and  
         ( ~"documento~".~"id_sog_commerciale~" = ~"sog_commerciale_gen~".~"id_sog_commerciale~" ) and  
         ( ~"prof_documento~".~"id_prof_documento~" = ~"documento~".~"id_prof_documento~" ) and  
         ( ~"documento~".~"id_valuta~"=~"valuta~".~"id_valuta~" ) and
			( ~"documento~".~"id_registro~" >= :ll_reg_ini ) AND  
         ( ~"documento~".~"id_registro~" <= :ll_reg_fine) AND  
         ( ~"documento~".~"data_documento~" >= :ldt_da_data ) AND  
         ( ~"documento~".~"data_documento~" <= :ldt_a_data ) AND  
         ( ~"sog_commerciale_gen~".~"codice~" >= :da_sog ) AND  
         ( ~"sog_commerciale_gen~".~"codice~" <= :a_sog ) AND  
         ( ~"registro~".~"id_esercizio~" >= :da_esercizio ) AND  
         ( ~"registro~".~"id_esercizio~" <= :a_esercizio ) AND  
         ( ~"prof_documento~".~"codice~" >= :da_prof ) AND  
         ( ~"prof_documento~".~"codice~" <= :a_prof ) AND  
         ( ~"registro~".~"tipo_registro~" ='OV')

" arguments=(("ll_reg_ini", number),("ll_reg_fine", number),("ldt_da_data", date),("ldt_a_data", date),("da_sog", string),("a_sog", string),("da_esercizio", number),("a_esercizio", number),("da_prof", string),("a_prof", string),("tipo_reg_da", string),("tipo_reg_a", string))  sort="documento_data_prev_consegna A documento_data_documento A documento_num_documento A documento_num_progressivo A " )
