 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"tot_magazzino~" )  TABLE(NAME=~"tot_mag_configurazione~" )  TABLE(NAME=~"riga_documento~" )  TABLE(NAME=~"documento~" )  TABLE(NAME=~"articolo~" )  TABLE(NAME=~"orafo_metallo~" )  TABLE(NAME=~"orafo_titolo~" )  TABLE(NAME=~"caus_magazzino~" ) COLUMN(NAME=~"tot_magazzino.id_tot_magazzino~") COLUMN(NAME=~"tot_magazzino.id_caus_magazzino~") COLUMN(NAME=~"tot_magazzino.segno~") COLUMN(NAME=~"riga_documento.peso_netto~") COLUMN(NAME=~"riga_documento.calo~") COLUMN(NAME=~"riga_documento.fino~") COLUMN(NAME=~"tot_mag_configurazione.pesata~") COLUMN(NAME=~"tot_mag_configurazione.calo~") COLUMN(NAME=~"tot_mag_configurazione.fino~") COLUMN(NAME=~"tot_mag_configurazione.fino_calo~") COLUMN(NAME=~"tot_mag_configurazione.ordine~") COLUMN(NAME=~"tot_mag_configurazione.descrizione~") COLUMN(NAME=~"orafo_titolo.titolo~") COLUMN(NAME=~"orafo_metallo.codice~") COLUMN(NAME=~"orafo_metallo.prezioso~") COLUMN(NAME=~"documento.num_documento~") COLUMN(NAME=~"documento.data_documento~") COLUMN(NAME=~"riga_documento.num_riga~") COLUMN(NAME=~"caus_magazzino.codice~")    JOIN (LEFT=~"tot_magazzino.id_tot_magazzino~"    OP =~"=~"RIGHT=~"tot_mag_configurazione.id_tot_magazzino~"    OUTER1 =~"tot_magazzino.id_tot_magazzino~" )    JOIN (LEFT=~"riga_documento.id_caus_magazzino~"    OP =~"=~"RIGHT=~"tot_magazzino.id_caus_magazzino~" )    JOIN (LEFT=~"documento.id_documento~"    OP =~"=~"RIGHT=~"riga_documento.id_documento~" )    JOIN (LEFT=~"articolo.id_articolo~"    OP =~"=~"RIGHT=~"riga_documento.id_articolo~" )    JOIN (LEFT=~"orafo_titolo.id_metallo~"    OP =~"=~"RIGHT=~"orafo_metallo.id_metallo~" )    JOIN (LEFT=~"orafo_titolo.id_titolo~"    OP =~"=~"RIGHT=~"articolo.id_titolo~" )    JOIN (LEFT=~"tot_magazzino.id_caus_magazzino~"    OP =~"=~"RIGHT=~"caus_magazzino.id_caus_magazzino~" )WHERE(    EXP1 =~"( ( ~~~"documento~~~".~~~"data_documento~~~"~"   OP =~">=~"    EXP2 =~":da_data )~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"( ~~~"documento~~~".~~~"data_documento~~~"~"   OP =~"<=~"    EXP2 =~":a_data ) )~" ) ) ARG(NAME = ~"da_data~" TYPE = date)  ARG(NAME = ~"a_data~" TYPE = date) " arguments=(("da_data", date),("a_data", date))  sort="tot_mag_configurazione_ordine A orafo_metallo_codice A documento_data_documento A documento_num_documento A " )
