table(column=(type=char(8) updatewhereclause=yes name=prof_documento_codice dbname="prof_documento.codice" )
 column=(type=decimal(4) updatewhereclause=yes name=riga_documento_peso_netto dbname="riga_documento.peso_netto" )
 column=(type=decimal(2) update=yes updatewhereclause=yes name=riga_documento_coef_calo dbname="riga_documento.coef_calo" )
 column=(type=decimal(2) updatewhereclause=yes name=orafo_titolo_titolo dbname="orafo_titolo.titolo" )
 column=(type=decimal(4) update=yes updatewhereclause=yes name=riga_documento_calo dbname="riga_documento.calo" )
 column=(type=char(16) updatewhereclause=yes name=documento_num_documento dbname="documento.num_documento" )
 column=(type=decimal(0) updatewhereclause=yes name=documento_num_progressivo dbname="documento.num_progressivo" )
 column=(type=date updatewhereclause=yes name=documento_data_documento dbname="documento.data_documento" )
 column=(type=decimal(0) updatewhereclause=yes name=riga_documento_num_riga dbname="riga_documento.num_riga" )
 column=(type=long updatewhereclause=yes key=yes identity=yes name=id_riga_documento dbname="riga_documento.id_riga_documento" )
 retrieve="select p.codice, r.peso_netto, r.coef_calo, t.titolo, r.calo, d.num_documento, d.num_progressivo, d.data_documento, num_riga  , r.id_riga_documento
from riga_documento r, articolo a, orafo_titolo t , documento d , prof_documento p
where t.id_titolo=a.id_titolo and r.id_articolo=a.id_articolo
and t.titolo<>r.coef_calo and d.id_documento=r.id_documento
and d.id_sog_commerciale=:id_sog_comm and d.data_documento>20250101 and p.id_prof_documento=d.id_prof_documento
and d.id_prof_documento<>184 and r.peso_netto>0

order by d.data_documento
" update="riga_documento" updatewhere=1 updatekeyinplace=yes arguments=(("id_sog_comm", number)) )
