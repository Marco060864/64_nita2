 column=(type=char(32766) updatewhereclause=no name=riga_documento_descrizione dbname="riga_documento.descrizione" )
 column=(type=long updatewhereclause=yes identity=yes name=riga_documento_id_riga_documento dbname="riga_documento.id_riga_documento" )
 column=(type=char(32766) updatewhereclause=no name=riga_documento_descrizione dbname="riga_documento.descrizione" )
 column=(type=long updatewhereclause=yes name=documento_id_prof_documento dbname="documento.id_prof_documento" )
 column=(type=char(16) updatewhereclause=yes name=documento_num_documento dbname="documento.num_documento" )
 column=(type=date updatewhereclause=yes name=documento_data_documento dbname="documento.data_documento" )
 column=(type=long updatewhereclause=yes name=documento_id_prof_documento dbname="documento.id_prof_documento" )
 column=(type=char(16) updatewhereclause=yes name=documento_num_documento dbname="documento.num_documento" )
 column=(type=date updatewhereclause=yes name=documento_data_documento dbname="documento.data_documento" )
 column=(type=char(8) updatewhereclause=yes name=prof_documento_codice dbname="prof_documento.codice" )
 column=(type=char(8) updatewhereclause=yes name=prof_documento_codice dbname="prof_documento.codice" )
 column=(type=char(8) updatewhereclause=yes name=prof_documento_codice dbname="prof_documento.codice" )
 column=(type=char(174) updatewhereclause=yes name=c_galvint dbname="c_galvint" )
 column=(type=char(178) updatewhereclause=yes name=c_num_sald dbname="c_num_sald" )
 column=(type=char(174) updatewhereclause=yes name=c_buratto dbname="c_buratto" )
 column=(type=decimal(4) updatewhereclause=yes name=quantita dbname="riga_documento.quantita" )
 column=(type=decimal(4) updatewhereclause=yes name=quantita_1 dbname="riga_documento.quantita" )
 column=(type=decimal(4) updatewhereclause=yes name=quantita_2 dbname="riga_documento.quantita" )
 column=(type=decimal(4) updatewhereclause=yes name=riga_documento_peso_netto dbname="riga_documento.peso_netto" )
 column=(type=long updatewhereclause=yes name=riga_documento_id_articolo dbname="riga_documento.id_articolo" )
 column=(type=long updatewhereclause=yes name=c_visibile dbname="c_visibile" )
 column=(type=long updatewhereclause=yes name=c_id_sog_com_sald dbname="c_id_sog_com_sald" )
 column=(type=char(174) updatewhereclause=yes name=c_tlaser dbname="c_tlaser" )
 retrieve="  SELECT ~"documento_a~".~"id_documento~",   
         ~"documento_a~".~"id_prof_documento~",   
         ~"documento_a~".~"id_registro~",   
         ~"documento_a~".~"num_progressivo~",   
         ~"documento_a~".~"data_registrazione~",   
         ~"documento_a~".~"num_documento~",   
         ~"documento_a~".~"data_documento~",   
         ~"documento_a~".~"id_sog_commerciale~",   
         ~"documento_a~".~"data_prev_consegna~",   
         ~"riga_documento_a~".~"id_riga_documento~",   
         ~"riga_documento_a~".~"descrizione~",   
         ~"riga_documento_b~".~"descrizione~",   
         ~"riga_documento_c~".~"id_riga_documento~",   
         ~"riga_documento_c~".~"descrizione~",   
         ~"documento_b~".~"id_prof_documento~",   
         ~"documento_b~".~"num_documento~",   
         ~"documento_b~".~"data_documento~",   
         ~"documento_c~".~"id_prof_documento~",   
         ~"documento_c~".~"num_documento~",   
         ~"documento_c~".~"data_documento~",   
         ~"prof_documento_a~".~"codice~",   
         ~"prof_documento_b~".~"codice~",   
         ~"prof_documento_c~".~"codice~",   
         (select first(p.codice+' -  '+num_documento+ ' - '+string(data_documento)+' qt. '+str(r.quantita,6)) from documento d, riga_documento r, prof_documento p where r.id_documento=d.id_documento and p.id_prof_documento=d.id_prof_documento 
		and r.provv_imp_subage_2=riga_documento_a.id_riga_documento and d.id_prof_documento=170) as c_galvint,   
         (select first(p.codice+' -  '+num_documento+ ' - '+string(data_documento)+'-'+left(a.rag_soc_1,4)+' qt.'+str(r.quantita,6)) from documento d, riga_documento r, prof_documento p , sog_commerciale s, anagrafica a
where r.id_documento=d.id_documento and p.id_prof_documento=d.id_prof_documento and r.provv_imp_subage_2=riga_documento_a.id_riga_documento and s.id_sog_commerciale=d.id_sog_commerciale and a.id_anagrafica=s.id_anagrafica
 and d.id_prof_documento=130) as c_num_sald,   
         (select first(p.codice+' -  '+num_documento+ ' - '+string(data_documento)+' qt. '+str(r.quantita,6)) from documento d, riga_documento r, prof_documento p where r.id_documento=d.id_documento and p.id_prof_documento=d.id_prof_documento 
and r.provv_imp_subage_2=riga_documento_a.id_riga_documento and d.id_prof_documento=184) as c_buratto,   
         ~"riga_documento_a~".~"quantita~",   
         ~"riga_documento_b~".~"quantita~",   
         ~"riga_documento_c~".~"quantita~",   
         ~"riga_documento_a~".~"peso_netto~",   
         ~"riga_documento_a~".~"id_articolo~",   
         0 as c_visibile ,
	(select first( d.id_sog_commerciale) from documento d, riga_documento r where r.id_documento=d.id_documento and  r.provv_imp_subage_2=riga_documento_a.id_riga_documento and 
	 d.id_prof_documento=130) as C_ID_SOG_COM_SALD , (select first(p.codice+' -  '+num_documento+ ' - '+string(data_documento)+' qt. '+str(r.quantita,6)) from documento d, riga_documento r, prof_documento p where r.id_documento=d.id_documento and p.id_prof_documento=d.id_prof_documento 
and r.provv_imp_subage_2=riga_documento_a.id_riga_documento and d.id_prof_documento=194) as c_tlaser
    FROM {oj ~"riga_documento~" ~"riga_documento_a~" RIGHT OUTER JOIN ~"documento~" ~"documento_a~" ON ~"riga_documento_a~".~"id_documento~" = ~"documento_a~".~"id_documento~" LEFT OUTER JOIN ~"riga_documento~" ~"riga_documento_b~" ON
 ~"riga_documento_a~".~"id_riga_documento~" = ~"riga_documento_b~".~"id_riga_doc_provenienza~" LEFT OUTER JOIN ~"riga_documento~" ~"riga_documento_c~" ON ~"riga_documento_b~".~"id_riga_documento~" = ~"riga_documento_c~".~"id_riga_doc_provenienza~" 
LEFT OUTER JOIN ~"documento~" ~"documento_b~" ON ~"riga_documento_b~".~"id_documento~" = ~"documento_b~".~"id_documento~" LEFT OUTER JOIN ~"documento~" ~"documento_c~" ON ~"riga_documento_c~".~"id_documento~" = ~"documento_c~".~"id_documento~" 
LEFT OUTER JOIN ~"prof_documento~" ~"prof_documento_c~" ON ~"documento_c~".~"id_prof_documento~" = ~"prof_documento_c~".~"id_prof_documento~" LEFT OUTER JOIN ~"prof_documento~" ~"prof_documento_b~" 
ON ~"documento_b~".~"id_prof_documento~" = ~"prof_documento_b~".~"id_prof_documento~" LEFT OUTER JOIN ~"prof_documento~" ~"prof_documento_a~" ON ~"documento_a~".~"id_prof_documento~" = ~"prof_documento_a~".~"id_prof_documento~"} ,
registro 
   WHERE ( ~"documento_a~".~"data_documento~" >= :DA_DATA  ) AND  
         ( ~"documento_a~".~"data_documento~" <= :A_DATA  ) AND  
         (  ~"documento_a~".~"id_registro~" = registro.id_registro  )
and  (registro.id_mod_registro=54)    
" arguments=(("DA_DATA", date),("A_DATA", date))  sort="documento_data_documento A documento_data_prev_consegna D " )
