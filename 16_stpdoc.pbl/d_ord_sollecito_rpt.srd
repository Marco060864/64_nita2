footer(height=80 color="536870912" )
detail(height=84 color="536870912" )
table(column=(type=char(16) updatewhereclause=yes name=num_documento dbname="documento.num_documento" )
 column=(type=date updatewhereclause=yes name=documento_data_documento dbname="documento.data_documento" )
 column=(type=long updatewhereclause=yes name=id_documento dbname="documento.id_documento" )
 column=(type=char(8) updatewhereclause=yes name=sog_commerciale_codice dbname="sog_commerciale.codice" )
 column=(type=char(40) updatewhereclause=yes name=anagrafica_rag_soc_1 dbname="anagrafica.rag_soc_1" )
 column=(type=date updatewhereclause=yes name=data_prev_consegna dbname="documento.data_prev_consegna" )
 column=(type=char(2) updatewhereclause=yes name=riga_documento_sigla_prezzo dbname="riga_documento.sigla_prezzo" )
 column=(type=char(16) updatewhereclause=yes name=documento_num_documento dbname="documento.num_documento" )
 column=(type=char(40) updatewhereclause=yes name=azienda_rag_soc_1 dbname="azienda.rag_soc_1" )
 column=(type=char(40) updatewhereclause=yes name=sede_indirizzo dbname="sede.indirizzo" )
 column=(type=char(10) updatewhereclause=yes name=sede_cap dbname="sede.cap" )
 column=(type=char(40) updatewhereclause=yes name=sede_localita dbname="sede.localita" )
 column=(type=char(5) updatewhereclause=yes name=sede_provincia dbname="sede.provincia" )
 retrieve="  SELECT distinct ~"documento_a~".~"num_documento~",   
         ~"documento_a~".~"data_documento~", 
			~"documento_a~".~"id_documento~",  
         ~"sog_commerciale~".~"codice~",   
         ~"anagrafica~".~"rag_soc_1~",   
         ~"documento_a~".~"data_prev_consegna~",   
         ~"riga_documento_a~".~"sigla_prezzo~",   
         ~"documento_b~".~"num_documento~" ,
			~"azienda~".~"rag_soc_1~", ~"sede~".~"indirizzo~", 
~"sede~".~"cap~", ~"sede~".~"localita~", ~"sede~".~"provincia~"
    FROM ~"anagrafica~",   
         ~"documento~" ~"documento_a~",   
         ~"sog_commerciale~",   
         ~"prof_documento~",   
         ~"riga_documento~" ~"riga_documento_a~",   
         ~"ord_cli_fornitore~",   
         ~"riga_documento~" ~"riga_documento_b~",   
         ~"documento~" ~"documento_b~"  ,
  	~"azienda~", ~"sede~"  
   WHERE ( ~"sog_commerciale~".~"id_anagrafica~" = ~"anagrafica~".~"id_anagrafica~" ) and  
         ( ~"documento_a~".~"id_sog_commerciale~" = ~"sog_commerciale~".~"id_sog_commerciale~" ) and  
         ( ~"prof_documento~".~"id_prof_documento~" = ~"documento_a~".~"id_prof_documento~" ) and  
         ( ~"documento_a~".~"id_documento~" = ~"riga_documento_a~".~"id_documento~" ) and  
         ( ~"riga_documento_a~".~"id_riga_documento~" *= ~"ord_cli_fornitore~".~"id_riga_ord_fornitore~"  ) and  
         ( ~"ord_cli_fornitore~".~"id_riga_ord_cliente~" *= ~"riga_documento_b~".~"id_riga_documento~" ) and  
         ( ~"riga_documento_b~".~"id_documento~" *= ~"documento_b~".~"id_documento~" ) and  
         ( ( ~"documento_a~".~"data_prev_consegna~" >= :da_data_sc ) AND  
         ( ~"documento_a~".~"data_prev_consegna~" <= :a_data_sc ) AND  
         ( ~"anagrafica~".~"rag_soc_1~" >= :da_sog ) AND  
         ( ~"anagrafica~".~"rag_soc_1~" <= :a_sog ) AND  
         ( ~"documento_a~".~"data_prev_consegna~" is not null ) AND  
         ( ~"documento_a~".~"data_prev_consegna~" > date('1900/01/01') ) AND  
         ( ~"prof_documento~".~"tipo_registro~" = :tipo_registro ) )    
			and (~"azienda~".~"id_azienda~"= ~"documento_a~".~"id_azienda~") 
			and (~"azienda~".~"id_azienda~"= ~"sede~".~"id_azienda~")" arguments=(("da_data_sc", date),("a_data_sc", date),("da_sog", string),("a_sog", string),("tipo_registro", string),("nota", string))  sort="anagrafica_rag_soc_1 A data_prev_consegna A " )
