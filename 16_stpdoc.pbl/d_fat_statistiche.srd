 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"mov_iva~" )  TABLE(NAME=~"reg_pd~" )  TABLE(NAME=~"conto~" )  TABLE(NAME=~"tab_iva~" )  TABLE(NAME=~"registro~" )  TABLE(NAME=~"esercizio~" )  TABLE(NAME=~"anagrafica~" )  TABLE(NAME=~"sog_commerciale~" ) COLUMN(NAME=~"reg_pd.num_progressivo~") COLUMN(NAME=~"reg_pd.data_registrazione~") COLUMN(NAME=~"conto.codice~") COLUMN(NAME=~"conto.descrizione~") COLUMN(NAME=~"tab_iva.codice~") COLUMN(NAME=~"tab_iva.des_breve~") COLUMN(NAME=~"mov_iva.imponibile~") COLUMN(NAME=~"mov_iva.imposta~") COLUMN(NAME=~"reg_pd.segno_reg_iva~") COLUMN(NAME=~"registro.id_esercizio~") COLUMN(NAME=~"esercizio.codice~") COLUMN(NAME=~"reg_pd.id_valuta~") COLUMN(NAME=~"reg_pd.cambio~") COLUMN(NAME=~"anagrafica.cod_fiscale~") COLUMN(NAME=~"anagrafica.par_iva~") COLUMN(NAME=~"tab_iva.per_aliquota~") COLUMN(NAME=~"anagrafica.indirizzo~") COLUMN(NAME=~"anagrafica.cap~") COLUMN(NAME=~"anagrafica.localita~") COLUMN(NAME=~"anagrafica.provincia~") COLUMN(NAME=~"anagrafica.nazione~")    JOIN (LEFT=~"reg_pd.id_reg_pd~"    OP =~"=~"RIGHT=~"mov_iva.id_reg_pd~" )    JOIN (LEFT=~"conto.id_conto~"    OP =~"=~"RIGHT=~"reg_pd.id_conto~" )    JOIN (LEFT=~"tab_iva.id_tab_iva~"    OP =~"=~"RIGHT=~"mov_iva.id_tab_iva~" )    JOIN (LEFT=~"registro.id_registro~"    OP =~"=~"RIGHT=~"reg_pd.id_registro~" )    JOIN (LEFT=~"esercizio.id_esercizio~"    OP =~"=~"RIGHT=~"registro.id_esercizio~" )    JOIN (LEFT=~"sog_commerciale.id_anagrafica~"    OP =~"=~"RIGHT=~"anagrafica.id_anagrafica~" )    JOIN (LEFT=~"sog_commerciale.id_conto~"    OP =~"=~"RIGHT=~"conto.id_conto~" )WHERE(    EXP1 =~"~~~"reg_pd~~~".~~~"data_registrazione~~~"~"   OP =~">=~"    EXP2 =~":da_data~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"reg_pd~~~".~~~"data_registrazione~~~"~"   OP =~"<=~"    EXP2 =~":a_data~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"conto~~~".~~~"codice~~~"~"   OP =~">=~"    EXP2 =~":da_sog~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"conto~~~".~~~"codice~~~"~"   OP =~"<=~"    EXP2 =~":a_sog~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"esercizio~~~".~~~"codice~~~"~"   OP =~">=~"    EXP2 =~":da_ese~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"esercizio~~~".~~~"codice~~~"~"   OP =~"<=~"    EXP2 =~":a_ese~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"tab_iva~~~".~~~"codice~~~"~"   OP =~">=~"    EXP2 =~":da_iva~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"tab_iva~~~".~~~"codice~~~"~"   OP =~"<=~"    EXP2 =~":a_iva~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"registro~~~".~~~"tipo_registro~~~"~"   OP =~"=~"    EXP2 =~":tipo_reg~" ) ) ARG(NAME = ~"da_data~" TYPE = date)  ARG(NAME = ~"a_data~" TYPE = date)  ARG(NAME = ~"da_sog~" TYPE = string)  ARG(NAME = ~"a_sog~" TYPE = string)  ARG(NAME = ~"da_ese~" TYPE = string)  ARG(NAME = ~"a_ese~" TYPE = string)  ARG(NAME = ~"da_iva~" TYPE = string)  ARG(NAME = ~"a_iva~" TYPE = string)  ARG(NAME = ~"tipo_reg~" TYPE = string) " arguments=(("da_data", date),("a_data", date),("da_sog", string),("a_sog", string),("da_ese", string),("a_ese", string),("da_iva", string),("a_iva", string),("tipo_reg", string))  sort="conto_codice A reg_pd_data_registrazione A " )
