table(column=(type=long update=yes updatewhereclause=yes identity=yes name=riga_documento_id_riga_documento dbname="riga_documento.id_riga_documento" )
 column=(type=long updatewhereclause=yes name=riga_documento_id_documento dbname="riga_documento.id_documento" )
 column=(type=long updatewhereclause=yes name=riga_documento_id_articolo dbname="riga_documento.id_articolo" )
 column=(type=char(32) updatewhereclause=yes name=articolo_codice dbname="articolo.codice" )
 column=(type=decimal(4) updatewhereclause=yes name=quantita dbname="riga_documento.quantita" )
 column=(type=decimal(4) updatewhereclause=yes name=riga_documento_qta_un_base dbname="riga_documento.qta_un_base" )
 column=(type=decimal(4) updatewhereclause=yes name=peso_netto dbname="riga_documento.peso_netto" )
 column=(type=decimal(4) update=yes updatewhereclause=yes name=calo dbname="riga_documento.calo" )
 column=(type=decimal(2) update=yes updatewhereclause=yes name=coef_calo dbname="riga_documento.coef_calo" )
 column=(type=decimal(4) updatewhereclause=yes name=fino dbname="riga_documento.fino" )
 column=(type=decimal(4) updatewhereclause=yes name=peso_non_prezioso dbname="riga_documento.peso_non_prezioso" )
 column=(type=char(16) updatewhereclause=yes name=num_documento dbname="documento.num_documento" )
 column=(type=date updatewhereclause=yes name=data_documento dbname="documento.data_documento" )
 column=(type=char(1) updatewhereclause=yes name=caus_magazzino_segno dbname="caus_magazzino.segno" )
 column=(type=decimal(2) updatewhereclause=yes name=orafo_titolo_titolo dbname="orafo_titolo.titolo" )
 column=(type=char(2) updatewhereclause=yes name=orafo_metallo_codice dbname="orafo_metallo.codice" )
 column=(type=char(8) updatewhereclause=yes name=caus_magazzino_codice dbname="caus_magazzino.codice" )
 column=(type=decimal(0) updatewhereclause=yes name=num_riga dbname="riga_documento.num_riga" )
 column=(type=char(4) updatewhereclause=yes name=c_tipo_partita dbname="c_tipo_partita" )
 column=(type=char(40) updatewhereclause=yes name=c_rag_sociale dbname="c_rag_sociale" )
 column=(type=long updatewhereclause=yes identity=yes name=caus_magazzino_id_caus_magazzino dbname="caus_magazzino.id_caus_magazzino" )
 column=(type=decimal(2) updatewhereclause=yes name=c_prezzo_laccio dbname="c_prezzo_laccio" )
 column=(type=decimal(2) updatewhereclause=yes name=c_prezzo_filo_rame dbname="c_prezzo_filo_rame" )
 column=(type=decimal(0) updatewhereclause=yes name=riga_documento_num_riga dbname="riga_documento.num_riga" )
 column=(type=decimal(4) updatewhereclause=yes name=provv_imp_agente_2 dbname="riga_documento.provv_imp_agente_2" )
 column=(type=decimal(5) updatewhereclause=yes name=provv_imp_carea_2 dbname="riga_documento.provv_imp_carea_2" )
 column=(type=decimal(4) updatewhereclause=yes name=peso_lordo dbname="riga_documento.peso_lordo" )
 column=(type=long updatewhereclause=yes name=documento_id_prof_documento dbname="documento.id_prof_documento" )
 column=(type=decimal(2) updatewhereclause=yes name=c_correzione dbname="c_correzione" )
 column=(type=char(8) updatewhereclause=yes name=c_cod_cl_fo dbname="c_cod_cl_fo" )
 retrieve="  SELECT ~"riga_documento~".~"id_riga_documento~",   
         ~"riga_documento~".~"id_documento~",   
         ~"riga_documento~".~"id_articolo~",   
         ~"articolo~".~"codice~",   
         ~"riga_documento~".~"quantita~",   
         ~"riga_documento~".~"qta_un_base~",   
         ~"riga_documento~".~"peso_netto~",   
         ~"riga_documento~".~"calo~",   
         ~"riga_documento~".~"coef_calo~",   
         ~"riga_documento~".~"fino~",   
         ~"riga_documento~".~"peso_non_prezioso~",   
         ~"documento~".~"num_documento~",   
         ~"documento~".~"data_documento~",   
         ~"caus_magazzino~".~"segno~",   
         ~"orafo_titolo~".~"titolo~",   
         ~"orafo_metallo~".~"codice~",   
         ~"caus_magazzino~".~"codice~",   
         ~"riga_documento~".~"num_riga~",   
          (select cod_tipo_partita from orafo_tipo_partita where orafo_tipo_partita.id_tipo_partita = caus_magazzino.id_tipo_partita) as c_tipo_partita ,
            (select rag_soc_1 from sog_commerciale_gen WHERE id_sog_commerciale=documento.id_sog_commerciale) AS c_rag_sociale,
        ~"caus_magazzino~".~"id_caus_magazzino~" ,
		 fn_rec_prezzo_filo_rame('L', documento.~"data_documento~") as c_prezzo_laccio,   
         fn_rec_prezzo_filo_rame('F', documento.~"data_documento~") as c_prezzo_filo_rame,   
		 ~"riga_documento~".~"num_riga~",
		~"riga_documento~".~"provv_imp_agente_2~",   
         ~"riga_documento~".~"provv_imp_carea_2~",
		~"riga_documento~".~"peso_lordo~",
 		~"documento~".~"id_prof_documento~",
		 (select correzione from correzioni_k where id_riga_documento=riga_documento.id_riga_documento) as c_correzione,
(select codice from sog_commerciale WHERE id_sog_commerciale=documento.id_sog_commerciale) AS c_cod_cl_fo
    FROM ~"riga_documento~",   
         ~"documento~",   
         ~"articolo~",   
         ~"orafo_metallo~",   
         ~"orafo_titolo~" ,
        ~"caus_magazzino~" 
   WHERE ( ~"caus_magazzino~".~"id_caus_magazzino~" = ~"riga_documento~".~"id_caus_magazzino~" ) and  
         ( ~"documento~".~"id_documento~" = ~"riga_documento~".~"id_documento~" ) and  
         ( ~"articolo~".~"id_articolo~" = ~"riga_documento~".~"id_articolo~" ) and  
         ( ~"orafo_titolo~".~"id_metallo~" = ~"orafo_metallo~".~"id_metallo~" ) and  
         ( ~"orafo_titolo~".~"id_titolo~" = ~"articolo~".~"id_titolo~" ) and  
         ( ( ~"caus_magazzino~".~"segno~" is not null ) AND  
         (~"documento~".~"data_documento~" >= :da_data AND  
         ~"documento~".~"data_documento~" <= :a_data) ) 
order by   ~"orafo_metallo~".~"codice~",  ~"documento~".~"data_documento~",  ~"documento~".~"num_documento~",  ~"riga_documento~".~"num_riga~"

" arguments=(("da_data", date),("a_data", date),("saldo_precedente_peso", decimal),("saldo_precedente_fc", decimal))  sort="orafo_metallo_codice A data_documento A riga_documento_id_documento A caus_magazzino_segno A num_documento A num_riga A " )
