compute(band=detail alignment="0" expression="space(1) + '14'  +  right('0000000' + num_riga, 7)  + space(12) +  d_crea_sup  + '30000' +  importo_euro  + '-' + right('00000' + if(isnull(cod_abi), '00000', cod_abi), 5) +  right('00000' + if (isnull(cod_cab), '00000', cod_cab), 5) +  left( conto_corrente + '            ', 12) + right('00000' + if(isnull(cod_abi_c), '00000', cod_abi_c), 5)   + right('00000' + if(isnull(cod_cab_c), '00000', cod_cab_c), 5) + space(12) + left(codice_sia + '00000', 5) + '4' +left(codice + '                ', 16) + space(6) + codice_divisa"border="0" color="0" x="5563" y="12" height="76" width="2715" format="[general]"  name=rec_14  font.face="Arial" font.height="-8" font.weight="400"  font.family="2" font.pitch="2" font.charset="0" background.mode="2" background.color="16777215" )
