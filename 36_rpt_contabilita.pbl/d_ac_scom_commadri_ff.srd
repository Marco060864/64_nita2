~") COMPUTE(NAME=~"cast('' as char(40)) As c_magazzino_des~") COMPUTE(NAME=~"cast('' as char(8)) As c_condpag_cod~") COMPUTE(NAME=~"cast('' as char(40)) As c_condpag_des~") COMPUTE(NAME=~"cast('' as char(83)) As c_abi_cab_des~") COMPUTE(NAME=~"cast('' as char(1)) As c_cin~") COMPUTE(NAME=~"cast('' as char(20)) As c_conto_corrente~") COMPUTE(NAME=~"cast('' as char(8)) As c_vettore_cod~") COMPUTE(NAME=~"cast('' as char(40)) As c_vettore_des~") COMPUTE(NAME=~"cast('' as char(1)) As c_info~") COMPUTE(NAME=~"cast('' as char(1)) As c_conto_presente~") COMPUTE(NAME=~"cast('' as integer) As sm~")WHERE(    EXP1 =~"~~~"sog_commerciale~~~".~~~"id_anagrafica~~~"~"   OP =~"=~"    EXP2 =~":ri_id_anagrafica~" ) ) ARG(NAME = ~"ri_id_anagrafica~" TYPE = number) " update="sog_commerciale" updatewhere=1 updatekeyinplace=yes arguments=(("ri_id_anagrafica", number)) )
