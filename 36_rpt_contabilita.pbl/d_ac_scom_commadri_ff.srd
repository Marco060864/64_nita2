table(column=(type=long update=yes updatewhereclause=yes identity=yes name=id_sog_commerciale dbname="sog_commerciale.id_sog_commerciale" )
 column=(type=char(1) update=yes updatewhereclause=yes name=tipo dbname="sog_commerciale.tipo" values="Cliente	C/Fornitore	F/Agente	A/Vettore	V/Altro	Z/Cliente potenziale	P/" validation=" gettext()  = 'C' OR  gettext()  = 'F' OR  gettext()  = 'A' OR  gettext()  = 'V' OR  gettext()  = 'Z' OR  gettext()  = 'P'" validationmsg="'Inserire: C, F, A, V, P, Z'" )
 column=(type=char(8) update=yes updatewhereclause=yes key=yes name=codice dbname="sog_commerciale.codice" )
 column=(type=long update=yes updatewhereclause=yes name=id_anagrafica dbname="sog_commerciale.id_anagrafica" )
