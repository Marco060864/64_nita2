 column=(type=char(1) update=yes updatewhereclause=yes name=modo_fatturazione dbname="sog_commerciale.modo_fatturazione" values="In raggruppamento di bolle	R/Non in raggruppamento di bolle	N/" validation=" gettext()  = 'R' OR  gettext()  = 'N'" validationmsg="'Immettere: R, N'" )
 column=(type=char(1) update=yes updatewhereclause=yes name=con_fattura dbname="sog_commerciale.con_fattura" values="Come bolla di origine	O/In raggruppamento a parità di articolo	A/Con solo totale	T/" validation=" gettext()  = 'O' OR  gettext()  = 'A' OR  gettext()  = 'T'" validationmsg="'Immettere: O, A, T'" )
