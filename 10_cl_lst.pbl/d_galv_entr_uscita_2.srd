 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"documento~" ALIAS=~"documento_a~" )  TABLE(NAME=~"riga_documento~" ALIAS=~"riga_documento_a~" )  TABLE(NAME=~"caus_magazzino~" )  TABLE(NAME=~"documento~" ALIAS=~"documento_b~" )  TABLE(NAME=~"riga_documento~" ALIAS=~"riga_documento_b~" )  TABLE(NAME=~"documento~" ALIAS=~"documento_c~" )  TABLE(NAME=~"produzione_2011~" ) COLUMN(NAME=~"documento_a.id_documento~") COLUMN(NAME=~"documento_a.id_registro~") COLUMN(NAME=~"documento_a.id_prof_documento~") COLUMN(NAME=~"documento_a.num_progressivo~") COLUMN(NAME=~"documento_a.data_registrazione~") COLUMN(NAME=~"documento_a.num_documento~") COLUMN(NAME=~"documento_a.data_documento~") COLUMN(NAME=~"riga_documento_a.id_riga_documento~") COLUMN(NAME=~"riga_documento_a.num_riga~") COLUMN(NAME=~"riga_documento_a.id_articolo~") COLUMN(NAME=~"riga_documento_a.descrizione~") COLUMN(NAME=~"riga_documento_a.quantita~") COLUMN(NAME=~"riga_documento_a.peso_netto~") COLUMN(NAME=~"riga_documento_a.calo~") COLUMN(NAME=~"riga_documento_a.fino~") COLUMN(NAME=~"caus_magazzino.segno~") COLUMN(NAME=~"riga_documento_a.id_riga_doc_provenienza~") COLUMN(NAME=~"riga_documento_b.id_riga_documento~") COLUMN(NAME=~"riga_documento_b.num_riga~") COLUMN(NAME=~"documento_b.num_documento~") COLUMN(NAME=~"documento_b.data_documento~") COLUMN(NAME=~"documento_c.num_documento~") COLUMN(NAME=~"documento_b.id_documento~") COLUMN(NAME=~"documento_c.id_documento~")    JOIN (LEFT=~"documento_b.id_documento~"    OP =~"=~"RIGHT=~"riga_documento_b.id_documento~"    OUTER2 =~"riga_documento_b.id_documento~" )    JOIN (LEFT=~"riga_documento_a.id_riga_doc_provenienza~"    OP =~"=~"RIGHT=~"riga_documento_b.id_riga_documento~"    OUTER1 =~"riga_documento_a.id_riga_doc_provenienza~" )    JOIN (LEFT=~"riga_documento_a.id_riga_documento~"    OP =~"=~"RIGHT=~"produzione_2011.id_doc_produzione~"    OUTER1 =~"riga_documento_a.id_riga_documento~" )    JOIN (LEFT=~"produzione_2011.id_bollettina~"    OP =~"=~"RIGHT=~"documento_c.id_documento~"    OUTER1 =~"produzione_2011.id_bollettina~" )    JOIN (LEFT=~"riga_documento_a.id_documento~"    OP =~"=~"RIGHT=~"documento_a.id_documento~" )    JOIN (LEFT=~"riga_documento_a.id_caus_magazzino~"    OP =~"=~"RIGHT=~"caus_magazzino.id_caus_magazzino~" )WHERE(    EXP1 =~"(~~~"documento_a~~~".~~~"id_prof_documento~~~"~"   OP =~"=~"    EXP2 =~"159~"    LOGIC =~"or~" ) WHERE(    EXP1 =~"~~~"documento_a~~~".~~~"id_prof_documento~~~"~"   OP =~"=~"    EXP2 =~"160~"    LOGIC =~"or~" ) WHERE(    EXP1 =~"~~~"documento_a~~~".~~~"id_prof_documento~~~"~"   OP =~"=~"    EXP2 =~"150)~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"documento_a~~~".~~~"data_documento~~~"~"   OP =~">=~"    EXP2 =~":da_data~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"documento_a~~~".~~~"data_documento~~~"~"   OP =~"<=~"    EXP2 =~":a_data~" ) ) ORDER(NAME=~"documento_a.data_documento~" ASC=yes )  ORDER(NAME=~"documento_a.num_progressivo~" ASC=yes ) ARG(NAME = ~"da_data~" TYPE = date)  ARG(NAME = ~"a_data~" TYPE = date) " arguments=(("da_data", date),("a_data", date)) )
