 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"documento~" ALIAS=~"documento_a~" )  TABLE(NAME=~"riga_documento~" ALIAS=~"riga_documento_a~" )  TABLE(NAME=~"articolo~" )  TABLE(NAME=~"prof_documento~" )  TABLE(NAME=~"documento~" ALIAS=~"documento_b~" )  TABLE(NAME=~"riga_documento~" ALIAS=~"riga_documento_b~" ) COLUMN(NAME=~"documento_a.id_documento~") COLUMN(NAME=~"documento_a.num_documento~") COLUMN(NAME=~"documento_a.data_documento~") COLUMN(NAME=~"documento_a.num_progressivo~") COLUMN(NAME=~"articolo.codice~") COLUMN(NAME=~"riga_documento_a.id_riga_documento~") COLUMN(NAME=~"riga_documento_a.num_riga~") COLUMN(NAME=~"riga_documento_a.descrizione~") COLUMN(NAME=~"riga_documento_a.quantita~") COLUMN(NAME=~"riga_documento_a.peso_netto~") COLUMN(NAME=~"riga_documento_a.peso_lordo~") COLUMN(NAME=~"prof_documento.codice~") COLUMN(NAME=~"riga_documento_b.quantita~") COLUMN(NAME=~"riga_documento_b.peso_netto~") COLUMN(NAME=~"riga_documento_b.peso_lordo~") COLUMN(NAME=~"documento_b.id_prof_documento~") COLUMN(NAME=~"documento_b.num_progressivo~") COLUMN(NAME=~"documento_b.num_documento~") COLUMN(NAME=~"documento_b.data_documento~") COLUMN(NAME=~"riga_documento_b.num_riga~") COLUMN(NAME=~"riga_documento_b.id_riga_documento~") COLUMN(NAME=~"riga_documento_b.id_documento~")    JOIN (LEFT=~"riga_documento_a.id_documento~"    OP =~"=~"RIGHT=~"documento_a.id_documento~" )    JOIN (LEFT=~"articolo.id_articolo~"    OP =~"=~"RIGHT=~"riga_documento_a.id_articolo~" )    JOIN (LEFT=~"documento_a.id_prof_documento~"    OP =~"=~"RIGHT=~"prof_documento.id_prof_documento~" )    JOIN (LEFT=~"documento_b.id_documento~"    OP =~"=~"RIGHT=~"riga_documento_b.id_documento~" )    JOIN (LEFT=~"riga_documento_a.id_riga_documento~"    OP =~"=~"RIGHT=~"riga_documento_b.provv_imp_subage_2~" )WHERE(    EXP1 =~"(~~~"documento_a~~~".~~~"id_prof_documento~~~"~"   OP =~"=~"    EXP2 =~"65~"    LOGIC =~"or~" ) WHERE(    EXP1 =~"~~~"documento_a~~~".~~~"id_prof_documento~~~"~"   OP =~"=~"    EXP2 =~"111~"    LOGIC =~"or~" ) WHERE(    EXP1 =~"~~~"documento_a~~~".~~~"id_prof_documento~~~"~"   OP =~"=~"    EXP2 =~"112~"    LOGIC =~"or~" ) WHERE(    EXP1 =~"~~~"documento_a~~~".~~~"id_prof_documento~~~"~"   OP =~"=~"    EXP2 =~"113~"    LOGIC =~"or~" ) WHERE(    EXP1 =~"~~~"documento_a~~~".~~~"id_prof_documento~~~"~"   OP =~"=~"    EXP2 =~"99)~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"documento_b~~~".~~~"id_sog_commerciale~~~"~"   OP =~"=~"    EXP2 =~":id_sog~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"documento_b~~~".~~~"data_documento~~~"~"   OP =~">=~"    EXP2 =~":da_data~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"documento_b~~~".~~~"data_documento~~~"~"   OP =~"<=~"    EXP2 =~":a_data~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"documento_b~~~".~~~"chius_forzata~~~"~"   OP =~"<>~"    EXP2 =~"'S'~" ) ) ARG(NAME = ~"id_sog~" TYPE = number)  ARG(NAME = ~"da_data~" TYPE = date)  ARG(NAME = ~"a_data~" TYPE = date) " arguments=(("id_sog", number),("da_data", date),("a_data", date))  sort="documento_data_documento A documento_num_documento A " )
