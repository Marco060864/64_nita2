 column=(type=decimal(4) updatewhereclause=yes name=riga_documento_calo dbname="riga_documento.calo" dbalias=".calo" )
 column=(type=decimal(4) updatewhereclause=yes name=riga_documento_fino dbname="riga_documento.fino" dbalias=".fino" )
 column=(type=char(2) updatewhereclause=yes name=registro_tipo_registro dbname="registro.tipo_registro" dbalias=".tipo_registro" )
 column=(type=char(8) updatewhereclause=yes name=sog_commerciale_codice dbname="sog_commerciale.codice" dbalias=".codice" )
