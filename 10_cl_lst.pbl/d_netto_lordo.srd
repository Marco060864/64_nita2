 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"documento~" )  TABLE(NAME=~"riga_documento~" )  TABLE(NAME=~"orafo_par_sistema~" ) COLUMN(NAME=~"documento.id_documento~") COLUMN(NAME=~"documento.num_progressivo~") COLUMN(NAME=~"documento.data_registrazione~") COLUMN(NAME=~"documento.num_documento~") COLUMN(NAME=~"documento.data_documento~") COLUMN(NAME=~"documento.id_sog_commerciale~") COLUMN(NAME=~"riga_documento.id_riga_documento~") COLUMN(NAME=~"riga_documento.num_riga~") COLUMN(NAME=~"riga_documento.descrizione~") COLUMN(NAME=~"riga_documento.quantita~") COLUMN(NAME=~"riga_documento.peso_netto~") COLUMN(NAME=~"riga_documento.peso_lordo~") COLUMN(NAME=~"riga_documento.provv_imp_agente_2~") COLUMN(NAME=~"riga_documento.provv_imp_carea_2~") COLUMN(NAME=~"orafo_par_sistema.peso_laccio~") COLUMN(NAME=~"orafo_par_sistema.peso_filo_rame~")    JOIN (LEFT=~"riga_documento.id_documento~"    OP =~"=~"RIGHT=~"documento.id_documento~" )WHERE(    EXP1 =~"(~~~"documento~~~".~~~"id_prof_documento~~~"~"   OP =~"=~"    EXP2 =~"114~"    LOGIC =~"or~" ) WHERE(    EXP1 =~"~~~"documento~~~".~~~"id_prof_documento~~~"~"   OP =~"=~"    EXP2 =~"150~"    LOGIC =~"or~" ) WHERE(    EXP1 =~"~~~"documento~~~".~~~"id_prof_documento~~~"~"   OP =~"=~"    EXP2 =~"66)~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"documento~~~".~~~"id_sog_commerciale~~~"~"   OP =~"=~"    EXP2 =~"43~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"documento~~~".~~~"data_documento~~~"~"   OP =~">=~"    EXP2 =~":da_data~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"documento~~~".~~~"data_documento~~~"~"   OP =~"<=~"    EXP2 =~":a_data~" ) ) ORDER(NAME=~"documento.data_documento~" ASC=yes )  ORDER(NAME=~"documento.num_documento~" ASC=yes ) ARG(NAME = ~"da_data~" TYPE = date)  ARG(NAME = ~"a_data~" TYPE = date) " arguments=(("da_data", date),("a_data", date))  sort="documento_data_documento A documento_num_progressivo A documento_num_documento A " )
