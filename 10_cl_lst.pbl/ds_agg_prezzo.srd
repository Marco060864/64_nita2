 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"prezzo~" ) COLUMN(NAME=~"prezzo.id_unita_confezione~") COLUMN(NAME=~"prezzo.id_variazione~") COLUMN(NAME=~"prezzo.prezzo~") COLUMN(NAME=~"prezzo.prezzo_manifattura~") COLUMN(NAME=~"prezzo.coef_calo~") COLUMN(NAME=~"prezzo.galvanica~") COLUMN(NAME=~"prezzo.des_1~") COLUMN(NAME=~"prezzo.des_2~") COLUMN(NAME=~"prezzo.des_3~") COLUMN(NAME=~"prezzo.ultima_modifica~") COLUMN(NAME=~"prezzo.confermato~") COLUMN(NAME=~"prezzo.ins_automatico~")WHERE(    EXP1 =~"~~~"prezzo~~~".~~~"id_variazione~~~"~"   OP =~"=~"    EXP2 =~":id_var~" ) ) ARG(NAME = ~"id_var~" TYPE = number) " update="prezzo" updatewhere=1 updatekeyinplace=yes arguments=(("id_var", number)) )
