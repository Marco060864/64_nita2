table(column=(type=long updatewhereclause=yes identity=yes name=documento_id_documento dbname="documento.id_documento" )
 column=(type=decimal(0) updatewhereclause=yes name=documento_num_progressivo dbname="documento.num_progressivo" )
 column=(type=char(16) updatewhereclause=yes name=documento_num_documento dbname="documento.num_documento" )
 column=(type=date updatewhereclause=yes name=documento_data_documento dbname="documento.data_documento" )
 column=(type=long updatewhereclause=yes name=documento_id_sog_commerciale dbname="documento.id_sog_commerciale" )
 column=(type=long updatewhereclause=yes identity=yes name=riga_documento_id_riga_documento dbname="riga_documento.id_riga_documento" )
 column=(type=decimal(0) updatewhereclause=yes name=riga_documento_num_riga dbname="riga_documento.num_riga" )
 column=(type=long updatewhereclause=yes name=riga_documento_id_articolo dbname="riga_documento.id_articolo" )
 column=(type=char(32766) updatewhereclause=no name=riga_documento_descrizione dbname="riga_documento.descrizione" )
 column=(type=decimal(4) updatewhereclause=yes name=riga_documento_quantita dbname="riga_documento.quantita" )
 column=(type=char(64) updatewhereclause=yes name=articolo_codice dbname="articolo.codice" )
 column=(type=long updatewhereclause=yes name=riga_documento_id_caus_magazzino dbname="riga_documento.id_caus_magazzino" )
 column=(type=char(2) updatewhereclause=yes name=orafo_metallo_codice dbname="orafo_metallo.codice" )
 column=(type=char(40) updatewhereclause=yes name=orafo_metallo_descrizione dbname="orafo_metallo.descrizione" )
 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"articolo~" )  TABLE(NAME=~"documento~" )  TABLE(NAME=~"riga_documento~" )  TABLE(NAME=~"orafo_metallo~" )  TABLE(NAME=~"orafo_titolo~" ) COLUMN(NAME=~"documento.id_documento~") COLUMN(NAME=~"documento.num_progressivo~") COLUMN(NAME=~"documento.num_documento~") COLUMN(NAME=~"documento.data_documento~") COLUMN(NAME=~"documento.id_sog_commerciale~") COLUMN(NAME=~"riga_documento.id_riga_documento~") COLUMN(NAME=~"riga_documento.num_riga~") COLUMN(NAME=~"riga_documento.id_articolo~") COLUMN(NAME=~"riga_documento.descrizione~") COLUMN(NAME=~"riga_documento.quantita~") COLUMN(NAME=~"articolo.codice~") COLUMN(NAME=~"riga_documento.id_caus_magazzino~") COLUMN(NAME=~"orafo_metallo.codice~") COLUMN(NAME=~"orafo_metallo.descrizione~")    JOIN (LEFT=~"riga_documento.id_documento~"    OP =~"=~"RIGHT=~"documento.id_documento~" )    JOIN (LEFT=~"riga_documento.id_articolo~"    OP =~"=~"RIGHT=~"articolo.id_articolo~" )    JOIN (LEFT=~"orafo_titolo.id_metallo~"    OP =~"=~"RIGHT=~"orafo_metallo.id_metallo~" )    JOIN (LEFT=~"articolo.id_titolo~"    OP =~"=~"RIGHT=~"orafo_titolo.id_titolo~" )WHERE(    EXP1 =~"~~~"riga_documento~~~".~~~"id_caus_magazzino~~~"~"   OP =~"=~"    EXP2 =~"111~"    LOGIC =~"or~" ) WHERE(    EXP1 =~"~~~"riga_documento~~~".~~~"id_caus_magazzino~~~"~"   OP =~"=~"    EXP2 =~"112~" ) ) "  sort="articolo_codice A documento_data_documento A " )
