 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"documento~" )  TABLE(NAME=~"riga_documento~" ) COLUMN(NAME=~"documento.id_documento~") COLUMN(NAME=~"documento.id_prof_documento~") COLUMN(NAME=~"documento.num_progressivo~") COLUMN(NAME=~"documento.data_registrazione~") COLUMN(NAME=~"documento.num_documento~") COLUMN(NAME=~"documento.data_documento~") COLUMN(NAME=~"documento.id_sog_commerciale~") COLUMN(NAME=~"riga_documento.id_riga_documento~") COLUMN(NAME=~"riga_documento.num_riga~") COLUMN(NAME=~"riga_documento.id_articolo~") COLUMN(NAME=~"riga_documento.quantita~") COLUMN(NAME=~"riga_documento.peso_netto~") COLUMN(NAME=~"riga_documento.peso_lordo~")    JOIN (LEFT=~"riga_documento.id_documento~"    OP =~"=~"RIGHT=~"documento.id_documento~" )WHERE(    EXP1 =~"~~~"documento~~~".~~~"id_prof_documento~~~"~"   OP =~"=~"    EXP2 =~"50~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"riga_documento~~~".~~~"id_riga_doc_provenienza~~~"~"   OP =~">~"    EXP2 =~"0~" ) ) " update="riga_documento" updatewhere=1 updatekeyinplace=yes  sort="documento_num_progressivo A " )
