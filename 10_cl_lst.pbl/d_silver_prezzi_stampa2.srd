table(column=(type=long updatewhereclause=yes name=prezzo_id_unita_confezione dbname="prezzo.id_unita_confezione" dbalias=".id_unita_confezione" )
 column=(type=long updatewhereclause=yes name=prezzo_id_variazione dbname="prezzo.id_variazione" dbalias=".id_variazione" )
 column=(type=decimal(6) updatewhereclause=yes name=prezzo_prezzo dbname="prezzo.prezzo" dbalias=".prezzo" )
 column=(type=decimal(2) updatewhereclause=yes name=prezzo_coef_calo dbname="prezzo.coef_calo" dbalias=".coef_calo" )
 column=(type=decimal(6) updatewhereclause=yes name=prezzo_prezzo_manifattura dbname="prezzo.prezzo_manifattura" dbalias=".prezzo_manifattura" )
 column=(type=decimal(6) updatewhereclause=yes name=prezzo_costo_imballo dbname="prezzo.costo_imballo" dbalias=".costo_imballo" )
 column=(type=decimal(6) updatewhereclause=yes name=prezzo_galvanica dbname="prezzo.galvanica" dbalias=".galvanica" )
 column=(type=char(255) updatewhereclause=yes name=prezzo_des_1 dbname="prezzo.des_1" dbalias=".des_1" )
 column=(type=char(255) updatewhereclause=yes name=prezzo_des_2 dbname="prezzo.des_2" dbalias=".des_2" )
 column=(type=char(255) updatewhereclause=yes name=prezzo_des_3 dbname="prezzo.des_3" dbalias=".des_3" )
 column=(type=datetime updatewhereclause=yes name=prezzo_ultima_modifica dbname="prezzo.ultima_modifica" dbalias=".ultima_modifica" )
 column=(type=char(8) updatewhereclause=yes name=unita_confezione_codice dbname="unita_confezione.codice" dbalias=".codice" )
 column=(type=char(64) updatewhereclause=yes name=articolo_codice dbname="articolo.codice" dbalias=".codice" )
 column=(type=long updatewhereclause=yes identity=yes name=id_articolo dbname="articolo.id_articolo" dbalias=".id_articolo" )
 column=(type=char(1) updatewhereclause=yes name=prezzo_confermato dbname="prezzo.confermato" dbalias=".confermato" )
 column=(type=long updatewhereclause=yes name=c_scelto dbname="c_scelto" values="	1/	0" )
 column=(type=char(1) updatewhereclause=yes name=prezzo_ins_automatico dbname="prezzo.ins_automatico" dbalias=".ins_automatico" )
 column=(type=char(5) updatewhereclause=yes name=prezzo_cliente dbname="prezzo.cliente" dbalias=".cliente" )
 column=(type=char(80) updatewhereclause=yes name=articolo_descrizione dbname="articolo.descrizione" dbalias=".descrizione" )
 column=(type=decimal(6) updatewhereclause=yes name=c_controllato_k dbname="c_controllato_k" )
 column=(type=char(1) updatewhereclause=yes name=prezzo_scheda_tecnica dbname="prezzo.scheda_tecnica" dbalias=".scheda_tecnica" values="	S/	N" )
 column=(type=decimal(6) updatewhereclause=yes name=prezzo_pr_spazzolatura dbname="prezzo.pr_spazzolatura" dbalias=".pr_spazzolatura" )
 column=(type=char(1) updatewhereclause=yes name=unita_confezione_tipo_conversione dbname="unita_confezione.tipo_conversione" dbalias=".tipo_conversione" )
 column=(type=long updatewhereclause=yes name=prezzo_id_utente dbname="prezzo.id_utente" dbalias=".id_utente" )
 column=(type=datetime updatewhereclause=yes name=prezzo_ult_modifica_2 dbname="prezzo.ult_modifica_2" dbalias=".ult_modifica_2" )
 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"articolo~" )  TABLE(NAME=~"prezzo~" )  TABLE(NAME=~"unita_confezione~" ) COLUMN(NAME=~"prezzo.id_unita_confezione~") COLUMN(NAME=~"prezzo.id_variazione~") COLUMN(NAME=~"prezzo.prezzo~") COLUMN(NAME=~"prezzo.coef_calo~") COLUMN(NAME=~"prezzo.prezzo_manifattura~") COLUMN(NAME=~"prezzo.costo_imballo~") COLUMN(NAME=~"prezzo.galvanica~") COLUMN(NAME=~"prezzo.des_1~") COLUMN(NAME=~"prezzo.des_2~") COLUMN(NAME=~"prezzo.des_3~") COLUMN(NAME=~"prezzo.ultima_modifica~") COLUMN(NAME=~"unita_confezione.codice~") COLUMN(NAME=~"articolo.codice~") COLUMN(NAME=~"articolo.id_articolo~") COLUMN(NAME=~"prezzo.confermato~") COMPUTE(NAME=~"0 as c_scelto~") COLUMN(NAME=~"prezzo.ins_automatico~") COLUMN(NAME=~"prezzo.cliente~") COLUMN(NAME=~"articolo.descrizione~") COMPUTE(NAME=~"0.000001 as c_controllato_k~") COLUMN(NAME=~"prezzo.scheda_tecnica~") COLUMN(NAME=~"prezzo.pr_spazzolatura~") COLUMN(NAME=~"unita_confezione.tipo_conversione~") COLUMN(NAME=~"prezzo.id_utente~") COLUMN(NAME=~"prezzo.ult_modifica_2~")    JOIN (LEFT=~"unita_confezione.id_unita_confezione~"    OP =~"=~"RIGHT=~"prezzo.id_unita_confezione~" )    JOIN (LEFT=~"unita_confezione.id_articolo~"    OP =~"=~"RIGHT=~"articolo.id_articolo~" )WHERE(    EXP1 =~"( ( ~~~"prezzo~~~".~~~"id_variazione~~~"~"   OP =~"=~"    EXP2 =~":id_variazione ) )~" ) ) ARG(NAME = ~"id_variazione~" TYPE = number) " arguments=(("id_variazione", number)) )
