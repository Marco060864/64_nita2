 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"DBA.articolo~" )  TABLE(NAME=~"DBA.documento~" )  TABLE(NAME=~"DBA.riga_documento~" )  TABLE(NAME=~"DBA.orafo_metallo~" )  TABLE(NAME=~"DBA.orafo_titolo~" )  TABLE(NAME=~"DBA.registro~" )  TABLE(NAME=~"DBA.valuta~" )  TABLE(NAME=~"DBA.tab_iva~" ) COLUMN(NAME=~"DBA.articolo.id_articolo~") COLUMN(NAME=~"DBA.articolo.codice~") COLUMN(NAME=~"DBA.orafo_titolo.titolo~") COLUMN(NAME=~"DBA.orafo_metallo.codice~") COLUMN(NAME=~"DBA.orafo_metallo.id_metallo~") COLUMN(NAME=~"DBA.riga_documento.id_riga_documento~") COLUMN(NAME=~"DBA.riga_documento.id_documento~") COLUMN(NAME=~"DBA.riga_documento.num_riga~") COLUMN(NAME=~"DBA.riga_documento.descrizione~") COLUMN(NAME=~"DBA.riga_documento.quantita~") COLUMN(NAME=~"DBA.riga_documento.peso_netto~") COLUMN(NAME=~"DBA.riga_documento.calo~") COLUMN(NAME=~"DBA.riga_documento.fino~") COLUMN(NAME=~"DBA.riga_documento.prezzo_metallo~") COLUMN(NAME=~"DBA.riga_documento.prezzo_manifattura~") COLUMN(NAME=~"DBA.riga_documento.importo_manifattura~") COLUMN(NAME=~"DBA.riga_documento.importo_manifattura_val~") COLUMN(NAME=~"DBA.riga_documento.tot_riga_val_riga~") COLUMN(NAME=~"DBA.riga_documento.tot_riga_val_az~") COLUMN(NAME=~"DBA.documento.num_progressivo~") COLUMN(NAME=~"DBA.documento.data_registrazione~") COLUMN(NAME=~"DBA.documento.num_documento~") COLUMN(NAME=~"DBA.documento.data_documento~") COLUMN(NAME=~"DBA.documento.id_valuta~") COLUMN(NAME=~"DBA.valuta.codice~") COLUMN(NAME=~"DBA.documento.cambio~") COLUMN(NAME=~"DBA.tab_iva.codice~")    JOIN (LEFT=~"DBA.riga_documento.id_documento~"    OP =~"=~"RIGHT=~"DBA.documento.id_documento~" )    JOIN (LEFT=~"DBA.riga_documento.id_articolo~"    OP =~"=~"RIGHT=~"DBA.articolo.id_articolo~" )    JOIN (LEFT=~"DBA.orafo_titolo.id_metallo~"    OP =~"=~"RIGHT=~"DBA.orafo_metallo.id_metallo~" )    JOIN (LEFT=~"DBA.orafo_titolo.id_titolo~"    OP =~"=~"RIGHT=~"DBA.articolo.id_titolo~" )    JOIN (LEFT=~"DBA.documento.id_registro~"    OP =~"=~"RIGHT=~"DBA.registro.id_registro~" )    JOIN (LEFT=~"DBA.documento.id_valuta~"    OP =~"=~"RIGHT=~"DBA.valuta.id_valuta~" )    JOIN (LEFT=~"DBA.riga_documento.id_tab_iva~"    OP =~"=~"RIGHT=~"DBA.tab_iva.id_tab_iva~" )WHERE(    EXP1 =~"~~~"DBA~~~".~~~"registro~~~".~~~"tipo_registro~~~"~"   OP =~"=~"    EXP2 =~"'IV'~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"DBA~~~".~~~"documento~~~".~~~"data_documento~~~"~"   OP =~">=~"    EXP2 =~":da_data~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"DBA~~~".~~~"documento~~~".~~~"data_documento~~~"~"   OP =~"<=~"    EXP2 =~":a_data~" ) ) ORDER(NAME=~"DBA.orafo_metallo.codice~" ASC=yes )  ORDER(NAME=~"DBA.orafo_titolo.id_metallo~" ASC=yes )  ORDER(NAME=~"DBA.documento.data_documento~" ASC=yes )  ORDER(NAME=~"DBA.documento.num_documento~" ASC=yes ) ARG(NAME = ~"da_data~" TYPE = date)  ARG(NAME = ~"a_data~" TYPE = date) " arguments=(("da_data", date),("a_data", date)) )
