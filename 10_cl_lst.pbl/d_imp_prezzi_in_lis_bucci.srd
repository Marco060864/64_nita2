 column=(type=long update=yes updatewhereclause=yes key=yes identity=yes name=arianna_listino_id_art_listino dbname="arianna_listino.id_art_listino" dbalias="l.id_art_listino" )
 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"articolo~" ALIAS=~"a~" )  TABLE(NAME=~"unita_confezione~" ALIAS=~"u~" )  TABLE(NAME=~"arianna_listino~" ALIAS=~"l~" ) COLUMN(NAME=~"a.codice~") COLUMN(NAME=~"l.style~") COLUMN(NAME=~"l.prezzo~") COLUMN(NAME=~"u.id_unita_confezione~") COMPUTE(NAME=~"0 as scegli~") COLUMN(NAME=~"l.visible~") COLUMN(NAME=~"l.id_art_listino~")    JOIN (LEFT=~"l.style~"    OP =~"=~"RIGHT=~"a.codice~" )    JOIN (LEFT=~"u.id_articolo~"    OP =~"=~"RIGHT=~"a.id_articolo~" )WHERE(    EXP1 =~"u.unita_base~"   OP =~"=~"    EXP2 =~"'S'~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"l~~~".~~~"prezzo~~~"~"   OP =~">~"    EXP2 =~"0~" ) ) " update="arianna_listino" updatewhere=1 updatekeyinplace=yes filter=" visible ='S'" sort="arianna_listino_style A " )
