 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"documento~" )  TABLE(NAME=~"riga_documento~" )  TABLE(NAME=~"articolo~" ) COLUMN(NAME=~"documento.id_documento~") COLUMN(NAME=~"documento.num_documento~") COLUMN(NAME=~"documento.data_documento~") COLUMN(NAME=~"documento.num_progressivo~") COLUMN(NAME=~"articolo.codice~") COLUMN(NAME=~"riga_documento.id_riga_documento~") COLUMN(NAME=~"riga_documento.num_riga~") COLUMN(NAME=~"riga_documento.descrizione~") COLUMN(NAME=~"riga_documento.quantita~") COLUMN(NAME=~"riga_documento.peso_netto~") COLUMN(NAME=~"riga_documento.peso_lordo~") COLUMN(NAME=~"documento.id_prof_documento~") COLUMN(NAME=~"riga_documento.id_riga_doc_provenienza~")    JOIN (LEFT=~"riga_documento.id_documento~"    OP =~"=~"RIGHT=~"documento.id_documento~" )    JOIN (LEFT=~"articolo.id_articolo~"    OP =~"=~"RIGHT=~"riga_documento.id_articolo~" )WHERE(    EXP1 =~"~~~"riga_documento~~~".~~~"id_riga_doc_provenienza~~~"~"   OP =~"=~"    EXP2 =~":id_riga_bollettina~" ) ) ARG(NAME = ~"id_riga_bollettina~" TYPE = number) " arguments=(("id_riga_bollettina", number)) )
