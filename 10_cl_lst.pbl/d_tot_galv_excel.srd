table(column=(type=char(2) updatewhereclause=yes name=galvanica_lavorazione dbname="galvanica.lavorazione" )
 column=(type=decimal(4) updatewhereclause=yes name=galvanica_prezzo_gr dbname="galvanica.prezzo_gr" )
 column=(type=decimal(4) updatewhereclause=yes name=c_sum_peso dbname="c_sum_peso" )
 column=(type=char(32) updatewhereclause=yes name=galvanica_descrizione dbname="galvanica.descrizione" )
 column=(type=decimal(6) updatewhereclause=yes name=riga_documento_prezzo_metallo dbname="riga_documento.prezzo_metallo" )
 column=(type=decimal(4) updatewhereclause=yes name=c_sum_qta dbname="c_sum_qta" )
 column=(type=char(16) updatewhereclause=yes name=documento_num_documento dbname="documento.num_documento" )
 column=(type=date updatewhereclause=yes name=documento_data_documento dbname="documento.data_documento" )
 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"galvanica~" )  TABLE(NAME=~"riga_documento~" )  TABLE(NAME=~"documento~" )  TABLE(NAME=~"registro~" ) COLUMN(NAME=~"galvanica.lavorazione~") COLUMN(NAME=~"galvanica.prezzo_gr~") COMPUTE(NAME=~"sum(~~~"riga_documento~~~".~~~"peso_netto~~~" ) as c_sum_peso~") COLUMN(NAME=~"galvanica.descrizione~") COLUMN(NAME=~"riga_documento.prezzo_metallo~") COMPUTE(NAME=~"sum(~~~"riga_documento~~~".~~~"quantita~~~") as c_sum_qta~") COLUMN(NAME=~"documento.num_documento~") COLUMN(NAME=~"documento.data_documento~")    JOIN (LEFT=~"galvanica.id_galvanica~"    OP =~"=~"RIGHT=~"riga_documento.id_gruppo_agenti_2~" )    JOIN (LEFT=~"riga_documento.id_documento~"    OP =~"=~"RIGHT=~"documento.id_documento~" )    JOIN (LEFT=~"documento.id_registro~"    OP =~"=~"RIGHT=~"registro.id_registro~" )WHERE(    EXP1 =~"~~~"registro~~~".~~~"tipo_registro~~~"~"   OP =~"=~"    EXP2 =~"'IV'~" )  GROUP(NAME=~"galvanica.lavorazione~") GROUP(NAME=~"documento.num_documento~") GROUP(NAME=~"documento.data_documento~") GROUP(NAME=~"galvanica.prezzo_gr~") GROUP(NAME=~"galvanica.descrizione~") GROUP(NAME=~"riga_documento.prezzo_metallo~")) ORDER(NAME=~"documento.data_documento~" ASC=yes )  ORDER(NAME=~"documento.num_documento~" ASC=yes )  ORDER(NAME=~"galvanica.lavorazione~" ASC=yes )  ORDER(NAME=~"galvanica.prezzo_gr~" ASC=yes ) " )
