table(column=(type=char(8) updatewhereclause=yes name=sg_codice dbname="sog_commerciale_gen.codice" )
 column=(type=char(40) updatewhereclause=yes name=rag_soc_1 dbname="sog_commerciale_gen.rag_soc_1" )
 column=(type=char(16) updatewhereclause=yes name=num_documento dbname="documento.num_documento" )
 column=(type=date updatewhereclause=yes name=data_documento dbname="documento.data_documento" )
 column=(type=char(32) updatewhereclause=yes name=codice dbname="articolo.codice" )
 column=(type=char(32766) updatewhereclause=no name=descrizione dbname="riga_documento.descrizione" )
 column=(type=decimal(4) updatewhereclause=yes name=quantita dbname="riga_documento.quantita" )
 column=(type=decimal(4) updatewhereclause=yes name=peso_netto dbname="riga_documento.peso_netto" )
 column=(type=decimal(6) updatewhereclause=yes name=prezzo_complessivo dbname="riga_documento.prezzo_complessivo" )
 column=(type=char(1) updatewhereclause=yes name=tipo_calcolo dbname="provvigioni.tipo_calcolo" )
 column=(type=decimal(2) updatewhereclause=yes name=percentuale dbname="provvigioni.percentuale" )
 column=(type=decimal(4) updatewhereclause=yes name=val_fisso dbname="provvigioni.val_fisso" )
 column=(type=decimal(0) updatewhereclause=yes name=num_progressivo dbname="documento.num_progressivo" )
 column=(type=long updatewhereclause=yes name=id_prof_documento dbname="documento.id_prof_documento" )
 column=(type=decimal(4) updatewhereclause=yes name=cprezzo_acq dbname="cprezzo_acq" )
 column=(type=long updatewhereclause=yes name=riga_documento_id_documento dbname="riga_documento.id_documento" )
 column=(type=char(40) updatewhereclause=yes name=sconto_finanziario dbname="documento.sconto_finanziario" )
 column=(type=long updatewhereclause=yes name=documento_id_lingua dbname="documento.id_lingua" )
 column=(type=long updatewhereclause=yes name=provvigioni_id_sog_commerciale dbname="provvigioni.id_sog_commerciale" )
 retrieve="SELECT  ~"sog_commerciale_gen~".~"codice~" ,
           ~"sog_commerciale_gen~".~"rag_soc_1~" ,
           ~"documento~".~"num_documento~" ,
           ~"documento~".~"data_documento~" ,
           ~"articolo~".~"codice~" ,
           ~"riga_documento~".~"descrizione~" ,
           ~"riga_documento~".~"quantita~" ,
           ~"riga_documento~".~"peso_netto~" ,
           ~"riga_documento~".~"prezzo_complessivo~" ,
           ~"provvigioni~".~"tipo_calcolo~" ,
           ~"provvigioni~".~"percentuale~" ,
           ~"provvigioni~".~"val_fisso~" ,
           ~"documento~".~"num_progressivo~" ,
           ~"documento~".~"id_prof_documento~" ,
           cast((select prezzo   
        from prezzo 
        where id_variazione=  ~"provvigioni~".~"listino_acq~"  and 
 id_unita_confezione=~"riga_documento~".~"id_unita_confezione~") as decimal(18,
4)) as cprezzo_acq,
           ~"riga_documento~".~"id_documento~",
~"documento~".~"sconto_finanziario~",
~"documento~".~"id_lingua~",
~"provvigioni~".~"id_sog_commerciale~"

FROM {oj ~"riga_documento~" LEFT OUTER JOIN ~"articolo~" 
ON ~"riga_documento~".~"id_articolo~" = ~"articolo~".~"id_articolo~"} ,
           ~"provvigioni~" ,
           ~"lista_art_key~" ,
           ~"lista_profilo~" ,
           ~"documento~" ,
           ~"sog_commerciale_gen~"
  WHERE ( ~"provvigioni~".~"id_lista_articoli~" = ~"lista_art_key~".~"id_lista_articoli~" ) and      
    ( ~"provvigioni~".~"id_provvigioni~" = ~"lista_profilo~".~"id_provvigioni~" ) and   
       ( ~"riga_documento~".~"id_documento~" = ~"documento~".~"id_documento~" ) and     
     ( ~"lista_profilo~".~"id_prof_documento~" = ~"documento~".~"id_prof_documento~" ) and      
    ( ~"lista_art_key~".~"id_articolo~" = ~"riga_documento~".~"id_articolo~" ) and        
  ( ~"documento~".~"id_sog_commerciale~" = ~"sog_commerciale_gen~".~"id_sog_commerciale~" ) and   
       ( ~"documento~".~"id_lingua~" = ~"provvigioni~".~"id_lingua~" ) and     
     ( (  ~"sog_commerciale_gen~".~"codice~" >= :da_cod_sog  ) and  
        (  ~"sog_commerciale_gen~".~"codice~" <= :a_cod_sog  ) and  
        (  ~"documento~".~"data_documento~" >= :da_data  ) and      
    (  ~"documento~".~"data_documento~" <= :a_data  ) and  

   
   (  ~"documento~".~"data_documento~" >= ~"provvigioni~".~"data_valido~" ) and  
        (  ~"documento~".~"data_documento~" <= ~"provvigioni~".~"data_fine_valido~" )  
and (~"documento~".~"id_gruppo_agenti~"= :id_agente)
and (~"provvigioni~".~"id_sog_commerciale~"=:id_sog_comm_agente))


" arguments=(("id_agente", number),("da_cod_sog", string),("a_cod_sog", string),("da_data", date),("a_data", date),("id_sog_comm_agente", number)) )
