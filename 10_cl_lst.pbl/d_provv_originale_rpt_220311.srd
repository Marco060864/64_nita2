 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"riga_documento~" )  TABLE(NAME=~"articolo~" )  TABLE(NAME=~"provvigioni~" )  TABLE(NAME=~"lista_profilo~" )  TABLE(NAME=~"documento~" )  TABLE(NAME=~"sog_commerciale_gen~" ) COLUMN(NAME=~"sog_commerciale_gen.codice~") COLUMN(NAME=~"sog_commerciale_gen.rag_soc_1~") COLUMN(NAME=~"documento.num_documento~") COLUMN(NAME=~"documento.data_documento~") COLUMN(NAME=~"articolo.codice~") COLUMN(NAME=~"riga_documento.descrizione~") COLUMN(NAME=~"riga_documento.quantita~") COLUMN(NAME=~"riga_documento.peso_netto~") COLUMN(NAME=~"riga_documento.prezzo_complessivo~") COLUMN(NAME=~"provvigioni.tipo_calcolo~") COLUMN(NAME=~"provvigioni.percentuale~") COLUMN(NAME=~"provvigioni.val_fisso~") COLUMN(NAME=~"documento.num_progressivo~") COLUMN(NAME=~"documento.id_prof_documento~") COLUMN(NAME=~"riga_documento.id_documento~") COLUMN(NAME=~"documento.sconto_finanziario~") COLUMN(NAME=~"documento.id_lingua~") COLUMN(NAME=~"provvigioni.id_sog_commerciale~") COMPUTE(NAME=~"cast((select prezzo from prezzo where id_variazione=  ~~~"provvigioni~~~".~~~"listino_acq~~~"  and  id_unita_confezione=~~~"riga_documento~~~".~~~"id_unita_confezione~~~") as decimal(18,4)) as cprezzo_acq~")    JOIN (LEFT=~"provvigioni.id_lingua~"    OP =~"=~"RIGHT=~"documento.id_lingua~" )    JOIN (LEFT=~"provvigioni.id_provvigioni~"    OP =~"=~"RIGHT=~"lista_profilo.id_provvigioni~" )    JOIN (LEFT=~"riga_documento.id_documento~"    OP =~"=~"RIGHT=~"documento.id_documento~" )    JOIN (LEFT=~"lista_profilo.id_prof_documento~"    OP =~"=~"RIGHT=~"documento.id_prof_documento~" )    JOIN (LEFT=~"documento.id_sog_commerciale~"    OP =~"=~"RIGHT=~"sog_commerciale_gen.id_sog_commerciale~" )    JOIN (LEFT=~"riga_documento.id_articolo~"    OP =~"=~"RIGHT=~"articolo.id_articolo~" )    JOIN (LEFT=~"documento.data_documento~"    OP =~">=~"RIGHT=~"provvigioni.data_valido~" )    JOIN (LEFT=~"documento.data_documento~"    OP =~"<=~"RIGHT=~"provvigioni.data_fine_valido~" )WHERE(    EXP1 =~"(~~~"sog_commerciale_gen~~~".~~~"codice~~~"~"   OP =~">=~"    EXP2 =~":da_cod_sog)~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"(~~~"sog_commerciale_gen~~~".~~~"codice~~~"~"   OP =~"<=~"    EXP2 =~":a_cod_sog)~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"(~~~"documento~~~".~~~"data_documento~~~"~"   OP =~">=~"    EXP2 =~":da_data)~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"(~~~"documento~~~".~~~"data_documento~~~"~"   OP =~"<=~"    EXP2 =~":a_data)~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"(~~~"documento~~~".~~~"id_gruppo_agenti~~~"~"   OP =~"=~"    EXP2 =~":id_agente)~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"(~~~"provvigioni~~~".~~~"id_sog_commerciale~~~"~"   OP =~"=~"    EXP2 =~":id_sog_comm_agente)~" ) ) ARG(NAME = ~"id_agente~" TYPE = number)  ARG(NAME = ~"da_cod_sog~" TYPE = string)  ARG(NAME = ~"a_cod_sog~" TYPE = string)  ARG(NAME = ~"da_data~" TYPE = date)  ARG(NAME = ~"a_data~" TYPE = date)  ARG(NAME = ~"id_sog_comm_agente~" TYPE = number) " arguments=(("id_agente", number),("da_cod_sog", string),("a_cod_sog", string),("da_data", date),("a_data", date),("id_sog_comm_agente", number)) )
