to~"    OP =~"=~"RIGHT=~"documento.id_prof_documento~" )WHERE(    EXP1 =~"~~~"documento~~~".~~~"id_gruppo_agenti~~~"~"   OP =~"=~"    EXP2 =~":id_agente ~"    LOGIC =~"and~" ) WHERE(    EXP1 =~" ~~~"documento~~~".~~~"data_documento~~~"~"   OP =~">=~"    EXP2 =~":da_data ~"    LOGIC =~"and~" ) WHERE(    EXP1 =~" ~~~"documento~~~".~~~"data_documento~~~"~"   OP =~"<=~"    EXP2 =~":a_data ~"    LOGIC =~"and~" ) WHERE(    EXP1 =~" ~~~"documento~~~".~~~"data_documento~~~"~"   OP =~">=~"    EXP2 =~"~~~"provvigioni~~~".~~~"data_valido~~~"~"    LOGIC =~"and~" ) WHERE(    EXP1 =~" ~~~"documento~~~".~~~"data_documento~~~"~"   OP =~"<=~"    EXP2 =~"~~~"provvigioni~~~".~~~"data_fine_valido~~~"~" ) ) ARG(NAME = ~"id_agente~" TYPE = number)  ARG(NAME = ~"da_data~" TYPE = date)  ARG(NAME = ~"a_data~" TYPE = date)  ARG(NAME = ~"da_scadenza~" TYPE = date)  ARG(NAME = ~"a_scadenza~" TYPE = date) " arguments=(("id_agente", number),("da_data", date),("a_data", date),("da_scadenza", date),("a_scadenza", date))  sort="sog_commerciale_gen_rag_soc_1 A documento_data_documento A documento_num_documento A " )
