table(column=(type=char(16) updatewhereclause=yes name=num_documento dbname="documento.num_documento" )
 column=(type=date updatewhereclause=yes name=data_documento dbname="documento.data_documento" )
 column=(type=long updatewhereclause=yes name=id_documento dbname="documento.id_documento" )
 column=(type=char(13) updatewhereclause=yes name=num_bollettina dbname="c_codbarre" )
 column=(type=date updatewhereclause=yes name=data_prev_consegna dbname="documento.data_prev_consegna" )
 column=(type=decimal(4) updatewhereclause=yes name=c_tot_peso dbname="c_tot_peso" )
 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"documento~" ALIAS=~"documento_a~" )  TABLE(NAME=~"riga_documento~" ALIAS=~"riga_documento_a~" )  TABLE(NAME=~"riga_documento~" ALIAS=~"riga_documento_b~" )  TABLE(NAME=~"documento~" ALIAS=~"documento_b~" ) COLUMN(NAME=~"documento_a.num_documento~") COLUMN(NAME=~"documento_a.data_documento~") COLUMN(NAME=~"documento_a.id_documento~") COMPUTE(NAME=~"'             ' as c_codbarre~") COLUMN(NAME=~"documento_a.data_prev_consegna~") COMPUTE(NAME=~"sum(~~~"riga_documento_a~~~".~~~"peso_netto~~~" ) as c_tot_peso~")    JOIN (LEFT=~"riga_documento_a.id_documento~"    OP =~"=~"RIGHT=~"documento_a.id_documento~" )    JOIN (LEFT=~"riga_documento_a.provv_imp_subage_2~"    OP =~"=~"RIGHT=~"riga_documento_b.id_riga_documento~" )    JOIN (LEFT=~"riga_documento_b.id_documento~"    OP =~"=~"RIGHT=~"documento_b.id_documento~" )WHERE(    EXP1 =~"~~~"documento_a~~~".~~~"id_prof_documento~~~"~"   OP =~"=~"    EXP2 =~":id_prof~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"documento_a~~~".~~~"data_documento~~~"~"   OP =~"=~"    EXP2 =~":oggi~" )  GROUP(NAME=~"documento_a.id_documento~") GROUP(NAME=~"documento_a.num_documento~") GROUP(NAME=~"documento_a.data_documento~") GROUP(NAME=~"documento_a.data_prev_consegna~")) ARG(NAME = ~"id_prof~" TYPE = number)  ARG(NAME = ~"oggi~" TYPE = date) " arguments=(("id_prof", number),("oggi", date))  sort="data_documento A num_documento D " )
