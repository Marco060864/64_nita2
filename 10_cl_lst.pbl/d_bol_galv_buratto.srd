 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"bol_galv_buratto~" )  TABLE(NAME=~"documento~" ALIAS=~"documento_a~" )  TABLE(NAME=~"documento~" ALIAS=~"documento_b~" )  TABLE(NAME=~"riga_documento~" ) COLUMN(NAME=~"bol_galv_buratto.id_documento~") COLUMN(NAME=~"bol_galv_buratto.id_riga_bollettina~") COLUMN(NAME=~"documento_a.num_documento~") COLUMN(NAME=~"documento_a.data_documento~") COLUMN(NAME=~"documento_b.num_documento~")    JOIN (LEFT=~"documento_a.id_documento~"    OP =~"=~"RIGHT=~"bol_galv_buratto.id_documento~" )    JOIN (LEFT=~"riga_documento.id_riga_documento~"    OP =~"=~"RIGHT=~"bol_galv_buratto.id_riga_bollettina~" )    JOIN (LEFT=~"riga_documento.id_documento~"    OP =~"=~"RIGHT=~"documento_b.id_documento~" )WHERE(    EXP1 =~"~~~"documento_a~~~".~~~"data_documento~~~"~"   OP =~"=~"    EXP2 =~":ra_data~" ) ) ARG(NAME = ~"ra_data~" TYPE = date) " update="bol_galv_buratto" updatewhere=1 updatekeyinplace=yes arguments=(("ra_data", date))  sort="data_documento D num_documento D " )
