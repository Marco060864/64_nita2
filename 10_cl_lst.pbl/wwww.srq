PBSELECT( VERSION(400) TABLE(NAME="articolo" )  TABLE(NAME="unita_confezione" ) COLUMN(NAME="articolo.id_articolo") COLUMN(NAME="articolo.codice") COLUMN(NAME="unita_confezione.id_unita_confezione") COLUMN(NAME="unita_confezione.id_unita_misura") COLUMN(NAME="articolo.cod_intrastat")    JOIN (LEFT="unita_confezione.id_articolo"    OP ="="RIGHT="articolo.id_articolo" )WHERE(    EXP1 ="~"articolo~".~"id_articolo~""   OP ="="    EXP2 =":ll_id_art" ) ) ARG(NAME = "ll_id_art" TYPE = number) 