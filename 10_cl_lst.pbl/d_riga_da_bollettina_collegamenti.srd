 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"documento~" )  TABLE(NAME=~"riga_documento~" )  TABLE(NAME=~"prof_documento~" )  TABLE(NAME=~"sog_commerciale_gen~" ) COLUMN(NAME=~"riga_documento.id_riga_doc_provenienza~") COLUMN(NAME=~"riga_documento.id_riga_documento~") COLUMN(NAME=~"documento.id_documento~") COLUMN(NAME=~"documento.num_progressivo~") COLUMN(NAME=~"documento.data_registrazione~") COLUMN(NAME=~"documento.num_documento~") COLUMN(NAME=~"documento.data_documento~") COLUMN(NAME=~"riga_documento.num_riga~") COLUMN(NAME=~"riga_documento.descrizione~") COLUMN(NAME=~"riga_documento.qta_evasa~") COLUMN(NAME=~"riga_documento.quantita~") COLUMN(NAME=~"riga_documento.peso_netto~") COLUMN(NAME=~"riga_documento.peso_netto_evaso~") COLUMN(NAME=~"riga_documento.peso_non_prezioso~") COLUMN(NAME=~"riga_documento.provv_imp_subage_2~") COLUMN(NAME=~"prof_documento.id_prof_documento~") COLUMN(NAME=~"prof_documento.codice~") COLUMN(NAME=~"sog_commerciale_gen.id_sog_commerciale~") COLUMN(NAME=~"sog_commerciale_gen.codice~") COLUMN(NAME=~"sog_commerciale_gen.rag_soc_1~")    JOIN (LEFT=~"riga_documento.id_documento~"    OP =~"=~"RIGHT=~"documento.id_documento~" )    JOIN (LEFT=~"documento.id_prof_documento~"    OP =~"=~"RIGHT=~"prof_documento.id_prof_documento~" )    JOIN (LEFT=~"documento.id_sog_commerciale~"    OP =~"=~"RIGHT=~"sog_commerciale_gen.id_sog_commerciale~" )WHERE(    EXP1 =~"~~~"riga_documento~~~".~~~"provv_imp_subage_2~~~"~"   OP =~"=~"    EXP2 =~":id_riga~" ) ) ARG(NAME = ~"id_riga~" TYPE = number) " arguments=(("id_riga", number)) )
