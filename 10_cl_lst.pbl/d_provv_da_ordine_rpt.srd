 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"riga_documento~" )  TABLE(NAME=~"articolo~" )  TABLE(NAME=~"provvigioni~" )  TABLE(NAME=~"documento~" )  TABLE(NAME=~"sog_commerciale_gen~" )  TABLE(NAME=~"gruppo_agenti~" )  TABLE(NAME=~"registro~" )  TABLE(NAME=~"prof_documento~" ) COLUMN(NAME=~"sog_commerciale_gen.rag_soc_1~") COLUMN(NAME=~"documento.num_documento~") COLUMN(NAME=~"documento.data_documento~") COLUMN(NAME=~"articolo.codice~") COLUMN(NAME=~"riga_documento.descrizione~") COLUMN(NAME=~"riga_documento.quantita~") COLUMN(NAME=~"riga_documento.peso_netto~") COLUMN(NAME=~"riga_documento.prezzo_complessivo~") COLUMN(NAME=~"provvigioni.tipo_calcolo~") COLUMN(NAME=~"provvigioni.percentuale~") COLUMN(NAME=~"provvigioni.val_fisso~") COLUMN(NAME=~"documento.num_progressivo~") COLUMN(NAME=~"documento.id_prof_documento~") COMPUTE(NAME=~"cast((select prezzo   from prezzo where id_variazione=  ~~~"provvigioni~~~".~~~"listino_acq~~~"  and  id_unita_confezione=~~~"riga_documento~~~".~~~"id_unita_confezione~~~") as decimal(18,4)) as cprezzo_acq~") COLUMN(NAME=~"riga_documento.id_documento~") COLUMN(NAME=~"documento.id_gruppo_agenti~") COLUMN(NAME=~"gruppo_agenti.descrizione~") COLUMN(NAME=~"sog_commerciale_gen.id_sog_commerciale~") COLUMN(NAME=~"sog_commerciale_gen.codice~") COLUMN(NAME=~"articolo.id_articolo~") COLUMN(NAME=~"prof_documento.codice~")    JOIN (LEFT=~"riga_documento.id_articolo~"    OP =~"=~"RIGHT=~"articolo.id_articolo~"    OUTER1 =~"riga_documento.id_articolo~" )    JOIN (LEFT=~"riga_documento.id_documento~"    OP =~"=~"RIGHT=~"documento.id_documento~" )    JOIN (LEFT=~"documento.id_sog_commerciale~"    OP =~"=~"RIGHT=~"sog_commerciale_gen.id_sog_commerciale~" )    JOIN (LEFT=~"gruppo_agenti.id_gruppo_agenti~"    OP =~"=~"RIGHT=~"documento.id_gruppo_agenti~" )    JOIN (LEFT=~"registro.id_registro~"    OP =~"=~"RIGHT=~"documento.id_registro~" )    JOIN (LEFT=~"provvigioni.id_sog_commerciale~"    OP =~"=~"RIGHT=~"gruppo_agenti.id_sog_com_capo_area~" )    JOIN (LEFT=~"prof_documento.id_prof_documento~"    OP =~"=~"RIGHT=~"documento.id_prof_documento~" )WHERE(    EXP1 =~"~~~"documento~~~".~~~"id_gruppo_agenti~~~"~"   OP =~"=~"    EXP2 =~":id_agente ~"    LOGIC =~"and~" ) WHERE(    EXP1 =~" ~~~"documento~~~".~~~"data_documento~~~"~"   OP =~">=~"    EXP2 =~":da_data ~"    LOGIC =~"and~" ) WHERE(    EXP1 =~" ~~~"documento~~~".~~~"data_documento~~~"~"   OP =~"<=~"    EXP2 =~":a_data ~"    LOGIC =~"and~" ) WHERE(    EXP1 =~" ~~~"documento~~~".~~~"data_documento~~~"~"   OP =~">=~"    EXP2 =~"~~~"provvigioni~~~".~~~"data_valido~~~"~"    LOGIC =~"and~" ) WHERE(    EXP1 =~" ~~~"documento~~~".~~~"data_documento~~~"~"   OP =~"<=~"    EXP2 =~"~~~"provvigioni~~~".~~~"data_fine_valido~~~"~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"registro~~~".~~~"tipo_registro~~~"~"   OP =~"=~"    EXP2 =~"'OV'~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"documento~~~".~~~"evaso_totalmente~~~"~"   OP =~"<>~"    EXP2 =~"'S'~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"documento~~~".~~~"chius_forzata~~~"~"   OP =~"<>~"    EXP2 =~"'S'~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"documento~~~".~~~"sospeso~~~"~"   OP =~"<>~"    EXP2 =~"'S'~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"riga_documento~~~".~~~"forza_chius_evasione~~~"~"   OP =~"<>~"    EXP2 =~"'S'~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"(~~~"riga_documento~~~".~~~"quantita~~~"~"   OP =~">~"    EXP2 =~"~~~"riga_documento~~~".~~~"qta_evasa~~~"~"    LOGIC =~"or~" ) WHERE(    EXP1 =~"~~~"riga_documento~~~".~~~"peso_netto~~~"~"   OP =~">~"    EXP2 =~"~~~"riga_documento~~~".~~~"peso_netto_evaso~~~")~" ) ) ARG(NAME = ~"id_agente~" TYPE = number)  ARG(NAME = ~"da_data~" TYPE = date)  ARG(NAME = ~"a_data~" TYPE = date) " arguments=(("id_agente", number),("da_data", date),("a_data", date))  sort="sog_commerciale_gen_rag_soc_1 A documento_data_documento A documento_num_documento A " )
