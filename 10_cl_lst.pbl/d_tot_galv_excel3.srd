table(column=(type=decimal(6) updatewhereclause=yes name=c_01 dbname="c_01" )
 column=(type=char(2) updatewhereclause=yes name=galvanica_lavorazione dbname="galvanica.lavorazione" )
 column=(type=char(16) updatewhereclause=yes name=documento_num_documento dbname="documento.num_documento" )
 column=(type=date updatewhereclause=yes name=documento_data_documento dbname="documento.data_documento" )
 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"galvanica~" )  TABLE(NAME=~"riga_documento~" )  TABLE(NAME=~"documento~" )  TABLE(NAME=~"registro~" ) COMPUTE(NAME=~"~~~"riga_documento~~~".~~~"prezzo_metallo~~~" * sum(~~~"riga_documento~~~".~~~"peso_netto~~~" ) as c_01~") COLUMN(NAME=~"galvanica.lavorazione~") COLUMN(NAME=~"documento.num_documento~") COLUMN(NAME=~"documento.data_documento~")    JOIN (LEFT=~"galvanica.id_galvanica~"    OP =~"=~"RIGHT=~"riga_documento.id_gruppo_agenti_2~" )    JOIN (LEFT=~"riga_documento.id_documento~"    OP =~"=~"RIGHT=~"documento.id_documento~" )    JOIN (LEFT=~"documento.id_registro~"    OP =~"=~"RIGHT=~"registro.id_registro~" )WHERE(    EXP1 =~"( ( ~~~"registro~~~".~~~"tipo_registro~~~"~"   OP =~"=~"    EXP2 =~"'IV' )~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"( ~~~"documento~~~".~~~"data_documento~~~"~"   OP =~">=~"    EXP2 =~"'2019-06-29' )~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"( ~~~"documento~~~".~~~"data_documento~~~"~"   OP =~"<=~"    EXP2 =~"'2019-06-29' ) )~" )  GROUP(NAME=~"galvanica.lavorazione~") GROUP(NAME=~"riga_documento.prezzo_metallo~") GROUP(NAME=~"documento.num_documento~") GROUP(NAME=~"documento.data_documento~")) ORDER(NAME=~"galvanica.lavorazione~" ASC=yes )  ORDER(NAME=~"documento.data_documento~" ASC=yes )  ORDER(NAME=~"documento.data_documento~" ASC=yes ) " )
