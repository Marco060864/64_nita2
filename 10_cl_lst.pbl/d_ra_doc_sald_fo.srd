table(column=(type=long updatewhereclause=yes identity=yes name=id_documento dbname="documento.id_documento" )
 column=(type=long updatewhereclause=yes name=documento_id_prof_documento dbname="documento.id_prof_documento" )
 column=(type=long updatewhereclause=yes name=documento_id_registro dbname="documento.id_registro" )
 column=(type=decimal(0) updatewhereclause=yes name=documento_num_progressivo dbname="documento.num_progressivo" )
 column=(type=date updatewhereclause=yes name=documento_data_registrazione dbname="documento.data_registrazione" )
 column=(type=char(16) updatewhereclause=yes name=num_documento dbname="documento.num_documento" )
 column=(type=date updatewhereclause=yes name=data_documento dbname="documento.data_documento" )
 column=(type=long updatewhereclause=yes name=documento_id_sog_commerciale dbname="documento.id_sog_commerciale" )
 column=(type=char(8) updatewhereclause=yes name=sog_commerciale_gen_codice dbname="sog_commerciale_gen.codice" )
 column=(type=char(40) updatewhereclause=yes name=sog_commerciale_gen_rag_soc_1 dbname="sog_commerciale_gen.rag_soc_1" )
 column=(type=char(8) updatewhereclause=yes name=prof_documento_codice dbname="prof_documento.codice" )
 column=(type=char(1) updatewhereclause=yes name=documento_evaso_totalmente dbname="documento.evaso_totalmente" )
 column=(type=char(1) updatewhereclause=yes name=documento_scarica_ogni_titolo dbname="documento.scarica_ogni_titolo" values="	S/	N" )
 column=(type=decimal(4) updatewhereclause=yes name=peso_netto dbname="documento.peso_netto" )
 column=(type=char(40) updatewhereclause=yes name=des_contabile dbname="documento.des_contabile" )
 column=(type=long updatewhereclause=yes name=c_num_riga dbname="documento.id_prof_registrazione" )
 column=(type=char(1) updatewhereclause=yes name=lunedi dbname="prof_documento.ric_lingua_linguaggio" values="	L/	0" )
 column=(type=char(1) updatewhereclause=yes name=martedi dbname="prof_documento.ric_id_listino" values="	M/	0" )
 column=(type=char(1) updatewhereclause=yes name=mercoledi dbname="prof_documento.ric_id_con_pagamento" values="	W/	0" )
 column=(type=char(1) updatewhereclause=yes name=giovedi dbname="prof_documento.ric_scadenze" values="	G/	0" )
 column=(type=char(1) updatewhereclause=yes name=venerdi dbname="prof_documento.ric_id_sog_comm_agente" values="	V/	0" )
 column=(type=char(1) updatewhereclause=yes name=sabato dbname="prof_documento.ric_provvigioni" values="	S/	0" )
 column=(type=decimal(6) updatewhereclause=yes name=imp_avanzo_acconto dbname="documento.imp_avanzo_acconto" )
 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"documento~" )  TABLE(NAME=~"sog_commerciale_gen~" )  TABLE(NAME=~"prof_documento~" )  TABLE(NAME=~"registro~" ) COLUMN(NAME=~"documento.id_documento~") COLUMN(NAME=~"documento.id_prof_documento~") COLUMN(NAME=~"documento.id_registro~") COLUMN(NAME=~"documento.num_progressivo~") COLUMN(NAME=~"documento.data_registrazione~") COLUMN(NAME=~"documento.num_documento~") COLUMN(NAME=~"documento.data_documento~") COLUMN(NAME=~"documento.id_sog_commerciale~") COLUMN(NAME=~"sog_commerciale_gen.codice~") COLUMN(NAME=~"sog_commerciale_gen.rag_soc_1~") COLUMN(NAME=~"prof_documento.codice~") COLUMN(NAME=~"documento.evaso_totalmente~") COLUMN(NAME=~"documento.scarica_ogni_titolo~") COLUMN(NAME=~"documento.peso_netto~") COLUMN(NAME=~"documento.des_contabile~") COLUMN(NAME=~"documento.id_prof_registrazione~") COLUMN(NAME=~"prof_documento.ric_lingua_linguaggio~") COLUMN(NAME=~"prof_documento.ric_id_listino~") COLUMN(NAME=~"prof_documento.ric_id_con_pagamento~") COLUMN(NAME=~"prof_documento.ric_scadenze~") COLUMN(NAME=~"prof_documento.ric_id_sog_comm_agente~") COLUMN(NAME=~"prof_documento.ric_provvigioni~") COLUMN(NAME=~"documento.imp_avanzo_acconto~")    JOIN (LEFT=~"documento.id_sog_commerciale~"    OP =~"=~"RIGHT=~"sog_commerciale_gen.id_sog_commerciale~" )    JOIN (LEFT=~"documento.id_prof_documento~"    OP =~"=~"RIGHT=~"prof_documento.id_prof_documento~" )    JOIN (LEFT=~"documento.id_registro~"    OP =~"=~"RIGHT=~"registro.id_registro~" )WHERE(    EXP1 =~"(~~~"documento~~~".~~~"evaso_totalmente~~~"~"   OP =~"is~"    EXP2 =~"null~"    LOGIC =~"or~" ) WHERE(    EXP1 =~"~~~"documento~~~".~~~"evaso_totalmente~~~"~"   OP =~"=~"    EXP2 =~"'N')~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"documento~~~".~~~"id_documento~~~"~"   OP =~"=~"    EXP2 =~":id_doc~" ) ) ARG(NAME = ~"id_doc~" TYPE = number) " arguments=(("id_doc", number))  sort="c_num_riga D " )
