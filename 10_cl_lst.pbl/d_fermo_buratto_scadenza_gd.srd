compute(band=detail alignment="0" expression="if( c_giorno =~"Lunedi~", 1,
if ( c_giorno=~"Martedi~", 2 ,
if( c_giorno=~"Mercoledi~", 3 ,
if( c_giorno=~"Giovedi~", 4 ,
