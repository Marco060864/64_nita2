PIPELINE(source_connect=NITA,destination_connect=NITA,type=update,commit=100,errors=100,keyname="dipendente_copy")
SOURCE(name="dipendente",COLUMN(type=long,name="id_dipendente",dbtype="integer",key=yes,nulls_allowed=no)
 COLUMN(type=varchar,name="nome",dbtype="varchar(32)",nulls_allowed=no)
 COLUMN(type=varchar,name="cognome",dbtype="varchar(48)",nulls_allowed=no)
 COLUMN(type=varchar,name="nota",dbtype="varchar(255)",nulls_allowed=yes)
 COLUMN(type=long,name="codice",dbtype="integer",nulls_allowed=no)
 COLUMN(type=varchar,name="barcode",dbtype="varchar(128)",nulls_allowed=no)
 COLUMN(type=varchar,name="cod_dip_paghe",dbtype="varchar(10)",nulls_allowed=yes)
 COLUMN(type=varchar,name="num_rap_paghe",dbtype="varchar(3)",nulls_allowed=yes)
 COLUMN(type=varchar,name="in_uso",dbtype="varchar(1)",nulls_allowed=yes))
RETRIEVE(statement="SELECT ~"dipendente~".~"id_dipendente~", ~"dipendente~".~"nome~", ~"dipendente~".~"cognome~", ~"dipendente~".~"nota~", ~"dipendente~".~"codice~", ~"dipendente~".~"barcode~", ~"dipendente~".~"cod_dip_paghe~", ~"dipendente~".~"num_rap_paghe~", ~"dipendente~".~"in_uso~" FROM ~"dipendente~"")
DESTINATION(name="dipendente_copy",COLUMN(type=long,name="id_dipendente",dbtype="integer",key=yes,nulls_allowed=no,initial_value="0")
 COLUMN(type=varchar,name="nome",dbtype="varchar(32)",nulls_allowed=no,initial_value="spaces")
 COLUMN(type=varchar,name="cognome",dbtype="varchar(48)",nulls_allowed=no,initial_value="spaces")
 COLUMN(type=varchar,name="nota",dbtype="varchar(255)",nulls_allowed=yes)
 COLUMN(type=long,name="codice",dbtype="integer",nulls_allowed=no,initial_value="0")
 COLUMN(type=varchar,name="barcode",dbtype="varchar(128)",nulls_allowed=no,initial_value="spaces")
 COLUMN(type=varchar,name="cod_dip_paghe",dbtype="varchar(10)",nulls_allowed=yes)
 COLUMN(type=varchar,name="num_rap_paghe",dbtype="varchar(3)",nulls_allowed=yes)
 COLUMN(type=varchar,name="in_uso",dbtype="varchar(1)",nulls_allowed=yes))
