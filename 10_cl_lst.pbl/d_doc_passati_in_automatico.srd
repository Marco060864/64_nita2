table(column=(type=long updatewhereclause=yes identity=yes name=id_documento dbname="documento.id_documento" )
 column=(type=long updatewhereclause=yes name=id_prof_documento dbname="documento.id_prof_documento" )
 column=(type=long updatewhereclause=yes name=id_registro dbname="documento.id_registro" )
 column=(type=decimal(0) updatewhereclause=yes name=num_progressivo dbname="documento.num_progressivo" )
 column=(type=date updatewhereclause=yes name=data_registrazione dbname="documento.data_registrazione" )
 column=(type=char(16) updatewhereclause=yes name=num_documento dbname="documento.num_documento" )
 column=(type=date updatewhereclause=yes name=data_documento dbname="documento.data_documento" )
 column=(type=char(8) updatewhereclause=yes name=prof_documento_codice dbname="prof_documento.codice" )
 column=(type=decimal(4) updatewhereclause=yes name=c_peso_totale dbname="c_peso_totale" )
 column=(type=char(40) updatewhereclause=yes name=documento_origine dbname="documento.origine" )
 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"documento~" )  TABLE(NAME=~"prof_documento~" ) COLUMN(NAME=~"documento.id_documento~") COLUMN(NAME=~"documento.id_prof_documento~") COLUMN(NAME=~"documento.id_registro~") COLUMN(NAME=~"documento.num_progressivo~") COLUMN(NAME=~"documento.data_registrazione~") COLUMN(NAME=~"documento.num_documento~") COLUMN(NAME=~"documento.data_documento~") COLUMN(NAME=~"prof_documento.codice~") COMPUTE(NAME=~"(select sum(peso_netto) from dba.riga_documento where id_documento=~~~"documento~~~".~~~"id_documento~~~") as c_peso_totale~") COLUMN(NAME=~"documento.origine~")    JOIN (LEFT=~"documento.id_prof_documento~"    OP =~"=~"RIGHT=~"prof_documento.id_prof_documento~" )WHERE(    EXP1 =~"~~~"documento~~~".~~~"origine~~~"~"   OP =~"like~"    EXP2 =~"'PDA%'~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"documento~~~".~~~"data_documento~~~"~"   OP =~">=~"    EXP2 =~":da_data~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"documento~~~".~~~"data_documento~~~"~"   OP =~"<=~"    EXP2 =~":a_data~" ) ) ARG(NAME = ~"da_data~" TYPE = date)  ARG(NAME = ~"a_data~" TYPE = date) " arguments=(("da_data", date),("a_data", date))  sort="data_documento D num_progressivo D " )
