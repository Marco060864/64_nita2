 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"articolo~" )  TABLE(NAME=~"documento~" ALIAS=~"documento_a~" )  TABLE(NAME=~"riga_documento~" ALIAS=~"riga_documento_a~" )  TABLE(NAME=~"documento~" ALIAS=~"documento_b~" )  TABLE(NAME=~"riga_documento~" ALIAS=~"riga_documento_b~" ) COLUMN(NAME=~"documento_a.id_documento~") COLUMN(NAME=~"documento_a.num_progressivo~") COLUMN(NAME=~"documento_a.num_documento~") COLUMN(NAME=~"documento_a.data_documento~") COLUMN(NAME=~"riga_documento_a.id_riga_documento~") COLUMN(NAME=~"riga_documento_a.id_unita_confezione~") COLUMN(NAME=~"riga_documento_a.num_riga~") COLUMN(NAME=~"riga_documento_a.quantita~") COLUMN(NAME=~"articolo.id_articolo~") COLUMN(NAME=~"articolo.codice~") COLUMN(NAME=~"riga_documento_a.descrizione~") COLUMN(NAME=~"riga_documento_a.peso_netto~") COLUMN(NAME=~"documento_a.id_prof_documento~") COLUMN(NAME=~"documento_b.num_documento~") COLUMN(NAME=~"documento_b.data_prev_consegna~") COLUMN(NAME=~"riga_documento_b.id_gruppo_agenti_2~")    JOIN (LEFT=~"riga_documento_a.id_documento~"    OP =~"=~"RIGHT=~"documento_a.id_documento~" )    JOIN (LEFT=~"riga_documento_a.id_articolo~"    OP =~"=~"RIGHT=~"articolo.id_articolo~" )    JOIN (LEFT=~"documento_b.id_documento~"    OP =~"=~"RIGHT=~"riga_documento_b.id_documento~" )    JOIN (LEFT=~"riga_documento_a.provv_imp_subage_2~"    OP =~"=~"RIGHT=~"riga_documento_b.id_riga_documento~" )WHERE(    EXP1 =~"(~~~"documento_a~~~".~~~"id_prof_documento~~~"~"   OP =~"=~"    EXP2 =~":ll_prof_1~"    LOGIC =~"or~" ) WHERE(    EXP1 =~"~~~"documento_a~~~".~~~"id_prof_documento~~~"~"   OP =~"=~"    EXP2 =~":ll_prof_2)~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"documento_a~~~".~~~"data_documento~~~"~"   OP =~">=~"    EXP2 =~"20220101~" ) ) ARG(NAME = ~"ll_prof_1~" TYPE = number)  ARG(NAME = ~"ll_prof_2~" TYPE = number) " arguments=(("ll_prof_1", number),("ll_prof_2", number)) )
