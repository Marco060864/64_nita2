table(column=(type=char(16) updatewhereclause=yes name=documento_num_documento dbname="documento.num_documento" )
 column=(type=decimal(0) updatewhereclause=yes name=documento_num_progressivo dbname="documento.num_progressivo" )
 column=(type=long updatewhereclause=yes name=documento_id_prof_documento dbname="documento.id_prof_documento" )
 column=(type=decimal(4) updatewhereclause=yes name=riga_documento_quantita dbname="riga_documento.quantita" )
 column=(type=date updatewhereclause=yes name=documento_data_documento dbname="documento.data_documento" )
 column=(type=char(8) updatewhereclause=yes name=prof_documento_codice dbname="prof_documento.codice" )
 column=(type=long updatewhereclause=yes identity=yes name=documento_id_documento dbname="documento.id_documento" )
 column=(type=decimal(0) updatewhereclause=yes name=riga_documento_num_riga dbname="riga_documento.num_riga" )
 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"documento~" ALIAS=~"d~" )  TABLE(NAME=~"riga_documento~" ALIAS=~"r~" )  TABLE(NAME=~"prof_documento~" ) COLUMN(NAME=~"d.num_documento~") COLUMN(NAME=~"d.num_progressivo~") COLUMN(NAME=~"d.id_prof_documento~") COLUMN(NAME=~"r.quantita~") COLUMN(NAME=~"d.data_documento~") COLUMN(NAME=~"prof_documento.codice~") COLUMN(NAME=~"d.id_documento~") COLUMN(NAME=~"r.num_riga~")    JOIN (LEFT=~"d.id_documento~"    OP =~"=~"RIGHT=~"r.id_documento~" )    JOIN (LEFT=~"d.id_prof_documento~"    OP =~"=~"RIGHT=~"prof_documento.id_prof_documento~" )WHERE(    EXP1 =~"r.peso_netto~"   OP =~"=~"    EXP2 =~"0.01~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"D.DATA_DOCUMENTO~"   OP =~">~"    EXP2 =~"DATE('2019-01-01')~" ) ) ORDER(NAME=~"d.data_documento~" ASC=yes )  ORDER(NAME=~"d.num_progressivo~" ASC=yes ) " )
