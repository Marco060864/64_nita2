table(column=(type=long updatewhereclause=yes identity=yes name=id_documento dbname="documento.id_documento" )
 column=(type=long updatewhereclause=yes name=documento_id_prof_documento dbname="documento.id_prof_documento" )
 column=(type=long updatewhereclause=yes name=documento_id_registro dbname="documento.id_registro" )
 column=(type=decimal(0) updatewhereclause=yes name=documento_num_progressivo dbname="documento.num_progressivo" )
 column=(type=date updatewhereclause=yes name=documento_data_registrazione dbname="documento.data_registrazione" )
 column=(type=char(16) updatewhereclause=yes name=num_documento dbname="documento.num_documento" )
 column=(type=date updatewhereclause=yes name=data_documento dbname="documento.data_documento" )
 column=(type=long updatewhereclause=yes name=documento_id_sog_commerciale dbname="documento.id_sog_commerciale" )
 column=(type=char(8) updatewhereclause=yes name=sog_commerciale_gen_codice dbname="sog_commerciale_gen.codice" )
 column=(type=char(40) updatewhereclause=yes name=sog_commerciale_gen_rag_soc_1 dbname="sog_commerciale_gen.rag_soc_1" )
 column=(type=char(8) updatewhereclause=yes name=prof_documento_codice dbname="prof_documento.codice" )
 column=(type=char(1) updatewhereclause=yes name=documento_evaso_totalmente dbname="documento.evaso_totalmente" )
 column=(type=char(1) updatewhereclause=yes name=documento_scarica_ogni_titolo dbname="documento.scarica_ogni_titolo" values="	S/	N" )
 column=(type=decimal(4) updatewhereclause=yes name=peso_netto dbname="documento.peso_netto" )
 column=(type=char(40) updatewhereclause=yes name=des_contabile dbname="documento.des_contabile" )
 column=(type=long updatewhereclause=yes name=c_num_riga dbname="documento.id_prof_registrazione" )
 column=(type=decimal(0) updatewhereclause=yes name=c_peso_originale dbname="c_peso_originale" )
 column=(type=long updatewhereclause=yes name=c_vgmf dbname="c_vgmf" )
 column=(type=long updatewhereclause=yes name=c_vsb dbname="c_vsb" )
 column=(type=char(40) updatewhereclause=yes name=c_fo_des_libera dbname="c_fo_des_libera" )
 column=(type=decimal(6) updatewhereclause=yes name=imp_avanzo_acconto dbname="documento.imp_avanzo_acconto" )
 column=(type=long updatewhereclause=yes name=da_spazzolare dbname="sog_commerciale_gen.id_tributo" values=" 	0/SPAZZ!	1/" )
 column=(type=long updatewhereclause=yes name=da_laserare dbname="sog_commerciale_gen.id_tipo_agente" values=" 	0/LASER!	1/" )
 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"documento~" )  TABLE(NAME=~"sog_commerciale_gen~" )  TABLE(NAME=~"prof_documento~" )  TABLE(NAME=~"registro~" ) COLUMN(NAME=~"documento.id_documento~") COLUMN(NAME=~"documento.id_prof_documento~") COLUMN(NAME=~"documento.id_registro~") COLUMN(NAME=~"documento.num_progressivo~") COLUMN(NAME=~"documento.data_registrazione~") COLUMN(NAME=~"documento.num_documento~") COLUMN(NAME=~"documento.data_documento~") COLUMN(NAME=~"documento.id_sog_commerciale~") COLUMN(NAME=~"sog_commerciale_gen.codice~") COLUMN(NAME=~"sog_commerciale_gen.rag_soc_1~") COLUMN(NAME=~"prof_documento.codice~") COLUMN(NAME=~"documento.evaso_totalmente~") COLUMN(NAME=~"documento.scarica_ogni_titolo~") COLUMN(NAME=~"documento.peso_netto~") COLUMN(NAME=~"documento.des_contabile~") COLUMN(NAME=~"documento.id_prof_registrazione~") COMPUTE(NAME=~"0.00 as c_peso_originale~") COMPUTE(NAME=~"(select first(id_ver_giorno_merce_fo) from ver_giorno_merce_fo where num_bollettina=right(documento.num_documento, 7) order by id_ver_giorno_merce_fo desc) as c_vgmf~") COMPUTE(NAME=~"(select first(id_ver_sped_bollettina) from ver_sped_bollettina where num_bollettina=right(documento.num_documento, 7) order by id_ver_sped_bollettina desc) as c_vsb~") COMPUTE(NAME=~"(select first(fo_des_libera) from ver_giorno_merce_fo where num_bollettina=right(documento.num_documento, 7) order by id_ver_giorno_merce_fo desc) as c_fo_des_libera~") COLUMN(NAME=~"documento.imp_avanzo_acconto~") COLUMN(NAME=~"sog_commerciale_gen.id_tributo~") COLUMN(NAME=~"sog_commerciale_gen.id_tipo_agente~")    JOIN (LEFT=~"documento.id_sog_commerciale~"    OP =~"=~"RIGHT=~"sog_commerciale_gen.id_sog_commerciale~" )    JOIN (LEFT=~"documento.id_prof_documento~"    OP =~"=~"RIGHT=~"prof_documento.id_prof_documento~" )    JOIN (LEFT=~"documento.id_registro~"    OP =~"=~"RIGHT=~"registro.id_registro~" )WHERE(    EXP1 =~"(~~~"documento~~~".~~~"evaso_totalmente~~~"~"   OP =~"is~"    EXP2 =~"null~"    LOGIC =~"or~" ) WHERE(    EXP1 =~"~~~"documento~~~".~~~"evaso_totalmente~~~"~"   OP =~"=~"    EXP2 =~"'N')~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"documento~~~".~~~"id_documento~~~"~"   OP =~"=~"    EXP2 =~":id_doc~" ) ) ARG(NAME = ~"id_doc~" TYPE = number) " arguments=(("id_doc", number))  sort="c_num_riga D " )
