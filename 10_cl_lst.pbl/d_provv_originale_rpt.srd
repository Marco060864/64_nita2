 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"documento~" )  TABLE(NAME=~"provvigioni~" )  TABLE(NAME=~"gruppo_agenti~" )  TABLE(NAME=~"riga_documento~" )  TABLE(NAME=~"sog_commerciale_gen~" ) COLUMN(NAME=~"documento.id_documento~") COLUMN(NAME=~"documento.num_progressivo~") COLUMN(NAME=~"documento.num_documento~") COLUMN(NAME=~"documento.data_documento~") COLUMN(NAME=~"provvigioni.tipo_calcolo~") COLUMN(NAME=~"provvigioni.data_valido~") COLUMN(NAME=~"provvigioni.percentuale~") COLUMN(NAME=~"provvigioni.val_fisso~") COLUMN(NAME=~"provvigioni.listino_acq~") COLUMN(NAME=~"provvigioni.listino_ven~") COLUMN(NAME=~"provvigioni.id_lingua~") COLUMN(NAME=~"riga_documento.id_riga_documento~") COLUMN(NAME=~"riga_documento.num_riga~") COLUMN(NAME=~"riga_documento.quantita~") COLUMN(NAME=~"riga_documento.prezzo_complessivo~") COLUMN(NAME=~"documento.sconto_finanziario~") COMPUTE(NAME=~"cast((select prezzo from prezzo where id_variazione=  ~~~"provvigioni~~~".~~~"listino_acq~~~"  and  id_unita_confezione=~~~"riga_documento~~~".~~~"id_unita_confezione~~~") as decimal(18,4)) as cprezzo_acq~") COLUMN(NAME=~"sog_commerciale_gen.codice~") COLUMN(NAME=~"sog_commerciale_gen.rag_soc_1~") COLUMN(NAME=~"riga_documento.id_documento~")    JOIN (LEFT=~"gruppo_agenti.id_gruppo_agenti~"    OP =~"=~"RIGHT=~"documento.id_gruppo_agenti~" )    JOIN (LEFT=~"provvigioni.id_sog_commerciale~"    OP =~"=~"RIGHT=~"gruppo_agenti.id_sog_com_capo_area~" )    JOIN (LEFT=~"documento.id_lingua~"    OP =~"=~"RIGHT=~"provvigioni.id_lingua~" )    JOIN (LEFT=~"documento.data_documento~"    OP =~">=~"RIGHT=~"provvigioni.data_valido~" )    JOIN (LEFT=~"documento.data_documento~"    OP =~"<=~"RIGHT=~"provvigioni.data_fine_valido~" )    JOIN (LEFT=~"riga_documento.id_documento~"    OP =~"=~"RIGHT=~"documento.id_documento~" )    JOIN (LEFT=~"documento.id_sog_commerciale~"    OP =~"=~"RIGHT=~"sog_commerciale_gen.id_sog_commerciale~" )WHERE(    EXP1 =~"~~~"documento~~~".~~~"id_gruppo_agenti~~~"~"   OP =~"=~"    EXP2 =~":id_agente~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"documento~~~".~~~"data_documento~~~"~"   OP =~">=~"    EXP2 =~":da_data~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"documento~~~".~~~"data_documento~~~"~"   OP =~"<=~"    EXP2 =~":a_data~" ) ) ARG(NAME = ~"id_agente~" TYPE = number)  ARG(NAME = ~"da_data~" TYPE = date)  ARG(NAME = ~"a_data~" TYPE = date) " arguments=(("id_agente", number),("da_data", date),("a_data", date))  sort="sog_commerciale_gen_rag_soc_1 A data_documento A num_documento A riga_documento_num_riga A " )
