global type f_conta_pezzi from function_object
end type

forward prototypes
global function decimal f_conta_pezzi (long al_id_prof_doc, long al_id_sog, long al_id_art)
end prototypes

global function decimal f_conta_pezzi (long al_id_prof_doc, long al_id_sog, long al_id_art);decimal ldc_return

SELECT sum(quantita) 
into :ldc_return
from dba.riga_documento r, dba.documento d
where d.id_documento=r.id_documento and
id_articolo=:al_id_art and data_documento>=20200101 and
 id_sog_commerciale=:al_id_sog and id_prof_documento=:al_id_prof_doc
 ;
 if ldc_return>0 then
	return ldc_return
else
	return 0
end if
end function

