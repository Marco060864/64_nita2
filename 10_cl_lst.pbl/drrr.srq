PBSELECT( VERSION(400) TABLE(NAME="documento" )  TABLE(NAME="prof_documento" )  TABLE(NAME="riga_documento" )  TABLE(NAME="locazione" ALIAS="locazione_a" )  TABLE(NAME="magazzino" ALIAS="magazzino_a" )  TABLE(NAME="articolo" )  TABLE(NAME="cat_merceologica" )  TABLE(NAME="locazione" ALIAS="locazione_b" )  TABLE(NAME="magazzino" ALIAS="magazzino_b" ) COLUMN(NAME="documento.id_documento") COLUMN(NAME="documento.id_prof_documento") COLUMN(NAME="documento.id_registro") COLUMN(NAME="documento.num_progressivo") COLUMN(NAME="documento.data_registrazione") COLUMN(NAME="documento.num_documento") COLUMN(NAME="documento.data_documento") COLUMN(NAME="documento.id_sog_commerciale") COLUMN(NAME="prof_documento.codice") COLUMN(NAME="documento.evaso_totalmente") COLUMN(NAME="documento.scarica_ogni_titolo") COLUMN(NAME="riga_documento.num_riga") COLUMN(NAME="riga_documento.descrizione") COLUMN(NAME="riga_documento.quantita") COLUMN(NAME="riga_documento.id_locazione_1") COLUMN(NAME="riga_documento.id_locazione_2") COLUMN(NAME="riga_documento.prezzo") COLUMN(NAME="riga_documento.peso_netto") COLUMN(NAME="riga_documento.tot_riga_val_doc") COLUMN(NAME="riga_documento.id_riga_documento") COLUMN(NAME="magazzino_a.codice") COLUMN(NAME="articolo.codice") COLUMN(NAME="cat_merceologica.descrizione") COLUMN(NAME="riga_documento.id_riga_doc_provenienza") COLUMN(NAME="riga_documento.id_gruppo_agenti_2") COLUMN(NAME="riga_documento.id_articolo") COLUMN(NAME="riga_documento.qta_evasa") COLUMN(NAME="riga_documento.peso_netto_evaso") COLUMN(NAME="magazzino_b.codice") COLUMN(NAME="riga_documento.id_unita_confezione") COMPUTE(NAME="(riga_documento.quantita - ifnull(riga_documento.qta_evasa, 0, riga_documento.qta_evasa)) as c_qta_residua") COMPUTE(NAME="(riga_documento.peso_netto - ifnull(riga_documento.peso_netto_evaso, 0, riga_documento.peso_netto_evaso)) as c_peso_residuo") COLUMN(NAME="riga_documento.qta_sconto_merce") COMPUTE(NAME="(select codice from magazzino m, locazione l where l.id_magazzino=m.id_magazzino and l.id_locazione=riga_documento.id_locazione_2) as c_mag2") COMPUTE(NAME="(select codice from orafo_metallo m, orafo_titolo t where m.id_metallo=t.id_metallo and t.id_titolo=articolo.id_titolo) as c_metallo")    JOIN (LEFT="riga_documento.id_gruppo_agenti_2"    OP ="="RIGHT="cat_merceologica.id_cat_merceologica"    OUTER1 ="riga_documento.id_gruppo_agenti_2" )    JOIN (LEFT="locazione_b.id_magazzino"    OP ="="RIGHT="magazzino_b.id_magazzino"    OUTER1 ="locazione_b.id_magazzino" )    JOIN (LEFT="riga_documento.id_locazione_2"    OP ="="RIGHT="locazione_b.id_locazione"    OUTER1 ="riga_documento.id_locazione_2" )    JOIN (LEFT="documento.id_prof_documento"    OP ="="RIGHT="prof_documento.id_prof_documento" )    JOIN (LEFT="documento.id_documento"    OP ="="RIGHT="riga_documento.id_documento" )    JOIN (LEFT="magazzino_a.id_magazzino"    OP ="="RIGHT="locazione_a.id_magazzino" )    JOIN (LEFT="riga_documento.id_locazione_1"    OP ="="RIGHT="locazione_a.id_locazione" )    JOIN (LEFT="riga_documento.id_articolo"    OP ="="RIGHT="articolo.id_articolo" )WHERE(    EXP1 ="(~"documento~".~"evaso_totalmente~""   OP ="is"    EXP2 ="null"    LOGIC ="or" ) WHERE(    EXP1 ="~"documento~".~"evaso_totalmente~""   OP ="="    EXP2 ="'N')"    LOGIC ="and" ) WHERE(    EXP1 ="(~"riga_documento~".~"id_caus_magazzino~""   OP ="="    EXP2 ="40"    LOGIC ="and" ) WHERE(    EXP1 ="(~"prof_documento~".~"id_locazione_2_prop~""   OP ="="    EXP2 ="2"    LOGIC ="or" ) WHERE(    EXP1 ="~"prof_documento~".~"id_locazione_2_prop~""   OP ="="    EXP2 ="3"    LOGIC ="or" ) WHERE(    EXP1 ="~"prof_documento~".~"id_locazione_2_prop~""   OP ="="    EXP2 ="5)"    LOGIC ="or" ) WHERE(    EXP1 ="~"riga_documento~".~"id_caus_magazzino~""   OP ="="    EXP2 ="1"    LOGIC ="and" ) WHERE(    EXP1 ="(~"prof_documento~".~"id_locazione_1_prop~""   OP ="="    EXP2 ="2"    LOGIC ="or" ) WHERE(    EXP1 ="~"prof_documento~".~"id_locazione_1_prop~""   OP ="="    EXP2 ="3))"    LOGIC ="and" ) WHERE(    EXP1 ="(~"riga_documento~".~"qta_evasa~""   OP ="<"    EXP2 ="~"riga_documento~".~"quantita~""    LOGIC ="or" ) WHERE(    EXP1 ="~"riga_documento~".~"qta_evasa~""   OP ="is"    EXP2 ="null)" ) ) 