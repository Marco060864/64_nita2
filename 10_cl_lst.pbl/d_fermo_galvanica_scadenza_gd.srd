 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"documento~" ALIAS=~"documento_a~" )  TABLE(NAME=~"riga_documento~" ALIAS=~"riga_documento_a~" )  TABLE(NAME=~"riga_documento~" ALIAS=~"riga_documento_b~" )  TABLE(NAME=~"documento~" ALIAS=~"documento_b~" )  TABLE(NAME=~"bollettine_excel~" ) COLUMN(NAME=~"documento_a.num_documento~") COLUMN(NAME=~"documento_a.data_documento~") COLUMN(NAME=~"documento_a.id_documento~") COLUMN(NAME=~"riga_documento_a.id_riga_documento~") COLUMN(NAME=~"riga_documento_a.num_riga~") COLUMN(NAME=~"riga_documento_a.id_articolo~") COLUMN(NAME=~"riga_documento_a.descrizione~") COLUMN(NAME=~"riga_documento_b.id_documento~") COLUMN(NAME=~"documento_b.num_documento~") COLUMN(NAME=~"documento_b.data_documento~") COLUMN(NAME=~"riga_documento_b.provv_imp_subage_2~") COLUMN(NAME=~"riga_documento_b.num_riga~") COLUMN(NAME=~"riga_documento_b.quantita~") COLUMN(NAME=~"riga_documento_b.peso_netto~") COLUMN(NAME=~"riga_documento_a.qta_evasa~") COLUMN(NAME=~"riga_documento_a.peso_netto~") COMPUTE(NAME=~"(select first(r.peso_netto) from riga_documento r, documento d where d.id_documento=r.id_documento and d.id_prof_documento=184 and r.provv_imp_subage_2=riga_documento_a.id_riga_documento) as c_peso_buratto~") COLUMN(NAME=~"documento_a.data_prev_consegna~") COLUMN(NAME=~"bollettine_excel.num_ordine~") COMPUTE(NAME=~"( select d.data_documento from riga_documento r, documento d where d.id_documento=r.id_documento and provv_imp_subage_2=~~~"riga_documento_a~~~".~~~"id_riga_documento~~~" and d.id_prof_documento=204  and d.data_documento>= ~~~"documento_b~~~".~~~"data_documento~~~") as c_riparazione~")    JOIN (LEFT=~"riga_documento_a.id_documento~"    OP =~"=~"RIGHT=~"documento_a.id_documento~" )    JOIN (LEFT=~"riga_documento_a.id_riga_documento~"    OP =~"=~"RIGHT=~"riga_documento_b.provv_imp_subage_2~" )    JOIN (LEFT=~"riga_documento_b.id_documento~"    OP =~"=~"RIGHT=~"documento_b.id_documento~" )    JOIN (LEFT=~"riga_documento_a.quantita~"    OP =~">~"RIGHT=~"riga_documento_a.qta_evasa~" )WHERE(    EXP1 =~"( ( ~~~"documento_a~~~".~~~"id_prof_documento~~~"~"   OP =~"=~"    EXP2 =~"65 )~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"( ~~~"documento_b~~~".~~~"id_prof_documento~~~"~"   OP =~"=~"    EXP2 =~"170 )~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"( ~~~"documento_a~~~".~~~"data_documento~~~"~"   OP =~">=~"    EXP2 =~"20231215 )~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"( ~~~"riga_documento_a~~~".~~~"id_riga_documento~~~"~"   OP =~"not in~"    EXP2 =~"(SELECT r.id_riga_doc_provenienza FROM RIGA_DOCUMENTO r , documento d where d.id_documento=r.id_documento and d.id_prof_documento=66 and r.id_riga_doc_provenienza>0 ) ) )~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"right(documento_a.num_documento, 7)~"   OP =~"=~"    EXP2 =~"~~~"bollettine_excel~~~".~~~"cod_barre~~~"~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"bollettine_excel~~~".~~~"tipo~~~"~"   OP =~"=~"    EXP2 =~"'B'~" ) ) " filter=" c_galvanica >~"~"" sort="c_data_consegna A c_giorno A documento_data_prev_consegna A c_galvanica A data_documento A documento_num_documento A " )
