 column=(type=decimal(4) updatewhereclause=yes name=c_peso_buratto dbname="c_peso_buratto" )
 column=(type=date updatewhereclause=yes name=documento_data_prev_consegna dbname="documento.data_prev_consegna" dbalias="documento_a.data_prev_consegna" )
