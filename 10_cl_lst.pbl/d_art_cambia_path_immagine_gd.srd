 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"articolo~" ) COLUMN(NAME=~"articolo.id_articolo~") COLUMN(NAME=~"articolo.id_cat_codifica~") COLUMN(NAME=~"articolo.codice~") COLUMN(NAME=~"articolo.descrizione~") COLUMN(NAME=~"articolo.immagine~") COLUMN(NAME=~"articolo.id_cat_com_articolo~") COLUMN(NAME=~"articolo.id_cat_merceologica~") COLUMN(NAME=~"articolo.id_gruppo_articoli~") COLUMN(NAME=~"articolo.id_anagrafica~") COLUMN(NAME=~"articolo.id_sog_commerciale~") COLUMN(NAME=~"articolo.data_ora_creazione~") COLUMN(NAME=~"articolo.data_ora_ult_cambiamento~") COLUMN(NAME=~"articolo.prod_interna~") COLUMN(NAME=~"articolo.id_titolo~") COLUMN(NAME=~"articolo.coef_calo~") COMPUTE(NAME=~"cast(0 as integer) as scegli~") COLUMN(NAME=~"articolo.note~")WHERE(    EXP1 =~"~~~"articolo~~~".~~~"id_articolo~~~"~"   OP =~"=~"    EXP2 =~":id_art~" ) ) ARG(NAME = ~"id_art~" TYPE = number) " update="articolo" updatewhere=1 updatekeyinplace=yes arguments=(("id_art", number))  sort="codice A " )
