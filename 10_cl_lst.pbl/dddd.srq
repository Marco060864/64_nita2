PBSELECT( VERSION(400) TABLE(NAME="produzione_2011" )  TABLE(NAME="documento" ALIAS="d1" )  TABLE(NAME="documento" ALIAS="d2" )  TABLE(NAME="riga_documento" )  TABLE(NAME="prof_documento" )  TABLE(NAME="sog_commerciale_gen" ) COLUMN(NAME="d1.num_documento") COLUMN(NAME="d1.data_documento") COLUMN(NAME="produzione_2011.id_bollettina") COLUMN(NAME="produzione_2011.id_doc_produzione") COLUMN(NAME="d2.num_documento") COLUMN(NAME="d2.data_documento") COLUMN(NAME="d2.id_prof_documento") COLUMN(NAME="d2.id_sog_commerciale") COLUMN(NAME="prof_documento.codice") COLUMN(NAME="sog_commerciale_gen.codice") COLUMN(NAME="sog_commerciale_gen.rag_soc_1")    JOIN (LEFT="d1.id_documento"    OP ="="RIGHT="produzione_2011.id_bollettina" )    JOIN (LEFT="d2.id_documento"    OP ="="RIGHT="riga_documento.id_documento" )    JOIN (LEFT="produzione_2011.id_doc_produzione"    OP ="="RIGHT="riga_documento.id_riga_documento" )    JOIN (LEFT="d2.id_prof_documento"    OP ="="RIGHT="prof_documento.id_prof_documento" )    JOIN (LEFT="d2.id_sog_commerciale"    OP ="="RIGHT="sog_commerciale_gen.id_sog_commerciale" )WHERE(    EXP1 ="~"d2~".~"data_documento~""   OP =">="    EXP2 ="20220101" ) ) 