table(column=(type=long updatewhereclause=yes identity=yes name=id_documento dbname="documento.id_documento" )
 column=(type=long updatewhereclause=yes name=documento_id_prof_documento dbname="documento.id_prof_documento" )
 column=(type=long updatewhereclause=yes name=documento_id_registro dbname="documento.id_registro" )
 column=(type=decimal(0) updatewhereclause=yes name=documento_num_progressivo dbname="documento.num_progressivo" )
 column=(type=date updatewhereclause=yes name=documento_data_registrazione dbname="documento.data_registrazione" )
 column=(type=char(16) updatewhereclause=yes name=num_documento dbname="documento.num_documento" )
 column=(type=date updatewhereclause=yes name=data_documento dbname="documento.data_documento" )
