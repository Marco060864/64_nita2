 column=(type=char(8) updatewhereclause=yes name=prof_documento_codice dbname="prof_documento.codice" )
 column=(type=char(1) updatewhereclause=yes name=documento_evaso_totalmente dbname="documento.evaso_totalmente" )
 column=(type=char(1) updatewhereclause=yes name=documento_scarica_ogni_titolo dbname="documento.scarica_ogni_titolo" values="	S/	N" )
 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"documento~" )  TABLE(NAME=~"sog_commerciale_gen~" )  TABLE(NAME=~"prof_documento~" )  TABLE(NAME=~"registro~" ) COLUMN(NAME=~"documento.id_documento~") COLUMN(NAME=~"documento.id_prof_documento~") COLUMN(NAME=~"documento.id_registro~") COLUMN(NAME=~"documento.num_progressivo~") COLUMN(NAME=~"documento.data_registrazione~") COLUMN(NAME=~"documento.num_documento~") COLUMN(NAME=~"documento.data_documento~") COLUMN(NAME=~"documento.id_sog_commerciale~") COLUMN(NAME=~"sog_commerciale_gen.codice~") COLUMN(NAME=~"sog_commerciale_gen.rag_soc_1~") COLUMN(NAME=~"prof_documento.codice~") COLUMN(NAME=~"documento.evaso_totalmente~") COLUMN(NAME=~"documento.scarica_ogni_titolo~")    JOIN (LEFT=~"documento.id_sog_commerciale~"    OP =~"=~"RIGHT=~"sog_commerciale_gen.id_sog_commerciale~" )    JOIN (LEFT=~"documento.id_prof_documento~"    OP =~"=~"RIGHT=~"prof_documento.id_prof_documento~" )    JOIN (LEFT=~"documento.id_registro~"    OP =~"=~"RIGHT=~"registro.id_registro~" )WHERE(    EXP1 =~"~~~"documento~~~".~~~"evaso_totalmente~~~"~"   OP =~"is~"    EXP2 =~"null~"    LOGIC =~"or~" ) WHERE(    EXP1 =~"~~~"documento~~~".~~~"evaso_totalmente~~~"~"   OP =~"=~"    EXP2 =~"'N'~" ) ) "  sort="data_documento D num_documento D " )
