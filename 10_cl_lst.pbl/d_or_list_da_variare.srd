table(column=(type=char(4) updatewhereclause=yes name=listino_codice dbname="listino.codice" )
 column=(type=char(40) updatewhereclause=yes name=listino_descrizione dbname="listino.descrizione" )
 column=(type=date updatewhereclause=yes name=variazione_data_inizio dbname="variazione.data_inizio" )
 column=(type=date updatewhereclause=yes name=variazione_data_fine dbname="variazione.data_fine" )
 column=(type=long updatewhereclause=yes name=id_variazione dbname="variazione.id_variazione" )
 column=(type=long updatewhereclause=yes name=id_listino dbname="variazione.id_listino" )
 column=(type=decimal(2) updatewhereclause=yes name=percentuale dbname="var_percentuale" )
 column=(type=decimal(6) updatewhereclause=yes name=importo dbname="var_importo" )
 column=(type=char(1) updatewhereclause=yes name=c_varia dbname="c_varia" values="	S/	N" )
 column=(type=char(1) updatewhereclause=yes name=listino_tipo dbname="listino.tipo" )
 column=(type=char(1) updatewhereclause=yes name=listino_lis_base dbname="listino.lis_base" values="	S/	N" )
 column=(type=long updatewhereclause=yes name=listino_base_calcolo dbname="listino_base_calcolo" )
 retrieve="PBSELECT( VERSION(400) DISTINCT ()TABLE(NAME=~"listino~" )  TABLE(NAME=~"variazione~" )  TABLE(NAME=~"lista_art_key~" )  TABLE(NAME=~"prezzo~" )  TABLE(NAME=~"unita_confezione~" ) COLUMN(NAME=~"listino.codice~") COLUMN(NAME=~"listino.descrizione~") COLUMN(NAME=~"variazione.data_inizio~") COLUMN(NAME=~"variazione.data_fine~") COLUMN(NAME=~"variazione.id_variazione~") COLUMN(NAME=~"variazione.id_listino~") COMPUTE(NAME=~"cast(0 as numeric(5,2)) as var_percentuale~") COMPUTE(NAME=~"cast(0 as numeric(20,6)) as var_importo~") COMPUTE(NAME=~"cast('N' as char(1)) as c_varia~") COLUMN(NAME=~"listino.tipo~") COLUMN(NAME=~"listino.lis_base~") COMPUTE(NAME=~"cast(0 as integer) as listino_base_calcolo~")    JOIN (LEFT=~"variazione.id_listino~"    OP =~"=~"RIGHT=~"listino.id_listino~"    OUTER1 =~"variazione.id_listino~" )    JOIN (LEFT=~"prezzo.id_variazione~"    OP =~"=~"RIGHT=~"variazione.id_variazione~"    OUTER1 =~"prezzo.id_variazione~" )    JOIN (LEFT=~"unita_confezione.id_unita_confezione~"    OP =~"=~"RIGHT=~"prezzo.id_unita_confezione~" )    JOIN (LEFT=~"lista_art_key.id_articolo~"    OP =~"=~"RIGHT=~"unita_confezione.id_articolo~" )WHERE(    EXP1 =~"~~~"variazione~~~".~~~"data_inizio~~~"~"   OP =~"<=~"    EXP2 =~"today()~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"(~~~"variazione~~~".~~~"data_fine~~~"~"   OP =~">=~"    EXP2 =~"today()~"    LOGIC =~"or~" ) WHERE(    EXP1 =~"~~~"variazione~~~".~~~"data_fine~~~"~"   OP =~"is~"    EXP2 =~"null)~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"lista_art_key~~~".~~~"id_lista_articoli~~~"~"   OP =~"=~"    EXP2 =~"0~" ) ) "  sort="c_ordina A listino_codice A variazione_data_inizio A " )
