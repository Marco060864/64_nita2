table(column=(type=long update=yes updatewhereclause=yes key=yes name=documento_id_documento dbname="documento.id_documento" dbalias="d.id_documento" )
 column=(type=char(16) updatewhereclause=yes name=documento_num_documento dbname="documento.num_documento" dbalias="d.num_documento" )
 column=(type=date updatewhereclause=yes name=documento_data_documento dbname="documento.data_documento" dbalias="d.data_documento" )
 column=(type=char(1) update=yes updatewhereclause=yes name=evaso_totalmente dbname="documento.evaso_totalmente" dbalias="d.evaso_totalmente" )
 column=(type=decimal(4) updatewhereclause=yes name=compute_0005 dbname="compute_0005" )
 column=(type=decimal(4) updatewhereclause=yes name=compute_0006 dbname="compute_0006" )
 retrieve=" select d.id_documento,num_documento, d.data_documento,  d.evaso_totalmente, sum(quantita), sum(qta_evasa)
from riga_documento r, documento d 
where d.id_sog_commerciale=43 and data_documento>=:data_inizio and id_prof_documento=:id_prof_doc and r.id_documento=d.id_documento and (select sum(quantita) - sum(qta_evasa) from riga_documento where id_documento=d.id_documento)=0 and evaso_totalmente<>'S'
group by d.id_documento,num_documento, d.data_documento,  d.evaso_totalmente order by d.id_documento
" update="documento" updatewhere=1 updatekeyinplace=yes arguments=(("data_inizio", date),("id_prof_doc", number)) )
