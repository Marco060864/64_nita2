table(column=(type=decimal(0) updatewhereclause=yes name=num_riga dbname="riga_documento.num_riga" )
 column=(type=long updatewhereclause=yes name=id_riga_doc_provenienza dbname="riga_documento.id_riga_doc_provenienza" )
 column=(type=decimal(4) updatewhereclause=yes name=quantita dbname="riga_documento.quantita" )
 column=(type=decimal(4) updatewhereclause=yes name=peso_netto dbname="riga_documento.peso_netto" )
 column=(type=decimal(0) updatewhereclause=yes name=documento_num_progressivo dbname="documento.num_progressivo" )
 column=(type=char(16) updatewhereclause=yes name=documento_num_documento dbname="documento.num_documento" )
 column=(type=date updatewhereclause=yes name=documento_data_documento dbname="documento.data_documento" )
 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"riga_documento~" ALIAS=~"r~" )  TABLE(NAME=~"riga_documento~" ALIAS=~"riga_documento_b~" )  TABLE(NAME=~"documento~" ) COLUMN(NAME=~"r.num_riga~") COLUMN(NAME=~"r.id_riga_doc_provenienza~") COLUMN(NAME=~"r.quantita~") COLUMN(NAME=~"r.peso_netto~") COLUMN(NAME=~"documento.num_progressivo~") COLUMN(NAME=~"documento.num_documento~") COLUMN(NAME=~"documento.data_documento~")    JOIN (LEFT=~"documento.id_documento~"    OP =~"=~"RIGHT=~"riga_documento_b.id_documento~" )    JOIN (LEFT=~"r.id_riga_doc_provenienza~"    OP =~"=~"RIGHT=~"riga_documento_b.id_riga_documento~" )WHERE(    EXP1 =~"~~~"r~~~".~~~"id_documento~~~"~"   OP =~"=~"    EXP2 =~":id_doc~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"r~~~".~~~"id_riga_doc_provenienza~~~"~"   OP =~"IN~"    EXP2 =~"(SELECT id_riga_doc_provenienza FROM RIGA_DOCUMENTO where id_documento=:id_doc and num_riga<> r.num_riga)~" ) ) ARG(NAME = ~"id_doc~" TYPE = number) " arguments=(("id_doc", number)) )
