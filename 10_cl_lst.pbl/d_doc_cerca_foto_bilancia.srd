table(column=(type=decimal(0) updatewhereclause=yes name=num_progressivo dbname="documento.num_progressivo" )
 column=(type=date updatewhereclause=yes name=data_registrazione dbname="documento.data_registrazione" )
 column=(type=char(8) updatewhereclause=yes name=prof_documento_codice dbname="prof_documento.codice" )
 column=(type=char(16) updatewhereclause=yes name=num_documento dbname="documento.num_documento" )
 column=(type=date updatewhereclause=yes name=data_documento dbname="documento.data_documento" )
 column=(type=char(8) updatewhereclause=yes name=sog_commerciale_gen_codice dbname="sog_commerciale_gen.codice" )
 column=(type=long updatewhereclause=yes identity=yes name=id_documento dbname="documento.id_documento" )
 column=(type=datetime updatewhereclause=yes name=data_ora_creazione dbname="documento.data_ora_creazione" )
 column=(type=char(40) updatewhereclause=yes name=sog_commerciale_gen_rag_soc_1 dbname="sog_commerciale_gen.rag_soc_1" )
 column=(type=long updatewhereclause=yes name=id_sog_commerciale dbname="documento.id_sog_commerciale" )
 column=(type=datetime updatewhereclause=yes name=data_ora_modifica dbname="riga_doc_estensione.data_ora_modifica" )
 column=(type=decimal(4) updatewhereclause=yes name=riga_documento_quantita dbname="riga_documento.quantita" )
 column=(type=decimal(4) updatewhereclause=yes name=riga_documento_peso_netto dbname="riga_documento.peso_netto" )
 column=(type=decimal(4) updatewhereclause=yes name=riga_documento_peso_lordo dbname="riga_documento.peso_lordo" )
 column=(type=decimal(5) updatewhereclause=yes name=provv_imp_carea_2 dbname="riga_documento.provv_imp_carea_2" )
 column=(type=decimal(4) updatewhereclause=yes name=provv_imp_agente_2 dbname="riga_documento.provv_imp_agente_2" )
 column=(type=decimal(4) updatewhereclause=yes name=peso_laccio dbname="orafo_par_sistema.peso_laccio" )
 column=(type=decimal(4) updatewhereclause=yes name=peso_filo_rame dbname="orafo_par_sistema.peso_filo_rame" )
 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"documento~" )  TABLE(NAME=~"sog_commerciale_gen~" )  TABLE(NAME=~"prof_documento~" )  TABLE(NAME=~"riga_doc_estensione~" )  TABLE(NAME=~"riga_documento~" )  TABLE(NAME=~"orafo_par_sistema~" ) COLUMN(NAME=~"documento.num_progressivo~") COLUMN(NAME=~"documento.data_registrazione~") COLUMN(NAME=~"prof_documento.codice~") COLUMN(NAME=~"documento.num_documento~") COLUMN(NAME=~"documento.data_documento~") COLUMN(NAME=~"sog_commerciale_gen.codice~") COLUMN(NAME=~"documento.id_documento~") COLUMN(NAME=~"documento.data_ora_creazione~") COLUMN(NAME=~"sog_commerciale_gen.rag_soc_1~") COLUMN(NAME=~"documento.id_sog_commerciale~") COLUMN(NAME=~"riga_doc_estensione.data_ora_modifica~") COLUMN(NAME=~"riga_documento.quantita~") COLUMN(NAME=~"riga_documento.peso_netto~") COLUMN(NAME=~"riga_documento.peso_lordo~") COLUMN(NAME=~"riga_documento.provv_imp_carea_2~") COLUMN(NAME=~"riga_documento.provv_imp_agente_2~") COLUMN(NAME=~"orafo_par_sistema.peso_laccio~") COLUMN(NAME=~"orafo_par_sistema.peso_filo_rame~")    JOIN (LEFT=~"riga_documento.id_riga_documento~"    OP =~"=~"RIGHT=~"riga_doc_estensione.id_riga_documento~"    OUTER1 =~"riga_documento.id_riga_documento~" )    JOIN (LEFT=~"prof_documento.id_prof_documento~"    OP =~"=~"RIGHT=~"documento.id_prof_documento~" )    JOIN (LEFT=~"documento.id_sog_commerciale~"    OP =~"=~"RIGHT=~"sog_commerciale_gen.id_sog_commerciale~" )    JOIN (LEFT=~"documento.id_documento~"    OP =~"=~"RIGHT=~"riga_documento.id_documento~" )WHERE(    EXP1 =~"(~~~"documento~~~".~~~"id_prof_documento~~~"~"   OP =~"=~"    EXP2 =~"99~"    LOGIC =~"or~" ) WHERE(    EXP1 =~"~~~"documento~~~".~~~"id_prof_documento~~~"~"   OP =~"=~"    EXP2 =~"130~"    LOGIC =~"or~" ) WHERE(    EXP1 =~"~~~"documento~~~".~~~"id_prof_documento~~~"~"   OP =~"=~"    EXP2 =~"113~"    LOGIC =~"or~" ) WHERE(    EXP1 =~"~~~"documento~~~".~~~"id_prof_documento~~~"~"   OP =~"=~"    EXP2 =~"65)~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"documento~~~".~~~"ordinato_fo~~~"~"   OP =~"=~"    EXP2 =~"'S'~" ) ) ORDER(NAME=~"documento.num_progressivo~" ASC=no)  ORDER(NAME=~"documento.data_registrazione~" ASC=no) "  sort="data_ora_modifica D data_documento D num_progressivo D " )
