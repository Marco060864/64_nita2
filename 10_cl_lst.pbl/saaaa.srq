PBSELECT( VERSION(400) TABLE(NAME="articolo" )  TABLE(NAME="documento" )  TABLE(NAME="riga_documento" )  TABLE(NAME="orafo_metallo" )  TABLE(NAME="orafo_titolo" ) COLUMN(NAME="documento.id_documento") COLUMN(NAME="documento.num_progressivo") COLUMN(NAME="documento.num_documento") COLUMN(NAME="documento.data_documento") COLUMN(NAME="documento.id_sog_commerciale") COLUMN(NAME="riga_documento.id_riga_documento") COLUMN(NAME="riga_documento.num_riga") COLUMN(NAME="riga_documento.id_articolo") COLUMN(NAME="riga_documento.descrizione") COLUMN(NAME="riga_documento.quantita") COLUMN(NAME="articolo.codice") COLUMN(NAME="riga_documento.id_caus_magazzino") COLUMN(NAME="orafo_metallo.codice") COLUMN(NAME="orafo_metallo.descrizione")    JOIN (LEFT="riga_documento.id_documento"    OP ="="RIGHT="documento.id_documento" )    JOIN (LEFT="riga_documento.id_articolo"    OP ="="RIGHT="articolo.id_articolo" )    JOIN (LEFT="orafo_titolo.id_metallo"    OP ="="RIGHT="orafo_metallo.id_metallo" )    JOIN (LEFT="articolo.id_titolo"    OP ="="RIGHT="orafo_titolo.id_titolo" )WHERE(    EXP1 ="~"riga_documento~".~"id_caus_magazzino~""   OP ="="    EXP2 ="111"    LOGIC ="or" ) WHERE(    EXP1 ="~"riga_documento~".~"id_caus_magazzino~""   OP ="="    EXP2 ="112" ) ) 