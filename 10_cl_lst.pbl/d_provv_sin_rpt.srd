"border="0" color="0" x="978" y="4" height="56" width="347" format="#,0.0000"  name=c_imp_per_calcolo visible="1~t0"  font.face="Arial" font.height="-8" font.weight="400"  font.family="2" font.pitch="2" font.charset="0" background.mode="1" background.color="536870912" )
