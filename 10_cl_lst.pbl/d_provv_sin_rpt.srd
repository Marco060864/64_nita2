 column=(type=decimal(4) updatewhereclause=yes name=cprezzo_acq dbname="cprezzo_acq" )
 column=(type=long updatewhereclause=yes name=riga_documento_id_documento dbname="prezzo.id_documento" )
 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"riga_documento~" )  TABLE(NAME=~"articolo~" )  TABLE(NAME=~"provvigioni~" )  TABLE(NAME=~"lista_art_key~" )  TABLE(NAME=~"lista_profilo~" )  TABLE(NAME=~"documento~" )  TABLE(NAME=~"sog_commerciale_gen~" ) COLUMN(NAME=~"sog_commerciale_gen.codice~") COLUMN(NAME=~"sog_commerciale_gen.rag_soc_1~") COLUMN(NAME=~"documento.num_documento~") COLUMN(NAME=~"documento.data_documento~") COLUMN(NAME=~"articolo.codice~") COLUMN(NAME=~"riga_documento.descrizione~") COLUMN(NAME=~"riga_documento.quantita~") COLUMN(NAME=~"riga_documento.peso_netto~") COLUMN(NAME=~"riga_documento.prezzo_complessivo~") COLUMN(NAME=~"provvigioni.tipo_calcolo~") COLUMN(NAME=~"provvigioni.percentuale~") COLUMN(NAME=~"provvigioni.val_fisso~") COLUMN(NAME=~"documento.num_progressivo~") COLUMN(NAME=~"documento.id_prof_documento~") COMPUTE(NAME=~"cast((select prezzo   from prezzo where id_variazione=  ~~~"provvigioni~~~".~~~"listino_acq~~~"  and  id_unita_confezione=~~~"riga_documento~~~".~~~"id_unita_confezione~~~") as decimal(18,4)) as cprezzo_acq~") COLUMN(NAME=~"riga_documento.id_documento~")    JOIN (LEFT=~"riga_documento.id_articolo~"    OP =~"=~"RIGHT=~"articolo.id_articolo~"    OUTER1 =~"riga_documento.id_articolo~" )    JOIN (LEFT=~"provvigioni.id_lista_articoli~"    OP =~"=~"RIGHT=~"lista_art_key.id_lista_articoli~" )    JOIN (LEFT=~"provvigioni.id_provvigioni~"    OP =~"=~"RIGHT=~"lista_profilo.id_provvigioni~" )    JOIN (LEFT=~"riga_documento.id_documento~"    OP =~"=~"RIGHT=~"documento.id_documento~" )    JOIN (LEFT=~"lista_profilo.id_prof_documento~"    OP =~"=~"RIGHT=~"documento.id_prof_documento~" )    JOIN (LEFT=~"provvigioni.id_sog_commerciale~"    OP =~"=~"RIGHT=~"sog_commerciale_gen.id_sog_commerciale~" )    JOIN (LEFT=~"lista_art_key.id_articolo~"    OP =~"=~"RIGHT=~"riga_documento.id_articolo~" )WHERE(    EXP1 =~"( ( ~~~"sog_commerciale_gen~~~".~~~"codice~~~"~"   OP =~">=~"    EXP2 =~":da_cod_sog )~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"( ~~~"sog_commerciale_gen~~~".~~~"codice~~~"~"   OP =~"<=~"    EXP2 =~":a_cod_sog )~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"( ~~~"documento~~~".~~~"data_documento~~~"~"   OP =~">=~"    EXP2 =~":da_data )~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"( ~~~"documento~~~".~~~"data_documento~~~"~"   OP =~"<=~"    EXP2 =~":a_data ) )~"    LOGIC =~"and~" ) WHERE(    EXP1 =~" ~~~"documento~~~".~~~"data_documento~~~"~"   OP =~">=~"    EXP2 =~"~~~"provvigioni~~~".~~~"data_valido~~~"~"    LOGIC =~"and~" ) WHERE(    EXP1 =~" ~~~"documento~~~".~~~"data_documento~~~"~"   OP =~"<=~"    EXP2 =~"~~~"provvigioni~~~".~~~"data_fine_valido~~~"~" ) ) ARG(NAME = ~"da_cod_sog~" TYPE = string)  ARG(NAME = ~"a_cod_sog~" TYPE = string)  ARG(NAME = ~"da_data~" TYPE = date)  ARG(NAME = ~"a_data~" TYPE = date) " arguments=(("da_cod_sog", string),("a_cod_sog", string),("da_data", date),("a_data", date))  sort="sg_codice A data_documento A codice A " )
group(level=1 header.height=0 trailer.height=80 by=("sg_codice" ) header.color="536870912" trailer.color="536870912" )
