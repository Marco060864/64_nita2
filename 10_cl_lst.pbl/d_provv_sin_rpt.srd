 column=(type=decimal(4) updatewhereclause=yes name=quantita dbname="prezzo.quantita" )
 column=(type=decimal(4) updatewhereclause=yes name=peso_netto dbname="prezzo.peso_netto" )
 column=(type=decimal(6) updatewhereclause=yes name=prezzo_complessivo dbname="prezzo.prezzo_complessivo" )
 column=(type=char(1) updatewhereclause=yes name=tipo_calcolo dbname="prezzo.tipo_calcolo" )
