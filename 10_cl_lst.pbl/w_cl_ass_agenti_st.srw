end event

event open;call super::open;long ll_id_es
datawindowchild ldw_da_cat_merceologica, ldw_a_cat_merceologica, ldw_data_inizio_es, ldw_gruppo_art
date ldt_data_inzio

String ls_par 

dw_1.getchild("id_agente",ldw_da_cat_merceologica)
ldw_da_cat_merceologica.settransobject(sqlca)
ldw_da_cat_merceologica.retrieve()

dw_1.getchild("id_gruppo_articoli",ldw_gruppo_art)
ldw_gruppo_art.settransobject(sqlca)
ldw_gruppo_art.retrieve()
//

dw_1.insertrow(1)

long ll_riga
date ld_data
ld_data=today()
ll_riga=dw_1.getrow()
dw_1.setitem(ll_riga, "a_data", ld_data)
select data_inizio
into :ldt_data_inzio
from esercizio e, azienda a
where e.id_esercizio=a.id_esercizio_proposto
and a.id_azienda=1;
dw_1.setitem(ll_riga, "da_data", ldt_data_inzio)








end event

