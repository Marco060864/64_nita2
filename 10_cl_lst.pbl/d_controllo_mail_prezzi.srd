table(column=(type=decimal(0) updatewhereclause=yes name=num_progressivo dbname="documento.num_progressivo" dbalias=".num_progressivo" )
 column=(type=char(16) updatewhereclause=yes name=documento_num_documento dbname="documento.num_documento" dbalias=".num_documento" )
 column=(type=date updatewhereclause=yes name=documento_data_documento dbname="documento.data_documento" dbalias=".data_documento" )
 column=(type=long updatewhereclause=yes name=c_modificato dbname="c_modificato" )
 column=(type=long updatewhereclause=yes name=id_sog_commerciale dbname="documento.id_sog_commerciale" dbalias=".id_sog_commerciale" )
 column=(type=char(1) updatewhereclause=yes name=stampato dbname="documento.stampato" dbalias=".stampato" )
 column=(type=char(8) updatewhereclause=yes name=prof_documento_codice dbname="prof_documento.codice" dbalias=".codice" )
 column=(type=long updatewhereclause=yes identity=yes name=prof_documento_id_prof_documento dbname="prof_documento.id_prof_documento" dbalias=".id_prof_documento" )
 column=(type=char(2) updatewhereclause=yes name=prof_documento_tipo_registro dbname="prof_documento.tipo_registro" dbalias=".tipo_registro" )
 column=(type=long updatewhereclause=yes identity=yes name=id_documento dbname="documento.id_documento" dbalias=".id_documento" )
 column=(type=char(8) updatewhereclause=yes name=sog_commerciale_gen_codice dbname="sog_commerciale_gen.codice" dbalias=".codice" )
 column=(type=char(40) updatewhereclause=yes name=sog_commerciale_gen_rag_soc_1 dbname="sog_commerciale_gen.rag_soc_1" dbalias=".rag_soc_1" )
 column=(type=long updatewhereclause=yes name=documento_id_utenti dbname="documento.id_utenti" dbalias=".id_utenti" )
 column=(type=datetime updatewhereclause=yes name=fe_invio_data_ora_invio dbname="fe_invio.data_ora_invio" dbalias=".data_ora_invio" )
 column=(type=long updatewhereclause=yes name=fe_invio_id_invio_fe dbname="fe_invio.id_invio_fe" dbalias=".id_invio_fe" )
 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"documento~" )  TABLE(NAME=~"prof_documento~" )  TABLE(NAME=~"sog_commerciale_gen~" )  TABLE(NAME=~"fe_invio~" ) COLUMN(NAME=~"documento.num_progressivo~") COLUMN(NAME=~"documento.num_documento~") COLUMN(NAME=~"documento.data_documento~") COMPUTE(NAME=~"cast(0 as integer) as c_modificato~") COLUMN(NAME=~"documento.id_sog_commerciale~") COLUMN(NAME=~"documento.stampato~") COLUMN(NAME=~"prof_documento.codice~") COLUMN(NAME=~"prof_documento.id_prof_documento~") COLUMN(NAME=~"prof_documento.tipo_registro~") COLUMN(NAME=~"documento.id_documento~") COLUMN(NAME=~"sog_commerciale_gen.codice~") COLUMN(NAME=~"sog_commerciale_gen.rag_soc_1~") COLUMN(NAME=~"documento.id_utenti~") COLUMN(NAME=~"fe_invio.data_ora_invio~") COLUMN(NAME=~"fe_invio.id_invio_fe~")    JOIN (LEFT=~"documento.id_documento~"    OP =~"=~"RIGHT=~"fe_invio.id_documento~"    OUTER1 =~"documento.id_documento~" )    JOIN (LEFT=~"prof_documento.id_prof_documento~"    OP =~"=~"RIGHT=~"documento.id_prof_documento~" )    JOIN (LEFT=~"documento.id_sog_commerciale~"    OP =~"=~"RIGHT=~"sog_commerciale_gen.id_sog_commerciale~" )WHERE(    EXP1 =~"~~~"documento~~~".~~~"data_documento~~~"~"   OP =~">=~"    EXP2 =~":da_data~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"documento~~~".~~~"data_documento~~~"~"   OP =~"<=~"    EXP2 =~":a_data~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"right(~~~"prof_documento~~~".~~~"tipo_registro~~~", 1)~"   OP =~"=~"    EXP2 =~"'V'~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"(~~~"prof_documento~~~".~~~"codice~~~"~"   OP =~"=~"    EXP2 =~"'ORBOL'~"    LOGIC =~"or~" ) WHERE(    EXP1 =~"~~~"prof_documento~~~".~~~"codice~~~"~"   OP =~"=~"    EXP2 =~"'FATLAV'~"    LOGIC =~"or~" ) WHERE(    EXP1 =~"~~~"prof_documento~~~".~~~"codice~~~"~"   OP =~"=~"    EXP2 =~"'RBOL'~"    LOGIC =~"or~" ) WHERE(    EXP1 =~"~~~"prof_documento~~~".~~~"codice~~~"~"   OP =~"=~"    EXP2 =~"'FATVEN'~"    LOGIC =~"or~" ) WHERE(    EXP1 =~"~~~"prof_documento~~~".~~~"codice~~~"~"   OP =~"=~"    EXP2 =~"'VFATLAV'~"    LOGIC =~"or~" ) WHERE(    EXP1 =~"~~~"prof_documento~~~".~~~"codice~~~"~"   OP =~"=~"    EXP2 =~"'FATLAV-O'~"    LOGIC =~"or~" ) WHERE(    EXP1 =~"~~~"prof_documento~~~".~~~"codice~~~"~"   OP =~"=~"    EXP2 =~"'GRBOL'~"    LOGIC =~"or~" ) WHERE(    EXP1 =~"~~~"prof_documento~~~".~~~"codice~~~"~"   OP =~"=~"    EXP2 =~"'GORBOL'~"    LOGIC =~"or~" ) WHERE(    EXP1 =~"~~~"prof_documento~~~".~~~"codice~~~"~"   OP =~"=~"    EXP2 =~"'RBOLAU'~"    LOGIC =~"or~" ) WHERE(    EXP1 =~"~~~"prof_documento~~~".~~~"codice~~~"~"   OP =~"=~"    EXP2 =~"'FATGAL-O'~"    LOGIC =~"or~" ) WHERE(    EXP1 =~"~~~"prof_documento~~~".~~~"tipo_registro~~~"~"   OP =~"=~"    EXP2 =~"'IV'~"    LOGIC =~"or~" ) WHERE(    EXP1 =~"~~~"prof_documento~~~".~~~"codice~~~"~"   OP =~"=~"    EXP2 =~"'FATGALV'~"    LOGIC =~"or~" ) WHERE(    EXP1 =~"~~~"prof_documento~~~".~~~"codice~~~"~"   OP =~"=~"    EXP2 =~"'FATLAVAU')~" ) ) ARG(NAME = ~"da_data~" TYPE = date)  ARG(NAME = ~"a_data~" TYPE = date) " arguments=(("da_data", date),("a_data", date))  sort="documento_data_documento D num_progressivo D documento_num_documento D " )
