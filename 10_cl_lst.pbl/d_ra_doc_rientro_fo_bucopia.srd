 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"documento~" )  TABLE(NAME=~"prof_documento~" )  TABLE(NAME=~"riga_documento~" )  TABLE(NAME=~"locazione~" )  TABLE(NAME=~"magazzino~" )  TABLE(NAME=~"articolo~" )  TABLE(NAME=~"cat_merceologica~" ) COLUMN(NAME=~"documento.id_documento~") COLUMN(NAME=~"documento.id_prof_documento~") COLUMN(NAME=~"documento.id_registro~") COLUMN(NAME=~"documento.num_progressivo~") COLUMN(NAME=~"documento.data_registrazione~") COLUMN(NAME=~"documento.num_documento~") COLUMN(NAME=~"documento.data_documento~") COLUMN(NAME=~"documento.id_sog_commerciale~") COLUMN(NAME=~"prof_documento.codice~") COLUMN(NAME=~"documento.evaso_totalmente~") COLUMN(NAME=~"documento.scarica_ogni_titolo~") COLUMN(NAME=~"riga_documento.num_riga~") COLUMN(NAME=~"riga_documento.descrizione~") COLUMN(NAME=~"riga_documento.quantita~") COLUMN(NAME=~"riga_documento.id_locazione_1~") COLUMN(NAME=~"riga_documento.id_locazione_2~") COLUMN(NAME=~"riga_documento.prezzo~") COLUMN(NAME=~"riga_documento.peso_netto~") COLUMN(NAME=~"riga_documento.tot_riga_val_doc~") COLUMN(NAME=~"riga_documento.id_riga_documento~") COLUMN(NAME=~"magazzino.codice~") COLUMN(NAME=~"articolo.codice~") COLUMN(NAME=~"cat_merceologica.descrizione~") COLUMN(NAME=~"riga_documento.id_riga_doc_provenienza~") COLUMN(NAME=~"riga_documento.id_gruppo_agenti_2~") COLUMN(NAME=~"riga_documento.id_articolo~") COLUMN(NAME=~"riga_documento.qta_evasa~") COLUMN(NAME=~"riga_documento.peso_netto_evaso~")    JOIN (LEFT=~"riga_documento.id_gruppo_agenti_2~"    OP =~"=~"RIGHT=~"cat_merceologica.id_cat_merceologica~"    OUTER1 =~"riga_documento.id_gruppo_agenti_2~" )    JOIN (LEFT=~"documento.id_documento~"    OP =~"=~"RIGHT=~"riga_documento.id_documento~"    OUTER1 =~"documento.id_documento~" )    JOIN (LEFT=~"documento.id_prof_documento~"    OP =~"=~"RIGHT=~"prof_documento.id_prof_documento~" )    JOIN (LEFT=~"magazzino.id_magazzino~"    OP =~"=~"RIGHT=~"locazione.id_magazzino~" )    JOIN (LEFT=~"riga_documento.id_locazione_1~"    OP =~"=~"RIGHT=~"locazione.id_locazione~" )    JOIN (LEFT=~"riga_documento.id_articolo~"    OP =~"=~"RIGHT=~"articolo.id_articolo~" )WHERE(    EXP1 =~"~~~"documento~~~".~~~"id_prof_documento~~~"~"   OP =~"=~"    EXP2 =~"82~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"(~~~"documento~~~".~~~"evaso_totalmente~~~"~"   OP =~"is~"    EXP2 =~"null~"    LOGIC =~"or~" ) WHERE(    EXP1 =~"~~~"documento~~~".~~~"evaso_totalmente~~~"~"   OP =~"=~"    EXP2 =~"'N')~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"(~~~"riga_documento~~~".~~~"qta_evasa~~~"~"   OP =~"is~"    EXP2 =~"null~"    LOGIC =~"or~" ) WHERE(    EXP1 =~"~~~"riga_documento~~~".~~~"qta_evasa~~~"~"   OP =~"<~"    EXP2 =~"~~~"riga_documento~~~".~~~"quantita~~~")~" ) ) "  sort="data_documento A num_documento A num_riga A " )
