PBSELECT( VERSION(400) TABLE(NAME="scadenza" )  TABLE(NAME="sog_commerciale_gen" )  TABLE(NAME="documento" ) COLUMN(NAME="scadenza.id_scadenza") COLUMN(NAME="scadenza.tipo_scadenza") COLUMN(NAME="scadenza.data_scadenza") COLUMN(NAME="scadenza.imp_valuta") COLUMN(NAME="scadenza.stato_scadenza") COLUMN(NAME="scadenza.data_cambiamento_stato") COLUMN(NAME="scadenza.esito_pagamento") COLUMN(NAME="scadenza.scadenza_da_raggruppare") COLUMN(NAME="documento.id_documento") COLUMN(NAME="documento.num_progressivo") COLUMN(NAME="documento.data_registrazione") COLUMN(NAME="documento.num_documento") COLUMN(NAME="documento.data_documento") COLUMN(NAME="sog_commerciale_gen.codice") COLUMN(NAME="sog_commerciale_gen.rag_soc_1") COLUMN(NAME="sog_commerciale_gen.id_sog_commerciale")    JOIN (LEFT="scadenza.id_sog_commerciale"    OP ="="RIGHT="sog_commerciale_gen.id_sog_commerciale" )    JOIN (LEFT="documento.id_documento"    OP ="="RIGHT="scadenza.id_documento" )WHERE(    EXP1 ="~"scadenza~".~"tipo_scadenza~""   OP ="="    EXP2 ="'A'"    LOGIC ="and" ) WHERE(    EXP1 ="~"scadenza~".~"data_scadenza~""   OP =">="    EXP2 =":da_data"    LOGIC ="and" ) WHERE(    EXP1 ="~"scadenza~".~"data_scadenza~""   OP ="<="    EXP2 =":a_data" ) ) ARG(NAME = "da_data" TYPE = date)  ARG(NAME = "a_data" TYPE = date) 