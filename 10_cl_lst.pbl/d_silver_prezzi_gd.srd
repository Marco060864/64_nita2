table(column=(type=long update=yes updatewhereclause=yes key=yes name=prezzo_id_unita_confezione dbname="prezzo.id_unita_confezione" )
 column=(type=long update=yes updatewhereclause=yes key=yes name=prezzo_id_variazione dbname="prezzo.id_variazione" )
 column=(type=decimal(6) update=yes updatewhereclause=yes name=prezzo_prezzo dbname="prezzo.prezzo" )
 column=(type=decimal(2) updatewhereclause=yes name=prezzo_coef_calo dbname="prezzo.coef_calo" )
 column=(type=decimal(6) update=yes updatewhereclause=yes name=prezzo_prezzo_manifattura dbname="prezzo.prezzo_manifattura" )
 column=(type=decimal(6) updatewhereclause=yes name=prezzo_costo_imballo dbname="prezzo.costo_imballo" )
 column=(type=decimal(6) updatewhereclause=yes name=prezzo_galvanica dbname="prezzo.galvanica" )
 column=(type=char(255) update=yes updatewhereclause=yes name=prezzo_des_1 dbname="prezzo.des_1" )
 column=(type=char(255) update=yes updatewhereclause=yes name=prezzo_des_2 dbname="prezzo.des_2" )
 column=(type=char(255) update=yes updatewhereclause=yes name=prezzo_des_3 dbname="prezzo.des_3" )
 column=(type=datetime update=yes updatewhereclause=yes name=prezzo_ultima_modifica dbname="prezzo.ultima_modifica" )
 column=(type=char(8) updatewhereclause=yes name=unita_confezione_codice dbname="unita_confezione.codice" )
 column=(type=long updatewhereclause=yes name=id_articolo dbname="articolo.id_articolo" )
 column=(type=char(1) update=yes updatewhereclause=yes name=prezzo_confermato dbname="prezzo.confermato" values="	S/	N" )
 column=(type=long updatewhereclause=yes name=c_scelto dbname="c_scelto" )
 column=(type=char(1) updatewhereclause=yes name=prezzo_ins_automatico dbname="prezzo.ins_automatico" )
 column=(type=char(5) updatewhereclause=yes name=prezzo_cliente dbname="prezzo.cliente" )
 column=(type=char(64) updatewhereclause=yes name=articolo_codice dbname="articolo.codice" )
 column=(type=char(80) updatewhereclause=yes name=articolo_descrizione dbname="articolo.descrizione" )
 column=(type=decimal(6) updatewhereclause=yes name=c_controllato_k dbname="c_controllato_k" )
 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"articolo~" )  TABLE(NAME=~"prezzo~" )  TABLE(NAME=~"unita_confezione~" ) COLUMN(NAME=~"prezzo.id_unita_confezione~") COLUMN(NAME=~"prezzo.id_variazione~") COLUMN(NAME=~"prezzo.prezzo~") COLUMN(NAME=~"prezzo.coef_calo~") COLUMN(NAME=~"prezzo.prezzo_manifattura~") COLUMN(NAME=~"prezzo.costo_imballo~") COLUMN(NAME=~"prezzo.galvanica~") COLUMN(NAME=~"prezzo.des_1~") COLUMN(NAME=~"prezzo.des_2~") COLUMN(NAME=~"prezzo.des_3~") COLUMN(NAME=~"prezzo.ultima_modifica~") COLUMN(NAME=~"unita_confezione.codice~") COLUMN(NAME=~"articolo.id_articolo~") COLUMN(NAME=~"prezzo.confermato~") COMPUTE(NAME=~"0 as c_scelto~") COLUMN(NAME=~"prezzo.ins_automatico~") COLUMN(NAME=~"prezzo.cliente~") COLUMN(NAME=~"articolo.codice~") COLUMN(NAME=~"articolo.descrizione~") COMPUTE(NAME=~"0.000001 as c_controllato_k~")    JOIN (LEFT=~"unita_confezione.id_unita_confezione~"    OP =~"=~"RIGHT=~"prezzo.id_unita_confezione~" )    JOIN (LEFT=~"unita_confezione.id_articolo~"    OP =~"=~"RIGHT=~"articolo.id_articolo~" )WHERE(    EXP1 =~"~~~"prezzo~~~".~~~"id_unita_confezione~~~"~"   OP =~"=~"    EXP2 =~":id_uc~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"prezzo~~~".~~~"id_variazione~~~"~"   OP =~"=~"    EXP2 =~":id_variazione~" ) ) ARG(NAME = ~"id_uc~" TYPE = number)  ARG(NAME = ~"id_variazione~" TYPE = number) " update="prezzo" updatewhere=1 updatekeyinplace=yes arguments=(("id_uc", number),("id_variazione", number)) )
