table(column=(type=char(2) updatewhereclause=yes name=galvanica_lavorazione dbname="galvanica.lavorazione" )
 column=(type=decimal(4) updatewhereclause=yes name=galvanica_prezzo_gr dbname="galvanica.prezzo_gr" )
 column=(type=decimal(4) updatewhereclause=yes name=c_sum_peso dbname="c_sum_peso" )
 column=(type=char(32) updatewhereclause=yes name=galvanica_descrizione dbname="galvanica.descrizione" )
 column=(type=decimal(6) updatewhereclause=yes name=riga_documento_prezzo_metallo dbname="riga_documento.prezzo_metallo" )
 column=(type=decimal(4) updatewhereclause=yes name=c_sum_qta dbname="c_sum_qta" )
 column=(type=char(16) updatewhereclause=yes name=documento_num_documento dbname="documento.num_documento" )
 column=(type=date updatewhereclause=yes name=documento_data_documento dbname="documento.data_documento" )
 retrieve="  SELECT  ~"galvanica~".~"lavorazione~" ,           ~"galvanica~".~"prezzo_gr~" ,           sum(~"riga_documento~".~"peso_netto~" ) as c_sum_peso,  
         ~"galvanica~".~"descrizione~" ,           ~"riga_documento~".~"prezzo_metallo~" ,      
     sum(~"riga_documento~".~"quantita~") as c_sum_qta , ~"documento~".~"num_documento~",  ~"documento~".~"data_documento~"    
FROM ~"galvanica~" ,     ~"riga_documento~"  , ~"documento~"   , ~"registro~"
WHERE ( ~"galvanica~".~"id_galvanica~" = ~"riga_documento~".~"id_gruppo_agenti_2~" ) and  
( ~"riga_documento~".~"id_documento~"=  ~"documento~".~"id_documento~" ) 
and ~"documento~".~"id_registro~"=~"registro~".~"id_registro~" and ~"registro~".~"tipo_registro~"='IV'
and ~"documento~".~"data_documento~" >= :da_data and ~"documento~".~"data_documento~" <= :lupo
GROUP BY ~"galvanica~".~"lavorazione~" , ~"galvanica~".~"prezzo_gr~" ,  ~"galvanica~".~"descrizione~" , ~"riga_documento~".~"prezzo_metallo~", ~"documento~".~"num_documento~", ~"documento~".~"data_documento~"  
 ORDER BY ~"galvanica~".~"lavorazione~"          ASC,           ~"galvanica~".~"prezzo_gr~"          ASC,   ~"documento~".~"data_documento~" asc, ~"documento~".~"data_documento~" asc
" arguments=(("da_data", date),("lupo", date)) )
