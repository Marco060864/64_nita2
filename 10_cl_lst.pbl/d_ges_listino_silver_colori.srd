table(column=(type=long update=yes updatewhereclause=yes name=prezzo_id_unita_confezione dbname="prezzo.id_unita_confezione" dbalias=".id_unita_confezione" )
 column=(type=long update=yes updatewhereclause=yes name=prezzo_id_variazione dbname="prezzo.id_variazione" dbalias=".id_variazione" )
 column=(type=decimal(6) update=yes updatewhereclause=yes name=prezzo_prezzo dbname="prezzo.prezzo" dbalias=".prezzo" )
 column=(type=decimal(2) updatewhereclause=yes name=prezzo_coef_calo dbname="prezzo.coef_calo" dbalias=".coef_calo" )
 column=(type=decimal(6) update=yes updatewhereclause=yes name=prezzo_prezzo_manifattura dbname="prezzo.prezzo_manifattura" dbalias=".prezzo_manifattura" )
 column=(type=decimal(6) updatewhereclause=yes name=prezzo_costo_imballo dbname="prezzo.costo_imballo" dbalias=".costo_imballo" )
 column=(type=decimal(6) updatewhereclause=yes name=prezzo_galvanica dbname="prezzo.galvanica" dbalias=".galvanica" )
 column=(type=char(255) update=yes updatewhereclause=yes name=prezzo_des_1 dbname="prezzo.des_1" dbalias=".des_1" )
 column=(type=char(255) update=yes updatewhereclause=yes name=prezzo_des_2 dbname="prezzo.des_2" dbalias=".des_2" )
 column=(type=char(255) update=yes updatewhereclause=yes name=prezzo_des_3 dbname="prezzo.des_3" dbalias=".des_3" )
 column=(type=datetime update=yes updatewhereclause=yes name=prezzo_ultima_modifica dbname="prezzo.ultima_modifica" dbalias=".ultima_modifica" )
 column=(type=char(8) updatewhereclause=yes name=unita_confezione_codice dbname="unita_confezione.codice" dbalias=".codice" )
 column=(type=char(64) updatewhereclause=yes name=articolo_codice dbname="articolo.codice" dbalias=".codice" )
 column=(type=long updatewhereclause=yes identity=yes name=id_articolo dbname="articolo.id_articolo" dbalias=".id_articolo" )
 column=(type=char(1) update=yes updatewhereclause=yes name=prezzo_confermato dbname="prezzo.confermato" dbalias=".confermato" values="	C/	N" )
 column=(type=long updatewhereclause=yes name=c_scelto dbname="c_scelto" values="	1/	0" )
 column=(type=char(1) update=yes updatewhereclause=yes name=prezzo_ins_automatico dbname="prezzo.ins_automatico" dbalias=".ins_automatico" )
 column=(type=char(5) update=yes updatewhereclause=yes name=prezzo_cliente dbname="prezzo.cliente" dbalias=".cliente" )
 column=(type=char(80) updatewhereclause=yes name=articolo_descrizione dbname="articolo.descrizione" dbalias=".descrizione" )
 column=(type=decimal(6) updatewhereclause=yes name=c_controllato_k dbname="c_controllato_k" )
 column=(type=char(255) updatewhereclause=yes name=cod_accessori_k_descrizione dbname="cod_accessori_k_descrizione" )
 retrieve="  SELECT ~"prezzo~".~"id_unita_confezione~",   
         ~"prezzo~".~"id_variazione~",   
         ~"prezzo~".~"prezzo~",   
         ~"prezzo~".~"coef_calo~",   
         ~"prezzo~".~"prezzo_manifattura~",   
         ~"prezzo~".~"costo_imballo~",   
         ~"prezzo~".~"galvanica~",   
         ~"prezzo~".~"des_1~",   
         ~"prezzo~".~"des_2~",   
         ~"prezzo~".~"des_3~",   
         ~"prezzo~".~"ultima_modifica~",   
         ~"unita_confezione~".~"codice~",   
         ~"articolo~".~"codice~",   
         ~"articolo~".~"id_articolo~",   
         ~"prezzo~".~"confermato~",   
         0 as c_scelto,   
         ~"prezzo~".~"ins_automatico~",   
         ~"prezzo~".~"cliente~",   
         ~"articolo~".~"descrizione~",   
         0.000001 as c_controllato_k,
		(select first(k.descrizione) from dba.cod_accessori_k k, bollettine_excel b where k.cod_accessorio=b.accessorio and b.articolo=articolo.codice order by k.cod_accessorio ) as cod_accessori_k_descrizione
    FROM ~"articolo~",   
         ~"prezzo~",   
         ~"unita_confezione~"  
   WHERE ( ~"unita_confezione~".~"id_unita_confezione~" = ~"prezzo~".~"id_unita_confezione~" ) and  
         ( ~"unita_confezione~".~"id_articolo~" = ~"articolo~".~"id_articolo~" ) and  
         ( ( ~"prezzo~".~"id_variazione~" = :id_variazione ) )    
" arguments=(("id_variazione", number))  sort="articolo_codice A " )
