table(column=(type=decimal(0) updatewhereclause=yes name=giorni_data_decorrenza dbname="app_pagamento.giorni_data_decorrenza" dbalias=".giorni_data_decorrenza" )
 column=(type=decimal(0) updatewhereclause=yes name=num_rate dbname="app_pagamento.num_rate" dbalias=".num_rate" )
 column=(type=decimal(0) updatewhereclause=yes name=giorni_rate dbname="app_pagamento.giorni_rate" dbalias=".giorni_rate" )
 column=(type=char(4) updatewhereclause=yes name=tipo_pagamento dbname="con_pagamento.tipo_pagamento" dbalias=".tipo_pagamento" )
 column=(type=char(4) updatewhereclause=yes name=mod_pagamento dbname="con_pagamento.mod_pagamento" dbalias=".mod_pagamento" )
 column=(type=long updatewhereclause=yes identity=yes name=documento_id_documento dbname="documento.id_documento" dbalias=".id_documento" )
 column=(type=date updatewhereclause=yes name=data_scadenza dbname="scadenza.data_scadenza" dbalias=".data_scadenza" )
 column=(type=decimal(4) updatewhereclause=yes name=imp_valuta dbname="scadenza.imp_valuta" dbalias=".imp_valuta" )
 column=(type=char(2) updatewhereclause=yes name=iban_nazione dbname="banca_sog_commerciale.iban_nazione" dbalias=".iban_nazione" )
 column=(type=char(2) updatewhereclause=yes name=iban_contr_internazionale dbname="banca_sog_commerciale.iban_contr_internazionale" dbalias=".iban_contr_internazionale" )
 column=(type=char(1) updatewhereclause=yes name=cin dbname="banca_sog_commerciale.cin" dbalias=".cin" )
 column=(type=char(5) updatewhereclause=yes name=cod_abi dbname="banca_appoggio.cod_abi" dbalias=".cod_abi" )
 column=(type=char(5) updatewhereclause=yes name=cod_cab dbname="banca_appoggio.cod_cab" dbalias=".cod_cab" )
 column=(type=char(20) updatewhereclause=yes name=conto_corrente dbname="banca_sog_commerciale.conto_corrente" dbalias=".conto_corrente" )
 column=(type=decimal(4) updatewhereclause=yes name=importo dbname="scadenza.importo" dbalias=".importo" )
 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"app_pagamento~" )  TABLE(NAME=~"con_pagamento~" )  TABLE(NAME=~"documento~" )  TABLE(NAME=~"scadenza~" )  TABLE(NAME=~"banca_sog_commerciale~" )  TABLE(NAME=~"banca_appoggio~" ) COLUMN(NAME=~"app_pagamento.giorni_data_decorrenza~") COLUMN(NAME=~"app_pagamento.num_rate~") COLUMN(NAME=~"app_pagamento.giorni_rate~") COLUMN(NAME=~"con_pagamento.tipo_pagamento~") COLUMN(NAME=~"con_pagamento.mod_pagamento~") COLUMN(NAME=~"documento.id_documento~") COLUMN(NAME=~"scadenza.data_scadenza~") COLUMN(NAME=~"scadenza.imp_valuta~") COLUMN(NAME=~"banca_sog_commerciale.iban_nazione~") COLUMN(NAME=~"banca_sog_commerciale.iban_contr_internazionale~") COLUMN(NAME=~"banca_sog_commerciale.cin~") COLUMN(NAME=~"banca_appoggio.cod_abi~") COLUMN(NAME=~"banca_appoggio.cod_cab~") COLUMN(NAME=~"banca_sog_commerciale.conto_corrente~") COLUMN(NAME=~"scadenza.importo~")    JOIN (LEFT=~"con_pagamento.id_con_pagamento~"    OP =~"=~"RIGHT=~"app_pagamento.id_con_pagamento~"    OUTER1 =~"con_pagamento.id_con_pagamento~" )    JOIN (LEFT=~"documento.id_con_pagamento~"    OP =~"=~"RIGHT=~"con_pagamento.id_con_pagamento~"    OUTER1 =~"documento.id_con_pagamento~" )    JOIN (LEFT=~"documento.id_banca_sog_commerciale~"    OP =~"=~"RIGHT=~"banca_sog_commerciale.id_banca_sog_commerciale~"    OUTER1 =~"documento.id_banca_sog_commerciale~" )    JOIN (LEFT=~"banca_appoggio.id_banca_appoggio~"    OP =~"=~"RIGHT=~"banca_sog_commerciale.id_banca_appoggio~"    OUTER2 =~"banca_sog_commerciale.id_banca_appoggio~" )    JOIN (LEFT=~"scadenza.id_documento~"    OP =~"=~"RIGHT=~"documento.id_documento~" )WHERE(    EXP1 =~"~~~"documento~~~".~~~"id_documento~~~"~"   OP =~"=~"    EXP2 =~":id_doc~" ) ) ARG(NAME = ~"id_doc~" TYPE = number) " arguments=(("id_doc", number)) )
