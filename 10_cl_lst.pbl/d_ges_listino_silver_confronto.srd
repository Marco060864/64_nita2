table(column=(type=long update=yes updatewhereclause=yes key=yes name=prezzo_id_unita_confezione dbname="prezzo.id_unita_confezione" )
 column=(type=long update=yes updatewhereclause=yes key=yes name=prezzo_id_variazione dbname="prezzo.id_variazione" )
 column=(type=decimal(6) update=yes updatewhereclause=yes name=prezzo_prezzo dbname="prezzo.prezzo" )
 column=(type=decimal(2) updatewhereclause=yes name=prezzo_coef_calo dbname="prezzo.coef_calo" )
 column=(type=decimal(6) update=yes updatewhereclause=yes name=prezzo_prezzo_manifattura dbname="prezzo.prezzo_manifattura" )
 column=(type=decimal(6) updatewhereclause=yes name=prezzo_costo_imballo dbname="prezzo.costo_imballo" )
 column=(type=decimal(6) updatewhereclause=yes name=prezzo_galvanica dbname="prezzo.galvanica" )
 column=(type=char(255) updatewhereclause=yes name=prezzo_des_1 dbname="prezzo.des_1" )
 column=(type=char(255) updatewhereclause=yes name=prezzo_des_2 dbname="prezzo.des_2" )
 column=(type=char(255) updatewhereclause=yes name=prezzo_des_3 dbname="prezzo.des_3" )
 column=(type=datetime update=yes updatewhereclause=yes name=prezzo_ultima_modifica dbname="prezzo.ultima_modifica" )
 column=(type=char(8) updatewhereclause=yes name=unita_confezione_codice dbname="unita_confezione.codice" )
 column=(type=long updatewhereclause=yes identity=yes name=id_articolo dbname="articolo.id_articolo" )
 column=(type=char(1) update=yes updatewhereclause=yes name=prezzo_confermato dbname="prezzo.confermato" values="	C/	N" )
 column=(type=long updatewhereclause=yes name=c_scelto dbname="c_scelto" values="	1/	0" )
 column=(type=char(1) updatewhereclause=yes name=prezzo_ins_automatico dbname="prezzo.ins_automatico" )
 column=(type=char(5) updatewhereclause=yes name=prezzo_cliente dbname="prezzo.cliente" )
 column=(type=char(64) updatewhereclause=yes name=articolo_codice dbname="articolo.codice" )
 column=(type=char(80) updatewhereclause=yes name=articolo_descrizione dbname="articolo.descrizione" )
 column=(type=decimal(6) updatewhereclause=yes name=c_controllato_k dbname="c_controllato_k" )
 column=(type=decimal(6) update=yes updatewhereclause=yes name=prezzo_kar dbname="prezzo.prezzo" )
 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"articolo~" )  TABLE(NAME=~"prezzo~" ALIAS=~"prezzo_a~" )  TABLE(NAME=~"unita_confezione~" )  TABLE(NAME=~"prezzo~" ALIAS=~"prezzo_b~" ) COLUMN(NAME=~"prezzo_a.id_unita_confezione~") COLUMN(NAME=~"prezzo_a.id_variazione~") COLUMN(NAME=~"prezzo_a.prezzo~") COLUMN(NAME=~"prezzo_a.coef_calo~") COLUMN(NAME=~"prezzo_a.prezzo_manifattura~") COLUMN(NAME=~"prezzo_a.costo_imballo~") COLUMN(NAME=~"prezzo_a.galvanica~") COLUMN(NAME=~"prezzo_a.des_1~") COLUMN(NAME=~"prezzo_a.des_2~") COLUMN(NAME=~"prezzo_a.des_3~") COLUMN(NAME=~"prezzo_a.ultima_modifica~") COLUMN(NAME=~"unita_confezione.codice~") COLUMN(NAME=~"articolo.id_articolo~") COLUMN(NAME=~"prezzo_a.confermato~") COMPUTE(NAME=~"0 as c_scelto~") COLUMN(NAME=~"prezzo_a.ins_automatico~") COLUMN(NAME=~"prezzo_a.cliente~") COLUMN(NAME=~"articolo.codice~") COLUMN(NAME=~"articolo.descrizione~") COMPUTE(NAME=~"0.000001 as c_controllato_k~") COLUMN(NAME=~"prezzo_b.prezzo~")    JOIN (LEFT=~"unita_confezione.id_unita_confezione~"    OP =~"=~"RIGHT=~"prezzo_b.id_unita_confezione~"    OUTER1 =~"unita_confezione.id_unita_confezione~" )   JOIN (LEFT=~"unita_confezione.id_unita_confezione~"    OP =~"=~"RIGHT=~"prezzo_a.id_unita_confezione~" )    JOIN (LEFT=~"unita_confezione.id_articolo~"    OP =~"=~"RIGHT=~"articolo.id_articolo~" ) WHERE(    EXP1 =~"~~~"prezzo_a~~~".~~~"id_variazione~~~"~"   OP =~"=~"    EXP2 =~":id_variazione~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"prezzo_b~~~".~~~"id_variazione~~~"~"   OP =~"=~"    EXP2 =~"15~" ) ) ARG(NAME = ~"id_variazione~" TYPE = number) " update="prezzo" updatewhere=1 updatekeyinplace=yes arguments=(("id_variazione", number))  sort="articolo_codice A " )
