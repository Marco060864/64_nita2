table(column=(type=decimal(6) updatewhereclause=yes name=c_tot_ddt_in_fattura dbname="compute_0001" )
 column=(type=decimal(0) updatewhereclause=yes name=num_prog_ddt dbname="num_prog_ddt" )
 column=(type=long updatewhereclause=yes name=id_doc_ddt dbname="id_doc_ddt" )
 column=(type=date updatewhereclause=yes name=documento_data_documento dbname="documento.data_documento" dbalias="dc.data_documento" )
 column=(type=char(16) updatewhereclause=yes name=documento_num_documento dbname="documento.num_documento" dbalias="dc.num_documento" )
 column=(type=decimal(3) updatewhereclause=yes name=c_tot_ddt dbname="c_tot_ddt" )
 column=(type=long updatewhereclause=yes name=id_doc_fattura dbname="documento.id_doc_fattura" dbalias="dc.id_doc_fattura" )
 retrieve="
SELECT sum(tot_riga_val_riga), (select num_progressivo from documento d, riga_documento r where d.id_documento=r.id_documento 
and r.id_riga_documento=rd.id_riga_doc_provenienza) AS NUM_prog_DDT, (select d.id_documento from documento d, riga_documento r where d.id_documento=r.id_documento 
and r.id_riga_documento=rd.id_riga_doc_provenienza) AS ID_DOC_DDT,
data_documento, num_documento, 0.001 as c_tot_ddt, dc.id_documento as id_doc_fattura
 FROM riga_documento rd, documento dc
where dc.id_documento=:al_id_doc 
and rd.id_documento= dc.id_documento
group BY  NUM_prog_DDT, ID_DOC_DDT, data_documento, num_documento, c_tot_ddt, id_doc_fattura
ORDER BY NUM_prog_DDT " arguments=(("al_id_doc", number)) )
