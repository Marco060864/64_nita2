table(column=(type=long update=yes updatewhereclause=yes key=yes name=prezzo_id_unita_confezione dbname="prezzo.id_unita_confezione" )
 column=(type=long update=yes updatewhereclause=yes key=yes name=prezzo_id_variazione dbname="prezzo.id_variazione" )
 column=(type=decimal(6) update=yes updatewhereclause=yes name=prezzo_prezzo dbname="prezzo.prezzo" )
 column=(type=decimal(2) updatewhereclause=yes name=prezzo_coef_calo dbname="prezzo.coef_calo" )
 column=(type=decimal(6) update=yes updatewhereclause=yes name=prezzo_prezzo_manifattura dbname="prezzo.prezzo_manifattura" )
 column=(type=decimal(6) updatewhereclause=yes name=prezzo_costo_imballo dbname="prezzo.costo_imballo" )
 column=(type=decimal(6) updatewhereclause=yes name=prezzo_galvanica dbname="prezzo.galvanica" )
 column=(type=char(255) update=yes updatewhereclause=yes name=prezzo_des_1 dbname="prezzo.des_1" )
 column=(type=char(255) update=yes updatewhereclause=yes name=prezzo_des_2 dbname="prezzo.des_2" )
 column=(type=char(255) update=yes updatewhereclause=yes name=prezzo_des_3 dbname="prezzo.des_3" )
 column=(type=datetime update=yes updatewhereclause=yes name=prezzo_ultima_modifica dbname="prezzo.ultima_modifica" )
 column=(type=char(8) updatewhereclause=yes name=unita_confezione_codice dbname="unita_confezione.codice" )
 column=(type=char(64) updatewhereclause=yes name=articolo_codice dbname="articolo.codice" )
 column=(type=long updatewhereclause=yes identity=yes name=id_articolo dbname="articolo.id_articolo" )
 column=(type=char(1) update=yes updatewhereclause=yes name=prezzo_confermato dbname="prezzo.confermato" values="	C/	N" )
 column=(type=long updatewhereclause=yes name=c_scelto dbname="c_scelto" values="	1/	0" )
 column=(type=char(1) update=yes updatewhereclause=yes name=prezzo_ins_automatico dbname="prezzo.ins_automatico" )
 column=(type=char(5) update=yes updatewhereclause=yes name=prezzo_cliente dbname="prezzo.cliente" )
 column=(type=char(80) updatewhereclause=yes name=articolo_descrizione dbname="articolo.descrizione" )
 column=(type=decimal(6) updatewhereclause=yes name=c_controllato_k dbname="c_controllato_k" )
 column=(type=char(1) update=yes updatewhereclause=yes name=prezzo_scheda_tecnica dbname="prezzo.scheda_tecnica" values="	S/	N" )
 column=(type=decimal(6) update=yes updatewhereclause=yes name=prezzo_pr_spazzolatura dbname="prezzo.pr_spazzolatura" )
 column=(type=char(1) updatewhereclause=yes name=tipo_conversione dbname="unita_confezione.tipo_conversione" values="	S/	N" )
 column=(type=long update=yes updatewhereclause=yes name=prezzo_id_utente dbname="prezzo.id_utente" )
 column=(type=datetime update=yes updatewhereclause=yes name=prezzo_ult_modifica_2 dbname="prezzo.ult_modifica_2" )
 retrieve="  SELECT  prezzo.id_unita_confezione ,           prezzo.id_variazione ,           prezzo.prezzo ,           prezzo.coef_calo ,           prezzo.prezzo_manifattura ,   
        prezzo.costo_imballo ,           prezzo.galvanica ,           prezzo.des_1 ,           prezzo.des_2 ,           prezzo.des_3 ,           prezzo.ultima_modifica ,     
      unita_confezione.codice ,           articolo.codice ,           articolo.id_articolo ,           prezzo.confermato ,           0 as c_scelto,           prezzo.ins_automatico ,     
      prezzo.cliente ,           articolo.descrizione ,           0.000001 as c_controllato_k,           prezzo.scheda_tecnica ,           prezzo.pr_spazzolatura ,      
     unita_confezione.tipo_conversione ,           prezzo.id_utente ,           prezzo.ult_modifica_2        

   FROM articolo ,           prezzo ,           unita_confezione     WHERE ( unita_confezione.id_unita_confezione = prezzo.id_unita_confezione ) and          ( unita_confezione.id_articolo = articolo.id_articolo ) and          ( ( ~"prezzo~".~"id_variazione~" = :id_variazione ) )   " update="prezzo" updatewhere=1 updatekeyinplace=yes arguments=(("id_variazione", number))  sort="articolo_codice A " )
