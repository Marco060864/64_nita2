table(column=(type=char(16) updatewhereclause=yes name=documento_num_documento dbname="documento.num_documento" )
 column=(type=date updatewhereclause=yes name=documento_data_documento dbname="documento.data_documento" )
 column=(type=long updatewhereclause=yes name=produzione_2011_id_bollettina dbname="produzione_2011.id_bollettina" )
 column=(type=long updatewhereclause=yes name=produzione_2011_id_doc_produzione dbname="produzione_2011.id_doc_produzione" )
 column=(type=char(16) updatewhereclause=yes name=documento_num_documento_1 dbname="documento.num_documento" )
 column=(type=date updatewhereclause=yes name=documento_data_documento_1 dbname="documento.data_documento" )
 column=(type=long updatewhereclause=yes name=documento_id_prof_documento dbname="documento.id_prof_documento" )
 column=(type=long updatewhereclause=yes name=documento_id_sog_commerciale dbname="documento.id_sog_commerciale" )
 column=(type=char(8) updatewhereclause=yes name=prof_documento_codice dbname="prof_documento.codice" )
 column=(type=char(8) updatewhereclause=yes name=sog_commerciale_gen_codice dbname="sog_commerciale_gen.codice" )
 column=(type=char(40) updatewhereclause=yes name=sog_commerciale_gen_rag_soc_1 dbname="sog_commerciale_gen.rag_soc_1" )
 column=(type=decimal(0) updatewhereclause=yes name=num_riga dbname="riga_documento.num_riga" )
 column=(type=long updatewhereclause=yes name=id_articolo dbname="riga_documento.id_articolo" )
 column=(type=decimal(4) updatewhereclause=yes name=quantita dbname="riga_documento.quantita" )
 column=(type=decimal(4) updatewhereclause=yes name=peso_netto dbname="riga_documento.peso_netto" )
 column=(type=char(7) updatewhereclause=yes name=c_num_bollettina1 dbname="c_num_bollettina1" )
 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"produzione_2011~" )  TABLE(NAME=~"documento~" ALIAS=~"d1~" )  TABLE(NAME=~"documento~" ALIAS=~"d2~" )  TABLE(NAME=~"riga_documento~" )  TABLE(NAME=~"prof_documento~" )  TABLE(NAME=~"sog_commerciale_gen~" ) COLUMN(NAME=~"d1.num_documento~") COLUMN(NAME=~"d1.data_documento~") COLUMN(NAME=~"produzione_2011.id_bollettina~") COLUMN(NAME=~"produzione_2011.id_doc_produzione~") COLUMN(NAME=~"d2.num_documento~") COLUMN(NAME=~"d2.data_documento~") COLUMN(NAME=~"d2.id_prof_documento~") COLUMN(NAME=~"d2.id_sog_commerciale~") COLUMN(NAME=~"prof_documento.codice~") COLUMN(NAME=~"sog_commerciale_gen.codice~") COLUMN(NAME=~"sog_commerciale_gen.rag_soc_1~") COLUMN(NAME=~"riga_documento.num_riga~") COLUMN(NAME=~"riga_documento.id_articolo~") COLUMN(NAME=~"riga_documento.quantita~") COLUMN(NAME=~"riga_documento.peso_netto~") COMPUTE(NAME=~"(select right(d1.num_documento, 7)) as c_num_bollettina1~")    JOIN (LEFT=~"d1.id_documento~"    OP =~"=~"RIGHT=~"produzione_2011.id_bollettina~" )    JOIN (LEFT=~"d2.id_documento~"    OP =~"=~"RIGHT=~"riga_documento.id_documento~" )    JOIN (LEFT=~"produzione_2011.id_doc_produzione~"    OP =~"=~"RIGHT=~"riga_documento.id_riga_documento~" )    JOIN (LEFT=~"d2.id_prof_documento~"    OP =~"=~"RIGHT=~"prof_documento.id_prof_documento~" )    JOIN (LEFT=~"d2.id_sog_commerciale~"    OP =~"=~"RIGHT=~"sog_commerciale_gen.id_sog_commerciale~" )WHERE(    EXP1 =~"~~~"d2~~~".~~~"data_documento~~~"~"   OP =~">=~"    EXP2 =~"20220101~" ) ) ORDER(NAME=~"d1.data_documento~" ASC=no)  ORDER(NAME=~"d1.num_documento~" ASC=no)  ORDER(NAME=~"d2.data_documento~" ASC=no)  ORDER(NAME=~"d2.num_documento~" ASC=yes )  ORDER(NAME=~"riga_documento.num_riga~" ASC=yes ) " )
