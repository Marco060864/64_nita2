PBSELECT( VERSION(400) TABLE(NAME="articolo" )  TABLE(NAME="prezzo" )  TABLE(NAME="unita_confezione" ) COLUMN(NAME="prezzo.id_unita_confezione") COLUMN(NAME="prezzo.id_variazione") COLUMN(NAME="prezzo.prezzo") COLUMN(NAME="prezzo.coef_calo") COLUMN(NAME="prezzo.prezzo_manifattura") COLUMN(NAME="prezzo.costo_imballo") COLUMN(NAME="prezzo.galvanica") COLUMN(NAME="prezzo.des_1") COLUMN(NAME="prezzo.des_2") COLUMN(NAME="prezzo.des_3") COLUMN(NAME="prezzo.ultima_modifica") COLUMN(NAME="unita_confezione.codice") COLUMN(NAME="articolo.codice") COLUMN(NAME="articolo.id_articolo") COLUMN(NAME="prezzo.confermato") COMPUTE(NAME="0 as c_scelto") COLUMN(NAME="prezzo.ins_automatico") COLUMN(NAME="prezzo.cliente") COLUMN(NAME="articolo.descrizione") COMPUTE(NAME="0.000001 as c_controllato_k")    JOIN (LEFT="unita_confezione.id_unita_confezione"    OP ="="RIGHT="prezzo.id_unita_confezione" )    JOIN (LEFT="unita_confezione.id_articolo"    OP ="="RIGHT="articolo.id_articolo" )WHERE(    EXP1 ="~"prezzo~".~"id_variazione~""   OP ="="    EXP2 =":id_variazione" ) ) ARG(NAME = "id_variazione" TYPE = number) 