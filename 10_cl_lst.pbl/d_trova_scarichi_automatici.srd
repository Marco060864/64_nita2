 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"documento~" ALIAS=~"documento_a~" )  TABLE(NAME=~"riga_documento~" ALIAS=~"riga_documento_a~" )  TABLE(NAME=~"partite_automatiche~" )  TABLE(NAME=~"riga_documento~" ALIAS=~"riga_documento_b~" )  TABLE(NAME=~"documento~" ALIAS=~"documento_b~" ) COLUMN(NAME=~"documento_b.num_progressivo~") COLUMN(NAME=~"documento_b.data_registrazione~") COLUMN(NAME=~"documento_b.num_documento~") COLUMN(NAME=~"documento_b.data_documento~") COLUMN(NAME=~"riga_documento_b.num_riga~") COLUMN(NAME=~"riga_documento_b.quantita~") COLUMN(NAME=~"riga_documento_b.peso_netto~") COLUMN(NAME=~"riga_documento_a.num_riga~") COLUMN(NAME=~"riga_documento_a.quantita~") COLUMN(NAME=~"riga_documento_a.peso_netto~") COLUMN(NAME=~"documento_a.num_progressivo~") COLUMN(NAME=~"documento_a.data_registrazione~") COLUMN(NAME=~"documento_a.num_documento~") COLUMN(NAME=~"documento_a.data_documento~")    JOIN (LEFT=~"partite_automatiche.id_riga_doc_scarico~"    OP =~"=~"RIGHT=~"riga_documento_a.id_riga_documento~" )    JOIN (LEFT=~"riga_documento_b.id_riga_documento~"    OP =~"=~"RIGHT=~"partite_automatiche.id_riga_doc_carico~" )    JOIN (LEFT=~"riga_documento_a.id_documento~"    OP =~"=~"RIGHT=~"documento_a.id_documento~" )    JOIN (LEFT=~"riga_documento_b.id_documento~"    OP =~"=~"RIGHT=~"documento_b.id_documento~" )WHERE(    EXP1 =~"~~~"documento_a~~~".~~~"id_documento~~~"~"   OP =~"=~"    EXP2 =~":id_doc~" ) ) ARG(NAME = ~"id_doc~" TYPE = number) " arguments=(("id_doc", number))  sort="documento_num_documento A " )
