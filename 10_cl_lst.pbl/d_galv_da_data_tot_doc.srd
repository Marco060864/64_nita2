table(column=(type=char(12) updatewhereclause=yes name=galvanica_lavorazione dbname="galvanica.lavorazione" dbalias=".lavorazione" )
 column=(type=decimal(4) updatewhereclause=yes name=galvanica_prezzo_gr dbname="galvanica.prezzo_gr" dbalias=".prezzo_gr" )
 column=(type=decimal(4) updatewhereclause=yes name=c_sum_peso dbname="c_sum_peso" )
 column=(type=char(32) updatewhereclause=yes name=galvanica_descrizione dbname="galvanica.descrizione" dbalias=".descrizione" )
 column=(type=decimal(6) updatewhereclause=yes name=riga_documento_prezzo_metallo dbname="riga_documento.prezzo_metallo" dbalias=".prezzo_metallo" )
 column=(type=decimal(4) updatewhereclause=yes name=c_sum_qta dbname="c_sum_qta" )
 column=(type=date updatewhereclause=yes name=documento_data_documento dbname="documento.data_documento" dbalias=".data_documento" )
 column=(type=char(16) updatewhereclause=yes name=documento_num_documento dbname="documento.num_documento" dbalias=".num_documento" )
 column=(type=char(8) updatewhereclause=yes name=prof_documento_codice dbname="prof_documento.codice" dbalias=".codice" )
 column=(type=decimal(4) updatewhereclause=yes name=prezzo_da_data1 dbname="galvanica.prezzo_da_data1" dbalias=".prezzo_da_data1" )
 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"galvanica~" )  TABLE(NAME=~"riga_documento~" )  TABLE(NAME=~"documento~" )  TABLE(NAME=~"prof_documento~" ) COLUMN(NAME=~"galvanica.lavorazione~") COLUMN(NAME=~"galvanica.prezzo_gr~") COMPUTE(NAME=~"sum(~~~"riga_documento~~~".~~~"peso_netto~~~" ) as c_sum_peso~") COLUMN(NAME=~"galvanica.descrizione~") COLUMN(NAME=~"riga_documento.prezzo_metallo~") COMPUTE(NAME=~"sum(~~~"riga_documento~~~".~~~"quantita~~~") as c_sum_qta~") COLUMN(NAME=~"documento.data_documento~") COLUMN(NAME=~"documento.num_documento~") COLUMN(NAME=~"prof_documento.codice~") COLUMN(NAME=~"galvanica.prezzo_da_data1~")    JOIN (LEFT=~"galvanica.id_galvanica~"    OP =~"=~"RIGHT=~"riga_documento.id_gruppo_agenti_2~" )    JOIN (LEFT=~"riga_documento.id_documento~"    OP =~"=~"RIGHT=~"documento.id_documento~" )    JOIN (LEFT=~"documento.id_prof_documento~"    OP =~"=~"RIGHT=~"prof_documento.id_prof_documento~" )WHERE(    EXP1 =~"~~~"documento~~~".~~~"data_documento~~~"~"   OP =~">=~"    EXP2 =~":da_data~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"documento~~~".~~~"data_documento~~~"~"   OP =~"<=~"    EXP2 =~":a_data~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"galvanica~~~".~~~"lavorazione~~~"~"   OP =~">~"    EXP2 =~"' '~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"(~~~"documento~~~".~~~"id_prof_documento~~~"~"   OP =~"=~"    EXP2 =~"66~"    LOGIC =~"or~" ) WHERE(    EXP1 =~"~~~"documento~~~".~~~"id_prof_documento~~~"~"   OP =~"=~"    EXP2 =~"150~"    LOGIC =~"or~" ) WHERE(    EXP1 =~"~~~"documento~~~".~~~"id_prof_documento~~~"~"   OP =~"=~"    EXP2 =~"116~"    LOGIC =~"or~" ) WHERE(    EXP1 =~"~~~"documento~~~".~~~"id_prof_documento~~~"~"   OP =~"=~"    EXP2 =~"25)~" )  GROUP(NAME=~"galvanica.lavorazione~") GROUP(NAME=~"galvanica.prezzo_gr~") GROUP(NAME=~"galvanica.descrizione~") GROUP(NAME=~"riga_documento.prezzo_metallo~") GROUP(NAME=~"documento.num_documento~") GROUP(NAME=~"documento.data_documento~") GROUP(NAME=~"prof_documento.codice~") GROUP(NAME=~"galvanica.prezzo_da_data1~")) ORDER(NAME=~"galvanica.prezzo_gr~" ASC=yes )  ORDER(NAME=~"galvanica.prezzo_da_data1~" ASC=yes )  ORDER(NAME=~"documento.num_documento~" ASC=yes ) ARG(NAME = ~"da_data~" TYPE = date)  ARG(NAME = ~"a_data~" TYPE = date) " arguments=(("da_data", date),("a_data", date))  sort="galvanica_lavorazione A documento_data_documento A documento_num_documento A " )
