(NAME=~"riga_documento_a.provv_imp_carea_2~") COLUMN(NAME=~"documento_b.num_documento~") COMPUTE(NAME=~"'N' as c_lavorata~")    JOIN (LEFT=~"riga_documento_a.provv_imp_subage_2~"    OP =~"=~"RIGHT=~"riga_documento_b.id_riga_documento~"    OUTER1 =~"riga_documento_a.provv_imp_subage_2~" )    JOIN (LEFT=~"riga_documento_b.id_documento~"    OP =~"=~"RIGHT=~"documento_b.id_documento~"    OUTER1 =~"riga_documento_b.id_documento~" )    JOIN (LEFT=~"riga_documento_a.id_documento~"    OP =~"=~"RIGHT=~"documento_a.id_documento~" )WHERE(    EXP1 =~"~~~"riga_documento_a~~~".~~~"id_documento~~~"~"   OP =~"=~"    EXP2 =~":ll_id_doc~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"riga_documento_a~~~".~~~"id_articolo~~~"~"   OP =~"<>~"    EXP2 =~"8942~" ) ) ARG(NAME = ~"ll_id_doc~" TYPE = number) " update="riga_documento" updatewhere=1 updatekeyinplace=yes arguments=(("ll_id_doc", number))  sort="num_riga A " )
