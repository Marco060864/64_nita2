 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"riga_documento~" )  TABLE(NAME=~"articolo~" ) COLUMN(NAME=~"riga_documento.id_documento~") COLUMN(NAME=~"riga_documento.id_riga_doc_provenienza~") COLUMN(NAME=~"riga_documento.id_riga_documento~") COLUMN(NAME=~"articolo.id_articolo~") COLUMN(NAME=~"articolo.codice~") COLUMN(NAME=~"riga_documento.num_riga~") COLUMN(NAME=~"riga_documento.id_unita_confezione~") COLUMN(NAME=~"riga_documento.descrizione~") COLUMN(NAME=~"riga_documento.quantita~") COLUMN(NAME=~"riga_documento.qta_evasa~") COLUMN(NAME=~"riga_documento.peso_netto~") COLUMN(NAME=~"riga_documento.peso_lordo~") COLUMN(NAME=~"riga_documento.id_riga_partita~") COLUMN(NAME=~"riga_documento.calo~") COLUMN(NAME=~"riga_documento.fino~") COLUMN(NAME=~"riga_documento.id_riga_doc_padre~") COLUMN(NAME=~"riga_documento.id_riga_sorgente~") COLUMN(NAME=~"riga_documento.peso_non_prezioso~") COLUMN(NAME=~"riga_documento.peso_netto_evaso~") COLUMN(NAME=~"riga_documento.provv_imp_carea_2~") COLUMN(NAME=~"riga_documento.id_gruppo_agenti~")    JOIN (LEFT=~"articolo.id_articolo~"    OP =~"=~"RIGHT=~"riga_documento.id_articolo~" )WHERE(    EXP1 =~"~~~"riga_documento~~~".~~~"id_documento~~~"~"   OP =~"=~"    EXP2 =~":id_doc~" ) ) ARG(NAME = ~"id_doc~" TYPE = number) " arguments=(("id_doc", number)) )
