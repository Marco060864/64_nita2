 retrieve="SELECT  ~"prezzi_calcolo~".~"articolo~" ,
           ~"prezzi_calcolo~".~"q_oro~" ,
           ~"prezzi_calcolo~".~"p_oro~" ,
           ~"prezzi_calcolo~".~"min_lav_esterna~" ,
           ~"prezzi_calcolo~".~"p_min_lav_esterna~" ,
           ~"prezzi_calcolo~".~"brillante~" ,
           ~"prezzi_calcolo~".~"profilo~" ,
           ~"prezzi_calcolo~".~"min_lav_interna~" ,
           ~"prezzi_calcolo~".~"p_costo~" ,
           ~"prezzi_calcolo~".~"ricarico~" ,
           ~"prezzi_calcolo~".~"id_prezzi_calcolo~" ,
           ~"prezzi_calcolo~".~"id_crea_prezzi~" ,
           ~"prezzi_calcolo~".~"id_unita_confezione~" ,
           ~"prezzi_calcolo~".~"tipo_prezzo~" 
               
        FROM ~"prezzi_calcolo~"      
        WHERE ( ~"prezzi_calcolo~".~"id_crea_prezzi~" = :ll_id )   " update="prezzi_calcolo" updatewhere=1 updatekeyinplace=yes arguments=(("ll_id", number)) )
