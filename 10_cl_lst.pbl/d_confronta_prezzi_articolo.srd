table(column=(type=decimal(6) updatewhereclause=yes name=prezzo dbname="prezzo.prezzo" dbalias=".prezzo" )
 column=(type=decimal(6) updatewhereclause=yes name=prezzo_manifattura dbname="prezzo.prezzo_manifattura" dbalias=".prezzo_manifattura" )
 column=(type=char(64) updatewhereclause=yes name=articolo_codice dbname="articolo.codice" dbalias=".codice" )
 column=(type=char(80) updatewhereclause=yes name=articolo_descrizione dbname="articolo.descrizione" dbalias=".descrizione" )
 column=(type=char(4) updatewhereclause=yes name=listino_codice dbname="listino.codice" dbalias=".codice" )
 column=(type=date updatewhereclause=yes name=data_inizio dbname="variazione.data_inizio" dbalias=".data_inizio" )
 column=(type=date updatewhereclause=yes name=data_fine dbname="variazione.data_fine" dbalias=".data_fine" )
 column=(type=long updatewhereclause=yes identity=yes name=id_articolo dbname="articolo.id_articolo" dbalias=".id_articolo" )
 column=(type=long updatewhereclause=yes identity=yes name=id_variazione dbname="variazione.id_variazione" dbalias=".id_variazione" )
 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"prezzo~" )  TABLE(NAME=~"listino~" )  TABLE(NAME=~"variazione~" )  TABLE(NAME=~"articolo~" )  TABLE(NAME=~"unita_confezione~" ) COLUMN(NAME=~"prezzo.prezzo~") COLUMN(NAME=~"prezzo.prezzo_manifattura~") COLUMN(NAME=~"articolo.codice~") COLUMN(NAME=~"articolo.descrizione~") COLUMN(NAME=~"listino.codice~") COLUMN(NAME=~"variazione.data_inizio~") COLUMN(NAME=~"variazione.data_fine~") COLUMN(NAME=~"articolo.id_articolo~") COLUMN(NAME=~"variazione.id_variazione~")    JOIN (LEFT=~"variazione.id_listino~"    OP =~"=~"RIGHT=~"listino.id_listino~" )    JOIN (LEFT=~"variazione.id_variazione~"    OP =~"=~"RIGHT=~"prezzo.id_variazione~" )    JOIN (LEFT=~"unita_confezione.id_articolo~"    OP =~"=~"RIGHT=~"articolo.id_articolo~" )    JOIN (LEFT=~"unita_confezione.id_unita_confezione~"    OP =~"=~"RIGHT=~"prezzo.id_unita_confezione~" )) ORDER(NAME=~"articolo.codice~" ASC=yes ) " )
