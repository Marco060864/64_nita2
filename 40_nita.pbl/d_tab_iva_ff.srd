table(column=(type=long update=yes updatewhereclause=yes key=yes identity=yes name=id_tab_iva dbname="tab_iva.id_tab_iva" dbalias=".id_tab_iva" )
 column=(type=char(8) update=yes updatewhereclause=yes name=codice dbname="tab_iva.codice" dbalias=".codice" )
 column=(type=char(20) update=yes updatewhereclause=yes name=des_breve dbname="tab_iva.des_breve" dbalias=".des_breve" )
 column=(type=char(32766) update=yes updatewhereclause=no name=des_estesa dbname="tab_iva.des_estesa" dbalias=".des_estesa" )
 column=(type=char(1) update=yes updatewhereclause=yes name=tipo_iva dbname="tab_iva.tipo_iva" dbalias=".tipo_iva" values="Detraibile	D/Non detraibile	N/Non imponibile	I/Esente	S/Fuori campo	F/Esclusa	C/Scissione (Split Payment)	X/" )
 column=(type=decimal(2) update=yes updatewhereclause=yes name=per_aliquota dbname="tab_iva.per_aliquota" dbalias=".per_aliquota" validation=" real(gettext())  >= 0 AND  real(gettext())  <= 100" validationmsg="'Immettere un valore fra 0 e 100'" )
 column=(type=decimal(2) update=yes updatewhereclause=yes name=per_detrazione dbname="tab_iva.per_detrazione" dbalias=".per_detrazione" initial="100" validation=" real(gettext())  >= 0 AND  real(gettext())  <= 100" validationmsg="'Immettere un valore fra 0 e 100'" )
 column=(type=decimal(2) update=yes updatewhereclause=yes name=per_ventilazione dbname="tab_iva.per_ventilazione" dbalias=".per_ventilazione" validation=" real(gettext())  >= 0 AND  real(gettext())  <= 100" validationmsg="'Immettere un valore fra 0 e 100'" )
 column=(type=char(1) update=yes updatewhereclause=yes name=ges_plafond dbname="tab_iva.ges_plafond" dbalias=".ges_plafond" initial="N" values="	S/	N" validation=" gettext()  = 'S' OR  gettext()  = 'N'" validationmsg="'Immettere: S, N'" )
 column=(type=char(1) update=yes updatewhereclause=yes name=ges_oper_intracomunitarie dbname="tab_iva.ges_oper_intracomunitarie" dbalias=".ges_oper_intracomunitarie" initial="N" values="	S/	N" validation=" gettext()  = 'S' OR  gettext()  = 'N'" validationmsg="'Immettere: S, N'" )
 column=(type=decimal(0) update=yes updatewhereclause=yes name=imp_min_fattura dbname="tab_iva.imp_min_fattura" dbalias=".imp_min_fattura" )
 column=(type=decimal(0) update=yes updatewhereclause=yes name=imp_bollo_fattura dbname="tab_iva.imp_bollo_fattura" dbalias=".imp_bollo_fattura" )
 column=(type=char(1) update=yes updatewhereclause=yes name=ges_beni_rivendita dbname="tab_iva.ges_beni_rivendita" dbalias=".ges_beni_rivendita" initial="N" values="	S/	N" )
 column=(type=char(1) update=yes updatewhereclause=yes name=ges_beni_strumentali dbname="tab_iva.ges_beni_strumentali" dbalias=".ges_beni_strumentali" initial="N" values="	S/	N" )
 column=(type=char(1) update=yes updatewhereclause=yes name=rcharge dbname="tab_iva.rcharge" dbalias=".rcharge" values="	S/	N" )
 column=(type=char(1) update=yes updatewhereclause=yes name=usa_comunicazioni dbname="tab_iva.usa_comunicazioni" dbalias=".usa_comunicazioni" values="Usa per Comun: 	S/Usa per Comun: 	N" )
 column=(type=char(4) update=yes updatewhereclause=yes name=natura dbname="tab_iva.natura" dbalias=".natura" )
 column=(type=char(1) update=yes updatewhereclause=yes name=esigibilita dbname="tab_iva.esigibilita" dbalias=".esigibilita" values="Immediata	I/Differita	D/Scissione Pagamenti	S/" )
 column=(type=char(2) update=yes updatewhereclause=yes name=deducibile dbname="tab_iva.deducibile" dbalias=".deducibile" values="Sì	SI/No	NO/" )
 column=(type=char(1) update=yes updatewhereclause=yes name=no_bollo dbname="tab_iva.no_bollo" dbalias=".no_bollo" values="NO BOLLO	S/NO BOLLO	N" )
 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"tab_iva~" ) COLUMN(NAME=~"tab_iva.id_tab_iva~") COLUMN(NAME=~"tab_iva.codice~") COLUMN(NAME=~"tab_iva.des_breve~") COLUMN(NAME=~"tab_iva.des_estesa~") COLUMN(NAME=~"tab_iva.tipo_iva~") COLUMN(NAME=~"tab_iva.per_aliquota~") COLUMN(NAME=~"tab_iva.per_detrazione~") COLUMN(NAME=~"tab_iva.per_ventilazione~") COLUMN(NAME=~"tab_iva.ges_plafond~") COLUMN(NAME=~"tab_iva.ges_oper_intracomunitarie~") COLUMN(NAME=~"tab_iva.imp_min_fattura~") COLUMN(NAME=~"tab_iva.imp_bollo_fattura~") COLUMN(NAME=~"tab_iva.ges_beni_rivendita~") COLUMN(NAME=~"tab_iva.ges_beni_strumentali~") COLUMN(NAME=~"tab_iva.rcharge~") COLUMN(NAME=~"tab_iva.usa_comunicazioni~") COLUMN(NAME=~"tab_iva.natura~") COLUMN(NAME=~"tab_iva.esigibilita~") COLUMN(NAME=~"tab_iva.deducibile~") COLUMN(NAME=~"tab_iva.no_bollo~")) ORDER(NAME=~"tab_iva.codice~" ASC=yes ) " update="tab_iva" updatewhere=1 updatekeyinplace=yes )
