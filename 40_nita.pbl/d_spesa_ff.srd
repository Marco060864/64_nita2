//objectcomments in R1Cometa.pbl
release 6;
datawindow(units=0 timer_interval=0 color=79741120 processing=0 print.documentname="" print.orientation = 0 print.margin.left = 110 print.margin.right = 110 print.margin.top = 97 print.margin.bottom = 97 print.paper.source = 0 print.paper.size = 0 print.prompt=no print.buttons=no print.preview.buttons=no )
summary(height=0 color="536870912" )
footer(height=0 color="536870912" )
detail(height=604 color="536870912" )
table(column=(type=long update=yes updatewhereclause=yes key=yes identity=yes name=id_spesa dbname="spesa.id_spesa" )
 column=(type=char(1) update=yes updatewhereclause=yes name=codice dbname="spesa.codice" validation="match( gettext() ,~"^[TCBI0-9]~")" validationmsg="'Immettere: T, C, B, I e da 0 a 9'" )
 column=(type=char(40) update=yes updatewhereclause=yes name=descrizione dbname="spesa.descrizione" validation="not isnull(gettext())" )
 column=(type=char(1) update=yes updatewhereclause=yes name=tipo_importo dbname="spesa.tipo_importo" initial="F" values="Percentuale	P/Importo	F/" validation=" gettext()  = 'P' OR  gettext()  = 'F'" validationmsg="'Immettere: P, F'" )
 column=(type=long update=yes updatewhereclause=yes name=id_conto_acquisti dbname="spesa.id_conto_acquisti" )
 column=(type=long update=yes updatewhereclause=yes name=id_conto_vendite dbname="spesa.id_conto_vendite" )
 column=(type=char(8) updatewhereclause=yes name=conto_a_codice dbname="conto.codice" )
 column=(type=char(40) updatewhereclause=yes name=conto_a_descrizione dbname="conto.descrizione" )
 column=(type=char(8) updatewhereclause=yes name=conto_b_codice dbname="conto.codice" )
 column=(type=char(40) updatewhereclause=yes name=conto_b_descrizione dbname="conto.descrizione" )
 column=(type=char(1) update=yes updatewhereclause=yes name=spesa_segue_esenzione dbname="spesa.segue_esenzione" values="	S/	N" )
 column=(type=char(1) update=yes updatewhereclause=yes name=spesa_mod_cal_iva dbname="spesa.mod_cal_iva" values="Proporzionale	P/Aliquota maggiore	A/Imponibile maggiore	I/" validation=" gettext()  = 'P' OR  gettext()  = 'A' OR gettext() = 'I'" validationmsg="'Immetere: P, A, I'" )
 column=(type=long update=yes updatewhereclause=yes name=spesa_id_tab_iva dbname="spesa.id_tab_iva" )
 column=(type=long update=yes updatewhereclause=yes name=spesa_id_valuta dbname="spesa.id_valuta" )
 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"spesa~" )  TABLE(NAME=~"conto~" ALIAS=~"conto_a~" )  TABLE(NAME=~"conto~" ALIAS=~"conto_b~" ) COLUMN(NAME=~"spesa.id_spesa~") COLUMN(NAME=~"spesa.codice~") COLUMN(NAME=~"spesa.descrizione~") COLUMN(NAME=~"spesa.tipo_importo~") COLUMN(NAME=~"spesa.id_conto_acquisti~") COLUMN(NAME=~"spesa.id_conto_vendite~") COLUMN(NAME=~"conto_a.codice~") COLUMN(NAME=~"conto_a.descrizione~") COLUMN(NAME=~"conto_b.codice~") COLUMN(NAME=~"conto_b.descrizione~") COLUMN(NAME=~"spesa.segue_esenzione~") COLUMN(NAME=~"spesa.mod_cal_iva~") COLUMN(NAME=~"spesa.id_tab_iva~") COLUMN(NAME=~"spesa.id_valuta~")    JOIN (LEFT=~"spesa.id_conto_acquisti~"    OP =~"=~"RIGHT=~"conto_a.id_conto~" )    JOIN (LEFT=~"spesa.id_conto_vendite~"    OP =~"=~"RIGHT=~"conto_b.id_conto~" )) " update="spesa" updatewhere=1 updatekeyinplace=yes )
