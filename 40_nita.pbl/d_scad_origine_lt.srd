release 5;
datawindow(units=0 timer_interval=0 color=79741120 processing=1 print.documentname="" print.orientation = 0 print.margin.left = 110 print.margin.right = 110 print.margin.top = 97 print.margin.bottom = 97 print.paper.source = 0 print.paper.size = 0 print.prompt=no grid.lines=0 selected.mouse=no )
header(height=125 color="553648127" )
summary(height=1 color="536870912" )
footer(height=1 color="536870912" )
detail(height=73 color="553648127" )
table(column=(type=long update=yes updatewhereclause=yes key=yes identity=yes name=id_scadenza dbname="scadenza.id_scadenza" )
 column=(type=date update=yes updatewhereclause=yes name=data_scadenza dbname="scadenza.data_scadenza" )
 column=(type=char(1) update=yes updatewhereclause=yes name=stato_scadenza dbname="scadenza.stato_scadenza" initial="N" values="Non generare	N/Provvisoria	P/Definitva	D/" validation=" gettext()  = 'N' OR  gettext()  = 'P' OR  gettext()  = 'D'" validationmsg="'Inserire un valore tra N, P, D'" )
 column=(type=char(1) update=yes updatewhereclause=yes name=scadenza_da_raggruppare dbname="scadenza.scadenza_da_raggruppare" initial="N" values="	S/	N" validation=" gettext()  = 'S' OR  gettext()  = 'N'" validationmsg="'Immettere: S, N'" )
 column=(type=long update=yes updatewhereclause=yes name=id_tipo_pagamento_des dbname="scadenza.id_tipo_pagamento" )
 column=(type=long update=yes updatewhereclause=yes name=id_valuta_des dbname="scadenza.id_valuta" )
 column=(type=decimal(4) update=yes updatewhereclause=yes name=imp_valuta dbname="scadenza.imp_valuta" )
 column=(type=decimal(4) update=yes updatewhereclause=yes name=cambio dbname="scadenza.cambio" validation=" real(gettext())  >= 0" validationmsg="'Immettere un valore >= 0'" )
 column=(type=decimal(0) update=yes updatewhereclause=yes name=importo dbname="scadenza.importo" )
 column=(type=long updatewhereclause=yes name=id_sog_commerciale dbname="scadenza.id_sog_commerciale" )
 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"scadenza~" ) COLUMN(NAME=~"scadenza.id_scadenza~") COLUMN(NAME=~"scadenza.data_scadenza~") COLUMN(NAME=~"scadenza.stato_scadenza~") COLUMN(NAME=~"scadenza.scadenza_da_raggruppare~") COLUMN(NAME=~"scadenza.id_tipo_pagamento~") COLUMN(NAME=~"scadenza.id_valuta~") COLUMN(NAME=~"scadenza.imp_valuta~") COLUMN(NAME=~"scadenza.cambio~") COLUMN(NAME=~"scadenza.importo~") COLUMN(NAME=~"scadenza.id_sog_commerciale~")) " update="scadenza" updatewhere=1 updatekeyinplace=no )
