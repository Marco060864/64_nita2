table(column=(type=char(40) updatewhereclause=yes name=titolo_finestra dbname="par_stampa.titolo_finestra" )
 column=(type=char(40) updatewhereclause=yes name=classe_finestra dbname="par_stampa.classe_finestra" )
 column=(type=char(40) updatewhereclause=yes name=nome_report dbname="par_stampa.nome_report" )
 column=(type=char(2) updatewhereclause=yes name=argomento dbname="par_stampa.argomento" initial="GN" values="Contabilità	CN/Magazzino	MG/Gestione Finanziaria	GF/Agenti	AG/Cespiti	CS/Centri di costo	CC/Generica	GN/" validation=" gettext()  = 'CN' OR  gettext()  = 'MG' OR  gettext()  = 'GF' OR  gettext()  = 'AG' OR  gettext()  = 'CS' OR  gettext()  = 'CC' OR  gettext()  = 'GN'" validationmsg="'Immettere un CN, MG, GF, AG, CS, CC'" )
 column=(type=char(1) updatewhereclause=yes name=cat_report dbname="par_stampa.cat_report" initial="G" values="Anagrafica	A/Statistica	S/Controllo	C/Valorizzazione	V/Bilancio	B/Fiscale	F/Utilità	U/Generica	G/" validation=" gettext()  = 'A' OR  gettext()  = 'S' OR  gettext()  = 'C' OR  gettext()  = 'V' OR  gettext()  = 'B' OR  gettext()  = 'F' OR  gettext()  = 'U' OR  gettext()  = 'G'" validationmsg="'Immettere un valore tra A, S, C, V, B, F, U, G'" )
 column=(type=char(32766) updatewhereclause=no name=note dbname="par_stampa.note" )
 column=(type=char(40) updatewhereclause=yes name=nome_campo_db_cod dbname="par_stampa.nome_campo_db_cod" )
 column=(type=char(40) updatewhereclause=yes name=nome_campo_db_des dbname="par_stampa.nome_campo_db_des" )
 column=(type=char(40) updatewhereclause=yes name=nome_campo_instampa dbname="par_stampa.nome_campo_instampa" )
 column=(type=char(40) updatewhereclause=yes name=nome_dddw_sl dbname="par_stampa.nome_dddw_sl" )
 column=(type=char(40) updatewhereclause=yes name=nome_dddw_codice dbname="par_stampa.nome_dddw_codice" )
 column=(type=char(40) updatewhereclause=yes name=nome_dddw_descrizione dbname="par_stampa.nome_dddw_descrizione" )
 column=(type=char(1) updatewhereclause=yes name=tipo_serve dbname="par_stampa.tipo_serve" initial="N" values="Utilizza il tipo	S/Utilizza il tipo	N" validation=" gettext()  = 'S' OR  gettext()  = 'N'" validationmsg="'Immettere: S, N'" )
 column=(type=char(1) updatewhereclause=yes name=no_param dbname="par_stampa.no_param" initial="N" values="Nessun parametro	S/Nessun parametro	N" validation=" gettext()  = 'S' OR  gettext()  = 'N'" validationmsg="'Immettere: S, N'" )
 column=(type=char(1) updatewhereclause=yes name=use_completa_semplificata dbname="par_stampa.use_completa_semplificata" initial="N" values="Completa o semplificata	S/Completa o semplificata	N" validation=" gettext()  = 'S' OR  gettext()  = 'N'" validationmsg="'Immettere: S, N'" )
 column=(type=long updatewhereclause=yes key=yes identity=yes name=id_par_stampa dbname="par_stampa.id_par_stampa" )
 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"par_stampa~" ) COLUMN(NAME=~"par_stampa.titolo_finestra~") COLUMN(NAME=~"par_stampa.classe_finestra~") COLUMN(NAME=~"par_stampa.nome_report~") COLUMN(NAME=~"par_stampa.argomento~") COLUMN(NAME=~"par_stampa.cat_report~") COLUMN(NAME=~"par_stampa.note~") COLUMN(NAME=~"par_stampa.nome_campo_db_cod~") COLUMN(NAME=~"par_stampa.nome_campo_db_des~") COLUMN(NAME=~"par_stampa.nome_campo_instampa~") COLUMN(NAME=~"par_stampa.nome_dddw_sl~") COLUMN(NAME=~"par_stampa.nome_dddw_codice~") COLUMN(NAME=~"par_stampa.nome_dddw_descrizione~") COLUMN(NAME=~"par_stampa.tipo_serve~") COLUMN(NAME=~"par_stampa.no_param~") COLUMN(NAME=~"par_stampa.use_completa_semplificata~") COLUMN(NAME=~"par_stampa.id_par_stampa~")) " update="par_stampa" updatewhere=0 updatekeyinplace=no )
