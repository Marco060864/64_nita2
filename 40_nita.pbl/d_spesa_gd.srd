release 5;
datawindow(units=0 timer_interval=0 color=79741120 processing=1 print.documentname="" print.orientation = 0 print.margin.left = 110 print.margin.right = 110 print.margin.top = 97 print.margin.bottom = 97 print.paper.source = 0 print.paper.size = 0 print.prompt=no grid.lines=0 selected.mouse=no )
header(height=81 color="536870912" )
summary(height=1 color="536870912" )
footer(height=1 color="536870912" )
detail(height=73 color="553648127" )
table(column=(type=long update=yes updatewhereclause=yes key=yes identity=yes name=id_spesa dbname="spesa.id_spesa" )
 column=(type=char(1) update=yes updatewhereclause=yes name=codice dbname="spesa.codice" validation="match( gettext() ,~"^[TCBI0-9]~")" validationmsg="'Immettere: T, C, B, I e da 0 a 9~"" )
 column=(type=char(40) update=yes updatewhereclause=yes name=descrizione dbname="spesa.descrizione" )
 column=(type=char(1) update=yes updatewhereclause=yes name=tipo_importo dbname="spesa.tipo_importo" values="Percentuale	P/Fisso	F/" validation=" gettext()  = 'P' OR  gettext()  = 'F'" validationmsg="'Immettere: P, F'" )
 column=(type=decimal(2) update=yes updatewhereclause=yes name=percentuale dbname="spesa.percentuale" validation=" real(gettext())  >= 0 AND  real(gettext())  <= 100" validationmsg="'Immettere un valore fra 0 e 100'" )
 column=(type=decimal(0) update=yes updatewhereclause=yes name=importo dbname="spesa.importo" validation=" real(gettext())  >= 0" validationmsg="'Immettere un valore >= 0'" )
 column=(type=long update=yes updatewhereclause=yes name=id_tab_iva dbname="spesa.id_tab_iva" )
 column=(type=long update=yes updatewhereclause=yes name=id_conto_acquisti dbname="spesa.id_conto_acquisti" )
 column=(type=long update=yes updatewhereclause=yes name=id_conto_vendite dbname="spesa.id_conto_vendite" )
 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"spesa~" ) COLUMN(NAME=~"spesa.id_spesa~") COLUMN(NAME=~"spesa.codice~") COLUMN(NAME=~"spesa.descrizione~") COLUMN(NAME=~"spesa.tipo_importo~") COLUMN(NAME=~"spesa.percentuale~") COLUMN(NAME=~"spesa.importo~") COLUMN(NAME=~"spesa.id_tab_iva~") COLUMN(NAME=~"spesa.id_conto_acquisti~") COLUMN(NAME=~"spesa.id_conto_vendite~")) ORDER(NAME=~"spesa.codice~" ASC=yes ) " update="spesa" updatewhere=1 updatekeyinplace=yes )
