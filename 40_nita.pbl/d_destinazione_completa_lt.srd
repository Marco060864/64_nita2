//objectcomments DW LT(Completa) Destinazione  Cometa
release 5;
datawindow(units=0 timer_interval=0 color=79741120 processing=1 print.documentname="" print.orientation = 0 print.margin.left = 110 print.margin.right = 110 print.margin.top = 97 print.margin.bottom = 97 print.paper.source = 0 print.paper.size = 0 print.prompt=no grid.lines=0 )
header(height=117 color="553648127" )
summary(height=1 color="536870912" )
footer(height=1 color="536870912" )
detail(height=73 color="553648127" )
table(column=(type=long updatewhereclause=yes name=destinazione_id_destinazione dbname="destinazione.id_destinazione" )
 column=(type=char(4) updatewhereclause=yes name=cat_attivita_codice dbname="cat_attivita.codice" )
 column=(type=char(40) updatewhereclause=yes name=cat_attivita_descrizione dbname="cat_attivita.descrizione" )
 column=(type=char(40) updatewhereclause=yes name=destinazione_rag_soc_1 dbname="destinazione.rag_soc_1" )
 column=(type=char(4) updatewhereclause=yes name=cat_com_sc_codice dbname="cat_com_sc.codice" )
 column=(type=char(40) updatewhereclause=yes name=cat_com_sc_descrizione dbname="cat_com_sc.descrizione" )
 column=(type=char(40) updatewhereclause=yes name=destinazione_rag_soc_2 dbname="destinazione.rag_soc_2" )
 column=(type=char(4) updatewhereclause=yes name=cat_zona_codice dbname="cat_zona.codice" )
 column=(type=char(40) updatewhereclause=yes name=cat_zona_descrizione dbname="cat_zona.descrizione" )
 column=(type=char(40) updatewhereclause=yes name=destinazione_indirizzo dbname="destinazione.indirizzo" )
 column=(type=char(10) updatewhereclause=yes name=destinazione_cap dbname="destinazione.cap" )
 column=(type=char(40) updatewhereclause=yes name=destinazione_localita dbname="destinazione.localita" )
 column=(type=char(5) updatewhereclause=yes name=destinazione_provincia dbname="destinazione.provincia" )
 column=(type=char(5) updatewhereclause=yes name=destinazione_nazione dbname="destinazione.nazione" initial="IT" )
 column=(type=char(1) updatewhereclause=yes name=destinazione_tipo_destinazione dbname="destinazione.tipo_destinazione" values="Spedizione merci	M/Spedizione documenti e fattura	D/Riferimento presentazione RI.BA.	R/" validation=" gettext()  = 'M' OR  gettext()  = 'D' OR  gettext()  = 'R'" validationmsg="'Immettere: M, D, R'" )
 column=(type=char(8) updatewhereclause=yes name=magazzino_codice dbname="magazzino.codice" )
 column=(type=char(40) updatewhereclause=yes name=magazzino_descrizione dbname="magazzino.descrizione" )
 column=(type=long updatewhereclause=yes name=destinazione_id_azienda dbname="destinazione.id_azienda" initial="1" )
 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"destinazione~" )  TABLE(NAME=~"cat_attivita~" )  TABLE(NAME=~"cat_com_sc~" )  TABLE(NAME=~"cat_zona~" )  TABLE(NAME=~"magazzino~" ) COLUMN(NAME=~"destinazione.id_destinazione~") COLUMN(NAME=~"cat_attivita.codice~") COLUMN(NAME=~"cat_attivita.descrizione~") COLUMN(NAME=~"destinazione.rag_soc_1~") COLUMN(NAME=~"cat_com_sc.codice~") COLUMN(NAME=~"cat_com_sc.descrizione~") COLUMN(NAME=~"destinazione.rag_soc_2~") COLUMN(NAME=~"cat_zona.codice~") COLUMN(NAME=~"cat_zona.descrizione~") COLUMN(NAME=~"destinazione.indirizzo~") COLUMN(NAME=~"destinazione.cap~") COLUMN(NAME=~"destinazione.localita~") COLUMN(NAME=~"destinazione.provincia~") COLUMN(NAME=~"destinazione.nazione~") COLUMN(NAME=~"destinazione.tipo_destinazione~") COLUMN(NAME=~"magazzino.codice~") COLUMN(NAME=~"magazzino.descrizione~") COLUMN(NAME=~"destinazione.id_azienda~")    JOIN (LEFT=~"cat_attivita.id_cat_attivita~"    OP =~"=~"RIGHT=~"destinazione.id_cat_attivita~"    OUTER2 =~"destinazione.id_cat_attivita~" )    JOIN (LEFT=~"cat_com_sc.id_cat_com_sc~"    OP =~"=~"RIGHT=~"destinazione.id_cat_com_sc~"    OUTER2 =~"destinazione.id_cat_com_sc~" )    JOIN (LEFT=~"cat_zona.id_cat_zona~"    OP =~"=~"RIGHT=~"destinazione.id_cat_zona~"    OUTER2 =~"destinazione.id_cat_zona~" )    JOIN (LEFT=~"magazzino.id_magazzino~"    OP =~"=~"RIGHT=~"destinazione.id_magazzino~"    OUTER2 =~"destinazione.id_magazzino~" )WHERE(    EXP1 =~"~~~"destinazione~~~".~~~"id_azienda~~~"~"   OP =~"in~"    EXP2 =~"(0, 1)~" ) ) " )
