 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"con_movimento~" )  TABLE(NAME=~"sog_commerciale~" ALIAS=~"sog_commerciale_a~" )  TABLE(NAME=~"cat_com_sc~" )  TABLE(NAME=~"articolo~" )  TABLE(NAME=~"cat_com_articolo~" )  TABLE(NAME=~"conto~" )  TABLE(NAME=~"anagrafica~" ALIAS=~"anagrafica_a~" )  TABLE(NAME=~"sog_commerciale~" ALIAS=~"sog_commerciale_b~" )  TABLE(NAME=~"anagrafica~" ALIAS=~"anagrafica_b~" ) COLUMN(NAME=~"con_movimento.applicazione~") COLUMN(NAME=~"sog_commerciale_a.codice~") COLUMN(NAME=~"cat_com_sc.codice~") COLUMN(NAME=~"cat_com_sc.descrizione~") COLUMN(NAME=~"articolo.codice~") COLUMN(NAME=~"articolo.descrizione~") COLUMN(NAME=~"cat_com_articolo.codice~") COLUMN(NAME=~"cat_com_articolo.descrizione~") COLUMN(NAME=~"conto.codice~") COLUMN(NAME=~"conto.descrizione~") COLUMN(NAME=~"sog_commerciale_b.codice~") COLUMN(NAME=~"anagrafica_a.rag_soc_1~") COLUMN(NAME=~"anagrafica_b.rag_soc_1~")    JOIN (LEFT=~"sog_commerciale_a.id_sog_commerciale~"    OP =~"=~"RIGHT=~"con_movimento.id_sog_commerciale_agente~"    OUTER2 =~"con_movimento.id_sog_commerciale_agente~" )    JOIN (LEFT=~"cat_com_sc.id_cat_com_sc~"    OP =~"=~"RIGHT=~"con_movimento.id_cat_com_sc~"    OUTER2 =~"con_movimento.id_cat_com_sc~" )    JOIN (LEFT=~"articolo.id_articolo~"    OP =~"=~"RIGHT=~"con_movimento.id_articolo~"    OUTER2 =~"con_movimento.id_articolo~" )    JOIN (LEFT=~"cat_com_articolo.id_cat_com_articolo~"    OP =~"=~"RIGHT=~"con_movimento.id_cat_com_articolo~"    OUTER2 =~"con_movimento.id_cat_com_articolo~" )    JOIN (LEFT=~"con_movimento.id_sog_commerciale~"    OP =~"=~"RIGHT=~"sog_commerciale_b.id_sog_commerciale~"    OUTER1 =~"con_movimento.id_sog_commerciale~" )    JOIN (LEFT=~"conto.id_conto~"    OP =~"=~"RIGHT=~"con_movimento.id_conto~" )    JOIN (LEFT=~"anagrafica_a.id_anagrafica~"    OP =~"=~"RIGHT=~"sog_commerciale_a.id_anagrafica~" )    JOIN (LEFT=~"sog_commerciale_b.id_anagrafica~"    OP =~"=~"RIGHT=~"anagrafica_b.id_anagrafica~" )) " )
