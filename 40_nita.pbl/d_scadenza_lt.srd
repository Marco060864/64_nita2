//objectcomments Scadenze legate ad un soggetto commerciale
release 6;
datawindow(units=0 timer_interval=0 color=79741120 processing=1 print.documentname="" print.orientation = 0 print.margin.left = 110 print.margin.right = 110 print.margin.top = 97 print.margin.bottom = 97 print.paper.source = 0 print.paper.size = 0 print.prompt=no print.buttons=no print.preview.buttons=no pointer="S:\pb\commonframework\Point.cur" grid.lines=0 selected.mouse=no )
header(height=136 color="536870912" )
summary(height=0 color="536870912" )
footer(height=0 color="536870912" )
detail(height=72 color="553648127" )
table(column=(type=long update=yes updatewhereclause=yes identity=yes name=id_scadenza dbname="valuta.id_scadenza" )
 column=(type=long update=yes updatewhereclause=yes name=id_sog_commerciale dbname="valuta.id_sog_commerciale" )
 column=(type=date update=yes updatewhereclause=yes name=scadenza_data_scadenza dbname="valuta.data_scadenza" )
 column=(type=decimal(4) update=yes updatewhereclause=yes name=scadenza_importo dbname="valuta.importo" )
 column=(type=char(4) updatewhereclause=yes key=yes name=tipo_pagamento_codice dbname="valuta.codice" )
 column=(type=long update=yes updatewhereclause=yes name=scadenza_id_azienda dbname="valuta.id_azienda" initial="1" )
 column=(type=char(40) updatewhereclause=yes name=tipo_pagamento_descrizione dbname="valuta.descrizione" )
 column=(type=char(1) updatewhereclause=yes name=scadenza_scadenza_da_raggruppare dbname="valuta.scadenza_da_raggruppare" initial="N" values="	S/	N" validation=" gettext()  = 'S' OR  gettext()  = 'N'" validationmsg="'Immettere: S, N'" )
 column=(type=char(16) updatewhereclause=yes name=par_aperta_num_partita dbname="valuta.num_partita" )
 column=(type=date updatewhereclause=yes name=par_aperta_data_partita dbname="valuta.data_partita" )
 column=(type=char(16) updatewhereclause=yes name=documento_num_documento dbname="valuta.num_documento" )
 column=(type=long updatewhereclause=yes name=scadenza_id_par_aperta dbname="valuta.id_par_aperta" )
 column=(type=long updatewhereclause=yes name=scadenza_id_documento dbname="valuta.id_documento" )
 column=(type=date updatewhereclause=yes name=documento_data_documento dbname="valuta.data_documento" )
 column=(type=long updatewhereclause=yes name=scadenza_id_tipo_pagamento dbname="valuta.id_tipo_pagamento" )
 column=(type=long updatewhereclause=yes name=scadenza_id_banca_azienda dbname="valuta.id_banca_azienda" )
 column=(type=char(1) updatewhereclause=yes name=scadenza_esito_pagamento dbname="valuta.esito_pagamento" initial="E" values="Emesso	E/Distinta	D/Pagato	P/Insoluto	I/Bloccato	B/" validation=" gettext()  = 'E' OR  gettext()  = 'D' OR  gettext()  = 'P' OR  gettext()  = 'I' OR  gettext()  = 'B' OR  gettext()  = 'R'" validationmsg="'Immettere un valore tra E, D, P, I, B, R'" )
 column=(type=char(5) updatewhereclause=yes name=banca_appoggio_cod_abi dbname="valuta.cod_abi" validation="match( gettext() , ~"[0-9][0-9][0-9][0-9][0-9]~")" validationmsg="'Immettere cinque cifre'" )
 column=(type=char(5) updatewhereclause=yes name=banca_appoggio_cod_cab dbname="valuta.cod_cab" validation="match( gettext() , ~"[0-9][0-9][0-9][0-9][0-9]~")" validationmsg="'Immettere cinque cifre'" )
 column=(type=char(20) updatewhereclause=yes name=banca_azienda_conto_corrente dbname="valuta.conto_corrente" )
 column=(type=char(1) updatewhereclause=yes name=stato_scadenza dbname="valuta.stato_scadenza" )
 column=(type=decimal(0) updatewhereclause=yes name=tot_importo dbname="tot_importo" )
 column=(type=long updatewhereclause=yes identity=yes name=id_documento dbname="valuta.id_documento" )
 column=(type=long updatewhereclause=yes name=c_id_valuta_scadenza dbname="c_id_valuta_scadenza" )
 column=(type=char(5) updatewhereclause=yes name=c_sim_valuta_scadenza dbname="c_sim_valuta_scadenza" )
 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"scadenza~" )  TABLE(NAME=~"tipo_pagamento~" )  TABLE(NAME=~"par_aperta~" )  TABLE(NAME=~"documento~" )  TABLE(NAME=~"banca_azienda~" )  TABLE(NAME=~"banca_appoggio~" ) COLUMN(NAME=~"scadenza.id_scadenza~") COLUMN(NAME=~"scadenza.id_sog_commerciale~") COLUMN(NAME=~"scadenza.data_scadenza~") COLUMN(NAME=~"scadenza.importo~") COLUMN(NAME=~"tipo_pagamento.codice~") COLUMN(NAME=~"scadenza.id_azienda~") COLUMN(NAME=~"tipo_pagamento.descrizione~") COLUMN(NAME=~"scadenza.scadenza_da_raggruppare~") COLUMN(NAME=~"par_aperta.num_partita~") COLUMN(NAME=~"par_aperta.data_partita~") COLUMN(NAME=~"documento.num_documento~") COLUMN(NAME=~"scadenza.id_par_aperta~") COLUMN(NAME=~"scadenza.id_documento~") COLUMN(NAME=~"documento.data_documento~") COLUMN(NAME=~"scadenza.id_tipo_pagamento~") COLUMN(NAME=~"scadenza.id_banca_azienda~") COLUMN(NAME=~"scadenza.esito_pagamento~") COLUMN(NAME=~"banca_appoggio.cod_abi~") COLUMN(NAME=~"banca_appoggio.cod_cab~") COLUMN(NAME=~"banca_azienda.conto_corrente~") COLUMN(NAME=~"scadenza.stato_scadenza~") COMPUTE(NAME=~"cast(0 as decimal) as tot_importo~") COLUMN(NAME=~"documento.id_documento~") COMPUTE(NAME=~"CAST(FN_VALUTA_SCADENZA(~~~"scadenza~~~".~~~"id_documento~~~", ~~~"scadenza~~~".~~~"id_par_aperta~~~", ~~~"scadenza~~~".~~~"data_scadenza~~~") AS INTEGER ) AS c_id_valuta_scadenza~") COMPUTE(NAME=~"CAST( (SELECT simbolo FROM valuta WHERE id_valuta = c_id_valuta_scadenza) AS CHAR(5) ) AS c_sim_valuta_scadenza~")    JOIN (LEFT=~"par_aperta.id_par_aperta~"    OP =~"=~"RIGHT=~"scadenza.id_par_aperta~"    OUTER2 =~"scadenza.id_par_aperta~" )    JOIN (LEFT=~"documento.id_documento~"    OP =~"=~"RIGHT=~"scadenza.id_documento~"    OUTER2 =~"scadenza.id_documento~" )    JOIN (LEFT=~"banca_azienda.id_banca_azienda~"    OP =~"=~"RIGHT=~"scadenza.id_banca_azienda~"    OUTER2 =~"scadenza.id_banca_azienda~" )    JOIN (LEFT=~"banca_appoggio.id_banca_appoggio~"    OP =~"=~"RIGHT=~"banca_azienda.id_banca_appoggio~"    OUTER2 =~"banca_azienda.id_banca_appoggio~" )    JOIN (LEFT=~"tipo_pagamento.id_tipo_pagamento~"    OP =~"=~"RIGHT=~"scadenza.id_tipo_pagamento~" )WHERE(    EXP1 =~"~~~"scadenza~~~".~~~"id_azienda~~~"~"   OP =~"=~"    EXP2 =~"1~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"scadenza~~~".~~~"id_sog_commerciale~~~"~"   OP =~"=~"    EXP2 =~":rn_id_sog_commerciale~" ) ) ORDER(NAME=~"scadenza.data_scadenza~" ASC=no) ARG(NAME = ~"rn_id_sog_commerciale~" TYPE = number) " update="valuta" updatewhere=0 updatekeyinplace=no arguments=(("rn_id_sog_commerciale", number))  sort="c_sort A " )
group(level=1 header.height=0 trailer.height=84 by=("documento_num_documento" , "documento_data_documento" ) header.color="536870912" trailer.color="536870912"  sort="count(documento_num_documento for group 1) A count(documento_data_documento for group 1) A " )
text(band=header alignment="2" text="Pagamento"border="0" color="33554432" x="1129" y="8" height="56" width="448"  name=tipo_pagamento_descrizione_t  font.face="Arial" font.height="-8" font.weight="400"  font.family="2" font.pitch="2" font.charset="0" background.mode="1" background.color="553648127" )
