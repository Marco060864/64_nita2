column(band=detail id=7 alignment="0" tabsequence=32766 border="0" color="33554432" x="1129" y="4" height="64" width="448" format="[general]"  name=tipo_pagamento_descrizione edit.name="es_Descrizione" edit.limit=40 edit.case=any edit.autoselect=yes edit.autohscroll=yes  font.face="Arial" font.height="-8" font.weight="400"  font.family="2" font.pitch="2" font.charset="0" background.mode="2" background.color="1090519039" )
column(band=detail id=3 alignment="0" tabsequence=32766 border="0" color="33554432" x="846" y="4" height="64" width="274" format="dd/mm/yyyy"  name=scadenza_data_scadenza edit.name="es_Data" edit.limit=10 edit.case=any edit.format="dd/mm/yyyy " edit.autoselect=yes edit.nilisnull=yes  font.face="Arial" font.height="-8" font.weight="400"  font.family="2" font.pitch="2" font.charset="0" background.mode="2" background.color="1090519039" )
compute(band=detail alignment="0" expression="if ( NOT (IsNull (scadenza_id_par_aperta) OR scadenza_id_par_aperta = 0),
        'Partita - Numero: ' + par_aperta_num_partita + ' Data: ' + string(par_aperta_data_partita, ~"dd/mm/yyyy~"),
        if ( NOT (IsNull (scadenza_id_documento) OR scadenza_id_documento = 0), 'Documento - Numero: ' + documento_num_documento + ' Data: ' + string(documento_data_documento, ~"dd/mm/yyyy~"), '' ) )
"border="0" color="33554432" x="9" y="4" height="64" width="827" format="[general]"  name=c_estremi  font.face="Arial" font.height="-8" font.weight="400"  font.family="2" font.pitch="2" font.charset="0" background.mode="2" background.color="1090519039" )
column(band=detail id=18 alignment="0" tabsequence=32766 border="0" color="33554432" x="1947" y="4" height="64" width="174" format="[general]"  name=banca_appoggio_cod_abi edit.name="es_Cod_N5" edit.limit=5 edit.case=upper edit.autoselect=yes edit.nilisnull=yes edit.autohscroll=yes  font.face="Arial" font.height="-8" font.weight="400"  font.family="2" font.pitch="2" font.charset="0" background.mode="2" background.color="1090519039" )
column(band=detail id=19 alignment="0" tabsequence=32766 border="0" color="33554432" x="2130" y="4" height="64" width="174" format="[general]"  name=banca_appoggio_cod_cab edit.name="es_Cod_N5" edit.limit=5 edit.case=upper edit.autoselect=yes edit.nilisnull=yes edit.autohscroll=yes  font.face="Arial" font.height="-8" font.weight="400"  font.family="2" font.pitch="2" font.charset="0" background.mode="2" background.color="1090519039" )
column(band=detail id=8 alignment="0" tabsequence=32766 border="0" color="33554432" x="2674" y="4" height="64" width="142" format="[general]"  name=scadenza_scadenza_da_raggruppare edit.name="es_Boolean" checkbox.text="" checkbox.on="S" checkbox.off="N" checkbox.scale=no checkbox.threed=yes  font.face="Arial" font.height="-8" font.weight="400"  font.family="2" font.pitch="2" font.charset="0" background.mode="2" background.color="1090519039" )
compute(band=detail alignment="0" expression="if ( NOT (IsNull (scadenza_id_par_aperta) OR scadenza_id_par_aperta = 0),
        long( par_aperta_num_partita ),
        if ( NOT (IsNull (scadenza_id_documento) OR scadenza_id_documento = 0), long( documento_num_documento ), 0 ) )
"border="0" color="33554432" x="2825" y="4" height="64" width="5" format="[general]"  name=c_sort visible="1~t0"  font.face="Arial" font.height="-8" font.weight="400"  font.family="2" font.pitch="2" font.charset="0" background.mode="2" background.color="1090519039" )
compute(band=detail alignment="0" expression="if ( IsNull(  documento_data_documento ),  
	date(par_aperta_data_partita) ,  
	date(documento_data_documento) )"border="0" color="33554432" x="2839" y="4" height="64" width="5" format="dd/mm/yyyy"  name=data_par_documento visible="1~t0"  font.face="Arial" font.height="-8" font.weight="400"  font.family="2" font.pitch="2" font.charset="0" background.mode="2" background.color="1090519039" )
