column(band=detail id=4 alignment="1" tabsequence=32766 border="0" color="33554432" x="1591" y="4" height="64" width="343" format="~t c_sim_valuta_scadenza + '  ' + f_valu_mask (  c_id_valuta_scadenza )"  name=scadenza_importo edit.limit=14 edit.case=any edit.format="#,0 " edit.autoselect=yes edit.nilisnull=yes  font.face="Arial" font.height="-8" font.weight="400"  font.family="2" font.pitch="2" font.charset="0" background.mode="2" background.color="1090519039" )
compute(band=trailer.1 alignment="1" expression="sum( scadenza_importo for group 1)"border="0" color="0" x="1586" y="8" height="52" width="347" format="#,0"  name=tot_dist_scad  font.face="Arial" font.height="-8" font.weight="400"  font.family="2" font.pitch="2" font.charset="0" background.mode="2" background.color="16777215" )
