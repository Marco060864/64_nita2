text(band=header alignment="2" text="EstremiPartita/Documento"border="0" color="33554432" x="9" y="8" height="112" width="827"  name=c_estremi_t  font.face="Arial" font.height="-8" font.weight="400"  font.family="2" font.pitch="2" font.charset="0" background.mode="1" background.color="553648127" )
text(band=header alignment="2" text="Cod.ABI"border="0" color="33554432" x="1947" y="8" height="112" width="174"  name=banca_appoggio_cod_abi_t  font.face="Arial" font.height="-8" font.weight="400"  font.family="2" font.pitch="2" font.charset="0" background.mode="1" background.color="536870912" )
text(band=header alignment="2" text="Cod.CAB"border="0" color="33554432" x="2130" y="8" height="112" width="174"  name=banca_appoggio_cod_cab_t  font.face="Arial" font.height="-8" font.weight="400"  font.family="2" font.pitch="2" font.charset="0" background.mode="1" background.color="536870912" )
text(band=header alignment="2" text="Conto Corrente"border="0" color="33554432" x="2313" y="8" height="56" width="352"  name=banca_azienda_conto_corrente_t  font.face="Arial" font.height="-8" font.weight="400"  font.family="2" font.pitch="2" font.charset="0" background.mode="1" background.color="536870912" )
text(band=header alignment="2" text="DaRagg."border="0" color="33554432" x="2674" y="4" height="112" width="142"  name=scadenza_scadenza_da_raggruppare_t  font.face="Arial" font.height="-8" font.weight="400"  font.family="2" font.pitch="2" font.charset="0" background.mode="1" background.color="536870912" )
