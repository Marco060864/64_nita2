 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"scadenza~" ALIAS=~"scadenza~" )  TABLE(NAME=~"riga_dis_banca~" )  TABLE(NAME=~"dis_banca~" )  TABLE(NAME=~"scadenza~" ALIAS=~"scadenza_padre~" ) COLUMN(NAME=~"scadenza.id_scadenza~") COLUMN(NAME=~"scadenza.id_tipo_pagamento~") COLUMN(NAME=~"scadenza.tipo_scadenza~") COLUMN(NAME=~"scadenza.id_sog_commerciale~") COLUMN(NAME=~"scadenza.data_scadenza~") COLUMN(NAME=~"scadenza.id_valuta~") COLUMN(NAME=~"scadenza.cambio~") COLUMN(NAME=~"scadenza.imp_valuta~") COLUMN(NAME=~"scadenza.importo~") COLUMN(NAME=~"scadenza.id_banca_azienda~") COLUMN(NAME=~"scadenza.id_banca_sog_commerciale~") COLUMN(NAME=~"scadenza.note~") COLUMN(NAME=~"scadenza.ces_denominazione~") COLUMN(NAME=~"scadenza.ces_indirizzo~") COLUMN(NAME=~"scadenza.ces_cap~") COLUMN(NAME=~"scadenza.ces_localita~") COLUMN(NAME=~"scadenza.ces_provincia~") COLUMN(NAME=~"scadenza.ces_doc_originale~") COLUMN(NAME=~"scadenza.ces_data_documento~") COLUMN(NAME=~"scadenza.stato_scadenza~") COLUMN(NAME=~"scadenza.data_cambiamento_stato~") COLUMN(NAME=~"scadenza.esito_pagamento~") COLUMN(NAME=~"scadenza.scadenza_da_raggruppare~") COLUMN(NAME=~"scadenza.id_riga_distinta_banca~") COLUMN(NAME=~"scadenza.id_documento~") COLUMN(NAME=~"scadenza.id_par_aperta~") COLUMN(NAME=~"scadenza.id_scadenza_padre~") COLUMN(NAME=~"scadenza.id_azienda~") COMPUTE(NAME=~"Cast(Null as numeric(14)) as c_dis_banca_tot_distinta~") COMPUTE(NAME=~"Cast(Null as numeric(8)) as c_registro_numero~") COMPUTE(NAME=~"Cast('' as char(40)) as c_registro_descrizione~") COMPUTE(NAME=~"Cast('' as char(2)) as c_registro_tipo_registro~") COMPUTE(NAME=~"Cast(Null as numeric(12)) as c_documento_num_progressivo~") COMPUTE(NAME=~"Cast('' as char(16)) as c_documento_num_documento~") COMPUTE(NAME=~"Cast(Null as date) as c_documento_data_documento~") COMPUTE(NAME=~"Cast(Null as date) as c_documento_data_competenza~") COMPUTE(NAME=~"Cast(Null as numeric(8)) as c_par_registro_numero~") COMPUTE(NAME=~"Cast('' as char(40)) as c_par_registro_descrizione~") COMPUTE(NAME=~"Cast('' as char(2)) as c_par_registro_tipo_registro~") COMPUTE(NAME=~"Cast(Null as date) as c_par_aperta_data_partita~") COMPUTE(NAME=~"Cast(Null as date) as c_dis_banca_data_distinta~") COMPUTE(NAME=~"Cast(Null as numeric(6)) as c_dis_banca_num_distinta~") COLUMN(NAME=~"dis_banca.num_distinta~") COLUMN(NAME=~"dis_banca.data_distinta~") COLUMN(NAME=~"dis_banca.tot_distinta~") COLUMN(NAME=~"scadenza_padre.data_scadenza~") COLUMN(NAME=~"scadenza_padre.stato_scadenza~") COLUMN(NAME=~"scadenza_padre.scadenza_da_raggruppare~") COLUMN(NAME=~"scadenza_padre.id_tipo_pagamento~") COLUMN(NAME=~"scadenza_padre.id_valuta~") COLUMN(NAME=~"scadenza_padre.imp_valuta~") COLUMN(NAME=~"scadenza_padre.cambio~") COLUMN(NAME=~"scadenza_padre.importo~") COMPUTE(NAME=~"Cast(Null as date) as c_documento_data_registrazion~") COMPUTE(NAME=~"Cast(Null as Numeric(16)) as c_par_aperta_num_partita~") COMPUTE(NAME=~"CAST(FN_VALUTA_SCADENZA(~~~"scadenza~~~".~~~"id_documento~~~", ~~~"scadenza~~~".~~~"id_par_aperta~~~", ~~~"scadenza~~~".~~~"data_scadenza~~~") AS INTEGER ) AS c_id_valuta_scadenza~") COMPUTE(NAME=~"CAST( (SELECT simbolo FROM valuta WHERE id_valuta = c_id_valuta_scadenza) AS CHAR(5) ) AS c_sim_valuta_scadenza~")    JOIN (LEFT=~"scadenza.id_riga_distinta_banca~"    OP =~"=~"RIGHT=~"riga_dis_banca.id_riga_distinta_banca~"    OUTER1 =~"scadenza.id_riga_distinta_banca~" )    JOIN (LEFT=~"riga_dis_banca.id_distinta_banca~"    OP =~"=~"RIGHT=~"dis_banca.id_distinta_banca~"    OUTER1 =~"riga_dis_banca.id_distinta_banca~" )    JOIN (LEFT=~"scadenza.id_scadenza_padre~"    OP =~"=~"RIGHT=~"scadenza_padre.id_scadenza~"    OUTER1 =~"scadenza.id_scadenza_padre~" )WHERE(    EXP1 =~"~~~"scadenza~~~".~~~"id_azienda~~~"~"   OP =~"in~"    EXP2 =~"(0,1)~" ) ) " update="scadenza" updatewhere=1 updatekeyinplace=yes )
