 column=(type=char(40) update=yes updatewhereclause=yes name=nome_dddw_descrizione dbname="par_stampa.nome_dddw_descrizione" )
 column=(type=char(1) update=yes updatewhereclause=yes name=tipo_serve dbname="par_stampa.tipo_serve" initial="N" values="	S/	N" validation=" gettext()  = 'S' OR  gettext()  = 'N'" validationmsg="'Immettere: S, N'" )
