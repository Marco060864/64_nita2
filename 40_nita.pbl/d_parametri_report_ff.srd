 column=(type=char(2) update=yes updatewhereclause=yes name=argomento dbname="par_stampa.argomento" initial="GN" values="Contabilità	CN/Magazzino	MG/Gestione Finanziaria	GF/Agenti	AG/Cespiti	CS/Centri di costo	CC/Generica	GN/" validation=" gettext()  = 'CN' OR  gettext()  = 'MG' OR  gettext()  = 'GF' OR  gettext()  = 'AG' OR  gettext()  = 'CS' OR  gettext()  = 'CC' OR  gettext()  = 'GN'" validationmsg="'Immettere un CN, MG, GF, AG, CS, CC'" )
 column=(type=char(1) update=yes updatewhereclause=yes name=cat_report dbname="par_stampa.cat_report" initial="G" values="Anagrafica	A/Statistica	S/Controllo	C/Valorizzazione	V/Bilancio	B/Fiscale	F/Utilità	U/Generica	G/Documento	D/" validation=" gettext()  = 'A' OR  gettext()  = 'S' OR  gettext()  = 'C' OR  gettext()  = 'V' OR  gettext()  = 'B' OR  gettext()  = 'F' OR  gettext()  = 'U' OR  gettext()  = 'G' OR  gettext()  = 'D'" validationmsg="'Immettere un valore tra A, S, C, V, B, F, U, G, D'" )
