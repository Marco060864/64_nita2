table(column=(type=long update=yes updatewhereclause=yes identity=yes name=id_riga_distinta_banca dbname="riga_dis_banca.id_riga_distinta_banca" dbalias=".id_riga_distinta_banca" )
 column=(type=long update=yes updatewhereclause=yes name=id_distinta_banca dbname="riga_dis_banca.id_distinta_banca" dbalias=".id_distinta_banca" )
 column=(type=decimal(0) update=yes updatewhereclause=yes name=riga_dis_banca_num_riga dbname="riga_dis_banca.num_riga" dbalias=".num_riga" )
 column=(type=decimal(4) update=yes updatewhereclause=yes name=riga_dis_banca_imp_totale dbname="riga_dis_banca.imp_totale" dbalias=".imp_totale" )
 column=(type=char(40) update=yes updatewhereclause=yes name=riga_dis_banca_rif_documento dbname="riga_dis_banca.rif_documento" dbalias=".rif_documento" )
 column=(type=char(20) update=yes updatewhereclause=yes name=riga_dis_banca_creata_su_modello dbname="riga_dis_banca.creata_su_modello" dbalias=".creata_su_modello" )
 column=(type=char(20) update=yes updatewhereclause=yes name=riga_dis_banca_creata_su_distinta dbname="riga_dis_banca.creata_su_distinta" dbalias=".creata_su_distinta" )
 column=(type=char(1) update=yes updatewhereclause=yes name=riga_dis_banca_esito_pagamento dbname="riga_dis_banca.esito_pagamento" dbalias=".esito_pagamento" values="Emesso	E/Distinta	D/Pagato	P/Insoluto	I/Bloccato	B/" )
 column=(type=date update=yes updatewhereclause=yes name=riga_dis_banca_data_pagamento dbname="riga_dis_banca.data_pagamento" dbalias=".data_pagamento" )
 column=(type=long update=yes updatewhereclause=yes name=id_azienda dbname="riga_dis_banca.id_azienda" dbalias=".id_azienda" )
 column=(type=date updatewhereclause=yes name=scadenza_data_scadenza dbname="scadenza.data_scadenza" dbalias=".data_scadenza" )
 column=(type=long updatewhereclause=yes identity=yes name=id_scadenza dbname="scadenza.id_scadenza" dbalias=".id_scadenza" )
 column=(type=char(1) updatewhereclause=yes name=tipo_scadenza dbname="scadenza.tipo_scadenza" dbalias=".tipo_scadenza" values="Attiva	A/Passiva	P/" validation=" gettext()  = 'A' OR  gettext()  = 'P'" validationmsg="'Immettere un valore tra A, P'" )
 column=(type=long updatewhereclause=yes name=id_sog_commerciale dbname="scadenza.id_sog_commerciale" dbalias=".id_sog_commerciale" )
 column=(type=long updatewhereclause=yes name=scadenza_id_riga_distinta_banca dbname="scadenza.id_riga_distinta_banca" dbalias=".id_riga_distinta_banca" )
 column=(type=long updatewhereclause=yes name=scadenza_id_par_aperta dbname="scadenza.id_par_aperta" dbalias=".id_par_aperta" )
 column=(type=char(8) updatewhereclause=yes name=sog_commerciale_codice dbname="sog_commerciale.codice" dbalias=".codice" )
 column=(type=char(40) updatewhereclause=yes name=anagrafica_rag_soc_1 dbname="anagrafica.rag_soc_1" dbalias=".rag_soc_1" )
 column=(type=long updatewhereclause=yes name=id_tipo_pagamento dbname="scadenza.id_tipo_pagamento" dbalias=".id_tipo_pagamento" )
 column=(type=char(40) updatewhereclause=yes name=descrizione dbname="tipo_pagamento.descrizione" dbalias=".descrizione" )
 column=(type=decimal(4) updatewhereclause=yes name=scadenza_importo dbname="scadenza_importo" )
 column=(type=long updatewhereclause=yes name=id_valuta dbname="id_valuta" )
 column=(type=date updatewhereclause=yes name=data_registrazione dbname="documento.data_registrazione" dbalias=".data_registrazione" )
 column=(type=decimal(4) updatewhereclause=yes name=importo dbname="scadenza.importo" dbalias=".importo" )
 column=(type=decimal(4) updatewhereclause=yes name=cc_importo_riga dbname="c_importo_riga" )
 column=(type=long updatewhereclause=yes name=id_valuta_i dbname="id_valuta_i" )
 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"riga_dis_banca~" )  TABLE(NAME=~"scadenza~" )  TABLE(NAME=~"sog_commerciale~" )  TABLE(NAME=~"anagrafica~" )  TABLE(NAME=~"tipo_pagamento~" )  TABLE(NAME=~"dis_banca~" )  TABLE(NAME=~"esercizio~" )  TABLE(NAME=~"documento~" ) COLUMN(NAME=~"riga_dis_banca.id_riga_distinta_banca~") COLUMN(NAME=~"riga_dis_banca.id_distinta_banca~") COLUMN(NAME=~"riga_dis_banca.num_riga~") COLUMN(NAME=~"riga_dis_banca.imp_totale~") COLUMN(NAME=~"riga_dis_banca.rif_documento~") COLUMN(NAME=~"riga_dis_banca.creata_su_modello~") COLUMN(NAME=~"riga_dis_banca.creata_su_distinta~") COLUMN(NAME=~"riga_dis_banca.esito_pagamento~") COLUMN(NAME=~"riga_dis_banca.data_pagamento~") COLUMN(NAME=~"riga_dis_banca.id_azienda~") COLUMN(NAME=~"scadenza.data_scadenza~") COLUMN(NAME=~"scadenza.id_scadenza~") COLUMN(NAME=~"scadenza.tipo_scadenza~") COLUMN(NAME=~"scadenza.id_sog_commerciale~") COLUMN(NAME=~"scadenza.id_riga_distinta_banca~") COLUMN(NAME=~"scadenza.id_par_aperta~") COLUMN(NAME=~"sog_commerciale.codice~") COLUMN(NAME=~"anagrafica.rag_soc_1~") COLUMN(NAME=~"scadenza.id_tipo_pagamento~") COLUMN(NAME=~"tipo_pagamento.descrizione~") COMPUTE(NAME=~"CAST( fn_conv_valuta(id_valuta_i, ~~~"scadenza~~~".~~~"importo~~~", :rn_id_valuta) AS NUMERIC(18,4) ) AS scadenza_importo~") COMPUTE(NAME=~"CAST( :rn_id_valuta AS INTEGER ) AS id_valuta~") COLUMN(NAME=~"documento.data_registrazione~") COLUMN(NAME=~"scadenza.importo~") COMPUTE(NAME=~"CAST( fn_conv_valuta(~~~"dis_banca~~~".~~~"id_valuta~~~",  ~~~"riga_dis_banca~~~".~~~"imp_totale~~~", :rn_id_valuta) AS NUMERIC(18,4) ) AS c_importo_riga~") COMPUTE(NAME=~"CAST( fn_val_distinta(~~~"documento~~~".~~~"data_documento~~~",~~~"documento~~~".~~~"data_registrazione~~~",~~~"scadenza~~~".~~~"data_scadenza~~~",~~~"scadenza~~~".~~~"id_par_aperta~~~") AS integer ) AS id_valuta_i~")    JOIN (LEFT=~"scadenza.id_riga_distinta_banca~"    OP =~"=~"RIGHT=~"riga_dis_banca.id_riga_distinta_banca~"    OUTER2 =~"riga_dis_banca.id_riga_distinta_banca~" )    JOIN (LEFT=~"sog_commerciale.id_sog_commerciale~"    OP =~"=~"RIGHT=~"scadenza.id_sog_commerciale~"    OUTER2 =~"scadenza.id_sog_commerciale~" )    JOIN (LEFT=~"anagrafica.id_anagrafica~"    OP =~"=~"RIGHT=~"sog_commerciale.id_anagrafica~"    OUTER2 =~"sog_commerciale.id_anagrafica~" )    JOIN (LEFT=~"tipo_pagamento.id_tipo_pagamento~"    OP =~"=~"RIGHT=~"scadenza.id_tipo_pagamento~"    OUTER2 =~"scadenza.id_tipo_pagamento~" )    JOIN (LEFT=~"documento.id_documento~"    OP =~"=~"RIGHT=~"scadenza.id_documento~"    OUTER2 =~"scadenza.id_documento~" )    JOIN (LEFT=~"dis_banca.id_distinta_banca~"    OP =~"=~"RIGHT=~"riga_dis_banca.id_distinta_banca~" )    JOIN (LEFT=~"esercizio.id_esercizio~"    OP =~"=~"RIGHT=~"dis_banca.id_esercizio~" )WHERE(    EXP1 =~"~~~"riga_dis_banca~~~".~~~"id_azienda~~~"~"   OP =~"in~"    EXP2 =~"(0,1)~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"riga_dis_banca~~~".~~~"id_riga_distinta_banca~~~"~"   OP =~"=~"    EXP2 =~":rn_id_riga_distinta_banca~" ) ) ARG(NAME = ~"rn_id_riga_distinta_banca~" TYPE = number)  ARG(NAME = ~"rn_id_valuta~" TYPE = number) " arguments=(("rn_id_riga_distinta_banca", number),("rn_id_valuta", number)) )
