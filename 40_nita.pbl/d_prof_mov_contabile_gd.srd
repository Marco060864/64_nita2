footer(height=0 color="536870912" )
detail(height=72 color="553648127" )
table(column=(type=long update=yes updatewhereclause=yes key=yes name=id_prof_registrazione dbname="prof_mov_contabile.id_prof_registrazione" )
 column=(type=decimal(0) update=yes updatewhereclause=yes name=num_riga dbname="prof_mov_contabile.num_riga" validation=" real(gettext())  >= 0" validationmsg="'Immettere un valore >= 0'" )
 column=(type=long update=yes updatewhereclause=yes name=id_conto dbname="prof_mov_contabile.id_conto" )
 column=(type=char(8) update=yes updatewhereclause=yes name=filtro_conto dbname="prof_mov_contabile.filtro_conto" )
 column=(type=char(40) update=yes updatewhereclause=yes name=des_contabile dbname="prof_mov_contabile.des_contabile" )
 column=(type=decimal(0) update=yes updatewhereclause=yes name=importo dbname="prof_mov_contabile.importo" )
 column=(type=char(1) update=yes updatewhereclause=yes name=segno dbname="prof_mov_contabile.segno" values="Dare	D/Avere	A/" validation=" gettext()  = 'D' OR  gettext()  = 'A'" validationmsg="'Immettere: D, A'" )
 column=(type=char(8) updatewhereclause=yes name=conto_codice dbname="conto.codice" )
 column=(type=char(40) updatewhereclause=yes name=conto_descrizione dbname="conto.descrizione" )
 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"prof_mov_contabile~" )  TABLE(NAME=~"conto~" ) COLUMN(NAME=~"prof_mov_contabile.id_prof_registrazione~") COLUMN(NAME=~"prof_mov_contabile.num_riga~") COLUMN(NAME=~"prof_mov_contabile.id_conto~") COLUMN(NAME=~"prof_mov_contabile.filtro_conto~") COLUMN(NAME=~"prof_mov_contabile.des_contabile~") COLUMN(NAME=~"prof_mov_contabile.importo~") COLUMN(NAME=~"prof_mov_contabile.segno~") COLUMN(NAME=~"conto.codice~") COLUMN(NAME=~"conto.descrizione~")    JOIN (LEFT=~"conto.id_conto~"    OP =~"=~"RIGHT=~"prof_mov_contabile.id_conto~"    OUTER2 =~"prof_mov_contabile.id_conto~" )WHERE(    EXP1 =~"~~~"prof_mov_contabile~~~".~~~"id_prof_registrazione~~~"~"   OP =~"=~"    EXP2 =~":ra_prof_registrazione~" ) ) ORDER(NAME=~"prof_mov_contabile.num_riga~" ASC=yes ) ARG(NAME = ~"ra_prof_registrazione~" TYPE = number) " update="prof_mov_contabile" updatewhere=1 updatekeyinplace=yes arguments=(("ra_prof_registrazione", number)) )
