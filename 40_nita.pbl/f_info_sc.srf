global type f_info_sc from function_object
end type

forward prototypes
global function string f_info_sc (long al_id_sog_commerciale)
end prototypes

global function string f_info_sc (long al_id_sog_commerciale);

string ls_info, ls_Rag_Soc_1, ls_Rag_Soc_2, ls_Ind, ls_CAP, ls_Loc, ls_Prov, ls_Naz, ls_CF, ls_PI

  SELECT "dba"."anagrafica"."rag_soc_1",   
         "dba"."anagrafica"."rag_soc_2",   
         "dba"."anagrafica"."indirizzo",   
         "dba"."anagrafica"."cap",   
         "dba"."anagrafica"."localita",   
         "dba"."anagrafica"."provincia",   
         "dba"."anagrafica"."nazione",   
         "dba"."anagrafica"."cod_fiscale",   
         "dba"."anagrafica"."par_iva"  
    INTO :ls_Rag_Soc_1,   
         :ls_Rag_Soc_2,   
         :ls_Ind,   
         :ls_CAP,   
         :ls_Loc,   
         :ls_Prov,   
         :ls_Naz,   
         :ls_CF,   
         :ls_PI  
    FROM "dba"."anagrafica",   
         "dba"."sog_commerciale"  
   WHERE ( "dba"."sog_commerciale"."id_anagrafica" = "dba"."anagrafica"."id_anagrafica" )  and
			( "dba"."sog_commerciale"."id_sog_commerciale" = :al_id_sog_commerciale );

CHOOSE CASE SQLCA.SQLCode
	CASE 0
		
		
		IF IsNull(ls_Rag_Soc_1) THEN ls_Rag_Soc_1 = ""
		IF IsNull(ls_Rag_Soc_2) THEN ls_Rag_Soc_2 = ""
		IF IsNull(ls_Ind) THEN ls_Ind = ""
		IF IsNull(ls_CAP) THEN ls_CAP = ""
		IF IsNull(ls_Loc) THEN ls_Loc = ""
		IF IsNull(ls_Prov) THEN ls_Prov = ""
		IF IsNull(ls_Naz) THEN ls_Naz = ""
		IF IsNull(ls_PI) THEN ls_PI = ""
		IF IsNull(ls_CF) THEN ls_CF = ""
		ls_info = ls_Rag_Soc_1 + " - " + ls_Rag_Soc_2 + "~r" + ls_Ind + "~r" + ls_CAP + &
			" " + ls_Loc + " " + ls_Prov + " " + ls_Naz + "~rP.I.:" + ls_PI + " - C.F.:" + ls_CF
	CASE -1, 100
		ls_info = ""
END CHOOSE

RETURN ls_info
end function

