 column=(type=date updatewhereclause=yes name=data_registrazione dbname="data_registrazione" )
 column=(type=decimal(4) updatewhereclause=yes name=importo dbname="importo" )
 column=(type=decimal(4) updatewhereclause=yes name=cc_importo_riga dbname="c_importo_riga" )
 column=(type=long updatewhereclause=yes name=id_valuta_i dbname="id_valuta_i" )
 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"riga_dis_banca~" )  TABLE(NAME=~"scadenza~" )  TABLE(NAME=~"sog_commerciale~" )  TABLE(NAME=~"anagrafica~" )  TABLE(NAME=~"tipo_pagamento~" )  TABLE(NAME=~"dis_banca~" )  TABLE(NAME=~"esercizio~" )  TABLE(NAME=~"documento~" ) COLUMN(NAME=~"riga_dis_banca.id_riga_distinta_banca~") COLUMN(NAME=~"riga_dis_banca.id_distinta_banca~") COLUMN(NAME=~"riga_dis_banca.num_riga~") COLUMN(NAME=~"riga_dis_banca.imp_totale~") COLUMN(NAME=~"riga_dis_banca.rif_documento~") COLUMN(NAME=~"riga_dis_banca.creata_su_modello~") COLUMN(NAME=~"riga_dis_banca.creata_su_distinta~") COLUMN(NAME=~"riga_dis_banca.esito_pagamento~") COLUMN(NAME=~"riga_dis_banca.data_pagamento~") COLUMN(NAME=~"riga_dis_banca.id_azienda~") COLUMN(NAME=~"scadenza.data_scadenza~") COLUMN(NAME=~"scadenza.id_scadenza~") COLUMN(NAME=~"scadenza.tipo_scadenza~") COLUMN(NAME=~"scadenza.id_sog_commerciale~") COLUMN(NAME=~"scadenza.id_riga_distinta_banca~") COLUMN(NAME=~"scadenza.id_par_aperta~") COLUMN(NAME=~"sog_commerciale.codice~") COLUMN(NAME=~"anagrafica.rag_soc_1~") COLUMN(NAME=~"scadenza.id_tipo_pagamento~") COLUMN(NAME=~"tipo_pagamento.descrizione~") COMPUTE(NAME=~"CAST( fn_conv_valuta(id_valuta_i, ~~~"scadenza~~~".~~~"importo~~~", :rn_id_valuta) AS NUMERIC(18,4) ) AS scadenza_importo~") COMPUTE(NAME=~"CAST( :rn_id_valuta AS INTEGER ) AS id_valuta~") COLUMN(NAME=~"documento.data_registrazione~") COLUMN(NAME=~"scadenza.importo~") COMPUTE(NAME=~"CAST( fn_conv_valuta(~~~"dis_banca~~~".~~~"id_valuta~~~",  ~~~"riga_dis_banca~~~".~~~"imp_totale~~~", :rn_id_valuta) AS NUMERIC(18,4) ) AS c_importo_riga~") COMPUTE(NAME=~"CAST( fn_val_distinta(~~~"documento~~~".~~~"data_documento~~~",~~~"documento~~~".~~~"data_registrazione~~~",~~~"scadenza~~~".~~~"data_scadenza~~~",~~~"scadenza~~~".~~~"id_par_aperta~~~") AS integer ) AS id_valuta_i~")    JOIN (LEFT=~"scadenza.id_riga_distinta_banca~"    OP =~"=~"RIGHT=~"riga_dis_banca.id_riga_distinta_banca~"    OUTER2 =~"riga_dis_banca.id_riga_distinta_banca~" )    JOIN (LEFT=~"sog_commerciale.id_sog_commerciale~"    OP =~"=~"RIGHT=~"scadenza.id_sog_commerciale~"    OUTER2 =~"scadenza.id_sog_commerciale~" )    JOIN (LEFT=~"anagrafica.id_anagrafica~"    OP =~"=~"RIGHT=~"sog_commerciale.id_anagrafica~"    OUTER2 =~"sog_commerciale.id_anagrafica~" )    JOIN (LEFT=~"tipo_pagamento.id_tipo_pagamento~"    OP =~"=~"RIGHT=~"scadenza.id_tipo_pagamento~"    OUTER2 =~"scadenza.id_tipo_pagamento~" )    JOIN (LEFT=~"documento.id_documento~"    OP =~"=~"RIGHT=~"scadenza.id_documento~"    OUTER2 =~"scadenza.id_documento~" )    JOIN (LEFT=~"dis_banca.id_distinta_banca~"    OP =~"=~"RIGHT=~"riga_dis_banca.id_distinta_banca~" )    JOIN (LEFT=~"esercizio.id_esercizio~"    OP =~"=~"RIGHT=~"dis_banca.id_esercizio~" )WHERE(    EXP1 =~"~~~"riga_dis_banca~~~".~~~"id_azienda~~~"~"   OP =~"in~"    EXP2 =~"(0,1)~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"riga_dis_banca~~~".~~~"id_distinta_banca~~~"~"   OP =~"=~"    EXP2 =~":rn_id_distinta_banca~" ) ) ARG(NAME = ~"rn_id_distinta_banca~" TYPE = number)  ARG(NAME = ~"rn_id_valuta~" TYPE = number) " update="riga_dis_banca" updatewhere=1 updatekeyinplace=yes arguments=(("rn_id_distinta_banca", number),("rn_id_valuta", number)) )
