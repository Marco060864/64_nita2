table(column=(type=long update=yes updatewhereclause=yes key=yes identity=yes name=id_riga_distinta_banca dbname="id_riga_distinta_banca" )
 column=(type=long update=yes updatewhereclause=yes name=id_distinta_banca dbname="id_distinta_banca" )
 column=(type=decimal(0) update=yes updatewhereclause=yes name=riga_dis_banca_num_riga dbname="num_riga" )
 column=(type=decimal(4) update=yes updatewhereclause=yes name=riga_dis_banca_imp_totale dbname="imp_totale" )
