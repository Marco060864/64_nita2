 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"ges_ratei_risconti~" )  TABLE(NAME=~"reg_pd~" )  TABLE(NAME=~"conto~" ALIAS=~"conto_a~" )  TABLE(NAME=~"conto~" ALIAS=~"conto_b~" ) COLUMN(NAME=~"ges_ratei_risconti.rif_scrittura~") COLUMN(NAME=~"ges_ratei_risconti.rif_intestatario~") COLUMN(NAME=~"ges_ratei_risconti.rif_documento~") COLUMN(NAME=~"ges_ratei_risconti.rif_conto~") COLUMN(NAME=~"ges_ratei_risconti.importo_doc~") COLUMN(NAME=~"ges_ratei_risconti.data_in_comp~") COLUMN(NAME=~"ges_ratei_risconti.data_fin_comp~") COLUMN(NAME=~"ges_ratei_risconti.flag_rat_ris~") COLUMN(NAME=~"ges_ratei_risconti.quota_bloc~") COLUMN(NAME=~"ges_ratei_risconti.storno~") COLUMN(NAME=~"ges_ratei_risconti.tipo_record~") COLUMN(NAME=~"reg_pd.num_progressivo~") COLUMN(NAME=~"reg_pd.data_competenza~") COLUMN(NAME=~"reg_pd.data_registrazione~") COLUMN(NAME=~"conto_a.codice~") COLUMN(NAME=~"conto_a.descrizione~") COLUMN(NAME=~"ges_ratei_risconti.quota_rat_ris~") COLUMN(NAME=~"ges_ratei_risconti.id_ges_ratei_risconti~") COLUMN(NAME=~"ges_ratei_risconti.segno~") COLUMN(NAME=~"conto_b.codice~") COLUMN(NAME=~"conto_b.descrizione~")    JOIN (LEFT=~"ges_ratei_risconti.rif_scrittura~"    OP =~"=~"RIGHT=~"reg_pd.id_reg_pd~"    OUTER1 =~"ges_ratei_risconti.rif_scrittura~" )    JOIN (LEFT=~"ges_ratei_risconti.rif_intestatario~"    OP =~"=~"RIGHT=~"conto_b.id_conto~"    OUTER1 =~"ges_ratei_risconti.rif_intestatario~" )   JOIN (LEFT=~"ges_ratei_risconti.rif_conto~"    OP =~"=~"RIGHT=~"conto_a.id_conto~" ) WHERE(    EXP1 =~"~~~"ges_ratei_risconti~~~".~~~"tipo_record~~~"~"   OP =~"=~"    EXP2 =~"'T'~" ) ) ORDER(NAME=~"reg_pd.num_progressivo~" ASC=yes ) " update="ges_ratei_risconti" updatewhere=1 updatekeyinplace=yes )
