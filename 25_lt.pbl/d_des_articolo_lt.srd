//objectcomments selectionlist (grid) per la tabella des_articolo (per un solo articolo)
release 5;
datawindow(units=0 timer_interval=0 color=79741120 processing=1 print.documentname="" print.orientation = 0 print.margin.left = 110 print.margin.right = 110 print.margin.top = 97 print.margin.bottom = 97 print.paper.source = 0 print.paper.size = 0 print.prompt=no grid.lines=0 selected.mouse=no )
header(height=117 color="536870912" )
summary(height=1 color="536870912" )
footer(height=1 color="536870912" )
detail(height=73 color="553648127" )
table(column=(type=long update=yes updatewhereclause=yes key=yes identity=yes name=id_des_articolo dbname="id_des_articolo" )
 column=(type=long update=yes updatewhereclause=yes name=id_sog_commerciale dbname="id_sog_commerciale" )
 column=(type=char(8) updatewhereclause=yes name=sog_commerciale_codice dbname="codice" )
 column=(type=char(40) updatewhereclause=yes name=anagrafica_rag_soc_1 dbname="rag_soc_1" )
 column=(type=char(4) updatewhereclause=yes name=linguaggio_codice dbname="codice" )
 column=(type=char(40) updatewhereclause=yes name=linguaggio_descrizione dbname="descrizione" )
 column=(type=char(40) update=yes updatewhereclause=yes name=descrizione dbname="descrizione" )
 column=(type=char(32766) update=yes updatewhereclause=no name=des_estesa dbname="des_estesa" )
 column=(type=long update=yes updatewhereclause=yes name=id_articolo dbname="id_articolo" )
 column=(type=char(80) updatewhereclause=yes name=articolo_descrizione dbname="descrizione" )
 column=(type=char(32) update=yes updatewhereclause=yes name=codice dbname="codice" )
 column=(type=long update=yes updatewhereclause=yes name=des_articolo_id_lingua_des dbname="id_lingua" )
 column=(type=char(32) update=yes updatewhereclause=yes name=des_codice dbname="codice" )
 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"des_articolo~" )  TABLE(NAME=~"sog_commerciale~" )  TABLE(NAME=~"linguaggio~" )  TABLE(NAME=~"articolo~" )  TABLE(NAME=~"anagrafica~" ) COLUMN(NAME=~"des_articolo.id_des_articolo~") COLUMN(NAME=~"des_articolo.id_sog_commerciale~") COLUMN(NAME=~"sog_commerciale.codice~") COLUMN(NAME=~"anagrafica.rag_soc_1~") COLUMN(NAME=~"linguaggio.codice~") COLUMN(NAME=~"linguaggio.descrizione~") COLUMN(NAME=~"des_articolo.descrizione~") COLUMN(NAME=~"des_articolo.des_estesa~") COLUMN(NAME=~"des_articolo.id_articolo~") COLUMN(NAME=~"articolo.descrizione~") COLUMN(NAME=~"articolo.codice~") COLUMN(NAME=~"des_articolo.id_lingua~") COLUMN(NAME=~"des_articolo.codice~")    JOIN (LEFT=~"des_articolo.id_sog_commerciale~"    OP =~"=~"RIGHT=~"sog_commerciale.id_sog_commerciale~"    OUTER1 =~"des_articolo.id_sog_commerciale~" )    JOIN (LEFT=~"des_articolo.id_linguaggio~"    OP =~"=~"RIGHT=~"linguaggio.id_linguaggio~"    OUTER1 =~"des_articolo.id_linguaggio~" )    JOIN (LEFT=~"des_articolo.id_articolo~"    OP =~"=~"RIGHT=~"articolo.id_articolo~"    OUTER1 =~"des_articolo.id_articolo~" )    JOIN (LEFT=~"sog_commerciale.id_anagrafica~"    OP =~"=~"RIGHT=~"anagrafica.id_anagrafica~"    OUTER1 =~"sog_commerciale.id_anagrafica~" )WHERE(    EXP1 =~"( ~~~"des_articolo~~~".~~~"id_azienda~~~"~"   OP =~"in~"    EXP2 =~"(0,1) )~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"( ~~~"des_articolo~~~".~~~"id_articolo~~~"~"   OP =~"=~"    EXP2 =~":rn_id_articolo )~" ) ) ARG(NAME = ~"rn_id_articolo~" TYPE = number) " update="des_articolo" updatewhere=1 updatekeyinplace=yes arguments=(("rn_id_articolo", number)) )
