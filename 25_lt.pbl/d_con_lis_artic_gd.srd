 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"con_lis_articolo~" ) COMPUTE(NAME=~"cast(( select rag_soc_1 from sog_commerciale_gen where id_sog_commerciale=~~~"con_lis_articolo~~~".~~~"id_sog_commerciale~~~") as char(40) ) as sogg_rag~") COMPUTE(NAME=~"cast(( select rag_soc_1 from sog_commerciale_gen where id_sog_commerciale=~~~"con_lis_articolo~~~".~~~"id_sog_commerciale_fornitore~~~") as char(40) ) as forn_rag~") COMPUTE(NAME=~"cast(( select codice from articolo where id_articolo=~~~"con_lis_articolo~~~".~~~"id_art_da~~~") as char(40) ) as art_da_cod~") COMPUTE(NAME=~"cast(( select codice from articolo where id_articolo=~~~"con_lis_articolo~~~".~~~"id_art_a~~~") as char(40) ) as art_a_cod~") COMPUTE(NAME=~"cast(( select codice from unita_confezione where id_unita_confezione=~~~"con_lis_articolo~~~".~~~"id_unita_confezione~~~") as char(40) ) as uf_cod~") COMPUTE(NAME=~"cast(( select descrizione from unita_confezione where id_unita_confezione=~~~"con_lis_articolo~~~".~~~"id_unita_confezione~~~") as char(40) ) as uf_des~") COMPUTE(NAME=~"cast(( select rag_soc_1 from anagrafica where id_anagrafica=~~~"con_lis_articolo~~~".~~~"id_anagrafica~~~") as char(40) ) as produttore~") COMPUTE(NAME=~"cast(( select codice from listino where id_listino=~~~"con_lis_articolo~~~".~~~"id_listino~~~") as char(4) ) as list_cod~") COMPUTE(NAME=~"cast(( select descrizione from listino where id_listino=~~~"con_lis_articolo~~~".~~~"id_listino~~~") as char(40) ) as list_des~") COMPUTE(NAME=~"cast(( select descrizione from articolo where id_articolo=~~~"con_lis_articolo~~~".~~~"id_art_da~~~") as char(80) ) as art_da_des~") COMPUTE(NAME=~"cast(( select descrizione from articolo where id_articolo=~~~"con_lis_articolo~~~".~~~"id_art_a~~~") as char(80) ) as art_a_des~") COMPUTE(NAME=~"cast(( select codice from sog_commerciale where id_sog_commerciale=~~~"con_lis_articolo~~~".~~~"id_sog_commerciale_fornitore~~~") as char(10) ) as forn_cod~") COMPUTE(NAME=~"cast(( select codice from sog_commerciale where id_sog_commerciale=~~~"con_lis_articolo~~~".~~~"id_sog_commerciale~~~") as char(10) ) as sogg_cod~") COLUMN(NAME=~"con_lis_articolo.id_con_lis_articolo~") COLUMN(NAME=~"con_lis_articolo.applicazione~") COLUMN(NAME=~"con_lis_articolo.id_unita_confezione~") COLUMN(NAME=~"con_lis_articolo.id_cat_com_sc~") COLUMN(NAME=~"con_lis_articolo.id_sog_commerciale~") COLUMN(NAME=~"con_lis_articolo.id_art_da~") COLUMN(NAME=~"con_lis_articolo.id_cat_com_articolo~") COLUMN(NAME=~"con_lis_articolo.id_sog_commerciale_fornitore~") COLUMN(NAME=~"con_lis_articolo.id_anagrafica~") COLUMN(NAME=~"con_lis_articolo.id_listino~") COLUMN(NAME=~"con_lis_articolo.data_inizio~") COLUMN(NAME=~"con_lis_articolo.data_fine~") COLUMN(NAME=~"con_lis_articolo.qta_minima~") COLUMN(NAME=~"con_lis_articolo.qta_massima~") COLUMN(NAME=~"con_lis_articolo.tipo_applicazione~") COLUMN(NAME=~"con_lis_articolo.id_valuta~") COLUMN(NAME=~"con_lis_articolo.importo~") COLUMN(NAME=~"con_lis_articolo.spesa~") COLUMN(NAME=~"con_lis_articolo.cambio~") COLUMN(NAME=~"con_lis_articolo.percentuali~") COLUMN(NAME=~"con_lis_articolo.spesa_fissa~") COLUMN(NAME=~"con_lis_articolo.priorita~") COLUMN(NAME=~"con_lis_articolo.id_azienda~") COLUMN(NAME=~"con_lis_articolo.id_art_a~") COLUMN(NAME=~"con_lis_articolo.id_destinazione~") COLUMN(NAME=~"con_lis_articolo.tras_mezzo~") COLUMN(NAME=~"con_lis_articolo.id_tipo_trasporto~") COLUMN(NAME=~"con_lis_articolo.id_cat_merceologica~")) " update="con_lis_articolo" updatewhere=0 updatekeyinplace=no )
