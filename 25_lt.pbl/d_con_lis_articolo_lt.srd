release 5;
datawindow(units=0 timer_interval=0 color=79741120 processing=1 print.documentname="" print.orientation = 0 print.margin.left = 110 print.margin.right = 110 print.margin.top = 97 print.margin.bottom = 97 print.paper.source = 0 print.paper.size = 0 print.prompt=no grid.lines=0 selected.mouse=no )
header(height=117 color="553648127" )
summary(height=1 color="536870912" )
footer(height=17 color="536870912" )
detail(height=73 color="553648127" )
table(column=(type=char(4) updatewhereclause=yes name=listino_codice dbname="listino.codice" )
 column=(type=char(40) updatewhereclause=yes name=listino_descrizione dbname="listino.descrizione" )
 column=(type=decimal(4) update=yes updatewhereclause=yes name=con_lis_articolo_qta_minima dbname="con_lis_articolo.qta_minima" validation=" real(gettext())  >= 0" validationmsg="'Immettere un valore >= 0'" )
 column=(type=decimal(4) update=yes updatewhereclause=yes name=con_lis_articolo_qta_massima dbname="con_lis_articolo.qta_massima" validation=" real(gettext())  >= 0" validationmsg="'Immettere un valore >= 0'" )
 column=(type=long update=yes updatewhereclause=yes key=yes identity=yes name=id_con_lis_articolo dbname="con_lis_articolo.id_con_lis_articolo" )
 column=(type=char(1) update=yes updatewhereclause=yes name=con_lis_articolo_tipo_applicazione dbname="con_lis_articolo.tipo_applicazione" initial="N" values="Normale	N/Sconto Importo	I/Sconto Riga	R/" validation=" gettext()  = 'N' OR  gettext()  = 'I' OR  gettext()  = 'R'" validationmsg="'Immettere: N, I, R'" )
 column=(type=long updatewhereclause=yes name=cc_sog_commerciale dbname="c_sog_commerciale" values="	0/	1" )
 column=(type=long updatewhereclause=yes name=cc_unita_confezione dbname="c_unita_confezione" values="	0/	1" )
 column=(type=long updatewhereclause=yes name=cc_qta dbname="c_qta" values="	0/	1" )
 column=(type=long updatewhereclause=yes name=cc_altro dbname="c_altro" values="	0/	1" )
 column=(type=date update=yes updatewhereclause=yes name=con_lis_articolo_data_inizio dbname="con_lis_articolo.data_inizio" )
 column=(type=date update=yes updatewhereclause=yes name=con_lis_articolo_data_fine dbname="con_lis_articolo.data_fine" )
 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"con_lis_articolo~" )  TABLE(NAME=~"listino~" ) COLUMN(NAME=~"listino.codice~") COLUMN(NAME=~"listino.descrizione~") COLUMN(NAME=~"con_lis_articolo.qta_minima~") COLUMN(NAME=~"con_lis_articolo.qta_massima~") COLUMN(NAME=~"con_lis_articolo.id_con_lis_articolo~") COLUMN(NAME=~"con_lis_articolo.tipo_applicazione~") COMPUTE(NAME=~"ifnull(~~~"con_lis_articolo~~~".~~~"id_sog_commerciale~~~",1, 0) * ifnull(~~~"con_lis_articolo~~~".~~~"id_cat_com_sc~~~",1, 0) c_sog_commerciale~") COMPUTE(NAME=~"ifnull(~~~"con_lis_articolo~~~".~~~"id_unita_confezione~~~",1, 0) * ifnull(~~~"con_lis_articolo~~~".~~~"id_articolo~~~",1, 0)* ifnull(~~~"con_lis_articolo~~~".~~~"id_cat_com_articolo~~~",1, 0) c_unita_confezione~") COMPUTE(NAME=~"ifnull(~~~"con_lis_articolo~~~".~~~"qta_minima~~~",1, 0) * ifnull(~~~"con_lis_articolo~~~".~~~"qta_massima~~~",1, 0) c_qta~") COMPUTE(NAME=~"ifnull(~~~"con_lis_articolo~~~".~~~"id_sog_commerciale_fornitore~~~",1, 0) * ifnull(~~~"con_lis_articolo~~~".~~~"id_anagrafica~~~",1, 0)* ifnull(~~~"con_lis_articolo~~~".~~~"id_listino~~~",1, 0) c_altro~") COLUMN(NAME=~"con_lis_articolo.data_inizio~") COLUMN(NAME=~"con_lis_articolo.data_fine~")    JOIN (LEFT=~"con_lis_articolo.id_listino~"    OP =~"=~"RIGHT=~"listino.id_listino~"    OUTER1 =~"con_lis_articolo.id_listino~" )WHERE(    EXP1 =~"~~~"con_lis_articolo~~~".~~~"id_azienda~~~"~"   OP =~"in~"    EXP2 =~"(0,1)~" ) ) " update="con_lis_articolo" updatewhere=1 updatekeyinplace=yes )
