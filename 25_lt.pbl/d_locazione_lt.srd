 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"locazione~" )  TABLE(NAME=~"area~" )  TABLE(NAME=~"magazzino~" ) COLUMN(NAME=~"locazione.id_locazione~") COLUMN(NAME=~"locazione.id_magazzino~") COLUMN(NAME=~"locazione.id_area~") COLUMN(NAME=~"magazzino.codice~") COLUMN(NAME=~"magazzino.descrizione~") COLUMN(NAME=~"area.codice~") COLUMN(NAME=~"area.descrizione~") COLUMN(NAME=~"locazione.corsia~") COLUMN(NAME=~"locazione.scaffale~") COLUMN(NAME=~"locazione.ripiano~") COLUMN(NAME=~"locazione.posizione~") COLUMN(NAME=~"locazione.id_azienda~")    JOIN (LEFT=~"area.id_area~"    OP =~"=~"RIGHT=~"locazione.id_area~"    OUTER2 =~"locazione.id_area~" )    JOIN (LEFT=~"magazzino.id_magazzino~"    OP =~"=~"RIGHT=~"locazione.id_magazzino~" )) ORDER(NAME=~"magazzino.codice~" ASC=yes )  ORDER(NAME=~"area.codice~" ASC=yes )  ORDER(NAME=~"locazione.corsia~" ASC=yes )  ORDER(NAME=~"locazione.scaffale~" ASC=yes )  ORDER(NAME=~"locazione.ripiano~" ASC=yes )  ORDER(NAME=~"locazione.posizione~" ASC=yes ) " )
