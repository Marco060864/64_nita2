table(column=(type=long updatewhereclause=yes key=yes identity=yes name=id_sog_commerciale dbname="sog_commerciale.id_sog_commerciale" )
 column=(type=char(8) update=yes updatewhereclause=yes name=sog_commerciale_codice dbname="sog_commerciale.codice" )
 column=(type=char(40) updatewhereclause=yes name=anagrafica_rag_soc_1 dbname="anagrafica.rag_soc_1" )
 column=(type=char(16) updatewhereclause=yes name=anagrafica_cod_fiscale dbname="anagrafica.cod_fiscale" )
 column=(type=char(16) updatewhereclause=yes name=anagrafica_par_iva dbname="anagrafica.par_iva" )
 column=(type=char(1) update=yes updatewhereclause=yes name=sog_commerciale_tipo dbname="sog_commerciale.tipo" values="Cliente	C/Fornitore	F/Agente	A/Vettore	V/Altro	Z/Cliente potenziale	P/" validation=" gettext()  = 'C' OR  gettext()  = 'F' OR  gettext()  = 'A' OR  gettext()  = 'V' OR  gettext()  = 'Z' OR  gettext()  = 'P'" validationmsg="'Inserire: C, F, A, V, P, Z'" )
 column=(type=date update=yes updatewhereclause=yes name=sog_commerciale_data_acquisizione dbname="sog_commerciale.data_acquisizione" )
 column=(type=char(20) update=yes updatewhereclause=yes name=sog_commerciale_ns_cod_soggetto dbname="sog_commerciale.ns_cod_soggetto" )
 column=(type=char(4) updatewhereclause=yes name=cat_attivita_codice dbname="cat_attivita.codice" )
 column=(type=char(4) updatewhereclause=yes name=cat_com_sc_codice dbname="cat_com_sc.codice" )
 column=(type=char(4) updatewhereclause=yes name=cat_zona_codice dbname="cat_zona.codice" )
 column=(type=long update=yes updatewhereclause=yes name=sog_commerciale_id_azienda dbname="sog_commerciale.id_azienda" initial="1" )
 column=(type=long update=yes updatewhereclause=yes name=sog_commerciale_id_conto dbname="sog_commerciale.id_conto" )
 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"anagrafica~" )  TABLE(NAME=~"cat_attivita~" )  TABLE(NAME=~"cat_com_sc~" )  TABLE(NAME=~"cat_zona~" )  TABLE(NAME=~"sog_commerciale~" ) COLUMN(NAME=~"sog_commerciale.id_sog_commerciale~") COLUMN(NAME=~"sog_commerciale.codice~") COLUMN(NAME=~"anagrafica.rag_soc_1~") COLUMN(NAME=~"anagrafica.cod_fiscale~") COLUMN(NAME=~"anagrafica.par_iva~") COLUMN(NAME=~"sog_commerciale.tipo~") COLUMN(NAME=~"sog_commerciale.data_acquisizione~") COLUMN(NAME=~"sog_commerciale.ns_cod_soggetto~") COLUMN(NAME=~"cat_attivita.codice~") COLUMN(NAME=~"cat_com_sc.codice~") COLUMN(NAME=~"cat_zona.codice~") COLUMN(NAME=~"sog_commerciale.id_azienda~") COLUMN(NAME=~"sog_commerciale.id_conto~")    JOIN (LEFT=~"sog_commerciale.id_cat_zona~"    OP =~"=~"RIGHT=~"cat_zona.id_cat_zona~"    OUTER1 =~"sog_commerciale.id_cat_zona~" )    JOIN (LEFT=~"sog_commerciale.id_cat_com_sc~"    OP =~"=~"RIGHT=~"cat_com_sc.id_cat_com_sc~"    OUTER1 =~"sog_commerciale.id_cat_com_sc~" )    JOIN (LEFT=~"sog_commerciale.id_cat_attivita~"    OP =~"=~"RIGHT=~"cat_attivita.id_cat_attivita~"    OUTER1 =~"sog_commerciale.id_cat_attivita~" )    JOIN (LEFT=~"sog_commerciale.id_anagrafica~"    OP =~"=~"RIGHT=~"anagrafica.id_anagrafica~" )WHERE(    EXP1 =~"~~~"sog_commerciale~~~".~~~"id_azienda~~~"~"   OP =~"in~"    EXP2 =~"(0, 1)~" ) ) ORDER(NAME=~"anagrafica.rag_soc_1~" ASC=yes ) " update="sog_commerciale" updatewhere=1 updatekeyinplace=yes )
