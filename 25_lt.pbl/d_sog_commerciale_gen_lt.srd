 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"sog_commerciale_gen~" )  TABLE(NAME=~"sog_commerciale~" )  TABLE(NAME=~"banca_sog_commerciale~" )  TABLE(NAME=~"banca_appoggio~" ) COLUMN(NAME=~"sog_commerciale_gen.id_sog_commerciale~") COLUMN(NAME=~"sog_commerciale_gen.codice~") COLUMN(NAME=~"sog_commerciale_gen.rag_soc_1~") COLUMN(NAME=~"sog_commerciale_gen.rag_soc_2~") COLUMN(NAME=~"sog_commerciale_gen.indirizzo~") COLUMN(NAME=~"sog_commerciale_gen.cap~") COLUMN(NAME=~"sog_commerciale_gen.localita~") COLUMN(NAME=~"sog_commerciale_gen.provincia~") COLUMN(NAME=~"sog_commerciale_gen.nazione~") COLUMN(NAME=~"sog_commerciale_gen.cod_fiscale~") COLUMN(NAME=~"sog_commerciale_gen.par_iva~") COLUMN(NAME=~"sog_commerciale_gen.tipo~") COLUMN(NAME=~"sog_commerciale_gen.id_anagrafica~") COLUMN(NAME=~"banca_appoggio.den_abi~")    JOIN (LEFT=~"banca_appoggio.id_banca_appoggio~"    OP =~"=~"RIGHT=~"banca_sog_commerciale.id_banca_appoggio~"    OUTER2 =~"banca_sog_commerciale.id_banca_appoggio~" )    JOIN (LEFT=~"banca_sog_commerciale.id_banca_sog_commerciale~"    OP =~"=~"RIGHT=~"sog_commerciale.id_banca_sog_commerciale~"    OUTER2 =~"sog_commerciale.id_banca_sog_commerciale~" )    JOIN (LEFT=~"sog_commerciale_gen.id_sog_commerciale~"    OP =~"=~"RIGHT=~"sog_commerciale.id_sog_commerciale~" )) ORDER(NAME=~"sog_commerciale_gen.rag_soc_1~" ASC=yes ) " retrieve.asneeded=yes )
