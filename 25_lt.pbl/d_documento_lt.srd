 column=(type=char(1) update=yes updatewhereclause=yes name=stampato dbname="documento.stampato" )
 column=(type=char(2) updatewhereclause=yes name=registro_tipo_registro dbname="registro.tipo_registro" values="IVA acquisti	IA/IVA vendite	IV/Manageriale	MN/Prima nota	PN/Preventivi acquisti	PA/Preventivi vendite	PV/Ordini acquisti	OA/Ordini vendite	OV/DDT acquisti	DA/DDT vendite	DV/Liste prelievo acquisti	LA/Liste prelievo vendite	LV/Generico acquisti	GA/Generico vendite	GV/" validation=" gettext()  = 'IA' OR  gettext()  = 'IV' OR  gettext()  = 'MN' OR  gettext()  = 'PN' OR  gettext()  = 'PA' OR  gettext()  = 'PV' OR  gettext()  = 'OA' OR  gettext()  = 'OV' OR  gettext()  = 'DA' OR  gettext()  = 'DV' OR  gettext()  = 'LA' OR  gettext()  = 'LV' OR  gettext()  = 'GA' OR  gettext()  = 'GV'" validationmsg="'Immettere: IA, IV, MN, PN, OA, OP, DA, DV, LA, LP, GA, GV'" )
 column=(type=char(1) updatewhereclause=yes name=prof_documento_ric_acconti dbname="prof_documento.ric_acconti" )
 column=(type=long update=yes updatewhereclause=yes identity=yes name=id_documento dbname="documento.id_documento" )
 column=(type=long updatewhereclause=yes name=documento_id_registro dbname="documento.id_registro" )
 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"documento~" )  TABLE(NAME=~"sog_commerciale_gen~" )  TABLE(NAME=~"prof_documento~" )  TABLE(NAME=~"destinazione~" )  TABLE(NAME=~"caus_magazzino~" )  TABLE(NAME=~"registro~" ) COLUMN(NAME=~"registro.descrizione~") COLUMN(NAME=~"documento.num_progressivo~") COLUMN(NAME=~"documento.data_registrazione~") COLUMN(NAME=~"prof_documento.codice~") COLUMN(NAME=~"prof_documento.descrizione~") COLUMN(NAME=~"documento.num_documento~") COLUMN(NAME=~"documento.data_documento~") COLUMN(NAME=~"sog_commerciale_gen.codice~") COLUMN(NAME=~"sog_commerciale_gen.rag_soc_1~") COLUMN(NAME=~"destinazione.rag_soc_1~") COLUMN(NAME=~"caus_magazzino.codice~") COLUMN(NAME=~"caus_magazzino.descrizione~") COLUMN(NAME=~"documento.data_prev_consegna~") COLUMN(NAME=~"documento.stampato~") COLUMN(NAME=~"registro.tipo_registro~") COLUMN(NAME=~"prof_documento.ric_acconti~") COLUMN(NAME=~"documento.id_documento~") COLUMN(NAME=~"documento.id_registro~")    JOIN (LEFT=~"prof_documento.id_prof_documento~"    OP =~"=~"RIGHT=~"documento.id_prof_documento~"    OUTER2 =~"documento.id_prof_documento~" )    JOIN (LEFT=~"destinazione.id_destinazione~"    OP =~"=~"RIGHT=~"documento.id_destinazione~"    OUTER2 =~"documento.id_destinazione~" )    JOIN (LEFT=~"caus_magazzino.id_caus_magazzino~"    OP =~"=~"RIGHT=~"documento.id_caus_magazzino~"    OUTER2 =~"documento.id_caus_magazzino~" )    JOIN (LEFT=~"registro.id_registro~"    OP =~"=~"RIGHT=~"documento.id_registro~"    OUTER2 =~"documento.id_registro~" )    JOIN (LEFT=~"documento.id_sog_commerciale~"    OP =~"=~"RIGHT=~"sog_commerciale_gen.id_sog_commerciale~" )) ORDER(NAME=~"registro.tipo_registro~" ASC=yes )  ORDER(NAME=~"documento.id_registro~" ASC=yes )  ORDER(NAME=~"documento.num_progressivo~" ASC=no)  ORDER(NAME=~"documento.data_registrazione~" ASC=no) " )
