table(column=(type=char(40) updatewhereclause=yes name=registro_descrizione dbname="registro.descrizione" )
 column=(type=decimal(0) update=yes updatewhereclause=yes name=num_progressivo dbname="documento.num_progressivo" )
 column=(type=date update=yes updatewhereclause=yes name=data_registrazione dbname="documento.data_registrazione" )
 column=(type=char(8) updatewhereclause=yes name=prof_documento_codice dbname="prof_documento.codice" )
 column=(type=char(40) updatewhereclause=yes name=prof_documento_descrizione dbname="prof_documento.descrizione" )
 column=(type=char(16) update=yes updatewhereclause=yes name=num_documento dbname="documento.num_documento" )
 column=(type=date update=yes updatewhereclause=yes name=data_documento dbname="documento.data_documento" )
