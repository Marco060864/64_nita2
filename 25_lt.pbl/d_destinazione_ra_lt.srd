table(column=(type=long update=yes updatewhereclause=yes name=id_sog_commerciale dbname="destinazione.id_sog_commerciale" dbalias=".id_sog_commerciale" )
 column=(type=long update=yes updatewhereclause=yes name=codice dbname="destinazione.codice" dbalias=".codice" )
 column=(type=long update=yes updatewhereclause=yes key=yes identity=yes name=id_destinazione dbname="destinazione.id_destinazione" dbalias=".id_destinazione" )
 column=(type=char(40) update=yes updatewhereclause=yes name=rag_soc_1 dbname="destinazione.rag_soc_1" dbalias=".rag_soc_1" )
 column=(type=char(5) update=yes updatewhereclause=yes name=provincia dbname="destinazione.provincia" dbalias=".provincia" )
 column=(type=char(5) update=yes updatewhereclause=yes name=nazione dbname="destinazione.nazione" dbalias=".nazione" initial="IT" )
 column=(type=char(1) update=yes updatewhereclause=yes name=tipo_destinazione dbname="destinazione.tipo_destinazione" dbalias=".tipo_destinazione" values="Spedizione merci	M/Spedizione documenti e fattura	D/Riferimento presentazione RI.BA.	R/" validation=" gettext()  = 'M' OR  gettext()  = 'D' OR  gettext()  = 'R'" validationmsg="'Immettere: M, D, R'" )
 column=(type=long update=yes updatewhereclause=yes name=id_azienda dbname="destinazione.id_azienda" dbalias=".id_azienda" initial="1" )
 column=(type=char(40) updatewhereclause=yes name=indirizzo dbname="destinazione.indirizzo" dbalias=".indirizzo" )
 column=(type=char(10) updatewhereclause=yes name=cap dbname="destinazione.cap" dbalias=".cap" )
 column=(type=char(40) updatewhereclause=yes name=localita dbname="destinazione.localita" dbalias=".localita" )
 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"destinazione~" ) COLUMN(NAME=~"destinazione.id_sog_commerciale~") COLUMN(NAME=~"destinazione.codice~") COLUMN(NAME=~"destinazione.id_destinazione~") COLUMN(NAME=~"destinazione.rag_soc_1~") COLUMN(NAME=~"destinazione.provincia~") COLUMN(NAME=~"destinazione.nazione~") COLUMN(NAME=~"destinazione.tipo_destinazione~") COLUMN(NAME=~"destinazione.id_azienda~") COLUMN(NAME=~"destinazione.indirizzo~") COLUMN(NAME=~"destinazione.cap~") COLUMN(NAME=~"destinazione.localita~")WHERE(    EXP1 =~"~~~"destinazione~~~".~~~"id_sog_commerciale~~~"~"   OP =~"=~"    EXP2 =~":id_sog~" ) ) ARG(NAME = ~"id_sog~" TYPE = number) " update="destinazione" updatewhere=0 updatekeyinplace=no arguments=(("id_sog", number))  sort="codice A " )
