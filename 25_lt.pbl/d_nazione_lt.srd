table(column=(type=long update=yes updatewhereclause=yes key=yes identity=yes name=id_nazione dbname="nazione.id_nazione" dbalias=".id_nazione" )
 column=(type=char(5) update=yes updatewhereclause=yes name=codice dbname="nazione.codice" dbalias=".codice" initial="IT" )
 column=(type=char(40) update=yes updatewhereclause=yes name=descrizione dbname="nazione.descrizione" dbalias=".descrizione" )
 column=(type=char(4) updatewhereclause=yes name=valuta_codice dbname="valuta.codice" dbalias=".codice" )
 column=(type=char(40) updatewhereclause=yes name=valuta_descrizione dbname="valuta.descrizione" dbalias=".descrizione" )
 column=(type=char(5) updatewhereclause=yes name=lingua_codice dbname="lingua.codice" dbalias=".codice" initial="IT" )
 column=(type=char(40) updatewhereclause=yes name=lingua_descrizione dbname="lingua.descrizione" dbalias=".descrizione" )
 column=(type=char(1) update=yes updatewhereclause=yes name=prov_contabile dbname="nazione.prov_contabile" dbalias=".prov_contabile" initial="I" values="Azienda intracomunitaria	I/Azienda extracomunitaria	E/San Marino	S/" validation=" gettext()  = 'I' OR  gettext()  = 'E' OR  gettext()  = 'S'" validationmsg="'Immettere: I, E, S'" )
 column=(type=long update=yes updatewhereclause=yes name=nazione_id_valuta dbname="nazione.id_valuta" dbalias=".id_valuta" )
 column=(type=long update=yes updatewhereclause=yes name=nazione_id_lingua dbname="nazione.id_lingua" dbalias=".id_lingua" )
 column=(type=char(3) update=yes updatewhereclause=yes name=nazione_cod_territorio dbname="nazione.cod_territorio" dbalias=".cod_territorio" )
 column=(type=char(2) update=yes updatewhereclause=yes name=nazione_alpha_2 dbname="nazione.alpha_2" dbalias=".alpha_2" )
 column=(type=char(3) update=yes updatewhereclause=yes name=nazione_alpha_3 dbname="nazione.alpha_3" dbalias=".alpha_3" )
 column=(type=long update=yes updatewhereclause=yes name=nazione_iso3166_1 dbname="nazione.iso3166_1" dbalias=".iso3166_1" )
 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"nazione~" )  TABLE(NAME=~"valuta~" )  TABLE(NAME=~"lingua~" ) COLUMN(NAME=~"nazione.id_nazione~") COLUMN(NAME=~"nazione.codice~") COLUMN(NAME=~"nazione.descrizione~") COLUMN(NAME=~"valuta.codice~") COLUMN(NAME=~"valuta.descrizione~") COLUMN(NAME=~"lingua.codice~") COLUMN(NAME=~"lingua.descrizione~") COLUMN(NAME=~"nazione.prov_contabile~") COLUMN(NAME=~"nazione.id_valuta~") COLUMN(NAME=~"nazione.id_lingua~") COLUMN(NAME=~"nazione.cod_territorio~") COLUMN(NAME=~"nazione.alpha_2~") COLUMN(NAME=~"nazione.alpha_3~") COLUMN(NAME=~"nazione.iso3166_1~")    JOIN (LEFT=~"valuta.id_valuta~"    OP =~"=~"RIGHT=~"nazione.id_valuta~" )    JOIN (LEFT=~"lingua.id_lingua~"    OP =~"=~"RIGHT=~"nazione.id_lingua~" )) ORDER(NAME=~"nazione.codice~" ASC=yes ) " update="nazione" updatewhere=1 updatekeyinplace=yes )
