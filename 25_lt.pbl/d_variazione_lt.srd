table(column=(type=char(4) updatewhereclause=yes name=listino_codice dbname="listino.codice" )
 column=(type=date updatewhereclause=yes name=variazione_data_inizio dbname="variazione.data_inizio" )
 column=(type=date updatewhereclause=yes name=variazione_data_fine dbname="variazione.data_fine" )
 column=(type=decimal(4) updatewhereclause=yes name=variazione_cambio dbname="variazione.cambio" validation=" real(gettext())  >= 0" validationmsg="'Immettere un valore >= 0'" )
 column=(type=long updatewhereclause=yes name=listino_id_listino dbname="listino.id_listino" )
 column=(type=long updatewhereclause=yes name=variazione_id_variazione dbname="variazione.id_variazione" )
 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"listino~" )  TABLE(NAME=~"variazione~" ) COLUMN(NAME=~"listino.codice~") COLUMN(NAME=~"variazione.data_inizio~") COLUMN(NAME=~"variazione.data_fine~") COLUMN(NAME=~"variazione.cambio~") COLUMN(NAME=~"listino.id_listino~") COLUMN(NAME=~"variazione.id_variazione~")    JOIN (LEFT=~"variazione.id_listino~"    OP =~"=~"RIGHT=~"listino.id_listino~" )WHERE(    EXP1 =~"~~~"listino~~~".~~~"id_azienda~~~"~"   OP =~"in~"    EXP2 =~"(0, 1)~" ) ) " )
