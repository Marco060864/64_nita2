table(column=(type=char(5) updatewhereclause=yes name=banca_appoggio_cod_abi dbname="banca_appoggio.cod_abi" validation="match( gettext() , ~"[0-9][0-9][0-9][0-9][0-9]~")" validationmsg="'Immettere cinque cifre'" )
 column=(type=char(5) updatewhereclause=yes name=banca_appoggio_cod_cab dbname="banca_appoggio.cod_cab" validation="match( gettext() , ~"[0-9][0-9][0-9][0-9][0-9]~")" validationmsg="'Immettere cinque cifre'" )
 column=(type=char(40) updatewhereclause=yes name=banca_appoggio_den_abi dbname="banca_appoggio.den_abi" )
 column=(type=char(40) updatewhereclause=yes name=banca_appoggio_den_cab dbname="banca_appoggio.den_cab" )
 column=(type=char(20) update=yes updatewhereclause=yes name=banca_azienda_conto_corrente dbname="banca_azienda.conto_corrente" )
 column=(type=char(8) updatewhereclause=yes name=conto_codice dbname="conto.codice" )
 column=(type=char(40) updatewhereclause=yes name=conto_descrizione dbname="conto.descrizione" )
 column=(type=long update=yes updatewhereclause=yes key=yes identity=yes name=id_banca_azienda dbname="banca_azienda.id_banca_azienda" )
 column=(type=long update=yes updatewhereclause=yes name=banca_azienda_id_banca_appoggio dbname="banca_azienda.id_banca_appoggio" )
 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"banca_appoggio~" )  TABLE(NAME=~"banca_azienda~" )  TABLE(NAME=~"conto~" ) COLUMN(NAME=~"banca_appoggio.cod_abi~") COLUMN(NAME=~"banca_appoggio.cod_cab~") COLUMN(NAME=~"banca_appoggio.den_abi~") COLUMN(NAME=~"banca_appoggio.den_cab~") COLUMN(NAME=~"banca_azienda.conto_corrente~") COLUMN(NAME=~"conto.codice~") COLUMN(NAME=~"conto.descrizione~") COLUMN(NAME=~"banca_azienda.id_banca_azienda~") COLUMN(NAME=~"banca_azienda.id_banca_appoggio~")    JOIN (LEFT=~"conto.id_conto~"    OP =~"=~"RIGHT=~"banca_azienda.id_conto~"    OUTER2 =~"banca_azienda.id_conto~" )    JOIN (LEFT=~"banca_azienda.id_banca_appoggio~"    OP =~"=~"RIGHT=~"banca_appoggio.id_banca_appoggio~" )WHERE(    EXP1 =~"~~~"banca_azienda~~~".~~~"id_azienda~~~"~"   OP =~"in~"    EXP2 =~"(0, 1)~" ) ) ORDER(NAME=~"banca_appoggio.cod_abi~" ASC=yes )  ORDER(NAME=~"banca_appoggio.cod_cab~" ASC=yes )  ORDER(NAME=~"banca_azienda.conto_corrente~" ASC=yes ) " update="banca_azienda" updatewhere=1 updatekeyinplace=yes  sort="banca_appoggio_cod_abi A banca_appoggio_cod_cab A " )
