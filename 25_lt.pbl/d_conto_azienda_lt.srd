//objectcomments datawindow (grid) provvisoria per la gestione della tabella Conto sotto forma di elenco/finestra di ricerca
release 9;
datawindow(units=0 timer_interval=0 color=79741120 processing=1 HTMLDW=no print.printername="" print.documentname="" print.orientation = 0 print.margin.left = 110 print.margin.right = 110 print.margin.top = 97 print.margin.bottom = 97 print.paper.source = 0 print.paper.size = 0 print.canusedefaultprinter=yes print.prompt=no print.buttons=no print.preview.buttons=no print.cliptext=no print.overrideprintjob=no print.collate=yes hidegrayline=no grid.lines=0 selected.mouse=no )
header(height=138 color="536870912" )
summary(height=0 color="536870912" )
footer(height=0 color="536870912" )
detail(height=74 color="553648127" )
table(column=(type=char(8) update=yes updatewhereclause=yes name=conto_codice dbname="conto_azienda.codice" )
 column=(type=char(40) update=yes updatewhereclause=yes name=conto_descrizione dbname="conto_azienda.descrizione" )
 column=(type=char(2) updatewhereclause=yes name=mastro_codice dbname="mastro.codice" )
 column=(type=char(40) updatewhereclause=yes name=mastro_descrizione dbname="mastro.descrizione" )
 column=(type=char(2) updatewhereclause=yes name=sottomastro_codice dbname="sottomastro.codice" )
 column=(type=char(40) updatewhereclause=yes name=sottomastro_descrizione dbname="sottomastro.descrizione" )
 column=(type=char(1) update=yes updatewhereclause=yes name=conto_ges_par_aperte dbname="conto_azienda.ges_par_aperte" values="	S/	N" validation=" gettext()  = 'S' OR  gettext()  = 'N'" validationmsg="'Immettere: S, N'" )
 column=(type=long update=yes updatewhereclause=yes identity=yes name=conto_id_conto dbname="conto_azienda.id_conto" )
 column=(type=long updatewhereclause=yes identity=yes name=id_sog_commerciale dbname="sog_commerciale.id_sog_commerciale" )
 column=(type=char(1) updatewhereclause=yes name=sottomastro_uso dbname="sottomastro.uso" initial="G" values="Clienti	C/Fornitori	F/Banche	B/Generico	G/" validation=" gettext()  = 'C' OR  gettext()  = 'F' OR  gettext()  = 'B' OR  gettext()  = 'G'" validationmsg="'Immettere: C, F, B, G'" )
 column=(type=long updatewhereclause=yes name=id_anagrafica dbname="sog_commerciale.id_anagrafica" )
 column=(type=char(16) updatewhereclause=yes name=anagrafica_par_iva dbname="anagrafica.par_iva" )
 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"conto_azienda~" )  TABLE(NAME=~"sog_commerciale~" )  TABLE(NAME=~"mastro~" )  TABLE(NAME=~"sottomastro~" )  TABLE(NAME=~"anagrafica~" ) COLUMN(NAME=~"conto_azienda.codice~") COLUMN(NAME=~"conto_azienda.descrizione~") COLUMN(NAME=~"mastro.codice~") COLUMN(NAME=~"mastro.descrizione~") COLUMN(NAME=~"sottomastro.codice~") COLUMN(NAME=~"sottomastro.descrizione~") COLUMN(NAME=~"conto_azienda.ges_par_aperte~") COLUMN(NAME=~"conto_azienda.id_conto~") COLUMN(NAME=~"sog_commerciale.id_sog_commerciale~") COLUMN(NAME=~"sottomastro.uso~") COLUMN(NAME=~"sog_commerciale.id_anagrafica~") COLUMN(NAME=~"anagrafica.par_iva~")    JOIN (LEFT=~"conto_azienda.id_conto~"    OP =~"=~"RIGHT=~"sog_commerciale.id_conto~"    OUTER1 =~"conto_azienda.id_conto~" )    JOIN (LEFT=~"anagrafica.id_anagrafica~"    OP =~"=~"RIGHT=~"sog_commerciale.id_anagrafica~"    OUTER2 =~"sog_commerciale.id_anagrafica~" )   JOIN (LEFT=~"sottomastro.id_mastro~"    OP =~"=~"RIGHT=~"mastro.id_mastro~" )    JOIN (LEFT=~"sottomastro.id_sottomastro~"    OP =~"=~"RIGHT=~"conto_azienda.id_sottomastro~" ) WHERE(    EXP1 =~"( ( ~~~"conto_azienda~~~".~~~"id_azienda~~~"~"   OP =~"in~"    EXP2 =~"(0,1) ) )~" ) ) ORDER(NAME=~"conto_azienda.codice~" ASC=yes ) " )
