table(column=(type=long update=yes updatewhereclause=yes identity=yes name=mod_registro_id_mod_registro dbname="mod_registro.id_mod_registro" )
 column=(type=decimal(0) update=yes updatewhereclause=yes key=yes name=mod_registro_numero dbname="mod_registro.numero" validation=" real(gettext())  >= 0" validationmsg="'Immettere un valore >= 0'" )
 column=(type=char(40) update=yes updatewhereclause=yes name=mod_registro_descrizione dbname="mod_registro.descrizione" )
 column=(type=char(1) update=yes updatewhereclause=yes name=mod_registro_usa_prorata dbname="mod_registro.usa_prorata" initial="N" values="	S/	N" validation=" gettext()  = 'S' OR  gettext()  = 'N'" validationmsg="'Immettere: S, N'" )
 column=(type=char(1) update=yes updatewhereclause=yes name=mod_registro_iva_sospensione dbname="mod_registro.iva_sospensione" initial="N" values="	S/	N" validation=" gettext()  = 'S' OR  gettext()  = 'N'" validationmsg="'Immettere: S, N'" )
 column=(type=long update=yes updatewhereclause=yes key=yes name=mod_registro_id_azienda dbname="mod_registro.id_azienda" initial="1" )
 column=(type=char(2) update=yes updatewhereclause=yes key=yes name=mod_registro_tipo_registro dbname="mod_registro.tipo_registro" values="IVA acquisti	IA/IVA vendite	IV/IVA corrispettivi	IC/Manageriale	MN/Prima nota	PN/Preventivi acquisti	PA/Preventivi vendite	PV/Ordini acquisti	OA/Ordini vendite	OV/DDT acquisti	DA/DDT vendite	DV/Liste prelievo acquisti	LA/Liste prelievo vendite	LV/Generico acquisti	GA/Generico vendite	GV/" validation=" gettext()  = 'IA' OR  gettext()  = 'IV' OR  gettext()  = 'IC' OR  gettext()  = 'MN' OR  gettext()  = 'PN' OR  gettext()  = 'PA' OR  gettext()  = 'PV' OR  gettext()  = 'OA' OR  gettext()  = 'OV' OR  gettext()  = 'DA' OR  gettext()  = 'DV' OR  gettext()  = 'LA' OR  gettext()  = 'LV' OR  gettext()  = 'GA' OR  gettext()  = 'GV'" validationmsg="'Immettere: IA, IV, MN, PN, OA, OP, DA, DV, LA, LP, GA, GV'" )
 column=(type=long update=yes updatewhereclause=yes name=id_attivita dbname="mod_registro.id_attivita" )
 column=(type=char(1) update=yes updatewhereclause=yes name=ges_sco_giornaliero dbname="mod_registro.ges_sco_giornaliero" initial="N" values="	S/	N" validation=" gettext()  = 'S' OR  gettext()  = 'N'" validationmsg="'Immettere: S, N'" )
 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"mod_registro~" ) COLUMN(NAME=~"mod_registro.id_mod_registro~") COLUMN(NAME=~"mod_registro.numero~") COLUMN(NAME=~"mod_registro.descrizione~") COLUMN(NAME=~"mod_registro.usa_prorata~") COLUMN(NAME=~"mod_registro.iva_sospensione~") COLUMN(NAME=~"mod_registro.id_azienda~") COLUMN(NAME=~"mod_registro.tipo_registro~") COLUMN(NAME=~"mod_registro.id_attivita~") COLUMN(NAME=~"mod_registro.ges_sco_giornaliero~")WHERE(    EXP1 =~"( ( ~~~"mod_registro~~~".~~~"id_azienda~~~"~"   OP =~"in~"    EXP2 =~"(0,1) ) )~" ) ) ORDER(NAME=~"mod_registro.numero~" ASC=yes ) " update="mod_registro" updatewhere=1 updatekeyinplace=yes )
