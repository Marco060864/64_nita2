table(column=(type=long updatewhereclause=yes identity=yes name=documento_id_documento dbname="documento.id_documento" )
 column=(type=char(2) updatewhereclause=yes name=registro_tipo_registro dbname="registro.tipo_registro" values="IVA acquisti	IA/IVA vendite	IV/IVA corrispettivi	IC/Manageriale	MN/Prima nota	PN/Preventivi acquisti	PA/Preventivi vendite	PV/Ordini acquisti	OA/Ordini vendite	OV/DDT acquisti	DA/DDT vendite	DV/Liste prelievo acquisti	LA/Liste prelievo vendite	LV/Generico acquisti	GA/Generico vendite	GV/" validation=" gettext()  = 'IA' OR  gettext()  = 'IV' OR  gettext()  = 'IC' OR  gettext()  = 'MN' OR  gettext()  = 'PN' OR  gettext()  = 'PA' OR  gettext()  = 'PV' OR  gettext()  = 'OA' OR  gettext()  = 'OV' OR  gettext()  = 'DA' OR  gettext()  = 'DV' OR  gettext()  = 'LA' OR  gettext()  = 'LV' OR  gettext()  = 'GA' OR  gettext()  = 'GV'" validationmsg="'Immettere: IA, IV, MN, PN, OA, OP, DA, DV, LA, LP, GA, GV'" )
 column=(type=decimal(0) updatewhereclause=yes name=documento_num_progressivo dbname="documento.num_progressivo" )
 column=(type=date updatewhereclause=yes name=documento_data_registrazione dbname="documento.data_registrazione" )
 column=(type=decimal(0) updatewhereclause=yes name=registro_numero dbname="registro.numero" validation=" real(gettext())  >= 0" validationmsg="'Immettere un valore >= 0'" )
 column=(type=char(51) updatewhereclause=yes name=cc_descrizione dbname="c_descrizione" )
 column=(type=char(1) updatewhereclause=yes name=prof_documento_contabilizzabile dbname="prof_documento.contabilizzabile" initial="N" values="	S/	N" validation=" gettext()  = 'S' OR  gettext()  = 'N'" validationmsg="'Immettere: S, N'" )
 column=(type=char(38) updatewhereclause=yes name=cc_filtro_4 dbname="c_filtro_4" )
 column=(type=char(17) updatewhereclause=yes name=cc_filtro_2 dbname="c_filtro_2" )
 column=(type=char(33) updatewhereclause=yes name=cc_filtro_3 dbname="c_filtro_3" )
 column=(type=char(23) updatewhereclause=yes name=cc_filtro_1 dbname="c_filtro_1" )
 column=(type=char(8) updatewhereclause=yes name=sog_commerciale_gen_codice dbname="sog_commerciale_gen.codice" )
 column=(type=char(40) updatewhereclause=yes name=sog_commerciale_gen_rag_soc_1 dbname="sog_commerciale_gen.rag_soc_1" )
 column=(type=long updatewhereclause=yes identity=yes name=sog_commerciale_gen_id_sog_commerciale dbname="sog_commerciale_gen.id_sog_commerciale" )
 column=(type=char(40) updatewhereclause=yes name=registro_descrizione dbname="registro.descrizione" )
 column=(type=date updatewhereclause=yes name=documento_data_documento dbname="documento.data_documento" )
 column=(type=char(16) updatewhereclause=yes name=documento_num_documento dbname="documento.num_documento" )
 column=(type=date updatewhereclause=yes name=documento_data_competenza dbname="documento.data_competenza" )
 column=(type=char(8) updatewhereclause=yes name=prof_documento_codice dbname="prof_documento.codice" )
 column=(type=long updatewhereclause=yes identity=yes name=id_registro dbname="registro.id_registro" )
 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"documento~" )  TABLE(NAME=~"registro~" )  TABLE(NAME=~"prof_documento~" )  TABLE(NAME=~"sog_commerciale_gen~" ) COLUMN(NAME=~"documento.id_documento~") COLUMN(NAME=~"registro.tipo_registro~") COLUMN(NAME=~"documento.num_progressivo~") COLUMN(NAME=~"documento.data_registrazione~") COLUMN(NAME=~"registro.numero~") COMPUTE(NAME=~"~~~"registro~~~".~~~"tipo_registro~~~" + ' Nr. ' + Cast(~~~"registro~~~".~~~"numero~~~" as Char(8)) + ' - Nr.Progr. ' +  Cast(~~~"documento~~~".~~~"num_progressivo~~~" as Char(8)) + ' del ' + Cast(~~~"documento~~~".~~~"data_registrazione~~~" as Char(10))  as c_descrizione~") COLUMN(NAME=~"prof_documento.contabilizzabile~") COMPUTE(NAME=~"~~~"registro~~~".~~~"tipo_registro~~~" + ' - Nr.Progr. ' +  Cast(~~~"documento~~~".~~~"num_progressivo~~~" as Char(8)) + ' del ' + Cast(~~~"documento~~~".~~~"data_registrazione~~~" as Char(10))  as c_filtro_4~") COMPUTE(NAME=~"~~~"registro~~~".~~~"tipo_registro~~~"   + ' del ' + Cast(~~~"documento~~~".~~~"data_registrazione~~~" as Char(10))  as c_filtro_2~") COMPUTE(NAME=~" 'Nr.Progr. ' +  Cast(~~~"documento~~~".~~~"num_progressivo~~~" as Char(8)) + ' del ' + Cast(~~~"documento~~~".~~~"data_registrazione~~~" as Char(10))  as c_filtro_3~") COMPUTE(NAME=~"~~~"registro~~~".~~~"tipo_registro~~~"  +  ' - Nr.Progr. ' +  Cast(~~~"documento~~~".~~~"num_progressivo~~~" as Char(8))  as c_filtro_1~") COLUMN(NAME=~"sog_commerciale_gen.codice~") COLUMN(NAME=~"sog_commerciale_gen.rag_soc_1~") COLUMN(NAME=~"sog_commerciale_gen.id_sog_commerciale~") COLUMN(NAME=~"registro.descrizione~") COLUMN(NAME=~"documento.data_documento~") COLUMN(NAME=~"documento.num_documento~") COLUMN(NAME=~"documento.data_competenza~") COLUMN(NAME=~"prof_documento.codice~") COLUMN(NAME=~"registro.id_registro~")    JOIN (LEFT=~"registro.id_registro~"    OP =~"=~"RIGHT=~"documento.id_registro~" )    JOIN (LEFT=~"prof_documento.id_prof_documento~"    OP =~"=~"RIGHT=~"documento.id_prof_documento~" )    JOIN (LEFT=~"sog_commerciale_gen.id_sog_commerciale~"    OP =~"=~"RIGHT=~"documento.id_sog_commerciale~" )WHERE(    EXP1 =~"(~~~"documento~~~".~~~"id_azienda~~~"~"   OP =~"in~"    EXP2 =~"(0,1))~" ) ) ORDER(NAME=~"prof_documento.codice~" ASC=yes )  ORDER(NAME=~"registro.tipo_registro~" ASC=yes )  ORDER(NAME=~"documento.data_documento~" ASC=yes )  ORDER(NAME=~"documento.num_documento~" ASC=yes ) "  sort="prof_documento_codice A registro_tipo_registro A documento_data_registrazione D documento_num_progressivo D documento_data_documento D documento_num_documento D " )
