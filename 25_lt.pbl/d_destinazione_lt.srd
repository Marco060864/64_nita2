 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"destinazione~" )  TABLE(NAME=~"sog_commerciale~" ) COLUMN(NAME=~"destinazione.id_sog_commerciale~") COLUMN(NAME=~"destinazione.codice~") COLUMN(NAME=~"destinazione.id_destinazione~") COLUMN(NAME=~"destinazione.rag_soc_1~") COLUMN(NAME=~"destinazione.provincia~") COLUMN(NAME=~"destinazione.nazione~") COLUMN(NAME=~"destinazione.tipo_destinazione~") COLUMN(NAME=~"destinazione.id_azienda~") COLUMN(NAME=~"destinazione.indirizzo~") COLUMN(NAME=~"destinazione.cap~") COLUMN(NAME=~"destinazione.localita~") COLUMN(NAME=~"sog_commerciale.id_anagrafica~")    JOIN (LEFT=~"sog_commerciale.id_sog_commerciale~"    OP =~"=~"RIGHT=~"destinazione.id_sog_commerciale~" )) "  sort="codice A " )
