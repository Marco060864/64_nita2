//objectcomments MM DW di ricerca dove ho aggiunto l'articolo accanto all'unita_confezione
release 5;
datawindow(units=0 timer_interval=0 color=79741120 processing=1 print.documentname="" print.orientation = 0 print.margin.left = 110 print.margin.right = 110 print.margin.top = 97 print.margin.bottom = 97 print.paper.source = 0 print.paper.size = 0 print.prompt=no grid.lines=0 selected.mouse=no )
header(height=121 color="536870912" )
summary(height=9 color="536870912" )
footer(height=9 color="536870912" )
detail(height=73 color="553648127" )
table(column=(type=long update=yes updatewhereclause=yes identity=yes name=id_unita_confezione dbname="unita_confezione.id_unita_confezione" )
 column=(type=char(8) update=yes updatewhereclause=yes name=unita_confezione_codice dbname="unita_confezione.codice" )
 column=(type=char(40) update=yes updatewhereclause=yes name=unita_confezione_descrizione dbname="unita_confezione.descrizione" )
 column=(type=char(1) update=yes updatewhereclause=yes name=unita_confezione_app_conversione dbname="unita_confezione.app_conversione" initial="F" values="Fattore Fisso	F/Fattore Variabile	V/Dalla Quantità	Q/" validation=" gettext()  = 'F' OR  gettext()  = 'V' OR  gettext()  = 'Q'" validationmsg="'Immettere: F, V, Q'" )
 column=(type=decimal(4) update=yes updatewhereclause=yes name=unita_confezione_fat_conversione dbname="unita_confezione.fat_conversione" validation=" real(gettext())  >= 0" validationmsg="'Immettere un valore >= 0'" )
 column=(type=char(1) update=yes updatewhereclause=yes name=unita_confezione_tipo_conversione dbname="unita_confezione.tipo_conversione" initial="M" values="Moltiplicazione	M/Divisione	D/" validation=" gettext()  = 'M' OR  gettext()  = 'D'" validationmsg="'Immettere: M, D'" )
 column=(type=decimal(4) update=yes updatewhereclause=yes name=unita_confezione_molteplicita dbname="unita_confezione.molteplicita" validation=" real(gettext())  >= 0" validationmsg="'Immettere un valore >= 0'" )
 column=(type=decimal(4) update=yes updatewhereclause=yes name=unita_confezione_qta_minima dbname="unita_confezione.qta_minima" validation=" real(gettext())  >= 0" validationmsg="'Immettere un valore >= 0'" )
 column=(type=decimal(4) update=yes updatewhereclause=yes name=unita_confezione_qta_massima dbname="unita_confezione.qta_massima" validation=" real(gettext())  >= 0" validationmsg="'Immettere un valore >= 0'" )
 column=(type=long updatewhereclause=yes name=unita_confezione_id_unita_mis_peso dbname="unita_confezione.id_unita_mis_peso" )
 column=(type=decimal(4) update=yes updatewhereclause=yes name=unita_confezione_peso_netto dbname="unita_confezione.peso_netto" validation=" real(gettext())  >= 0" validationmsg="'Immettere un valore >= 0'" )
 column=(type=decimal(4) update=yes updatewhereclause=yes name=unita_confezione_peso_lordo dbname="unita_confezione.peso_lordo" validation=" real(gettext())  >= 0" validationmsg="'Immettere un valore >= 0'" )
 column=(type=long updatewhereclause=yes name=unita_confezione_id_unita_mis_volume dbname="unita_confezione.id_unita_mis_volume" )
 column=(type=decimal(4) update=yes updatewhereclause=yes name=unita_confezione_dim_l dbname="unita_confezione.dim_l" validation=" real(gettext())  >= 0" validationmsg="'Immettere un valore >= 0'" )
 column=(type=decimal(4) update=yes updatewhereclause=yes name=unita_confezione_dim_h dbname="unita_confezione.dim_h" validation=" real(gettext())  >= 0" validationmsg="'Immettere un valore >= 0'" )
 column=(type=decimal(4) update=yes updatewhereclause=yes name=unita_confezione_dim_p dbname="unita_confezione.dim_p" validation=" real(gettext())  >= 0" validationmsg="'Immettere un valore >= 0'" )
 column=(type=char(1) update=yes updatewhereclause=yes name=unita_confezione_unita_base dbname="unita_confezione.unita_base" values="	S/	N" validation=" gettext()  = 'S' OR  gettext()  = 'N'" validationmsg="'Immettere: S, N'" )
 column=(type=char(1) update=yes updatewhereclause=yes name=unita_confezione_unita_prezzo dbname="unita_confezione.unita_prezzo" values="	S/	N" validation=" gettext()  = 'S' OR  gettext()  = 'N'" validationmsg="'Immettere: S, N'" )
 column=(type=char(1) update=yes updatewhereclause=yes name=unita_confezione_unita_documenti dbname="unita_confezione.unita_documenti" values="	S/	N" validation=" gettext()  = 'S' OR  gettext()  = 'N'" validationmsg="'Immettere: S, N'" )
 column=(type=char(1) update=yes updatewhereclause=yes name=unita_confezione_unita_produzione dbname="unita_confezione.unita_produzione" values="	S/	N" validation=" gettext()  = 'S' OR  gettext()  = 'N'" validationmsg="'Immettere: S, N'" )
 column=(type=long update=yes updatewhereclause=yes name=unita_confezione_id_azienda dbname="unita_confezione.id_azienda" initial="1" )
 column=(type=char(80) updatewhereclause=yes name=unita_misura_descrizione dbname="articolo.descrizione" )
 column=(type=char(32) updatewhereclause=yes name=articolo_codice dbname="articolo.codice" )
 column=(type=long updatewhereclause=yes name=cid_unita_misura dbname="unita_confezione.id_unita_misura" )
 column=(type=char(5) updatewhereclause=yes name=unita_misura_simbolo dbname="unita_misura.simbolo" )
 column=(type=char(40) updatewhereclause=yes name=unita_misura_descrizione dbname="unita_misura.descrizione" )
 column=(type=char(5) updatewhereclause=yes name=unita_misura_b_simbolo dbname="unita_misura.simbolo" )
 column=(type=char(40) updatewhereclause=yes name=unita_misura_b_descrizione dbname="unita_misura.descrizione" )
 column=(type=char(5) updatewhereclause=yes name=unita_misura_c_simbolo dbname="unita_misura.simbolo" )
 column=(type=char(40) updatewhereclause=yes name=unita_misura_c_descrizione dbname="unita_misura.descrizione" )
 column=(type=decimal(0) updatewhereclause=yes name=unita_confezione_num_colli dbname="unita_confezione.num_colli" )
 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"unita_confezione~" )  TABLE(NAME=~"articolo~" )  TABLE(NAME=~"unita_misura~" ALIAS=~"unita_misura_a~" )  TABLE(NAME=~"unita_misura~" ALIAS=~"unita_misura_b~" )  TABLE(NAME=~"unita_misura~" ALIAS=~"unita_misura_c~" ) COLUMN(NAME=~"unita_confezione.id_unita_confezione~") COLUMN(NAME=~"unita_confezione.codice~") COLUMN(NAME=~"unita_confezione.descrizione~") COLUMN(NAME=~"unita_confezione.app_conversione~") COLUMN(NAME=~"unita_confezione.fat_conversione~") COLUMN(NAME=~"unita_confezione.tipo_conversione~") COLUMN(NAME=~"unita_confezione.molteplicita~") COLUMN(NAME=~"unita_confezione.qta_minima~") COLUMN(NAME=~"unita_confezione.qta_massima~") COLUMN(NAME=~"unita_confezione.id_unita_mis_peso~") COLUMN(NAME=~"unita_confezione.peso_netto~") COLUMN(NAME=~"unita_confezione.peso_lordo~") COLUMN(NAME=~"unita_confezione.id_unita_mis_volume~") COLUMN(NAME=~"unita_confezione.dim_l~") COLUMN(NAME=~"unita_confezione.dim_h~") COLUMN(NAME=~"unita_confezione.dim_p~") COLUMN(NAME=~"unita_confezione.unita_base~") COLUMN(NAME=~"unita_confezione.unita_prezzo~") COLUMN(NAME=~"unita_confezione.unita_documenti~") COLUMN(NAME=~"unita_confezione.unita_produzione~") COLUMN(NAME=~"unita_confezione.id_azienda~") COLUMN(NAME=~"articolo.descrizione~") COLUMN(NAME=~"articolo.codice~") COLUMN(NAME=~"unita_confezione.id_unita_misura~") COLUMN(NAME=~"unita_misura_a.simbolo~") COLUMN(NAME=~"unita_misura_a.descrizione~") COLUMN(NAME=~"unita_misura_b.simbolo~") COLUMN(NAME=~"unita_misura_b.descrizione~") COLUMN(NAME=~"unita_misura_c.simbolo~") COLUMN(NAME=~"unita_misura_c.descrizione~") COLUMN(NAME=~"unita_confezione.num_colli~")    JOIN (LEFT=~"unita_misura_a.id_unita_misura~"    OP =~"=~"RIGHT=~"unita_confezione.id_unita_misura~"    OUTER2 =~"unita_confezione.id_unita_misura~" )    JOIN (LEFT=~"unita_misura_b.id_unita_misura~"    OP =~"=~"RIGHT=~"unita_confezione.id_unita_mis_peso~"    OUTER2 =~"unita_confezione.id_unita_mis_peso~" )    JOIN (LEFT=~"unita_misura_c.id_unita_misura~"    OP =~"=~"RIGHT=~"unita_confezione.id_unita_mis_volume~"    OUTER2 =~"unita_confezione.id_unita_mis_volume~" )    JOIN (LEFT=~"articolo.id_articolo~"    OP =~"=~"RIGHT=~"unita_confezione.id_articolo~" )WHERE(    EXP1 =~" ~~~"unita_confezione~~~".~~~"id_azienda~~~"~"   OP =~"in~"    EXP2 =~"(0,1) ~" ) ) " )
