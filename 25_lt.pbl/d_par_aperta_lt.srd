//objectcomments Usa Computed Field in SQL e Sort (Rows) ParAperte Cometa
release 5;
datawindow(units=0 timer_interval=0 color=79741120 processing=1 print.documentname="" print.orientation = 0 print.margin.left = 110 print.margin.right = 110 print.margin.top = 97 print.margin.bottom = 97 print.paper.source = 0 print.paper.size = 0 print.prompt=no grid.lines=0 selected.mouse=no )
header(height=137 color="536870912" )
summary(height=1 color="536870912" )
footer(height=1 color="536870912" )
detail(height=73 color="553648127" )
table(column=(type=char(8) updatewhereclause=yes name=conto_codice dbname="conto.codice" )
 column=(type=char(16) update=yes updatewhereclause=yes name=par_aperta_num_partita dbname="par_aperta.num_partita" )
 column=(type=date update=yes updatewhereclause=yes name=par_aperta_data_partita dbname="par_aperta.data_partita" )
 column=(type=decimal(0) update=yes updatewhereclause=yes name=par_aperta_importo dbname="par_aperta.importo" )
 column=(type=char(1) update=yes updatewhereclause=yes name=chiusa_forzatamente dbname="par_aperta.chiusa_forzatamente" values="	S/	N" validation=" gettext()  = 'S' OR  gettext()  = 'N'" validationmsg="'Immettere: S, N'" )
 column=(type=decimal(0) updatewhereclause=yes name=csommann dbname="sommann" )
 column=(type=decimal(0) updatewhereclause=yes name=csaldo dbname="saldo" )
 column=(type=decimal(0) updatewhereclause=yes name=csomma dbname="somma" )
 column=(type=long update=yes updatewhereclause=yes name=par_aperta_id_conto dbname="par_aperta.id_conto" )
 column=(type=long update=yes updatewhereclause=yes name=par_aperta_id_reg_pd dbname="par_aperta.id_reg_pd" )
 column=(type=long update=yes updatewhereclause=yes name=id_par_aperta dbname="par_aperta.id_par_aperta" )
 column=(type=char(40) updatewhereclause=yes name=conto_descrizione dbname="conto.descrizione" )
 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"par_aperta~" )  TABLE(NAME=~"mov_partita~" )  TABLE(NAME=~"conto~" ) COLUMN(NAME=~"conto.codice~") COLUMN(NAME=~"par_aperta.num_partita~") COLUMN(NAME=~"par_aperta.data_partita~") COLUMN(NAME=~"par_aperta.importo~") COLUMN(NAME=~"par_aperta.chiusa_forzatamente~") COMPUTE(NAME=~"(ifnull(Somma, 0, Somma)) as SommaNN~") COMPUTE(NAME=~"(~~~"par_aperta~~~".~~~"importo~~~" - SommaNN) as Saldo~") COMPUTE(NAME=~"(sum(~~~"mov_partita~~~".~~~"importo~~~")) as Somma~") COLUMN(NAME=~"par_aperta.id_conto~") COLUMN(NAME=~"par_aperta.id_reg_pd~") COLUMN(NAME=~"par_aperta.id_par_aperta~") COLUMN(NAME=~"conto.descrizione~")    JOIN (LEFT=~"par_aperta.id_par_aperta~"    OP =~"=~"RIGHT=~"mov_partita.id_par_aperta~"    OUTER1 =~"par_aperta.id_par_aperta~" )    JOIN (LEFT=~"conto.id_conto~"    OP =~"=~"RIGHT=~"par_aperta.id_conto~" )WHERE(    EXP1 =~" ( ~~~"par_aperta~~~".~~~"id_azienda~~~"~"   OP =~"in~"    EXP2 =~"(0,1) )~" )  GROUP(NAME=~"par_aperta.id_par_aperta~") GROUP(NAME=~"par_aperta.id_reg_pd~") GROUP(NAME=~"par_aperta.data_partita~") GROUP(NAME=~"conto.descrizione~") GROUP(NAME=~"par_aperta.id_conto~") GROUP(NAME=~"par_aperta.num_partita~") GROUP(NAME=~"par_aperta.importo~") GROUP(NAME=~"par_aperta.chiusa_forzatamente~") GROUP(NAME=~"conto.codice~")) ORDER(NAME=~"conto.codice~" ASC=yes ) " filter=" csaldo <> 0" )
text(band=header alignment="2" text="TotaleMovimenti"border="0" color="33554432" x="2126" y="8" height="113" width="362"  name=csommann_t  font.face="Arial" font.height="-8" font.weight="400"  font.family="2" font.pitch="2" font.charset="0" background.mode="1" background.color="553648127" )
