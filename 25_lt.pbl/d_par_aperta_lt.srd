column(band=detail id=4 alignment="1" tabsequence=32766 border="0" color="33554432" x="1404" y="4" height="65" width="343" format="#,0"  name=par_aperta_importo edit.name="es_Importo" edit.limit=14 edit.case=any edit.format="#,0 " edit.autoselect=yes edit.nilisnull=yes  font.face="Arial" font.height="-8" font.weight="400"  font.family="2" font.pitch="2" font.charset="0" background.mode="2" background.color="1090519039" )
