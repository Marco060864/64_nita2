text(band=header alignment="2" text="Saldo"border="0" color="33554432" x="1756" y="8" height="57" width="362"  name=csaldo_t  font.face="Arial" font.height="-8" font.weight="700"  font.family="2" font.pitch="2" font.charset="0" background.mode="1" background.color="553648127" )
column(band=detail id=7 alignment="1" tabsequence=32766 border="0" color="33554432" x="1756" y="4" height="65" width="362" format="#,0"  name=csaldo edit.limit=0 edit.case=any edit.autoselect=yes  font.face="Arial" font.height="-8" font.weight="700"  font.family="2" font.pitch="2" font.charset="0" background.mode="0" background.color="1087955144~tif( (chiusa_forzatamente = 'S') OR ( csaldo = 0), RGB(192,192,192), RGB(255,255,255) )" )

