release 5;
datawindow(units=0 timer_interval=0 color=79741120 processing=1 print.documentname="" print.orientation = 0 print.margin.left = 110 print.margin.right = 110 print.margin.top = 97 print.margin.bottom = 97 print.paper.source = 0 print.paper.size = 0 print.prompt=no grid.lines=0 selected.mouse=no )
header(height=77 color="536870912" )
summary(height=1 color="536870912" )
footer(height=17 color="536870912" )
detail(height=73 color="553648127" )
table(column=(type=long updatewhereclause=yes identity=yes name=documento_id_documento dbname="documento.id_documento" )
 column=(type=char(2) updatewhereclause=yes name=registro_tipo_registro dbname="registro.tipo_registro" values="IVA acquisti	IA/IVA vendite	IV/IVA corrispettivi	IC/Manageriale	MN/Prima nota	PN/Preventivi acquisti	PA/Preventivi vendite	PV/Ordini acquisti	OA/Ordini vendite	OV/DDT acquisti	DA/DDT vendite	DV/Liste prelievo acquisti	LA/Liste prelievo vendite	LV/Generico acquisti	GA/Generico vendite	GV/" validation=" gettext()  = 'IA' OR  gettext()  = 'IV' OR  gettext()  = 'IC' OR  gettext()  = 'MN' OR  gettext()  = 'PN' OR  gettext()  = 'PA' OR  gettext()  = 'PV' OR  gettext()  = 'OA' OR  gettext()  = 'OV' OR  gettext()  = 'DA' OR  gettext()  = 'DV' OR  gettext()  = 'LA' OR  gettext()  = 'LV' OR  gettext()  = 'GA' OR  gettext()  = 'GV'" validationmsg="'Immettere: IA, IV, MN, PN, OA, OP, DA, DV, LA, LP, GA, GV'" )
 column=(type=decimal(0) updatewhereclause=yes name=documento_num_progressivo dbname="documento.num_progressivo" )
 column=(type=date updatewhereclause=yes name=documento_data_registrazione dbname="documento.data_registrazione" )
 column=(type=decimal(0) updatewhereclause=yes name=registro_numero dbname="registro.numero" validation=" real(gettext())  >= 0" validationmsg="'Immettere un valore >= 0'" )
 column=(type=char(1) updatewhereclause=yes name=prof_documento_contabilizzabile dbname="prof_documento.contabilizzabile" initial="N" values="	S/	N" validation=" gettext()  = 'S' OR  gettext()  = 'N'" validationmsg="'Immettere: S, N'" )
 column=(type=char(8) updatewhereclause=yes name=sog_commerciale_gen_codice dbname="sog_commerciale_gen.codice" )
 column=(type=char(40) updatewhereclause=yes name=sog_commerciale_gen_rag_soc_1 dbname="sog_commerciale_gen.rag_soc_1" )
 column=(type=long updatewhereclause=yes identity=yes name=sog_commerciale_gen_id_sog_commerciale dbname="sog_commerciale_gen.id_sog_commerciale" )
 column=(type=decimal(0) updatewhereclause=yes name=riga_documento_num_riga dbname="riga_documento.num_riga" )
 column=(type=char(76) updatewhereclause=yes name=cc_descrizione dbname="c_descrizione" )
 column=(type=long updatewhereclause=yes identity=yes name=riga_documento_id_riga_documento dbname="riga_documento.id_riga_documento" )
 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"documento~" )  TABLE(NAME=~"registro~" )  TABLE(NAME=~"prof_documento~" )  TABLE(NAME=~"sog_commerciale_gen~" )  TABLE(NAME=~"riga_documento~" ) COLUMN(NAME=~"documento.id_documento~") COLUMN(NAME=~"registro.tipo_registro~") COLUMN(NAME=~"documento.num_progressivo~") COLUMN(NAME=~"documento.data_registrazione~") COLUMN(NAME=~"registro.numero~") COLUMN(NAME=~"prof_documento.contabilizzabile~") COLUMN(NAME=~"sog_commerciale_gen.codice~") COLUMN(NAME=~"sog_commerciale_gen.rag_soc_1~") COLUMN(NAME=~"sog_commerciale_gen.id_sog_commerciale~") COLUMN(NAME=~"riga_documento.num_riga~") COMPUTE(NAME=~"'Riga Nr. ' +  Cast( ~~~"riga_documento~~~".~~~"num_riga~~~" as Char(8)) + ' - Reg. ' + ~~~"registro~~~".~~~"tipo_registro~~~" + ' Nr. ' + Cast(~~~"registro~~~".~~~"numero~~~" as Char(8)) + ' - Nr.Progr. ' +  Cast(~~~"documento~~~".~~~"num_progressivo~~~" as Char(8)) + ' del ' + Cast(~~~"documento~~~".~~~"data_registrazione~~~" as Char(10))  as c_descrizione~") COLUMN(NAME=~"riga_documento.id_riga_documento~")    JOIN (LEFT=~"registro.id_registro~"    OP =~"=~"RIGHT=~"documento.id_registro~" )    JOIN (LEFT=~"prof_documento.id_prof_documento~"    OP =~"=~"RIGHT=~"documento.id_prof_documento~" )    JOIN (LEFT=~"sog_commerciale_gen.id_sog_commerciale~"    OP =~"=~"RIGHT=~"documento.id_sog_commerciale~" )    JOIN (LEFT=~"riga_documento.id_documento~"    OP =~"=~"RIGHT=~"documento.id_documento~" )WHERE(    EXP1 =~"(~~~"documento~~~".~~~"id_azienda~~~"~"   OP =~"in~"    EXP2 =~"(0,1))~" ) ) ORDER(NAME=~"registro.tipo_registro~" ASC=yes )  ORDER(NAME=~"documento.data_registrazione~" ASC=no)  ORDER(NAME=~"documento.num_progressivo~" ASC=no) " )
