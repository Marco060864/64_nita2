table(column=(type=char(8) update=yes updatewhereclause=yes name=conto_codice dbname="conto_azienda.codice" )
 column=(type=char(40) update=yes updatewhereclause=yes name=conto_descrizione dbname="conto_azienda.descrizione" )
 column=(type=char(2) updatewhereclause=yes name=mastro_codice dbname="mastro.codice" )
 column=(type=char(40) updatewhereclause=yes name=mastro_descrizione dbname="mastro.descrizione" )
 column=(type=char(2) updatewhereclause=yes name=sottomastro_codice dbname="sottomastro.codice" )
 column=(type=char(40) updatewhereclause=yes name=sottomastro_descrizione dbname="sottomastro.descrizione" )
 column=(type=char(1) update=yes updatewhereclause=yes name=conto_ges_par_aperte dbname="conto_azienda.ges_par_aperte" values="	S/	N" validation=" gettext()  = 'S' OR  gettext()  = 'N'" validationmsg="'Immettere: S, N'" )
 column=(type=long update=yes updatewhereclause=yes identity=yes name=id_conto dbname="conto_azienda.id_conto" )
 column=(type=long updatewhereclause=yes identity=yes name=id_sog_commerciale dbname="sog_commerciale.id_sog_commerciale" )
 column=(type=char(1) updatewhereclause=yes name=sottomastro_uso dbname="sottomastro.uso" initial="G" values="Clienti	C/Fornitori	F/Banche	B/Generico	G/" validation=" gettext()  = 'C' OR  gettext()  = 'F' OR  gettext()  = 'B' OR  gettext()  = 'G'" validationmsg="'Immettere: C, F, B, G'" )
 column=(type=long updatewhereclause=yes name=id_anagrafica dbname="sog_commerciale.id_anagrafica" )
 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"conto_azienda~" )  TABLE(NAME=~"sog_commerciale~" )  TABLE(NAME=~"mastro~" )  TABLE(NAME=~"sottomastro~" ) COLUMN(NAME=~"conto_azienda.codice~") COLUMN(NAME=~"conto_azienda.descrizione~") COLUMN(NAME=~"mastro.codice~") COLUMN(NAME=~"mastro.descrizione~") COLUMN(NAME=~"sottomastro.codice~") COLUMN(NAME=~"sottomastro.descrizione~") COLUMN(NAME=~"conto_azienda.ges_par_aperte~") COLUMN(NAME=~"conto_azienda.id_conto~") COLUMN(NAME=~"sog_commerciale.id_sog_commerciale~") COLUMN(NAME=~"sottomastro.uso~") COLUMN(NAME=~"sog_commerciale.id_anagrafica~")    JOIN (LEFT=~"conto_azienda.id_conto~"    OP =~"=~"RIGHT=~"sog_commerciale.id_conto~"    OUTER1 =~"conto_azienda.id_conto~" )    JOIN (LEFT=~"sottomastro.id_mastro~"    OP =~"=~"RIGHT=~"mastro.id_mastro~" )    JOIN (LEFT=~"sottomastro.id_sottomastro~"    OP =~"=~"RIGHT=~"conto_azienda.id_sottomastro~" )WHERE(    EXP1 =~"( ( ~~~"conto_azienda~~~".~~~"id_azienda~~~"~"   OP =~"in~"    EXP2 =~"(0,1) ) )~" ) ) ORDER(NAME=~"conto_azienda.codice~" ASC=yes ) " )
