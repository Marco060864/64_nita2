table(column=(type=long update=yes updatewhereclause=yes key=yes identity=yes name=id_tab_iva dbname="tab_iva.id_tab_iva" )
 column=(type=char(8) update=yes updatewhereclause=yes name=codice dbname="tab_iva.codice" )
 column=(type=char(20) update=yes updatewhereclause=yes name=des_breve dbname="tab_iva.des_breve" )
 column=(type=char(32766) update=yes updatewhereclause=no name=des_estesa dbname="tab_iva.des_estesa" )
 column=(type=char(1) update=yes updatewhereclause=yes name=tipo_iva dbname="tab_iva.tipo_iva" values="Detraibile	D/Non detraibile	N/Non imponibile	I/Esente	S/Fuori campo	F/Esclusa	C/" validation=" gettext()  = 'D' OR  gettext()  = 'N' OR  gettext()  = 'I' OR  gettext()  = 'S' OR  gettext()  = 'F' OR  gettext()  = 'C'" validationmsg="'Immettere: D, N, I, S, F, C'" )
 column=(type=decimal(2) update=yes updatewhereclause=yes name=per_aliquota dbname="tab_iva.per_aliquota" validation=" real(gettext())  >= 0 AND  real(gettext())  <= 100" validationmsg="'Immettere un valore fra 0 e 100'" )
 column=(type=decimal(2) update=yes updatewhereclause=yes name=per_detrazione dbname="tab_iva.per_detrazione" initial="100" validation=" real(gettext())  >= 0 AND  real(gettext())  <= 100" validationmsg="'Immettere un valore fra 0 e 100'" )
 column=(type=decimal(2) update=yes updatewhereclause=yes name=per_ventilazione dbname="tab_iva.per_ventilazione" validation=" real(gettext())  >= 0 AND  real(gettext())  <= 100" validationmsg="'Immettere un valore fra 0 e 100'" )
 column=(type=char(1) update=yes updatewhereclause=yes name=ges_plafond dbname="tab_iva.ges_plafond" initial="N" values="	S/	N" validation=" gettext()  = 'S' OR  gettext()  = 'N'" validationmsg="'Immettere: S, N'" )
 column=(type=char(1) update=yes updatewhereclause=yes name=ges_oper_intracomunitarie dbname="tab_iva.ges_oper_intracomunitarie" initial="N" values="	S/	N" validation=" gettext()  = 'S' OR  gettext()  = 'N'" validationmsg="'Immettere: S, N'" )
 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"tab_iva~" ) COLUMN(NAME=~"tab_iva.id_tab_iva~") COLUMN(NAME=~"tab_iva.codice~") COLUMN(NAME=~"tab_iva.des_breve~") COLUMN(NAME=~"tab_iva.des_estesa~") COLUMN(NAME=~"tab_iva.tipo_iva~") COLUMN(NAME=~"tab_iva.per_aliquota~") COLUMN(NAME=~"tab_iva.per_detrazione~") COLUMN(NAME=~"tab_iva.per_ventilazione~") COLUMN(NAME=~"tab_iva.ges_plafond~") COLUMN(NAME=~"tab_iva.ges_oper_intracomunitarie~")) ORDER(NAME=~"tab_iva.codice~" ASC=yes ) " update="tab_iva" updatewhere=1 updatekeyinplace=yes )
