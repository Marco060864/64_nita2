table(column=(type=char(32) updatewhereclause=yes name=articolo_codice dbname="articolo.codice" )
 column=(type=char(80) updatewhereclause=yes name=articolo_descrizione dbname="articolo.descrizione" )
 column=(type=char(30) updatewhereclause=yes name=lotto_cod_esterno dbname="lotto.cod_esterno" )
 column=(type=char(40) updatewhereclause=yes name=azienda_rag_soc_1 dbname="azienda.rag_soc_1" )
 column=(type=decimal(4) updatewhereclause=yes name=esi_fiscale_iniziale dbname="esi_fiscale_iniziale" )
 column=(type=decimal(4) updatewhereclause=yes name=esi_fiscale_finale dbname="esi_fiscale_finale" )
 column=(type=decimal(4) updatewhereclause=yes name=carichi_finali dbname="carichi_finali" )
 column=(type=decimal(4) updatewhereclause=yes name=scarichi_finali dbname="scarichi_finali" )
 column=(type=date updatewhereclause=yes name=lotto_data_scadenza dbname="lotto.data_scadenza" )
 column=(type=decimal(4) updatewhereclause=yes name=costo_acquisto dbname="costo_acquisto" )
 column=(type=char(80) updatewhereclause=yes name=valori_iniziali dbname="valori_iniziali" )
 column=(type=char(80) updatewhereclause=yes name=valori_finali dbname="valori_finali" )
 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"lotto~" )  TABLE(NAME=~"articolo~" )  TABLE(NAME=~"cat_merceologica~" )  TABLE(NAME=~"cat_fiscale~" )  TABLE(NAME=~"azienda~" ) COLUMN(NAME=~"articolo.codice~") COLUMN(NAME=~"articolo.descrizione~") COLUMN(NAME=~"lotto.cod_esterno~") COLUMN(NAME=~"azienda.rag_soc_1~") COMPUTE(NAME=~"CAST( SUBSTR( valori_iniziali, 1, 20) AS DECIMAL(18,4) ) AS esi_fiscale_iniziale~") COMPUTE(NAME=~"CAST( SUBSTR( valori_finali, 1, 20) AS DECIMAL(18,4) ) AS esi_fiscale_finale~") COMPUTE(NAME=~"CAST( SUBSTR( valori_finali, 21, 20) AS DECIMAL(18,4) ) AS carichi_finali~") COMPUTE(NAME=~"CAST( SUBSTR( valori_finali, 41, 20) AS DECIMAL(18,4) ) AS scarichi_finali~") COLUMN(NAME=~"lotto.data_scadenza~") COMPUTE(NAME=~"CAST( SUBSTR( valori_finali, 61, 20) AS DECIMAL(18,4) ) AS costo_acquisto~") COMPUTE(NAME=~"CAST( fn_esi_lotti(~~~"lotto~~~".~~~"id_lotto~~~", 0, :rdt_data_inizio) AS CHAR(80) ) AS valori_iniziali~") COMPUTE(NAME=~"CAST( fn_esi_lotti(~~~"lotto~~~".~~~"id_lotto~~~", 0, :rdt_data_fine) AS CHAR(80) ) AS valori_finali~")    JOIN (LEFT=~"cat_merceologica.id_cat_merceologica~"    OP =~"=~"RIGHT=~"articolo.id_cat_merceologica~"    OUTER2 =~"articolo.id_cat_merceologica~" )    JOIN (LEFT=~"cat_fiscale.id_cat_fiscale~"    OP =~"=~"RIGHT=~"articolo.id_cat_fiscale~"    OUTER2 =~"articolo.id_cat_fiscale~" )    JOIN (LEFT=~"articolo.id_articolo~"    OP =~"=~"RIGHT=~"lotto.id_articolo~" )    JOIN (LEFT=~"azienda.id_azienda~"    OP =~"=~"RIGHT=~"articolo.id_azienda~" )) ARG(NAME = ~"rs_parametri~" TYPE = string)  ARG(NAME = ~"rdt_data_inizio~" TYPE = date)  ARG(NAME = ~"rdt_data_fine~" TYPE = date) " arguments=(("rs_parametri", string),("rdt_data_inizio", date),("rdt_data_fine", date)) )
