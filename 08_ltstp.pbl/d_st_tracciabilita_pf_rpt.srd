 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"lotto~" ALIAS=~"lotto_a~" )  TABLE(NAME=~"articolo~" ALIAS=~"articolo_a~" )  TABLE(NAME=~"movimenti_lotto~" )  TABLE(NAME=~"lotto~" ALIAS=~"lotto_b~" )  TABLE(NAME=~"articolo~" ALIAS=~"articolo_b~" )  TABLE(NAME=~"riga_documento~" )  TABLE(NAME=~"documento~" )  TABLE(NAME=~"prof_documento~" )  TABLE(NAME=~"azienda~" )  TABLE(NAME=~"sog_commerciale_gen~" ) COLUMN(NAME=~"lotto_a.data_doc~") COLUMN(NAME=~"lotto_a.data_scadenza~") COLUMN(NAME=~"lotto_a.cod_esterno~") COLUMN(NAME=~"articolo_a.codice~") COLUMN(NAME=~"articolo_a.descrizione~") COLUMN(NAME=~"lotto_a.qta_iniziale~") COLUMN(NAME=~"lotto_a.qta_scaricata~") COLUMN(NAME=~"lotto_a.peso_netto_iniziale~") COLUMN(NAME=~"lotto_a.peso_netto_scaricato~") COLUMN(NAME=~"lotto_a.peso_netto_da_lav~") COLUMN(NAME=~"articolo_b.codice~") COLUMN(NAME=~"articolo_b.descrizione~") COLUMN(NAME=~"lotto_b.data_scadenza~") COLUMN(NAME=~"lotto_b.cod_esterno~") COLUMN(NAME=~"prof_documento.codice~") COLUMN(NAME=~"documento.num_progressivo~") COLUMN(NAME=~"documento.data_registrazione~") COLUMN(NAME=~"riga_documento.quantita~") COLUMN(NAME=~"riga_documento.peso_netto~") COLUMN(NAME=~"lotto_a.id_lotto~") COLUMN(NAME=~"lotto_a.numero~") COLUMN(NAME=~"azienda.rag_soc_1~") COLUMN(NAME=~"sog_commerciale_gen.codice~") COLUMN(NAME=~"sog_commerciale_gen.rag_soc_1~")    JOIN (LEFT=~"riga_documento.id_riga_documento~"    OP =~"=~"RIGHT=~"movimenti_lotto.id_riga_documento~"    OUTER2 =~"movimenti_lotto.id_riga_documento~" )    JOIN (LEFT=~"documento.id_documento~"    OP =~"=~"RIGHT=~"riga_documento.id_documento~"    OUTER2 =~"riga_documento.id_documento~" )    JOIN (LEFT=~"prof_documento.id_prof_documento~"    OP =~"=~"RIGHT=~"documento.id_prof_documento~"    OUTER2 =~"documento.id_prof_documento~" )    JOIN (LEFT=~"sog_commerciale_gen.id_sog_commerciale~"    OP =~"=~"RIGHT=~"documento.id_sog_commerciale~"    OUTER2 =~"documento.id_sog_commerciale~" )   JOIN (LEFT=~"articolo_a.id_articolo~"    OP =~"=~"RIGHT=~"lotto_a.id_articolo~" )    JOIN (LEFT=~"movimenti_lotto.num_lotto_prod~"    OP =~"=~"RIGHT=~"lotto_a.numero~" )    JOIN (LEFT=~"lotto_b.id_lotto~"    OP =~"=~"RIGHT=~"movimenti_lotto.id_lotto~" )    JOIN (LEFT=~"articolo_b.id_articolo~"    OP =~"=~"RIGHT=~"lotto_b.id_articolo~" )    JOIN (LEFT=~"azienda.id_azienda~"    OP =~"=~"RIGHT=~"articolo_a.id_azienda~" ) ) ARG(NAME = ~"rs_parametri~" TYPE = string) " arguments=(("rs_parametri", string))  sort="articolo_codice A lotto_cod_esterno_n A articolo_codice_mp A lotto_cod_esterno_mp_n A " )
