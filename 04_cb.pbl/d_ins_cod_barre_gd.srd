 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"cod_barre~" )  TABLE(NAME=~"unita_confezione~" )  TABLE(NAME=~"articolo~" ) COLUMN(NAME=~"articolo.codice~") COLUMN(NAME=~"articolo.descrizione~") COLUMN(NAME=~"unita_confezione.codice~") COLUMN(NAME=~"cod_barre.id_cod_barre~") COLUMN(NAME=~"cod_barre.id_tipo_cod_barre~") COLUMN(NAME=~"cod_barre.codice~") COLUMN(NAME=~"cod_barre.id_unita_confezione~") COLUMN(NAME=~"cod_barre.id_azienda~") COLUMN(NAME=~"unita_confezione.id_articolo~") COLUMN(NAME=~"unita_confezione.id_unita_confezione~")    JOIN (LEFT=~"unita_confezione.id_unita_confezione~"    OP =~"=~"RIGHT=~"cod_barre.id_unita_confezione~" )    JOIN (LEFT=~"articolo.id_articolo~"    OP =~"=~"RIGHT=~"unita_confezione.id_articolo~" )WHERE(    EXP1 =~"( ( ~~~"cod_barre~~~".~~~"gen_automatica~~~"~"   OP =~"=~"    EXP2 =~"'N' )~"    LOGIC =~"or~" ) WHERE(    EXP1 =~"( ~~~"cod_barre~~~".~~~"gen_automatica~~~"~"   OP =~"is~"    EXP2 =~"NULL ) )~" ) ) " update="cod_barre" updatewhere=1 updatekeyinplace=yes  sort="articolo_codice A c_unita_confezione_cod A " )
