table(column=(type=char(64) updatewhereclause=yes name=articolo_codice dbname="articolo.codice" dbalias=".codice" )
 column=(type=char(40) updatewhereclause=yes name=articolo_des_breve dbname="articolo.des_breve" dbalias=".des_breve" )
 column=(type=char(8) updatewhereclause=yes name=unita_confezione_codice dbname="unita_confezione.codice" dbalias=".codice" )
 column=(type=char(8) updatewhereclause=yes name=cat_com_articolo_codice dbname="cat_com_articolo.codice" dbalias=".codice" )
 column=(type=char(8) updatewhereclause=yes name=cat_merceologica_codice dbname="cat_merceologica.codice" dbalias=".codice" )
 column=(type=char(8) updatewhereclause=yes name=cat_fiscale_codice dbname="cat_fiscale.codice" dbalias=".codice" )
 column=(type=char(8) updatewhereclause=yes name=tab_iva_codice dbname="tab_iva.codice" dbalias=".codice" )
 column=(type=char(8) updatewhereclause=yes name=sog_commerciale_codice dbname="sog_commerciale.codice" dbalias=".codice" )
 column=(type=char(40) updatewhereclause=yes name=anagrafica_rag_soc_1 dbname="anagrafica.rag_soc_1" dbalias=".rag_soc_1" )
 column=(type=long updatewhereclause=yes identity=yes name=unita_confezione_id_unita_confezione dbname="unita_confezione.id_unita_confezione" dbalias=".id_unita_confezione" )
 column=(type=long updatewhereclause=yes name=id_cat_codifica dbname="articolo.id_cat_codifica" dbalias=".id_cat_codifica" )
 column=(type=long updatewhereclause=yes identity=yes name=id_articolo dbname="articolo.id_articolo" dbalias=".id_articolo" )
 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"articolo~" )  TABLE(NAME=~"unita_confezione~" )  TABLE(NAME=~"cat_com_articolo~" )  TABLE(NAME=~"cat_merceologica~" )  TABLE(NAME=~"cat_fiscale~" )  TABLE(NAME=~"tab_iva~" )  TABLE(NAME=~"sog_commerciale~" )  TABLE(NAME=~"anagrafica~" ) COLUMN(NAME=~"articolo.codice~") COLUMN(NAME=~"articolo.des_breve~") COLUMN(NAME=~"unita_confezione.codice~") COLUMN(NAME=~"cat_com_articolo.codice~") COLUMN(NAME=~"cat_merceologica.codice~") COLUMN(NAME=~"cat_fiscale.codice~") COLUMN(NAME=~"tab_iva.codice~") COLUMN(NAME=~"sog_commerciale.codice~") COLUMN(NAME=~"anagrafica.rag_soc_1~") COLUMN(NAME=~"unita_confezione.id_unita_confezione~") COLUMN(NAME=~"articolo.id_cat_codifica~") COLUMN(NAME=~"articolo.id_articolo~")    JOIN (LEFT=~"cat_merceologica.id_cat_merceologica~"    OP =~"=~"RIGHT=~"articolo.id_cat_merceologica~"    OUTER2 =~"articolo.id_cat_merceologica~" )    JOIN (LEFT=~"cat_fiscale.id_cat_fiscale~"    OP =~"=~"RIGHT=~"articolo.id_cat_fiscale~"    OUTER2 =~"articolo.id_cat_fiscale~" )    JOIN (LEFT=~"tab_iva.id_tab_iva~"    OP =~"=~"RIGHT=~"articolo.id_tab_iva~"    OUTER2 =~"articolo.id_tab_iva~" )    JOIN (LEFT=~"sog_commerciale.id_sog_commerciale~"    OP =~"=~"RIGHT=~"articolo.id_sog_commerciale~"    OUTER2 =~"articolo.id_sog_commerciale~" )    JOIN (LEFT=~"anagrafica.id_anagrafica~"    OP =~"=~"RIGHT=~"articolo.id_anagrafica~"    OUTER2 =~"articolo.id_anagrafica~" )    JOIN (LEFT=~"unita_confezione.id_articolo~"    OP =~"=~"RIGHT=~"articolo.id_articolo~" )    JOIN (LEFT=~"cat_com_articolo.id_cat_com_articolo~"    OP =~"=~"RIGHT=~"articolo.id_cat_com_articolo~" )WHERE(    EXP1 =~"~~~"articolo~~~".~~~"id_azienda~~~"~"   OP =~"=~"    EXP2 =~"1~" ) ) " )
