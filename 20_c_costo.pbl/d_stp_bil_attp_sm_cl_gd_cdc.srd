 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"chiusura_apertura~" )  TABLE(NAME=~"conto~" )  TABLE(NAME=~"mastro~" )  TABLE(NAME=~"sottomastro~" )  TABLE(NAME=~"par_sistema~" ALIAS=~"par_sistema_a~" )  TABLE(NAME=~"par_sistema~" ALIAS=~"par_sistema_b~" ) COLUMN(NAME=~"conto.codice~") COLUMN(NAME=~"conto.descrizione~") COLUMN(NAME=~"chiusura_apertura.saldo_dare~") COLUMN(NAME=~"chiusura_apertura.data~") COLUMN(NAME=~"chiusura_apertura.tipo~") COLUMN(NAME=~"sottomastro.codice~") COLUMN(NAME=~"sottomastro.descrizione~") COMPUTE(NAME=~"cast(~~~"chiusura_apertura~~~".~~~"saldo_dare~~~" / :rn_cambio as decimal) as dare_valuta~") COMPUTE(NAME=~"cast(left(~~~"conto~~~".~~~"codice~~~",2)as char)as mastro~") COMPUTE(NAME=~"cast(substr(~~~"conto~~~".~~~"codice~~~",3,2)as char )as sottomastr~") COLUMN(NAME=~"par_sistema_a.pref_cod_cliente~") COLUMN(NAME=~"par_sistema_b.pref_cod_fornitore~") COLUMN(NAME=~"mastro.codice~") COLUMN(NAME=~"mastro.descrizione~")    JOIN (LEFT=~"mastro.codice~"    OP =~"=~"RIGHT=~"par_sistema_a.pref_cod_cliente~"    OUTER1 =~"mastro.codice~" )    JOIN (LEFT=~"mastro.codice~"    OP =~"=~"RIGHT=~"par_sistema_b.pref_cod_fornitore~"    OUTER1 =~"mastro.codice~" )    JOIN (LEFT=~"chiusura_apertura.id_conto~"    OP =~"=~"RIGHT=~"conto.id_conto~" )    JOIN (LEFT=~"sottomastro.id_mastro~"    OP =~"=~"RIGHT=~"mastro.id_mastro~" )    JOIN (LEFT=~"sottomastro.id_sottomastro~"    OP =~"=~"RIGHT=~"conto.id_sottomastro~" )WHERE(    EXP1 =~"~~~"chiusura_apertura~~~".~~~"saldo_dare~~~"~"   OP =~">~"    EXP2 =~"0~" ) ) ORDER(NAME=~"sottomastro.codice~" ASC=yes )  ORDER(NAME=~"chiusura_apertura.saldo_dare~" ASC=yes ) ARG(NAME = ~"rn_cambio~" TYPE = number)  ARG(NAME = ~"rs_formato~" TYPE = string) " arguments=(("rn_cambio", number),("rs_formato", string))  sort="mastro_codice A sottomastro_codice A " )
