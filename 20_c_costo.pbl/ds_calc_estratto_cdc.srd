compute(band=detail alignment="1" expression="dare  /  rn_cambio "border="0" color="0" x="7699" y="0" height="502" width="2672" format="[general]~tif (  rn_decimali = 0 , '#,0' ,    if ( rn_decimali = -1, '#,0.0' ,   if ( rn_decimali = -2, '#,0.00' ,if ( rn_decimali = -3, '#,0.000',  if ( rn_decimali = -4, '#,0.0000', '#,0.000000' ) ) ) ) )"  name=cambio_dare  font.face="Arial" font.height="-8" font.weight="400"  font.family="2" font.pitch="2" font.charset="0" background.mode="2" background.color="16777215" )
compute(band=detail alignment="1" expression="avere  /  rn_cambio "border="0" color="0" x="10424" y="0" height="502" width="2698" format="[general]~tif (  rn_decimali = 0 , '#,0' ,    if ( rn_decimali = -1, '#,0.0' ,   if ( rn_decimali = -2, '#,0.00' ,if ( rn_decimali = -3, '#,0.000',  if ( rn_decimali = -4, '#,0.0000', '#,0.000000' ) ) ) ) )"  name=cambio_avere  font.face="Arial" font.height="-8" font.weight="400"  font.family="2" font.pitch="2" font.charset="0" background.mode="2" background.color="16777215" )
compute(band=detail alignment="1" expression="cumulativeSum( dareavere  for all )  +  rn_saldo_iniziale "border="0" color="0" x="13176" y="0" height="502" width="4127" format="[general]~tif (  rn_decimali = 0 , '#,0' ,    if ( rn_decimali = -1, '#,0.0' ,   if ( rn_decimali = -2, '#,0.00' ,if ( rn_decimali = -3, '#,0.000',  if ( rn_decimali = -4, '#,0.0000', '#,0.000000' ) ) ) ) )"  name=saldo_parziale  font.face="Arial" font.height="-8" font.weight="400"  font.family="2" font.pitch="2" font.charset="0" background.mode="2" background.color="16777215" )
