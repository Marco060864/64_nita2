compute(band=summary alignment="1" expression="( tot_dare - tot_avere ) + rn_saldo_iniziale "border="0" color="0" x="13176" y="159" height="502" width="4127" format="[general]~tif (  rn_decimali = 0 , '#,0' ,    if ( rn_decimali = -1, '#,0.0' ,   if ( rn_decimali = -2, '#,0.00' ,if ( rn_decimali = -3, '#,0.000',  if ( rn_decimali = -4, '#,0.0000', '#,0.000000' ) ) ) ) )"  name=sum_saldo  font.face="Arial" font.height="-8" font.weight="700"  font.family="2" font.pitch="2" font.charset="0" background.mode="2" background.color="16777215" )
