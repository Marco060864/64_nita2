//objectcomments new cdc
release 6;
datawindow(units=3 timer_interval=0 color=79741120 processing=1 print.documentname="" print.orientation = 0 print.margin.left = 110 print.margin.right = 110 print.margin.top = 96 print.margin.bottom = 96 print.paper.source = 0 print.paper.size = 0 print.prompt=no print.buttons=no print.preview.buttons=no grid.lines=1 selected.mouse=no )
header(height=4603 color="536870912" )
summary(height=1931 color="536870912" )
footer(height=582 color="536870912" )
detail(height=529 color="536870912"  height.autosize=yes)
table(column=(type=date updatewhereclause=yes name=c_data dbname="reg_pdc.data" )
 column=(type=long updatewhereclause=yes name=num_prog dbname="reg_pdc.num_prog" )
 column=(type=char(80) updatewhereclause=yes name=descrizione dbname="reg_pdc.descrizione" )
 column=(type=decimal(4) updatewhereclause=yes name=dare dbname="mov_centri_costo.dare" )
 column=(type=decimal(4) updatewhereclause=yes name=avere dbname="mov_centri_costo.avere" )
 column=(type=long updatewhereclause=yes identity=yes name=conto_id_conto dbname="conto.id_conto" )
 column=(type=char(8) updatewhereclause=yes name=conto_codice dbname="conto.codice" )
 column=(type=char(40) updatewhereclause=yes name=conto_descrizione dbname="conto.descrizione" )
 column=(type=long updatewhereclause=yes identity=yes name=id_reg_pdc dbname="reg_pdc.id_reg_pdc" )
 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"conto~" )  TABLE(NAME=~"mov_centri_costo~" )  TABLE(NAME=~"reg_pdc~" ) COLUMN(NAME=~"reg_pdc.data~") COLUMN(NAME=~"reg_pdc.num_prog~") COLUMN(NAME=~"reg_pdc.descrizione~") COLUMN(NAME=~"mov_centri_costo.dare~") COLUMN(NAME=~"mov_centri_costo.avere~") COLUMN(NAME=~"conto.id_conto~") COLUMN(NAME=~"conto.codice~") COLUMN(NAME=~"conto.descrizione~") COLUMN(NAME=~"reg_pdc.id_reg_pdc~")    JOIN (LEFT=~"mov_centri_costo.id_conto~"    OP =~"=~"RIGHT=~"conto.id_conto~" )    JOIN (LEFT=~"reg_pdc.id_reg_pdc~"    OP =~"=~"RIGHT=~"mov_centri_costo.id_reg_pdc~" )WHERE(    EXP1 =~"(~~~"reg_pdc~~~".~~~"data~~~"~"   OP =~">=~"    EXP2 =~":da_data ~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"reg_pdc~~~".~~~"data~~~"~"   OP =~"<=~"    EXP2 =~":a_data )~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"conto~~~".~~~"codice~~~"~"   OP =~"=~"    EXP2 =~":rs_conto ~" ) ) ARG(NAME = ~"rs_conto~" TYPE = string)  ARG(NAME = ~"da_data~" TYPE = date)  ARG(NAME = ~"a_data~" TYPE = date)  ARG(NAME = ~"rn_prof_apertura~" TYPE = number)  ARG(NAME = ~"rn_prof_chiusura~" TYPE = number)  ARG(NAME = ~"rn_decimali~" TYPE = number)  ARG(NAME = ~"rn_cambio~" TYPE = number)  ARG(NAME = ~"rs_valuta~" TYPE = string)  ARG(NAME = ~"rn_saldo_iniziale~" TYPE = number)  ARG(NAME = ~"rn_saldo_finale~" TYPE = number) " arguments=(("rs_conto", string),("da_data", date),("a_data", date),("rn_prof_apertura", number),("rn_prof_chiusura", number),("rn_decimali", number),("rn_cambio", number),("rs_valuta", string),("rn_saldo_iniziale", number),("rn_saldo_finale", number))  sort="conto_id_conto A " )
report(band=header dataobject="d_stampa_cdc" x="52" y="105" height="2831" width="19949" border="0"  height.autosize=yes criteria="" nest_arguments=(("rs_conto"),("da_data"),("a_data"),("rs_valuta")) trail_footer = yes  slideup=directlyabove )
