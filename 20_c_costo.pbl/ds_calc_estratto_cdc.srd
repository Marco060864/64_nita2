compute(band=summary alignment="1" expression="sum(   cambio_dare for all )"border="0" color="0" x="7699" y="159" height="502" width="2672" format="[general]~tif (  rn_decimali = 0 , '#,0' ,    if ( rn_decimali = -1, '#,0.0' ,   if ( rn_decimali = -2, '#,0.00' ,if ( rn_decimali = -3, '#,0.000',  if ( rn_decimali = -4, '#,0.0000', '#,0.000000' ) ) ) ) )"  name=tot_dare  font.face="Arial" font.height="-8" font.weight="400"  font.family="2" font.pitch="2" font.charset="0" background.mode="2" background.color="16777215" )
