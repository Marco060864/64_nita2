 column=(type=char(40) updatewhereclause=yes name=sottomastro_descrizione dbname="sottomastro.descrizione" )
 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"chiusura_apertura~" )  TABLE(NAME=~"conto~" )  TABLE(NAME=~"mastro~" )  TABLE(NAME=~"sottomastro~" ) COLUMN(NAME=~"conto.descrizione~") COLUMN(NAME=~"chiusura_apertura.saldo_dare~") COLUMN(NAME=~"chiusura_apertura.saldo_avere~") COLUMN(NAME=~"chiusura_apertura.data~") COLUMN(NAME=~"chiusura_apertura.tipo~") COMPUTE(NAME=~"cast(~~~"chiusura_apertura~~~".~~~"saldo_avere~~~" / :rn_cambio as decimal) as avere_valuta~") COMPUTE(NAME=~"cast(left(~~~"conto~~~".~~~"codice~~~",2) as char) as mastro~") COMPUTE(NAME=~"cast(substr(~~~"conto~~~".~~~"codice~~~",3,2) as char) as sottomastro~") COLUMN(NAME=~"conto.codice~") COLUMN(NAME=~"mastro.descrizione~") COLUMN(NAME=~"sottomastro.descrizione~")    JOIN (LEFT=~"chiusura_apertura.id_conto~"    OP =~"=~"RIGHT=~"conto.id_conto~" )    JOIN (LEFT=~"sottomastro.id_sottomastro~"    OP =~"=~"RIGHT=~"conto.id_sottomastro~" )    JOIN (LEFT=~"mastro.id_mastro~"    OP =~"=~"RIGHT=~"sottomastro.id_mastro~" )WHERE(    EXP1 =~"~~~"chiusura_apertura~~~".~~~"saldo_avere~~~"~"   OP =~">~"    EXP2 =~"0~" ) ) ORDER(NAME=~"7~" ASC=yes )  ORDER(NAME=~"8~" ASC=yes )  ORDER(NAME=~"chiusura_apertura.tipo~" ASC=yes ) ARG(NAME = ~"rn_cambio~" TYPE = number)  ARG(NAME = ~"rs_formato~" TYPE = string) " arguments=(("rn_cambio", number),("rs_formato", string)) )
