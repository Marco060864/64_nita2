 column=(type=char(40) updatewhereclause=yes name=c_cat_sc_des dbname="cat_com_sc.descrizione" )
 column=(type=long update=yes updatewhereclause=yes key=yes identity=yes name=con_movimento_pdc_id_con_movimento dbname="con_movimento_pdc.id_con_movimento" )
 column=(type=char(1) update=yes updatewhereclause=yes name=applicazione dbname="con_movimento_pdc.applicazione" validation=" gettext()  = 'A' OR  gettext()  = 'V'" )
 column=(type=long update=yes updatewhereclause=yes name=con_movimento_pdc_id_sog_commerciale dbname="con_movimento_pdc.id_sog_commerciale" )
 column=(type=long update=yes updatewhereclause=yes name=id_cat_com_sc dbname="con_movimento_pdc.id_cat_com_sc" )
 column=(type=long update=yes updatewhereclause=yes name=con_movimento_pdc_id_articolo dbname="con_movimento_pdc.id_articolo" )
 column=(type=long update=yes updatewhereclause=yes name=con_movimento_pdc_id_cat_com_articolo dbname="con_movimento_pdc.id_cat_com_articolo" )
 column=(type=long update=yes updatewhereclause=yes name=id_conto dbname="con_movimento_pdc.id_conto" )
 column=(type=decimal(0) update=yes updatewhereclause=yes name=con_movimento_pdc_priorita dbname="con_movimento_pdc.priorita" )
 column=(type=long update=yes updatewhereclause=yes name=id_azienda dbname="con_movimento_pdc.id_azienda" initial="1" )
 column=(type=char(60) update=yes updatewhereclause=yes name=con_movimento_pdc_chiave dbname="con_movimento_pdc.chiave" )
 column=(type=long update=yes updatewhereclause=yes name=per_cento dbname="con_movimento_pdc.per_cento" )
 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"conto~" )  TABLE(NAME=~"cat_com_sc~" )  TABLE(NAME=~"con_movimento_pdc~" ) COLUMN(NAME=~"conto.codice~") COLUMN(NAME=~"conto.descrizione~") COLUMN(NAME=~"cat_com_sc.codice~") COLUMN(NAME=~"cat_com_sc.descrizione~") COLUMN(NAME=~"con_movimento_pdc.id_con_movimento~") COLUMN(NAME=~"con_movimento_pdc.applicazione~") COLUMN(NAME=~"con_movimento_pdc.id_sog_commerciale~") COLUMN(NAME=~"con_movimento_pdc.id_cat_com_sc~") COLUMN(NAME=~"con_movimento_pdc.id_articolo~") COLUMN(NAME=~"con_movimento_pdc.id_cat_com_articolo~") COLUMN(NAME=~"con_movimento_pdc.id_conto~") COLUMN(NAME=~"con_movimento_pdc.priorita~") COLUMN(NAME=~"con_movimento_pdc.id_azienda~") COLUMN(NAME=~"con_movimento_pdc.chiave~") COLUMN(NAME=~"con_movimento_pdc.per_cento~")    JOIN (LEFT=~"cat_com_sc.id_cat_com_sc~"    OP =~"=~"RIGHT=~"con_movimento_pdc.id_cat_com_sc~"    OUTER2 =~"con_movimento_pdc.id_cat_com_sc~" )    JOIN (LEFT=~"conto.id_conto~"    OP =~"=~"RIGHT=~"con_movimento_pdc.id_conto~" )WHERE(    EXP1 =~"~~~"con_movimento_pdc~~~".~~~"id_azienda~~~"~"   OP =~"in~"    EXP2 =~"(0,1)~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"con_movimento_pdc~~~".~~~"id_cat_com_articolo~~~"~"   OP =~"is~"    EXP2 =~"null~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"con_movimento_pdc~~~".~~~"id_sog_commerciale~~~"~"   OP =~"is~"    EXP2 =~"null~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"con_movimento_pdc~~~".~~~"id_articolo~~~"~"   OP =~"is~"    EXP2 =~"null~" ) ) " update="con_movimento_pdc" updatewhere=1 updatekeyinplace=yes )
