 column=(type=long update=yes updatewhereclause=yes name=per_cento dbname="con_movimento_pdc.per_cento" )
 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"conto~" )  TABLE(NAME=~"sog_commerciale_gen~" )  TABLE(NAME=~"con_movimento_pdc~" ) COLUMN(NAME=~"conto.codice~") COLUMN(NAME=~"conto.descrizione~") COLUMN(NAME=~"sog_commerciale_gen.codice~") COLUMN(NAME=~"sog_commerciale_gen.rag_soc_1~") COLUMN(NAME=~"con_movimento_pdc.id_con_movimento~") COLUMN(NAME=~"con_movimento_pdc.applicazione~") COLUMN(NAME=~"con_movimento_pdc.id_sog_commerciale~") COLUMN(NAME=~"con_movimento_pdc.id_cat_com_sc~") COLUMN(NAME=~"con_movimento_pdc.id_cat_com_articolo~") COLUMN(NAME=~"con_movimento_pdc.id_articolo~") COLUMN(NAME=~"con_movimento_pdc.id_conto~") COLUMN(NAME=~"con_movimento_pdc.priorita~") COLUMN(NAME=~"con_movimento_pdc.id_azienda~") COLUMN(NAME=~"con_movimento_pdc.chiave~") COLUMN(NAME=~"con_movimento_pdc.per_cento~")    JOIN (LEFT=~"sog_commerciale_gen.id_sog_commerciale~"    OP =~"=~"RIGHT=~"con_movimento_pdc.id_sog_commerciale~"    OUTER2 =~"con_movimento_pdc.id_sog_commerciale~" )    JOIN (LEFT=~"conto.id_conto~"    OP =~"=~"RIGHT=~"con_movimento_pdc.id_conto~" )WHERE(    EXP1 =~"~~~"con_movimento_pdc~~~".~~~"id_azienda~~~"~"   OP =~"in~"    EXP2 =~"(0,1)~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"con_movimento_pdc~~~".~~~"id_cat_com_articolo~~~"~"   OP =~"is~"    EXP2 =~"null~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"con_movimento_pdc~~~".~~~"id_cat_com_sc~~~"~"   OP =~"is~"    EXP2 =~"null~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"con_movimento_pdc~~~".~~~"id_articolo~~~"~"   OP =~"is~"    EXP2 =~"null~" ) ) " update="con_movimento_pdc" updatewhere=1 updatekeyinplace=yes )
