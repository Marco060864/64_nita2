detail(height=404 color="536870912" )
table(column=(type=long update=yes updatewhereclause=yes identity=yes name=id_reg_pd dbname="id_reg_pd" )
 column=(type=char(8) updatewhereclause=yes name=prof_registrazione_codice dbname="codice" )
 column=(type=char(40) updatewhereclause=yes name=prof_registrazione_descrizione dbname="descrizione" )
 column=(type=long update=yes updatewhereclause=yes name=id_prof_registrazione dbname="id_prof_registrazione" )
 column=(type=long update=yes updatewhereclause=yes name=id_registro dbname="id_registro" )
 column=(type=decimal(0) update=yes updatewhereclause=yes name=num_progressivo dbname="num_progressivo" validation=" real(gettext())  >= 0" validationmsg="'Immettere un valore >= 0'" )
 column=(type=date update=yes updatewhereclause=yes name=data_competenza dbname="data_competenza" )
 column=(type=date update=yes updatewhereclause=yes name=data_registrazione dbname="data_registrazione" )
 column=(type=long update=yes updatewhereclause=yes name=id_valuta_des dbname="id_valuta" )
 column=(type=char(40) update=yes updatewhereclause=yes name=descrizione dbname="descrizione" )
 column=(type=decimal(4) update=yes updatewhereclause=yes name=cambio dbname="cambio" validation=" real(gettext())  >= 0" validationmsg="'Immettere un valore >= 0'" )
 column=(type=char(16) update=yes updatewhereclause=yes name=num_documento dbname="num_documento" validation=" real(gettext())  >= 0" validationmsg="'Immettere un valore >= 0'" )
 column=(type=date update=yes updatewhereclause=yes name=data_documento dbname="data_documento" )
 column=(type=long update=yes updatewhereclause=yes name=cdc_conto dbname="id_conto" )
 column=(type=long update=yes updatewhereclause=yes name=id_azienda dbname="id_azienda" initial="1" )
 column=(type=decimal(0) update=yes updatewhereclause=yes name=importo dbname="importo" validation=" real(gettext())  >= 0" validationmsg="'Immettere un valore >= 0'" )
 column=(type=decimal(0) updatewhereclause=yes name=imponibile dbname="totale_imponibile" )
 column=(type=decimal(0) updatewhereclause=yes name=imposta dbname="totale_imposta" )
 column=(type=char(2) updatewhereclause=yes name=tipo_registro dbname="tipo_registro" values="IVA acquisti	IA/IVA vendite	IV/Manageriale	MN/Prima nota	PN/Preventivi acquisti	PA/Preventivi vendite	PV/Ordini acquisti	OA/Ordini vendite	OV/DDT acquisti	DA/DDT vendite	DV/Liste prelievo acquisti	LA/Liste prelievo vendite	LV/Generico acquisti	GA/Generico vendite	GV/" validation=" gettext()  = 'IA' OR  gettext()  = 'IV' OR  gettext()  = 'MN' OR  gettext()  = 'PN' OR  gettext()  = 'PA' OR  gettext()  = 'PV' OR  gettext()  = 'OA' OR  gettext()  = 'OV' OR  gettext()  = 'DA' OR  gettext()  = 'DV' OR  gettext()  = 'LA' OR  gettext()  = 'LV' OR  gettext()  = 'GA' OR  gettext()  = 'GV'" validationmsg="'Immettere: IA, IV, MN, PN, OA, OP, DA, DV, LA, LP, GA, GV'" )
 column=(type=char(40) updatewhereclause=yes name=registro_descrizione dbname="descrizione" )
 column=(type=char(4) updatewhereclause=yes name=esercizio_codice dbname="codice" )
 column=(type=char(8) updatewhereclause=yes name=conto_codice dbname="codice" )
 column=(type=char(40) updatewhereclause=yes name=conto_descrizione dbname="descrizione" )
 column=(type=long updatewhereclause=yes identity=yes name=conto_id_conto dbname="id_conto" )
 column=(type=char(0) updatewhereclause=yes name=cinfo_sc dbname="info_sc" )
 column=(type=char(40) updatewhereclause=yes name=anagrafica_rag_soc_1 dbname="rag_soc_1" )
 column=(type=char(40) updatewhereclause=yes name=anagrafica_rag_soc_2 dbname="rag_soc_2" )
 column=(type=char(40) updatewhereclause=yes name=anagrafica_indirizzo dbname="indirizzo" )
 column=(type=char(10) updatewhereclause=yes name=anagrafica_cap dbname="cap" )
 column=(type=char(40) updatewhereclause=yes name=anagrafica_localita dbname="localita" )
 column=(type=char(5) updatewhereclause=yes name=anagrafica_provincia dbname="provincia" )
 column=(type=char(5) updatewhereclause=yes name=anagrafica_nazione dbname="nazione" initial="IT" )
 column=(type=char(16) updatewhereclause=yes name=anagrafica_cod_fiscale dbname="cod_fiscale" )
 column=(type=char(16) updatewhereclause=yes name=anagrafica_par_iva dbname="par_iva" )
 column=(type=decimal(0) updatewhereclause=yes name=registro_numero dbname="numero" validation=" real(gettext())  >= 0" validationmsg="'Immettere un valore >= 0'" )
 column=(type=char(1) update=yes updatewhereclause=yes name=reg_pd_ges_oper_intracomunitarie dbname="ges_oper_intracomunitarie" initial="N" values="	S/	N" validation=" gettext()  = 'S' OR  gettext()  = 'N'" validationmsg="'Immettere: S, N'" )
 column=(type=long updatewhereclause=yes identity=yes name=anagrafica_id_anagrafica dbname="id_anagrafica" initial="1" )
 column=(type=decimal(4) update=yes updatewhereclause=yes name=reg_pd_imp_valuta dbname="imp_valuta" )
 column=(type=long update=yes updatewhereclause=yes name=reg_pd_id_reg_pd_padre dbname="id_reg_pd_padre" )
 column=(type=long updatewhereclause=yes identity=yes name=esercizio_id_esercizio dbname="id_esercizio" )
 column=(type=char(29) updatewhereclause=yes name=cinfo_registro dbname="info_registro" )
 column=(type=date updatewhereclause=yes name=esercizio_data_inizio dbname="data_inizio" )
 column=(type=date updatewhereclause=yes name=esercizio_data_fine dbname="data_fine" )
 column=(type=char(1) update=yes updatewhereclause=yes name=reg_pd_tipo_fattura dbname="tipo_fattura" initial="N" values="Normale	N/Nota di Credito	C/Nota di Debito	D/" validation="gettext()  = 'N' OR  gettext()  = 'C' OR  gettext()  = 'D'" validationmsg="'Immettere un valore compreso tra N, C, D'" )
 column=(type=decimal(0) update=yes updatewhereclause=yes name=segno dbname="segno_reg_iva" initial="1" values="Nota addebito	1/Nota accredito	-1/" validation=" real(gettext())  = 1 OR  real(gettext())  = -1" validationmsg="'Immetere il valore -1 o +1'" )
 column=(type=real updatewhereclause=yes name=ceuro dbname="euro" )
 column=(type=date update=yes updatewhereclause=yes name=data_comp_liq_iva dbname="data_comp_liq_iva" )
 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"reg_pd~" )  TABLE(NAME=~"registro~" )  TABLE(NAME=~"esercizio~" )  TABLE(NAME=~"conto~" )  TABLE(NAME=~"prof_registrazione~" )  TABLE(NAME=~"sog_commerciale~" )  TABLE(NAME=~"anagrafica~" ) COLUMN(NAME=~"reg_pd.id_reg_pd~") COLUMN(NAME=~"prof_registrazione.codice~") COLUMN(NAME=~"prof_registrazione.descrizione~") COLUMN(NAME=~"reg_pd.id_prof_registrazione~") COLUMN(NAME=~"reg_pd.id_registro~") COLUMN(NAME=~"reg_pd.num_progressivo~") COLUMN(NAME=~"reg_pd.data_competenza~") COLUMN(NAME=~"reg_pd.data_registrazione~") COLUMN(NAME=~"reg_pd.id_valuta~") COLUMN(NAME=~"reg_pd.descrizione~") COLUMN(NAME=~"reg_pd.cambio~") COLUMN(NAME=~"reg_pd.num_documento~") COLUMN(NAME=~"reg_pd.data_documento~") COLUMN(NAME=~"reg_pd.id_conto~") COLUMN(NAME=~"reg_pd.id_azienda~") COLUMN(NAME=~"reg_pd.importo~") COMPUTE(NAME=~"CAST (0 as decimal) as totale_imponibile~") COMPUTE(NAME=~"CAST (0 as decimal) as totale_imposta~") COLUMN(NAME=~"registro.tipo_registro~") COLUMN(NAME=~"registro.descrizione~") COLUMN(NAME=~"esercizio.codice~") COLUMN(NAME=~"conto.codice~") COLUMN(NAME=~"conto.descrizione~") COLUMN(NAME=~"conto.id_conto~") COMPUTE(NAME=~"'' as info_sc~") COLUMN(NAME=~"anagrafica.rag_soc_1~") COLUMN(NAME=~"anagrafica.rag_soc_2~") COLUMN(NAME=~"anagrafica.indirizzo~") COLUMN(NAME=~"anagrafica.cap~") COLUMN(NAME=~"anagrafica.localita~") COLUMN(NAME=~"anagrafica.provincia~") COLUMN(NAME=~"anagrafica.nazione~") COLUMN(NAME=~"anagrafica.cod_fiscale~") COLUMN(NAME=~"anagrafica.par_iva~") COLUMN(NAME=~"registro.numero~") COLUMN(NAME=~"reg_pd.ges_oper_intracomunitarie~") COLUMN(NAME=~"anagrafica.id_anagrafica~") COLUMN(NAME=~"reg_pd.imp_valuta~") COLUMN(NAME=~"reg_pd.id_reg_pd_padre~") COLUMN(NAME=~"esercizio.id_esercizio~") COMPUTE(NAME=~"'Tipo: ' || ~~~"registro~~~".~~~"tipo_registro~~~" || ' - Numero: ' || ~~~"registro~~~".~~~"numero~~~" as info_registro~") COLUMN(NAME=~"esercizio.data_inizio~") COLUMN(NAME=~"esercizio.data_fine~") COLUMN(NAME=~"reg_pd.tipo_fattura~") COLUMN(NAME=~"reg_pd.segno_reg_iva~") COMPUTE(NAME=~"cast(1 as real) as euro~") COLUMN(NAME=~"reg_pd.data_comp_liq_iva~")    JOIN (LEFT=~"conto.id_conto~"    OP =~"=~"RIGHT=~"reg_pd.id_conto~"    OUTER2 =~"reg_pd.id_conto~" )    JOIN (LEFT=~"sog_commerciale.id_conto~"    OP =~"=~"RIGHT=~"conto.id_conto~"    OUTER2 =~"conto.id_conto~" )    JOIN (LEFT=~"anagrafica.id_anagrafica~"    OP =~"=~"RIGHT=~"sog_commerciale.id_anagrafica~"    OUTER2 =~"sog_commerciale.id_anagrafica~" )    JOIN (LEFT=~"registro.id_registro~"    OP =~"=~"RIGHT=~"reg_pd.id_registro~" )    JOIN (LEFT=~"esercizio.id_esercizio~"    OP =~"=~"RIGHT=~"registro.id_esercizio~" )    JOIN (LEFT=~"prof_registrazione.id_prof_registrazione~"    OP =~"=~"RIGHT=~"reg_pd.id_prof_registrazione~" )WHERE(    EXP1 =~"~~~"reg_pd~~~".~~~"id_azienda~~~"~"   OP =~"in~"    EXP2 =~"(0,1)~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"reg_pd~~~".~~~"id_reg_pd~~~"~"   OP =~"=~"    EXP2 =~":rd_reg~" ) ) ARG(NAME = ~"rd_reg~" TYPE = number) " arguments=(("rd_reg", number)) )
