compute(band=trailer.1 alignment="1" expression="sum(chiusura_apertura_saldo_avere for group 1)"border="0" color="0" x="2158" y="4" height="61" width="421" format="[general]"  name=sum_a  font.face="Arial" font.height="-8" font.weight="400"  font.family="2" font.pitch="2" font.charset="0" background.mode="2" background.color="16777215" )
compute(band=trailer.1 alignment="1" expression="sum(chiusura_apertura_saldo_dare for group 1)"border="0" color="0" x="1729" y="4" height="61" width="421" format="[general]"  name=sum_d  font.face="Arial" font.height="-8" font.weight="400"  font.family="2" font.pitch="2" font.charset="0" background.mode="2" background.color="16777215" )
compute(band=trailer.1 alignment="0" expression="IF (sum_d > 0, (sum_d-sum_a), (sum_a-sum_d))"border="0" color="0" x="2620" y="12" height="77" width="517" format="[general]"  name=tot  font.face="Arial" font.height="-8" font.weight="400"  font.family="2" font.pitch="2" font.charset="0" background.mode="2" background.color="16777215" )
