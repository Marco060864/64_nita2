 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"chiusura_apertura~" )  TABLE(NAME=~"centro_costo_righe~" )  TABLE(NAME=~"centro_costo_testa~" ) COLUMN(NAME=~"centro_costo_righe.id_conto~") COLUMN(NAME=~"centro_costo_righe.base_perc~") COLUMN(NAME=~"centro_costo_righe.saldo_cen_costo~") COLUMN(NAME=~"centro_costo_righe.segno~") COLUMN(NAME=~"chiusura_apertura.saldo_dare~") COLUMN(NAME=~"chiusura_apertura.saldo_avere~") COLUMN(NAME=~"centro_costo_righe.id_cen_cos_r~") COLUMN(NAME=~"centro_costo_testa.id_conto~") COLUMN(NAME=~"centro_costo_testa.totale~")    JOIN (LEFT=~"chiusura_apertura.id_conto~"    OP =~"=~"RIGHT=~"centro_costo_righe.id_conto~" )    JOIN (LEFT=~"centro_costo_testa.id_cen_cos_t~"    OP =~"=~"RIGHT=~"centro_costo_righe.id_cen_cos_t~" )) " update="centro_costo_righe" updatewhere=0 updatekeyinplace=no )
