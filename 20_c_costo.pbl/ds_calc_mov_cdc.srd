table(column=(type=date updatewhereclause=yes name=c_data dbname="reg_pdc.data" )
 column=(type=long updatewhereclause=yes name=num_prog dbname="reg_pdc.num_prog" )
 column=(type=char(8) updatewhereclause=yes name=codice dbname="conto.codice" )
 column=(type=char(40) updatewhereclause=yes name=descrizione dbname="conto.descrizione" )
 column=(type=decimal(4) updatewhereclause=yes name=dare dbname="mov_centri_costo.dare" )
 column=(type=decimal(4) updatewhereclause=yes name=avere dbname="mov_centri_costo.avere" )
 column=(type=char(8) updatewhereclause=yes name=codice_a dbname="conto.codice" )
