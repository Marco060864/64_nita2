 column=(type=long updatewhereclause=yes identity=yes name=id_reg_pdc dbname="reg_pdc.id_reg_pdc" )
 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"conto~" ALIAS=~"conto_a~" )  TABLE(NAME=~"mov_centri_costo~" )  TABLE(NAME=~"reg_pdc~" )  TABLE(NAME=~"conto~" ALIAS=~"conto_b~" ) COLUMN(NAME=~"reg_pdc.data~") COLUMN(NAME=~"reg_pdc.num_prog~") COLUMN(NAME=~"conto_a.codice~") COLUMN(NAME=~"conto_a.descrizione~") COLUMN(NAME=~"mov_centri_costo.dare~") COLUMN(NAME=~"mov_centri_costo.avere~") COLUMN(NAME=~"conto_b.codice~") COLUMN(NAME=~"conto_b.descrizione~") COLUMN(NAME=~"conto_b.id_conto~") COLUMN(NAME=~"conto_a.id_conto~") COLUMN(NAME=~"reg_pdc.id_reg_pdc~")    JOIN (LEFT=~"mov_centri_costo.id_conto~"    OP =~"=~"RIGHT=~"conto_a.id_conto~" )    JOIN (LEFT=~"reg_pdc.id_reg_pdc~"    OP =~"=~"RIGHT=~"mov_centri_costo.id_reg_pdc~" )    JOIN (LEFT=~"reg_pdc.id_conto~"    OP =~"=~"RIGHT=~"conto_b.id_conto~" )WHERE(    EXP1 =~"(~~~"reg_pdc~~~".~~~"data~~~"~"   OP =~">=~"    EXP2 =~":da_data ~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"reg_pdc~~~".~~~"data~~~"~"   OP =~"<=~"    EXP2 =~":a_data )~" ) ) ARG(NAME = ~"da_data~" TYPE = date)  ARG(NAME = ~"a_data~" TYPE = date) " arguments=(("da_data", date),("a_data", date))  sort="c_data A num_prog A id_conto_a A " )
