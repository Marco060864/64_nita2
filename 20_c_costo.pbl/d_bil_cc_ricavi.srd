 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"centro_costo_righe~" )  TABLE(NAME=~"centro_costo_testa~" )  TABLE(NAME=~"conto~" ALIAS=~"conto_a~" )  TABLE(NAME=~"mastro~" )  TABLE(NAME=~"sottomastro~" )  TABLE(NAME=~"conto~" ALIAS=~"conto_b~" ) COLUMN(NAME=~"mastro.tipo~") COLUMN(NAME=~"conto_a.codice~") COLUMN(NAME=~"conto_a.descrizione~") COLUMN(NAME=~"centro_costo_testa.totale~") COLUMN(NAME=~"centro_costo_testa.segno~") COLUMN(NAME=~"centro_costo_righe.base_perc~") COLUMN(NAME=~"centro_costo_righe.saldo_cen_costo~") COLUMN(NAME=~"centro_costo_righe.segno~") COLUMN(NAME=~"conto_b.descrizione~") COLUMN(NAME=~"conto_b.codice~") COLUMN(NAME=~"centro_costo_testa.id_cen_cos_t~") COMPUTE(NAME=~"cast(~~~"centro_costo_testa~~~".~~~"totale~~~" / :rn_cambio as decimal) as avere_valuta~")    JOIN (LEFT=~"centro_costo_testa.id_cen_cos_t~"    OP =~"=~"RIGHT=~"centro_costo_righe.id_cen_cos_t~" )    JOIN (LEFT=~"centro_costo_testa.id_conto~"    OP =~"=~"RIGHT=~"conto_a.id_conto~" )    JOIN (LEFT=~"sottomastro.id_mastro~"    OP =~"=~"RIGHT=~"mastro.id_mastro~" )    JOIN (LEFT=~"sottomastro.id_sottomastro~"    OP =~"=~"RIGHT=~"conto_a.id_sottomastro~" )    JOIN (LEFT=~"conto_b.id_conto~"    OP =~"=~"RIGHT=~"centro_costo_righe.id_conto~" )WHERE(    EXP1 =~"~~~"mastro~~~".~~~"tipo~~~"~"   OP =~"=~"    EXP2 =~"'R'~" ) ) ORDER(NAME=~"conto_a.codice~" ASC=yes ) ARG(NAME = ~"rn_cambio~" TYPE = number) " arguments=(("rn_cambio", number)) )
