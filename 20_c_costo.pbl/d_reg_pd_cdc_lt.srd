 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"conto~" )  TABLE(NAME=~"esercizio~" )  TABLE(NAME=~"reg_pdc~" ) COLUMN(NAME=~"esercizio.codice~") COLUMN(NAME=~"conto.codice~") COLUMN(NAME=~"conto.descrizione~") COLUMN(NAME=~"reg_pdc.id_reg_pdc~") COLUMN(NAME=~"reg_pdc.data~") COLUMN(NAME=~"reg_pdc.num_prog~") COLUMN(NAME=~"reg_pdc.descrizione~") COLUMN(NAME=~"reg_pdc.valore~") COLUMN(NAME=~"reg_pdc.liv_provvisorieta~") COLUMN(NAME=~"reg_pdc.segno~") COLUMN(NAME=~"reg_pdc.id_documento~") COLUMN(NAME=~"reg_pdc.id_reg_pd~") COLUMN(NAME=~"reg_pdc.id_cen_cos_t~") COLUMN(NAME=~"reg_pdc.id_conto~")    JOIN (LEFT=~"conto.id_conto~"    OP =~"=~"RIGHT=~"reg_pdc.id_conto~" )    JOIN (LEFT=~"esercizio.id_esercizio~"    OP =~"=~"RIGHT=~"reg_pdc.id_esercizio~" )) ORDER(NAME=~"reg_pdc.num_prog~" ASC=yes ) "  sort="c_num_prog A esercizio_codice A " )
