 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"articolo~" )  TABLE(NAME=~"sog_commerciale~" )  TABLE(NAME=~"cat_com_sc~" )  TABLE(NAME=~"anagrafica~" )  TABLE(NAME=~"cat_com_articolo~" )  TABLE(NAME=~"unita_confezione~" )  TABLE(NAME=~"azienda~" ) COLUMN(NAME=~"articolo.codice~") COLUMN(NAME=~"articolo.descrizione~") COLUMN(NAME=~"cat_com_sc.descrizione~") COLUMN(NAME=~"cat_com_articolo.descrizione~") COMPUTE(NAME=~"CAST(0 AS NUMERIC(18,4) ) AS qta_sconto_merce~") COLUMN(NAME=~"anagrafica.rag_soc_1~") COLUMN(NAME=~"sog_commerciale.codice~") COLUMN(NAME=~"articolo.id_articolo~") COLUMN(NAME=~"unita_confezione.id_unita_confezione~") COMPUTE(NAME=~"CAST(0 AS INTEGER) AS riga_documento_id_listino~") COMPUTE(NAME=~"CAST(0 AS INTEGER) AS riga_documento_id_con_lis_articolo~") COLUMN(NAME=~"sog_commerciale.id_sog_commerciale~") COMPUTE(NAME=~"CAST(:id_locazione_1 AS INTEGER ) AS id_locazione_1~") COMPUTE(NAME=~"CAST(:id_valuta AS INTEGER) AS riga_documento_id_valuta~") COLUMN(NAME=~"azienda.rag_soc_1~") COMPUTE(NAME=~"CAST('' AS CHAR(40) ) AS sconto~") COMPUTE(NAME=~"CAST(0 AS NUMERIC(18,4) ) AS riga_documento_sconto_riga~") COMPUTE(NAME=~"CAST(0 AS dm_imp_6_dec ) AS prezzo~") COMPUTE(NAME=~"CAST(0 AS dm_imp_6_dec) AS prezzo_netto~") COLUMN(NAME=~"cat_com_articolo.codice~") COLUMN(NAME=~"cat_com_sc.codice~")    JOIN (LEFT=~"cat_com_sc.id_cat_com_sc~"    OP =~"=~"RIGHT=~"sog_commerciale.id_cat_com_sc~"    OUTER2 =~"sog_commerciale.id_cat_com_sc~" )    JOIN (LEFT=~"cat_com_articolo.id_cat_com_articolo~"    OP =~"=~"RIGHT=~"articolo.id_cat_com_articolo~"    OUTER2 =~"articolo.id_cat_com_articolo~" )    JOIN (LEFT=~"unita_confezione.id_articolo~"    OP =~"=~"RIGHT=~"articolo.id_articolo~"    OUTER2 =~"articolo.id_articolo~" )    JOIN (LEFT=~"anagrafica.id_anagrafica~"    OP =~"=~"RIGHT=~"sog_commerciale.id_anagrafica~" )    JOIN (LEFT=~"azienda.id_azienda~"    OP =~"=~"RIGHT=~"articolo.id_azienda~" )) ARG(NAME = ~"parametri~" TYPE = string)  ARG(NAME = ~"id_locazione_1~" TYPE = number)  ARG(NAME = ~"id_valuta~" TYPE = number) " arguments=(("parametri", string),("id_locazione_1", number),("id_valuta", number)) )
