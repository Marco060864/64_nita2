table(column=(type=long updatewhereclause=yes identity=yes name=id_articolo dbname="articolo.id_articolo" )
 column=(type=char(32) updatewhereclause=yes name=codice dbname="articolo.codice" )
 column=(type=char(80) updatewhereclause=yes name=descrizione dbname="articolo.descrizione" )
 column=(type=char(40) updatewhereclause=yes name=c_sconto dbname="c_sconto" )
 column=(type=decimal(0) updatewhereclause=yes name=c_id_listino dbname="c_id_listino" )
 column=(type=decimal(0) updatewhereclause=yes name=c_id_valuta dbname="c_id_valuta" )
 column=(type=char(40) updatewhereclause=yes name=cat_com_art_descrizione dbname="cat_com_art_descrizione" )
 column=(type=char(40) updatewhereclause=yes name=rag_soc_1 dbname="rag_soc_1" )
 column=(type=char(40) updatewhereclause=yes name=cat_com_sc_descrizione dbname="cat_com_sc_descrizione" )
 column=(type=char(1) updatewhereclause=yes name=tipo_applicazione dbname="tipo_applicazione" )
 column=(type=decimal(4) updatewhereclause=yes name=importo dbname="importo" )
 column=(type=char(40) updatewhereclause=yes name=percentuali dbname="percentuali" )
 column=(type=decimal(6) updatewhereclause=yes name=c_prezzo_n dbname="c_prezzo_n" )
 column=(type=decimal(6) updatewhereclause=yes name=c_prezzo_l dbname="c_prezzo_l" )
 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"articolo~" ) COLUMN(NAME=~"articolo.id_articolo~") COLUMN(NAME=~"articolo.codice~") COLUMN(NAME=~"articolo.descrizione~") COMPUTE(NAME=~"cast(null as char(40)) as c_sconto~") COMPUTE(NAME=~"cast( 0 as numeric) as c_id_listino~") COMPUTE(NAME=~"cast( 0 as numeric) as c_id_valuta~") COMPUTE(NAME=~"cast(null as char(40)) as cat_com_art_descrizione~") COMPUTE(NAME=~"cast(null as char(40)) as rag_soc_1~") COMPUTE(NAME=~"cast(null as char(40)) as cat_com_sc_descrizione~") COMPUTE(NAME=~"cast(null as char(1)) as tipo_applicazione~") COMPUTE(NAME=~"cast(0 as numeric(18,4)) as importo~") COMPUTE(NAME=~"cast(NULL as char(40)) as percentuali~") COMPUTE(NAME=~"cast(0 as dm_imp_6_dec) as c_prezzo_n~") COMPUTE(NAME=~"cast(0 as dm_imp_6_dec) as c_prezzo_l~")WHERE(    EXP1 =~"~~~"articolo~~~".~~~"codice~~~"~"   OP =~">=~"    EXP2 =~":da_art~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"articolo~~~".~~~"codice~~~"~"   OP =~"<=~"    EXP2 =~":a_art~" ) ) ORDER(NAME=~"articolo.codice~" ASC=yes ) ARG(NAME = ~"da_art~" TYPE = string)  ARG(NAME = ~"a_art~" TYPE = string) " arguments=(("da_art", string),("a_art", string)) )
