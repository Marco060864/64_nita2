 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"prezzo~" )  TABLE(NAME=~"unita_confezione~" )  TABLE(NAME=~"articolo~" )  TABLE(NAME=~"azienda~" )  TABLE(NAME=~"listino~" )  TABLE(NAME=~"variazione~" )  TABLE(NAME=~"sog_commerciale~" )  TABLE(NAME=~"cat_merceologica~" ) COLUMN(NAME=~"articolo.codice~") COLUMN(NAME=~"articolo.descrizione~") COLUMN(NAME=~"azienda.rag_soc_1~") COLUMN(NAME=~"listino.codice~") COLUMN(NAME=~"variazione.data_inizio~") COLUMN(NAME=~"variazione.data_fine~") COLUMN(NAME=~"listino.descrizione~") COLUMN(NAME=~"cat_merceologica.codice~") COLUMN(NAME=~"cat_merceologica.descrizione~") COLUMN(NAME=~"listino.id_valuta~") COLUMN(NAME=~"prezzo.prezzo~")    JOIN (LEFT=~"sog_commerciale.id_sog_commerciale~"    OP =~"=~"RIGHT=~"articolo.id_sog_commerciale~"    OUTER2 =~"articolo.id_sog_commerciale~" )    JOIN (LEFT=~"cat_merceologica.id_cat_merceologica~"    OP =~"=~"RIGHT=~"articolo.id_cat_merceologica~"    OUTER2 =~"articolo.id_cat_merceologica~" )    JOIN (LEFT=~"unita_confezione.id_unita_confezione~"    OP =~"=~"RIGHT=~"prezzo.id_unita_confezione~" )    JOIN (LEFT=~"articolo.id_articolo~"    OP =~"=~"RIGHT=~"unita_confezione.id_articolo~" )    JOIN (LEFT=~"azienda.id_azienda~"    OP =~"=~"RIGHT=~"articolo.id_azienda~" )    JOIN (LEFT=~"listino.id_listino~"    OP =~"=~"RIGHT=~"variazione.id_listino~" )    JOIN (LEFT=~"variazione.id_variazione~"    OP =~"=~"RIGHT=~"prezzo.id_variazione~" )WHERE(    EXP1 =~"~~~"prezzo~~~".~~~"id_variazione~~~"~"   OP =~"=~"    EXP2 =~":rn_id_variazione_1~" ) ) ARG(NAME = ~"rn_id_variazione_1~" TYPE = number)  ARG(NAME = ~"rs_parametri~" TYPE = string) " arguments=(("rn_id_variazione_1", number),("rs_parametri", string)) )
