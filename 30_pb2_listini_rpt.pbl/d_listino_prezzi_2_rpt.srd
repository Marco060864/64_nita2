 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"prezzo~" )  TABLE(NAME=~"unita_confezione~" )  TABLE(NAME=~"articolo~" )  TABLE(NAME=~"azienda~" )  TABLE(NAME=~"listino~" ALIAS=~"listino_a~" )  TABLE(NAME=~"variazione~" ALIAS=~"variazione_a~" )  TABLE(NAME=~"sog_commerciale~" )  TABLE(NAME=~"listino~" ALIAS=~"listino_b~" )  TABLE(NAME=~"variazione~" ALIAS=~"variazione_b~" ) COLUMN(NAME=~"articolo.codice~") COLUMN(NAME=~"articolo.descrizione~") COLUMN(NAME=~"azienda.rag_soc_1~") COLUMN(NAME=~"listino_a.codice~") COLUMN(NAME=~"listino_a.descrizione~") COLUMN(NAME=~"variazione_a.data_inizio~") COLUMN(NAME=~"variazione_a.data_fine~") COLUMN(NAME=~"listino_b.codice~") COLUMN(NAME=~"listino_b.descrizione~") COLUMN(NAME=~"variazione_b.data_inizio~") COLUMN(NAME=~"variazione_b.data_fine~") COLUMN(NAME=~"listino_a.id_valuta~") COLUMN(NAME=~"listino_b.id_valuta~") COLUMN(NAME=~"prezzo.prezzo~") COMPUTE(NAME=~"CAST ( ( SELECT p2.prezzo FROM prezzo p2 WHERE p2.id_unita_confezione = ~~~"prezzo~~~".~~~"id_unita_confezione~~~" AND p2.id_variazione = :rn_id_variazione_2 ) AS dm_imp_6_dec ) AS prezzo_2~")    JOIN (LEFT=~"sog_commerciale.id_sog_commerciale~"    OP =~"=~"RIGHT=~"articolo.id_sog_commerciale~"    OUTER2 =~"articolo.id_sog_commerciale~" )    JOIN (LEFT=~"unita_confezione.id_unita_confezione~"    OP =~"=~"RIGHT=~"prezzo.id_unita_confezione~" )    JOIN (LEFT=~"articolo.id_articolo~"    OP =~"=~"RIGHT=~"unita_confezione.id_articolo~" )    JOIN (LEFT=~"azienda.id_azienda~"    OP =~"=~"RIGHT=~"articolo.id_azienda~" )    JOIN (LEFT=~"listino_a.id_listino~"    OP =~"=~"RIGHT=~"variazione_a.id_listino~" )    JOIN (LEFT=~"variazione_a.id_variazione~"    OP =~"=~"RIGHT=~"prezzo.id_variazione~" )    JOIN (LEFT=~"variazione_b.id_listino~"    OP =~"=~"RIGHT=~"listino_b.id_listino~" )WHERE(    EXP1 =~"~~~"prezzo~~~".~~~"id_variazione~~~"~"   OP =~"=~"    EXP2 =~":rn_id_variazione_1~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"variazione_b~~~".~~~"id_variazione~~~"~"   OP =~"=~"    EXP2 =~":rn_id_variazione_2~" ) ) ARG(NAME = ~"rn_id_variazione_1~" TYPE = number)  ARG(NAME = ~"rn_id_variazione_2~" TYPE = number)  ARG(NAME = ~"rs_parametri~" TYPE = string) " arguments=(("rn_id_variazione_1", number),("rn_id_variazione_2", number),("rs_parametri", string)) )
