 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"articolo~" )  TABLE(NAME=~"sog_commerciale~" )  TABLE(NAME=~"cat_merceologica~" )  TABLE(NAME=~"unita_confezione~" )  TABLE(NAME=~"azienda~" )  TABLE(NAME=~"listino~" )  TABLE(NAME=~"variazione~" ) COLUMN(NAME=~"articolo.codice~") COLUMN(NAME=~"articolo.descrizione~") COLUMN(NAME=~"azienda.rag_soc_1~") COLUMN(NAME=~"listino.codice~") COLUMN(NAME=~"variazione.data_inizio~") COLUMN(NAME=~"variazione.data_fine~") COLUMN(NAME=~"listino.descrizione~") COLUMN(NAME=~"unita_confezione.molteplicita~") COLUMN(NAME=~"unita_confezione.codice~") COLUMN(NAME=~"unita_confezione.descrizione~") COLUMN(NAME=~"cat_merceologica.codice~") COMPUTE(NAME=~"CAST( fn_unita_non_base(~~~"articolo~~~".~~~"id_articolo~~~") AS CHAR(24) ) AS unita_non_base~") COMPUTE(NAME=~"SUBSTRING(unita_non_base, 1, 8) AS unita1~") COMPUTE(NAME=~"SUBSTRING(unita_non_base, 9, 8) AS unita2~") COMPUTE(NAME=~"SUBSTRING(unita_non_base, 17, 8) AS unita3~") COLUMN(NAME=~"listino.id_valuta~") COMPUTE(NAME=~"CAST( ( SELECT prezzo FROM prezzo WHERE id_unita_confezione = ~~~"unita_confezione~~~".~~~"id_unita_confezione~~~" AND id_variazione = :rn_id_variazione_1 ) AS NUMERIC(18,4) ) AS prezzo~")    JOIN (LEFT=~"articolo.id_sog_commerciale~"    OP =~"=~"RIGHT=~"sog_commerciale.id_sog_commerciale~"    OUTER1 =~"articolo.id_sog_commerciale~" )    JOIN (LEFT=~"articolo.id_cat_merceologica~"    OP =~"=~"RIGHT=~"cat_merceologica.id_cat_merceologica~"    OUTER1 =~"articolo.id_cat_merceologica~" )    JOIN (LEFT=~"listino.id_listino~"    OP =~"=~"RIGHT=~"variazione.id_listino~"    OUTER2 =~"variazione.id_listino~" )    JOIN (LEFT=~"articolo.id_articolo~"    OP =~"=~"RIGHT=~"unita_confezione.id_articolo~" )    JOIN (LEFT=~"azienda.id_azienda~"    OP =~"=~"RIGHT=~"articolo.id_azienda~" )WHERE(    EXP1 =~"~~~"variazione~~~".~~~"id_variazione~~~"~"   OP =~"=~"    EXP2 =~":rn_id_variazione_1~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"unita_confezione~~~".~~~"unita_base~~~"~"   OP =~"=~"    EXP2 =~"'S'~" ) ) ARG(NAME = ~"rn_id_variazione_1~" TYPE = number)  ARG(NAME = ~"rs_parametri~" TYPE = string) " arguments=(("rn_id_variazione_1", number),("rs_parametri", string)) )
