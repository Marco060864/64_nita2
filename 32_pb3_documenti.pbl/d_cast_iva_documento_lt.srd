 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"cast_iva_documento~" )  TABLE(NAME=~"tab_iva~" ) COLUMN(NAME=~"cast_iva_documento.id_documento~") COLUMN(NAME=~"cast_iva_documento.id_tab_iva~") COLUMN(NAME=~"cast_iva_documento.val_omaggi~") COLUMN(NAME=~"cast_iva_documento.val_imponibile~") COLUMN(NAME=~"cast_iva_documento.val_imp_scontato~") COLUMN(NAME=~"cast_iva_documento.val_spese~") COLUMN(NAME=~"cast_iva_documento.val_tot_imp_v~") COLUMN(NAME=~"cast_iva_documento.val_tot_imp_l~") COLUMN(NAME=~"cast_iva_documento.val_tot_iva_v~") COLUMN(NAME=~"cast_iva_documento.val_tot_iva_l~") COLUMN(NAME=~"tab_iva.codice~") COMPUTE(NAME=~"CAST (0 as numeric(18,4)) as c_prop_imp~") COMPUTE(NAME=~"CAST (~~~"tab_iva~~~".~~~"per_aliquota~~~" as numeric(18,2)) as c_aliquota~") COMPUTE(NAME=~"CAST (~~~"tab_iva~~~".~~~"per_detrazione~~~" as numeric(18,4)) as c_per_detrazione~") COMPUTE(NAME=~"CAST (NULL as numeric(18,4)) as c_acconto~")    JOIN (LEFT=~"tab_iva.id_tab_iva~"    OP =~"=~"RIGHT=~"cast_iva_documento.id_tab_iva~" )WHERE(    EXP1 =~"~~~"cast_iva_documento~~~".~~~"id_documento~~~"~"   OP =~"=~"    EXP2 =~":ra_id_documento~" ) ) ARG(NAME = ~"ra_id_documento~" TYPE = number) " update="cast_iva_documento" updatewhere=1 updatekeyinplace=yes arguments=(("ra_id_documento", number)) )
