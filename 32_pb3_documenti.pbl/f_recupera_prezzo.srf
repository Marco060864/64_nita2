global type f_recupera_prezzo from function_object
end type

forward prototypes
global function string f_recupera_prezzo (string ls_app, long ll_id_u_c_in_esame, long ll_sog_com, long ll_id_cat_com_sc, string ls_cod_art_in_esame, long ll_id_cat_com_articolo, long ll_sog_com_fornitore, long ll_id_produttore, decimal ld_qta, string ls_tipo_applicazione, long al_id_articolo, long al_id_magazzino, long al_id_valuta)
end prototypes

global function string f_recupera_prezzo (string ls_app, long ll_id_u_c_in_esame, long ll_sog_com, long ll_id_cat_com_sc, string ls_cod_art_in_esame, long ll_id_cat_com_articolo, long ll_sog_com_fornitore, long ll_id_produttore, decimal ld_qta, string ls_tipo_applicazione, long al_id_articolo, long al_id_magazzino, long al_id_valuta);
string ls_ritorno,ls_filtro,ls_percentuali,ls_spesa,ls_tipo, ls_lis_variazione
decimal ld_prezzo,ld_importo,ld_cambio,ld_cambio_doc,ld_spesa_fissa
decimal ld_percentuali,ld_spesa

date ldt_data_attuale
integer li_ret
long ll_listino,ll_variazione,ll_valuta,ll_attivita
ldt_data_attuale=today()
select cambio 
into :ld_cambio_doc
from valuta
where id_valuta=:al_id_valuta;
ls_tipo=ls_app
datastore lds_rec_prezzo
lds_rec_prezzo=create datastore
lds_rec_prezzo.dataobject="d_recupera_prezzo_gd"
lds_rec_prezzo.settransobject(sqlca)
lds_rec_prezzo.retrieve(ldt_data_attuale)

ls_filtro = ""

if ls_app = 'V' then
	ls_filtro = "(applicazione = '" +ls_app +"')"
	if not isnull(ll_id_u_c_in_esame) then 
		ls_filtro=ls_filtro + " AND (id_unita_confezione = " +string(ll_id_u_c_in_esame)+ ")"
	else
		ls_filtro=ls_filtro + " AND (ISNULL(id_unita_confezione)) "
	end if
	if not isnull(ll_sog_com) then
		ls_filtro=ls_filtro + " AND (id_sog_commerciale = " + string(ll_sog_com)+ ")"
	else
		ls_filtro=ls_filtro + " AND (ISNULL(id_sog_commerciale))"
	end if
	if not isnull(ll_id_cat_com_sc) then
		ls_filtro=ls_filtro + " AND (id_cat_com_sc = "+ string(ll_id_cat_com_sc)+ ")"
	else
		ls_filtro=ls_filtro + " AND (ISNULL(id_cat_com_sc))"
	end if	
	if not isnull(ls_cod_art_in_esame) then
		ls_filtro=ls_filtro + " AND (cod_art_da <= '"+string(ls_cod_art_in_esame)+"') AND (cod_art_a >= '"+string(ls_cod_art_in_esame)+ "')"
	else
		ls_filtro=ls_filtro + " AND (ISNULL(cod_art_da)) AND (ISNULL(cod_art_a))"
	end if		
	if not isnull(ll_id_cat_com_articolo) then
		ls_filtro=ls_filtro + " AND (id_cat_com_articolo = "+string(ll_id_cat_com_articolo)+ ")"
	else
		ls_filtro=ls_filtro + " AND (ISNULL(id_cat_com_articolo))"
	end if			
	if not isnull(ll_sog_com_fornitore) then
		ls_filtro=ls_filtro + " AND (id_sog_commerciale_forn = "+string(ll_sog_com_fornitore)+ ")"
	else
		ls_filtro=ls_filtro + " AND (ISNULL(id_sog_commerciale_forn))"
	end if				
	if not isnull(ll_id_produttore) then
		ls_filtro=ls_filtro + " AND	(id_anagrafica = "+string(ll_id_produttore)+ ")"
	else
		ls_filtro=ls_filtro + " AND (ISNULL(id_anagrafica))"
	end if					
	if not isnull(ld_qta) then
		ls_filtro=ls_filtro + " AND (qta_minima <= real('"+string(ld_qta)+")) AND (qta_massima >= real('"+string(ld_qta) + "))"
	else
		ls_filtro=ls_filtro + " AND (ISNULL(qta_minima)) AND (ISNULL(qta_massima))"
	end if						

else
	ls_filtro = "(applicazione = '" +ls_app +"')"
	if not isnull(ll_id_u_c_in_esame) then 
		ls_filtro=ls_filtro + " AND (id_unita_confezione = " +string(ll_id_u_c_in_esame)+ ")"
	else
		ls_filtro=ls_filtro + " AND (ISNULL(id_unita_confezione)) "
	end if
	if not isnull(ll_sog_com) then
		ls_filtro=ls_filtro + " AND (id_listino = " + string(ll_sog_com)+ ")"
	else
		ls_filtro=ls_filtro + " AND (ISNULL(id_listino))"
	end if
	if not isnull(ll_id_cat_com_sc) then
		ls_filtro=ls_filtro + " AND (id_cat_com_sc = "+ string(ll_id_cat_com_sc)+ ")"
	else
		ls_filtro=ls_filtro + " AND (ISNULL(id_cat_com_sc))"
	end if	
	if not isnull(ls_cod_art_in_esame) then
		ls_filtro=ls_filtro + " AND (cod_art_da <= '"+string(ls_cod_art_in_esame)+"') AND (cod_art_a >= '"+string(ls_cod_art_in_esame)+ "')"
	else
		ls_filtro=ls_filtro + " AND (ISNULL(cod_art_da)) AND (ISNULL(cod_art_a))"
	end if		
	if not isnull(ll_id_cat_com_articolo) then
		ls_filtro=ls_filtro + " AND (id_cat_com_articolo = "+string(ll_id_cat_com_articolo)+ ")"
	else
		ls_filtro=ls_filtro + " AND (ISNULL(id_cat_com_articolo))"
	end if			
	if not isnull(ll_sog_com_fornitore) then
		ls_filtro=ls_filtro + " AND (id_sog_commerciale_forn = "+string(ll_sog_com_fornitore)+ ")"
	else
		ls_filtro=ls_filtro + " AND (ISNULL(id_sog_commerciale_forn))"
	end if				
	if not isnull(ll_id_produttore) then
		ls_filtro=ls_filtro + " AND	(id_anagrafica = "+string(ll_id_produttore)+ ")"
	else
		ls_filtro=ls_filtro + " AND (ISNULL(id_anagrafica))"
	end if					
	if not isnull(ld_qta) then
		ls_filtro=ls_filtro + " AND (qta_minima <= real('"+string(ld_qta)+")) AND (qta_massima >= real('"+string(ld_qta) + "))"
	else
		ls_filtro=ls_filtro + " AND (ISNULL(qta_minima)) AND (ISNULL(qta_massima))"
	end if						
	


end if	

CHOOSE CASE ls_tipo_applicazione
	CASE 'P','I','C'		
		
		ls_filtro=ls_filtro+" AND ((tipo_applicazione='P') OR (tipo_applicazione='I') OR (tipo_applicazione='C'))"
		
		
		
		
		lds_rec_prezzo.setfilter(ls_filtro)
		lds_rec_prezzo.filter()

		li_ret=lds_rec_prezzo.rowcount()
		li_ret=1
	
		if lds_rec_prezzo.rowcount()>0 then

			ls_spesa=lds_rec_prezzo.getitemstring(1,"spesa")
			ls_percentuali=lds_rec_prezzo.getitemstring(1,"percentuali")
			ld_spesa_fissa=lds_rec_prezzo.getitemnumber(1,"spesa_fissa")
			
			
			ls_tipo_applicazione=lds_rec_prezzo.getitemstring(1,"tipo_applicazione")
			
			
			if li_ret=1 then
				if lds_rec_prezzo.rowcount()>0 then
					if ls_tipo_applicazione='P' then
					
						ld_importo=lds_rec_prezzo.getitemdecimal(1,"importo")					
						if ld_importo>0 then
							ld_prezzo=ld_importo
							
							if ls_spesa<>"" and not isnull(ls_spesa) then 
								ld_prezzo=f_string_dec_prezzo(ls_spesa,ld_prezzo)
							end if
							if ls_percentuali<>"" and not isnull(ls_percentuali) then
								ld_prezzo=f_string_dec_prezzo(ls_percentuali,ld_prezzo)
							end if
							if not isnull(ld_spesa_fissa) then ld_prezzo=ld_prezzo+ld_spesa_fissa
							ll_valuta=lds_rec_prezzo.getitemnumber(1,"id_valuta")
							if ll_valuta<>al_id_valuta then							
								
								
								select cambio 
								into :ld_cambio
								from valuta
								where id_valuta=:ll_valuta;
								ld_importo=ld_importo*ld_cambio								
								ld_prezzo=ld_importo / ld_cambio_doc
							end if
							ls_ritorno=string(ld_prezzo)
						else
							
							
							
							ll_listino=lds_rec_prezzo.getitemnumber(1,"id_listino")
							if ll_listino>0 then
								select id_variazione
								into :ll_variazione
								from variazione
								where id_listino=:ll_listino
								AND 	(data_inizio <= :ldt_data_attuale AND (data_fine >= :ldt_data_attuale OR data_fine IS NULL));
								if sqlca.sqlcode=0 then
									select prezzo
									into :ld_prezzo
									from prezzo
									where id_variazione=:ll_variazione
									and id_unita_confezione=:ll_id_u_c_in_esame;
								
									
									
									if ls_spesa<>"" and not isnull(ls_spesa) then 
										ld_prezzo=f_string_dec_prezzo(ls_spesa,ld_prezzo)
									end if
									if ls_percentuali<>"" and not isnull(ls_percentuali) then
										ld_prezzo=f_string_dec_prezzo(ls_percentuali,ld_prezzo)
									end if
									if not isnull(ld_spesa_fissa) then ld_prezzo=ld_prezzo+ld_spesa_fissa
									
									select id_valuta
									into :ll_valuta
									from listino
									where id_listino=:ll_listino;
									
									
									if ll_valuta<>al_id_valuta then
										select cambio 
										into :ld_cambio
										from valuta
										where id_valuta=:ll_valuta;
										ld_prezzo=ld_prezzo*ld_cambio
										
										ld_prezzo=ld_prezzo / ld_cambio_doc										
									end if
									ls_ritorno=string(ld_prezzo)
										
									
									
									ls_lis_variazione=string(ll_variazione)
									
								else
									messagebox("Errore!","Errore nel recupero della variazione!",stopsign!)
								end if
						end if
						end if
					elseif ls_tipo_applicazione='I' then
						
						
						
						ll_listino=lds_rec_prezzo.getitemnumber(1,"id_listino")
						if ll_listino>0 then
							select id_variazione
							into :ll_variazione
							from variazione
							where id_listino=:ll_listino
							AND 	(data_inizio <= :ldt_data_attuale AND (data_fine >= :ldt_data_attuale OR data_fine IS NULL));
							if sqlca.sqlcode=0 then
								select prezzo
								into :ld_prezzo
								from prezzo
								where id_variazione=:ll_variazione
								and id_unita_confezione=:ll_id_u_c_in_esame;
								
								
								
								
								if ls_spesa<>"" and not isnull(ls_spesa) then 
									ld_prezzo=f_string_dec_prezzo(ls_spesa,ld_prezzo)
								end if
								if ls_percentuali<>"" and not isnull(ls_percentuali) then
									ld_prezzo=f_string_dec_prezzo(ls_percentuali,ld_prezzo)
								end if
								if not isnull(ld_spesa_fissa) then ld_prezzo=ld_prezzo+ld_spesa_fissa
								
								select id_valuta
								into :ll_valuta
								from listino
								where id_listino=:ll_listino;
								
								
								if ll_valuta<>al_id_valuta then
									select cambio 
									into :ld_cambio
									from valuta
									where id_valuta=:ll_valuta;
									ld_prezzo=ld_prezzo*ld_cambio
									
									ld_prezzo=ld_prezzo / ld_cambio_doc									
								end if
								ls_ritorno=string(ld_prezzo)
								
									
									
									ls_lis_variazione=string(ll_variazione)
								
							else
								messagebox("Errore!","Errore nel recupero della variazione!",stopsign!)
							end if
						end if
					else
						
						
						select id_attivita
						into :ll_attivita
						from azienda
						where id_azienda=1;
						
						select cmc
						into :ld_prezzo
						from cmc
						where id_magazzino=:al_id_magazzino
						and id_articolo=:al_id_articolo
						and id_attivita=:ll_attivita;
						if sqlca.sqlcode=0 then
							
							
							if ld_cambio_doc<>1 then
								
								ld_prezzo=ld_prezzo / ld_cambio_doc								
							end if
							ls_ritorno=string(ld_prezzo)
						else
							messagebox("Errore!","Si è verificato un errore recuperando il costo medio continuo",stopsign!)
						end if
					end if
				end if
			else
				messagebox("Errore!","Errore applicando il filtro!",stopsign!)
			end if
		else
			
			
			
			
			
			
			
			
			
			
			
			
			
			
			if ls_app = 'V' then
				select id_listino
				into :ll_listino
				from sog_commerciale
				where id_sog_commerciale=:ll_sog_com;
			else
				ll_listino = ll_sog_com
			end if
			
			
			
			select id_variazione
			into :ll_variazione
			from variazione
			where id_listino=:ll_listino
			AND 	(data_inizio <= :ldt_data_attuale AND (data_fine >= :ldt_data_attuale OR data_fine IS NULL)); 
			
			select prezzo
			into :ld_prezzo
			from prezzo
			where id_variazione=:ll_variazione
			and id_unita_confezione=:ll_id_u_c_in_esame;
			if ld_prezzo>0 and not isnull(ld_prezzo) then
				
				
				
				ls_lis_variazione=string(ll_variazione)
				
				
				
				select id_valuta
				into :ll_valuta
				from listino
				where id_listino=:ll_listino;
				
				
				if ll_valuta<>al_id_valuta then
					select cambio 
					into :ld_cambio
					from valuta
					where id_valuta=:ll_valuta;
					ld_prezzo=ld_prezzo*ld_cambio						
					ld_prezzo=ld_prezzo / ld_cambio_doc					
				end if
				ls_ritorno=string(ld_prezzo)
				
			else
				
				
				
				
					
					
					select v.id_variazione,l.id_listino
					into :ll_variazione,:ll_listino
					from variazione v, listino l
					where l.lis_base='S'
					and l.tipo=:ls_tipo
					AND 	(data_inizio <= :ldt_data_attuale AND (data_fine >= :ldt_data_attuale OR data_fine IS NULL));
								
					
					select prezzo
					into :ld_prezzo
					from prezzo
					where id_variazione=:ll_variazione
					and id_unita_confezione=:ll_id_u_c_in_esame;
					if ld_prezzo>0 and not isnull(ld_prezzo) then
						
						
						
						ls_lis_variazione=string(ll_variazione)
						
						
						
						select id_valuta
						into :ll_valuta
						from listino
						where id_listino=:ll_listino;
						
						
						if ll_valuta<>al_id_valuta then
							select cambio 
							into :ld_cambio
							from valuta
							where id_valuta=:ll_valuta;
							ld_prezzo=ld_prezzo*ld_cambio						
							ld_prezzo=ld_prezzo / ld_cambio_doc							
						end if
						ls_ritorno=string(ld_prezzo)
					end if
			end if
		end if
	CASE 'S'
		ls_lis_variazione=""
		
		ls_filtro=ls_filtro+" AND	tipo_applicazione IN ('S')" 
		
		lds_rec_prezzo.setfilter(ls_filtro)
		lds_rec_prezzo.filter()
		if lds_rec_prezzo.rowcount()>0 then
			ls_percentuali=lds_rec_prezzo.getitemstring(1,"percentuali")
			ls_ritorno=ls_percentuali
		end if
	CASE 'R'
		ls_lis_variazione=""
		
		ls_filtro=ls_filtro+" AND	tipo_applicazione IN ('R')" 
		
		lds_rec_prezzo.setfilter(ls_filtro)
		lds_rec_prezzo.filter()
		if lds_rec_prezzo.rowcount()>0 then
			ld_importo=lds_rec_prezzo.getitemdecimal(1,"importo")
			ld_importo=ld_importo*ld_qta
			ls_ritorno=string(ld_importo)
		end if
	CASE 'D'
		ls_lis_variazione=""
		
		ls_filtro=ls_filtro+" AND	tipo_applicazione IN ('D')" 
		
		lds_rec_prezzo.setfilter(ls_filtro)
		lds_rec_prezzo.filter()
		if lds_rec_prezzo.rowcount()>0 then
			ls_percentuali=lds_rec_prezzo.getitemstring(1,"percentuali")
			ls_ritorno=ls_percentuali
		end if
END CHOOSE
destroy lds_rec_prezzo;
if ls_ritorno="" or isnull(ls_ritorno) then 
	ls_ritorno="0"
else
	if not isnull(ls_lis_variazione) and ls_lis_variazione>"" and not ls_ritorno="0" then
		ls_ritorno=ls_ritorno+"!"+ls_lis_variazione
	end if
end if
return ls_ritorno
end function

