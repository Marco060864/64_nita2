 column=(type=long updatewhereclause=yes name=id_valuta dbname="documento.id_valuta" )
 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"documento~" )  TABLE(NAME=~"prof_documento~" )  TABLE(NAME=~"riga_documento~" ) COLUMN(NAME=~"documento.id_documento~") COLUMN(NAME=~"documento.num_progressivo~") COLUMN(NAME=~"documento.data_registrazione~") COLUMN(NAME=~"documento.num_documento~") COLUMN(NAME=~"documento.data_documento~") COLUMN(NAME=~"documento.id_prof_registrazione~") COLUMN(NAME=~"documento.id_sog_commerciale~") COLUMN(NAME=~"prof_documento.fat_anticipo~") COLUMN(NAME=~"documento.id_prof_documento~") COLUMN(NAME=~"riga_documento.id_riga_documento~") COLUMN(NAME=~"riga_documento.id_valuta~") COLUMN(NAME=~"riga_documento.id_tab_iva~") COLUMN(NAME=~"riga_documento.tot_riga_val_riga~") COLUMN(NAME=~"documento.id_tipo_pagamento~") COLUMN(NAME=~"documento.storno_anticipi~") COMPUTE(NAME=~"cast(0 as numeric(18,4)) as da_scaricare~") COMPUTE(NAME=~"cast(0 as numeric(18,4)) as ripristina~") COMPUTE(NAME=~"cast(0 as numeric(18,4)) as controllo~") COLUMN(NAME=~"riga_documento.tot_riga_val_az~") COLUMN(NAME=~"documento.cambio~") COLUMN(NAME=~"documento.id_valuta~")    JOIN (LEFT=~"prof_documento.id_prof_documento~"    OP =~"=~"RIGHT=~"documento.id_prof_documento~" )    JOIN (LEFT=~"riga_documento.id_documento~"    OP =~"=~"RIGHT=~"documento.id_documento~" )WHERE(    EXP1 =~"( ( ~~~"prof_documento~~~".~~~"fat_anticipo~~~"~"   OP =~"=~"    EXP2 =~"'S' )~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"( ~~~"documento~~~".~~~"id_sog_commerciale~~~"~"   OP =~"=~"    EXP2 =~":ra_id_sog_comm )~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"(~~~"documento~~~".~~~"storno_anticipi~~~"~"   OP =~"<>~"    EXP2 =~"'S'~"    LOGIC =~"or~" ) WHERE(    EXP1 =~"~~~"documento~~~".~~~"storno_anticipi~~~"~"   OP =~"is~"    EXP2 =~"null) )~" ) ) ARG(NAME = ~"ra_id_sog_comm~" TYPE = number) " arguments=(("ra_id_sog_comm", number))  sort="id_tab_iva A id_tipo_pagamento A " )
group(level=1 header.height=0 trailer.height=0 by=("id_tab_iva" , "id_tipo_pagamento" ) header.color="536870912" trailer.color="553648127" )
