release 6;
datawindow(units=0 timer_interval=0 color=79741120 processing=0 print.documentname="" print.orientation = 0 print.margin.left = 110 print.margin.right = 110 print.margin.top = 97 print.margin.bottom = 97 print.paper.source = 0 print.paper.size = 0 print.prompt=no print.buttons=no print.preview.buttons=no )
header(height=16 color="536870912" )
summary(height=0 color="536870912" )
footer(height=20 color="536870912" )
detail(height=96 color="553648127" )
table(column=(type=decimal(0) updatewhereclause=yes name=documento_num_progressivo dbname="documento.num_progressivo" validation=" real(gettext())  >= 0" validationmsg="'Immettere un valore >= 0'" )
 column=(type=date updatewhereclause=yes name=documento_data_registrazione dbname="documento.data_registrazione" )
 column=(type=char(2) updatewhereclause=yes name=registro_tipo_registro dbname="registro.tipo_registro" validation=" gettext()  = 'IA' OR  gettext()  = 'IV' OR  gettext()  = 'IC' OR  gettext()  = 'MN' OR  gettext()  = 'PN' OR  gettext()  = 'PA' OR  gettext()  = 'PV' OR  gettext()  = 'OA' OR  gettext()  = 'OV' OR  gettext()  = 'DA' OR  gettext()  = 'DV' OR  gettext()  = 'LA' OR  gettext()  = 'LV' OR  gettext()  = 'GA' OR  gettext()  = 'GV'" validationmsg="'Immettere: IA, IV, MN, PN, OA, OP, DA, DV, LA, LP, GA, GV'" )
 column=(type=decimal(0) updatewhereclause=yes name=registro_numero dbname="registro.numero" validation=" real(gettext())  >= 0" validationmsg="'Immettere un valore >= 0'" )
 column=(type=decimal(0) updatewhereclause=yes name=riga_documento_num_riga dbname="riga_documento.num_riga" validation=" real(gettext())  >= 0" validationmsg="'Immettere un valore >= 0'" )
 column=(type=char(32) updatewhereclause=yes name=articolo_codice dbname="articolo.codice" )
 column=(type=long updatewhereclause=yes name=riga_documento_id_caus_magazzino dbname="riga_documento.id_caus_magazzino" )
 column=(type=char(32766) updatewhereclause=no name=riga_documento_descrizione dbname="riga_documento.descrizione" )
 column=(type=decimal(4) updatewhereclause=yes name=riga_documento_quantita dbname="riga_documento.quantita" validation=" real(gettext())  >= 0" validationmsg="'Immettere un valore >= 0'" )
 column=(type=decimal(4) updatewhereclause=yes name=riga_documento_qta_sconto_merce dbname="riga_documento.qta_sconto_merce" validation=" real(gettext())  >= 0" validationmsg="'Immettere un valore >= 0'" )
 column=(type=decimal(4) updatewhereclause=yes name=riga_documento_qta_evasa dbname="riga_documento.qta_evasa" validation=" real(gettext())  >= 0" validationmsg="'Immettere un valore >= 0'" )
 column=(type=decimal(4) updatewhereclause=yes name=cc_qta_ev dbname="c_qta_ev" )
 column=(type=decimal(4) updatewhereclause=yes name=cc_qtasm_ev dbname="c_qtasm_ev" )
 column=(type=long updatewhereclause=yes name=cc_id_riga dbname="c_id_riga" )
 column=(type=long updatewhereclause=yes name=cc_id_arti dbname="c_id_arti" )
 column=(type=long updatewhereclause=yes name=cc_id_un_conf dbname="c_id_un_conf" )
 column=(type=long updatewhereclause=yes name=cc_id_caus_orig dbname="c_id_caus_orig" )
 column=(type=long updatewhereclause=yes name=cc_id_loc1 dbname="c_id_loc1" )
 column=(type=long updatewhereclause=yes name=cc_id_loc2 dbname="c_id_loc2" )
 column=(type=long updatewhereclause=yes name=cc_id_valu dbname="c_id_valu" )
 column=(type=char(1) updatewhereclause=yes name=cc_cambiato dbname="c_cambiato" )
 column=(type=decimal(4) updatewhereclause=yes name=cc_handle dbname="c_handle" )
 column=(type=decimal(4) updatewhereclause=yes name=documento_imp_acconto dbname="documento.imp_acconto" )
 column=(type=long updatewhereclause=yes name=documento_id_tipo_pag_acconto dbname="documento.id_tipo_pag_acconto" )
 column=(type=long updatewhereclause=yes name=documento_id_tab_iva_acconto dbname="documento.id_tab_iva_acconto" )
 column=(type=long updatewhereclause=yes name=documento_id_val_acconto dbname="documento.id_val_acconto" )
 column=(type=char(1) update=yes updatewhereclause=yes name=riga_documento_forza_chius_evasione dbname="riga_documento.forza_chius_evasione" values="Si	S/No	N/" )
 column=(type=long updatewhereclause=yes key=yes identity=yes name=riga_documento_id_riga_documento dbname="riga_documento.id_riga_documento" )
 column=(type=decimal(2) updatewhereclause=yes name=riga_documento_peso_netto dbname="riga_documento.peso_netto" )
 column=(type=long updatewhereclause=yes name=riga_documento_id_riga_lotto dbname="riga_documento.id_riga_lotto" )
 column=(type=decimal(4) updatewhereclause=yes name=riga_documento_peso_netto_evaso dbname="riga_documento.peso_netto_evaso" )
 column=(type=decimal(4) updatewhereclause=yes name=cc_peso_ev dbname="c_peso_ev" )
 column=(type=long updatewhereclause=yes name=documento_id_sog_commerciale dbname="documento.id_sog_commerciale" )
 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"articolo~" )  TABLE(NAME=~"riga_documento~" )  TABLE(NAME=~"documento~" )  TABLE(NAME=~"registro~" ) COLUMN(NAME=~"documento.num_progressivo~") COLUMN(NAME=~"documento.data_registrazione~") COLUMN(NAME=~"registro.tipo_registro~") COLUMN(NAME=~"registro.numero~") COLUMN(NAME=~"riga_documento.num_riga~") COLUMN(NAME=~"articolo.codice~") COLUMN(NAME=~"riga_documento.id_caus_magazzino~") COLUMN(NAME=~"riga_documento.descrizione~") COLUMN(NAME=~"riga_documento.quantita~") COLUMN(NAME=~"riga_documento.qta_sconto_merce~") COLUMN(NAME=~"riga_documento.qta_evasa~") COMPUTE(NAME=~"cast (NULL as numeric(18,4)) as c_qta_ev~") COMPUTE(NAME=~"cast (NULL as numeric(18,4)) as c_qtasm_ev~") COMPUTE(NAME=~"cast (NULL as integer) as c_id_riga~") COMPUTE(NAME=~"cast (NULL as integer) as c_id_arti~") COMPUTE(NAME=~"cast (NULL as integer) as c_id_un_conf~") COMPUTE(NAME=~"cast (NULL as integer) as c_id_caus_orig~") COMPUTE(NAME=~"cast (NULL as integer) as c_id_loc1~") COMPUTE(NAME=~"cast (NULL as integer) as c_id_loc2~") COMPUTE(NAME=~"cast (NULL as integer) as c_id_valu~") COMPUTE(NAME=~"cast ('N' as char(1)) as c_cambiato~") COMPUTE(NAME=~"cast (NULL as numeric(18,4)) as c_handle~") COLUMN(NAME=~"documento.imp_acconto~") COLUMN(NAME=~"documento.id_tipo_pag_acconto~") COLUMN(NAME=~"documento.id_tab_iva_acconto~") COLUMN(NAME=~"documento.id_val_acconto~") COLUMN(NAME=~"riga_documento.forza_chius_evasione~") COLUMN(NAME=~"riga_documento.id_riga_documento~") COLUMN(NAME=~"riga_documento.peso_netto~") COLUMN(NAME=~"riga_documento.id_riga_lotto~") COLUMN(NAME=~"riga_documento.peso_netto_evaso~") COMPUTE(NAME=~"cast (NULL as numeric(18,4)) as c_peso_ev~") COLUMN(NAME=~"documento.id_sog_commerciale~")    JOIN (LEFT=~"articolo.id_articolo~"    OP =~"=~"RIGHT=~"riga_documento.id_articolo~"    OUTER1 =~"articolo.id_articolo~" )    JOIN (LEFT=~"documento.id_registro~"    OP =~"=~"RIGHT=~"registro.id_registro~" )    JOIN (LEFT=~"riga_documento.id_documento~"    OP =~"=~"RIGHT=~"documento.id_documento~" )) " update="riga_documento" updatewhere=1 updatekeyinplace=yes filter=" riga_documento_forza_chius_evasione ='S'"  sort="registro_tipo_registro A registro_numero A documento_num_progressivo A documento_data_registrazione A riga_documento_num_riga A " )
group(level=1 header.height=224 trailer.height=0 by=("registro_tipo_registro" , "registro_numero" , "documento_num_progressivo" , "documento_data_registrazione" ) header.color="553648127" trailer.color="536870912"  sort="registro_tipo_registro A registro_numero A documento_num_progressivo A documento_data_registrazione A " )
