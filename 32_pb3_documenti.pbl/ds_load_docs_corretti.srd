table(column=(type=char(2) updatewhereclause=yes name=registro_tipo_registro dbname="registro.tipo_registro" dbalias=".tipo_registro" )
 column=(type=decimal(0) updatewhereclause=yes name=registro_numero dbname="registro.numero" dbalias=".numero" )
 column=(type=decimal(0) updatewhereclause=yes name=documento_num_progressivo dbname="documento.num_progressivo" dbalias=".num_progressivo" )
 column=(type=date updatewhereclause=yes name=documento_data_registrazione dbname="documento.data_registrazione" dbalias=".data_registrazione" )
 column=(type=long updatewhereclause=yes identity=yes name=documento_id_documento dbname="documento.id_documento" dbalias=".id_documento" )
 column=(type=char(16) updatewhereclause=yes name=documento_num_documento dbname="documento.num_documento" dbalias=".num_documento" )
 column=(type=date updatewhereclause=yes name=documento_data_documento dbname="documento.data_documento" dbalias=".data_documento" )
 column=(type=long updatewhereclause=yes name=documento_id_sog_commerciale dbname="documento.id_sog_commerciale" dbalias=".id_sog_commerciale" )
 column=(type=char(40) updatewhereclause=yes name=sog_commerciale_gen_rag_soc_1 dbname="sog_commerciale_gen.rag_soc_1" dbalias=".rag_soc_1" )
 column=(type=decimal(4) updatewhereclause=yes name=documento_imp_acconto dbname="documento.imp_acconto" dbalias=".imp_acconto" )
 column=(type=long updatewhereclause=yes name=documento_id_tipo_pag_acconto dbname="documento.id_tipo_pag_acconto" dbalias=".id_tipo_pag_acconto" )
 column=(type=long updatewhereclause=yes name=documento_id_tab_iva_acconto dbname="documento.id_tab_iva_acconto" dbalias=".id_tab_iva_acconto" )
 column=(type=long updatewhereclause=yes name=documento_id_val_acconto dbname="documento.id_val_acconto" dbalias=".id_val_acconto" )
 column=(type=long updatewhereclause=yes name=documento_id_banca_sog_commerciale dbname="documento.id_banca_sog_commerciale" dbalias=".id_banca_sog_commerciale" )
 column=(type=long updatewhereclause=yes name=documento_id_destinazione dbname="documento.id_destinazione" dbalias=".id_destinazione" )
 column=(type=long updatewhereclause=yes name=documento_id_con_pagamento dbname="documento.id_con_pagamento" dbalias=".id_con_pagamento" )
 column=(type=long updatewhereclause=yes name=documento_id_valuta dbname="documento.id_valuta" dbalias=".id_valuta" )
 column=(type=char(40) updatewhereclause=yes name=documento_sconto_finanziario dbname="documento.sconto_finanziario" dbalias=".sconto_finanziario" )
 column=(type=decimal(2) updatewhereclause=yes name=documento_sconto_fin_cassa dbname="documento.sconto_fin_cassa" dbalias=".sconto_fin_cassa" )
 column=(type=long updatewhereclause=yes name=documento_id_gruppo_agenti dbname="documento.id_gruppo_agenti" dbalias=".id_gruppo_agenti" )
 column=(type=long updatewhereclause=yes name=documento_id_gruppo_agenti_2 dbname="documento.id_gruppo_agenti_2" dbalias=".id_gruppo_agenti_2" )
 column=(type=decimal(4) updatewhereclause=yes name=documento_sconto_fin_incondizionato dbname="documento.sconto_fin_incondizionato" dbalias=".sconto_fin_incondizionato" )
 column=(type=char(1) updatewhereclause=yes name=c_ord_fo_riga dbname="c_ord_fo_riga" )
 column=(type=decimal(4) updatewhereclause=yes name=c_qta_evasa dbname="c_qta_evasa" )
 retrieve="SELECT DISTINCT registro.tipo_registro, registro.numero, documento.num_progressivo, documento.data_registrazione,
 documento.id_documento, documento.num_documento, documento.data_documento, documento.id_sog_commerciale, sog_commerciale_gen.rag_soc_1, 
documento.imp_acconto, documento.id_tipo_pag_acconto, documento.id_tab_iva_acconto, documento.id_val_acconto, documento.id_banca_sog_commerciale, 
documento.id_destinazione, documento.id_con_pagamento, documento.id_valuta, documento.sconto_finanziario, documento.sconto_fin_cassa, 
documento.id_gruppo_agenti , documento.id_gruppo_agenti_2 , documento.sconto_fin_incondizionato  ,
 ( select riga_documento.ordinato_fo from riga_documento where riga_documento.id_documento = documento.id_documento and num_riga=1) as c_ord_fo_riga,
( select riga_documento.qta_evasa from riga_documento where riga_documento.id_documento = documento.id_documento and num_riga=1) as c_qta_evasa

FROM dba.documento, dba.der_profilo, dba.registro, dba.sog_commerciale_gen 

WHERE ( documento.id_prof_documento = der_profilo.id_prof_documento_padre ) 
AND ( documento.id_Azienda = 1 ) AND ( documento.evaso_totalmente <> 'S') 
AND ( documento.chius_forzata<> 'S') AND ( registro.id_registro = documento.id_registro ) 
AND ( documento.id_sog_commerciale = sog_commerciale_gen.id_sog_commerciale ) 
AND (( select riga_documento.ordinato_fo from riga_documento where riga_documento.id_documento = documento.id_documento and num_riga=1)= 'S' ) 
and (( select riga_documento.qta_evasa from riga_documento where riga_documento.id_documento = documento.id_documento and num_riga=1)=0)
AND (  der_profilo.id_prof_documento_derivato = :ll_id_prof_der)  AND  (documento.id_sog_commerciale = :ll_id_sog)  AND  (documento.id_magazzino = :ll_id_magazzino) 
 AND  (documento.id_valuta = :ll_id_valuta)  AND  (documento.id_con_pagamento = :ll_id_con_pagamento) 
 AND  (documento.data_documento >= :ldt_data_inizio)  AND  (documento.data_documento <= :ldt_data_fine)  AND  (documento.bloccato <> 'S')  
AND  (documento.sospeso <> 'S') 
order by  documento.data_registrazione,documento.num_progressivo" arguments=(("ll_id_prof_der", number),("ll_id_sog", number),("ll_id_magazzino", number),("ll_id_valuta", number),("ll_id_con_pagamento", number),("ldt_data_inizio", date),("ldt_data_fine", date))  sort="documento_data_registrazione A documento_num_progressivo A " )
