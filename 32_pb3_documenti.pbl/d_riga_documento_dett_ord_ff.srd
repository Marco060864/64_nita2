 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"riga_documento~" )  TABLE(NAME=~"unita_confezione~" )  TABLE(NAME=~"unita_misura~" ALIAS=~"unita_misura_a~" )  TABLE(NAME=~"articolo~" )  TABLE(NAME=~"unita_misura~" ALIAS=~"unita_misura_b~" )  TABLE(NAME=~"unita_misura~" ALIAS=~"unita_misura_c~" )  TABLE(NAME=~"sog_commerciale_gen~" )  TABLE(NAME=~"des_articolo~" ) COLUMN(NAME=~"riga_documento.provv_subage~") COLUMN(NAME=~"riga_documento.provv_carea~") COMPUTE(NAME=~"Cast(~~~"articolo~~~".~~~"codice~~~" as char(32)) As c_articolo_cod~") COMPUTE(NAME=~"Cast(~~~"articolo~~~".~~~"descrizione~~~" as char(80)) As c_articolo_des~") COMPUTE(NAME=~"Cast(~~~"unita_confezione~~~".~~~"tipo_conversione~~~" as char(1)) As c_unita_conf_tipo_conversione~") COMPUTE(NAME=~"Cast(~~~"unita_confezione~~~".~~~"molteplicita~~~" as decimal) As c_unita_conf_molteplicita~") COMPUTE(NAME=~"Cast(0 as integer) As c_arrot~") COLUMN(NAME=~"riga_documento.id_riga_documento~") COLUMN(NAME=~"riga_documento.id_documento~") COLUMN(NAME=~"riga_documento.num_riga~") COLUMN(NAME=~"riga_documento.id_articolo~") COLUMN(NAME=~"riga_documento.id_des_articolo~") COLUMN(NAME=~"riga_documento.id_unita_confezione~") COLUMN(NAME=~"riga_documento.quantita~") COLUMN(NAME=~"riga_documento.qta_sconto_merce~") COLUMN(NAME=~"riga_documento.qta_evasa~") COLUMN(NAME=~"riga_documento.fat_con_unita_base~") COLUMN(NAME=~"riga_documento.fat_con_globale~") COLUMN(NAME=~"riga_documento.qta_un_base~") COLUMN(NAME=~"riga_documento.qta_evasa_un_base~") COLUMN(NAME=~"riga_documento.id_caus_magazzino~") COLUMN(NAME=~"riga_documento.id_locazione_1~") COLUMN(NAME=~"riga_documento.id_locazione_2~") COLUMN(NAME=~"riga_documento.id_valuta~") COLUMN(NAME=~"riga_documento.cambio~") COLUMN(NAME=~"riga_documento.id_listino~") COLUMN(NAME=~"riga_documento.id_con_lis_articolo~") COLUMN(NAME=~"riga_documento.prezzo~") COLUMN(NAME=~"riga_documento.sconto~") COLUMN(NAME=~"riga_documento.prezzo_netto~") COLUMN(NAME=~"riga_documento.sconto_riga~") COLUMN(NAME=~"riga_documento.data_prevista_consegna~") COLUMN(NAME=~"riga_documento.peso_netto~") COLUMN(NAME=~"riga_documento.peso_lordo~") COLUMN(NAME=~"riga_documento.dim_l~") COLUMN(NAME=~"riga_documento.dim_h~") COLUMN(NAME=~"riga_documento.dim_p~") COLUMN(NAME=~"riga_documento.num_colli~") COLUMN(NAME=~"riga_documento.id_tab_iva~") COLUMN(NAME=~"riga_documento.provv_agente~") COLUMN(NAME=~"riga_documento.id_gruppo_agenti~") COLUMN(NAME=~"riga_documento.val_attribuito~") COLUMN(NAME=~"riga_documento.id_caus_trasporto~") COLUMN(NAME=~"riga_documento.forza_chius_evasione~") COLUMN(NAME=~"riga_documento.sospesa~") COLUMN(NAME=~"riga_documento.da_stampare~") COLUMN(NAME=~"riga_documento.data_inizio_competenza~") COLUMN(NAME=~"riga_documento.data_fine_competenza~") COLUMN(NAME=~"riga_documento.tot_riga_val_riga~") COLUMN(NAME=~"riga_documento.tot_riga_val_doc~") COLUMN(NAME=~"riga_documento.tot_riga_val_az~") COLUMN(NAME=~"riga_documento.id_riga_doc_provenienza~") COLUMN(NAME=~"riga_documento.id_conto~") COLUMN(NAME=~"riga_documento.id_azienda~") COLUMN(NAME=~"unita_misura_a.simbolo~") COLUMN(NAME=~"articolo.stato~") COLUMN(NAME=~"unita_misura_b.simbolo~") COLUMN(NAME=~"unita_misura_a.conversione~") COLUMN(NAME=~"unita_misura_b.conversione~") COMPUTE(NAME=~"cast(null as integer) as ric1~") COMPUTE(NAME=~"cast(null as integer) as ric2~") COLUMN(NAME=~"riga_documento.id_riga_doc_padre~") COLUMN(NAME=~"riga_documento.provv_imp_agente~") COLUMN(NAME=~"riga_documento.provv_imp_subage~") COLUMN(NAME=~"riga_documento.provv_imp_carea~") COLUMN(NAME=~"unita_misura_c.tipo~") COLUMN(NAME=~"sog_commerciale_gen.rag_soc_1~") COLUMN(NAME=~"articolo.prod_interna~") COLUMN(NAME=~"articolo.id_sog_commerciale~") COLUMN(NAME=~"riga_documento.ordinato_fo~") COLUMN(NAME=~"riga_documento.qta_ordinata_fo~") COLUMN(NAME=~"riga_documento.id_riga_lotto~") COLUMN(NAME=~"des_articolo.codice~") COLUMN(NAME=~"des_articolo.des_estesa~") COLUMN(NAME=~"riga_documento.id_gruppo_agenti_2~") COLUMN(NAME=~"riga_documento.provv_agente_2~") COLUMN(NAME=~"riga_documento.provv_subage_2~") COLUMN(NAME=~"riga_documento.provv_carea_2~") COLUMN(NAME=~"riga_documento.provv_imp_agente_2~") COLUMN(NAME=~"riga_documento.provv_imp_subage_2~") COLUMN(NAME=~"riga_documento.provv_imp_carea_2~") COMPUTE(NAME=~"CAST(SUBSTR(c_cmc_data, 1, 22) as dm_imp_6_dec) as cmc~") COMPUTE(NAME=~"CAST(SUBSTR(c_ult_costo_data, 1, 22) as dm_imp_6_dec) as costo_ultimo~") COMPUTE(NAME=~"CAST(FN_PAR_COSTOMEDIO(1, ~~~"riga_documento~~~".~~~"id_articolo~~~", (SELECT id_magazzino FROM locazione WHERE id_locazione = ~~~"riga_documento~~~".~~~"id_locazione_1~~~"), YEAR(TODAY(*)), MONTH(TODAY(*)), ~~~"riga_documento~~~".~~~"id_valuta~~~",  (SELECT id_prof_documento FROM documento WHERE id_documento = :ra_id_documento) )  AS dm_imp_6_dec ) AS costo_medio~") COMPUTE(NAME=~"CAST(SUBSTR( c_esidisp, 21, 20) as numeric(18,4)) As c_esistenza~") COMPUTE(NAME=~"CAST(SUBSTR(c_esidisp,  41, 20) as numeric(18,4)) As c_disponibilita~") COMPUTE(NAME=~"CAST(SUBSTR(c_esidisp, 1, 20) as numeric(18,4)) as esistenza_fisica~") COMPUTE(NAME=~"CAST(FN_PAR_ESIDISP(1, ~~~"riga_documento~~~".~~~"id_articolo~~~", (SELECT id_magazzino FROM locazione WHERE id_locazione = ~~~"riga_documento~~~".~~~"id_locazione_1~~~"), YEAR(TODAY(*)), MONTH(TODAY(*)) , (SELECT id_prof_documento FROM documento WHERE id_documento = :ra_id_documento))  AS CHAR(60) ) AS c_esidisp~") COMPUTE(NAME=~"CAST(FN_PAR_ULTCOSTO(1, ~~~"riga_documento~~~".~~~"id_articolo~~~", (SELECT id_magazzino FROM locazione WHERE id_locazione = ~~~"riga_documento~~~".~~~"id_locazione_1~~~"), YEAR(TODAY(*)), MONTH(TODAY(*)) , ~~~"riga_documento~~~".~~~"id_valuta~~~",  (SELECT id_prof_documento FROM documento WHERE id_documento = :ra_id_documento))  AS CHAR(32) ) AS c_ult_costo_data~") COMPUTE(NAME=~"CAST(FN_PAR_CMC(1, ~~~"riga_documento~~~".~~~"id_articolo~~~", (SELECT id_magazzino FROM locazione WHERE id_locazione = ~~~"riga_documento~~~".~~~"id_locazione_1~~~"), ~~~"riga_documento~~~".~~~"id_valuta~~~",  (SELECT id_prof_documento FROM documento WHERE id_documento = :ra_id_documento))  AS CHAR(32) ) AS c_cmc_data~") COMPUTE(NAME=~"CAST(SUBSTR(c_ult_costo_data, 23, 10) as CHAR(10)) as data_costo_ultimo~") COMPUTE(NAME=~"CAST(SUBSTR(c_cmc_data, 23, 10) as CHAR(10)) as data_cmc~") COLUMN(NAME=~"riga_documento.descrizione~") COLUMN(NAME=~"unita_misura_a.descrizione~") COLUMN(NAME=~"unita_misura_b.descrizione~") COLUMN(NAME=~"des_articolo.descrizione~")    JOIN (LEFT=~"unita_confezione.id_unita_mis_peso~"    OP =~"=~"RIGHT=~"unita_misura_a.id_unita_misura~"    OUTER1 =~"unita_confezione.id_unita_mis_peso~" )    JOIN (LEFT=~"unita_confezione.id_unita_mis_volume~"    OP =~"=~"RIGHT=~"unita_misura_b.id_unita_misura~"    OUTER1 =~"unita_confezione.id_unita_mis_volume~" )    JOIN (LEFT=~"unita_confezione.id_unita_misura~"    OP =~"=~"RIGHT=~"unita_misura_c.id_unita_misura~"    OUTER1 =~"unita_confezione.id_unita_misura~" )    JOIN (LEFT=~"unita_confezione.id_unita_confezione~"    OP =~"=~"RIGHT=~"riga_documento.id_unita_confezione~"    OUTER2 =~"riga_documento.id_unita_confezione~" )    JOIN (LEFT=~"articolo.id_articolo~"    OP =~"=~"RIGHT=~"riga_documento.id_articolo~"    OUTER2 =~"riga_documento.id_articolo~" )    JOIN (LEFT=~"articolo.id_sog_commerciale~"    OP =~"=~"RIGHT=~"sog_commerciale_gen.id_sog_commerciale~"    OUTER1 =~"articolo.id_sog_commerciale~" )    JOIN (LEFT=~"des_articolo.id_des_articolo~"    OP =~"=~"RIGHT=~"riga_documento.id_des_articolo~"    OUTER2 =~"riga_documento.id_des_articolo~" )WHERE(    EXP1 =~"( ~~~"riga_documento~~~".~~~"id_documento~~~"~"   OP =~"=~"    EXP2 =~":ra_id_documento )~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"( ~~~"riga_documento~~~".~~~"id_azienda~~~"~"   OP =~"in~"    EXP2 =~"(0,1) )~" ) ) ARG(NAME = ~"ra_id_documento~" TYPE = number) " arguments=(("ra_id_documento", number)) )
