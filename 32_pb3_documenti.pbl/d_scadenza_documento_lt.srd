detail(height=76 color="553648127" )
table(column=(type=long update=yes updatewhereclause=yes key=yes identity=yes name=id_scadenza dbname="scadenza.id_scadenza" )
 column=(type=char(1) update=yes updatewhereclause=yes name=tipo_scadenza dbname="scadenza.tipo_scadenza" initial="A" values="Attiva	A/Passiva	P/" validation=" gettext()  = 'A' OR  gettext()  = 'P'" validationmsg="'Immettere un valore tra A, P'" )
 column=(type=long update=yes updatewhereclause=yes name=id_sog_commerciale dbname="scadenza.id_sog_commerciale" )
 column=(type=date update=yes updatewhereclause=yes name=data_scadenza dbname="scadenza.data_scadenza" )
 column=(type=long update=yes updatewhereclause=yes name=id_valuta dbname="scadenza.id_valuta" )
 column=(type=decimal(4) update=yes updatewhereclause=yes name=cambio dbname="scadenza.cambio" validation=" real(gettext())  >= 0" validationmsg="'Immettere un valore >= 0'" )
 column=(type=decimal(4) update=yes updatewhereclause=yes name=imp_valuta dbname="scadenza.imp_valuta" )
 column=(type=long update=yes updatewhereclause=yes name=id_tipo_pagamento dbname="scadenza.id_tipo_pagamento" )
 column=(type=long update=yes updatewhereclause=yes name=id_banca_azienda dbname="scadenza.id_banca_azienda" )
 column=(type=long update=yes updatewhereclause=yes name=id_banca_sog_commerciale dbname="scadenza.id_banca_sog_commerciale" )
 column=(type=char(32766) update=yes updatewhereclause=no name=note dbname="scadenza.note" )
 column=(type=char(40) update=yes updatewhereclause=yes name=ces_denominazione dbname="scadenza.ces_denominazione" )
 column=(type=char(40) update=yes updatewhereclause=yes name=ces_indirizzo dbname="scadenza.ces_indirizzo" )
 column=(type=char(10) update=yes updatewhereclause=yes name=ces_cap dbname="scadenza.ces_cap" )
 column=(type=char(40) update=yes updatewhereclause=yes name=ces_localita dbname="scadenza.ces_localita" )
 column=(type=char(5) update=yes updatewhereclause=yes name=ces_provincia dbname="scadenza.ces_provincia" )
 column=(type=char(16) update=yes updatewhereclause=yes name=ces_doc_originale dbname="scadenza.ces_doc_originale" )
 column=(type=date update=yes updatewhereclause=yes name=ces_data_documento dbname="scadenza.ces_data_documento" )
 column=(type=char(1) update=yes updatewhereclause=yes name=stato_scadenza dbname="scadenza.stato_scadenza" initial="N" values="Non generare	N/Provvisoria	P/Definitva	D/" validation=" gettext()  = 'N' OR  gettext()  = 'P' OR  gettext()  = 'D'" validationmsg="'Inserire un valore tra N, P, D'" )
 column=(type=date update=yes updatewhereclause=yes name=data_cambiamento_stato dbname="scadenza.data_cambiamento_stato" )
 column=(type=char(1) update=yes updatewhereclause=yes name=esito_pagamento dbname="scadenza.esito_pagamento" initial="E" values="Emesso	E/Distinta	D/Pagato	P/Insoluto	I/Bloccato	B/" validation=" gettext()  = 'E' OR  gettext()  = 'D' OR  gettext()  = 'P' OR  gettext()  = 'I' OR  gettext()  = 'B' OR  gettext()  = 'R'" validationmsg="'Immettere un valore tra E, D, P, I, B, R'" )
 column=(type=char(1) update=yes updatewhereclause=yes name=scadenza_da_raggruppare dbname="scadenza.scadenza_da_raggruppare" initial="N" values="	S/	N" validation=" gettext()  = 'S' OR  gettext()  = 'N'" validationmsg="'Immettere: S, N'" )
 column=(type=long update=yes updatewhereclause=yes name=id_riga_distinta_banca dbname="scadenza.id_riga_distinta_banca" )
 column=(type=long update=yes updatewhereclause=yes name=id_documento dbname="scadenza.id_documento" )
 column=(type=long update=yes updatewhereclause=yes name=id_par_aperta dbname="scadenza.id_par_aperta" )
 column=(type=long update=yes updatewhereclause=yes name=id_scadenza_padre dbname="scadenza.id_scadenza_padre" )
 column=(type=long update=yes updatewhereclause=yes name=id_azienda dbname="scadenza.id_azienda" initial="1" )
 column=(type=decimal(4) update=yes updatewhereclause=yes name=importo dbname="scadenza.importo" )
 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"scadenza~" ) COLUMN(NAME=~"scadenza.id_scadenza~") COLUMN(NAME=~"scadenza.tipo_scadenza~") COLUMN(NAME=~"scadenza.id_sog_commerciale~") COLUMN(NAME=~"scadenza.data_scadenza~") COLUMN(NAME=~"scadenza.id_valuta~") COLUMN(NAME=~"scadenza.cambio~") COLUMN(NAME=~"scadenza.imp_valuta~") COLUMN(NAME=~"scadenza.id_tipo_pagamento~") COLUMN(NAME=~"scadenza.id_banca_azienda~") COLUMN(NAME=~"scadenza.id_banca_sog_commerciale~") COLUMN(NAME=~"scadenza.note~") COLUMN(NAME=~"scadenza.ces_denominazione~") COLUMN(NAME=~"scadenza.ces_indirizzo~") COLUMN(NAME=~"scadenza.ces_cap~") COLUMN(NAME=~"scadenza.ces_localita~") COLUMN(NAME=~"scadenza.ces_provincia~") COLUMN(NAME=~"scadenza.ces_doc_originale~") COLUMN(NAME=~"scadenza.ces_data_documento~") COLUMN(NAME=~"scadenza.stato_scadenza~") COLUMN(NAME=~"scadenza.data_cambiamento_stato~") COLUMN(NAME=~"scadenza.esito_pagamento~") COLUMN(NAME=~"scadenza.scadenza_da_raggruppare~") COLUMN(NAME=~"scadenza.id_riga_distinta_banca~") COLUMN(NAME=~"scadenza.id_documento~") COLUMN(NAME=~"scadenza.id_par_aperta~") COLUMN(NAME=~"scadenza.id_scadenza_padre~") COLUMN(NAME=~"scadenza.id_azienda~") COLUMN(NAME=~"scadenza.importo~")WHERE(    EXP1 =~"(~~~"scadenza~~~".~~~"id_documento~~~"~"   OP =~"=~"    EXP2 =~":ra_id_documento~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"( ~~~"scadenza~~~".~~~"id_azienda~~~"~"   OP =~"in~"    EXP2 =~"(0, 1)) )~" ) ) ARG(NAME = ~"ra_id_documento~" TYPE = number) " update="scadenza" updatewhere=0 updatekeyinplace=yes arguments=(("ra_id_documento", number)) )
