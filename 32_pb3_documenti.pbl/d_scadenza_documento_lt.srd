release 6;
datawindow(units=0 timer_interval=60000 color=80264376 processing=1 print.documentname="" print.orientation = 0 print.margin.left = 110 print.margin.right = 110 print.margin.top = 97 print.margin.bottom = 97 print.paper.source = 0 print.paper.size = 0 print.prompt=no print.buttons=no print.preview.buttons=no grid.lines=3 grid.columnmove=no selected.mouse=no )
header(height=68 color="536870912" )
