 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"spesa~" )  TABLE(NAME=~"riga_spesa~" )  TABLE(NAME=~"spesa_sog_commerciale~" )  TABLE(NAME=~"prof_documento~" )  TABLE(NAME=~"sog_commerciale~" )  TABLE(NAME=~"anagrafica~" ) COLUMN(NAME=~"spesa.id_spesa~") COLUMN(NAME=~"spesa.codice~") COLUMN(NAME=~"spesa.descrizione~") COLUMN(NAME=~"spesa.tipo_importo~") COLUMN(NAME=~"spesa.id_tab_iva~") COLUMN(NAME=~"spesa.id_conto_acquisti~") COLUMN(NAME=~"spesa.id_conto_vendite~") COLUMN(NAME=~"spesa.segue_esenzione~") COLUMN(NAME=~"spesa.mod_cal_iva~") COLUMN(NAME=~"riga_spesa.codice~") COLUMN(NAME=~"riga_spesa.da_imponibile~") COLUMN(NAME=~"riga_spesa.a_imponibile~") COLUMN(NAME=~"riga_spesa.importo~") COLUMN(NAME=~"riga_spesa.percentuale~") COLUMN(NAME=~"spesa_sog_commerciale.percentuale~") COLUMN(NAME=~"spesa_sog_commerciale.importo~") COLUMN(NAME=~"spesa_sog_commerciale.da_imponibile~") COLUMN(NAME=~"spesa_sog_commerciale.a_imponibile~") COLUMN(NAME=~"spesa_sog_commerciale.app_rateale~") COMPUTE(NAME=~"LOCATE( ~~~"prof_documento~~~".~~~"spese_gestite~~~", ~~~"spesa~~~".~~~"codice~~~" ) AS pd_spesa_gestita~") COMPUTE(NAME=~"( SELECT spese_gestite FROM tipo_trasporto WHERE id_tipo_trasporto = :rn_id_tipo_trasporto) AS tt_spese_gestite~") COMPUTE(NAME=~"IFNULL( :rn_id_tipo_trasporto, 1, LOCATE( IFNULL( tt_spese_gestite, '', tt_spese_gestite) || 'BC', ~~~"spesa~~~".~~~"codice~~~")) AS tt_spesa_gestita~") COMPUTE(NAME=~"(SELECT SUM(num_rate) FROM app_pagamento WHERE id_con_pagamento = :rn_id_con_pagamento) AS tot_num_rate~") COMPUTE(NAME=~"(SELECT spese_gestite FROM tipo_pagamento WHERE id_tipo_pagamento = (SELECT MIN(id_tipo_pagamento) FROM app_pagamento WHERE id_con_pagamento = :rn_id_con_pagamento) ) AS tp_spese_gestite~") COLUMN(NAME=~"sog_commerciale.id_tab_iva~") COMPUTE(NAME=~"IFNULL( :rn_id_con_pagamento, 1, LOCATE( IFNULL( tp_spese_gestite, '', tp_spese_gestite) , ~~~"spesa~~~".~~~"codice~~~")) AS tp_spesa_gestita~") COLUMN(NAME=~"spesa.id_valuta~") COLUMN(NAME=~"sog_commerciale.id_valuta~") COLUMN(NAME=~"anagrafica.id_valuta~")    JOIN (LEFT=~"riga_spesa.id_spesa~"    OP =~"=~"RIGHT=~"spesa.id_spesa~"    OUTER2 =~"spesa.id_spesa~" )    JOIN (LEFT=~"spesa_sog_commerciale.id_spesa~"    OP =~"=~"RIGHT=~"spesa.id_spesa~" )    JOIN (LEFT=~"sog_commerciale.id_sog_commerciale~"    OP =~"=~"RIGHT=~"spesa_sog_commerciale.id_sog_commerciale~" )    JOIN (LEFT=~"anagrafica.id_anagrafica~"    OP =~"=~"RIGHT=~"sog_commerciale.id_anagrafica~" )WHERE(    EXP1 =~"~~~"spesa_sog_commerciale~~~".~~~"id_sog_commerciale~~~"~"   OP =~"=~"    EXP2 =~":rn_id_sog_commerciale~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"( ~~~"riga_spesa~~~".~~~"da_imponibile~~~"~"   OP =~"<=~"    EXP2 =~"(FN_CONV_VALUTA(:rn_id_valuta_doc, :rn_tot_merce, ~~~"spesa~~~".~~~"id_valuta~~~") ) ~"    LOGIC =~"or~" ) WHERE(    EXP1 =~"~~~"riga_spesa~~~".~~~"da_imponibile~~~"~"   OP =~"is~"    EXP2 =~"NULL)~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"( ~~~"riga_spesa~~~".~~~"a_imponibile~~~"~"   OP =~">=~"    EXP2 =~"(FN_CONV_VALUTA(:rn_id_valuta_doc, :rn_tot_merce, ~~~"spesa~~~".~~~"id_valuta~~~") )~"    LOGIC =~"or~" ) WHERE(    EXP1 =~" ~~~"riga_spesa~~~".~~~"a_imponibile~~~"~"   OP =~"is~"    EXP2 =~"NULL )~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"( ~~~"spesa_sog_commerciale~~~".~~~"da_imponibile~~~"~"   OP =~"<=~"    EXP2 =~"(FN_CONV_VALUTA(:rn_id_valuta_doc, :rn_tot_merce, ~~~"sog_commerciale~~~".~~~"id_valuta~~~") )~"    LOGIC =~"or~" ) WHERE(    EXP1 =~" ~~~"spesa_sog_commerciale~~~".~~~"da_imponibile~~~"~"   OP =~"is~"    EXP2 =~"NULL )~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"( ~~~"spesa_sog_commerciale~~~".~~~"a_imponibile~~~"~"   OP =~">=~"    EXP2 =~"(FN_CONV_VALUTA(:rn_id_valuta_doc, :rn_tot_merce, ~~~"sog_commerciale~~~".~~~"id_valuta~~~") )~"    LOGIC =~"or~" ) WHERE(    EXP1 =~" ~~~"spesa_sog_commerciale~~~".~~~"a_imponibile~~~"~"   OP =~"is~"    EXP2 =~"NULL )~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"prof_documento~~~".~~~"id_prof_documento~~~"~"   OP =~"=~"    EXP2 =~":rn_id_prof_documento~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"( pd_spesa_gestita~"   OP =~">~"    EXP2 =~"0 )~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"( tt_spesa_gestita~"   OP =~">~"    EXP2 =~"0 )~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"( tp_spesa_gestita~"   OP =~">~"    EXP2 =~"0 )~" ) ) ARG(NAME = ~"rn_id_prof_documento~" TYPE = number)  ARG(NAME = ~"rn_id_tipo_trasporto~" TYPE = number)  ARG(NAME = ~"rn_id_con_pagamento~" TYPE = number)  ARG(NAME = ~"rn_id_sog_commerciale~" TYPE = number)  ARG(NAME = ~"rn_tot_merce~" TYPE = number)  ARG(NAME = ~"rn_id_valuta_doc~" TYPE = number) " update="tipo_trasporto" updatewhere=1 updatekeyinplace=no arguments=(("rn_id_prof_documento", number),("rn_id_tipo_trasporto", number),("rn_id_con_pagamento", number),("rn_id_sog_commerciale", number),("rn_tot_merce", number),("rn_id_valuta_doc", number)) )
