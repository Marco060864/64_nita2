table(column=(type=char(4) updatewhereclause=yes name=listino_codice dbname="listino.codice" )
 column=(type=char(40) updatewhereclause=yes name=valuta_descrizione dbname="valuta.descrizione" )
 column=(type=long update=yes updatewhereclause=yes key=yes name=id_unita_confezione dbname="prezzo.id_unita_confezione" )
 column=(type=long update=yes updatewhereclause=yes key=yes name=prezzo_id_variazione dbname="prezzo.id_variazione" )
 column=(type=long updatewhereclause=yes name=azione dbname="azione" values="Var. perc. su prezzo esistente	1/Var. a valore su prezzo esistente	2/Var. perc. su ultimo prezzo di acq.	3/Var. perc. rispetto ad altro listino	4/Var. fissa rispetto ad altro listino	5/Var. ~"Sottocento~" su prezzo esistente	10/" )
 column=(type=decimal(2) updatewhereclause=yes name=percentuale dbname="percentuale" )
 column=(type=decimal(4) updatewhereclause=yes name=valore dbname="valore" )
 column=(type=long updatewhereclause=yes name=id_var_rif dbname="id_var_rif" )
 column=(type=long updatewhereclause=yes name=id_valuta dbname="valuta.id_valuta" )
 column=(type=decimal(6) updatewhereclause=yes name=prezzo_o dbname="prezzo_o" )
 column=(type=decimal(6) update=yes updatewhereclause=yes name=prezzo_prezzo dbname="prezzo.prezzo" )
 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"listino~" )  TABLE(NAME=~"variazione~" )  TABLE(NAME=~"valuta~" )  TABLE(NAME=~"prezzo~" ) COLUMN(NAME=~"listino.codice~") COLUMN(NAME=~"valuta.descrizione~") COLUMN(NAME=~"prezzo.id_unita_confezione~") COLUMN(NAME=~"prezzo.id_variazione~") COMPUTE(NAME=~"CAST ( NULL AS INTEGER ) AS azione~") COMPUTE(NAME=~"CAST ( NULL AS NUMERIC(5,2) ) AS percentuale~") COMPUTE(NAME=~"CAST ( NULL AS NUMERIC(18,4) ) AS valore~") COMPUTE(NAME=~"CAST ( NULL AS INTEGER ) AS id_var_rif~") COLUMN(NAME=~"valuta.id_valuta~") COMPUTE(NAME=~"CAST (~~~"prezzo~~~".~~~"prezzo~~~" AS dm_imp_6_dec ) AS prezzo_o~") COLUMN(NAME=~"prezzo.prezzo~")    JOIN (LEFT=~"variazione.id_listino~"    OP =~"=~"RIGHT=~"listino.id_listino~" )    JOIN (LEFT=~"valuta.id_valuta~"    OP =~"=~"RIGHT=~"listino.id_valuta~" )    JOIN (LEFT=~"prezzo.id_variazione~"    OP =~"=~"RIGHT=~"variazione.id_variazione~" )WHERE(    EXP1 =~"~~~"prezzo~~~".~~~"id_unita_confezione~~~"~"   OP =~"=~"    EXP2 =~":rn_id_unita_confezione~" ) ) ARG(NAME = ~"rn_id_unita_confezione~" TYPE = number) " update="prezzo" updatewhere=1 updatekeyinplace=yes arguments=(("rn_id_unita_confezione", number)) )
