 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"articolo~" )  TABLE(NAME=~"listino~" )  TABLE(NAME=~"unita_confezione~" )  TABLE(NAME=~"variazione~" )  TABLE(NAME=~"prezzo~" )  TABLE(NAME=~"unita_misura~" ) COLUMN(NAME=~"articolo.id_articolo~") COLUMN(NAME=~"articolo.codice~") COLUMN(NAME=~"prezzo.id_variazione~") COLUMN(NAME=~"prezzo.prezzo~") COLUMN(NAME=~"prezzo.prezzo_manifattura~") COLUMN(NAME=~"variazione.data_inizio~") COLUMN(NAME=~"variazione.data_fine~") COLUMN(NAME=~"listino.codice~") COLUMN(NAME=~"listino.lis_base~") COLUMN(NAME=~"listino.tipo~") COLUMN(NAME=~"unita_misura.tipo~") COLUMN(NAME=~"prezzo.id_unita_confezione~") COLUMN(NAME=~"unita_confezione.id_unita_confezione~")    JOIN (LEFT=~"variazione.id_listino~"    OP =~"=~"RIGHT=~"listino.id_listino~"    OUTER1 =~"variazione.id_listino~" )    JOIN (LEFT=~"prezzo.id_variazione~"    OP =~"=~"RIGHT=~"variazione.id_variazione~"    OUTER1 =~"prezzo.id_variazione~" )    JOIN (LEFT=~"prezzo.id_unita_confezione~"    OP =~"=~"RIGHT=~"unita_confezione.id_unita_confezione~"    OUTER2 =~"unita_confezione.id_unita_confezione~" )    JOIN (LEFT=~"unita_confezione.id_articolo~"    OP =~"=~"RIGHT=~"articolo.id_articolo~" )    JOIN (LEFT=~"unita_confezione.id_unita_misura~"    OP =~"=~"RIGHT=~"unita_misura.id_unita_misura~" )WHERE(    EXP1 =~"~~~"prezzo~~~".~~~"id_unita_confezione~~~"~"   OP =~"is~"    EXP2 =~"null~" ) ) " update="prezzo" updatewhere=1 updatekeyinplace=yes  sort="articolo_codice A " )
