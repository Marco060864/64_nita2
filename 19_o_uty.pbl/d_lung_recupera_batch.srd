table(column=(type=long updatewhereclause=yes identity=yes name=sog_commerciale_id_sog_commerciale dbname="sog_commerciale.id_sog_commerciale" )
 column=(type=long updatewhereclause=yes name=riga_documento_id_articolo dbname="riga_documento.id_articolo" )
 column=(type=char(5) updatewhereclause=yes name=unita_misura_simbolo dbname="unita_misura.simbolo" )
 column=(type=decimal(4) updatewhereclause=yes name=riga_documento_dim_l dbname="riga_documento.dim_l" )
 column=(type=datetime updatewhereclause=yes name=data_ora_creazione dbname="documento.data_ora_creazione" )
 column=(type=long updatewhereclause=yes identity=yes name=id_riga_documento dbname="riga_documento.id_riga_documento" )
 column=(type=decimal(2) updatewhereclause=yes name=peso_unitario dbname="peso_unitario" )
 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"anagrafica~" )  TABLE(NAME=~"articolo~" )  TABLE(NAME=~"documento~" )  TABLE(NAME=~"riga_documento~" )  TABLE(NAME=~"sog_commerciale~" )  TABLE(NAME=~"unita_confezione~" )  TABLE(NAME=~"unita_misura~" )  TABLE(NAME=~"prof_documento~" ) COLUMN(NAME=~"sog_commerciale.id_sog_commerciale~") COLUMN(NAME=~"riga_documento.id_articolo~") COLUMN(NAME=~"unita_misura.simbolo~") COLUMN(NAME=~"riga_documento.dim_l~") COLUMN(NAME=~"documento.data_ora_creazione~") COLUMN(NAME=~"riga_documento.id_riga_documento~") COMPUTE(NAME=~"cast( (CASE riga_documento.quantita WHEN 0 then 0 else riga_documento.peso_netto/riga_documento.quantita end ) as numeric(18,2))as peso_unitario~")    JOIN (LEFT=~"riga_documento.id_documento~"    OP =~"=~"RIGHT=~"documento.id_documento~" )    JOIN (LEFT=~"riga_documento.id_articolo~"    OP =~"=~"RIGHT=~"articolo.id_articolo~" )    JOIN (LEFT=~"sog_commerciale.id_anagrafica~"    OP =~"=~"RIGHT=~"anagrafica.id_anagrafica~" )    JOIN (LEFT=~"sog_commerciale.id_sog_commerciale~"    OP =~"=~"RIGHT=~"documento.id_sog_commerciale~" )    JOIN (LEFT=~"unita_confezione.id_unita_confezione~"    OP =~"=~"RIGHT=~"riga_documento.id_unita_confezione~" )    JOIN (LEFT=~"unita_confezione.id_unita_mis_volume~"    OP =~"=~"RIGHT=~"unita_misura.id_unita_misura~" )    JOIN (LEFT=~"prof_documento.id_prof_documento~"    OP =~"=~"RIGHT=~"documento.id_prof_documento~" )WHERE(    EXP1 =~"~~~"prof_documento~~~".~~~"agg_lunghezza~~~"~"   OP =~"=~"    EXP2 =~"'S'~" ) ) "  sort="sog_commerciale_id_sog_commerciale A riga_documento_id_articolo A unita_misura_simbolo A riga_documento_dim_l A data_ora_creazione D id_riga_documento D " )
