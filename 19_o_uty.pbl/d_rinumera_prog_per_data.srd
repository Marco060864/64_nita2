 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"documento~" ) COLUMN(NAME=~"documento.id_documento~") COLUMN(NAME=~"documento.id_prof_documento~") COLUMN(NAME=~"documento.num_progressivo~") COLUMN(NAME=~"documento.data_registrazione~") COLUMN(NAME=~"documento.num_documento~") COLUMN(NAME=~"documento.data_documento~") COLUMN(NAME=~"documento.prog_globale~") COLUMN(NAME=~"documento.doc_globale~")WHERE(    EXP1 =~"~~~"documento~~~".~~~"id_prof_documento~~~"~"   OP =~"=~"    EXP2 =~"184~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"documento~~~".~~~"data_documento~~~"~"   OP =~">~"    EXP2 =~"20221231~" ) ) " update="documento" updatewhere=1 updatekeyinplace=no  sort="data_documento A " )
