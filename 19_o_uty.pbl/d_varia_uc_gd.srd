 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"articolo~" )  TABLE(NAME=~"unita_confezione~" )  TABLE(NAME=~"unita_misura~" ) COLUMN(NAME=~"articolo.codice~") COLUMN(NAME=~"articolo.id_articolo~") COLUMN(NAME=~"unita_confezione.codice~") COLUMN(NAME=~"unita_confezione.peso_netto~") COLUMN(NAME=~"unita_confezione.dim_l~") COLUMN(NAME=~"unita_confezione.unita_base~") COLUMN(NAME=~"unita_misura.simbolo~") COLUMN(NAME=~"unita_misura.id_unita_misura~") COLUMN(NAME=~"unita_confezione.peso_non_prezioso~") COLUMN(NAME=~"unita_confezione.id_unita_confezione~") COLUMN(NAME=~"unita_confezione.dim_h~") COLUMN(NAME=~"unita_confezione.dim_p~") COLUMN(NAME=~"unita_confezione.qta_minima~")    JOIN (LEFT=~"unita_misura.id_unita_misura~"    OP =~"=~"RIGHT=~"unita_confezione.id_unita_mis_peso~"    OUTER2 =~"unita_confezione.id_unita_mis_peso~" )    JOIN (LEFT=~"unita_confezione.id_articolo~"    OP =~"=~"RIGHT=~"articolo.id_articolo~" )) " update="unita_confezione" updatewhere=1 updatekeyinplace=yes  sort="articolo_codice A " )
