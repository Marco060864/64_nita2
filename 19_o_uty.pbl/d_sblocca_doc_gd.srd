 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"documento~" )  TABLE(NAME=~"prof_documento~" ) COLUMN(NAME=~"documento.id_documento~") COLUMN(NAME=~"documento.num_documento~") COLUMN(NAME=~"documento.data_documento~") COLUMN(NAME=~"documento.num_progressivo~") COLUMN(NAME=~"documento.data_registrazione~") COLUMN(NAME=~"documento.stampato~") COLUMN(NAME=~"documento.evaso_totalmente~") COLUMN(NAME=~"documento.chius_forzata~") COLUMN(NAME=~"documento.sospeso~") COLUMN(NAME=~"documento.bloccato~") COLUMN(NAME=~"prof_documento.codice~")    JOIN (LEFT=~"prof_documento.id_prof_documento~"    OP =~"=~"RIGHT=~"documento.id_prof_documento~" )WHERE(    EXP1 =~"~~~"documento~~~".~~~"stampato~~~"~"   OP =~"=~"    EXP2 =~"'S'~"    LOGIC =~"or~" ) WHERE(    EXP1 =~"~~~"documento~~~".~~~"evaso_totalmente~~~"~"   OP =~"=~"    EXP2 =~"'S'~"    LOGIC =~"or~" ) WHERE(    EXP1 =~"~~~"documento~~~".~~~"chius_forzata~~~"~"   OP =~"=~"    EXP2 =~"'S'~"    LOGIC =~"or~" ) WHERE(    EXP1 =~"~~~"documento~~~".~~~"sospeso~~~"~"   OP =~"=~"    EXP2 =~"'S'~" ) ) " update="documento" updatewhere=1 updatekeyinplace=yes  sort="data_documento A num_documento A " )
