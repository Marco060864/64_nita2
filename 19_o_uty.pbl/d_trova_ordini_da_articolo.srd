 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"documento~" )  TABLE(NAME=~"riga_documento~" )  TABLE(NAME=~"prof_documento~" )  TABLE(NAME=~"sog_commerciale_gen~" ) COLUMN(NAME=~"documento.id_documento~") COLUMN(NAME=~"documento.id_prof_documento~") COLUMN(NAME=~"documento.num_progressivo~") COLUMN(NAME=~"documento.data_registrazione~") COLUMN(NAME=~"documento.num_documento~") COLUMN(NAME=~"documento.data_documento~") COLUMN(NAME=~"sog_commerciale_gen.codice~") COLUMN(NAME=~"sog_commerciale_gen.rag_soc_1~") COLUMN(NAME=~"prof_documento.codice~") COLUMN(NAME=~"riga_documento.id_articolo~") COLUMN(NAME=~"riga_documento.ordinato_fo~")    JOIN (LEFT=~"riga_documento.id_documento~"    OP =~"=~"RIGHT=~"documento.id_documento~" )    JOIN (LEFT=~"prof_documento.id_prof_documento~"    OP =~"=~"RIGHT=~"documento.id_prof_documento~" )    JOIN (LEFT=~"documento.id_sog_commerciale~"    OP =~"=~"RIGHT=~"sog_commerciale_gen.id_sog_commerciale~" )WHERE(    EXP1 =~"(~~~"documento~~~".~~~"chius_forzata~~~"~"   OP =~"is~"    EXP2 =~"null~"    LOGIC =~"or~" ) WHERE(    EXP1 =~"~~~"documento~~~".~~~"chius_forzata~~~"~"   OP =~"<>~"    EXP2 =~"'S')~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"riga_documento~~~".~~~"id_articolo~~~"~"   OP =~"=~"    EXP2 =~":id_art~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"prof_documento~~~".~~~"codice~~~"~"   OP =~"=~"    EXP2 =~"'ORDCLI'~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"(~~~"riga_documento~~~".~~~"ordinato_fo~~~"~"   OP =~"is~"    EXP2 =~"null~"    LOGIC =~"or~" ) WHERE(    EXP1 =~"~~~"riga_documento~~~".~~~"ordinato_fo~~~"~"   OP =~"<>~"    EXP2 =~"'O')~" ) ) ARG(NAME = ~"id_art~" TYPE = number) " arguments=(("id_art", number)) )
