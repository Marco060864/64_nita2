 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"esercizio~" )  TABLE(NAME=~"registro~" )  TABLE(NAME=~"riga_documento~" )  TABLE(NAME=~"documento~" ) COLUMN(NAME=~"documento.id_documento~") COLUMN(NAME=~"documento.num_progressivo~") COLUMN(NAME=~"documento.data_registrazione~") COLUMN(NAME=~"documento.num_documento~") COLUMN(NAME=~"documento.data_documento~") COLUMN(NAME=~"riga_documento.id_riga_documento~") COLUMN(NAME=~"registro.tipo_registro~") COLUMN(NAME=~"esercizio.codice~") COLUMN(NAME=~"riga_documento.id_riga_doc_provenienza~") COLUMN(NAME=~"riga_documento.id_riga_doc_padre~") COLUMN(NAME=~"riga_documento.id_riga_sorgente~")    JOIN (LEFT=~"registro.id_esercizio~"    OP =~"=~"RIGHT=~"esercizio.id_esercizio~" )    JOIN (LEFT=~"documento.id_documento~"    OP =~"=~"RIGHT=~"riga_documento.id_documento~" )    JOIN (LEFT=~"documento.id_registro~"    OP =~"=~"RIGHT=~"registro.id_registro~" )WHERE(    EXP1 =~"~~~"documento~~~".~~~"num_progressivo~~~"~"   OP =~"=~"    EXP2 =~":num_prog~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"esercizio~~~".~~~"codice~~~"~"   OP =~"=~"    EXP2 =~":anno~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"documento~~~".~~~"id_prof_documento~~~"~"   OP =~"=~"    EXP2 =~":id_profilo~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"riga_documento~~~".~~~"id_riga_doc_padre~~~"~"   OP =~"is~"    EXP2 =~"null~" ) ) ARG(NAME = ~"num_prog~" TYPE = number)  ARG(NAME = ~"id_profilo~" TYPE = number)  ARG(NAME = ~"anno~" TYPE = string) " arguments=(("num_prog", number),("id_profilo", number),("anno", string)) )
