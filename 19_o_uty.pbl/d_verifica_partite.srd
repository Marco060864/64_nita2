 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"documento~" )  TABLE(NAME=~"orafo_scar_partita~" )  TABLE(NAME=~"riga_documento~" )  TABLE(NAME=~"orafo_aper_partita~" )  TABLE(NAME=~"sog_commerciale_gen~" )  TABLE(NAME=~"orafo_titolo~" ) COLUMN(NAME=~"orafo_scar_partita.id_partita~") COLUMN(NAME=~"orafo_scar_partita.id_riga_documento~") COLUMN(NAME=~"orafo_scar_partita.val_scarico~") COLUMN(NAME=~"documento.num_progressivo~") COLUMN(NAME=~"documento.data_registrazione~") COLUMN(NAME=~"documento.num_documento~") COLUMN(NAME=~"documento.data_documento~") COLUMN(NAME=~"riga_documento.calo~") COLUMN(NAME=~"riga_documento.fino~") COLUMN(NAME=~"riga_documento.num_riga~") COLUMN(NAME=~"sog_commerciale_gen.codice~") COLUMN(NAME=~"sog_commerciale_gen.rag_soc_1~") COLUMN(NAME=~"documento.id_sog_commerciale~") COLUMN(NAME=~"orafo_aper_partita.val_apertura~") COLUMN(NAME=~"orafo_aper_partita.val_scarico~") COLUMN(NAME=~"orafo_aper_partita.id_titolo~") COLUMN(NAME=~"orafo_titolo.titolo~")    JOIN (LEFT=~"riga_documento.id_documento~"    OP =~"=~"RIGHT=~"documento.id_documento~" )    JOIN (LEFT=~"orafo_scar_partita.id_riga_documento~"    OP =~"=~"RIGHT=~"riga_documento.id_riga_partita~" )    JOIN (LEFT=~"orafo_aper_partita.id_partita~"    OP =~"=~"RIGHT=~"orafo_scar_partita.id_partita~" )    JOIN (LEFT=~"documento.id_sog_commerciale~"    OP =~"=~"RIGHT=~"sog_commerciale_gen.id_sog_commerciale~" )    JOIN (LEFT=~"orafo_titolo.id_titolo~"    OP =~"=~"RIGHT=~"orafo_aper_partita.id_titolo~" )) ORDER(NAME=~"orafo_scar_partita.id_partita~" ASC=yes )  ORDER(NAME=~"documento.data_documento~" ASC=yes )  ORDER(NAME=~"documento.num_documento~" ASC=yes ) " filter="/* sog_commerciale_gen_codice ='CL010009' and  round(  c_finocalo  ,2) <>  round(c_somma_scarichi,2) */ 
sog_commerciale_gen_codice ='FO010100' and  doc_data_documento_1 <=date('2008-12-31')" sort="orafo_scar_partita_id_riga_documento A " )
