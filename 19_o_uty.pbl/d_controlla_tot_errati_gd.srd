 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"documento~" )  TABLE(NAME=~"riga_documento~" )  TABLE(NAME=~"unita_confezione~" )  TABLE(NAME=~"unita_misura~" )  TABLE(NAME=~"prof_documento~" )  TABLE(NAME=~"articolo~" ) COLUMN(NAME=~"documento.num_progressivo~") COLUMN(NAME=~"documento.data_registrazione~") COLUMN(NAME=~"documento.num_documento~") COLUMN(NAME=~"documento.data_documento~") COLUMN(NAME=~"riga_documento.quantita~") COLUMN(NAME=~"riga_documento.peso_netto~") COLUMN(NAME=~"riga_documento.tot_riga_val_az~") COLUMN(NAME=~"riga_documento.prezzo_manifattura~") COLUMN(NAME=~"riga_documento.prezzo_metallo~") COLUMN(NAME=~"riga_documento.prezzo_complessivo~") COLUMN(NAME=~"prof_documento.codice~") COLUMN(NAME=~"articolo.codice~") COLUMN(NAME=~"riga_documento.num_riga~") COLUMN(NAME=~"documento.id_documento~") COLUMN(NAME=~"riga_documento.calo~") COLUMN(NAME=~"riga_documento.fino~")    JOIN (LEFT=~"riga_documento.id_documento~"    OP =~"=~"RIGHT=~"documento.id_documento~" )    JOIN (LEFT=~"unita_confezione.id_unita_confezione~"    OP =~"=~"RIGHT=~"riga_documento.id_unita_confezione~" )    JOIN (LEFT=~"unita_confezione.id_unita_misura~"    OP =~"=~"RIGHT=~"unita_misura.id_unita_misura~" )    JOIN (LEFT=~"prof_documento.id_prof_documento~"    OP =~"=~"RIGHT=~"documento.id_prof_documento~" )    JOIN (LEFT=~"riga_documento.id_articolo~"    OP =~"=~"RIGHT=~"articolo.id_articolo~" )WHERE(    EXP1 =~"~~~"riga_documento~~~".~~~"tot_riga_val_az~~~"~"   OP =~"<>~"    EXP2 =~"round(~~~"riga_documento~~~".~~~"quantita~~~" * ~~~"riga_documento~~~".~~~"prezzo_complessivo~~~", 2)~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"unita_misura~~~".~~~"tipo~~~"~"   OP =~"=~"    EXP2 =~"'N'~" ) ) "  sort="documento_data_documento A documento_num_documento A " )
