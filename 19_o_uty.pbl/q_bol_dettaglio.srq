PBSELECT( VERSION(400) TABLE(NAME="bollettine_excel" )  TABLE(NAME="catena_resa" ) COLUMN(NAME="bollettine_excel.cod_barre") COLUMN(NAME="bollettine_excel.data") COLUMN(NAME="bollettine_excel.cod_art_assegnato") COLUMN(NAME="bollettine_excel.articolo") COLUMN(NAME="bollettine_excel.cliente") COLUMN(NAME="bollettine_excel.num_ordine") COLUMN(NAME="bollettine_excel.metallo") COLUMN(NAME="bollettine_excel.titolo") COLUMN(NAME="catena_resa.data_reso") COLUMN(NAME="catena_resa.num_bollettina") COLUMN(NAME="catena_resa.legato") COLUMN(NAME="catena_resa.num_riga") COLUMN(NAME="catena_resa.descrizione") COLUMN(NAME="bollettine_excel.fornitore") COMPUTE(NAME="~"catena_resa~".~"legato~"  as c_peso_lordo") COMPUTE(NAME="0.00 as c_lacci") COMPUTE(NAME="0.00 as c_peso_netto") COLUMN(NAME="bollettine_excel.id_riga_documento") COMPUTE(NAME="0.0001 as c_tara")    JOIN (LEFT="catena_resa.num_bollettina"    OP ="="RIGHT="bollettine_excel.cod_barre"    OUTER2 ="bollettine_excel.cod_barre" )WHERE(    EXP1 ="~"bollettine_excel~".~"cod_barre~""   OP ="="    EXP2 =":n_bol" ) ) ARG(NAME = "n_bol" TYPE = string) 