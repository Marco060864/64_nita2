 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"distinta~" ) COLUMN(NAME=~"distinta.id_distinta~") COLUMN(NAME=~"distinta.codice~") COLUMN(NAME=~"distinta.descrizione~") COLUMN(NAME=~"distinta.id_articolo~") COLUMN(NAME=~"distinta.id_dis_base~") COLUMN(NAME=~"distinta.ricarico~") COLUMN(NAME=~"distinta.calo~") COLUMN(NAME=~"distinta.data_ora_creazione~") COLUMN(NAME=~"distinta.data_ora_ult_cambiamento~") COLUMN(NAME=~"distinta.data_ora_ult_agg~") COLUMN(NAME=~"distinta.tipo_aggiornamento~") COLUMN(NAME=~"distinta.tipo_cal_valore~") COLUMN(NAME=~"distinta.tipo_applicazione~") COLUMN(NAME=~"distinta.id_azienda~") COLUMN(NAME=~"distinta.id_valuta~") COLUMN(NAME=~"distinta.note~") COLUMN(NAME=~"distinta.peso_netto~") COLUMN(NAME=~"distinta.tipo_ric~") COLUMN(NAME=~"distinta.blocco_val~")WHERE(    EXP1 =~"~~~"distinta~~~".~~~"id_articolo~~~"~"   OP =~"=~"    EXP2 =~":id_articolo~" ) ) ARG(NAME = ~"id_articolo~" TYPE = number) " update="distinta" updatewhere=1 updatekeyinplace=yes arguments=(("id_articolo", number)) )
