 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"orafo_scar_partita~" )  TABLE(NAME=~"riga_documento~" )  TABLE(NAME=~"documento~" )  TABLE(NAME=~"orafo_tipo_partita~" )  TABLE(NAME=~"caus_magazzino~" )  TABLE(NAME=~"sog_commerciale_gen~" )  TABLE(NAME=~"registro~" ) COLUMN(NAME=~"riga_documento.calo~") COLUMN(NAME=~"riga_documento.fino~") COLUMN(NAME=~"riga_documento.id_riga_documento~") COLUMN(NAME=~"riga_documento.id_documento~") COLUMN(NAME=~"riga_documento.num_riga~") COLUMN(NAME=~"riga_documento.peso_netto~") COLUMN(NAME=~"orafo_scar_partita.id_partita~") COLUMN(NAME=~"orafo_scar_partita.val_scarico~") COLUMN(NAME=~"riga_documento.id_riga_partita~") COLUMN(NAME=~"documento.num_documento~") COLUMN(NAME=~"documento.data_documento~") COLUMN(NAME=~"orafo_tipo_partita.cod_tipo_partita~") COLUMN(NAME=~"sog_commerciale_gen.codice~") COLUMN(NAME=~"sog_commerciale_gen.rag_soc_1~") COLUMN(NAME=~"registro.tipo_registro~")    JOIN (LEFT=~"riga_documento.id_riga_partita~"    OP =~"=~"RIGHT=~"orafo_scar_partita.id_riga_documento~"    OUTER1 =~"riga_documento.id_riga_partita~" )    JOIN (LEFT=~"caus_magazzino.id_tipo_partita~"    OP =~"=~"RIGHT=~"orafo_tipo_partita.id_tipo_partita~" )    JOIN (LEFT=~"caus_magazzino.id_caus_magazzino~"    OP =~"=~"RIGHT=~"riga_documento.id_caus_magazzino~" )    JOIN (LEFT=~"documento.id_documento~"    OP =~"=~"RIGHT=~"riga_documento.id_documento~" )    JOIN (LEFT=~"sog_commerciale_gen.id_sog_commerciale~"    OP =~"=~"RIGHT=~"documento.id_sog_commerciale~" )    JOIN (LEFT=~"registro.id_registro~"    OP =~"=~"RIGHT=~"documento.id_registro~" )WHERE(    EXP1 =~"~~~"documento~~~".~~~"data_documento~~~"~"   OP =~">=~"    EXP2 =~":da_data~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"documento~~~".~~~"data_documento~~~"~"   OP =~"<=~"    EXP2 =~":a_data~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"substr(~~~"orafo_tipo_partita~~~".~~~"cod_tipo_partita~~~", 1,1)~"   OP =~"=~"    EXP2 =~"'S'~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"substr(~~~"registro~~~".~~~"tipo_registro~~~",1,1)~"   OP =~"<>~"    EXP2 =~"'G'~" ) ) ARG(NAME = ~"da_data~" TYPE = date)  ARG(NAME = ~"a_data~" TYPE = date) " arguments=(("da_data", date),("a_data", date))  sort="riga_documento_id_riga_partita A documento_data_documento A " )
