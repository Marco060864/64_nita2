 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"articolo~" )  TABLE(NAME=~"unita_confezione~" )  TABLE(NAME=~"unita_misura~" )  TABLE(NAME=~"variazione~" )  TABLE(NAME=~"prezzo~" )  TABLE(NAME=~"listino~" ) COLUMN(NAME=~"articolo.id_articolo~") COLUMN(NAME=~"articolo.codice~") COLUMN(NAME=~"unita_misura.tipo~") COLUMN(NAME=~"unita_confezione.peso_netto~") COLUMN(NAME=~"unita_confezione.peso_non_prezioso~") COLUMN(NAME=~"articolo.spina~") COLUMN(NAME=~"prezzo.prezzo~") COLUMN(NAME=~"prezzo.prezzo_manifattura~")    JOIN (LEFT=~"unita_confezione.id_articolo~"    OP =~"=~"RIGHT=~"articolo.id_articolo~" )    JOIN (LEFT=~"unita_confezione.id_unita_misura~"    OP =~"=~"RIGHT=~"unita_misura.id_unita_misura~" )    JOIN (LEFT=~"prezzo.id_variazione~"    OP =~"=~"RIGHT=~"variazione.id_variazione~" )    JOIN (LEFT=~"prezzo.id_unita_confezione~"    OP =~"=~"RIGHT=~"unita_confezione.id_unita_confezione~" )    JOIN (LEFT=~"listino.id_listino~"    OP =~"=~"RIGHT=~"variazione.id_listino~" )WHERE(    EXP1 =~"~~~"unita_confezione~~~".~~~"unita_base~~~"~"   OP =~"=~"    EXP2 =~"'S'~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"listino~~~".~~~"tipo~~~"~"   OP =~"=~"    EXP2 =~"'A'~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"listino~~~".~~~"lis_base~~~"~"   OP =~"=~"    EXP2 =~"'S'~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"variazione~~~".~~~"data_inizio~~~"~"   OP =~"<=~"    EXP2 =~"today()~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"(~~~"variazione~~~".~~~"data_fine~~~"~"   OP =~">=~"    EXP2 =~"today()~"    LOGIC =~"or~" ) WHERE(    EXP1 =~"~~~"variazione~~~".~~~"data_fine~~~"~"   OP =~"is~"    EXP2 =~"null)~" ) ) "  sort="articolo_codice A " )
