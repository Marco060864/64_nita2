table(column=(type=long updatewhereclause=yes name=documento_id_documento dbname="documento.id_documento" )
 column=(type=decimal(0) updatewhereclause=yes name=documento_num_progressivo dbname="documento.num_progressivo" )
 column=(type=date updatewhereclause=yes name=documento_data_registrazione dbname="documento.data_registrazione" )
 column=(type=char(16) updatewhereclause=yes name=documento_num_documento dbname="documento.num_documento" )
 column=(type=date updatewhereclause=yes name=documento_data_documento dbname="documento.data_documento" )
 column=(type=long updatewhereclause=yes key=yes name=riga_documento_id_riga_documento dbname="riga_documento.id_riga_documento" )
 column=(type=decimal(0) updatewhereclause=yes name=riga_documento_num_riga dbname="riga_documento.num_riga" )
 column=(type=char(64) updatewhereclause=yes name=articolo_codice dbname="articolo.codice" )
 column=(type=long updatewhereclause=yes name=articolo_id_articolo dbname="articolo.id_articolo" )
 column=(type=decimal(4) updatewhereclause=yes name=riga_documento_quantita dbname="riga_documento.quantita" )
 column=(type=decimal(4) updatewhereclause=yes name=peso_netto dbname="riga_documento.peso_netto" )
 column=(type=decimal(2) updatewhereclause=yes name=coef_calo dbname="riga_documento.coef_calo" )
 column=(type=decimal(4) update=yes updatewhereclause=yes name=calo dbname="riga_documento.calo" )
 column=(type=decimal(4) update=yes updatewhereclause=yes name=fino dbname="riga_documento.fino" )
 column=(type=long updatewhereclause=yes name=articolo_id_titolo dbname="articolo.id_titolo" )
 column=(type=decimal(4) updatewhereclause=yes name=sum_finocalo dbname="sum_finocalo" )
 column=(type=char(8) updatewhereclause=yes name=prof_documento_codice dbname="prof_documento.codice" )
 column=(type=decimal(2) updatewhereclause=yes name=titolo dbname="orafo_titolo.titolo" )
 column=(type=decimal(11) updatewhereclause=yes name=peso_fc dbname="peso_fc" )
 column=(type=decimal(4) updatewhereclause=yes name=peso_non_prezioso dbname="riga_documento.peso_non_prezioso" )
 column=(type=long updatewhereclause=yes name=riga_documento_id_riga_sorgente dbname="riga_documento.id_riga_sorgente" )
 column=(type=long updatewhereclause=yes name=id_riga_doc_padre dbname="riga_documento.id_riga_doc_padre" )
 column=(type=char(2) updatewhereclause=yes name=registro_tipo_registro dbname="registro.tipo_registro" )
 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"riga_documento~" )  TABLE(NAME=~"documento~" )  TABLE(NAME=~"articolo~" )  TABLE(NAME=~"prof_documento~" )  TABLE(NAME=~"orafo_titolo~" )  TABLE(NAME=~"registro~" ) COLUMN(NAME=~"documento.id_documento~") COLUMN(NAME=~"documento.num_progressivo~") COLUMN(NAME=~"documento.data_registrazione~") COLUMN(NAME=~"documento.num_documento~") COLUMN(NAME=~"documento.data_documento~") COLUMN(NAME=~"riga_documento.id_riga_documento~") COLUMN(NAME=~"riga_documento.num_riga~") COLUMN(NAME=~"articolo.codice~") COLUMN(NAME=~"articolo.id_articolo~") COLUMN(NAME=~"riga_documento.quantita~") COLUMN(NAME=~"riga_documento.peso_netto~") COLUMN(NAME=~"riga_documento.coef_calo~") COLUMN(NAME=~"riga_documento.calo~") COLUMN(NAME=~"riga_documento.fino~") COLUMN(NAME=~"articolo.id_titolo~") COMPUTE(NAME=~"fino+calo as sum_finocalo~") COLUMN(NAME=~"prof_documento.codice~") COLUMN(NAME=~"orafo_titolo.titolo~") COMPUTE(NAME=~"round(riga_documento.coef_calo*  riga_documento.peso_netto /1000, 2) as peso_fc~") COLUMN(NAME=~"riga_documento.peso_non_prezioso~") COLUMN(NAME=~"riga_documento.id_riga_sorgente~") COLUMN(NAME=~"riga_documento.id_riga_doc_padre~") COLUMN(NAME=~"registro.tipo_registro~")    JOIN (LEFT=~"documento.id_documento~"    OP =~"=~"RIGHT=~"riga_documento.id_documento~" )    JOIN (LEFT=~"articolo.id_articolo~"    OP =~"=~"RIGHT=~"riga_documento.id_articolo~" )    JOIN (LEFT=~"prof_documento.id_prof_documento~"    OP =~"=~"RIGHT=~"documento.id_prof_documento~" )    JOIN (LEFT=~"orafo_titolo.id_titolo~"    OP =~"=~"RIGHT=~"articolo.id_titolo~" )    JOIN (LEFT=~"documento.id_registro~"    OP =~"=~"RIGHT=~"registro.id_registro~" )WHERE(    EXP1 =~"round(riga_documento.peso_netto  *riga_documento.coef_calo/1000, 2)~"   OP =~"<>~"    EXP2 =~"sum_finocalo~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"(~~~"registro~~~".~~~"tipo_registro~~~"~"   OP =~"=~"    EXP2 =~"'DV'~"    LOGIC =~"or~" ) WHERE(    EXP1 =~"~~~"prof_documento~~~".~~~"tipo_documento_ae~~~"~"   OP =~"=~"    EXP2 =~"'TD01')~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"documento~~~".~~~"data_documento~~~"~"   OP =~">=~"    EXP2 =~"20250101~" ) ) " update="riga_documento" updatewhere=1 updatekeyinplace=yes  sort="documento_data_documento A documento_num_documento A riga_documento_num_riga A " )
