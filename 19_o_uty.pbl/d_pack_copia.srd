 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"pack_t~" )  TABLE(NAME=~"documento~" )  TABLE(NAME=~"azienda~" )  TABLE(NAME=~"sede~" )  TABLE(NAME=~"destinazione~" )  TABLE(NAME=~"sog_commerciale_gen~" ) COLUMN(NAME=~"pack_t.num_ordine~") COLUMN(NAME=~"pack_t.somma_qta_riga_doc~") COLUMN(NAME=~"pack_t.dept~") COLUMN(NAME=~"pack_t.division_destinazione~") COLUMN(NAME=~"pack_t.id_pack_t~") COLUMN(NAME=~"pack_t.from~") COLUMN(NAME=~"pack_t.to~") COLUMN(NAME=~"azienda.rag_soc_1~") COLUMN(NAME=~"sede.indirizzo~") COLUMN(NAME=~"sede.cap~") COLUMN(NAME=~"sede.localita~") COLUMN(NAME=~"sede.provincia~") COLUMN(NAME=~"sede.nazione~") COLUMN(NAME=~"destinazione.rag_soc_1~") COLUMN(NAME=~"destinazione.indirizzo~") COLUMN(NAME=~"destinazione.rag_soc_2~") COLUMN(NAME=~"destinazione.cap~") COLUMN(NAME=~"destinazione.localita~") COLUMN(NAME=~"destinazione.provincia~") COLUMN(NAME=~"destinazione.nazione~") COLUMN(NAME=~"sog_commerciale_gen.rag_soc_1~") COLUMN(NAME=~"sog_commerciale_gen.indirizzo~") COLUMN(NAME=~"sog_commerciale_gen.cap~") COLUMN(NAME=~"sog_commerciale_gen.localita~") COLUMN(NAME=~"sog_commerciale_gen.provincia~") COLUMN(NAME=~"sog_commerciale_gen.rag_soc_2~") COLUMN(NAME=~"sog_commerciale_gen.nazione~") COLUMN(NAME=~"documento.num_documento~") COLUMN(NAME=~"documento.data_documento~") COLUMN(NAME=~"documento.id_documento~") COLUMN(NAME=~"pack_t.id_documento~") COLUMN(NAME=~"documento.bollo~") COLUMN(NAME=~"pack_t.ship_1~") COLUMN(NAME=~"pack_t.ship_2~") COLUMN(NAME=~"pack_t.master_c~") COLUMN(NAME=~"pack_t.po~") COLUMN(NAME=~"pack_t.master_contract_bollo~")    JOIN (LEFT=~"destinazione.id_destinazione~"    OP =~"=~"RIGHT=~"documento.id_destinazione~"    OUTER2 =~"documento.id_destinazione~" )    JOIN (LEFT=~"documento.id_documento~"    OP =~"=~"RIGHT=~"pack_t.id_documento~" )    JOIN (LEFT=~"documento.id_azienda~"    OP =~"=~"RIGHT=~"azienda.id_azienda~" )    JOIN (LEFT=~"azienda.id_azienda~"    OP =~"=~"RIGHT=~"sede.id_azienda~" )    JOIN (LEFT=~"sog_commerciale_gen.id_sog_commerciale~"    OP =~"=~"RIGHT=~"documento.id_sog_commerciale~" )WHERE(    EXP1 =~"~~~"documento~~~".~~~"id_documento~~~"~"   OP =~"=~"    EXP2 =~":rn_id_pack_t~" ) ) ARG(NAME = ~"rn_id_pack_t~" TYPE = number) " arguments=(("rn_id_pack_t", number)) )
