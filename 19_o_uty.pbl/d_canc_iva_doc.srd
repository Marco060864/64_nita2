table(column=(type=long update=yes updatewhereclause=yes key=yes name=cast_iva_documento_id_documento dbname="cast_iva_documento.id_documento" )
 column=(type=long update=yes updatewhereclause=yes key=yes name=cast_iva_documento_id_tab_iva dbname="cast_iva_documento.id_tab_iva" )
 column=(type=decimal(4) update=yes updatewhereclause=yes name=cast_iva_documento_val_omaggi dbname="cast_iva_documento.val_omaggi" )
 column=(type=decimal(4) update=yes updatewhereclause=yes name=cast_iva_documento_val_imponibile dbname="cast_iva_documento.val_imponibile" )
 column=(type=decimal(4) update=yes updatewhereclause=yes name=cast_iva_documento_val_imp_scontato dbname="cast_iva_documento.val_imp_scontato" )
 column=(type=decimal(4) update=yes updatewhereclause=yes name=cast_iva_documento_val_spese dbname="cast_iva_documento.val_spese" )
 column=(type=decimal(4) update=yes updatewhereclause=yes name=cast_iva_documento_val_tot_imp_v dbname="cast_iva_documento.val_tot_imp_v" )
 column=(type=decimal(4) update=yes updatewhereclause=yes name=cast_iva_documento_val_tot_imp_l dbname="cast_iva_documento.val_tot_imp_l" )
 column=(type=decimal(4) update=yes updatewhereclause=yes name=cast_iva_documento_val_tot_iva_v dbname="cast_iva_documento.val_tot_iva_v" )
 column=(type=decimal(4) update=yes updatewhereclause=yes name=cast_iva_documento_val_tot_iva_l dbname="cast_iva_documento.val_tot_iva_l" )
 retrieve="  SELECT   
         ~"cast_iva_documento~".~"id_documento~",   
         ~"cast_iva_documento~".~"id_tab_iva~",   
         ~"cast_iva_documento~".~"val_omaggi~",   
         ~"cast_iva_documento~".~"val_imponibile~",   
         ~"cast_iva_documento~".~"val_imp_scontato~",   
         ~"cast_iva_documento~".~"val_spese~",   
         ~"cast_iva_documento~".~"val_tot_imp_v~",   
         ~"cast_iva_documento~".~"val_tot_imp_l~",   
         ~"cast_iva_documento~".~"val_tot_iva_v~",   
         ~"cast_iva_documento~".~"val_tot_iva_l~"  
    FROM ~"caus_magazzino~",   
         ~"documento~",   
         ~"sog_commerciale~",   
         ~"cast_iva_documento~"  
   WHERE ( ~"documento~".~"id_caus_magazzino~" = ~"caus_magazzino~".~"id_caus_magazzino~" ) and  
         ( ~"sog_commerciale~".~"id_sog_commerciale~" = ~"documento~".~"id_sog_commerciale~" ) and  
         ( ~"cast_iva_documento~".~"id_documento~" = ~"documento~".~"id_documento~" ) and  
         ( ( ~"caus_magazzino~".~"codice~" >= :da_caus ) AND  
         ( ~"caus_magazzino~".~"codice~" <= :a_caus ) AND  
         (( ~"documento~".~"data_documento~" >= :da_data ) AND  
         ( ~"documento~".~"data_documento~" <= :a_data ) or 
			~"documento~".~"data_documento~" is null) AND  
         ( ~"sog_commerciale~".~"codice~" >= :da_sog ) AND  
         ( ~"sog_commerciale~".~"codice~" <= :a_sog ) )    
" update="cast_iva_documento" updatewhere=0 updatekeyinplace=no arguments=(("da_data", date),("a_data", date),("da_sog", string),("a_sog", string),("da_caus", string),("a_caus", string)) )
