table(column=(type=long updatewhereclause=yes identity=yes name=articolo_id_articolo dbname="articolo.id_articolo" )
 column=(type=char(32) updatewhereclause=yes name=articolo_codice dbname="articolo.codice" )
 column=(type=char(80) updatewhereclause=yes name=articolo_descrizione dbname="articolo.descrizione" )
 column=(type=datetime updatewhereclause=yes name=articolo_data_ora_creazione dbname="articolo.data_ora_creazione" )
 column=(type=datetime updatewhereclause=yes name=articolo_data_ora_ult_cambiamento dbname="articolo.data_ora_ult_cambiamento" )
 column=(type=decimal(2) updatewhereclause=yes name=orafo_titolo_titolo dbname="orafo_titolo.titolo" )
 column=(type=decimal(2) updatewhereclause=yes name=articolo_coef_calo dbname="articolo.coef_calo" )
 column=(type=char(1) updatewhereclause=yes name=ruota dbname="ruota" )
 column=(type=char(1) updatewhereclause=yes name=articolo_stampa_in_catalogo dbname="articolo.stampa_in_catalogo" )
 column=(type=decimal(4) updatewhereclause=yes name=unita_confezione_peso_netto dbname="unita_confezione.peso_netto" )
 column=(type=long updatewhereclause=yes name=um_id dbname="um_id" )
 column=(type=decimal(4) updatewhereclause=yes name=unita_confezione_dim_l dbname="unita_confezione.dim_l" )
 column=(type=char(1) updatewhereclause=yes name=usa_in_magazzino dbname="usa_in_magazzino" )
 column=(type=decimal(4) updatewhereclause=yes name=unita_confezione_peso_non_prezioso dbname="unita_confezione.peso_non_prezioso" )
 column=(type=char(32) updatewhereclause=yes name=barcode dbname="barcode" )
 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"articolo~" )  TABLE(NAME=~"unita_confezione~" )  TABLE(NAME=~"orafo_titolo~" ) COLUMN(NAME=~"articolo.id_articolo~") COLUMN(NAME=~"articolo.codice~") COLUMN(NAME=~"articolo.descrizione~") COLUMN(NAME=~"articolo.data_ora_creazione~") COLUMN(NAME=~"articolo.data_ora_ult_cambiamento~") COLUMN(NAME=~"orafo_titolo.titolo~") COLUMN(NAME=~"articolo.coef_calo~") COMPUTE(NAME=~"'N' as ruota~") COLUMN(NAME=~"articolo.stampa_in_catalogo~") COLUMN(NAME=~"unita_confezione.peso_netto~") COMPUTE(NAME=~"1 as um_id~") COLUMN(NAME=~"unita_confezione.dim_l~") COMPUTE(NAME=~"'S' as usa_in_magazzino~") COLUMN(NAME=~"unita_confezione.peso_non_prezioso~") COMPUTE(NAME=~"'00000000000000000000000000000000' as barcode~")    JOIN (LEFT=~"unita_confezione.id_articolo~"    OP =~"=~"RIGHT=~"articolo.id_articolo~" )    JOIN (LEFT=~"orafo_titolo.id_titolo~"    OP =~"=~"RIGHT=~"articolo.id_titolo~" )WHERE(    EXP1 =~"~~~"articolo~~~".~~~"codice~~~"~"   OP =~"like~"    EXP2 =~"'%-%'~" ) ) " filter="long(right( articolo_codice , 5)) >0 and long(right( articolo_codice , 5)) < 99999" sort="articolo_codice A " )
