 column=(type=long update=yes updatewhereclause=yes name=documento_id_documento_padre dbname="documento.id_documento_padre" dbalias=".id_documento_padre" )
 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"caus_magazzino~" )  TABLE(NAME=~"documento~" )  TABLE(NAME=~"sog_commerciale~" ) COLUMN(NAME=~"documento.data_documento~") COLUMN(NAME=~"documento.id_documento~") COLUMN(NAME=~"documento.num_progressivo~") COLUMN(NAME=~"documento.data_registrazione~") COLUMN(NAME=~"documento.num_documento~") COLUMN(NAME=~"documento.data_ora_creazione~") COLUMN(NAME=~"documento.id_documento_padre~")    JOIN (LEFT=~"documento.id_caus_magazzino~"    OP =~"=~"RIGHT=~"caus_magazzino.id_caus_magazzino~" )    JOIN (LEFT=~"sog_commerciale.id_sog_commerciale~"    OP =~"=~"RIGHT=~"documento.id_sog_commerciale~" )WHERE(    EXP1 =~"( ~~~"caus_magazzino~~~".~~~"codice~~~"~"   OP =~">=~"    EXP2 =~":da_caus )~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"( ~~~"caus_magazzino~~~".~~~"codice~~~"~"   OP =~"<=~"    EXP2 =~":a_caus )~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"(( ~~~"documento~~~".~~~"data_documento~~~"~"   OP =~">=~"    EXP2 =~":da_data )~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"( ~~~"documento~~~".~~~"data_documento~~~"~"   OP =~"<=~"    EXP2 =~":a_data )~"    LOGIC =~"or~" ) WHERE(    EXP1 =~"(~~~"documento~~~".~~~"data_documento~~~"~"   OP =~"is~"    EXP2 =~"null))~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"( ~~~"sog_commerciale~~~".~~~"codice~~~"~"   OP =~">=~"    EXP2 =~":da_sog )~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"( ~~~"sog_commerciale~~~".~~~"codice~~~"~"   OP =~"<=~"    EXP2 =~":a_sog )~" ) ) ARG(NAME = ~"da_data~" TYPE = date)  ARG(NAME = ~"a_data~" TYPE = date)  ARG(NAME = ~"da_sog~" TYPE = string)  ARG(NAME = ~"a_sog~" TYPE = string)  ARG(NAME = ~"da_caus~" TYPE = string)  ARG(NAME = ~"a_caus~" TYPE = string) " update="documento" updatewhere=1 updatekeyinplace=yes arguments=(("da_data", date),("a_data", date),("da_sog", string),("a_sog", string),("da_caus", string),("a_caus", string))  sort="documento_data_documento D documento_data_ora_creazione D " )
