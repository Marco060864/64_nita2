 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"riga_documento~" )  TABLE(NAME=~"des_articolo~" )  TABLE(NAME=~"articolo~" ) COLUMN(NAME=~"riga_documento.id_riga_documento~") COLUMN(NAME=~"riga_documento.num_riga~") COLUMN(NAME=~"riga_documento.descrizione~") COLUMN(NAME=~"riga_documento.quantita~") COLUMN(NAME=~"riga_documento.peso_netto~") COLUMN(NAME=~"riga_documento.num_colli~") COLUMN(NAME=~"des_articolo.codice~") COLUMN(NAME=~"des_articolo.descrizione~") COLUMN(NAME=~"des_articolo.des_estesa~") COLUMN(NAME=~"articolo.spina~")    JOIN (LEFT=~"des_articolo.id_des_articolo~"    OP =~"=~"RIGHT=~"riga_documento.id_des_articolo~" )    JOIN (LEFT=~"articolo.id_articolo~"    OP =~"=~"RIGHT=~"riga_documento.id_articolo~" )WHERE(    EXP1 =~"~~~"riga_documento~~~".~~~"id_documento~~~"~"   OP =~"=~"    EXP2 =~":rn_id_doc~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"des_articolo~~~".~~~"codice~~~"~"   OP =~">=~"    EXP2 =~"'0'~" ) ) ARG(NAME = ~"rn_id_doc~" TYPE = number) " arguments=(("rn_id_doc", number))  sort="riga_documento_num_riga A " )
