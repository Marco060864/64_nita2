 column=(type=decimal(2) updatewhereclause=yes name=riga_documento_coef_calo dbname="riga_documento.coef_calo" )
 column=(type=char(40) updatewhereclause=yes name=anagrafica_rag_soc_1 dbname="anagrafica.rag_soc_1" )
 column=(type=decimal(4) updatewhereclause=yes name=riga_documento_dim_l dbname="riga_documento.dim_l" )
 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"orafo_lung_peso_righe~" )  TABLE(NAME=~"documento~" )  TABLE(NAME=~"riga_documento~" )  TABLE(NAME=~"articolo~" )  TABLE(NAME=~"prof_documento~" )  TABLE(NAME=~"anagrafica~" )  TABLE(NAME=~"sog_commerciale~" ) COLUMN(NAME=~"prof_documento.codice~") COLUMN(NAME=~"documento.num_documento~") COLUMN(NAME=~"documento.data_documento~") COLUMN(NAME=~"riga_documento.num_riga~") COLUMN(NAME=~"articolo.codice~") COLUMN(NAME=~"riga_documento.prezzo_manifattura~") COLUMN(NAME=~"riga_documento.quantita~") COLUMN(NAME=~"riga_documento.peso_netto~") COLUMN(NAME=~"riga_documento.coef_calo~") COLUMN(NAME=~"anagrafica.rag_soc_1~") COLUMN(NAME=~"riga_documento.dim_l~")    JOIN (LEFT=~"riga_documento.id_documento~"    OP =~"=~"RIGHT=~"documento.id_documento~" )    JOIN (LEFT=~"orafo_lung_peso_righe.id_riga_documento~"    OP =~"=~"RIGHT=~"riga_documento.id_riga_documento~" )    JOIN (LEFT=~"riga_documento.id_articolo~"    OP =~"=~"RIGHT=~"articolo.id_articolo~" )    JOIN (LEFT=~"documento.id_prof_documento~"    OP =~"=~"RIGHT=~"prof_documento.id_prof_documento~" )    JOIN (LEFT=~"sog_commerciale.id_anagrafica~"    OP =~"=~"RIGHT=~"anagrafica.id_anagrafica~" )    JOIN (LEFT=~"documento.id_sog_commerciale~"    OP =~"=~"RIGHT=~"sog_commerciale.id_sog_commerciale~" )WHERE(    EXP1 =~"~~~"orafo_lung_peso_righe~~~".~~~"id_lung_peso~~~"~"   OP =~"=~"    EXP2 =~":id_lung_peso~" ) ) ARG(NAME = ~"id_lung_peso~" TYPE = number) " arguments=(("id_lung_peso", number)) )
