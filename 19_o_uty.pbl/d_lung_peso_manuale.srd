 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"orafo_lung_peso~" )  TABLE(NAME=~"articolo~" )  TABLE(NAME=~"anagrafica~" )  TABLE(NAME=~"sog_commerciale~" )  TABLE(NAME=~"riga_documento~" )  TABLE(NAME=~"des_articolo~" )  TABLE(NAME=~"documento~" ) COLUMN(NAME=~"orafo_lung_peso.id_lung_peso~") COLUMN(NAME=~"orafo_lung_peso.id_sog_commerciale~") COLUMN(NAME=~"orafo_lung_peso.id_articolo~") COLUMN(NAME=~"orafo_lung_peso.ultimo_aggiornamento~") COLUMN(NAME=~"orafo_lung_peso.id_riga_documento~") COLUMN(NAME=~"orafo_lung_peso.lunghezza~") COLUMN(NAME=~"orafo_lung_peso.peso_unitario~") COLUMN(NAME=~"orafo_lung_peso.simbolo_um~") COLUMN(NAME=~"articolo.codice~") COLUMN(NAME=~"anagrafica.rag_soc_1~") COLUMN(NAME=~"des_articolo.codice~") COLUMN(NAME=~"riga_documento.num_riga~") COLUMN(NAME=~"documento.num_documento~") COLUMN(NAME=~"documento.data_documento~") COLUMN(NAME=~"orafo_lung_peso.peso_manuale~") COLUMN(NAME=~"sog_commerciale.codice~")    JOIN (LEFT=~"riga_documento.id_des_articolo~"    OP =~"=~"RIGHT=~"des_articolo.id_des_articolo~"    OUTER1 =~"riga_documento.id_des_articolo~" )    JOIN (LEFT=~"orafo_lung_peso.id_riga_documento~"    OP =~"=~"RIGHT=~"riga_documento.id_riga_documento~"    OUTER1 =~"orafo_lung_peso.id_riga_documento~" )    JOIN (LEFT=~"riga_documento.id_documento~"    OP =~"=~"RIGHT=~"documento.id_documento~"    OUTER1 =~"riga_documento.id_documento~" )    JOIN (LEFT=~"orafo_lung_peso.id_articolo~"    OP =~"=~"RIGHT=~"articolo.id_articolo~" )    JOIN (LEFT=~"sog_commerciale.id_anagrafica~"    OP =~"=~"RIGHT=~"anagrafica.id_anagrafica~" )    JOIN (LEFT=~"orafo_lung_peso.id_sog_commerciale~"    OP =~"=~"RIGHT=~"sog_commerciale.id_sog_commerciale~" )WHERE(    EXP1 =~"~~~"sog_commerciale~~~".~~~"codice~~~"~"   OP =~">=~"    EXP2 =~":da_rag_soc~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"sog_commerciale~~~".~~~"codice~~~"~"   OP =~"<=~"    EXP2 =~":a_rag_soc~" ) ) ARG(NAME = ~"da_rag_soc~" TYPE = string)  ARG(NAME = ~"a_rag_soc~" TYPE = string) " update="orafo_lung_peso" updatewhere=1 updatekeyinplace=yes arguments=(("da_rag_soc", string),("a_rag_soc", string))  sort="anagrafica_rag_soc_1 A articolo A ultimo_aggiornamento D orafo_lung_peso_id_riga_documento D lunghezza D " )
