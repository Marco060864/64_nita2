 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"articolo~" )  TABLE(NAME=~"documento~" )  TABLE(NAME=~"riga_documento~" )  TABLE(NAME=~"gruppo_articoli~" ) COLUMN(NAME=~"documento.id_documento~") COLUMN(NAME=~"documento.num_progressivo~") COLUMN(NAME=~"documento.data_registrazione~") COLUMN(NAME=~"documento.num_documento~") COLUMN(NAME=~"documento.data_documento~") COLUMN(NAME=~"riga_documento.num_riga~") COLUMN(NAME=~"riga_documento.descrizione~") COLUMN(NAME=~"riga_documento.quantita~") COLUMN(NAME=~"riga_documento.peso_netto~") COLUMN(NAME=~"articolo.codice~") COLUMN(NAME=~"gruppo_articoli.id_gruppo_articoli~") COLUMN(NAME=~"gruppo_articoli.codice~")    JOIN (LEFT=~"gruppo_articoli.id_gruppo_articoli~"    OP =~"=~"RIGHT=~"articolo.id_gruppo_articoli~"    OUTER2 =~"articolo.id_gruppo_articoli~" )   JOIN (LEFT=~"riga_documento.id_documento~"    OP =~"=~"RIGHT=~"documento.id_documento~" )    JOIN (LEFT=~"riga_documento.id_articolo~"    OP =~"=~"RIGHT=~"articolo.id_articolo~" ) WHERE(    EXP1 =~"~~~"documento~~~".~~~"id_prof_documento~~~"~"   OP =~"=~"    EXP2 =~"145~" ) ) "  sort="documento_data_documento A documento_num_documento A riga_documento_num_riga A " )
