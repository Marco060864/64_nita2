 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"documento~" )  TABLE(NAME=~"riga_documento~" )  TABLE(NAME=~"riga_doc_estensione~" ) COLUMN(NAME=~"documento.num_progressivo~") COLUMN(NAME=~"documento.num_documento~") COLUMN(NAME=~"documento.data_documento~") COLUMN(NAME=~"riga_documento.num_riga~") COLUMN(NAME=~"riga_documento.id_articolo~") COLUMN(NAME=~"riga_documento.descrizione~") COLUMN(NAME=~"riga_documento.quantita~") COLUMN(NAME=~"riga_documento.peso_netto~") COLUMN(NAME=~"riga_documento.ordinato_fo~") COLUMN(NAME=~"riga_documento.id_riga_documento~") COLUMN(NAME=~"riga_documento.id_documento~") COLUMN(NAME=~"riga_documento.qta_evasa~") COLUMN(NAME=~"riga_documento.peso_netto_evaso~") COLUMN(NAME=~"riga_documento.coef_calo~") COLUMN(NAME=~"riga_documento.calo~") COLUMN(NAME=~"riga_documento.fino~") COMPUTE(NAME=~"cast(0 as integer) as c_modificato~") COLUMN(NAME=~"riga_documento.provv_subage_2~") COLUMN(NAME=~"riga_doc_estensione.data_ora_modifica~") COLUMN(NAME=~"riga_documento.peso_lordo~") COLUMN(NAME=~"riga_documento.peso_non_prezioso~") COLUMN(NAME=~"riga_documento.dim_l~")    JOIN (LEFT=~"riga_doc_estensione.id_riga_documento~"    OP =~"=~"RIGHT=~"riga_documento.id_riga_documento~"    OUTER2 =~"riga_documento.id_riga_documento~" )    JOIN (LEFT=~"riga_documento.id_documento~"    OP =~"=~"RIGHT=~"documento.id_documento~" )WHERE(    EXP1 =~"~~~"documento~~~".~~~"id_prof_documento~~~"~"   OP =~"=~"    EXP2 =~":id_prof_doc~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"(~~~"riga_documento~~~".~~~"qta_evasa~~~"~"   OP =~"=~"    EXP2 =~"0~"    LOGIC =~"or~" ) WHERE(    EXP1 =~"~~~"riga_documento~~~".~~~"qta_evasa~~~"~"   OP =~"is~"    EXP2 =~"null)~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"documento~~~".~~~"data_documento~~~"~"   OP =~">=~"    EXP2 =~":da_data~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"documento~~~".~~~"data_documento~~~"~"   OP =~"<=~"    EXP2 =~":a_data~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"riga_documento~~~".~~~"id_riga_doc_padre~~~"~"   OP =~"is~"    EXP2 =~"null~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"documento~~~".~~~"id_sog_commerciale~~~"~"   OP =~"=~"    EXP2 =~":id_soggetto~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"(~~~"riga_documento~~~".~~~"forza_chius_evasione~~~"~"   OP =~"is~"    EXP2 =~"null~"    LOGIC =~"or~" ) WHERE(    EXP1 =~"~~~"riga_documento~~~".~~~"forza_chius_evasione~~~"~"   OP =~"=~"    EXP2 =~"'N')~" ) ) ARG(NAME = ~"id_prof_doc~" TYPE = number)  ARG(NAME = ~"da_data~" TYPE = date)  ARG(NAME = ~"a_data~" TYPE = date)  ARG(NAME = ~"id_soggetto~" TYPE = number) " update="riga_documento" updatewhere=0 updatekeyinplace=yes arguments=(("id_prof_doc", number),("da_data", date),("a_data", date),("id_soggetto", number))  sort="num_progressivo A documento_data_documento A documento_num_documento A " )
