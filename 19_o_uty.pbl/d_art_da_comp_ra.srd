table(column=(type=long updatewhereclause=yes identity=yes name=id_articolo dbname="articolo.id_articolo" )
 column=(type=char(32) updatewhereclause=yes name=articolo_codice dbname="articolo.codice" )
 column=(type=char(80) updatewhereclause=yes name=articolo_descrizione dbname="articolo.descrizione" )
 column=(type=char(1) updatewhereclause=yes name=unita_misura_tipo dbname="unita_misura.tipo" )
 column=(type=decimal(4) updatewhereclause=yes name=peso_netto dbname="unita_confezione.peso_netto" )
 column=(type=decimal(4) updatewhereclause=yes name=dim_l dbname="unita_confezione.dim_l" )
 column=(type=decimal(0) updatewhereclause=yes name=riga_distinta_num_riga dbname="riga_distinta.num_riga" )
 column=(type=char(32) updatewhereclause=yes name=articolo_codice dbname="articolo.codice" )
 column=(type=long updatewhereclause=yes name=riga_distinta_id_articolo dbname="riga_distinta.id_articolo" )
 column=(type=long updatewhereclause=yes name=articolo_id_cat_codifica dbname="articolo.id_cat_codifica" )
 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"articolo~" ALIAS=~"articolo_a~" )  TABLE(NAME=~"unita_confezione~" )  TABLE(NAME=~"unita_misura~" )  TABLE(NAME=~"riga_distinta~" )  TABLE(NAME=~"articolo~" ALIAS=~"articolo_b~" )  TABLE(NAME=~"distinta~" ) COLUMN(NAME=~"articolo_a.id_articolo~") COLUMN(NAME=~"articolo_a.codice~") COLUMN(NAME=~"articolo_a.descrizione~") COLUMN(NAME=~"unita_misura.tipo~") COLUMN(NAME=~"unita_confezione.peso_netto~") COLUMN(NAME=~"unita_confezione.dim_l~") COLUMN(NAME=~"riga_distinta.num_riga~") COLUMN(NAME=~"articolo_b.codice~") COLUMN(NAME=~"riga_distinta.id_articolo~") COLUMN(NAME=~"articolo_a.id_cat_codifica~")    JOIN (LEFT=~"unita_confezione.id_articolo~"    OP =~"=~"RIGHT=~"articolo_a.id_articolo~" )    JOIN (LEFT=~"unita_confezione.id_unita_misura~"    OP =~"=~"RIGHT=~"unita_misura.id_unita_misura~" )    JOIN (LEFT=~"riga_distinta.id_articolo~"    OP =~"=~"RIGHT=~"articolo_b.id_articolo~" )    JOIN (LEFT=~"distinta.id_distinta~"    OP =~"=~"RIGHT=~"riga_distinta.id_distinta~" )    JOIN (LEFT=~"articolo_a.id_articolo~"    OP =~"=~"RIGHT=~"distinta.id_articolo~" )WHERE(    EXP1 =~"~~~"riga_distinta~~~".~~~"id_articolo~~~"~"   OP =~"=~"    EXP2 =~":id_art_riga_dis~" ) ) ARG(NAME = ~"id_art_riga_dis~" TYPE = number) " arguments=(("id_art_riga_dis", number))  sort="articolo_codice A " )
