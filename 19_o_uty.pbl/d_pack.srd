en.id_sog_commerciale~"    OP =~"=~"RIGHT=~"documento.id_sog_commerciale~" )WHERE(    EXP1 =~"~~~"documento~~~".~~~"id_documento~~~"~"   OP =~"=~"    EXP2 =~":rn_id_pack_t~" ) ) ARG(NAME = ~"rn_id_pack_t~" TYPE = number) " update="pack_t" updatewhere=1 updatekeyinplace=yes arguments=(("rn_id_pack_t", number)) )
