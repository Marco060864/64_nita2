 column=(type=char(40) updatewhereclause=yes name=sede_indirizzo dbname="sede.indirizzo" )
 column=(type=char(10) updatewhereclause=yes name=sede_cap dbname="sede.cap" )
 column=(type=char(40) updatewhereclause=yes name=sede_localita dbname="sede.localita" )
 column=(type=char(5) updatewhereclause=yes name=sede_provincia dbname="sede.provincia" )
 column=(type=char(128) updatewhereclause=yes name=c_cap_loc_pr dbname="c_cap_loc_pr" )
 column=(type=char(40) updatewhereclause=yes name=azienda_rag_soc_2 dbname="azienda.rag_soc_2" )
 retrieve="SELECT  anagrafica.rag_soc_1 ,
           anagrafica.indirizzo ,
           anagrafica.cap ,
           anagrafica.localita ,
           anagrafica.provincia ,
           anagrafica.nazione ,
           anagrafica.cod_fiscale ,
           anagrafica.par_iva,
				sede.indirizzo,
				sede.cap,
				sede.localita,
				sede.provincia,
cast( sede.cap + ' ' +sede.localita+ ' ' +sede.provincia as char(128)) as c_cap_loc_pr,
			azienda.rag_soc_2 
        FROM anagrafica, azienda, sede      
        WHERE anagrafica.id_azienda=azienda.id_azienda
		and azienda.id_azienda=sede.id_azienda
and ( anagrafica.rag_soc_1 = :ra_rag )   " arguments=(("ra_rag", string)) )
