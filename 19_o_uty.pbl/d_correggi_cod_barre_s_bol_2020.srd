table(column=(type=decimal(0) updatewhereclause=yes name=num_progressivo dbname="documento.num_progressivo" )
 column=(type=char(16) updatewhereclause=yes name=documento_num_documento dbname="documento.num_documento" )
 column=(type=date updatewhereclause=yes name=documento_data_documento dbname="documento.data_documento" )
 column=(type=decimal(0) updatewhereclause=yes name=riga_documento_num_riga dbname="riga_documento.num_riga" )
 column=(type=long update=yes updatewhereclause=yes name=id_articolo dbname="riga_documento.id_articolo" )
 column=(type=char(32766) update=yes updatewhereclause=no name=riga_documento_descrizione dbname="riga_documento.descrizione" )
 column=(type=decimal(4) update=yes updatewhereclause=yes name=quantita dbname="riga_documento.quantita" )
 column=(type=decimal(4) update=yes updatewhereclause=yes name=peso_netto dbname="riga_documento.peso_netto" )
 column=(type=char(1) update=yes updatewhereclause=yes name=ordinato_fo dbname="riga_documento.ordinato_fo" values="	S/	N" )
 column=(type=long updatewhereclause=yes key=yes identity=yes name=id_riga_documento dbname="riga_documento.id_riga_documento" )
 column=(type=long updatewhereclause=yes name=id_documento dbname="riga_documento.id_documento" )
 column=(type=decimal(4) updatewhereclause=yes name=riga_documento_qta_evasa dbname="riga_documento.qta_evasa" )
 column=(type=decimal(4) updatewhereclause=yes name=riga_documento_peso_netto_evaso dbname="riga_documento.peso_netto_evaso" )
 column=(type=decimal(2) updatewhereclause=yes name=coef_calo dbname="riga_documento.coef_calo" )
 column=(type=decimal(4) update=yes updatewhereclause=yes name=calo dbname="riga_documento.calo" )
 column=(type=decimal(4) update=yes updatewhereclause=yes name=fino dbname="riga_documento.fino" )
 column=(type=long updatewhereclause=yes name=c_modificato dbname="c_modificato" )
 column=(type=decimal(2) update=yes updatewhereclause=yes name=provv_subage_2 dbname="riga_documento.provv_subage_2" )
 column=(type=datetime updatewhereclause=yes name=riga_doc_estensione_data_ora_modifica dbname="riga_doc_estensione.data_ora_modifica" )
 column=(type=decimal(4) update=yes updatewhereclause=yes name=peso_lordo_tara dbname="riga_documento.peso_lordo" )
 column=(type=decimal(4) update=yes updatewhereclause=yes name=peso_non_prezioso dbname="riga_documento.peso_non_prezioso" )
 column=(type=decimal(6) update=yes updatewhereclause=yes name=tot_riga_val_riga dbname="riga_documento.tot_riga_val_riga" )
 column=(type=decimal(6) update=yes updatewhereclause=yes name=tot_riga_val_doc dbname="riga_documento.tot_riga_val_doc" )
 column=(type=decimal(6) update=yes updatewhereclause=yes name=tot_riga_val_az dbname="riga_documento.tot_riga_val_az" )
 column=(type=decimal(6) updatewhereclause=yes name=prezzo_complessivo dbname="riga_documento.prezzo_complessivo" )
 column=(type=long update=yes updatewhereclause=yes name=id_unita_confezione dbname="riga_documento.id_unita_confezione" )
 column=(type=long update=yes updatewhereclause=yes name=id_gruppo_agenti_2 dbname="riga_documento.id_gruppo_agenti_2" )
 column=(type=decimal(6) update=yes updatewhereclause=yes name=prezzo_metallo dbname="riga_documento.prezzo_metallo" )
 column=(type=long updatewhereclause=yes name=id_sog_commerciale dbname="documento.id_sog_commerciale" )
 column=(type=char(64) updatewhereclause=yes name=articolo_codice dbname="articolo.codice" )
 column=(type=long updatewhereclause=yes name=c_scelto dbname="c_scelto" values="Non Urgente	1/Urgente CL//Lista	2/Urgente per Data	3/Merce Urgentissima	4/Già Impacchettato	9999/" )
 column=(type=long updatewhereclause=yes name=id_pacco dbname="riga_doc_estensione.id_pacco" )
 column=(type=decimal(5) update=yes updatewhereclause=yes name=riga_documento_provv_imp_carea_2 dbname="riga_documento.provv_imp_carea_2" )
 column=(type=decimal(4) update=yes updatewhereclause=yes name=provv_imp_agente_2 dbname="riga_documento.provv_imp_agente_2" )
 column=(type=decimal(2) updatewhereclause=yes name=c_peso_laccio dbname="c_peso_laccio" )
 column=(type=decimal(2) updatewhereclause=yes name=c_peso_filo_rame dbname="c_peso_filo_rame" )
 column=(type=long updatewhereclause=yes name=c_peso_lordo dbname="c_peso_lordo" )
 column=(type=char(32) updatewhereclause=yes name=c_cod_pacco dbname="c_cod_pacco" )
 retrieve="  SELECT  ~"documento~".~"num_progressivo~" ,           ~"documento~".~"num_documento~" ,           ~"documento~".~"data_documento~" ,           ~"riga_documento~".~"num_riga~" ,      
     ~"riga_documento~".~"id_articolo~" ,           ~"riga_documento~".~"descrizione~" ,           ~"riga_documento~".~"quantita~" ,           ~"riga_documento~".~"peso_netto~" ,           ~"riga_documento~".~"ordinato_fo~" ,  
         ~"riga_documento~".~"id_riga_documento~" ,           ~"riga_documento~".~"id_documento~" ,           ~"riga_documento~".~"qta_evasa~" ,           ~"riga_documento~".~"peso_netto_evaso~" ,           ~"riga_documento~".~"coef_calo~" ,     
      ~"riga_documento~".~"calo~" ,           ~"riga_documento~".~"fino~" ,           cast(0 as integer) as c_modificato,           ~"riga_documento~".~"provv_subage_2~" ,           ~"riga_doc_estensione~".~"data_ora_modifica~" ,        
   ~"riga_documento~".~"peso_lordo~" ,           ~"riga_documento~".~"peso_non_prezioso~" ,           ~"riga_documento~".~"tot_riga_val_riga~" ,           ~"riga_documento~".~"tot_riga_val_doc~" ,           ~"riga_documento~".~"tot_riga_val_az~" , 
          ~"riga_documento~".~"prezzo_complessivo~" ,           ~"riga_documento~".~"id_unita_confezione~" ,           ~"riga_documento~".~"id_gruppo_agenti_2~" ,           ~"riga_documento~".~"prezzo_metallo~" ,
           ~"documento~".~"id_sog_commerciale~" ,           ~"articolo~".~"codice~" ,           0 as c_scelto,           ~"riga_doc_estensione~".~"id_pacco~"  ,
		~"riga_documento~".~"provv_imp_carea_2~", ~"riga_documento~".~"provv_imp_agente_2~",
fn_rec_prezzo_filo_rame('L', documento.~"data_documento~") as c_peso_laccio,
fn_rec_prezzo_filo_rame('F', documento.~"data_documento~") as c_peso_filo_rame,
 0 as c_peso_lordo, '                                ' as c_cod_pacco
// ~"orafo_par_sistema~".~"peso_laccio~", ~"orafo_par_sistema~".~"peso_filo_rame~", 0 as c_peso_lordo
FROM {oj ~"riga_doc_estensione~" 
RIGHT OUTER JOIN ~"riga_documento~" ON ~"riga_doc_estensione~".~"id_riga_documento~" = ~"riga_documento~".~"id_riga_documento~" RIGHT OUTER JOIN ~"documento~" ON ~"riga_documento~".~"id_documento~" = ~"documento~".~"id_documento~"} , 
          ~"articolo~", ~"orafo_par_sistema~"    WHERE ( ~"articolo~".~"id_articolo~" = ~"riga_documento~".~"id_articolo~" ) and          ( ( ~"riga_documento~".~"id_riga_documento~" = :id_doc ) and          ( ~"riga_documento~".~"id_riga_doc_padre~" is null ) )  " update="riga_documento" updatewhere=1 updatekeyinplace=yes arguments=(("id_doc", number)) )
