table(column=(type=char(8) updatewhereclause=yes name=caus_magazzino_codice dbname="caus_magazzino.codice" )
 column=(type=long update=yes updatewhereclause=yes key=yes name=cast_cpt_documento_id_documento dbname="cast_cpt_documento.id_documento" )
 column=(type=long update=yes updatewhereclause=yes key=yes name=cast_cpt_documento_id_conto dbname="cast_cpt_documento.id_conto" )
 column=(type=char(1) update=yes updatewhereclause=yes name=cast_cpt_documento_tipo_riga_cpt dbname="cast_cpt_documento.tipo_riga_cpt" )
 column=(type=decimal(4) update=yes updatewhereclause=yes name=cast_cpt_documento_val_imponibile dbname="cast_cpt_documento.val_imponibile" )
 column=(type=decimal(4) update=yes updatewhereclause=yes name=cast_cpt_documento_val_imp_scontato dbname="cast_cpt_documento.val_imp_scontato" )
 column=(type=decimal(4) update=yes updatewhereclause=yes name=cast_cpt_documento_val_omaggi dbname="cast_cpt_documento.val_omaggi" )
 column=(type=decimal(4) update=yes updatewhereclause=yes name=cast_cpt_documento_val_spese dbname="cast_cpt_documento.val_spese" )
 retrieve="  SELECT ~"caus_magazzino~".~"codice~",   
         ~"cast_cpt_documento~".~"id_documento~",   
         ~"cast_cpt_documento~".~"id_conto~",   
         ~"cast_cpt_documento~".~"tipo_riga_cpt~",   
         ~"cast_cpt_documento~".~"val_imponibile~",   
         ~"cast_cpt_documento~".~"val_imp_scontato~",   
         ~"cast_cpt_documento~".~"val_omaggi~",   
         ~"cast_cpt_documento~".~"val_spese~"  
    FROM ~"caus_magazzino~",   
         ~"documento~",   
         ~"sog_commerciale~",   
         ~"cast_cpt_documento~"  
   WHERE ( ~"documento~".~"id_caus_magazzino~" = ~"caus_magazzino~".~"id_caus_magazzino~" ) and  
         ( ~"sog_commerciale~".~"id_sog_commerciale~" = ~"documento~".~"id_sog_commerciale~" ) and  
         ( ~"cast_cpt_documento~".~"id_documento~" = ~"documento~".~"id_documento~" ) and  
         ( ( ~"caus_magazzino~".~"codice~" >= :da_caus ) AND  
         ( ~"caus_magazzino~".~"codice~" <= :a_caus ) AND  
         (~"documento~".~"data_documento~" >= :da_data AND  
         ~"documento~".~"data_documento~" <= :a_data or 
				~"documento~".~"data_documento~" is null)	AND  
         ~"sog_commerciale~".~"codice~" >= :da_sog AND  
         ~"sog_commerciale~".~"codice~" <= :a_sog )    
" update="cast_cpt_documento" updatewhere=0 updatekeyinplace=no arguments=(("da_data", date),("a_data", date),("da_sog", string),("a_sog", string),("da_caus", string),("a_caus", string)) )
