 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"articolo~" )  TABLE(NAME=~"unita_confezione~" )  TABLE(NAME=~"unita_misura~" ) COLUMN(NAME=~"articolo.codice~") COLUMN(NAME=~"articolo.descrizione~") COLUMN(NAME=~"unita_confezione.peso_netto~") COLUMN(NAME=~"unita_confezione.dim_l~") COLUMN(NAME=~"unita_misura.simbolo~") COMPUTE(NAME=~"cast((select prezzo_manifattura from prezzo where id_variazione=:ra_id_variazione and id_unita_confezione=~~~"unita_confezione~~~".~~~"id_unita_confezione~~~") as decimal(18,4)) as prezzo_manifattura~") COMPUTE(NAME=~"cast((select prezzo from prezzo where id_variazione=:ra_id_variazione and id_unita_confezione=~~~"unita_confezione~~~".~~~"id_unita_confezione~~~") as decimal(18,4)) as prezzo~") COMPUTE(NAME=~"cast((select simbolo from valuta where id_valuta=:ra_id_valuta) as char(2)) as simbolo_valuta~") COLUMN(NAME=~"unita_misura.tipo~")    JOIN (LEFT=~"unita_confezione.id_articolo~"    OP =~"=~"RIGHT=~"articolo.id_articolo~" )    JOIN (LEFT=~"unita_confezione.id_unita_misura~"    OP =~"=~"RIGHT=~"unita_misura.id_unita_misura~" )WHERE(    EXP1 =~"~~~"unita_confezione~~~".~~~"unita_base~~~"~"   OP =~"=~"    EXP2 =~"'S'~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"articolo~~~".~~~"id_articolo~~~"~"   OP =~"=~"    EXP2 =~":ra_id_articolo~" ) ) ARG(NAME = ~"ra_id_articolo~" TYPE = number)  ARG(NAME = ~"ra_id_variazione~" TYPE = number)  ARG(NAME = ~"ra_id_valuta~" TYPE = number)  ARG(NAME = ~"li_cifre_arr~" TYPE = number)  ARG(NAME = ~"ls_tipo_arr~" TYPE = string)  ARG(NAME = ~"cambio~" TYPE = number) " arguments=(("ra_id_articolo", number),("ra_id_variazione", number),("ra_id_valuta", number),("li_cifre_arr", number),("ls_tipo_arr", string),("cambio", number)) )
