table(column=(type=char(7) updatewhereclause=yes name=cod_barre dbname="bollettine_excel.cod_barre" )
 column=(type=datetime updatewhereclause=yes name=data dbname="bollettine_excel.data" )
 column=(type=char(64) updatewhereclause=yes name=cod_art_assegnato dbname="bollettine_excel.cod_art_assegnato" )
 column=(type=char(64) updatewhereclause=yes name=articolo dbname="bollettine_excel.articolo" )
 column=(type=char(5) updatewhereclause=yes name=cliente dbname="bollettine_excel.cliente" )
 column=(type=long updatewhereclause=yes name=num_ordine dbname="bollettine_excel.num_ordine" )
 column=(type=char(2) updatewhereclause=yes name=metallo dbname="bollettine_excel.metallo" )
 column=(type=decimal(2) updatewhereclause=yes name=titolo dbname="bollettine_excel.titolo" )
 column=(type=date update=yes updatewhereclause=yes key=yes name=data_reso dbname="catena_resa.data_reso" )
 column=(type=char(7) update=yes updatewhereclause=yes key=yes name=num_bollettina dbname="catena_resa.num_bollettina" )
 column=(type=decimal(2) update=yes updatewhereclause=yes name=legato dbname="catena_resa.legato" )
 column=(type=long update=yes updatewhereclause=yes name=num_riga dbname="catena_resa.num_riga" )
 column=(type=char(80) update=yes updatewhereclause=yes name=descrizione dbname="catena_resa.descrizione" )
 column=(type=char(5) updatewhereclause=yes name=fornitore dbname="bollettine_excel.fornitore" )
 column=(type=decimal(2) updatewhereclause=yes name=c_peso_lordo dbname="catena_resa.c_peso_lordo" )
 column=(type=decimal(0) updatewhereclause=yes name=c_lacci dbname="c_lacci" )
 column=(type=decimal(0) updatewhereclause=yes name=c_peso_netto dbname="c_peso_netto" )
 column=(type=long updatewhereclause=yes name=id_riga_documento dbname="bollettine_excel.id_riga_documento" )
 column=(type=decimal(4) updatewhereclause=yes name=c_tara dbname="c_tara" )
 column=(type=decimal(2) update=yes updatewhereclause=yes name=tara dbname="catena_resa.tara" )
 column=(type=long update=yes updatewhereclause=yes name=lacci dbname="catena_resa.lacci" )
 column=(type=datetime update=yes updatewhereclause=yes name=data_ora_creazione dbname="catena_resa.data_ora_creazione" initial="today" )
