 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"bollettine_excel~" )  TABLE(NAME=~"catena_resa~" ) COLUMN(NAME=~"bollettine_excel.cod_barre~") COLUMN(NAME=~"bollettine_excel.data~") COLUMN(NAME=~"bollettine_excel.cod_art_assegnato~") COLUMN(NAME=~"bollettine_excel.articolo~") COLUMN(NAME=~"bollettine_excel.cliente~") COLUMN(NAME=~"bollettine_excel.num_ordine~") COLUMN(NAME=~"bollettine_excel.metallo~") COLUMN(NAME=~"bollettine_excel.titolo~") COLUMN(NAME=~"catena_resa.data_reso~") COLUMN(NAME=~"catena_resa.num_bollettina~") COLUMN(NAME=~"catena_resa.legato~") COLUMN(NAME=~"catena_resa.num_riga~") COLUMN(NAME=~"catena_resa.descrizione~") COLUMN(NAME=~"bollettine_excel.fornitore~") COMPUTE(NAME=~"~~~"catena_resa~~~".~~~"legato~~~"  as c_peso_lordo~") COMPUTE(NAME=~"0.00 as c_lacci~") COMPUTE(NAME=~"0.00 as c_peso_netto~") COLUMN(NAME=~"bollettine_excel.id_riga_documento~") COMPUTE(NAME=~"0.0001 as c_tara~") COLUMN(NAME=~"catena_resa.tara~") COLUMN(NAME=~"catena_resa.lacci~") COLUMN(NAME=~"catena_resa.data_ora_creazione~") COLUMN(NAME=~"catena_resa.tipo~")    JOIN (LEFT=~"catena_resa.num_bollettina~"    OP =~"=~"RIGHT=~"bollettine_excel.cod_barre~"    OUTER2 =~"bollettine_excel.cod_barre~" )WHERE(    EXP1 =~"~~~"bollettine_excel~~~".~~~"cod_barre~~~"~"   OP =~"=~"    EXP2 =~":n_bol~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"bollettine_excel~~~".~~~"tipo~~~"~"   OP =~"=~"    EXP2 =~"'B'~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"catena_resa~~~".~~~"data_reso~~~"~"   OP =~"=~"    EXP2 =~":ldt_data_oggi~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"catena_resa~~~".~~~"tipo~~~"~"   OP =~"=~"    EXP2 =~"'M'~" ) ) ARG(NAME = ~"n_bol~" TYPE = string)  ARG(NAME = ~"ldt_data_oggi~" TYPE = date) " update="catena_resa" updatewhere=1 updatekeyinplace=yes arguments=(("n_bol", string),("ldt_data_oggi", date))  sort="num_riga D " )
