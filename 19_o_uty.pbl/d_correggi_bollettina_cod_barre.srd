 column=(type=decimal(4) update=yes updatewhereclause=yes name=calo dbname="riga_documento.calo" )
 column=(type=decimal(4) update=yes updatewhereclause=yes name=fino dbname="riga_documento.fino" )
 column=(type=long updatewhereclause=yes name=c_modificato dbname="c_modificato" )
 column=(type=decimal(2) update=yes updatewhereclause=yes name=provv_subage_2 dbname="riga_documento.provv_subage_2" )
