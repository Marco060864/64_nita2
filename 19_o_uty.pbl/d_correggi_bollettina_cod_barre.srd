 column=(type=long updatewhereclause=yes name=id_pacco dbname="riga_doc_estensione.id_pacco" )
 column=(type=long update=yes updatewhereclause=yes name=id_unita_confezione dbname="riga_documento.id_unita_confezione" )
 column=(type=decimal(5) update=yes updatewhereclause=yes name=riga_documento_provv_imp_carea_2 dbname="riga_documento.provv_imp_carea_2" )
 column=(type=decimal(4) update=yes updatewhereclause=yes name=provv_imp_agente_2 dbname="riga_documento.provv_imp_agente_2" )
 column=(type=long updatewhereclause=yes name=c_peso_lordo dbname="c_peso_lordo" )
 column=(type=long updatewhereclause=yes name=id_sog_commerciale dbname="documento.id_sog_commerciale" )
 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"documento~" )  TABLE(NAME=~"riga_documento~" )  TABLE(NAME=~"riga_doc_estensione~" ) COLUMN(NAME=~"documento.num_progressivo~") COLUMN(NAME=~"documento.num_documento~") COLUMN(NAME=~"documento.data_documento~") COLUMN(NAME=~"riga_documento.num_riga~") COLUMN(NAME=~"riga_documento.id_articolo~") COLUMN(NAME=~"riga_documento.descrizione~") COLUMN(NAME=~"riga_documento.quantita~") COLUMN(NAME=~"riga_documento.peso_netto~") COLUMN(NAME=~"riga_documento.ordinato_fo~") COLUMN(NAME=~"riga_documento.id_riga_documento~") COLUMN(NAME=~"riga_documento.id_documento~") COLUMN(NAME=~"riga_documento.qta_evasa~") COLUMN(NAME=~"riga_documento.peso_netto_evaso~") COLUMN(NAME=~"riga_documento.coef_calo~") COLUMN(NAME=~"riga_documento.calo~") COLUMN(NAME=~"riga_documento.fino~") COMPUTE(NAME=~"cast(0 as integer) as c_modificato~") COLUMN(NAME=~"riga_documento.provv_subage_2~") COLUMN(NAME=~"riga_doc_estensione.data_ora_modifica~") COLUMN(NAME=~"riga_documento.peso_lordo~") COLUMN(NAME=~"riga_documento.peso_non_prezioso~") COLUMN(NAME=~"riga_doc_estensione.id_pacco~") COLUMN(NAME=~"riga_documento.id_unita_confezione~") COLUMN(NAME=~"riga_documento.provv_imp_carea_2~") COLUMN(NAME=~"riga_documento.provv_imp_agente_2~") COMPUTE(NAME=~"0 as c_peso_lordo~") COLUMN(NAME=~"documento.id_sog_commerciale~")    JOIN (LEFT=~"riga_doc_estensione.id_riga_documento~"    OP =~"=~"RIGHT=~"riga_documento.id_riga_documento~"    OUTER2 =~"riga_documento.id_riga_documento~" )    JOIN (LEFT=~"riga_documento.id_documento~"    OP =~"=~"RIGHT=~"documento.id_documento~" )WHERE(    EXP1 =~"~~~"riga_documento~~~".~~~"id_riga_documento~~~"~"   OP =~"=~"    EXP2 =~":ll_id_doc~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"riga_documento~~~".~~~"id_riga_doc_padre~~~"~"   OP =~"is~"    EXP2 =~"null~" ) ) ARG(NAME = ~"ll_id_doc~" TYPE = number) " update="riga_documento" updatewhere=1 updatekeyinplace=yes arguments=(("ll_id_doc", number))  sort="num_progressivo A documento_data_documento A documento_num_documento A " )
