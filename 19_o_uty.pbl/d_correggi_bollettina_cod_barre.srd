 column=(type=date updatewhereclause=yes name=documento_data_documento dbname="documento.data_documento" )
 column=(type=decimal(0) updatewhereclause=yes name=riga_documento_num_riga dbname="riga_documento.num_riga" )
 column=(type=long update=yes updatewhereclause=yes name=id_articolo dbname="riga_documento.id_articolo" )
 column=(type=char(32766) update=yes updatewhereclause=no name=riga_documento_descrizione dbname="riga_documento.descrizione" )
 column=(type=decimal(4) update=yes updatewhereclause=yes name=quantita dbname="riga_documento.quantita" )
