table(column=(type=long updatewhereclause=yes identity=yes name=id_documento dbname="documento.id_documento" dbalias=".id_documento" )
 column=(type=char(16) updatewhereclause=yes name=num_documento dbname="documento.num_documento" dbalias=".num_documento" )
 column=(type=date updatewhereclause=yes name=data_documento dbname="documento.data_documento" dbalias=".data_documento" )
 column=(type=long updatewhereclause=yes identity=yes name=id_riga_documento dbname="riga_documento.id_riga_documento" dbalias=".id_riga_documento" )
 column=(type=long updatewhereclause=yes name=caus_magazzino_id_tipo_partita dbname="caus_magazzino.id_tipo_partita" dbalias=".id_tipo_partita" )
 column=(type=char(4) updatewhereclause=yes name=cod_tipo_partita dbname="orafo_tipo_partita.cod_tipo_partita" dbalias=".cod_tipo_partita" )
 column=(type=decimal(4) updatewhereclause=yes name=c_saldo_partita dbname="c_saldo_partita" )
 retrieve="SELECT documento.id_documento, documento.num_documento, documento.data_documento, riga_documento.id_riga_documento, caus_magazzino.id_tipo_partita, orafo_tipo_partita.cod_tipo_partita, (orafo_aper_partita.val_apertura - ifnull(orafo_aper_partita.val_scarico, 0, orafo_aper_partita.val_scarico)) as c_saldo_partita FROM documento, riga_documento, orafo_aper_partita, caus_magazzino, orafo_metallo, orafo_titolo, orafo_tipo_partita, articolo WHERE riga_documento.id_documento = documento.id_documento and orafo_aper_partita.id_documento = documento.id_documento and caus_magazzino.id_caus_magazzino = riga_documento.id_caus_magazzino and orafo_titolo.id_metallo = orafo_metallo.id_metallo and caus_magazzino.id_tipo_partita = orafo_tipo_partita.id_tipo_partita and riga_documento.id_articolo = articolo.id_articolo and articolo.id_titolo = orafo_titolo.id_titolo and articolo.id_titolo = orafo_aper_partita.id_titolo and riga_documento.id_riga_documento = (select min(r2.id_riga_documento) from riga_documento r2, articolo a2, caus_magazzino c2 where r2.id_documento = documento.id_documento and a2.id_articolo = r2.id_articolo and a2.id_titolo = orafo_aper_partita.id_titolo and c2.id_caus_magazzino = r2.id_caus_magazzino and c2.id_tipo_partita = caus_magazzino.id_tipo_partita) and orafo_tipo_partita.cod_tipo_partita = :cod_partita and documento.id_sog_commerciale = :id_sog and orafo_metallo.codice = :Metallo and documento.data_documento >= :da_data and documento.data_documento <= :a_data and orafo_aper_partita.stato = 'A' ORDER BY documento.data_documento, documento.id_documento" arguments=(("cod_partita", string),("id_sog", number),("Metallo", string),("da_data", date),("a_data", date)) )
