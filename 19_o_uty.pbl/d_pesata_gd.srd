table(column=(type=long update=yes updatewhereclause=yes key=yes identity=yes name=id_pesata dbname="pesata.id_pesata" )
 column=(type=date update=yes updatewhereclause=yes name=data dbname="pesata.data" initial="today" )
 column=(type=decimal(2) update=yes updatewhereclause=yes name=peso_lordo dbname="pesata.peso_lordo" initial="0" )
 column=(type=decimal(2) update=yes updatewhereclause=yes name=tara dbname="pesata.tara" initial="0" )
 column=(type=char(255) update=yes updatewhereclause=yes name=nota dbname="pesata.nota" )
 column=(type=char(16) update=yes updatewhereclause=yes name=num_documento dbname="pesata.num_documento" )
 column=(type=long update=yes updatewhereclause=yes name=num_progressivo dbname="pesata.num_progressivo" )
 column=(type=long update=yes updatewhereclause=yes name=id_operatore dbname="pesata.id_operatore" )
 column=(type=datetime update=yes updatewhereclause=yes name=data_ora dbname="pesata.data_ora" )
 column=(type=long update=yes updatewhereclause=yes name=id_articolo dbname="pesata.id_articolo" )
 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"pesata~" ) COLUMN(NAME=~"pesata.id_pesata~") COLUMN(NAME=~"pesata.data~") COLUMN(NAME=~"pesata.peso_lordo~") COLUMN(NAME=~"pesata.tara~") COLUMN(NAME=~"pesata.nota~") COLUMN(NAME=~"pesata.num_documento~") COLUMN(NAME=~"pesata.num_progressivo~") COLUMN(NAME=~"pesata.id_operatore~") COLUMN(NAME=~"pesata.data_ora~") COLUMN(NAME=~"pesata.id_articolo~")) " update="pesata" updatewhere=1 updatekeyinplace=yes  sort="data A id_pesata A " )
