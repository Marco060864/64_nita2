table(column=(type=char(32) updatewhereclause=yes name=articolo_codice dbname="articolo.codice" )
 column=(type=char(80) updatewhereclause=yes name=articolo_descrizione dbname="articolo.descrizione" )
 column=(type=decimal(0) updatewhereclause=yes name=riga_distinta_num_riga dbname="riga_distinta.num_riga" )
 column=(type=decimal(4) updatewhereclause=yes name=quantita dbname="riga_distinta.quantita" )
 column=(type=decimal(4) update=yes updatewhereclause=yes name=peso_netto dbname="riga_distinta.peso_netto" )
 column=(type=char(32) updatewhereclause=yes name=articolo_codice_1 dbname="articolo.codice" )
 column=(type=char(80) updatewhereclause=yes name=articolo_descrizione_2 dbname="articolo.descrizione" )
 column=(type=long updatewhereclause=yes key=yes name=riga_distinta_id_distinta dbname="riga_distinta.id_distinta" )
 column=(type=long updatewhereclause=yes identity=yes name=riga_distinta_id_riga_distinta dbname="riga_distinta.id_riga_distinta" )
 column=(type=long updatewhereclause=yes key=yes name=riga_distinta_id_articolo dbname="riga_distinta.id_articolo" )
 column=(type=decimal(4) updatewhereclause=yes name=peso_vecchio dbname="peso_vecchio" )
 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"articolo~" ALIAS=~"articolo_a~" )  TABLE(NAME=~"distinta~" )  TABLE(NAME=~"riga_distinta~" )  TABLE(NAME=~"articolo~" ALIAS=~"articolo_b~" ) COLUMN(NAME=~"articolo_a.codice~") COLUMN(NAME=~"articolo_a.descrizione~") COLUMN(NAME=~"riga_distinta.num_riga~") COLUMN(NAME=~"riga_distinta.quantita~") COLUMN(NAME=~"riga_distinta.peso_netto~") COLUMN(NAME=~"articolo_b.codice~") COLUMN(NAME=~"articolo_b.descrizione~") COLUMN(NAME=~"riga_distinta.id_distinta~") COLUMN(NAME=~"riga_distinta.id_riga_distinta~") COLUMN(NAME=~"riga_distinta.id_articolo~") COMPUTE(NAME=~"cast(0 as numeric(18,4)) as peso_vecchio~")    JOIN (LEFT=~"riga_distinta.id_distinta~"    OP =~"=~"RIGHT=~"distinta.id_distinta~" )    JOIN (LEFT=~"distinta.id_articolo~"    OP =~"=~"RIGHT=~"articolo_a.id_articolo~" )    JOIN (LEFT=~"riga_distinta.id_articolo~"    OP =~"=~"RIGHT=~"articolo_b.id_articolo~" )WHERE(    EXP1 =~"~~~"riga_distinta~~~".~~~"id_articolo~~~"~"   OP =~"=~"    EXP2 =~":id_articolo~" ) ) ARG(NAME = ~"id_articolo~" TYPE = number) " update="riga_distinta" updatewhere=1 updatekeyinplace=yes arguments=(("id_articolo", number)) )
