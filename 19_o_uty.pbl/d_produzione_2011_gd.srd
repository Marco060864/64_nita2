table(column=(type=long update=yes updatewhereclause=yes key=yes name=id_bollettina dbname="produzione_2011.id_bollettina" )
 column=(type=long update=yes updatewhereclause=yes key=yes name=id_doc_produzione dbname="produzione_2011.id_doc_produzione" )
