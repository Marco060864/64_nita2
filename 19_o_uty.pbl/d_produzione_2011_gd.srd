 column=(type=long updatewhereclause=yes name=n_fili dbname="n_fili" )
 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"produzione_2011~" ) COLUMN(NAME=~"produzione_2011.id_bollettina~") COLUMN(NAME=~"produzione_2011.id_doc_produzione~") COMPUTE(NAME=~"'' AS C_ART~") COMPUTE(NAME=~"0 AS PEZZI~") COMPUTE(NAME=~"'' AS NUM_BOLLETTINA~") COMPUTE(NAME=~"0.00 as legato~") COMPUTE(NAME=~"0 as n_lacci~") COMPUTE(NAME=~"0 as n_fili~")WHERE(    EXP1 =~"~~~"produzione_2011~~~".~~~"id_doc_produzione~~~"~"   OP =~"=~"    EXP2 =~":ll_id_doc~" ) ) ARG(NAME = ~"ll_id_doc~" TYPE = number) " update="produzione_2011" updatewhere=1 updatekeyinplace=yes arguments=(("ll_id_doc", number)) )
