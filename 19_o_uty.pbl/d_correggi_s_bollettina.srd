 column=(type=decimal(6) update=yes updatewhereclause=yes name=prezzo_metallo dbname="riga_documento.prezzo_metallo" )
 column=(type=long updatewhereclause=yes name=id_sog_commerciale dbname="documento.id_sog_commerciale" )
 column=(type=char(32) updatewhereclause=yes name=articolo_codice dbname="articolo.codice" )
 column=(type=long updatewhereclause=yes name=c_scelto dbname="c_scelto" values="Non Urgente	1/Urgente CL//Lista	2/Urgente per Data	3/Merce Urgentissima	4/Già Impacchettato	9999/" )
 column=(type=long updatewhereclause=yes name=id_pacco dbname="riga_doc_estensione.id_pacco" )
 column=(type=char(32766) updatewhereclause=no name=articolo_note dbname="articolo.note" )
 column=(type=decimal(5) update=yes updatewhereclause=yes name=riga_documento_provv_imp_carea_2 dbname="riga_documento.provv_imp_carea_2" initial="0" )
 column=(type=decimal(4) update=yes updatewhereclause=yes name=provv_imp_agente_2 dbname="riga_documento.provv_imp_agente_2" )
 column=(type=decimal(4) updatewhereclause=yes name=orafo_par_sistema_peso_laccio dbname="orafo_par_sistema.peso_laccio" )
 column=(type=decimal(4) updatewhereclause=yes name=orafo_par_sistema_peso_filo_rame dbname="orafo_par_sistema.peso_filo_rame" )
 column=(type=long updatewhereclause=yes name=c_peso_lordo dbname="c_peso_lordo" )
 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"documento~" )  TABLE(NAME=~"riga_documento~" )  TABLE(NAME=~"riga_doc_estensione~" )  TABLE(NAME=~"articolo~" )  TABLE(NAME=~"orafo_par_sistema~" ) COLUMN(NAME=~"documento.num_progressivo~") COLUMN(NAME=~"documento.num_documento~") COLUMN(NAME=~"documento.data_documento~") COLUMN(NAME=~"riga_documento.num_riga~") COLUMN(NAME=~"riga_documento.id_articolo~") COLUMN(NAME=~"riga_documento.descrizione~") COLUMN(NAME=~"riga_documento.quantita~") COLUMN(NAME=~"riga_documento.peso_netto~") COLUMN(NAME=~"riga_documento.ordinato_fo~") COLUMN(NAME=~"riga_documento.id_riga_documento~") COLUMN(NAME=~"riga_documento.id_documento~") COLUMN(NAME=~"riga_documento.qta_evasa~") COLUMN(NAME=~"riga_documento.peso_netto_evaso~") COLUMN(NAME=~"riga_documento.coef_calo~") COLUMN(NAME=~"riga_documento.calo~") COLUMN(NAME=~"riga_documento.fino~") COMPUTE(NAME=~"cast(0 as integer) as c_modificato~") COLUMN(NAME=~"riga_documento.provv_subage_2~") COLUMN(NAME=~"riga_doc_estensione.data_ora_modifica~") COLUMN(NAME=~"riga_documento.peso_lordo~") COLUMN(NAME=~"riga_documento.peso_non_prezioso~") COLUMN(NAME=~"riga_documento.tot_riga_val_riga~") COLUMN(NAME=~"riga_documento.tot_riga_val_doc~") COLUMN(NAME=~"riga_documento.tot_riga_val_az~") COLUMN(NAME=~"riga_documento.prezzo_complessivo~") COLUMN(NAME=~"riga_documento.id_unita_confezione~") COLUMN(NAME=~"riga_documento.id_gruppo_agenti_2~") COLUMN(NAME=~"riga_documento.prezzo_metallo~") COLUMN(NAME=~"documento.id_sog_commerciale~") COLUMN(NAME=~"articolo.codice~") COMPUTE(NAME=~"0 as c_scelto~") COLUMN(NAME=~"riga_doc_estensione.id_pacco~") COLUMN(NAME=~"articolo.note~") COLUMN(NAME=~"riga_documento.provv_imp_carea_2~") COLUMN(NAME=~"riga_documento.provv_imp_agente_2~") COLUMN(NAME=~"orafo_par_sistema.peso_laccio~") COLUMN(NAME=~"orafo_par_sistema.peso_filo_rame~") COMPUTE(NAME=~"0 as c_peso_lordo~")    JOIN (LEFT=~"riga_doc_estensione.id_riga_documento~"    OP =~"=~"RIGHT=~"riga_documento.id_riga_documento~"    OUTER2 =~"riga_documento.id_riga_documento~" )    JOIN (LEFT=~"riga_documento.id_documento~"    OP =~"=~"RIGHT=~"documento.id_documento~"    OUTER2 =~"documento.id_documento~" )    JOIN (LEFT=~"articolo.id_articolo~"    OP =~"=~"RIGHT=~"riga_documento.id_articolo~" )WHERE(    EXP1 =~"~~~"documento~~~".~~~"id_prof_documento~~~"~"   OP =~"=~"    EXP2 =~":id_prof_doc~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"(~~~"riga_documento~~~".~~~"qta_evasa~~~"~"   OP =~"=~"    EXP2 =~"0~"    LOGIC =~"or~" ) WHERE(    EXP1 =~"~~~"riga_documento~~~".~~~"qta_evasa~~~"~"   OP =~"is~"    EXP2 =~"null)~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"documento~~~".~~~"data_documento~~~"~"   OP =~">=~"    EXP2 =~":da_data~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"documento~~~".~~~"data_documento~~~"~"   OP =~"<=~"    EXP2 =~":a_data~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"riga_documento~~~".~~~"id_riga_doc_padre~~~"~"   OP =~"is~"    EXP2 =~"null~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"documento~~~".~~~"id_sog_commerciale~~~"~"   OP =~"=~"    EXP2 =~":id_soggetto~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"(~~~"riga_documento~~~".~~~"forza_chius_evasione~~~"~"   OP =~"is~"    EXP2 =~"null~"    LOGIC =~"or~" ) WHERE(    EXP1 =~"~~~"riga_documento~~~".~~~"forza_chius_evasione~~~"~"   OP =~"=~"    EXP2 =~"'N')~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"(~~~"riga_documento~~~".~~~"peso_netto_evaso~~~"~"   OP =~"is~"    EXP2 =~"null~"    LOGIC =~"or~" ) WHERE(    EXP1 =~"~~~"riga_documento~~~".~~~"peso_netto_evaso~~~"~"   OP =~"=~"    EXP2 =~"0)~" ) ) ARG(NAME = ~"id_prof_doc~" TYPE = number)  ARG(NAME = ~"da_data~" TYPE = date)  ARG(NAME = ~"a_data~" TYPE = date)  ARG(NAME = ~"id_soggetto~" TYPE = number) " update="riga_documento" updatewhere=1 updatekeyinplace=yes arguments=(("id_prof_doc", number),("da_data", date),("a_data", date),("id_soggetto", number))  sort="num_progressivo A documento_data_documento A documento_num_documento A " )
