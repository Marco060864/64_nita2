 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"anagrafica~" )  TABLE(NAME=~"sog_commerciale~" )  TABLE(NAME=~"azienda~" )  TABLE(NAME=~"sede~" ) COLUMN(NAME=~"azienda.par_iva~") COLUMN(NAME=~"sog_commerciale.num_ns_prot_documenti~") COLUMN(NAME=~"sog_commerciale.data_ns_prot_documenti~") COLUMN(NAME=~"sog_commerciale.num_lr_prot_documenti~") COLUMN(NAME=~"sog_commerciale.data_lr_prot_documenti~") COLUMN(NAME=~"anagrafica.rag_soc_1~") COLUMN(NAME=~"anagrafica.indirizzo~") COLUMN(NAME=~"anagrafica.cap~") COLUMN(NAME=~"anagrafica.localita~") COLUMN(NAME=~"anagrafica.provincia~") COMPUTE(NAME=~"cast('AREZZO' as char(30) ) as ufficio_iva_di~") COMPUTE(NAME=~"cast('8' as char(6)) as art_esenzione~") COMPUTE(NAME=~"cast('' as long varchar) as nota~") COMPUTE(NAME=~"cast(2000 as numeric(4,0)) as anno1~") COMPUTE(NAME=~"cast(2000 as numeric(4,0)) as anno2~") COMPUTE(NAME=~"cast('00' as char(2)) as giorno1~") COMPUTE(NAME=~"cast('00' as char(2)) as giorno2~") COMPUTE(NAME=~"cast('00' as char(2)) as mese1~") COMPUTE(NAME=~"cast('00' as char(2)) as mese2~") COMPUTE(NAME=~"cast(0 as decimal(18,4)) as concorrenza_lire~") COMPUTE(NAME=~"cast('AREZZO' as char(30)) as dogana_di~") COLUMN(NAME=~"azienda.rag_soc_1~") COLUMN(NAME=~"sede.indirizzo~") COLUMN(NAME=~"sede.cap~") COLUMN(NAME=~"sede.localita~") COLUMN(NAME=~"sede.provincia~") COMPUTE(NAME=~"cast('00-01-01' as date) as data_della_dich~") COMPUTE(NAME=~"cast('' as char(1)) as n_op~") COLUMN(NAME=~"anagrafica.rag_soc_2~")    JOIN (LEFT=~"sog_commerciale.id_anagrafica~"    OP =~"=~"RIGHT=~"anagrafica.id_anagrafica~" )    JOIN (LEFT=~"azienda.id_azienda~"    OP =~"=~"RIGHT=~"sog_commerciale.id_azienda~" )    JOIN (LEFT=~"azienda.id_azienda~"    OP =~"=~"RIGHT=~"sede.id_azienda~" )WHERE(    EXP1 =~"YEAR(~~~"sog_commerciale~~~".~~~"data_ns_prot_documenti~~~")~"   OP =~"=~"    EXP2 =~":ANNO~" ) ) ARG(NAME = ~"ANNO~" TYPE = number) " arguments=(("ANNO", number)) )
