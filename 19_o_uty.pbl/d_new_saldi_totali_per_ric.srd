table(column=(type=decimal(4) updatewhereclause=yes name=c_tot_fc dbname="c_tot_fc" )
 column=(type=char(2) updatewhereclause=yes name=orafo_metallo_codice dbname="orafo_metallo.codice" )
 column=(type=char(8) updatewhereclause=yes name=sog_commerciale_gen_codice dbname="sog_commerciale_gen.codice" )
 column=(type=long updatewhereclause=yes name=sog_commerciale_gen_id_sog_commerciale dbname="sog_commerciale_gen.id_sog_commerciale" )
 column=(type=char(3) updatewhereclause=yes name=compute_0005 dbname="compute_0005" )
 column=(type=char(40) updatewhereclause=yes name=sog_commerciale_gen_rag_soc_1 dbname="sog_commerciale_gen.rag_soc_1" )
 retrieve="


  SELECT sum(case ~"caus_magazzino~".~"saldi_cl_fino~" when '+' then (~"riga_documento~".~"fino~" + ~"riga_documento~".~"calo~") else (~"riga_documento~".~"fino~" + ~"riga_documento~".~"calo~")* -1 end case) as c_tot_fc,
         ~"orafo_metallo~".~"codice~",   
         ~"sog_commerciale_gen~".~"codice~",   
         ~"sog_commerciale_gen~".~"id_sog_commerciale~",    right(~"orafo_tipo_partita~".~"cod_tipo_partita~"  , 3), ~"sog_commerciale_gen~".~"RAG_SOC_1~"
    FROM {oj ~"caus_magazzino~" LEFT OUTER JOIN ~"orafo_tipo_partita~" ON ~"caus_magazzino~".~"id_tipo_partita~" = ~"orafo_tipo_partita~".~"id_tipo_partita~"},   
         ~"documento~",   
         ~"riga_documento~",   
         ~"sog_commerciale_gen~",   
         ~"articolo~",   
         ~"orafo_metallo~",   
         ~"orafo_titolo~"  
   WHERE ( ~"riga_documento~".~"id_documento~" = ~"documento~".~"id_documento~" ) and  
         ( ~"riga_documento~".~"id_caus_magazzino~" = ~"caus_magazzino~".~"id_caus_magazzino~" ) and  
         ( ~"documento~".~"id_sog_commerciale~" = ~"sog_commerciale_gen~".~"id_sog_commerciale~" ) and  
         ( ~"articolo~".~"id_articolo~" = ~"riga_documento~".~"id_articolo~" ) and  
         ( ~"orafo_titolo~".~"id_metallo~" = ~"orafo_metallo~".~"id_metallo~" ) and  
         ( ~"orafo_titolo~".~"id_titolo~" = ~"articolo~".~"id_titolo~" ) and  
         ( ~"documento~".~"data_documento~" >= :da_data AND ~"documento~".~"data_documento~" <= :a_data ) AND  
         ( ~"sog_commerciale_gen~".~"id_sog_commerciale~" >= :da_id_sog AND ~"sog_commerciale_gen~".~"id_sog_commerciale~" <= :a_id_sog ) 
        and  (~"caus_magazzino~".~"saldi_cl_fino~" > ' ' )    

group by ~"sog_commerciale_gen~".~"codice~",   ~"sog_commerciale_gen~".~"id_sog_commerciale~",  ~"sog_commerciale_gen~".~"RAG_SOC_1~", ~"orafo_metallo~".~"codice~", right(~"orafo_tipo_partita~".~"cod_tipo_partita~"  , 3) 
order by ~"sog_commerciale_gen~".~"codice~",   ~"sog_commerciale_gen~".~"id_sog_commerciale~", ~"sog_commerciale_gen~".~"RAG_SOC_1~",   ~"orafo_metallo~".~"codice~", right(~"orafo_tipo_partita~".~"cod_tipo_partita~"  , 3)" arguments=(("da_data", date),("a_data", date),("da_id_sog", number),("a_id_sog", number)) )
