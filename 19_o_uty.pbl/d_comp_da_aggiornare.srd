table(column=(type=long updatewhereclause=yes identity=yes name=id_articolo dbname="articolo.id_articolo" )
 column=(type=char(32) updatewhereclause=yes name=articolo_codice dbname="articolo.codice" )
 column=(type=char(80) updatewhereclause=yes name=articolo_descrizione dbname="articolo.descrizione" )
 column=(type=char(1) updatewhereclause=yes name=unita_misura_tipo dbname="unita_misura.tipo" )
 column=(type=decimal(4) updatewhereclause=yes name=peso_netto dbname="unita_confezione.peso_netto" )
 column=(type=decimal(4) updatewhereclause=yes name=dim_l dbname="unita_confezione.dim_l" )
 column=(type=decimal(6) updatewhereclause=yes name=prezzo dbname="prezzo.prezzo" )
 column=(type=decimal(6) updatewhereclause=yes name=prezzo_manifattura dbname="prezzo.prezzo_manifattura" )
 column=(type=char(1) updatewhereclause=yes name=c_scegli dbname="c_scegli" values="	S/	N" )
 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"articolo~" )  TABLE(NAME=~"unita_confezione~" )  TABLE(NAME=~"unita_misura~" )  TABLE(NAME=~"prezzo~" )  TABLE(NAME=~"listino~" )  TABLE(NAME=~"variazione~" ) COLUMN(NAME=~"articolo.id_articolo~") COLUMN(NAME=~"articolo.codice~") COLUMN(NAME=~"articolo.descrizione~") COLUMN(NAME=~"unita_misura.tipo~") COLUMN(NAME=~"unita_confezione.peso_netto~") COLUMN(NAME=~"unita_confezione.dim_l~") COLUMN(NAME=~"prezzo.prezzo~") COLUMN(NAME=~"prezzo.prezzo_manifattura~") COMPUTE(NAME=~"'N' as c_scegli~")    JOIN (LEFT=~"unita_confezione.id_articolo~"    OP =~"=~"RIGHT=~"articolo.id_articolo~" )    JOIN (LEFT=~"unita_confezione.id_unita_misura~"    OP =~"=~"RIGHT=~"unita_misura.id_unita_misura~" )    JOIN (LEFT=~"prezzo.id_unita_confezione~"    OP =~"=~"RIGHT=~"unita_confezione.id_unita_confezione~" )    JOIN (LEFT=~"variazione.id_listino~"    OP =~"=~"RIGHT=~"listino.id_listino~" )    JOIN (LEFT=~"variazione.id_variazione~"    OP =~"=~"RIGHT=~"prezzo.id_variazione~" )WHERE(    EXP1 =~"~~~"listino~~~".~~~"tipo~~~"~"   OP =~"=~"    EXP2 =~"'A'~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"listino~~~".~~~"lis_base~~~"~"   OP =~"=~"    EXP2 =~"'S'~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"variazione~~~".~~~"data_inizio~~~"~"   OP =~"<=~"    EXP2 =~"today(*)~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"(~~~"variazione~~~".~~~"data_fine~~~"~"   OP =~">=~"    EXP2 =~"today(*)~"    LOGIC =~"or~" ) WHERE(    EXP1 =~"~~~"variazione~~~".~~~"data_fine~~~"~"   OP =~"is~"    EXP2 =~"null)~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"articolo~~~".~~~"id_cat_codifica~~~"~"   OP =~"=~"    EXP2 =~":id_cat_cod~" ) ) ARG(NAME = ~"id_cat_cod~" TYPE = number) " arguments=(("id_cat_cod", number))  sort="articolo_codice A " )
