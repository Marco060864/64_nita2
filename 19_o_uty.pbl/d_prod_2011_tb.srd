 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"documento~" ALIAS=~"documento_b~" )  TABLE(NAME=~"produzione_2011~" )  TABLE(NAME=~"riga_documento~" )  TABLE(NAME=~"caus_magazzino~" )  TABLE(NAME=~"articolo~" )  TABLE(NAME=~"documento~" ALIAS=~"documento_a~" )  TABLE(NAME=~"sog_commerciale_gen~" ) COLUMN(NAME=~"documento_a.num_progressivo~") COLUMN(NAME=~"documento_a.data_registrazione~") COLUMN(NAME=~"documento_a.num_documento~") COLUMN(NAME=~"documento_a.data_documento~") COLUMN(NAME=~"documento_b.num_progressivo~") COLUMN(NAME=~"documento_b.data_registrazione~") COLUMN(NAME=~"documento_b.num_documento~") COLUMN(NAME=~"documento_b.data_documento~") COLUMN(NAME=~"caus_magazzino.step_produzione~") COLUMN(NAME=~"caus_magazzino.saldi_cl_fino~") COLUMN(NAME=~"riga_documento.num_riga~") COLUMN(NAME=~"riga_documento.id_articolo~") COLUMN(NAME=~"riga_documento.quantita~") COLUMN(NAME=~"riga_documento.peso_netto~") COLUMN(NAME=~"riga_documento.calo~") COLUMN(NAME=~"riga_documento.fino~") COLUMN(NAME=~"articolo.codice~") COLUMN(NAME=~"documento_b.id_documento~") COLUMN(NAME=~"sog_commerciale_gen.rag_soc_1~") COLUMN(NAME=~"articolo.id_cat_codifica~") COLUMN(NAME=~"riga_documento.id_riga_sorgente~")    JOIN (LEFT=~"documento_b.id_documento~"    OP =~"=~"RIGHT=~"produzione_2011.id_doc_produzione~"    OUTER1 =~"documento_b.id_documento~" )    JOIN (LEFT=~"riga_documento.id_caus_magazzino~"    OP =~"=~"RIGHT=~"caus_magazzino.id_caus_magazzino~"    OUTER1 =~"riga_documento.id_caus_magazzino~" )    JOIN (LEFT=~"documento_b.id_documento~"    OP =~"=~"RIGHT=~"riga_documento.id_documento~"    OUTER1 =~"documento_b.id_documento~" )    JOIN (LEFT=~"riga_documento.id_articolo~"    OP =~"=~"RIGHT=~"articolo.id_articolo~"    OUTER1 =~"riga_documento.id_articolo~" )    JOIN (LEFT=~"documento_b.id_sog_commerciale~"    OP =~"=~"RIGHT=~"sog_commerciale_gen.id_sog_commerciale~"    OUTER1 =~"documento_b.id_sog_commerciale~" )    JOIN (LEFT=~"produzione_2011.id_bollettina~"    OP =~"=~"RIGHT=~"documento_a.id_documento~" )WHERE(    EXP1 =~"~~~"documento_a~~~".~~~"data_documento~~~"~"   OP =~">=~"    EXP2 =~":da_data~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"documento_a~~~".~~~"data_documento~~~"~"   OP =~"<=~"    EXP2 =~":a_data~" ) ) ARG(NAME = ~"da_data~" TYPE = date)  ARG(NAME = ~"a_data~" TYPE = date) " arguments=(("da_data", date),("a_data", date))  sort="bol_data_documento A bol_num_documento A documento_data_documento_1 A documento_num_documento_1 A caus_magazzino_saldi_cl_fino A documento_id_documento A " )
