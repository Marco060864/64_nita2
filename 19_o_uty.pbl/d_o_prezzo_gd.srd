 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"prezzo~" )  TABLE(NAME=~"articolo~" )  TABLE(NAME=~"unita_confezione~" ) COLUMN(NAME=~"prezzo.id_variazione~") COLUMN(NAME=~"articolo.codice~") COLUMN(NAME=~"prezzo.prezzo~") COLUMN(NAME=~"prezzo.id_unita_confezione~") COLUMN(NAME=~"prezzo.coef_calo~") COLUMN(NAME=~"prezzo.prezzo_manifattura~") COLUMN(NAME=~"prezzo.costo_imballo~")    JOIN (LEFT=~"unita_confezione.id_articolo~"    OP =~"=~"RIGHT=~"articolo.id_articolo~" )    JOIN (LEFT=~"unita_confezione.id_unita_confezione~"    OP =~"=~"RIGHT=~"prezzo.id_unita_confezione~" )WHERE(    EXP1 =~"~~~"prezzo~~~".~~~"id_variazione~~~"~"   OP =~"=~"    EXP2 =~":id_variazione~" ) ) ARG(NAME = ~"id_variazione~" TYPE = number) " update="prezzo" updatewhere=1 updatekeyinplace=yes arguments=(("id_variazione", number))  sort="articolo_codice A " )
