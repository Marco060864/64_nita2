 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"mov_contabile~" )  TABLE(NAME=~"reg_pd~" ) COLUMN(NAME=~"reg_pd.id_registro~") COLUMN(NAME=~"reg_pd.num_progressivo~") COLUMN(NAME=~"reg_pd.data_competenza~") COLUMN(NAME=~"reg_pd.id_prof_registrazione~") COLUMN(NAME=~"reg_pd.data_registrazione~") COLUMN(NAME=~"reg_pd.id_valuta~") COLUMN(NAME=~"mov_contabile.id_conto~") COLUMN(NAME=~"mov_contabile.cambio~") COLUMN(NAME=~"mov_contabile.des_contabile~") COLUMN(NAME=~"mov_contabile.dare~") COLUMN(NAME=~"mov_contabile.avere~") COLUMN(NAME=~"reg_pd.num_documento~") COLUMN(NAME=~"reg_pd.data_documento~")    JOIN (LEFT=~"reg_pd.id_reg_pd~"    OP =~"=~"RIGHT=~"mov_contabile.id_reg_pd~" )WHERE(    EXP1 =~"~~~"mov_contabile~~~".~~~"id_conto~~~"~"   OP =~"=~"    EXP2 =~"64~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"reg_pd~~~".~~~"data_registrazione~~~"~"   OP =~">=~"    EXP2 =~"'2008-01-01'~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"reg_pd~~~".~~~"data_registrazione~~~"~"   OP =~"<=~"    EXP2 =~"'2008-12-31'~" ) ) "  sort="reg_pd_data_registrazione A reg_pd_num_progressivo A " )
