global type f_validate_date from function_object
end type

forward prototypes
global function integer f_validate_date (string as_data_in, ref string as_data_out)
end prototypes

global function integer f_validate_date (string as_data_in, ref string as_data_out);

integer ll_retval
string  ls_data

if as_data_in="" then
	setNull(as_data_out)
	ll_retval = 1
else
		
		if IsDate(as_data_in) then
				as_data_out = as_data_in
				ll_retval = 0
		else
			ls_data = left(as_data_in,2)+"/"+mid(as_data_in,3,2)+"/"+mid(as_data_in,5)
			if IsDate(ls_data) then
				as_data_out = ls_data
				ll_retval = 1
			else
				as_data_out = ""
				ll_retval = -1
			end if
		end if
		

end if

return ll_retval

end function

