end on

event clicked;s_list_main ls_list
window iw_finestra
Long ll_ute, ll_menu, ll_voce
String ls_ogg, ls_win, ls_param

open(w_open_win)
ls_win=message.stringparm

ll_ute=u_freddie.s_utenti.i_idutente
select id_menu into :ll_menu
from utenti where id_utenti=:ll_ute;

select max(id_voci_menu) into :ll_voce
from voci_menu where vmenu_voce=:ls_win;

select o.ogg_oggetto, v.vmenu_parametri into :ls_ogg, :ls_param
from oggetti o, voci_menu v
where v.id_oggetti=o.id_oggetti
and v.id_voci_menu=:ll_voce;
//and v.id_menu=:ll_menu;

if sqlca.sqlcode<>0 then
	messagebox('Attenzione','Nessuna corrispondenza nel menu per la voce inserita!')
	return
else
	ls_list.s_win_parametri = ls_param
	OpenSheetWithParm(iw_finestra,ls_list,ls_ogg,w_app_frame,0,original!)	
end if	
end event

