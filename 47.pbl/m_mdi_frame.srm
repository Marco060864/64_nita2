on m_apri.create
call super::create
this.tag = "Apri finestra del menu"
this.text = "&Apri"
this.microhelp = "Apre una finestra"
this.toolbaritemname = "RunWindow!"
this.toolbaritemtext = "Apri voce di menu"
this.toolbaritemspace = 1
end on

on m_apri.destroy
