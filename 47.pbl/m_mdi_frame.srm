global type m_mdi_frame from menu
m_file m_file
m_modifica m_modifica
m_record m_record
m_finestre m_finestre
m_guida m_guida
end type
global m_mdi_frame m_mdi_frame

forward prototypes
public subroutine uf_route_event (string as_event)
public subroutine uf_enable_modifica (boolean ab_enable)
end prototypes

public subroutine uf_route_event (string as_event);// se la finestra corrente di Freddie è valida gli invia il messaggio

w_data_main lw_current

lw_current = u_freddie.iw_current
if IsValid(lw_current) then
	lw_current.triggerevent(as_event)
end if

end subroutine

public subroutine uf_enable_modifica (boolean ab_enable);THIS.m_modifica.m_inserisci.enabled = ab_enable
THIS.m_modifica.m_aggiungiincoda.enabled = ab_enable
THIS.m_modifica.m_salva.enabled = ab_enable
THIS.m_modifica.m_elimina.enabled = ab_enable

end subroutine

on m_mdi_frame.create
m_mdi_frame=this
call super::create
this.m_file=create m_file
this.m_modifica=create m_modifica
this.m_record=create m_record
this.m_finestre=create m_finestre
this.m_guida=create m_guida
this.Item[UpperBound(this.Item)+1]=this.m_file
this.Item[UpperBound(this.Item)+1]=this.m_modifica
this.Item[UpperBound(this.Item)+1]=this.m_record
this.Item[UpperBound(this.Item)+1]=this.m_finestre
this.Item[UpperBound(this.Item)+1]=this.m_guida
end on

on m_mdi_frame.destroy
call super::destroy
destroy(this.m_file)
destroy(this.m_modifica)
destroy(this.m_record)
destroy(this.m_finestre)
destroy(this.m_guida)
end on

