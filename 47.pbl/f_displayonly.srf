global type f_displayonly from function_object
end type

forward prototypes
global subroutine f_displayonly (datawindow dw_dwobj, string s_field, boolean b_status)
end prototypes

global subroutine f_displayonly (datawindow dw_dwobj, string s_field, boolean b_status);

dw_dwobj.Modify(s_field + ".Protect = " + string(b_status))
dw_dwobj.Modify(s_field + ".Background.Mode=" + string(b_status))
end subroutine

