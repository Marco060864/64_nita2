 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"articolo~" ) COLUMN(NAME=~"articolo.id_articolo~") COLUMN(NAME=~"articolo.id_cat_codifica~") COLUMN(NAME=~"articolo.codice~") COLUMN(NAME=~"articolo.descrizione~") COLUMN(NAME=~"articolo.immagine~") COLUMN(NAME=~"articolo.rif_catalogo~") COLUMN(NAME=~"articolo.id_cat_com_articolo~") COLUMN(NAME=~"articolo.id_cat_merceologica~") COLUMN(NAME=~"articolo.id_cat_fiscale~") COLUMN(NAME=~"articolo.id_gruppo_articoli~") COLUMN(NAME=~"articolo.des_breve~") COLUMN(NAME=~"articolo.id_reparto~") COLUMN(NAME=~"articolo.id_anagrafica~") COLUMN(NAME=~"articolo.id_sog_commerciale~") COLUMN(NAME=~"articolo.id_tab_iva~") COLUMN(NAME=~"articolo.cod_intrastat~") COLUMN(NAME=~"articolo.data_ora_creazione~") COLUMN(NAME=~"articolo.data_ora_ult_cambiamento~") COLUMN(NAME=~"articolo.data_ora_ult_var_stato~") COLUMN(NAME=~"articolo.stampa_in_inventario~") COLUMN(NAME=~"articolo.stampa_in_listini~") COLUMN(NAME=~"articolo.stampa_in_giornale~") COLUMN(NAME=~"articolo.stampa_in_schede~") COLUMN(NAME=~"articolo.ges_lotti~") COLUMN(NAME=~"articolo.ges_matricole~") COLUMN(NAME=~"articolo.ges_produzione~") COLUMN(NAME=~"articolo.note~") COLUMN(NAME=~"articolo.utilizzabile~") COLUMN(NAME=~"articolo.stato~") COLUMN(NAME=~"articolo.ges_locazioni~") COLUMN(NAME=~"articolo.giorni_invenduto~") COLUMN(NAME=~"articolo.id_azienda~") COLUMN(NAME=~"articolo.id_cif~") COLUMN(NAME=~"articolo.costo_aggiuntivo~") COLUMN(NAME=~"articolo.prod_interna~") COLUMN(NAME=~"articolo.id_lega~") COLUMN(NAME=~"articolo.id_titolo~") COLUMN(NAME=~"articolo.id_colore~") COLUMN(NAME=~"articolo.coef_calo~") COLUMN(NAME=~"articolo.id_pietra~") COLUMN(NAME=~"articolo.id_valuta~") COLUMN(NAME=~"articolo.id_unita_conf_base~") COLUMN(NAME=~"articolo.id_sigla_prezzo~") COLUMN(NAME=~"articolo.id_sog_comm_variante~") COLUMN(NAME=~"articolo.spina~") COLUMN(NAME=~"articolo.stampa_in_catalogo~") COLUMN(NAME=~"articolo.giorni_durata~") COLUMN(NAME=~"articolo.id_art_imballo~") COLUMN(NAME=~"articolo.nota~") COMPUTE(NAME=~"'                                                                                                                                                                                                                                                                ' as c_foto~")) " update="articolo" updatewhere=1 updatekeyinplace=yes  sort="codice A " )
