table(column=(type=long updatewhereclause=yes identity=yes name=id_sog_commerciale dbname="id_sog_commerciale" )
 column=(type=char(1) updatewhereclause=yes name=tipo dbname="tipo" values="Cliente	C/Fornitore	F/Agente	A/Vettore	V/Altro	Z/Cliente potenziale	P/" validation=" gettext()  = 'C' OR  gettext()  = 'F' OR  gettext()  = 'A' OR  gettext()  = 'V' OR  gettext()  = 'Z' OR  gettext()  = 'P'" validationmsg="'Inserire: C, F, A, V, P, Z'" )
