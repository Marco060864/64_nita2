 column=(type=char(1) updatewhereclause=yes name=per_fatturazione dbname="per_fatturazione" initial="L" values="Mensile	M/Settimanale	S/Quindicinale	Q/Libera	L/" validation=" gettext()  = 'M' OR  gettext()  = 'S' OR  gettext()  = 'Q' OR  gettext()  = 'L'" validationmsg="'Immettere: M, S, Q, L'" )
 column=(type=char(1) updatewhereclause=yes name=modo_fatturazione dbname="modo_fatturazione" values="In raggruppamento di bolle	R/Non in raggruppamento di bolle	N/" validation=" gettext()  = 'R' OR  gettext()  = 'N'" validationmsg="'Immettere: R, N'" )
 column=(type=char(1) updatewhereclause=yes name=con_fattura dbname="con_fattura" values="Come bolla di origine	O/In raggruppamento a parità di articolo	A/Con solo totale	T/" validation=" gettext()  = 'O' OR  gettext()  = 'A' OR  gettext()  = 'T'" validationmsg="'Immettere: O, A, T'" )
