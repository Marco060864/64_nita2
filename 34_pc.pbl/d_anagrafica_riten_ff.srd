 column=(type=char(1) updatewhereclause=yes name=prov_contabile dbname="anagrafica.prov_contabile" values="Azienda intracomunitaria	I/Azienda extracomunitaria	E/San Marino	S/" )
 column=(type=long updatewhereclause=yes name=id_valuta dbname="anagrafica.id_valuta" )
