table(column=(type=long update=yes updatewhereclause=yes key=yes identity=yes name=id_anagrafica dbname="anagrafica.id_anagrafica" dbalias=".id_anagrafica" initial="1" )
 column=(type=long update=yes updatewhereclause=yes name=id_titolo dbname="anagrafica.id_titolo" dbalias=".id_titolo" )
 column=(type=char(40) update=yes updatewhereclause=yes name=rag_soc_1 dbname="anagrafica.rag_soc_1" dbalias=".rag_soc_1" )
 column=(type=char(40) update=yes updatewhereclause=yes name=rag_soc_2 dbname="anagrafica.rag_soc_2" dbalias=".rag_soc_2" )
 column=(type=char(40) update=yes updatewhereclause=yes name=indirizzo dbname="anagrafica.indirizzo" dbalias=".indirizzo" )
 column=(type=char(10) update=yes updatewhereclause=yes name=cap dbname="anagrafica.cap" dbalias=".cap" )
 column=(type=char(40) update=yes updatewhereclause=yes name=localita dbname="anagrafica.localita" dbalias=".localita" )
 column=(type=char(5) update=yes updatewhereclause=yes name=provincia dbname="anagrafica.provincia" dbalias=".provincia" )
 column=(type=char(5) update=yes updatewhereclause=yes name=nazione dbname="anagrafica.nazione" dbalias=".nazione" initial="IT" )
 column=(type=char(16) update=yes updatewhereclause=yes name=cod_fiscale dbname="anagrafica.cod_fiscale" dbalias=".cod_fiscale" )
 column=(type=char(16) update=yes updatewhereclause=yes name=par_iva dbname="anagrafica.par_iva" dbalias=".par_iva" )
 column=(type=long update=yes updatewhereclause=yes name=id_lingua dbname="anagrafica.id_lingua" dbalias=".id_lingua" )
 column=(type=long update=yes updatewhereclause=yes name=id_linguaggio dbname="anagrafica.id_linguaggio" dbalias=".id_linguaggio" )
 column=(type=char(1) update=yes updatewhereclause=yes name=nat_giuridica dbname="anagrafica.nat_giuridica" dbalias=".nat_giuridica" initial="G" values="Persona giuridica	G/Persona fisica	F/" validation=" gettext()  = 'F' OR  gettext()  = 'G'" validationmsg="'Immettere: G, F'" )
 column=(type=char(1) update=yes updatewhereclause=yes name=prov_contabile dbname="anagrafica.prov_contabile" dbalias=".prov_contabile" initial="I" values="Azienda intracomunitaria	I/Azienda extracomunitaria	E/San Marino	S/" validation=" gettext()  = 'I' OR  gettext()  = 'E' OR  gettext()  = 'S'" validationmsg="'Immettere: I, E, S'" )
 column=(type=long update=yes updatewhereclause=yes name=id_valuta dbname="anagrafica.id_valuta" dbalias=".id_valuta" )
 column=(type=long update=yes updatewhereclause=yes name=id_tipo_trasporto dbname="anagrafica.id_tipo_trasporto" dbalias=".id_tipo_trasporto" )
 column=(type=long update=yes updatewhereclause=yes name=id_att_svolta dbname="anagrafica.id_att_svolta" dbalias=".id_att_svolta" )
 column=(type=long update=yes updatewhereclause=yes name=id_tributo dbname="anagrafica.id_tributo" dbalias=".id_tributo" )
 column=(type=char(40) update=yes updatewhereclause=yes name=cog_ritenute dbname="anagrafica.cog_ritenute" dbalias=".cog_ritenute" )
 column=(type=char(40) update=yes updatewhereclause=yes name=nome_ritenute dbname="anagrafica.nome_ritenute" dbalias=".nome_ritenute" )
 column=(type=char(1) update=yes updatewhereclause=yes name=sesso dbname="anagrafica.sesso" dbalias=".sesso" values="Maschile	M/Femminile	F/Non Gestito	A/" validation=" gettext()  = 'M' OR  gettext()  = 'F' OR  gettext()  = 'A'" validationmsg="'Immettere: M, F, A'" )
 column=(type=char(40) update=yes updatewhereclause=yes name=ind_ritenute dbname="anagrafica.ind_ritenute" dbalias=".ind_ritenute" )
 column=(type=char(10) update=yes updatewhereclause=yes name=cap_ritenute dbname="anagrafica.cap_ritenute" dbalias=".cap_ritenute" )
 column=(type=char(40) update=yes updatewhereclause=yes name=loc_ritenute dbname="anagrafica.loc_ritenute" dbalias=".loc_ritenute" )
 column=(type=char(5) update=yes updatewhereclause=yes name=prov_ritenute dbname="anagrafica.prov_ritenute" dbalias=".prov_ritenute" )
 column=(type=char(5) update=yes updatewhereclause=yes name=naz_ritenute dbname="anagrafica.naz_ritenute" dbalias=".naz_ritenute" initial="IT" )
 column=(type=date update=yes updatewhereclause=yes name=data_nas_ritenute dbname="anagrafica.data_nas_ritenute" dbalias=".data_nas_ritenute" )
 column=(type=char(40) update=yes updatewhereclause=yes name=luogo_nas_ritenute dbname="anagrafica.luogo_nas_ritenute" dbalias=".luogo_nas_ritenute" )
 column=(type=char(5) update=yes updatewhereclause=yes name=prov_nas_ritenute dbname="anagrafica.prov_nas_ritenute" dbalias=".prov_nas_ritenute" )
 column=(type=char(5) update=yes updatewhereclause=yes name=naz_nas_ritenute dbname="anagrafica.naz_nas_ritenute" dbalias=".naz_nas_ritenute" initial="IT" )
 column=(type=decimal(2) update=yes updatewhereclause=yes name=con_previdenziale dbname="anagrafica.con_previdenziale" dbalias=".con_previdenziale" validation=" real(gettext())  >= 0 AND  real(gettext())  <= 100" validationmsg="'Immettere un valore fra 0 e 100'" )
 column=(type=decimal(2) update=yes updatewhereclause=yes name=cassa_previdenza dbname="anagrafica.cassa_previdenza" dbalias=".cassa_previdenza" validation=" real(gettext())  >= 0 AND  real(gettext())  <= 100" validationmsg="'Immettere un valore fra 0 e 100'" )
 column=(type=decimal(2) update=yes updatewhereclause=yes name=rit_previdenziale dbname="anagrafica.rit_previdenziale" dbalias=".rit_previdenziale" validation=" real(gettext())  >= 0 AND  real(gettext())  <= 100" validationmsg="'Immettere un valore fra 0 e 100'" )
 column=(type=char(1) update=yes updatewhereclause=yes name=isc_enasarco dbname="anagrafica.isc_enasarco" dbalias=".isc_enasarco" initial="N" values="	S/	N" validation=" gettext()  = 'S' OR  gettext()  = 'N'" validationmsg="'Immettere: S, N'" )
 column=(type=decimal(2) update=yes updatewhereclause=yes name=per_enasarco_agente dbname="anagrafica.per_enasarco_agente" dbalias=".per_enasarco_agente" validation=" real(gettext())  >= 0 AND  real(gettext())  <= 100" validationmsg="'Immettere un valore fra 0 e 100'" )
