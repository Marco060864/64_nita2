 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"anagrafica~" ) COLUMN(NAME=~"anagrafica.id_anagrafica~") COLUMN(NAME=~"anagrafica.id_titolo~") COLUMN(NAME=~"anagrafica.rag_soc_1~") COLUMN(NAME=~"anagrafica.rag_soc_2~") COLUMN(NAME=~"anagrafica.indirizzo~") COLUMN(NAME=~"anagrafica.cap~") COLUMN(NAME=~"anagrafica.localita~") COLUMN(NAME=~"anagrafica.provincia~") COLUMN(NAME=~"anagrafica.nazione~") COLUMN(NAME=~"anagrafica.cod_fiscale~") COLUMN(NAME=~"anagrafica.par_iva~") COLUMN(NAME=~"anagrafica.id_lingua~") COLUMN(NAME=~"anagrafica.id_linguaggio~") COLUMN(NAME=~"anagrafica.nat_giuridica~") COLUMN(NAME=~"anagrafica.prov_contabile~") COLUMN(NAME=~"anagrafica.id_valuta~") COLUMN(NAME=~"anagrafica.id_tipo_trasporto~") COLUMN(NAME=~"anagrafica.id_att_svolta~") COLUMN(NAME=~"anagrafica.id_tributo~") COLUMN(NAME=~"anagrafica.cog_ritenute~") COLUMN(NAME=~"anagrafica.nome_ritenute~") COLUMN(NAME=~"anagrafica.sesso~") COLUMN(NAME=~"anagrafica.ind_ritenute~") COLUMN(NAME=~"anagrafica.cap_ritenute~") COLUMN(NAME=~"anagrafica.loc_ritenute~") COLUMN(NAME=~"anagrafica.prov_ritenute~") COLUMN(NAME=~"anagrafica.naz_ritenute~") COLUMN(NAME=~"anagrafica.data_nas_ritenute~") COLUMN(NAME=~"anagrafica.luogo_nas_ritenute~") COLUMN(NAME=~"anagrafica.prov_nas_ritenute~") COLUMN(NAME=~"anagrafica.naz_nas_ritenute~") COLUMN(NAME=~"anagrafica.con_previdenziale~") COLUMN(NAME=~"anagrafica.cassa_previdenza~") COLUMN(NAME=~"anagrafica.rit_previdenziale~") COLUMN(NAME=~"anagrafica.isc_enasarco~") COLUMN(NAME=~"anagrafica.per_enasarco_agente~") COLUMN(NAME=~"anagrafica.per_enasarco_conto_agente~") COLUMN(NAME=~"anagrafica.id_azienda~") COLUMN(NAME=~"anagrafica.bollo~") COLUMN(NAME=~"anagrafica.codice~") COLUMN(NAME=~"anagrafica.cod_interscambio_ae~") COLUMN(NAME=~"anagrafica.pec~") COLUMN(NAME=~"anagrafica.codeori~") COLUMN(NAME=~"anagrafica.num_lic_guida~")) " update="anagrafica" updatewhere=1 updatekeyinplace=yes )
