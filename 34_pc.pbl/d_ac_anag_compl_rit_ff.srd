 column=(type=long update=yes updatewhereclause=yes name=codice dbname="anagrafica.codice" dbalias=".codice" )
 column=(type=char(7) update=yes updatewhereclause=yes name=cod_interscambio_ae dbname="anagrafica.cod_interscambio_ae" dbalias=".cod_interscambio_ae" )
