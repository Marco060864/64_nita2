//objectcomments datawindow (freeform) per la gestione della parte commerciale del soggetto commerciale (tabella Anagrafica);
release 5;
datawindow(units=0 timer_interval=0 color=79741120 processing=0 print.documentname="" print.orientation = 0 print.margin.left = 110 print.margin.right = 110 print.margin.top = 97 print.margin.bottom = 97 print.paper.source = 0 print.paper.size = 0 print.prompt=no )
header(height=1 color="536870912" )
summary(height=1 color="536870912" )
footer(height=1 color="536870912" )
detail(height=317 color="536870912" )
table(column=(type=long updatewhereclause=yes name=id_anagrafica dbname="anagrafica.id_anagrafica" )
 column=(type=char(40) updatewhereclause=yes name=rag_soc_1 dbname="anagrafica.rag_soc_1" )
 column=(type=char(40) updatewhereclause=yes name=rag_soc_2 dbname="anagrafica.rag_soc_2" )
 column=(type=char(40) updatewhereclause=yes name=indirizzo dbname="anagrafica.indirizzo" )
 column=(type=char(10) updatewhereclause=yes name=cap dbname="anagrafica.cap" )
 column=(type=char(40) updatewhereclause=yes name=localita dbname="anagrafica.localita" )
 column=(type=char(5) updatewhereclause=yes name=provincia dbname="anagrafica.provincia" )
 column=(type=char(5) updatewhereclause=yes name=nazione dbname="anagrafica.nazione" )
 column=(type=char(16) updatewhereclause=yes name=cod_fiscale dbname="anagrafica.cod_fiscale" )
 column=(type=char(16) updatewhereclause=yes name=par_iva dbname="anagrafica.par_iva" )
 column=(type=long updatewhereclause=yes name=id_linguaggio dbname="anagrafica.id_linguaggio" )
 column=(type=char(1) updatewhereclause=yes name=nat_giuridica dbname="anagrafica.nat_giuridica" values="Persona giuridica	G/Persona fisica	F/" )
 column=(type=char(1) updatewhereclause=yes name=prov_contabile dbname="anagrafica.prov_contabile" values="Azienda intracomunitaria	I/Azienda extracomunitaria	E/San Marino	S/" )
 column=(type=long updatewhereclause=yes name=id_valuta_des dbname="anagrafica.id_valuta" )
 column=(type=long updatewhereclause=yes name=id_tipo_trasporto_des dbname="anagrafica.id_tipo_trasporto" )
 column=(type=long updatewhereclause=yes name=id_att_svolta dbname="anagrafica.id_att_svolta" )
 column=(type=long updatewhereclause=yes name=id_tributo dbname="anagrafica.id_tributo" )
 column=(type=long updatewhereclause=yes name=id_titolo dbname="anagrafica.id_titolo" )
 column=(type=char(40) updatewhereclause=yes name=cog_ritenute dbname="anagrafica.cog_ritenute" )
 column=(type=char(40) updatewhereclause=yes name=nome_ritenute dbname="anagrafica.nome_ritenute" )
 column=(type=char(1) updatewhereclause=yes name=sesso dbname="anagrafica.sesso" values="Maschile	M/Femminile	F/Azienda	A/" )
 column=(type=char(40) updatewhereclause=yes name=ind_ritenute dbname="anagrafica.ind_ritenute" )
 column=(type=char(10) updatewhereclause=yes name=cap_ritenute dbname="anagrafica.cap_ritenute" )
 column=(type=char(40) updatewhereclause=yes name=loc_ritenute dbname="anagrafica.loc_ritenute" )
 column=(type=char(5) updatewhereclause=yes name=prov_ritenute dbname="anagrafica.prov_ritenute" )
 column=(type=char(5) updatewhereclause=yes name=naz_ritenute dbname="anagrafica.naz_ritenute" )
 column=(type=date updatewhereclause=yes name=data_nas_ritenute dbname="anagrafica.data_nas_ritenute" )
 column=(type=char(40) updatewhereclause=yes name=luogo_nas_ritenute dbname="anagrafica.luogo_nas_ritenute" )
 column=(type=char(5) updatewhereclause=yes name=prov_nas_ritenute dbname="anagrafica.prov_nas_ritenute" )
 column=(type=char(5) updatewhereclause=yes name=naz_nas_ritenute dbname="anagrafica.naz_nas_ritenute" )
 column=(type=char(1) updatewhereclause=yes name=isc_enasarco dbname="anagrafica.isc_enasarco" initial="N" values="	S/	N" validationmsg="'Immettere: S, N'" )
 column=(type=decimal(2) updatewhereclause=yes name=per_enasarco_agente dbname="anagrafica.per_enasarco_agente" validation="real(gettext())  >= 0 AND  real(gettext())  <= 100" validationmsg="'Immettere un valore fra 0 e 100'" )
 column=(type=decimal(2) updatewhereclause=yes name=per_enasarco_conto_agente dbname="anagrafica.per_enasarco_conto_agente" validation="real(gettext())  >= 0 AND  real(gettext())  <= 100" validationmsg="'Immettere un valore fra 0 e 100'" )
 column=(type=long updatewhereclause=yes name=id_azienda dbname="anagrafica.id_azienda" initial="1" )
 column=(type=decimal(2) updatewhereclause=yes name=con_previdenziale dbname="anagrafica.con_previdenziale" validation=" real(gettext())  >= 0 AND  real(gettext())  <= 100" validationmsg="'Immettere un valore fra 0 e 100'" )
 column=(type=decimal(2) updatewhereclause=yes name=cassa_previdenza dbname="anagrafica.cassa_previdenza" validation=" real(gettext())  >= 0 AND  real(gettext())  <= 100" validationmsg="'Immettere un valore fra 0 e 100'" )
 column=(type=decimal(2) updatewhereclause=yes name=rit_previdenziale dbname="anagrafica.rit_previdenziale" validation=" real(gettext())  >= 0 AND  real(gettext())  <= 100" validationmsg="'Immettere un valore fra 0 e 100'" )
 column=(type=long updatewhereclause=yes name=id_lingua dbname="anagrafica.id_lingua" )
 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"anagrafica~" ) COLUMN(NAME=~"anagrafica.id_anagrafica~") COLUMN(NAME=~"anagrafica.rag_soc_1~") COLUMN(NAME=~"anagrafica.rag_soc_2~") COLUMN(NAME=~"anagrafica.indirizzo~") COLUMN(NAME=~"anagrafica.cap~") COLUMN(NAME=~"anagrafica.localita~") COLUMN(NAME=~"anagrafica.provincia~") COLUMN(NAME=~"anagrafica.nazione~") COLUMN(NAME=~"anagrafica.cod_fiscale~") COLUMN(NAME=~"anagrafica.par_iva~") COLUMN(NAME=~"anagrafica.id_linguaggio~") COLUMN(NAME=~"anagrafica.nat_giuridica~") COLUMN(NAME=~"anagrafica.prov_contabile~") COLUMN(NAME=~"anagrafica.id_valuta~") COLUMN(NAME=~"anagrafica.id_tipo_trasporto~") COLUMN(NAME=~"anagrafica.id_att_svolta~") COLUMN(NAME=~"anagrafica.id_tributo~") COLUMN(NAME=~"anagrafica.id_titolo~") COLUMN(NAME=~"anagrafica.cog_ritenute~") COLUMN(NAME=~"anagrafica.nome_ritenute~") COLUMN(NAME=~"anagrafica.sesso~") COLUMN(NAME=~"anagrafica.ind_ritenute~") COLUMN(NAME=~"anagrafica.cap_ritenute~") COLUMN(NAME=~"anagrafica.loc_ritenute~") COLUMN(NAME=~"anagrafica.prov_ritenute~") COLUMN(NAME=~"anagrafica.naz_ritenute~") COLUMN(NAME=~"anagrafica.data_nas_ritenute~") COLUMN(NAME=~"anagrafica.luogo_nas_ritenute~") COLUMN(NAME=~"anagrafica.prov_nas_ritenute~") COLUMN(NAME=~"anagrafica.naz_nas_ritenute~") COLUMN(NAME=~"anagrafica.isc_enasarco~") COLUMN(NAME=~"anagrafica.per_enasarco_agente~") COLUMN(NAME=~"anagrafica.per_enasarco_conto_agente~") COLUMN(NAME=~"anagrafica.id_azienda~") COLUMN(NAME=~"anagrafica.con_previdenziale~") COLUMN(NAME=~"anagrafica.cassa_previdenza~") COLUMN(NAME=~"anagrafica.rit_previdenziale~") COLUMN(NAME=~"anagrafica.id_lingua~")WHERE(    EXP1 =~"( ~~~"anagrafica~~~".~~~"id_azienda~~~"~"   OP =~"in~"    EXP2 =~"(0,1) )~" ) ) ORDER(NAME=~"anagrafica.rag_soc_1~" ASC=yes )  ORDER(NAME=~"anagrafica.rag_soc_2~" ASC=yes ) " )
