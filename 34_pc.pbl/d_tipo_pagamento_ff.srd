table(column=(type=long update=yes updatewhereclause=yes identity=yes name=id_tipo_pagamento dbname="tipo_pagamento.id_tipo_pagamento" )
 column=(type=char(4) update=yes updatewhereclause=yes key=yes name=codice dbname="tipo_pagamento.codice" )
 column=(type=char(40) update=yes updatewhereclause=yes name=descrizione dbname="tipo_pagamento.descrizione" )
 column=(type=char(40) update=yes updatewhereclause=yes name=mod_stampa dbname="tipo_pagamento.mod_stampa" )
 column=(type=char(1) update=yes updatewhereclause=yes name=ges_cessioni dbname="tipo_pagamento.ges_cessioni" initial="N" values="	S/	N" validation=" gettext()  = 'S' OR  gettext()  = 'N'" validationmsg="'Immettere: S, N'" )
 column=(type=char(15) update=yes updatewhereclause=yes name=spese_gestite dbname="tipo_pagamento.spese_gestite" validation="match( gettext() , ~"^[1-9TCBI]+$~")" validationmsg="'Immettere tutte le spese applicabili (T, C, B, I e da 1 a 9)'" )
 column=(type=decimal(2) update=yes updatewhereclause=yes name=perc_tratte dbname="tipo_pagamento.perc_tratte" validation=" real(gettext())  >= 0 AND  real(gettext())  <= 100" validationmsg="'Immettere un valore fra 0 e 100'" )
 column=(type=decimal(0) update=yes updatewhereclause=yes name=arr_bollo_tratta dbname="tipo_pagamento.arr_bollo_tratta" validation=" real(gettext())  >= 0" validationmsg="'Immettere un valore >= 0'" )
 column=(type=decimal(0) update=yes updatewhereclause=yes name=imp_min_bollo_tratta dbname="tipo_pagamento.imp_min_bollo_tratta" validation=" real(gettext())  >= 0" validationmsg="'Immettere un valore >= 0'" )
 column=(type=long update=yes updatewhereclause=yes name=id_prof_reg_dare_cod dbname="tipo_pagamento.id_prof_reg_dare" )
 column=(type=long update=yes updatewhereclause=yes name=id_prof_reg_avere_cod dbname="tipo_pagamento.id_prof_reg_avere" )
 column=(type=long update=yes updatewhereclause=yes name=id_gruppo_esp_sospeso_des dbname="tipo_pagamento.id_gruppo_esp_sospeso" )
 column=(type=char(1) updatewhereclause=yes name=premi_penalita dbname="tipo_pagamento.premi_penalita" values="	S/	N" )
 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"tipo_pagamento~" ) COLUMN(NAME=~"tipo_pagamento.id_tipo_pagamento~") COLUMN(NAME=~"tipo_pagamento.codice~") COLUMN(NAME=~"tipo_pagamento.descrizione~") COLUMN(NAME=~"tipo_pagamento.mod_stampa~") COLUMN(NAME=~"tipo_pagamento.ges_cessioni~") COLUMN(NAME=~"tipo_pagamento.spese_gestite~") COLUMN(NAME=~"tipo_pagamento.perc_tratte~") COLUMN(NAME=~"tipo_pagamento.arr_bollo_tratta~") COLUMN(NAME=~"tipo_pagamento.imp_min_bollo_tratta~") COLUMN(NAME=~"tipo_pagamento.id_prof_reg_dare~") COLUMN(NAME=~"tipo_pagamento.id_prof_reg_avere~") COLUMN(NAME=~"tipo_pagamento.id_gruppo_esp_sospeso~") COLUMN(NAME=~"tipo_pagamento.premi_penalita~")) ORDER(NAME=~"tipo_pagamento.codice~" ASC=yes ) " update="tipo_pagamento" updatewhere=1 updatekeyinplace=yes )
