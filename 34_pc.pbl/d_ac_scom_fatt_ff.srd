 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"sog_commerciale~" )  TABLE(NAME=~"con_movimento~" ) COLUMN(NAME=~"sog_commerciale.id_sog_commerciale~") COLUMN(NAME=~"sog_commerciale.tipo~") COLUMN(NAME=~"sog_commerciale.codice~") COLUMN(NAME=~"sog_commerciale.id_anagrafica~") COLUMN(NAME=~"sog_commerciale.id_conto~") COLUMN(NAME=~"sog_commerciale.data_acquisizione~") COLUMN(NAME=~"sog_commerciale.data_trasformazione~") COLUMN(NAME=~"sog_commerciale.ns_cod_soggetto~") COLUMN(NAME=~"sog_commerciale.id_linguaggio~") COLUMN(NAME=~"sog_commerciale.id_cat_attivita~") COLUMN(NAME=~"sog_commerciale.id_cat_com_sc~") COLUMN(NAME=~"sog_commerciale.id_cat_zona~") COLUMN(NAME=~"sog_commerciale.id_magazzino~") COLUMN(NAME=~"sog_commerciale.fido~") COLUMN(NAME=~"sog_commerciale.extrafido~") COLUMN(NAME=~"sog_commerciale.con_fido~") COLUMN(NAME=~"sog_commerciale.id_con_pagamento~") COLUMN(NAME=~"sog_commerciale.data_dec_pagamenti~") COLUMN(NAME=~"sog_commerciale.giorno_fisso_pagamenti~") COLUMN(NAME=~"sog_commerciale.scad_raggruppate~") COLUMN(NAME=~"sog_commerciale.id_banca_sog_commerciale~") COLUMN(NAME=~"sog_commerciale.id_listino~") COLUMN(NAME=~"sog_commerciale.id_tipo_trasporto~") COLUMN(NAME=~"sog_commerciale.id_sog_com_vettore~") COLUMN(NAME=~"sog_commerciale.per_fatturazione~") COLUMN(NAME=~"sog_commerciale.modo_fatturazione~") COLUMN(NAME=~"sog_commerciale.con_fattura~") COLUMN(NAME=~"sog_commerciale.fat_sos_iva~") COLUMN(NAME=~"sog_commerciale.id_tab_iva~") COLUMN(NAME=~"sog_commerciale.num_ns_prot_documenti~") COLUMN(NAME=~"sog_commerciale.data_ns_prot_documenti~") COLUMN(NAME=~"sog_commerciale.num_lr_prot_documenti~") COLUMN(NAME=~"sog_commerciale.data_lr_prot_documenti~") COLUMN(NAME=~"sog_commerciale.uff_iva~") COLUMN(NAME=~"sog_commerciale.id_prof_registrazione~") COLUMN(NAME=~"sog_commerciale.id_tributo~") COLUMN(NAME=~"sog_commerciale.id_att_svolta~") COLUMN(NAME=~"sog_commerciale.id_gruppo_agenti~") COLUMN(NAME=~"sog_commerciale.id_azienda~") COMPUTE(NAME=~"cast('' as char(8)) As c_magazzino_cod~") COMPUTE(NAME=~"cast('' as char(40)) As c_magazzino_des~") COMPUTE(NAME=~"cast('' as char(8)) As c_condpag_cod~") COMPUTE(NAME=~"cast('' as char(40)) As c_condpag_des~") COMPUTE(NAME=~"cast('' as char(83)) As c_abi_cab_des~") COMPUTE(NAME=~"cast('' as char(1)) As c_cin~") COMPUTE(NAME=~"cast('' as char(20)) As c_conto_corrente~") COMPUTE(NAME=~"cast('' as char(8)) As c_vettore_cod~") COMPUTE(NAME=~"cast('' as char(40)) As c_vettore_des~") COMPUTE(NAME=~"cast('' as char(1)) As c_info~") COMPUTE(NAME=~"cast('' as char(1)) As c_conto_presente~") COMPUTE(NAME=~"cast('' as integer) As sm~") COLUMN(NAME=~"sog_commerciale.id_tipo_agente~") COLUMN(NAME=~"sog_commerciale.imp_fisso~") COLUMN(NAME=~"sog_commerciale.giorni_franchigia~") COLUMN(NAME=~"sog_commerciale.id_val_prov_agente~") COLUMN(NAME=~"sog_commerciale.crea_gruppo_agenti~") COLUMN(NAME=~"sog_commerciale.id_tab_iva_fat_prov~") COLUMN(NAME=~"con_movimento.id_conto~") COMPUTE(NAME=~"cast('' as char(8)) as cod_contropartita~") COMPUTE(NAME=~"cast('' as char(40)) as des_contropartita~") COMPUTE(NAME=~"cast('' as char(8)) As c_vettore_2_cod~") COMPUTE(NAME=~"cast('' as char(40)) As c_vettore_2_des~") COLUMN(NAME=~"sog_commerciale.id_sog_com_vettore_2~") COLUMN(NAME=~"sog_commerciale.id_gruppo_agenti_2~") COLUMN(NAME=~"sog_commerciale.tolleranza~") COLUMN(NAME=~"sog_commerciale.pz_precisi~") COLUMN(NAME=~"sog_commerciale.tipo_comunicazione~")    JOIN (LEFT=~"con_movimento.id_sog_commerciale~"    OP =~"=~"RIGHT=~"sog_commerciale.id_sog_commerciale~"    OUTER2 =~"sog_commerciale.id_sog_commerciale~" )WHERE(    EXP1 =~"~~~"sog_commerciale~~~".~~~"id_anagrafica~~~"~"   OP =~"=~"    EXP2 =~":ri_id_anagrafica~" ) ) ARG(NAME = ~"ri_id_anagrafica~" TYPE = number) " arguments=(("ri_id_anagrafica", number)) )
