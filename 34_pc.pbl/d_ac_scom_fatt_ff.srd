table(column=(type=long updatewhereclause=yes identity=yes name=id_sog_commerciale dbname="sog_commerciale.id_sog_commerciale" )
 column=(type=char(1) updatewhereclause=yes name=tipo dbname="sog_commerciale.tipo" values="Cliente	C/Fornitore	F/Agente	A/Vettore	V/Altro	Z/Cliente potenziale	P/" validation=" gettext()  = 'C' OR  gettext()  = 'F' OR  gettext()  = 'A' OR  gettext()  = 'V' OR  gettext()  = 'Z' OR  gettext()  = 'P'" validationmsg="'Inserire: C, F, A, V, P, Z'" )
 column=(type=char(8) updatewhereclause=yes name=codice dbname="sog_commerciale.codice" )
 column=(type=long updatewhereclause=yes name=id_anagrafica dbname="sog_commerciale.id_anagrafica" )
 column=(type=long updatewhereclause=yes name=id_conto dbname="sog_commerciale.id_conto" )
 column=(type=date updatewhereclause=yes name=data_acquisizione dbname="sog_commerciale.data_acquisizione" )
 column=(type=date updatewhereclause=yes name=data_trasformazione dbname="sog_commerciale.data_trasformazione" )
 column=(type=char(20) updatewhereclause=yes name=ns_cod_soggetto dbname="sog_commerciale.ns_cod_soggetto" )
 column=(type=long updatewhereclause=yes name=id_linguaggio dbname="sog_commerciale.id_linguaggio" )
 column=(type=long updatewhereclause=yes name=id_cat_attivita dbname="sog_commerciale.id_cat_attivita" )
 column=(type=long updatewhereclause=yes name=id_cat_com_sc dbname="sog_commerciale.id_cat_com_sc" )
 column=(type=long updatewhereclause=yes name=id_cat_zona dbname="sog_commerciale.id_cat_zona" )
 column=(type=long updatewhereclause=yes name=id_magazzino dbname="sog_commerciale.id_magazzino" )
 column=(type=decimal(0) updatewhereclause=yes name=fido dbname="sog_commerciale.fido" validation=" real(gettext())  >= 0" validationmsg="'Immettere un valore >= 0'" )
 column=(type=decimal(0) updatewhereclause=yes name=extrafido dbname="sog_commerciale.extrafido" validation=" real(gettext())  >= 0" validationmsg="'Immettere un valore >= 0'" )
 column=(type=char(1) updatewhereclause=yes name=con_fido dbname="sog_commerciale.con_fido" initial="N" values="Nessun controllo	N/Solo controllo	C/Controllo e blocco	B/Blocco incondizionato	X/" validation=" gettext()  = 'N' OR  gettext()  = 'C' OR  gettext()  = 'B' OR  gettext()  = 'X'" validationmsg="'Immettere: N, C, B, S'" )
 column=(type=long updatewhereclause=yes name=id_con_pagamento dbname="sog_commerciale.id_con_pagamento" )
 column=(type=char(1) updatewhereclause=yes name=data_dec_pagamenti dbname="sog_commerciale.data_dec_pagamenti" values="Fine mese	F/Data fattura	D/" validation=" gettext()  = 'F' OR  gettext()  = 'D'" validationmsg="'Immettere: F, D'" )
 column=(type=decimal(0) updatewhereclause=yes name=giorno_fisso_pagamenti dbname="sog_commerciale.giorno_fisso_pagamenti" validation=" real(gettext())  >= 1 AND  real(gettext())  <= 31" validationmsg="'Immettere un giorno (fra 1 e 31)'" )
 column=(type=char(1) updatewhereclause=yes name=scad_raggruppate dbname="sog_commerciale.scad_raggruppate" initial="N" values="	S/	N" validation=" gettext()  = 'S' OR  gettext()  = 'N'" validationmsg="'Immettere: S, N'" )
 column=(type=long updatewhereclause=yes name=id_banca_sog_commerciale dbname="sog_commerciale.id_banca_sog_commerciale" )
 column=(type=long updatewhereclause=yes name=id_listino dbname="sog_commerciale.id_listino" )
 column=(type=long updatewhereclause=yes name=id_tipo_trasporto dbname="sog_commerciale.id_tipo_trasporto" )
 column=(type=long updatewhereclause=yes name=id_sog_com_vettore dbname="sog_commerciale.id_sog_com_vettore" )
 column=(type=char(1) updatewhereclause=yes name=per_fatturazione dbname="sog_commerciale.per_fatturazione" initial="L" values="Mensile	M/Settimanale	S/Quindicinale	Q/Libera	L/" validation=" gettext()  = 'M' OR  gettext()  = 'S' OR  gettext()  = 'Q' OR  gettext()  = 'L'" validationmsg="'Immettere: M, S, Q, L'" )
 column=(type=char(1) updatewhereclause=yes name=modo_fatturazione dbname="sog_commerciale.modo_fatturazione" values="In raggruppamento di bolle	R/Non in raggruppamento di bolle	N/" validation=" gettext()  = 'R' OR  gettext()  = 'N'" validationmsg="'Immettere: R, N'" )
 column=(type=char(1) updatewhereclause=yes name=con_fattura dbname="sog_commerciale.con_fattura" values="Come bolla di origine	O/In raggruppamento a parità di articolo	A/Con solo totale	T/" validation=" gettext()  = 'O' OR  gettext()  = 'A' OR  gettext()  = 'T'" validationmsg="'Immettere: O, A, T'" )
 column=(type=char(1) updatewhereclause=yes name=fat_sos_iva dbname="sog_commerciale.fat_sos_iva" initial="N" values="	S/	N" validation=" gettext()  = 'S' OR  gettext()  = 'N'" validationmsg="'Immettere: S, N'" )
