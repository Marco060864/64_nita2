table(column=(type=long update=yes updatewhereclause=yes key=yes name=id_con_pagamento dbname="app_pagamento.id_con_pagamento" )
 column=(type=decimal(0) update=yes updatewhereclause=yes key=yes name=num_ordine dbname="app_pagamento.num_ordine" validation=" real(gettext())  >= 0" validationmsg="'Immettere un valore >= 0'" )
 column=(type=decimal(0) update=yes updatewhereclause=yes name=giorni_data_decorrenza dbname="app_pagamento.giorni_data_decorrenza" validation=" real(gettext())  >= 0" validationmsg="'Immettere un valore >= 0'" )
 column=(type=decimal(0) update=yes updatewhereclause=yes name=num_rate dbname="app_pagamento.num_rate" initial="1" validation=" real(gettext())  >= 0" validationmsg="'Immettere un valore >= 0'" )
 column=(type=decimal(0) update=yes updatewhereclause=yes name=giorni_rate dbname="app_pagamento.giorni_rate" validation=" real(gettext())  >= 0" validationmsg="'Immettere un valore >= 0'" )
 column=(type=char(1) update=yes updatewhereclause=yes name=giorno_scadenza dbname="app_pagamento.giorno_scadenza" values="Data decorrenza	D/Fine mese	M/Fisso	F/Fisso dal 1° del mese	A/" )
 column=(type=decimal(0) update=yes updatewhereclause=yes name=giorno_fisso dbname="app_pagamento.giorno_fisso" validation=" real(gettext())  >= 1 AND  real(gettext())  <= 31" validationmsg="'Immettere un giorno (fra 1 e 31)'" )
 column=(type=long update=yes updatewhereclause=yes name=id_tipo_pagamento_des dbname="app_pagamento.id_tipo_pagamento" )
 column=(type=decimal(4) update=yes updatewhereclause=yes name=importo_fisso dbname="app_pagamento.importo_fisso" )
 column=(type=decimal(4) update=yes updatewhereclause=yes name=importo_fisso_iva dbname="app_pagamento.importo_fisso_iva" )
 column=(type=decimal(4) update=yes updatewhereclause=yes name=per_iva dbname="app_pagamento.per_iva" )
 column=(type=decimal(4) update=yes updatewhereclause=yes name=per_imponibile dbname="app_pagamento.per_imponibile" )
 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"app_pagamento~" ) COLUMN(NAME=~"app_pagamento.id_con_pagamento~") COLUMN(NAME=~"app_pagamento.num_ordine~") COLUMN(NAME=~"app_pagamento.giorni_data_decorrenza~") COLUMN(NAME=~"app_pagamento.num_rate~") COLUMN(NAME=~"app_pagamento.giorni_rate~") COLUMN(NAME=~"app_pagamento.giorno_scadenza~") COLUMN(NAME=~"app_pagamento.giorno_fisso~") COLUMN(NAME=~"app_pagamento.id_tipo_pagamento~") COLUMN(NAME=~"app_pagamento.importo_fisso~") COLUMN(NAME=~"app_pagamento.importo_fisso_iva~") COLUMN(NAME=~"app_pagamento.per_iva~") COLUMN(NAME=~"app_pagamento.per_imponibile~")WHERE(    EXP1 =~"~~~"app_pagamento~~~".~~~"id_con_pagamento~~~"~"   OP =~"=~"    EXP2 =~":rn_id_con_pagamento~" ) ) ORDER(NAME=~"app_pagamento.num_ordine~" ASC=yes ) ARG(NAME = ~"rn_id_con_pagamento~" TYPE = number) " update="app_pagamento" updatewhere=1 updatekeyinplace=yes arguments=(("rn_id_con_pagamento", number)) )
