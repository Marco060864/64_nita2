table(column=(type=long update=yes updatewhereclause=yes key=yes identity=yes name=id_anagrafica dbname="anagrafica.id_anagrafica" )
 column=(type=char(40) update=yes updatewhereclause=yes name=rag_soc_1 dbname="anagrafica.rag_soc_1" )
 column=(type=char(40) update=yes updatewhereclause=yes name=rag_soc_2 dbname="anagrafica.rag_soc_2" )
 column=(type=char(40) update=yes updatewhereclause=yes name=indirizzo dbname="anagrafica.indirizzo" )
 column=(type=char(10) update=yes updatewhereclause=yes name=cap dbname="anagrafica.cap" )
 column=(type=char(40) update=yes updatewhereclause=yes name=localita dbname="anagrafica.localita" )
 column=(type=char(5) update=yes updatewhereclause=yes name=provincia dbname="anagrafica.provincia" )
 column=(type=char(5) update=yes updatewhereclause=yes name=nazione dbname="anagrafica.nazione" initial="IT" )
 column=(type=char(16) update=yes updatewhereclause=yes name=cod_fiscale dbname="anagrafica.cod_fiscale" )
 column=(type=char(16) update=yes updatewhereclause=yes name=par_iva dbname="anagrafica.par_iva" )
 column=(type=long update=yes updatewhereclause=yes name=id_azienda dbname="anagrafica.id_azienda" initial="1" )
 column=(type=long update=yes updatewhereclause=yes name=id_linguaggio dbname="anagrafica.id_linguaggio" )
 column=(type=long update=yes updatewhereclause=yes name=id_valuta dbname="anagrafica.id_valuta" )
 column=(type=char(1) update=yes updatewhereclause=yes name=nat_giuridica dbname="anagrafica.nat_giuridica" initial="G" values="Persona giuridica	G/Persona fisica	F/" validation=" gettext()  = 'F' OR  gettext()  = 'G'" validationmsg="'Immettere: G, F'" )
 column=(type=char(1) updatewhereclause=yes name=prov_contabile dbname="anagrafica.prov_contabile" initial="I" values="Azienda intracomunitaria	I/Azienda extracomunitaria	E/San Marino	S/" validation=" gettext()  = 'I' OR  gettext()  = 'E' OR  gettext()  = 'S'" validationmsg="'Immettere: I, E, S'" )
 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"anagrafica~" ) COLUMN(NAME=~"anagrafica.id_anagrafica~") COLUMN(NAME=~"anagrafica.rag_soc_1~") COLUMN(NAME=~"anagrafica.rag_soc_2~") COLUMN(NAME=~"anagrafica.indirizzo~") COLUMN(NAME=~"anagrafica.cap~") COLUMN(NAME=~"anagrafica.localita~") COLUMN(NAME=~"anagrafica.provincia~") COLUMN(NAME=~"anagrafica.nazione~") COLUMN(NAME=~"anagrafica.cod_fiscale~") COLUMN(NAME=~"anagrafica.par_iva~") COLUMN(NAME=~"anagrafica.id_azienda~") COLUMN(NAME=~"anagrafica.id_linguaggio~") COLUMN(NAME=~"anagrafica.id_valuta~") COLUMN(NAME=~"anagrafica.nat_giuridica~") COLUMN(NAME=~"anagrafica.prov_contabile~")WHERE(    EXP1 =~"~~~"anagrafica~~~".~~~"id_azienda~~~"~"   OP =~"in~"    EXP2 =~"(0, 1)~" ) ) " update="anagrafica" updatewhere=1 updatekeyinplace=yes )
