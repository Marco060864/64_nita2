 column=(type=char(1) updatewhereclause=yes name=caus_magazzino_mp_val_scaricato dbname="caus_magazzino.mp_val_scaricato" values="+	+/-	-/" validation=" gettext()  = '+' OR  gettext()  = '-'" validationmsg="'Immettere: + o -'" )
 column=(type=char(1) updatewhereclause=yes name=caus_magazzino_md_val_caricato dbname="caus_magazzino.md_val_caricato" values="+	+/-	-/" validation=" gettext()  = '+' OR  gettext()  = '-'" validationmsg="'Immettere: + o -'" )
 column=(type=char(1) updatewhereclause=yes name=caus_magazzino_md_val_scaricato dbname="caus_magazzino.md_val_scaricato" values="+	+/-	-/" validation=" gettext()  = '+' OR  gettext()  = '-'" validationmsg="'Immettere: + o -'" )
 column=(type=long updatewhereclause=yes name=documento_id_registro dbname="documento.id_registro" )
 column=(type=decimal(4) updatewhereclause=yes name=peso_netto dbname="riga_documento.peso_netto" )
