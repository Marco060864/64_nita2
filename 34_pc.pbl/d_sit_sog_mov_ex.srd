 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"caus_magazzino~" )  TABLE(NAME=~"documento~" )  TABLE(NAME=~"registro~" )  TABLE(NAME=~"riga_documento~" )  TABLE(NAME=~"unita_confezione~" )  TABLE(NAME=~"valuta~" )  TABLE(NAME=~"sog_commerciale_gen~" )  TABLE(NAME=~"articolo~" ) COLUMN(NAME=~"registro.tipo_registro~") COLUMN(NAME=~"registro.id_mod_registro~") COLUMN(NAME=~"documento.num_progressivo~") COLUMN(NAME=~"documento.data_registrazione~") COLUMN(NAME=~"sog_commerciale_gen.codice~") COLUMN(NAME=~"sog_commerciale_gen.rag_soc_1~") COLUMN(NAME=~"riga_documento.quantita~") COLUMN(NAME=~"riga_documento.qta_sconto_merce~") COLUMN(NAME=~"unita_confezione.codice~") COLUMN(NAME=~"riga_documento.tot_riga_val_riga~") COLUMN(NAME=~"valuta.descrizione~") COLUMN(NAME=~"caus_magazzino.codice~") COLUMN(NAME=~"registro.numero~") COLUMN(NAME=~"caus_magazzino.mp_val_caricato~") COLUMN(NAME=~"caus_magazzino.mp_val_scaricato~") COLUMN(NAME=~"caus_magazzino.md_val_caricato~") COLUMN(NAME=~"caus_magazzino.md_val_scaricato~") COLUMN(NAME=~"documento.id_registro~") COLUMN(NAME=~"riga_documento.peso_netto~") COLUMN(NAME=~"articolo.codice~") COLUMN(NAME=~"articolo.descrizione~")    JOIN (LEFT=~"registro.id_registro~"    OP =~"=~"RIGHT=~"documento.id_registro~" )    JOIN (LEFT=~"riga_documento.id_documento~"    OP =~"=~"RIGHT=~"documento.id_documento~" )    JOIN (LEFT=~"riga_documento.id_caus_magazzino~"    OP =~"=~"RIGHT=~"caus_magazzino.id_caus_magazzino~" )    JOIN (LEFT=~"unita_confezione.id_unita_confezione~"    OP =~"=~"RIGHT=~"riga_documento.id_unita_confezione~" )    JOIN (LEFT=~"valuta.id_valuta~"    OP =~"=~"RIGHT=~"riga_documento.id_valuta~" )    JOIN (LEFT=~"documento.id_sog_commerciale~"    OP =~"=~"RIGHT=~"sog_commerciale_gen.id_sog_commerciale~" )    JOIN (LEFT=~"riga_documento.id_articolo~"    OP =~"=~"RIGHT=~"articolo.id_articolo~" )WHERE(    EXP1 =~"( ~~~"documento~~~".~~~"id_sog_commerciale~~~"~"   OP =~"=~"    EXP2 =~":rd_sog )~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"( ~~~"documento~~~".~~~"data_registrazione~~~"~"   OP =~"<=~"    EXP2 =~":rd_a_data )~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"( ~~~"documento~~~".~~~"data_registrazione~~~"~"   OP =~">=~"    EXP2 =~":rd_da_data )~" ) ) ARG(NAME = ~"rd_sog~" TYPE = number)  ARG(NAME = ~"rd_da_data~" TYPE = date)  ARG(NAME = ~"rd_a_data~" TYPE = date) " arguments=(("rd_sog", number),("rd_da_data", date),("rd_a_data", date)) )
