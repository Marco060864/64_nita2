 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"spesa_sog_commerciale~" )  TABLE(NAME=~"spesa~" )  TABLE(NAME=~"sog_commerciale~" )  TABLE(NAME=~"anagrafica~" ) COLUMN(NAME=~"spesa_sog_commerciale.id_sog_commerciale~") COLUMN(NAME=~"spesa_sog_commerciale.id_spesa~") COLUMN(NAME=~"spesa_sog_commerciale.da_imponibile~") COLUMN(NAME=~"spesa_sog_commerciale.a_imponibile~") COLUMN(NAME=~"spesa_sog_commerciale.percentuale~") COLUMN(NAME=~"spesa_sog_commerciale.id_azienda~") COLUMN(NAME=~"spesa_sog_commerciale.app_rateale~") COLUMN(NAME=~"spesa.codice~") COLUMN(NAME=~"spesa.tipo_importo~") COMPUTE(NAME=~"CAST(~~~"spesa~~~".~~~"tipo_importo~~~" AS CHAR(1) ) AS c_tipo_importo~") COLUMN(NAME=~"spesa_sog_commerciale.importo~") COLUMN(NAME=~"anagrafica.id_valuta~")    JOIN (LEFT=~"spesa.id_spesa~"    OP =~"=~"RIGHT=~"spesa_sog_commerciale.id_spesa~" )    JOIN (LEFT=~"sog_commerciale.id_sog_commerciale~"    OP =~"=~"RIGHT=~"spesa_sog_commerciale.id_sog_commerciale~" )    JOIN (LEFT=~"anagrafica.id_anagrafica~"    OP =~"=~"RIGHT=~"sog_commerciale.id_anagrafica~" )WHERE(    EXP1 =~"~~~"spesa_sog_commerciale~~~".~~~"id_sog_commerciale~~~"~"   OP =~"=~"    EXP2 =~":ri_id_sog_commerciale~" ) ) ORDER(NAME=~"spesa.codice~" ASC=yes ) ARG(NAME = ~"ri_id_sog_commerciale~" TYPE = number) " update="spesa_sog_commerciale" updatewhere=1 updatekeyinplace=yes arguments=(("ri_id_sog_commerciale", number)) )
