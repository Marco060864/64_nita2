E=~"destinazione.id_gruppo_agenti_2~") COLUMN(NAME=~"gruppo_agenti_b.codice~") COLUMN(NAME=~"gruppo_agenti_b.descrizione~") COLUMN(NAME=~"sog_commerciale_gen_a.id_sog_commerciale~") COLUMN(NAME=~"sog_commerciale_gen_b.id_sog_commerciale~") COLUMN(NAME=~"sog_commerciale_gen_c.id_sog_commerciale~") COLUMN(NAME=~"sog_commerciale_gen_d.id_sog_commerciale~") COLUMN(NAME=~"sog_commerciale_gen_d.codice~") COLUMN(NAME=~"sog_commerciale_gen_d.rag_soc_1~") COLUMN(NAME=~"sog_commerciale_gen_e.id_sog_commerciale~") COLUMN(NAME=~"sog_commerciale_gen_e.codice~") COLUMN(NAME=~"sog_commerciale_gen_e.rag_soc_1~") COLUMN(NAME=~"sog_commerciale_gen_f.id_sog_commerciale~") COLUMN(NAME=~"sog_commerciale_gen_f.codice~") COLUMN(NAME=~"sog_commerciale_gen_f.rag_soc_1~") COLUMN(NAME=~"destinazione.id_con_pagamento~") COLUMN(NAME=~"con_pagamento.codice~") COLUMN(NAME=~"con_pagamento.descrizione~") COLUMN(NAME=~"destinazione.codice~") COLUMN(NAME=~"destinazione.ins_automatico_in_doc~")    JOIN (LEFT=~"gruppo_agenti_a.id_gruppo_agenti~"    OP =~"=~"RIGHT=~"destinazione.id_gruppo_agenti~"    OUTER2 =~"destinazione.id_gruppo_agenti~" )    JOIN (LEFT=~"gruppo_agenti_a.id_sog_com_capo_area~"    OP =~"=~"RIGHT=~"sog_commerciale_gen_a.id_sog_commerciale~"    OUTER1 =~"gruppo_agenti_a.id_sog_com_capo_area~" )    JOIN (LEFT=~"gruppo_agenti_a.id_sog_com_agente~"    OP =~"=~"RIGHT=~"sog_commerciale_gen_b.id_sog_commerciale~"    OUTER1 =~"gruppo_agenti_a.id_sog_com_agente~" )    JOIN (LEFT=~"sog_commerciale_gen_c.id_sog_commerciale~"    OP =~"=~"RIGHT=~"gruppo_agenti_a.id_sog_com_sub_agente~"    OUTER2 =~"gruppo_agenti_a.id_sog_com_sub_agente~" )    JOIN (LEFT=~"locazione.id_magazzino~"    OP =~"=~"RIGHT=~"magazzino.id_magazzino~"    OUTER1 =~"locazione.id_magazzino~" )    JOIN (LEFT=~"locazione.id_locazione~"    OP =~"=~"RIGHT=~"destinazione.id_magazzino~"    OUTER2 =~"destinazione.id_magazzino~" )    JOIN (LEFT=~"gruppo_agenti_b.id_gruppo_agenti~"    OP =~"=~"RIGHT=~"destinazione.id_gruppo_agenti_2~"  