 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"anagrafica~" )  TABLE(NAME=~"sog_commerciale~" )  TABLE(NAME=~"valuta~" ) COLUMN(NAME=~"sog_commerciale.id_sog_commerciale~") COLUMN(NAME=~"sog_commerciale.tipo~") COLUMN(NAME=~"sog_commerciale.codice~") COLUMN(NAME=~"sog_commerciale.id_anagrafica~") COLUMN(NAME=~"sog_commerciale.id_conto~") COLUMN(NAME=~"sog_commerciale.data_acquisizione~") COLUMN(NAME=~"sog_commerciale.ns_cod_soggetto~") COLUMN(NAME=~"sog_commerciale.id_linguaggio~") COLUMN(NAME=~"sog_commerciale.id_cat_attivita~") COLUMN(NAME=~"sog_commerciale.id_cat_com_sc~") COLUMN(NAME=~"sog_commerciale.id_cat_zona~") COLUMN(NAME=~"sog_commerciale.id_magazzino~") COLUMN(NAME=~"sog_commerciale.fido~") COLUMN(NAME=~"sog_commerciale.extrafido~") COLUMN(NAME=~"sog_commerciale.con_fido~") COLUMN(NAME=~"sog_commerciale.id_con_pagamento~") COLUMN(NAME=~"sog_commerciale.data_dec_pagamenti~") COLUMN(NAME=~"sog_commerciale.giorno_fisso_pagamenti~") COLUMN(NAME=~"sog_commerciale.id_listino~") COLUMN(NAME=~"sog_commerciale.id_gruppo_agenti~") COLUMN(NAME=~"sog_commerciale.id_tipo_trasporto~") COLUMN(NAME=~"sog_commerciale.id_sog_com_vettore~") COLUMN(NAME=~"sog_commerciale.per_fatturazione~") COLUMN(NAME=~"sog_commerciale.modo_fatturazione~") COLUMN(NAME=~"sog_commerciale.con_fattura~") COLUMN(NAME=~"sog_commerciale.fat_sos_iva~") COLUMN(NAME=~"sog_commerciale.id_tab_iva~") COLUMN(NAME=~"sog_commerciale.num_ns_prot_documenti~") COLUMN(NAME=~"sog_commerciale.data_ns_prot_documenti~") COLUMN(NAME=~"sog_commerciale.num_lr_prot_documenti~") COLUMN(NAME=~"sog_commerciale.data_lr_prot_documenti~") COLUMN(NAME=~"sog_commerciale.uff_iva~") COLUMN(NAME=~"sog_commerciale.id_prof_registrazione~") COLUMN(NAME=~"sog_commerciale.id_tributo~") COLUMN(NAME=~"sog_commerciale.id_att_svolta~") COLUMN(NAME=~"sog_commerciale.id_azienda~") COLUMN(NAME=~"anagrafica.rag_soc_1~") COMPUTE(NAME=~"if ~~~"sog_commerciale~~~".~~~"tipo~~~" = 'C'  OR  ~~~"sog_commerciale~~~".~~~"tipo~~~" = 'F' THEN 'S' ELSE if ~~~"sog_commerciale~~~".~~~"tipo~~~" = 'P'  OR  ~~~"sog_commerciale~~~".~~~"tipo~~~" = 'Z' THEN 'N' ELSE ifnull (~~~"sog_commerciale~~~".~~~"id_conto~~~", 'N','S') ENDIF ENDIF~") COMPUTE(NAME=~"' ' As c_magazzino_des~") COMPUTE(NAME=~"' ' As c_agente_cod~") COMPUTE(NAME=~"' ' As c_agente_des~") COMPUTE(NAME=~"' ' As c_vettore_cod~") COMPUTE(NAME=~"' ' As c_vettore_des~") COMPUTE(NAME=~"' ' As c_magazzino_cod~") COLUMN(NAME=~"sog_commerciale.data_trasformazione~") COLUMN(NAME=~"sog_commerciale.id_banca_sog_commerciale~") COMPUTE(NAME=~"cast('' as char(83)) As c_abi_cab_des~") COMPUTE(NAME=~"cast('' as char(1)) As c_cin~") COMPUTE(NAME=~"cast('' as char(20)) As c_conto_corrente~") COLUMN(NAME=~"sog_commerciale.scad_raggruppate~") COMPUTE(NAME=~"cast('' as char(1)) As info~") COLUMN(NAME=~"sog_commerciale.id_tipo_agente~") COLUMN(NAME=~"sog_commerciale.imp_fisso~") COLUMN(NAME=~"sog_commerciale.id_valuta~") COLUMN(NAME=~"sog_commerciale.giorni_franchigia~") COLUMN(NAME=~"sog_commerciale.id_val_prov_agente~") COLUMN(NAME=~"valuta.codice~") COLUMN(NAME=~"valuta.descrizione~") COMPUTE(NAME=~"cast('S' as char(1)) As crea_agenti~") COLUMN(NAME=~"sog_commerciale.crea_gruppo_agenti~") COMPUTE(NAME=~"cast('' as integer) As sm~")    JOIN (LEFT=~"anagrafica.id_anagrafica~"    OP =~"=~"RIGHT=~"sog_commerciale.id_anagrafica~"    OUTER1 =~"anagrafica.id_anagrafica~" )    JOIN (LEFT=~"valuta.id_valuta~"    OP =~"=~"RIGHT=~"sog_commerciale.id_val_prov_agente~"    OUTER2 =~"sog_commerciale.id_val_prov_agente~" )) " )
