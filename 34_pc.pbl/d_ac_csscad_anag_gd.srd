 column=(type=decimal(0) update=yes updatewhereclause=yes name=mese_inizio_periodo dbname="con_spec_scadenza.mese_inizio_periodo" validation=" real(gettext())  >= 1 AND  real(gettext())  <= 12" validationmsg="'Immettere un mese (fra 1 e 12)'" )
 column=(type=decimal(0) update=yes updatewhereclause=yes name=giorno_fine_periodo dbname="con_spec_scadenza.giorno_fine_periodo" validation=" real(gettext())  >= 1 AND  real(gettext())  <= 31" validationmsg="'Immettere un giorno (fra 1 e 31)'" )
