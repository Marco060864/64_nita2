 column=(type=long update=yes updatewhereclause=yes name=id_azienda dbname="con_spec_scadenza.id_azienda" initial="1" )
 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"con_spec_scadenza~" ) COLUMN(NAME=~"con_spec_scadenza.id_con_spec_scadenza~") COLUMN(NAME=~"con_spec_scadenza.id_anagrafica~") COLUMN(NAME=~"con_spec_scadenza.giorno_inizio_periodo~") COLUMN(NAME=~"con_spec_scadenza.mese_inizio_periodo~") COLUMN(NAME=~"con_spec_scadenza.giorno_fine_periodo~") COLUMN(NAME=~"con_spec_scadenza.mese_fine_periodo~") COLUMN(NAME=~"con_spec_scadenza.descrizione~") COLUMN(NAME=~"con_spec_scadenza.giorno_applicazione~") COLUMN(NAME=~"con_spec_scadenza.mese_applicazione~") COLUMN(NAME=~"con_spec_scadenza.id_azienda~")WHERE(    EXP1 =~"~~~"con_spec_scadenza~~~".~~~"id_anagrafica~~~"~"   OP =~"=~"    EXP2 =~":rn_id_anagrafica~" ) ) ARG(NAME = ~"rn_id_anagrafica~" TYPE = number) " update="con_spec_scadenza" updatewhere=1 updatekeyinplace=yes arguments=(("rn_id_anagrafica", number)) )
