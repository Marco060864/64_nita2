table(column=(type=long update=yes updatewhereclause=yes key=yes identity=yes name=id_con_spec_scadenza dbname="con_spec_scadenza.id_con_spec_scadenza" )
 column=(type=long update=yes updatewhereclause=yes name=id_anagrafica dbname="con_spec_scadenza.id_anagrafica" )
