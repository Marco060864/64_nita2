 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"banca_sog_commerciale~" )  TABLE(NAME=~"banca_appoggio~" ) COLUMN(NAME=~"banca_sog_commerciale.id_banca_sog_commerciale~") COLUMN(NAME=~"banca_sog_commerciale.id_anagrafica~") COLUMN(NAME=~"banca_sog_commerciale.id_banca_appoggio~") COLUMN(NAME=~"banca_sog_commerciale.conto_corrente~") COLUMN(NAME=~"banca_sog_commerciale.cin~") COLUMN(NAME=~"banca_sog_commerciale.modo_uso~") COLUMN(NAME=~"banca_sog_commerciale.id_azienda~") COMPUTE(NAME=~"~~~"banca_appoggio~~~".~~~"cod_abi~~~"+'-'+~~~"banca_appoggio~~~".~~~"cod_cab~~~"+'-'+~~~"banca_appoggio~~~".~~~"den_abi~~~" + ' - ' +~~~"banca_appoggio~~~".~~~"den_cab~~~" As c_den_abi_cab~") COLUMN(NAME=~"banca_sog_commerciale.iban_nazione~") COLUMN(NAME=~"banca_sog_commerciale.iban_contr_internazionale~") COLUMN(NAME=~"banca_sog_commerciale.swift~")    JOIN (LEFT=~"banca_sog_commerciale.id_banca_appoggio~"    OP =~"=~"RIGHT=~"banca_appoggio.id_banca_appoggio~"    OUTER1 =~"banca_sog_commerciale.id_banca_appoggio~" )WHERE(    EXP1 =~"~~~"banca_sog_commerciale~~~".~~~"id_anagrafica~~~"~"   OP =~"=~"    EXP2 =~":ri_id_anagrafica~" ) ) ARG(NAME = ~"ri_id_anagrafica~" TYPE = number) " update="banca_sog_commerciale" updatewhere=1 updatekeyinplace=yes arguments=(("ri_id_anagrafica", number)) )
