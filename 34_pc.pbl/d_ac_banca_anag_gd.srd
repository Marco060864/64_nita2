table(column=(type=long update=yes updatewhereclause=yes key=yes identity=yes name=id_banca_sog_comme dbname="banca_sog_commerciale.id_banca_sog_commerciale" dbalias=".id_banca_sog_commerciale" )
 column=(type=long update=yes updatewhereclause=yes name=id_anagrafica dbname="banca_sog_commerciale.id_anagrafica" dbalias=".id_anagrafica" )
 column=(type=long update=yes updatewhereclause=yes name=id_banca_appoggio dbname="banca_sog_commerciale.id_banca_appoggio" dbalias=".id_banca_appoggio" )
 column=(type=char(20) update=yes updatewhereclause=yes name=conto_corrente dbname="banca_sog_commerciale.conto_corrente" dbalias=".conto_corrente" )
 column=(type=char(1) update=yes updatewhereclause=yes name=cin dbname="banca_sog_commerciale.cin" dbalias=".cin" )
 column=(type=char(1) update=yes updatewhereclause=yes name=modo_uso dbname="banca_sog_commerciale.modo_uso" dbalias=".modo_uso" values="Del soggetto	S/Nostra	N/" validation=" gettext()  = 'S' OR  gettext()  = 'N'" validationmsg="'Immettere: S, N'" )
 column=(type=long update=yes updatewhereclause=yes name=id_azienda dbname="banca_sog_commerciale.id_azienda" dbalias=".id_azienda" initial="1" )
 column=(type=char(95) updatewhereclause=yes name=cc_den_abi_cab dbname="c_den_abi_cab" )
