//objectcomments DW LT Completa Soggetti Commerciali Cometa
release 5;
datawindow(units=0 timer_interval=0 color=79741120 processing=1 print.documentname="" print.orientation = 0 print.margin.left = 110 print.margin.right = 110 print.margin.top = 97 print.margin.bottom = 97 print.paper.source = 0 print.paper.size = 0 print.prompt=no grid.lines=0 selected.mouse=no )
header(height=141 color="536870912" )
summary(height=1 color="536870912" )
footer(height=1 color="536870912" )
detail(height=73 color="553648127" )
table(column=(type=char(8) update=yes updatewhereclause=yes name=sog_commerciale_codice dbname="codice" )
 column=(type=char(40) updatewhereclause=yes name=anagrafica_rag_soc_1 dbname="rag_soc_1" )
 column=(type=char(16) updatewhereclause=yes name=anagrafica_cod_fiscale dbname="cod_fiscale" )
 column=(type=char(16) updatewhereclause=yes name=anagrafica_par_iva dbname="par_iva" )
 column=(type=char(1) update=yes updatewhereclause=yes name=sog_commerciale_tipo dbname="tipo" values="Cliente	C/Fornitore	F/Agente	A/Vettore	V/Altro	Z/Cliente potenziale	P/" validation=" gettext()  = 'C' OR  gettext()  = 'F' OR  gettext()  = 'A' OR  gettext()  = 'V' OR  gettext()  = 'Z' OR  gettext()  = 'P'" validationmsg="'Inserire: C, F, A, V, P, Z'" )
 column=(type=date update=yes updatewhereclause=yes name=sog_commerciale_data_acquisizione dbname="data_acquisizione" )
 column=(type=char(20) update=yes updatewhereclause=yes name=sog_commerciale_ns_cod_soggetto dbname="ns_cod_soggetto" )
 column=(type=char(4) updatewhereclause=yes name=cat_attivita_codice dbname="codice" )
 column=(type=char(4) updatewhereclause=yes name=cat_com_sc_codice dbname="codice" )
 column=(type=char(4) updatewhereclause=yes name=cat_zona_codice dbname="codice" )
 column=(type=long updatewhereclause=yes key=yes identity=yes name=id_sog_commerciale dbname="id_sog_commerciale" )
 column=(type=long update=yes updatewhereclause=yes name=sog_commerciale_id_azienda dbname="id_azienda" initial="1" )
 column=(type=long updatewhereclause=yes name=id_anagrafica dbname="id_anagrafica" )
 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"anagrafica~" )  TABLE(NAME=~"cat_attivita~" )  TABLE(NAME=~"cat_com_sc~" )  TABLE(NAME=~"cat_zona~" )  TABLE(NAME=~"sog_commerciale~" ) COLUMN(NAME=~"sog_commerciale.codice~") COLUMN(NAME=~"anagrafica.rag_soc_1~") COLUMN(NAME=~"anagrafica.cod_fiscale~") COLUMN(NAME=~"anagrafica.par_iva~") COLUMN(NAME=~"sog_commerciale.tipo~") COLUMN(NAME=~"sog_commerciale.data_acquisizione~") COLUMN(NAME=~"sog_commerciale.ns_cod_soggetto~") COLUMN(NAME=~"cat_attivita.codice~") COLUMN(NAME=~"cat_com_sc.codice~") COLUMN(NAME=~"cat_zona.codice~") COLUMN(NAME=~"sog_commerciale.id_sog_commerciale~") COLUMN(NAME=~"sog_commerciale.id_azienda~") COLUMN(NAME=~"sog_commerciale.id_anagrafica~")    JOIN (LEFT=~"sog_commerciale.id_cat_zona~"    OP =~"=~"RIGHT=~"cat_zona.id_cat_zona~"    OUTER1 =~"sog_commerciale.id_cat_zona~" )    JOIN (LEFT=~"sog_commerciale.id_cat_com_sc~"    OP =~"=~"RIGHT=~"cat_com_sc.id_cat_com_sc~"    OUTER1 =~"sog_commerciale.id_cat_com_sc~" )    JOIN (LEFT=~"sog_commerciale.id_cat_attivita~"    OP =~"=~"RIGHT=~"cat_attivita.id_cat_attivita~"    OUTER1 =~"sog_commerciale.id_cat_attivita~" )    JOIN (LEFT=~"sog_commerciale.id_anagrafica~"    OP =~"=~"RIGHT=~"anagrafica.id_anagrafica~" )WHERE(    EXP1 =~"~~~"sog_commerciale~~~".~~~"id_azienda~~~"~"   OP =~"in~"    EXP2 =~"(0, 1)~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"sog_commerciale~~~".~~~"id_anagrafica~~~"~"   OP =~"=~"    EXP2 =~":ra_id_anagrafica~" ) ) ORDER(NAME=~"anagrafica.rag_soc_1~" ASC=yes ) ARG(NAME = ~"ra_id_anagrafica~" TYPE = number) " update="sog_commerciale" updatewhere=0 updatekeyinplace=yes arguments=(("ra_id_anagrafica", number)) )
