table(column=(type=long update=yes updatewhereclause=yes key=yes identity=yes name=id_con_pagamento dbname="con_pagamento.id_con_pagamento" )
 column=(type=char(8) update=yes updatewhereclause=yes name=codice dbname="con_pagamento.codice" )
 column=(type=char(40) update=yes updatewhereclause=yes name=descrizione dbname="con_pagamento.descrizione" )
 column=(type=decimal(2) update=yes updatewhereclause=yes name=sconto_cassa dbname="con_pagamento.sconto_cassa" validation=" real(gettext())  >= 0 AND  real(gettext())  <= 100" validationmsg="'Immettere un valore fra 0 e 100'" )
 column=(type=char(4) update=yes updatewhereclause=yes name=tipo_pagamento dbname="con_pagamento.tipo_pagamento" values="Pag. a RATE	TP01/Pag. Completo	TP02/Anticipo	TP03/" )
 column=(type=char(4) update=yes updatewhereclause=yes name=mod_pagamento dbname="con_pagamento.mod_pagamento" values="MP01 Contanti	MP01/MP02 Assegno	MP02/MP03 Ass. Circolare	MP03/MP04 Contanti Tesoreria	MP04/MP05 Bonifico	MP05/MP06 Vaglia Bancario	MP06/MP07 Bollettino Bancario	MP07/MP08 Carta di Pagamento	MP08/MP09 RID	MP09/MP10 RID utenze	MP10/MP11 RID veloce	MP11/MP12 RIBA	MP12/MP13 MAV	MP13/MP14 Quietanza Erario	MP14/MP15 Giroconto Cont. Speciale	MP15/MP16 Domiciliazione bancaria	MP16/MP17 Domiciliazione postale	MP17/MP18 Bollettino C//C postale	MP18/MP19 SEPA direct debit	MP19/MP20 SEPA d.d. CORE	MP20/MP21 SEPA d.d. B2B	MP21/MP22 Trattenuta su somme già riscosse	MP22/MP23 Pago PA	MP23/" )
 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"con_pagamento~" ) COLUMN(NAME=~"con_pagamento.id_con_pagamento~") COLUMN(NAME=~"con_pagamento.codice~") COLUMN(NAME=~"con_pagamento.descrizione~") COLUMN(NAME=~"con_pagamento.sconto_cassa~") COLUMN(NAME=~"con_pagamento.tipo_pagamento~") COLUMN(NAME=~"con_pagamento.mod_pagamento~")) ORDER(NAME=~"con_pagamento.codice~" ASC=yes ) " update="con_pagamento" updatewhere=1 updatekeyinplace=yes )
