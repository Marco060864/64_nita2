 column=(type=decimal(0) updatewhereclause=yes name=fido dbname="fido" validation=" real(gettext())  >= 0" validationmsg="'Immettere un valore >= 0'" )
 column=(type=decimal(0) updatewhereclause=yes name=extrafido dbname="extrafido" validation=" real(gettext())  >= 0" validationmsg="'Immettere un valore >= 0'" )
 column=(type=char(1) updatewhereclause=yes name=con_fido dbname="con_fido" initial="N" values="Nessun controllo	N/Solo controllo	C/Controllo e blocco	B/Blocco incondizionato	X/" validation=" gettext()  = 'N' OR  gettext()  = 'C' OR  gettext()  = 'B' OR  gettext()  = 'X'" validationmsg="'Immettere: N, C, B, S'" )
 column=(type=long updatewhereclause=yes name=id_con_pagamento dbname="id_con_pagamento" )
 column=(type=char(1) updatewhereclause=yes name=data_dec_pagamenti dbname="data_dec_pagamenti" values="Fine mese	F/Data fattura	D/" validation=" gettext()  = 'F' OR  gettext()  = 'D'" validationmsg="'Immettere: F, D'" )
 column=(type=decimal(0) updatewhereclause=yes name=giorno_fisso_pagamenti dbname="giorno_fisso_pagamenti" validation=" real(gettext())  >= 1 AND  real(gettext())  <= 31" validationmsg="'Immettere un giorno (fra 1 e 31)'" )
 column=(type=long updatewhereclause=yes name=id_listino dbname="id_listino" )
 column=(type=long updatewhereclause=yes name=sog_commerciale_id_gruppo_agenti dbname="id_gruppo_agenti" )
