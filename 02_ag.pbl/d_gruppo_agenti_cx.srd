 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"gruppo_agenti~" ) COLUMN(NAME=~"gruppo_agenti.codice~") COLUMN(NAME=~"gruppo_agenti.descrizione~") COLUMN(NAME=~"gruppo_agenti.id_sog_com_capo_area~") COLUMN(NAME=~"gruppo_agenti.id_sog_com_agente~") COLUMN(NAME=~"gruppo_agenti.id_sog_com_sub_agente~") COLUMN(NAME=~"gruppo_agenti.id_gruppo_agenti~") COLUMN(NAME=~"gruppo_agenti.id_azienda~") COMPUTE(NAME=~"cast('' as char(8)) As c_capo_area_cod~") COMPUTE(NAME=~"cast('' as char(40)) As c_capo_area_rag_soc~") COMPUTE(NAME=~"cast('' as char(8)) As c_agente_cod~") COMPUTE(NAME=~"cast('' as char(40)) As c_agente_rag_soc~") COMPUTE(NAME=~"cast('' as char(8)) As c_subagente_cod~") COMPUTE(NAME=~"cast('' as char(40)) As c_subagente_rag_soc~") COLUMN(NAME=~"gruppo_agenti.sconto_riga~") COLUMN(NAME=~"gruppo_agenti.sconto_finanziario~") COLUMN(NAME=~"gruppo_agenti.sconto_fin_cassa~") COLUMN(NAME=~"gruppo_agenti.sconto_fin_incondizionato~") COLUMN(NAME=~"gruppo_agenti.rip_per_fatturato~") COLUMN(NAME=~"gruppo_agenti.rip_per_incassato~") COLUMN(NAME=~"gruppo_agenti.mod_liq_provvigione~")WHERE(    EXP1 =~"~~~"gruppo_agenti~~~".~~~"id_azienda~~~"~"   OP =~"in~"    EXP2 =~"(0,1)~" ) ) " update="gruppo_agenti" updatewhere=1 updatekeyinplace=yes )
