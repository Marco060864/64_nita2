compute(band=trailer.1 alignment="0" expression=" sog_commerciale_codice "border="0" color="0" x="0" y="4" height="76" width="393" format="[general]"  font.face="Arial" font.height="-8" font.weight="400"  font.family="2" font.pitch="2" font.charset="0" background.mode="2" background.color="16777215" )
compute(band=trailer.1 alignment="0" expression=" riga_documento_provv_carea "border="0" color="0" x="402" y="4" height="76" width="375" format="[general]"  name=provv_tot  font.face="Arial" font.height="-8" font.weight="400"  font.family="2" font.pitch="2" font.charset="0" background.mode="2" background.color="16777215" )
compute(band=trailer.1 alignment="1" expression="//BL#12501#
// Sconto Finanziario Cassa - Percentuale di sconto

imp_provv_tot_b -
if( gruppo_agenti_sconto_fin_cassa ='S' ,  
    ( imp_provv_tot_b  *       
      if( documento_sconto_fin_cassa > 0, documento_sconto_fin_cassa / 100 , 0) 
     )  , 
0 )
"border="0" color="0" x="1481" y="176" height="72" width="453" format="#,0.0000"  name=imp_provv_tot  font.face="Arial" font.height="-8" font.weight="400"  font.family="2" font.pitch="2" font.charset="0" background.mode="2" background.color="16777215" )
text(band=trailer.1 alignment="0" text="- Sconto Finanziario Cassa"border="0" color="0" x="1961" y="180" height="72" width="795"  font.face="Arial" font.height="-8" font.weight="400"  font.family="2" font.pitch="2" font.charset="0" background.mode="1" background.color="553648127" )
compute(band=trailer.1 alignment="1" expression="//BL#12501#
sum( imp_provv  for group 1)"border="0" color="0" x="1481" y="4" height="72" width="453" format="#,0.0000"  name=imp_provv_tot_a  font.face="Arial" font.height="-8" font.weight="400"  font.family="2" font.pitch="2" font.charset="0" background.mode="2" background.color="16777215" )
text(band=trailer.1 alignment="0" text="- Sconto Riga"border="0" color="0" x="1961" y="4" height="72" width="393"  font.face="Arial" font.height="-8" font.weight="400"  font.family="2" font.pitch="2" font.charset="0" background.mode="1" background.color="553648127" )
compute(band=trailer.1 alignment="1" expression="//BL#12501# - Applico gli sconti a livello di documento, nell'importo totale
// Sconto Finanziario - percentuali composte
if( gruppo_agenti_sconto_finanziario ='S', f_prezzo_sconto_comp( documento_sconto_finanziario ,  imp_provv_tot_a ), imp_provv_tot_a )
 - 
// Sconto Finanziario Incondizionato - Importo
if ( gruppo_agenti_sconto_fin_incondizionato ='S',    
     if ( documento_sconto_fin_incondizionato > 0, 
        ( documento_sconto_fin_incondizionato * valuta_cambio_b ) , 
          0) , 
     0)"border="0" color="0" x="1481" y="88" height="72" width="453" format="#,0.0000"  name=imp_provv_tot_b  font.face="Arial" font.height="-8" font.weight="400"  font.family="2" font.pitch="2" font.charset="0" background.mode="2" background.color="16777215" )
