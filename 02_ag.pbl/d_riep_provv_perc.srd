compute(band=detail alignment="1" expression="// BL#12501# Se lo sconto riga è da detrarre prendo il prezzo netto altrimenti il prezzo lordo
(( (
if(  gruppo_agenti_sconto_riga ='S',  riga_documento_prezzo_netto , riga_documento_prezzo ) ) )  * 
if( tipo ='P',  riga_documento_peso_netto ,riga_documento_quantita) ) 
/*
(( (riga_documento_prezzo * valuta_cambio_a ) - (  prezzo_s_riga + prezzo_s_finanziario + prezzo_s_cassa )) * 
if( tipo ='P',  riga_documento_peso_netto ,riga_documento_quantita) ) 
- prezzo_s_inc 
*/"border="0" color="0" x="1481" y="0" height="72" width="453" format="#,0.0000"  name=imp_provv  font.face="Arial" font.height="-8" font.weight="400"  font.family="2" font.pitch="2" font.charset="0" background.mode="2" background.color="1090519039" )
compute(band=detail alignment="1" expression="if(  gruppo_agenti_sconto_riga ='S', f_string_dec_prezzo(  riga_documento_sconto ,(riga_documento_prezzo* valuta_cambio_a ) ) - (riga_documento_prezzo* valuta_cambio_a ) ,0)"border="0" color="0" x="1929" y="0" height="72" width="421" format="#,0.000"  name=prezzo_s_riga  font.face="Arial" font.height="-8" font.weight="400"  font.family="2" font.pitch="2" font.charset="0" background.mode="2" background.color="1090519039" )
