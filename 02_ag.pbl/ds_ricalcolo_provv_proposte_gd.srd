 retrieve="PBSELECT( VERSION(400) DISTINCT ()TABLE(NAME=~"documento~" )  TABLE(NAME=~"riga_documento~" )  TABLE(NAME=~"registro~" )  TABLE(NAME=~"prof_documento~" )  TABLE(NAME=~"sog_commerciale_gen~" ) COLUMN(NAME=~"riga_documento.id_riga_documento~") COLUMN(NAME=~"documento.id_documento~") COLUMN(NAME=~"riga_documento.provv_agente~") COLUMN(NAME=~"riga_documento.provv_subage~") COLUMN(NAME=~"riga_documento.provv_carea~") COLUMN(NAME=~"riga_documento.provv_imp_agente~") COLUMN(NAME=~"riga_documento.provv_imp_subage~") COLUMN(NAME=~"riga_documento.provv_imp_carea~") COLUMN(NAME=~"riga_documento.provv_agente_2~") COLUMN(NAME=~"riga_documento.provv_subage_2~") COLUMN(NAME=~"riga_documento.provv_carea_2~") COLUMN(NAME=~"riga_documento.provv_imp_agente_2~") COLUMN(NAME=~"riga_documento.provv_imp_subage_2~") COLUMN(NAME=~"riga_documento.provv_imp_carea_2~") COLUMN(NAME=~"riga_documento.id_gruppo_agenti~") COLUMN(NAME=~"riga_documento.id_gruppo_agenti_2~") COLUMN(NAME=~"riga_documento.id_articolo~") COLUMN(NAME=~"riga_documento.id_unita_confezione~") COLUMN(NAME=~"riga_documento.sconto~") COLUMN(NAME=~"riga_documento.sconto_riga~") COLUMN(NAME=~"riga_documento.id_con_lis_articolo~") COLUMN(NAME=~"documento.data_registrazione~") COLUMN(NAME=~"documento.num_progressivo~") COLUMN(NAME=~"riga_documento.id_valuta~") COLUMN(NAME=~"documento.id_sog_commerciale~") COLUMN(NAME=~"prof_documento.codice~") COLUMN(NAME=~"sog_commerciale_gen.codice~") COLUMN(NAME=~"sog_commerciale_gen.rag_soc_1~") COMPUTE(NAME=~"CAST('S' AS CHAR(1)) AS selezionato~") COLUMN(NAME=~"riga_documento.num_riga~")    JOIN (LEFT=~"riga_documento.id_documento~"    OP =~"=~"RIGHT=~"documento.id_documento~" )    JOIN (LEFT=~"registro.id_registro~"    OP =~"=~"RIGHT=~"documento.id_registro~" )    JOIN (LEFT=~"prof_documento.id_prof_documento~"    OP =~"=~"RIGHT=~"documento.id_prof_documento~" )    JOIN (LEFT=~"sog_commerciale_gen.id_sog_commerciale~"    OP =~"=~"RIGHT=~"documento.id_sog_commerciale~" )WHERE(    EXP1 =~"~~~"registro~~~".~~~"tipo_registro~~~"~"   OP =~"=~"    EXP2 =~"'IV'~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"( ~~~"riga_documento~~~".~~~"id_gruppo_agenti~~~"~"   OP =~">~"    EXP2 =~"0~"    LOGIC =~"or~" ) WHERE(    EXP1 =~"~~~"riga_documento~~~".~~~"id_gruppo_agenti_2~~~"~"   OP =~">~"    EXP2 =~"0 )~" ) ) " update="riga_documento" updatewhere=1 updatekeyinplace=yes )
