 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"scag_provvigione~" ) COLUMN(NAME=~"scag_provvigione.da_per_sconto~") COLUMN(NAME=~"scag_provvigione.a_per_sconto~") COLUMN(NAME=~"scag_provvigione.tipo_applicazione~") COLUMN(NAME=~"scag_provvigione.id_valuta~") COLUMN(NAME=~"scag_provvigione.per_prov_capo_area~") COLUMN(NAME=~"scag_provvigione.imp_prov_capo_area~") COLUMN(NAME=~"scag_provvigione.per_prov_agente~") COLUMN(NAME=~"scag_provvigione.imp_prov_agente~") COLUMN(NAME=~"scag_provvigione.per_prov_sub_agente~") COLUMN(NAME=~"scag_provvigione.imp_prov_sub_agente~") COLUMN(NAME=~"scag_provvigione.id_azienda~") COLUMN(NAME=~"scag_provvigione.id_con_provvigione~") COLUMN(NAME=~"scag_provvigione.id_scag_provvigione~")WHERE(    EXP1 =~"~~~"scag_provvigione~~~".~~~"id_con_provvigione~~~"~"   OP =~"=~"    EXP2 =~":ra_id_con_provvigioni~" ) ) ARG(NAME = ~"ra_id_con_provvigioni~" TYPE = number) " update="scag_provvigione" updatewhere=1 updatekeyinplace=yes retrieve.asneeded=yes arguments=(("ra_id_con_provvigioni", number)) )
