 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"riep_provvigioni~" )  TABLE(NAME=~"documento~" )  TABLE(NAME=~"sog_commerciale~" ) COLUMN(NAME=~"riep_provvigioni.id_riep_provvigioni~") COLUMN(NAME=~"riep_provvigioni.id_agente~") COLUMN(NAME=~"riep_provvigioni.id_documento~") COLUMN(NAME=~"riep_provvigioni.inc_precedente~") COLUMN(NAME=~"riep_provvigioni.stato_provvigioni~") COLUMN(NAME=~"riep_provvigioni.imp_premi_penalita~") COLUMN(NAME=~"documento.data_registrazione~") COLUMN(NAME=~"sog_commerciale.codice~") COLUMN(NAME=~"documento.id_registro~") COLUMN(NAME=~"documento.num_progressivo~") COLUMN(NAME=~"documento.id_documento~") COLUMN(NAME=~"riep_provvigioni.id_gruppo_agenti~")    JOIN (LEFT=~"documento.id_documento~"    OP =~"=~"RIGHT=~"riep_provvigioni.id_documento~" )    JOIN (LEFT=~"sog_commerciale.id_sog_commerciale~"    OP =~"=~"RIGHT=~"riep_provvigioni.id_agente~" )WHERE(    EXP1 =~"~~~"riep_provvigioni~~~".~~~"stato_provvigioni~~~"~"   OP =~"=~"    EXP2 =~"'A'~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"sog_commerciale~~~".~~~"codice~~~"~"   OP =~">=~"    EXP2 =~":rn_da_agente~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"sog_commerciale~~~".~~~"codice~~~"~"   OP =~"<=~"    EXP2 =~":rn_a_agente~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"documento~~~".~~~"data_registrazione~~~"~"   OP =~"<=~"    EXP2 =~":rn_data_reg~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"(~~~"sog_commerciale~~~".~~~"ult_elab_definitivo~~~"~"   OP =~"<=~"    EXP2 =~":rn_data_reg~"    LOGIC =~"or~" ) WHERE(    EXP1 =~"~~~"sog_commerciale~~~".~~~"ult_elab_definitivo~~~"~"   OP =~"is~"    EXP2 =~"null)~" ) ) ARG(NAME = ~"rn_da_agente~" TYPE = string)  ARG(NAME = ~"rn_a_agente~" TYPE = string)  ARG(NAME = ~"rn_data_reg~" TYPE = date) " arguments=(("rn_da_agente", string),("rn_a_agente", string),("rn_data_reg", date))  sort="sog_commerciale_codice A documento_data_registrazione A " )
