 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"riga_documento~" )  TABLE(NAME=~"articolo~" )  TABLE(NAME=~"unita_confezione~" )  TABLE(NAME=~"gruppo_agenti~" ALIAS=~"gruppo_agenti_a~" )  TABLE(NAME=~"gruppo_agenti~" ALIAS=~"gruppo_agenti_b~" ) COLUMN(NAME=~"riga_documento.id_riga_documento~") COLUMN(NAME=~"riga_documento.id_documento~") COLUMN(NAME=~"riga_documento.id_unita_confezione~") COLUMN(NAME=~"riga_documento.id_gruppo_agenti~") COLUMN(NAME=~"riga_documento.num_riga~") COLUMN(NAME=~"riga_documento.id_articolo~") COLUMN(NAME=~"riga_documento.descrizione~") COLUMN(NAME=~"riga_documento.quantita~") COLUMN(NAME=~"riga_documento.qta_un_base~") COLUMN(NAME=~"riga_documento.id_caus_magazzino~") COLUMN(NAME=~"riga_documento.id_locazione_1~") COLUMN(NAME=~"riga_documento.id_locazione_2~") COLUMN(NAME=~"riga_documento.prezzo_netto~") COLUMN(NAME=~"riga_documento.sconto~") COLUMN(NAME=~"riga_documento.sconto_riga~") COLUMN(NAME=~"riga_documento.peso_netto~") COLUMN(NAME=~"riga_documento.provv_agente~") COLUMN(NAME=~"riga_documento.provv_subage~") COLUMN(NAME=~"riga_documento.provv_carea~") COLUMN(NAME=~"riga_documento.tot_riga_val_az~") COLUMN(NAME=~"riga_documento.provv_imp_agente~") COLUMN(NAME=~"riga_documento.provv_imp_subage~") COLUMN(NAME=~"riga_documento.provv_imp_carea~") COLUMN(NAME=~"riga_documento.id_gruppo_agenti_2~") COLUMN(NAME=~"riga_documento.provv_agente_2~") COLUMN(NAME=~"riga_documento.provv_subage_2~") COLUMN(NAME=~"riga_documento.provv_carea_2~") COLUMN(NAME=~"riga_documento.provv_imp_agente_2~") COLUMN(NAME=~"riga_documento.provv_imp_subage_2~") COLUMN(NAME=~"riga_documento.provv_imp_carea_2~") COLUMN(NAME=~"articolo.codice~") COLUMN(NAME=~"unita_confezione.codice~") COLUMN(NAME=~"unita_confezione.descrizione~") COLUMN(NAME=~"gruppo_agenti_a.id_sog_com_capo_area~") COLUMN(NAME=~"gruppo_agenti_a.id_sog_com_agente~") COLUMN(NAME=~"gruppo_agenti_a.id_sog_com_sub_agente~") COLUMN(NAME=~"gruppo_agenti_b.id_sog_com_capo_area~") COLUMN(NAME=~"gruppo_agenti_b.id_sog_com_agente~") COLUMN(NAME=~"gruppo_agenti_b.id_sog_com_sub_agente~") COMPUTE(NAME=~"CAST(' ' AS CHAR(10) ) AS capo_area_a_codice~") COMPUTE(NAME=~"CAST(' ' AS CHAR(40) ) AS capo_area_a_rag_soc_1~") COMPUTE(NAME=~"CAST(' ' AS CHAR(10) ) AS capo_area_b_codice~") COMPUTE(NAME=~"CAST(' ' AS CHAR(40) ) AS capo_area_b_rag_soc_1~") COMPUTE(NAME=~"CAST(' ' AS CHAR(10) ) AS agente_a_codice~") COMPUTE(NAME=~"CAST(' ' AS CHAR(40) ) AS agente_a_rag_soc_1~") COMPUTE(NAME=~"CAST(' ' AS CHAR(10) ) AS agente_b_codice~") COMPUTE(NAME=~"CAST(' ' AS CHAR(40) ) AS agente_b_rag_soc_1~") COMPUTE(NAME=~"CAST(' ' AS CHAR(10) ) AS sub_agente_a_codice~") COMPUTE(NAME=~"CAST(' ' AS CHAR(40) ) AS sub_agente_a_rag_soc_1~") COMPUTE(NAME=~"CAST(' ' AS CHAR(10) ) AS sub_agente_b_codice~") COMPUTE(NAME=~"CAST(' ' AS CHAR(40) ) AS sub_agente_b_rag_soc_1~") COLUMN(NAME=~"riga_documento.id_valuta~") COLUMN(NAME=~"riga_documento.id_con_lis_articolo~")    JOIN (LEFT=~"articolo.id_articolo~"    OP =~"=~"RIGHT=~"riga_documento.id_articolo~"    OUTER2 =~"riga_documento.id_articolo~" )    JOIN (LEFT=~"unita_confezione.id_unita_confezione~"    OP =~"=~"RIGHT=~"riga_documento.id_unita_confezione~"    OUTER2 =~"riga_documento.id_unita_confezione~" )    JOIN (LEFT=~"gruppo_agenti_a.id_gruppo_agenti~"    OP =~"=~"RIGHT=~"riga_documento.id_gruppo_agenti~"    OUTER2 =~"riga_documento.id_gruppo_agenti~" )    JOIN (LEFT=~"gruppo_agenti_b.id_gruppo_agenti~"    OP =~"=~"RIGHT=~"riga_documento.id_gruppo_agenti_2~"    OUTER2 =~"riga_documento.id_gruppo_agenti_2~" )WHERE(    EXP1 =~"~~~"riga_documento~~~".~~~"id_documento~~~"~"   OP =~"=~"    EXP2 =~":rn_id_documento~" ) ) ARG(NAME = ~"rn_id_documento~" TYPE = number) " arguments=(("rn_id_documento", number)) )
