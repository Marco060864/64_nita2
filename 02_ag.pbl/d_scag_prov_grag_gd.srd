table(column=(type=decimal(2) update=yes updatewhereclause=yes key=yes name=scag_provvigione_da_per_sconto dbname="scag_provvigione.da_per_sconto" validation="int(   scag_provvigione_da_per_sconto ) >=0 and int(   scag_provvigione_da_per_sconto ) <= 100" validationmsg="~"Inserire un valore compreso fra 0 e 100~"" )
