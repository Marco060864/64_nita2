 column=(type=long updatewhereclause=yes identity=yes name=id_con_provvigioni dbname="con_provvigione.id_con_provvigioni" )
 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"con_provvigione~" )  TABLE(NAME=~"scag_provvigione~" ) COLUMN(NAME=~"scag_provvigione.da_per_sconto~") COLUMN(NAME=~"scag_provvigione.a_per_sconto~") COLUMN(NAME=~"scag_provvigione.tipo_applicazione~") COLUMN(NAME=~"scag_provvigione.per_prov_capo_area~") COLUMN(NAME=~"scag_provvigione.imp_prov_capo_area~") COLUMN(NAME=~"scag_provvigione.per_prov_agente~") COLUMN(NAME=~"scag_provvigione.imp_prov_agente~") COLUMN(NAME=~"scag_provvigione.per_prov_sub_agente~") COLUMN(NAME=~"scag_provvigione.imp_prov_sub_agente~") COLUMN(NAME=~"scag_provvigione.id_scag_provvigioni~") COLUMN(NAME=~"scag_provvigione.id_con_provvigioni~") COLUMN(NAME=~"scag_provvigione.id_azienda~") COLUMN(NAME=~"con_provvigione.id_gruppo_agenti~") COLUMN(NAME=~"con_provvigione.id_con_provvigioni~")    JOIN (LEFT=~"scag_provvigione.id_con_provvigioni~"    OP =~"=~"RIGHT=~"con_provvigione.id_con_provvigioni~" )WHERE(    EXP1 =~"~~~"con_provvigione~~~".~~~"id_gruppo_agenti~~~"~"   OP =~"=~"    EXP2 =~":ra_gruppo_agente~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"con_provvigione~~~".~~~"id_sog_commerciale~~~"~"   OP =~"is~"    EXP2 =~"Null~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"con_provvigione~~~".~~~"id_cat_com_sc~~~"~"   OP =~"is~"    EXP2 =~"Null~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"con_provvigione~~~".~~~"id_articolo~~~"~"   OP =~"is~"    EXP2 =~"Null~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"con_provvigione~~~".~~~"id_cat_com_articolo~~~"~"   OP =~"is~"    EXP2 =~"Null~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"con_provvigione~~~".~~~"id_con_pagamento~~~"~"   OP =~"is~"    EXP2 =~"Null~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"con_provvigione~~~".~~~"id_con_lis_articolo~~~"~"   OP =~"is~"    EXP2 =~"Null~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"con_provvigione~~~".~~~"id_azienda~~~"~"   OP =~"in~"    EXP2 =~"(0, 1)~" ) ) ARG(NAME = ~"ra_gruppo_agente~" TYPE = number) " update="scag_provvigione" updatewhere=1 updatekeyinplace=yes arguments=(("ra_gruppo_agente", number)) )
