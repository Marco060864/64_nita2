 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"riga_documento~" ALIAS=~"r~" )  TABLE(NAME=~"articolo~" ALIAS=~"a~" )  TABLE(NAME=~"documento~" ALIAS=~"d~" ) COLUMN(NAME=~"a.codice~") COLUMN(NAME=~"r.descrizione~") COLUMN(NAME=~"r.num_riga~") COLUMN(NAME=~"d.num_documento~") COLUMN(NAME=~"d.data_documento~") COLUMN(NAME=~"d.num_progressivo~") COLUMN(NAME=~"d.id_prof_documento~") COLUMN(NAME=~"r.id_riga_documento~")    JOIN (LEFT=~"r.id_articolo~"    OP =~"=~"RIGHT=~"a.id_articolo~" )    JOIN (LEFT=~"r.id_documento~"    OP =~"=~"RIGHT=~"d.id_documento~" )WHERE(    EXP1 =~"id_riga_documento~"   OP =~"=~"    EXP2 =~":id_riga ~" ) ) ARG(NAME = ~"id_riga~" TYPE = number) " arguments=(("id_riga", number)) )
