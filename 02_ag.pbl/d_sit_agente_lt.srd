 column=(type=long update=yes updatewhereclause=yes name=id_azienda dbname="riep_provvigione.id_azienda" initial="1" )
 column=(type=decimal(6) updatewhereclause=yes name=c_num_progressivo_doc dbname="c_num_progressivo_doc" )
 column=(type=date updatewhereclause=yes name=c_data_registrazione_doc dbname="c_data_registrazione_doc" )
 column=(type=char(16) updatewhereclause=yes name=c_num_documento_doc dbname="c_num_documento_doc" )
 column=(type=date updatewhereclause=yes name=c_data_documento_doc dbname="c_data_documento_doc" )
 column=(type=date updatewhereclause=yes name=c_data_competenza_doc dbname="c_data_competenza_doc" )
 column=(type=char(8) updatewhereclause=yes name=c_codice_cliente_doc dbname="c_codice_cliente_doc" )
 column=(type=char(40) updatewhereclause=yes name=c_rag_soc_cliente_doc dbname="c_rag_soc_cliente_doc" )
 column=(type=char(2) updatewhereclause=yes name=c_tipo_registro_doc dbname="c_tipo_registro_doc" )
 column=(type=char(4) updatewhereclause=yes name=c_codice_esercizio_doc dbname="c_codice_esercizio_doc" )
 column=(type=decimal(6) updatewhereclause=yes name=c_numero_registro_doc dbname="c_numero_registro_doc" )
 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"riep_provvigione~" ) COLUMN(NAME=~"riep_provvigione.id_riep_provvigioni~") COLUMN(NAME=~"riep_provvigione.id_documento~") COLUMN(NAME=~"riep_provvigione.id_agente~") COLUMN(NAME=~"riep_provvigione.num_progressivo~") COLUMN(NAME=~"riep_provvigione.data_registrazione~") COLUMN(NAME=~"riep_provvigione.num_documento~") COLUMN(NAME=~"riep_provvigione.data_documento~") COLUMN(NAME=~"riep_provvigione.data_competenza~") COLUMN(NAME=~"riep_provvigione.id_cliente~") COLUMN(NAME=~"riep_provvigione.tot_merce~") COLUMN(NAME=~"riep_provvigione.tot_provvigione~") COLUMN(NAME=~"riep_provvigione.id_azienda~") COMPUTE(NAME=~"cast(NULL as numeric) As c_num_progressivo_doc~") COMPUTE(NAME=~"cast(NULL as date) As c_data_registrazione_doc~") COMPUTE(NAME=~"cast(NULL as char (16)) As c_num_documento_doc~") COMPUTE(NAME=~"cast(NULL as date) As c_data_documento_doc~") COMPUTE(NAME=~"cast(NULL as date) As c_data_competenza_doc~") COMPUTE(NAME=~"cast(NULL as char (8)) As c_codice_cliente_doc~") COMPUTE(NAME=~"cast(NULL as char (40)) As c_rag_soc_cliente_doc~") COMPUTE(NAME=~"cast(NULL as char (2)) As c_tipo_registro_doc~") COMPUTE(NAME=~"cast(NULL as char (4)) As c_codice_esercizio_doc~") COMPUTE(NAME=~"cast(NULL as numeric) As c_numero_registro_doc~")WHERE(    EXP1 =~"~~~"riep_provvigione~~~".~~~"id_agente~~~"~"   OP =~"=~"    EXP2 =~":ri_id_agente~" ) ) ARG(NAME = ~"ri_id_agente~" TYPE = number) " update="riep_provvigione" updatewhere=1 updatekeyinplace=yes arguments=(("ri_id_agente", number)) )
