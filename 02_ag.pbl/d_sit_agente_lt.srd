table(column=(type=long update=yes updatewhereclause=yes key=yes identity=yes name=id_riep_provvigioni dbname="riep_provvigione.id_riep_provvigioni" )
 column=(type=long update=yes updatewhereclause=yes name=id_documento dbname="riep_provvigione.id_documento" )
 column=(type=long update=yes updatewhereclause=yes name=id_sog_commerciale dbname="riep_provvigione.id_agente" )
 column=(type=decimal(0) update=yes updatewhereclause=yes name=num_progressivo dbname="riep_provvigione.num_progressivo" validation=" real(gettext())  >= 0" validationmsg="'Immettere un valore >= 0'" )
 column=(type=date update=yes updatewhereclause=yes name=data_registrazione dbname="riep_provvigione.data_registrazione" )
 column=(type=char(16) update=yes updatewhereclause=yes name=num_documento dbname="riep_provvigione.num_documento" )
 column=(type=date update=yes updatewhereclause=yes name=data_documento dbname="riep_provvigione.data_documento" )
 column=(type=date update=yes updatewhereclause=yes name=data_competenza dbname="riep_provvigione.data_competenza" )
 column=(type=long update=yes updatewhereclause=yes name=id_cliente dbname="riep_provvigione.id_cliente" )
 column=(type=decimal(0) update=yes updatewhereclause=yes name=tot_merce dbname="riep_provvigione.tot_merce" )
