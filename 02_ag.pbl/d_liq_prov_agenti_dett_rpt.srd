 column=(type=char(80) updatewhereclause=yes name=articolo_descrizione dbname="articolo.descrizione" )
 retrieve="  SELECT ~"sog_commerciale~".~"codice~",   
         ~"anagrafica~".~"rag_soc_1~",   
         ~"sog_commerciale_gen~".~"codice~",   
         ~"sog_commerciale_gen~".~"rag_soc_1~",   
         ~"documento~".~"data_documento~",   
         ~"documento~".~"num_documento~",   
         ~"gruppo_agenti~".~"rip_per_fatturato~",   
         ~"gruppo_agenti~".~"rip_per_incassato~",   
         ~"sog_commerciale~".~"imp_fisso~",   
         ~"valuta~".~"descrizione~",   
         ~"par_aperta~".~"importo~",   
         ~"riep_prov_righe~".~"imp_provv_documento~",   
         ~"riep_prov_righe~".~"tipo_prov~",   
         ~"riep_prov_righe~".~"provvigioni~",   
         ~"riep_prov_righe~".~"imp_prov_incassato~",   
         ~"riep_provvigioni~".~"imp_premi_penalita~",   
         ~"riep_provvigioni~".~"liq_pagato~",   
         ~"sog_commerciale~".~"prec_elab_definitivo~",   
         ~"sog_commerciale~".~"imp_premio_budget~",   
         ~"tab_iva~".~"per_aliquota~",   
         CAST((SELECT SUM(IMP_STAR_CREDERE) FROM RIEP_PROV_STAR_CREDERE WHERE ID_RIEP_PROVVIGIONI = ~"riep_provvigioni~".~"id_riep_provvigioni~") AS NUMERIC(18,4)) AS imp_star_credere,   
         CAST((SELECT IMP_VER_ULT_ELAB FROM PROG_ENASARCO WHERE ID_SOG_COMMERCIALE = ~"sog_commerciale~".~"id_sog_commerciale~" AND ANNO = YEAR(~"sog_commerciale~".~"ult_elab_definitivo~") AND ID_AZIENDA = 1) AS NUMERIC(18,4)) AS imp_ver_ult_elab,   
         CAST((SELECT PROGRESSIVO_ENASARCO FROM PROG_ENASARCO WHERE ID_SOG_COMMERCIALE = ~"sog_commerciale~".~"id_sog_commerciale~" AND ANNO = YEAR(~"sog_commerciale~".~"ult_elab_definitivo~") AND ID_AZIENDA = 1) AS NUMERIC(18,4)) AS progressivo_enasarco,   
         CAST((SELECT T.PER_TRIBUTO FROM TRIBUTO T, SOG_COMMERCIALE S WHERE T.ID_TRIBUTO = S.ID_TRIBUTO AND S.ID_ANAGRAFICA = ~"sog_commerciale~".~"id_anagrafica~" AND S.TIPO = 'F') AS NUMERIC(5,2)) AS rit_acconto,   
         ~"valuta~".~"cambio~",   
         ~"valuta~".~"cifra_arrotondamento~",   
         ~"valuta~".~"tipo_arrotondamento~",   
         ~"riep_provvigioni~".~"inc_precedente~",   
         ~"documento~".~"tipo_fattura~",   
         ~"gruppo_agenti~".~"fat_ult_elab~",   
         ~"riep_prov_righe~".~"data_elab_fatturato~",   
         ~"sog_commerciale~".~"ult_elab_definitivo~",   
         CAST((SELECT IMP_MASSIMO FROM SCAG_ENASARCO WHERE ID_TIPO_AGENTE = ~"sog_commerciale~".~"id_tipo_agente~" AND ~"sog_commerciale~".~"ult_elab_definitivo~" >= DATA_INIZIO  AND ~"sog_commerciale~".~"ult_elab_definitivo~" <= DATA_FINE AND ID_AZIENDA = 1 ) AS NUMERIC(18,4)) AS massimale,   
         CAST((SELECT per_car_azienda FROM per_enasarco WHERE data_inizio <= ~"sog_commerciale~".~"ult_elab_definitivo~" AND (data_fine >= ~"sog_commerciale~".~"ult_elab_definitivo~" OR data_fine IS NULL)) AS NUMERIC(5,2)) AS per_car_azienda,   
         CAST((~"riep_prov_righe~".~"imp_provv_documento~" * ~"riep_provvigioni~".~"inc_precedente~" / ~"par_aperta~".~"importo~") AS NUMERIC(18,4)) AS incassato_netto,   
         CAST(0 AS NUMERIC(18,4)) AS totale,   
         CAST(0 AS NUMERIC(18,4)) AS prov_fatturato,   
         CAST(' ' AS CHAR(1)) AS gia_fatturato,
         CAST((SELECT T.PER_IMPONIBILE FROM TRIBUTO T, SOG_COMMERCIALE S WHERE T.ID_TRIBUTO = S.ID_TRIBUTO AND S.ID_ANAGRAFICA = ~"sog_commerciale~".~"id_anagrafica~" AND S.TIPO = 'F') AS NUMERIC(5,2)) AS rit_acconto_imp,
			~"documento~".~"id_documento~",
			~"riga_documento~".~"quantita~",
			~"riga_documento~".~"peso_netto~",
			~"unita_misura~".~"tipo~",
			~"articolo~".~"codice~",
			~"articolo~".~"descrizione~"
    FROM ~"documento~",   
         ~"riep_prov_righe~",   
         ~"riep_provvigioni~",   
         ~"sog_commerciale_gen~",   
         ~"gruppo_agenti~",   
         ~"sog_commerciale~",   
         ~"anagrafica~",   
         ~"valuta~",   
         ~"reg_pd~",   
         ~"par_aperta~",   
         ~"tab_iva~",
			~"riga_documento~",
		   ~"unita_confezione~",
			~"unita_misura~",
			~"articolo~"
   WHERE ( ~"riep_prov_righe~".~"id_riep_provvigioni~" = ~"riep_provvigioni~".~"id_riep_provvigioni~" ) and  
         ( ~"documento~".~"id_documento~" = ~"riep_provvigioni~".~"id_documento~" ) and  
         ( ~"sog_commerciale_gen~".~"id_sog_commerciale~" = ~"documento~".~"id_sog_commerciale~" ) and  
         ( ~"gruppo_agenti~".~"id_gruppo_agenti~" = ~"riep_provvigioni~".~"id_gruppo_agenti~" ) and  
         ( ~"sog_commerciale~".~"id_sog_commerciale~" = ~"riep_provvigioni~".~"id_agente~" ) and  
         ( ~"sog_commerciale~".~"id_anagrafica~" = ~"anagrafica~".~"id_anagrafica~" ) and  
         ( ~"valuta~".~"id_valuta~" = ~"sog_commerciale~".~"id_val_prov_agente~" ) and  
         ( ~"reg_pd~".~"num_progressivo~" = ~"documento~".~"num_progressivo~" ) and  
         ( ~"reg_pd~".~"data_registrazione~" = ~"documento~".~"data_registrazione~" ) and  
         ( ~"reg_pd~".~"id_registro~" = ~"documento~".~"id_registro~" ) and  
         ( ~"par_aperta~".~"id_reg_pd~" =* ~"reg_pd~".~"id_reg_pd~" ) and  
         ( ~"tab_iva~".~"id_tab_iva~" = ~"sog_commerciale~".~"id_tab_iva_fat_prov~" )    AND
         ( ~"riga_documento~".~"id_riga_documento~" = ~"riep_prov_righe~".~"id_riga_documento~" ) AND
		   ( ~"unita_confezione~".~"id_unita_confezione~" = ~"riga_documento~".~"id_unita_confezione~" ) AND
			( ~"unita_misura~".~"id_unita_misura~" = ~"unita_confezione~".~"id_unita_misura~" ) AND
		   ( ~"articolo~".~"id_articolo~" = ~"riga_documento~".~"id_articolo~" )
" arguments=(("parametri", string),("tipo_stampa", string)) )
