 column=(type=decimal(2) updatewhereclause=yes name=per_car_azienda dbname="per_car_azienda" )
 column=(type=decimal(4) updatewhereclause=yes name=cincassato_netto dbname="incassato_netto" )
 column=(type=decimal(4) updatewhereclause=yes name=ctotale dbname="totale" )
 column=(type=decimal(4) updatewhereclause=yes name=cprov_fatturato dbname="prov_fatturato" )
