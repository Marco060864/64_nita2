 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"gruppo_agenti~" )  TABLE(NAME=~"sog_commerciale_gen~" ALIAS=~"sog_commerciale_gen_a~" )  TABLE(NAME=~"sog_commerciale_gen~" ALIAS=~"sog_commerciale_gen_b~" )  TABLE(NAME=~"sog_commerciale_gen~" ALIAS=~"sog_commerciale_gen_c~" )  TABLE(NAME=~"con_provvigione~" )  TABLE(NAME=~"articolo~" ALIAS=~"articolo_a~" )  TABLE(NAME=~"sog_commerciale_gen~" ALIAS=~"sog_commerciale_gen_d~" )  TABLE(NAME=~"unita_confezione~" )  TABLE(NAME=~"articolo~" ALIAS=~"articolo_b~" )  TABLE(NAME=~"anagrafica~" ) COLUMN(NAME=~"gruppo_agenti.codice~") COLUMN(NAME=~"gruppo_agenti.descrizione~") COLUMN(NAME=~"gruppo_agenti.id_sog_com_capo_area~") COLUMN(NAME=~"gruppo_agenti.id_sog_com_agente~") COLUMN(NAME=~"gruppo_agenti.id_sog_com_sub_agente~") COLUMN(NAME=~"sog_commerciale_gen_a.codice~") COLUMN(NAME=~"sog_commerciale_gen_a.rag_soc_1~") COLUMN(NAME=~"sog_commerciale_gen_c.codice~") COLUMN(NAME=~"sog_commerciale_gen_c.rag_soc_1~") COLUMN(NAME=~"sog_commerciale_gen_b.codice~") COLUMN(NAME=~"sog_commerciale_gen_b.rag_soc_1~") COLUMN(NAME=~"con_provvigione.id_sog_commerciale~") COLUMN(NAME=~"con_provvigione.id_cat_com_sc~") COLUMN(NAME=~"con_provvigione.id_articolo~") COLUMN(NAME=~"con_provvigione.id_cat_com_articolo~") COLUMN(NAME=~"con_provvigione.priorita~") COLUMN(NAME=~"articolo_a.codice~") COLUMN(NAME=~"articolo_a.descrizione~") COLUMN(NAME=~"sog_commerciale_gen_d.codice~") COLUMN(NAME=~"sog_commerciale_gen_d.rag_soc_1~") COLUMN(NAME=~"con_provvigione.id_con_provvigione~") COLUMN(NAME=~"con_provvigione.id_gruppo_agenti~") COLUMN(NAME=~"con_provvigione.id_unita_confezione~") COLUMN(NAME=~"unita_confezione.codice~") COLUMN(NAME=~"unita_confezione.descrizione~") COLUMN(NAME=~"con_provvigione.id_azienda~") COLUMN(NAME=~"con_provvigione.data_inizio~") COLUMN(NAME=~"con_provvigione.data_fine~") COLUMN(NAME=~"con_provvigione.id_articolo_a~") COLUMN(NAME=~"con_provvigione.id_cat_merceologica~") COLUMN(NAME=~"articolo_b.codice~") COLUMN(NAME=~"articolo_b.descrizione~") COLUMN(NAME=~"con_provvigione.id_anagrafica~") COLUMN(NAME=~"anagrafica.rag_soc_1~")    JOIN (LEFT=~"gruppo_agenti.id_sog_com_capo_area~"    OP =~"=~"RIGHT=~"sog_commerciale_gen_a.id_sog_commerciale~"    OUTER1 =~"gruppo_agenti.id_sog_com_capo_area~" )    JOIN (LEFT=~"gruppo_agenti.id_sog_com_agente~"    OP =~"=~"RIGHT=~"sog_commerciale_gen_b.id_sog_commerciale~"    OUTER1 =~"gruppo_agenti.id_sog_com_agente~" )    JOIN (LEFT=~"gruppo_agenti.id_sog_com_sub_agente~"    OP =~"=~"RIGHT=~"sog_commerciale_gen_c.id_sog_commerciale~"    OUTER1 =~"gruppo_agenti.id_sog_com_sub_agente~" )    JOIN (LEFT=~"articolo_a.id_articolo~"    OP =~"=~"RIGHT=~"con_provvigione.id_articolo~"    OUTER2 =~"con_provvigione.id_articolo~" )    JOIN (LEFT=~"con_provvigione.id_sog_commerciale~"    OP =~"=~"RIGHT=~"sog_commerciale_gen_d.id_sog_commerciale~"    OUTER1 =~"con_provvigione.id_sog_commerciale~" )    JOIN (LEFT=~"con_provvigione.id_gruppo_agenti~"    OP =~"=~"RIGHT=~"gruppo_agenti.id_gruppo_agenti~"    OUTER1 =~"con_provvigione.id_gruppo_agenti~" )    JOIN (LEFT=~"unita_confezione.id_unita_confezione~"    OP =~"=~"RIGHT=~"con_provvigione.id_unita_confezione~"    OUTER2 =~"con_provvigione.id_unita_confezione~" )    JOIN (LEFT=~"articolo_b.id_articolo~"    OP =~"=~"RIGHT=~"con_provvigione.id_articolo_a~"    OUTER2 =~"con_provvigione.id_articolo_a~" )    JOIN (LEFT=~"anagrafica.id_anagrafica~"    OP =~"=~"RIGHT=~"con_provvigione.id_anagrafica~"    OUTER2 =~"con_provvigione.id_anagrafica~" )WHERE(    EXP1 =~"~~~"con_provvigione~~~".~~~"id_azienda~~~"~"   OP =~"=~"    EXP2 =~"1~" ) ) ORDER(NAME=~"gruppo_agenti.codice~" ASC=yes ) " update="con_provvigione" updatewhere=1 updatekeyinplace=yes  sort="cpriorita D " )
