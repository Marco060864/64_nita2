 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"gruppo_agenti~" )  TABLE(NAME=~"sog_commerciale_gen~" ALIAS=~"sog_commerciale_gen_a~" )  TABLE(NAME=~"sog_commerciale_gen~" ALIAS=~"sog_commerciale_gen_b~" )  TABLE(NAME=~"sog_commerciale_gen~" ALIAS=~"sog_commerciale_gen_c~" ) COLUMN(NAME=~"gruppo_agenti.id_gruppo_agenti~") COLUMN(NAME=~"gruppo_agenti.codice~") COLUMN(NAME=~"gruppo_agenti.descrizione~") COLUMN(NAME=~"gruppo_agenti.id_sog_com_capo_area~") COLUMN(NAME=~"gruppo_agenti.id_sog_com_agente~") COLUMN(NAME=~"gruppo_agenti.id_sog_com_sub_agente~") COLUMN(NAME=~"gruppo_agenti.sconto_riga~") COLUMN(NAME=~"gruppo_agenti.sconto_finanziario~") COLUMN(NAME=~"gruppo_agenti.sconto_fin_cassa~") COLUMN(NAME=~"gruppo_agenti.sconto_fin_incondizionato~") COLUMN(NAME=~"gruppo_agenti.rip_per_fatturato~") COLUMN(NAME=~"gruppo_agenti.rip_per_incassato~") COLUMN(NAME=~"gruppo_agenti.mod_liq_provvigione~") COLUMN(NAME=~"gruppo_agenti.id_azienda~") COLUMN(NAME=~"sog_commerciale_gen_a.codice~") COLUMN(NAME=~"sog_commerciale_gen_a.rag_soc_1~") COLUMN(NAME=~"sog_commerciale_gen_b.codice~") COLUMN(NAME=~"sog_commerciale_gen_b.rag_soc_1~") COLUMN(NAME=~"sog_commerciale_gen_c.codice~") COLUMN(NAME=~"sog_commerciale_gen_c.rag_soc_1~")    JOIN (LEFT=~"gruppo_agenti.id_sog_com_capo_area~"    OP =~"=~"RIGHT=~"sog_commerciale_gen_a.id_sog_commerciale~"    OUTER1 =~"gruppo_agenti.id_sog_com_capo_area~" )    JOIN (LEFT=~"gruppo_agenti.id_sog_com_agente~"    OP =~"=~"RIGHT=~"sog_commerciale_gen_b.id_sog_commerciale~"    OUTER1 =~"gruppo_agenti.id_sog_com_agente~" )    JOIN (LEFT=~"gruppo_agenti.id_sog_com_sub_agente~"    OP =~"=~"RIGHT=~"sog_commerciale_gen_c.id_sog_commerciale~"    OUTER1 =~"gruppo_agenti.id_sog_com_sub_agente~" )WHERE(    EXP1 =~"~~~"gruppo_agenti~~~".~~~"id_azienda~~~"~"   OP =~"in~"    EXP2 =~"(0,1)~" ) ) " )
