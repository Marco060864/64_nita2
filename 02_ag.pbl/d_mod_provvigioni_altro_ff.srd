i_b.id_sog_com_agente~") COLUMN(NAME=~"gruppo_agenti_b.id_sog_com_sub_agente~") COMPUTE(NAME=~"CAST(' ' AS CHAR(10) ) AS capo_area_a_codice~") COMPUTE(NAME=~"CAST(' ' AS CHAR(40) ) AS capo_area_a_rag_soc_1~") COMPUTE(NAME=~"CAST(' ' AS CHAR(10) ) AS capo_area_b_codice~") COMPUTE(NAME=~"CAST(' ' AS CHAR(40) ) AS capo_area_b_rag_soc_1~") COMPUTE(NAME=~"CAST(' ' AS CHAR(10) ) AS agente_a_codice~") COMPUTE(NAME=~"CAST(' ' AS CHAR(40) ) AS agente_a_rag_soc_1~") COMPUTE(NAME=~"CAST(' ' AS CHAR(10) ) AS agente_b_codice~") COMPUTE(NAME=~"CAST(' ' AS CHAR(40) ) AS agente_b_rag_soc_1~") COMPUTE(NAME=~"CAST(' ' AS CHAR(10) ) AS sub_agente_a_codice~") COMPUTE(NAME=~"CAST(' ' AS CHAR(40) ) AS sub_agente_a_rag_soc_1~") COMPUTE(NAME=~"CAST(' ' AS CHAR(10) ) AS sub_agente_b_codice~") COMPUTE(NAME=~"CAST(' ' AS CHAR(40) ) AS sub_agente_b_rag_soc_1~") COLUMN(NAME=~"riga_documento.id_valuta~") COLUMN(NAME=~"riga_documento.id_con_lis_articolo~")    JOIN (LEFT=~"articolo.id_articolo~"    OP =~"=~"RIGHT=~"riga_documento.id_articolo~"    OUTER2 =~"riga_documento.id_articolo~" )    JOIN (LEFT=~"unita_confezione.id_unita_confezione~"    OP =~"=~"RIGHT=~"riga_documento.id_unita_confezione~"    OUTER2 =~"riga_documento.id_unita_confezione~" )    JOIN (LEFT=~"gruppo_agenti_a.id_gruppo_agenti~"    OP =~"=~"RIGHT=~"riga_documento.id_gruppo_agenti~"    OUTER2 =~"riga_documento.id_gruppo_agenti~" )    JOIN (LEFT=~"gruppo_agenti_b.id_gruppo_agenti~"    OP =~"=~"RIGHT=~"riga_documento.id_gruppo_agenti_2~"    OUTER2 =~"riga_documento.id_gruppo_agenti_2~" )WHERE(    EXP1 =~"~~~"riga_documento~~~".~~~"id_documento~~~"~"   OP =~"=~"    EXP2 =~":rn_id_documento~" ) ) ARG(NAME = ~"rn_id_documento~" TYPE = number) " arguments=(("rn_id_documento", number)) )
