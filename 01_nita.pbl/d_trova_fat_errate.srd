table(column=(type=decimal(4) updatewhereclause=yes name=riga_documento_importo_manifattura dbname="riga_documento.importo_manifattura" dbalias="r.importo_manifattura" )
 column=(type=long updatewhereclause=yes name=documento_id_sog_commerciale dbname="documento.id_sog_commerciale" dbalias="d.id_sog_commerciale" )
 column=(type=decimal(4) updatewhereclause=yes name=riga_documento_quantita dbname="riga_documento.quantita" dbalias="r.quantita" )
 column=(type=decimal(6) updatewhereclause=yes name=riga_documento_prezzo_complessivo dbname="riga_documento.prezzo_complessivo" dbalias="r.prezzo_complessivo" )
 column=(type=date updatewhereclause=yes name=documento_data_documento dbname="documento.data_documento" dbalias="d.data_documento" )
 column=(type=char(16) updatewhereclause=yes name=documento_num_documento dbname="documento.num_documento" dbalias="d.num_documento" )
 column=(type=decimal(0) updatewhereclause=yes name=riga_documento_num_riga dbname="riga_documento.num_riga" dbalias="r.num_riga" )
 column=(type=char(1) updatewhereclause=yes name=unita_misura_tipo dbname="unita_misura.tipo" dbalias=".tipo" )
 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"riga_documento~" ALIAS=~"r~" )  TABLE(NAME=~"documento~" ALIAS=~"d~" )  TABLE(NAME=~"unita_confezione~" )  TABLE(NAME=~"unita_misura~" ) COLUMN(NAME=~"r.importo_manifattura~") COLUMN(NAME=~"d.id_sog_commerciale~") COLUMN(NAME=~"r.quantita~") COLUMN(NAME=~"r.prezzo_complessivo~") COLUMN(NAME=~"d.data_documento~") COLUMN(NAME=~"d.num_documento~") COLUMN(NAME=~"r.num_riga~") COLUMN(NAME=~"unita_misura.tipo~")    JOIN (LEFT=~"d.id_documento~"    OP =~"=~"RIGHT=~"r.id_documento~" )    JOIN (LEFT=~"r.id_unita_confezione~"    OP =~"=~"RIGHT=~"unita_confezione.id_unita_confezione~" )    JOIN (LEFT=~"unita_confezione.id_unita_misura~"    OP =~"=~"RIGHT=~"unita_misura.id_unita_misura~" )WHERE(    EXP1 =~"d.id_registro~"   OP =~"=~"    EXP2 =~"1334~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"r.prezzo_complessivo~"   OP =~">~"    EXP2 =~"0~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"round(r.quantita*r.prezzo_complessivo, 2)~"   OP =~"<>~"    EXP2 =~"r.importo_manifattura~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"unita_misura~~~".~~~"tipo~~~"~"   OP =~"=~"    EXP2 =~"'N'~" ) ) "  sort="documento_data_documento A documento_num_documento A " )
