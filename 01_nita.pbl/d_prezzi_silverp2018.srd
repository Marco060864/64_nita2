table(column=(type=long updatewhereclause=yes name=id_unita_confezione dbname="prezzopippo.id_unita_confezione" )
 column=(type=long updatewhereclause=yes name=id_variazione dbname="prezzopippo.id_variazione" )
 column=(type=decimal(6) updatewhereclause=yes name=prezzopippo dbname="prezzopippo.prezzopippo" )
 column=(type=decimal(2) updatewhereclause=yes name=coef_calo dbname="prezzopippo.coef_calo" )
 column=(type=decimal(6) updatewhereclause=yes name=prezzopippo_manifattura dbname="prezzopippo.prezzopippo_manifattura" )
 column=(type=decimal(6) updatewhereclause=yes name=costo_imballo dbname="prezzopippo.costo_imballo" )
 column=(type=decimal(6) updatewhereclause=yes name=galvanica dbname="prezzopippo.galvanica" )
 column=(type=char(255) updatewhereclause=yes name=des_1 dbname="prezzopippo.des_1" )
 column=(type=char(255) updatewhereclause=yes name=des_2 dbname="prezzopippo.des_2" )
 column=(type=char(255) updatewhereclause=yes name=des_3 dbname="prezzopippo.des_3" )
 column=(type=datetime updatewhereclause=yes name=ultima_modifica dbname="prezzopippo.ultima_modifica" )
 column=(type=char(1) updatewhereclause=yes name=confermato dbname="prezzopippo.confermato" )
 column=(type=long updatewhereclause=yes name=articolo_id_cat_codifica dbname="articolo.id_cat_codifica" )
 column=(type=char(32) updatewhereclause=yes name=articolo_codice dbname="articolo.codice" )
 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"prezzopippo~" )  TABLE(NAME=~"articolo~" )  TABLE(NAME=~"unita_confezione~" ) COLUMN(NAME=~"prezzopippo.id_unita_confezione~") COLUMN(NAME=~"prezzopippo.id_variazione~") COLUMN(NAME=~"prezzopippo.prezzopippo~") COLUMN(NAME=~"prezzopippo.coef_calo~") COLUMN(NAME=~"prezzopippo.prezzopippo_manifattura~") COLUMN(NAME=~"prezzopippo.costo_imballo~") COLUMN(NAME=~"prezzopippo.galvanica~") COLUMN(NAME=~"prezzopippo.des_1~") COLUMN(NAME=~"prezzopippo.des_2~") COLUMN(NAME=~"prezzopippo.des_3~") COLUMN(NAME=~"prezzopippo.ultima_modifica~") COLUMN(NAME=~"prezzopippo.confermato~") COLUMN(NAME=~"articolo.id_cat_codifica~") COLUMN(NAME=~"articolo.codice~")    JOIN (LEFT=~"unita_confezione.id_articolo~"    OP =~"=~"RIGHT=~"articolo.id_articolo~" )    JOIN (LEFT=~"prezzopippo.id_unita_confezione~"    OP =~"=~"RIGHT=~"unita_confezione.id_unita_confezione~" )WHERE(    EXP1 =~"~~~"prezzopippo~~~".~~~"id_variazione~~~"~"   OP =~"=~"    EXP2 =~"22~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"(~~~"prezzopippo~~~".~~~"prezzopippo~~~"~"   OP =~">~"    EXP2 =~"0~"    LOGIC =~"or~" ) WHERE(    EXP1 =~"~~~"prezzopippo~~~".~~~"prezzopippo_manifattura~~~"~"   OP =~">~"    EXP2 =~"0)~" ) ) "  sort="articolo_codice A " )
