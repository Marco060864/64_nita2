table(column=(type=long update=yes updatewhereclause=yes key=yes name=prezzo_id_unita_confezione dbname="prezzo.id_unita_confezione" )
 column=(type=long update=yes updatewhereclause=yes key=yes name=prezzo_id_variazione dbname="prezzo.id_variazione" initial="15" )
 column=(type=decimal(6) update=yes updatewhereclause=yes name=prezzo_prezzo dbname="prezzo.prezzo" initial="0" )
 column=(type=decimal(2) update=yes updatewhereclause=yes name=prezzo_coef_calo dbname="prezzo.coef_calo" initial="1000" )
 column=(type=char(255) update=yes updatewhereclause=yes name=prezzo_des_1 dbname="prezzo.des_1" initial="AUTO_XLS 19_08_20" )
 column=(type=datetime update=yes updatewhereclause=yes name=prezzo_ultima_modifica dbname="prezzo.ultima_modifica" initial="today" )
 column=(type=char(1) update=yes updatewhereclause=yes name=prezzo_confermato dbname="prezzo.confermato" initial="N" )
 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"prezzo~" )  TABLE(NAME=~"unita_confezione~" ) COLUMN(NAME=~"prezzo.id_unita_confezione~") COLUMN(NAME=~"prezzo.id_variazione~") COLUMN(NAME=~"prezzo.prezzo~") COLUMN(NAME=~"prezzo.coef_calo~") COLUMN(NAME=~"prezzo.des_1~") COLUMN(NAME=~"prezzo.ultima_modifica~") COLUMN(NAME=~"prezzo.confermato~")    JOIN (LEFT=~"unita_confezione.id_unita_confezione~"    OP =~"=~"RIGHT=~"prezzo.id_unita_confezione~" )WHERE(    EXP1 =~"~~~"unita_confezione~~~".~~~"id_unita_confezione~~~"~"   OP =~">=~"    EXP2 =~"19513~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"unita_confezione~~~".~~~"id_unita_confezione~~~"~"   OP =~"<=~"    EXP2 =~"19599~" ) ) " update="prezzo" updatewhere=1 updatekeyinplace=yes )
