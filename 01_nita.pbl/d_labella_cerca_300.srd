table(column=(type=long updatewhereclause=yes identity=yes name=orafo_aper_partita_id_partita dbname="orafo_aper_partita.id_partita" )
 column=(type=char(1) updatewhereclause=yes name=orafo_aper_partita_stato dbname="orafo_aper_partita.stato" )
 column=(type=long updatewhereclause=yes name=orafo_aper_partita_id_documento dbname="orafo_aper_partita.id_documento" )
 column=(type=decimal(4) updatewhereclause=yes name=orafo_aper_partita_val_apertura dbname="orafo_aper_partita.val_apertura" )
 column=(type=decimal(4) updatewhereclause=yes name=orafo_aper_partita_val_scarico_apertura dbname="orafo_aper_partita.val_scarico_apertura" )
 column=(type=decimal(4) updatewhereclause=yes name=orafo_scar_partita_val_scarico_scarico dbname="orafo_scar_partita.val_scarico_scarico" )
 column=(type=decimal(4) updatewhereclause=yes name=riga_documento_calo dbname="riga_documento.calo" )
 column=(type=decimal(4) updatewhereclause=yes name=riga_documento_fino dbname="riga_documento.fino" )
 column=(type=decimal(4) updatewhereclause=yes name=riga_documento_peso_netto dbname="riga_documento.peso_netto" )
 column=(type=char(32) updatewhereclause=yes name=documento_num_documento dbname="documento.num_documento" )
 column=(type=date updatewhereclause=yes name=documento_data_documento dbname="documento.data_documento" )
 column=(type=long updatewhereclause=yes name=orafo_titolo_id_metallo dbname="orafo_titolo.id_metallo" )
 column=(type=long updatewhereclause=yes name=orafo_scar_partita_id_riga_documento dbname="orafo_scar_partita.id_riga_documento" )
 column=(type=date updatewhereclause=yes name=documento_data_documento dbname="documento.data_documento" )
 column=(type=char(32) updatewhereclause=yes name=documento_num_documento dbname="documento.num_documento" )
 retrieve="SELECT 
    a.id_partita,
    a.stato,
    a.id_documento,
    a.val_apertura,
    a.val_scarico AS val_scarico_apertura,
    s.val_scarico AS val_scarico_scarico,
    r.calo,
    r.fino,
    r.peso_netto,
    d.num_documento,
    d.data_documento, t.id_metallo, s.id_riga_documento, d2.data_documento, d2.num_documento
FROM orafo_scar_partita s
LEFT JOIN orafo_aper_partita a
       ON s.id_partita = a.id_partita
LEFT JOIN riga_documento r
       ON s.id_riga_documento = r.id_riga_partita   -- ← controlla se è la chiave giusta!
LEFT JOIN DOCUMENTO d2
on r.id_documento= d2.id_documento
JOIN documento d
       ON a.id_documento = d.id_documento
JOIN orafo_titolo t
       ON a.id_titolo = t.id_titolo
WHERE d.data_documento >= :da_data
  AND d.data_documento <= :a_data
  AND d.id_sog_commerciale = 16
  AND t.id_metallo = 3;

" filter=" orafo_aper_partita_id_partita =84148"arguments=(("da_data", date),("a_data", date))  sort="documento_data_documento A documento_num_documento A " )
