 column=(type=decimal(4) updatewhereclause=yes name=riga_documento_peso_lordo dbname="riga_documento.peso_lordo" dbalias=".peso_lordo" )
 column=(type=decimal(5) updatewhereclause=yes name=riga_documento_provv_imp_carea_2 dbname="riga_documento.provv_imp_carea_2" dbalias=".provv_imp_carea_2" )
 column=(type=char(2) updatewhereclause=yes name=registro_tipo_registro dbname="registro.tipo_registro" dbalias=".tipo_registro" )
 column=(type=long updatewhereclause=yes name=c_conta_righe dbname="c_conta_righe" )
 column=(type=char(2) updatewhereclause=yes name=orafo_metallo_codice dbname="orafo_metallo.codice" dbalias=".codice" )
 column=(type=decimal(4) updatewhereclause=yes name=riga_documento_provv_imp_agente_2 dbname="riga_documento.provv_imp_agente_2" dbalias=".provv_imp_agente_2" )
 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"documento~" )  TABLE(NAME=~"riga_documento~" )  TABLE(NAME=~"registro~" )  TABLE(NAME=~"orafo_titolo~" )  TABLE(NAME=~"orafo_metallo~" )  TABLE(NAME=~"articolo~" ) COLUMN(NAME=~"documento.id_documento~") COLUMN(NAME=~"documento.num_progressivo~") COLUMN(NAME=~"documento.num_documento~") COLUMN(NAME=~"documento.data_documento~") COLUMN(NAME=~"riga_documento.id_riga_documento~") COLUMN(NAME=~"riga_documento.id_articolo~") COLUMN(NAME=~"riga_documento.num_riga~") COLUMN(NAME=~"riga_documento.descrizione~") COLUMN(NAME=~"riga_documento.quantita~") COLUMN(NAME=~"riga_documento.peso_netto~") COLUMN(NAME=~"riga_documento.peso_lordo~") COLUMN(NAME=~"riga_documento.provv_imp_carea_2~") COLUMN(NAME=~"registro.tipo_registro~") COMPUTE(NAME=~"(select count(id_riga_documento) from riga_documento where id_documento=~~~"documento~~~".~~~"id_documento~~~") as c_conta_righe~") COLUMN(NAME=~"orafo_metallo.codice~") COLUMN(NAME=~"riga_documento.provv_imp_agente_2~")    JOIN (LEFT=~"riga_documento.id_documento~"    OP =~"=~"RIGHT=~"documento.id_documento~" )    JOIN (LEFT=~"documento.id_registro~"    OP =~"=~"RIGHT=~"registro.id_registro~" )    JOIN (LEFT=~"orafo_metallo.id_metallo~"    OP =~"=~"RIGHT=~"orafo_titolo.id_metallo~" )    JOIN (LEFT=~"articolo.id_titolo~"    OP =~"=~"RIGHT=~"orafo_titolo.id_titolo~" )    JOIN (LEFT=~"riga_documento.id_articolo~"    OP =~"=~"RIGHT=~"articolo.id_articolo~" )WHERE(    EXP1 =~"~~~"registro~~~".~~~"tipo_registro~~~"~"   OP =~"=~"    EXP2 =~"'DV'~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"documento~~~".~~~"data_documento~~~"~"   OP =~">=~"    EXP2 =~"'2018-07-16'~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"orafo_metallo~~~".~~~"codice~~~"~"   OP =~"<>~"    EXP2 =~"'AG'~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"(~~~"riga_documento~~~".~~~"peso_lordo~~~"~"   OP =~">~"    EXP2 =~"0~"    LOGIC =~"or~" ) WHERE(    EXP1 =~"~~~"riga_documento~~~".~~~"provv_imp_carea_2~~~"~"   OP =~">~"    EXP2 =~"0~"    LOGIC =~"or~" ) WHERE(    EXP1 =~"~~~"riga_documento~~~".~~~"provv_imp_agente_2~~~"~"   OP =~">~"    EXP2 =~"0)~" ) ) "  sort="documento_data_documento A documento_num_progressivo A orafo_metallo_codice A " )
