 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"galvanica~" )  TABLE(NAME=~"riga_documento~" ) COLUMN(NAME=~"riga_documento.id_articolo~") COLUMN(NAME=~"riga_documento.descrizione~") COLUMN(NAME=~"galvanica.lavorazione~") COLUMN(NAME=~"riga_documento.dim_l~") COLUMN(NAME=~"riga_documento.quantita~")    JOIN (LEFT=~"riga_documento.id_gruppo_agenti_2~"    OP =~"=~"RIGHT=~"galvanica.id_galvanica~"    OUTER1 =~"riga_documento.id_gruppo_agenti_2~" )WHERE(    EXP1 =~"~~~"riga_documento~~~".~~~"id_documento~~~"~"   OP =~"=~"    EXP2 =~":id_doc~" ) ) ARG(NAME = ~"id_doc~" TYPE = number) " arguments=(("id_doc", number)) )
