 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"articolo_pr~" )  TABLE(NAME=~"prezzo_pr~" )  TABLE(NAME=~"unita_confezione_pr~" ) COLUMN(NAME=~"prezzo_pr.id_variazione~") COLUMN(NAME=~"articolo_pr.codice~") COLUMN(NAME=~"prezzo_pr.prezzo~") COLUMN(NAME=~"prezzo_pr.coef_calo~") COLUMN(NAME=~"prezzo_pr.prezzo_manifattura~") COLUMN(NAME=~"prezzo_pr.costo_imballo~") COLUMN(NAME=~"prezzo_pr.galvanica~") COLUMN(NAME=~"prezzo_pr.des_1~") COLUMN(NAME=~"prezzo_pr.des_2~") COLUMN(NAME=~"prezzo_pr.des_3~") COLUMN(NAME=~"prezzo_pr.ultima_modifica~") COLUMN(NAME=~"prezzo_pr.id_unita_confezione~")    JOIN (LEFT=~"articolo_pr.id_articolo~"    OP =~"=~"RIGHT=~"unita_confezione_pr.id_articolo~" )    JOIN (LEFT=~"unita_confezione_pr.id_unita_confezione~"    OP =~"=~"RIGHT=~"prezzo_pr.id_unita_confezione~" )WHERE(    EXP1 =~"~~~"prezzo_pr~~~".~~~"id_variazione~~~"~"   OP =~"=~"    EXP2 =~":id_var~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"unita_confezione_pr~~~".~~~"unita_base~~~"~"   OP =~"=~"    EXP2 =~"'S'~" ) ) ARG(NAME = ~"id_var~" TYPE = number) " arguments=(("id_var", number))  sort="articolo_pr_codice A " )
