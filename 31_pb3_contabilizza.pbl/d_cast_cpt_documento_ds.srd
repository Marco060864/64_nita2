//objectcomments DataWindow utilizzata nei DataStore di w_contab_documento_ff
release 6;
datawindow(units=0 timer_interval=0 color=79741120 processing=1 print.documentname="" print.orientation = 0 print.margin.left = 110 print.margin.right = 110 print.margin.top = 97 print.margin.bottom = 97 print.paper.source = 0 print.paper.size = 0 print.prompt=no print.buttons=no print.preview.buttons=no grid.lines=0 )
header(height=76 color="536870912" )
summary(height=16 color="536870912" )
footer(height=72 color="553648127" )
detail(height=72 color="553648127" )
table(column=(type=long update=yes updatewhereclause=yes name=id_conto dbname="cast_cpt_documento.id_conto" )
 column=(type=char(1) update=yes updatewhereclause=yes name=tipo_riga_cpt dbname="cast_cpt_documento.tipo_riga_cpt" )
 column=(type=decimal(0) update=yes updatewhereclause=yes name=val_imponibile dbname="cast_cpt_documento.val_imponibile" )
 column=(type=decimal(0) update=yes updatewhereclause=yes name=val_imp_scontato dbname="cast_cpt_documento.val_imp_scontato" )
 column=(type=decimal(0) update=yes updatewhereclause=yes name=val_omaggi dbname="cast_cpt_documento.val_omaggi" )
 column=(type=decimal(0) update=yes updatewhereclause=yes name=val_spese dbname="cast_cpt_documento.val_spese" )
 column=(type=char(1) updatewhereclause=yes name=tipo_registro dbname="tipo_registro" )
 column=(type=char(1) updatewhereclause=yes name=tipo_fattura dbname="tipo_fattura" )
 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"cast_cpt_documento~" ) COLUMN(NAME=~"cast_cpt_documento.id_conto~") COLUMN(NAME=~"cast_cpt_documento.tipo_riga_cpt~") COLUMN(NAME=~"cast_cpt_documento.val_imponibile~") COLUMN(NAME=~"cast_cpt_documento.val_imp_scontato~") COLUMN(NAME=~"cast_cpt_documento.val_omaggi~") COLUMN(NAME=~"cast_cpt_documento.val_spese~") COMPUTE(NAME=~"tipo_registro = :as_tipo_registro~") COMPUTE(NAME=~"tipo_fattura = :ac_tipo_fattura~")WHERE(    EXP1 =~"~~~"cast_cpt_documento~~~".~~~"id_documento~~~"~"   OP =~"=~"    EXP2 =~":al_id_documento~" ) ) ARG(NAME = ~"al_id_documento~" TYPE = number)  ARG(NAME = ~"as_tipo_registro~" TYPE = string)  ARG(NAME = ~"ac_tipo_fattura~" TYPE = string) " arguments=(("al_id_documento", number),("as_tipo_registro", string),("ac_tipo_fattura", string))  sort="sort A " )
