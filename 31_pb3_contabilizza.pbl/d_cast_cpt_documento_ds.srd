compute(band=detail alignment="1" expression="IF ( (tipo_riga_cpt = 'S'),  val_imp_scontato , 0  )"border="0" color="0" x="1842" y="4" height="64" width="256" format="[general]"  name=val_imp_scontato_isn  font.face="Arial" font.height="-8" font.weight="400"  font.family="2" font.pitch="2" font.charset="0" background.mode="2" background.color="16777215" )
compute(band=detail alignment="1" expression="IF ( (tipo_riga_cpt = 'S'),  val_spese , 0  )"border="0" color="0" x="2107" y="4" height="64" width="256" format="[general]"  name=val_spese_isn  font.face="Arial" font.height="-8" font.weight="400"  font.family="2" font.pitch="2" font.charset="0" background.mode="2" background.color="16777215" )
column(band=detail id=7 alignment="0" tabsequence=32766 border="0" color="0" x="2373" y="4" height="64" width="160" format="[general]"  name=tipo_registro edit.limit=0 edit.case=any edit.autoselect=yes  font.face="Arial" font.height="-8" font.weight="400"  font.family="2" font.pitch="2" font.charset="0" background.mode="2" background.color="1090519039" )
column(band=detail id=8 alignment="0" tabsequence=32766 border="0" color="0" x="2542" y="4" height="64" width="265" format="[general]"  name=tipo_fattura edit.limit=0 edit.case=any edit.autoselect=yes  font.face="Arial" font.height="-8" font.weight="400"  font.family="2" font.pitch="2" font.charset="0" background.mode="2" background.color="1090519039" )
compute(band=detail alignment="0" expression="CASE( as_tipo_registro
   WHEN ~"IA~" THEN
      (CASE (ac_tipo_fattura
         WHEN ~"N~" THEN (CASE (tipo_riga_cpt
               WHEN ~"S~" THEN ~"A~"
               WHEN ~"C~" THEN ~"D~"
               WHEN ~"I~" THEN ~"D~"
               WHEN ~"N~" THEN ~"D~"))

         WHEN ~"C~" THEN (CASE (tipo_riga_cpt
               WHEN ~"S~" THEN ~"D~"
               WHEN ~"C~" THEN ~"A~"
               WHEN ~"I~" THEN ~"A~"
               WHEN ~"N~" THEN ~"A~"))

         WHEN ~"D~" THEN (CASE (tipo_riga_cpt
               WHEN ~"S~" THEN ~"A~"
               WHEN ~"C~" THEN ~"D~"
               WHEN ~"I~" THEN ~"D~"
               WHEN ~"N~" THEN ~"D~"))))
   WHEN ~"IV~",~"IC~" THEN
      (CASE (ac_tipo_fattura
         WHEN ~"N~" THEN (CASE (tipo_riga_cpt
               WHEN ~"S~" THEN ~"D~"
               WHEN ~"C~" THEN ~"A~"
               WHEN ~"I~" THEN ~"A~"
               WHEN ~"N~" THEN ~"A~"))

         WHEN ~"C~" THEN (CASE (tipo_riga_cpt
               WHEN ~"S~" THEN ~"A~"
               WHEN ~"C~" THEN ~"D~"
               WHEN ~"I~" THEN ~"D~"
               WHEN ~"N~" THEN ~"D~"))

         WHEN ~"D~" THEN (CASE (tipo_riga_cpt
               WHEN ~"S~" THEN ~"D~"
               WHEN ~"C~" THEN ~"A~"
               WHEN ~"I~" THEN ~"A~"
               WHEN ~"N~" THEN ~"A~")))))
"border="0" color="0" x="2816" y="4" height="64" width="210" format="[general]"  name=segno  font.face="Arial" font.height="-8" font.weight="400"  font.family="2" font.pitch="2" font.charset="0" background.mode="2" background.color="1090519039" )
compute(band=detail alignment="0" expression="case( tipo_riga_cpt 
	when ~"S~" then 1
	when ~"C~" then 2
	when ~"I~" then 3
	when ~"N~" then 4
	else 99)

"border="0" color="0" x="3035" y="4" height="64" width="165" format="[general]"  name=sort  font.face="Arial" font.height="-8" font.weight="400"  font.family="2" font.pitch="2" font.charset="0" background.mode="2" background.color="1090519039" )
compute(band=footer alignment="1" expression="sum (val_imp_scontato_isn) + sum (val_spese_isn)"border="0" color="0" x="1842" y="4" height="64" width="256" format="[general]"  name=tot_documento  font.face="Arial" font.height="-8" font.weight="400"  font.family="2" font.pitch="2" font.charset="0" background.mode="2" background.color="16777215" )
compute(band=footer alignment="0" expression="sum (val_omaggi)"border="0" color="0" x="2107" y="0" height="76" width="256" format="[general]"  name=tot_omaggi  font.face="Arial" font.height="-12" font.weight="400"  font.family="2" font.pitch="2" font.charset="0" background.mode="2" background.color="16777215" )
htmltable(border="1" cellpadding="0" cellspacing="0" generatecss="no" nowrap="yes") ␀