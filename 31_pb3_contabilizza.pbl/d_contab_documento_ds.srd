table(column=(type=long updatewhereclause=yes identity=yes name=id_documento dbname="documento.id_documento" )
 column=(type=decimal(0) updatewhereclause=yes name=num_progressivo dbname="documento.num_progressivo" )
 column=(type=date updatewhereclause=yes name=data_registrazione dbname="documento.data_registrazione" )
 column=(type=char(16) updatewhereclause=yes name=documento_num_documento dbname="documento.num_documento" )
 column=(type=date updatewhereclause=yes name=documento_data_documento dbname="documento.data_documento" )
 column=(type=long updatewhereclause=yes name=documento_id_valuta dbname="documento.id_valuta" )
 column=(type=decimal(4) updatewhereclause=yes name=documento_cambio dbname="documento.cambio" )
 column=(type=date updatewhereclause=yes name=documento_data_competenza dbname="documento.data_competenza" )
 column=(type=char(40) updatewhereclause=yes name=documento_des_contabile dbname="documento.des_contabile" )
 column=(type=long updatewhereclause=yes name=documento_id_sog_commerciale dbname="documento.id_sog_commerciale" )
