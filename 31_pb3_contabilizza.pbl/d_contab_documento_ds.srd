 column=(type=long updatewhereclause=yes name=documento_id_con_pagamento dbname="documento.id_con_pagamento" )
 column=(type=long updatewhereclause=yes name=documento_id_sog_commerciale_vettore dbname="documento.id_sog_commerciale_vettore" )
 column=(type=long updatewhereclause=yes name=id_tab_iva_acconto dbname="documento.id_tab_iva_acconto" )
 column=(type=decimal(4) updatewhereclause=yes name=imp_acconto dbname="documento.imp_acconto" )
 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"documento~" )  TABLE(NAME=~"prof_documento~" ) COLUMN(NAME=~"documento.id_documento~") COLUMN(NAME=~"documento.num_progressivo~") COLUMN(NAME=~"documento.data_registrazione~") COLUMN(NAME=~"documento.num_documento~") COLUMN(NAME=~"documento.data_documento~") COLUMN(NAME=~"documento.id_valuta~") COLUMN(NAME=~"documento.cambio~") COLUMN(NAME=~"documento.data_competenza~") COLUMN(NAME=~"documento.des_contabile~") COLUMN(NAME=~"documento.id_sog_commerciale~") COLUMN(NAME=~"documento.id_azienda~") COLUMN(NAME=~"documento.tipo_fattura~") COLUMN(NAME=~"documento.id_prof_documento~") COLUMN(NAME=~"documento.id_prof_registrazione~") COLUMN(NAME=~"prof_documento.id_prof_registrazione~") COLUMN(NAME=~"documento.id_con_pagamento~") COLUMN(NAME=~"documento.id_sog_commerciale_vettore~") COLUMN(NAME=~"documento.id_tab_iva_acconto~") COLUMN(NAME=~"documento.imp_acconto~")    JOIN (LEFT=~"prof_documento.id_prof_documento~"    OP =~"=~"RIGHT=~"documento.id_prof_documento~" )WHERE(    EXP1 =~"~~~"documento~~~".~~~"id_registro~~~"~"   OP =~"=~"    EXP2 =~":al_id_registro~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"documento~~~".~~~"num_progressivo~~~"~"   OP =~">=~"    EXP2 =~":adc_numero_inizio~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"documento~~~".~~~"num_progressivo~~~"~"   OP =~"<=~"    EXP2 =~":adc_numero_fine~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"documento~~~".~~~"data_registrazione~~~"~"   OP =~">=~"    EXP2 =~":ad_data_dal~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"documento~~~".~~~"data_registrazione~~~"~"   OP =~"<=~"    EXP2 =~":ad_data_al~" ) ) ORDER(NAME=~"documento.num_progressivo~" ASC=yes ) ARG(NAME = ~"al_id_registro~" TYPE = number)  ARG(NAME = ~"adc_numero_inizio~" TYPE = number)  ARG(NAME = ~"adc_numero_fine~" TYPE = number)  ARG(NAME = ~"ad_data_dal~" TYPE = date)  ARG(NAME = ~"ad_data_al~" TYPE = date) " arguments=(("al_id_registro", number),("adc_numero_inizio", number),("adc_numero_fine", number),("ad_data_dal", date),("ad_data_al", date)) )
