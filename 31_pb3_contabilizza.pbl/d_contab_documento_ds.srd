 column=(type=char(1) updatewhereclause=yes name=documento_tipo_fattura dbname="documento.tipo_fattura" )
 column=(type=long updatewhereclause=yes name=documento_id_prof_documento dbname="documento.id_prof_documento" )
 column=(type=long updatewhereclause=yes name=id_prof_registrazione dbname="documento.id_prof_registrazione" )
