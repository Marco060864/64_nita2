 retrieve="PBSELECT( VERSION(400) DISTINCT ()TABLE(NAME=~"cast_iva_documento~" ) COLUMN(NAME=~"cast_iva_documento.id_tab_iva~") COLUMN(NAME=~"cast_iva_documento.val_omaggi~") COLUMN(NAME=~"cast_iva_documento.val_imponibile~") COLUMN(NAME=~"cast_iva_documento.val_imp_scontato~") COLUMN(NAME=~"cast_iva_documento.val_spese~") COLUMN(NAME=~"cast_iva_documento.val_tot_imp_v~") COLUMN(NAME=~"cast_iva_documento.val_tot_imp_l~") COLUMN(NAME=~"cast_iva_documento.val_tot_iva_v~") COLUMN(NAME=~"cast_iva_documento.val_tot_iva_l~")WHERE(    EXP1 =~"~~~"cast_iva_documento~~~".~~~"id_documento~~~"~"   OP =~"=~"    EXP2 =~":al_id_documento~" ) ) ARG(NAME = ~"al_id_documento~" TYPE = number) " arguments=(("al_id_documento", number)) )
