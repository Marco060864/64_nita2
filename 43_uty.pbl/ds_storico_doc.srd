footer(height=0 color="536870912" )
detail(height=84 color="536870912" )
table(column=(type=decimal(0) updatewhereclause=yes name=documento_num_progressivo dbname="documento.num_progressivo" )
 column=(type=date updatewhereclause=yes name=documento_data_registrazione dbname="documento.data_registrazione" )
 column=(type=char(16) updatewhereclause=yes name=documento_num_documento dbname="documento.num_documento" )
 column=(type=date updatewhereclause=yes name=documento_data_documento dbname="documento.data_documento" )
 column=(type=char(8) updatewhereclause=yes name=sog_commerciale_gen_codice dbname="sog_commerciale_gen.codice" )
 column=(type=char(40) updatewhereclause=yes name=sog_commerciale_gen_rag_soc_1 dbname="sog_commerciale_gen.rag_soc_1" )
 column=(type=char(40) updatewhereclause=yes name=registro_descrizione dbname="registro.descrizione" )
 column=(type=long updatewhereclause=yes name=prof_documento_id_prof_registrazione dbname="prof_documento.id_prof_registrazione" )
 column=(type=char(40) updatewhereclause=yes name=prof_documento_descrizione dbname="prof_documento.descrizione" )
 column=(type=char(8) updatewhereclause=yes name=prof_documento_codice dbname="prof_documento.codice" )
 column=(type=long updatewhereclause=yes name=id_riga_doc_provenienza dbname="riga_documento.id_riga_doc_provenienza" )
 column=(type=long updatewhereclause=yes name=id_documento dbname="riga_documento.id_documento" )
 column=(type=char(32) updatewhereclause=yes name=articolo_codice dbname="articolo.codice" )
 column=(type=char(80) updatewhereclause=yes name=articolo_descrizione dbname="articolo.descrizione" )
 column=(type=decimal(0) updatewhereclause=yes name=riga_documento_num_riga dbname="riga_documento.num_riga" )
 column=(type=decimal(4) updatewhereclause=yes name=riga_documento_quantita dbname="riga_documento.quantita" )
 column=(type=char(1) updatewhereclause=yes name=riga_doc dbname="riga_doc" )
 column=(type=decimal(4) updatewhereclause=yes name=riga_documento_prezzo dbname="riga_documento.prezzo" )
 retrieve="  SELECT ~"documento~".~"num_progressivo~",   
         ~"documento~".~"data_registrazione~",   
         ~"documento~".~"num_documento~",   
         ~"documento~".~"data_documento~",   
         ~"sog_commerciale_gen~".~"codice~",   
         ~"sog_commerciale_gen~".~"rag_soc_1~",   
         ~"registro~".~"descrizione~",   
         ~"prof_documento~".~"id_prof_registrazione~",   
         ~"prof_documento~".~"descrizione~",   
         ~"prof_documento~".~"codice~",   
         ~"riga_documento~".~"id_riga_doc_provenienza~",   
         ~"riga_documento~".~"id_documento~",   
         ~"articolo~".~"codice~",   
         ~"articolo~".~"descrizione~",   
         ~"riga_documento~".~"num_riga~",   
         ~"riga_documento~".~"quantita~",   
         cast('S' as char(1)) as riga_doc,   
         ~"riga_documento~".~"prezzo~"  
    FROM ~"documento~",   
         ~"sog_commerciale_gen~",   
         ~"prof_documento~",   
         ~"registro~",   
         ~"riga_documento~",   
         ~"articolo~"  
   WHERE ( ~"documento~".~"id_sog_commerciale~" = ~"sog_commerciale_gen~".~"id_sog_commerciale~" ) and  
         ( ~"prof_documento~".~"id_prof_documento~" = ~"documento~".~"id_prof_documento~" ) and  
         ( ~"registro~".~"id_registro~" = ~"documento~".~"id_registro~" ) and  
         ( ~"documento~".~"id_documento~" = ~"riga_documento~".~"id_documento~" ) and  
         ( ~"articolo~".~"id_articolo~" = ~"riga_documento~".~"id_articolo~" ) and  
         ( ( ~"riga_documento~".~"id_documento~" = :ra_id_riga_documento ) )    
" arguments=(("ra_id_riga_documento", number)) )
