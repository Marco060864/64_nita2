 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"articolo~" )  TABLE(NAME=~"cat_codifica~" )  TABLE(NAME=~"cat_com_articolo~" )  TABLE(NAME=~"cat_fiscale~" )  TABLE(NAME=~"cat_merceologica~" )  TABLE(NAME=~"anagrafica~" )  TABLE(NAME=~"reparto~" )  TABLE(NAME=~"sog_commerciale~" )  TABLE(NAME=~"tab_iva~" )  TABLE(NAME=~"unita_confezione~" )  TABLE(NAME=~"unita_misura~" ALIAS=~"unita_misura_a~" )  TABLE(NAME=~"unita_misura~" ALIAS=~"unita_misura_b~" )  TABLE(NAME=~"distinta~" ) COLUMN(NAME=~"articolo.descrizione~") COLUMN(NAME=~"cat_codifica.codice~") COLUMN(NAME=~"cat_codifica.descrizione~") COLUMN(NAME=~"articolo.rif_catalogo~") COLUMN(NAME=~"cat_com_articolo.codice~") COLUMN(NAME=~"cat_com_articolo.descrizione~") COLUMN(NAME=~"cat_merceologica.codice~") COLUMN(NAME=~"cat_merceologica.descrizione~") COLUMN(NAME=~"cat_fiscale.codice~") COLUMN(NAME=~"cat_fiscale.descrizione~") COLUMN(NAME=~"articolo.des_breve~") COLUMN(NAME=~"reparto.codice~") COLUMN(NAME=~"reparto.descrizione~") COLUMN(NAME=~"sog_commerciale.codice~") COLUMN(NAME=~"anagrafica.rag_soc_1~") COLUMN(NAME=~"tab_iva.codice~") COLUMN(NAME=~"tab_iva.des_breve~") COLUMN(NAME=~"articolo.cod_intrastat~") COLUMN(NAME=~"articolo.data_ora_creazione~") COLUMN(NAME=~"articolo.data_ora_ult_cambiamento~") COLUMN(NAME=~"articolo.data_ora_ult_var_stato~") COLUMN(NAME=~"articolo.stampa_in_inventario~") COLUMN(NAME=~"articolo.stampa_in_listini~") COLUMN(NAME=~"articolo.stampa_in_giornale~") COLUMN(NAME=~"articolo.stampa_in_schede~") COLUMN(NAME=~"articolo.ges_lotti~") COLUMN(NAME=~"articolo.ges_matricole~") COLUMN(NAME=~"articolo.ges_produzione~") COLUMN(NAME=~"articolo.utilizzabile~") COLUMN(NAME=~"articolo.stato~") COLUMN(NAME=~"articolo.ges_locazioni~") COLUMN(NAME=~"articolo.id_azienda~") COLUMN(NAME=~"articolo.id_articolo~") COLUMN(NAME=~"articolo.id_cat_codifica~") COLUMN(NAME=~"articolo.codice~") COLUMN(NAME=~"unita_misura_a.simbolo~") COLUMN(NAME=~"unita_misura_a.descrizione~") COLUMN(NAME=~"unita_misura_b.simbolo~") COLUMN(NAME=~"unita_misura_b.descrizione~") COLUMN(NAME=~"unita_misura_a.conversione~") COLUMN(NAME=~"unita_misura_b.conversione~") COLUMN(NAME=~"unita_confezione.id_unita_confezione~") COLUMN(NAME=~"unita_confezione.codice~") COLUMN(NAME=~"unita_confezione.descrizione~") COLUMN(NAME=~"unita_confezione.unita_base~") COLUMN(NAME=~"articolo.id_cat_com_articolo~") COLUMN(NAME=~"articolo.id_cat_merceologica~") COLUMN(NAME=~"articolo.id_cat_fiscale~") COLUMN(NAME=~"articolo.id_anagrafica~") COLUMN(NAME=~"articolo.id_sog_commerciale~") COLUMN(NAME=~"articolo.id_gruppo_articoli~") COLUMN(NAME=~"articolo.id_reparto~") COLUMN(NAME=~"articolo.id_tab_iva~") COLUMN(NAME=~"articolo.giorni_invenduto~") COLUMN(NAME=~"articolo.id_cif~") COLUMN(NAME=~"articolo.costo_aggiuntivo~") COLUMN(NAME=~"articolo.id_valuta~") COLUMN(NAME=~"articolo.id_unita_conf_base~") COLUMN(NAME=~"articolo.prod_interna~") COLUMN(NAME=~"articolo.note~") COMPUTE(NAME=~"CAST(0 as decimal(18,4)) as qta~") COMPUTE(NAME=~"CAST(fn_esi_disp2(1, ~~~"articolo~~~".~~~"id_articolo~~~", 0, year(today()), month(today()),0) AS CHAR(100)) AS ret_esi_attuale~") COMPUTE(NAME=~"CAST( SUBSTRING(ret_esi_attuale, 1, 20) AS NUMERIC(18,4) ) AS esi_fisica_attuale~") COMPUTE(NAME=~"CAST( SUBSTRING(ret_esi_attuale, 21, 20) AS NUMERIC(18,4) ) AS esi_fiscale_attuale~") COMPUTE(NAME=~"CAST( SUBSTRING(ret_esi_attuale, 41, 20) AS NUMERIC(18,4) ) AS disponibile~")    JOIN (LEFT=~"cat_fiscale.id_cat_fiscale~"    OP =~"=~"RIGHT=~"articolo.id_cat_fiscale~"    OUTER2 =~"articolo.id_cat_fiscale~" )    JOIN (LEFT=~"cat_merceologica.id_cat_merceologica~"    OP =~"=~"RIGHT=~"articolo.id_cat_merceologica~"    OUTER2 =~"articolo.id_cat_merceologica~" )    JOIN (LEFT=~"anagrafica.id_anagrafica~"    OP =~"=~"RIGHT=~"articolo.id_anagrafica~"    OUTER2 =~"articolo.id_anagrafica~" )    JOIN (LEFT=~"sog_commerciale.id_sog_commerciale~"    OP =~"=~"RIGHT=~"articolo.id_sog_commerciale~"    OUTER2 =~"articolo.id_sog_commerciale~" )    JOIN (LEFT=~"tab_iva.id_tab_iva~"    OP =~"=~"RIGHT=~"articolo.id_tab_iva~"    OUTER2 =~"articolo.id_tab_iva~" )    JOIN (LEFT=~"reparto.id_reparto~"    OP =~"=~"RIGHT=~"articolo.id_reparto~"    OUTER2 =~"articolo.id_reparto~" )    JOIN (LEFT=~"unita_misura_a.id_unita_misura~"    OP =~"=~"RIGHT=~"unita_confezione.id_unita_mis_peso~"    OUTER2 =~"unita_confezione.id_unita_mis_peso~" )    JOIN (LEFT=~"unita_confezione.id_unita_mis_volume~"    OP =~"=~"RIGHT=~"unita_misura_b.id_unita_misura~"    OUTER1 =~"unita_confezione.id_unita_mis_volume~" )    JOIN (LEFT=~"cat_codifica.id_cat_codifica~"    OP =~"=~"RIGHT=~"articolo.id_cat_codifica~" )    JOIN (LEFT=~"cat_com_articolo.id_cat_com_articolo~"    OP =~"=~"RIGHT=~"articolo.id_cat_com_articolo~" )    JOIN (LEFT=~"unita_confezione.id_articolo~"    OP =~"=~"RIGHT=~"articolo.id_articolo~" )    JOIN (LEFT=~"distinta.id_articolo~"    OP =~"=~"RIGHT=~"articolo.id_articolo~" )WHERE(    EXP1 =~"~~~"articolo~~~".~~~"id_azienda~~~"~"   OP =~"in~"    EXP2 =~"(0,1)~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"unita_confezione~~~".~~~"unita_base~~~"~"   OP =~"=~"    EXP2 =~"'S'~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"articolo~~~".~~~"codice~~~"~"   OP =~">=~"    EXP2 =~":da_articolo~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"articolo~~~".~~~"codice~~~"~"   OP =~"<=~"    EXP2 =~":a_articolo~" ) ) ORDER(NAME=~"articolo.codice~" ASC=yes ) ARG(NAME = ~"da_articolo~" TYPE = string)  ARG(NAME = ~"a_articolo~" TYPE = string) " update="articolo" updatewhere=1 updatekeyinplace=yes retrieve.asneeded=yes arguments=(("da_articolo", string),("a_articolo", string)) )
