 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"documento~" )  TABLE(NAME=~"prof_documento~" )  TABLE(NAME=~"sog_commerciale_gen~" ) COLUMN(NAME=~"documento.num_documento~") COLUMN(NAME=~"documento.data_documento~") COLUMN(NAME=~"prof_documento.codice~") COLUMN(NAME=~"prof_documento.descrizione~") COLUMN(NAME=~"sog_commerciale_gen.codice~") COLUMN(NAME=~"sog_commerciale_gen.rag_soc_1~") COLUMN(NAME=~"documento.stampato~") COLUMN(NAME=~"documento.contabilizzato~") COLUMN(NAME=~"documento.evaso_totalmente~") COLUMN(NAME=~"documento.chius_forzata~") COLUMN(NAME=~"documento.sospeso~") COLUMN(NAME=~"documento.bloccato~") COLUMN(NAME=~"documento.id_documento~") COLUMN(NAME=~"documento.id_sog_commerciale~") COLUMN(NAME=~"documento.sconto_finanziario~") COLUMN(NAME=~"documento.sconto_fin_incondizionato~") COLUMN(NAME=~"documento.sconto_fin_cassa~") COLUMN(NAME=~"documento.id_registro~") COLUMN(NAME=~"documento.id_val_acconto~") COLUMN(NAME=~"documento.imp_acconto~") COLUMN(NAME=~"documento.id_tab_iva_acconto~") COMPUTE(NAME=~"CAST(0 as decimal ) as c_val_sc_merce_art_15~") COMPUTE(NAME=~"CAST(0 as decimal ) as c_val_sc_merce_iva~") COMPUTE(NAME=~"CAST(0 as decimal ) as c_val_omaggi~") COLUMN(NAME=~"documento.id_valuta~") COLUMN(NAME=~"documento.cambio~")    JOIN (LEFT=~"prof_documento.id_prof_documento~"    OP =~"=~"RIGHT=~"documento.id_prof_documento~" )    JOIN (LEFT=~"sog_commerciale_gen.id_sog_commerciale~"    OP =~"=~"RIGHT=~"documento.id_sog_commerciale~" )WHERE(    EXP1 =~"~~~"documento~~~".~~~"data_documento~~~"~"   OP =~">=~"    EXP2 =~":da_data_doc~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"documento~~~".~~~"data_documento~~~"~"   OP =~"<=~"    EXP2 =~":a_data_doc~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"prof_documento~~~".~~~"codice~~~"~"   OP =~">=~"    EXP2 =~":da_prof~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"prof_documento~~~".~~~"codice~~~"~"   OP =~"<=~"    EXP2 =~":a_prof~" ) ) ARG(NAME = ~"da_data_doc~" TYPE = date)  ARG(NAME = ~"a_data_doc~" TYPE = date)  ARG(NAME = ~"da_prof~" TYPE = string)  ARG(NAME = ~"a_prof~" TYPE = string) " update="documento" updatewhere=1 updatekeyinplace=yes arguments=(("da_data_doc", date),("a_data_doc", date),("da_prof", string),("a_prof", string)) )
