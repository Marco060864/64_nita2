 column=(type=long updatewhereclause=yes name=aa dbname="aa" )
 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"bol_mag~" )  TABLE(NAME=~"documento~" )  TABLE(NAME=~"riga_documento~" )  TABLE(NAME=~"sog_commerciale_gen~" )  TABLE(NAME=~"registro~" )  TABLE(NAME=~"unita_confezione~" )  TABLE(NAME=~"unita_misura~" ) COLUMN(NAME=~"documento.num_progressivo~") COLUMN(NAME=~"documento.data_registrazione~") COLUMN(NAME=~"documento.num_documento~") COLUMN(NAME=~"documento.data_documento~") COLUMN(NAME=~"registro.descrizione~") COLUMN(NAME=~"riga_documento.descrizione~") COLUMN(NAME=~"riga_documento.quantita~") COLUMN(NAME=~"riga_documento.prezzo~") COLUMN(NAME=~"riga_documento.tot_riga_val_riga~") COLUMN(NAME=~"unita_misura.simbolo~") COLUMN(NAME=~"sog_commerciale_gen.codice~") COLUMN(NAME=~"sog_commerciale_gen.rag_soc_1~") COLUMN(NAME=~"riga_documento.num_riga~") COLUMN(NAME=~"bol_mag.flag~") COMPUTE(NAME=~"cast(null as integer) as aa~")    JOIN (LEFT=~"riga_documento.id_documento~"    OP =~"=~"RIGHT=~"documento.id_documento~" )    JOIN (LEFT=~"documento.id_sog_commerciale~"    OP =~"=~"RIGHT=~"sog_commerciale_gen.id_sog_commerciale~" )    JOIN (LEFT=~"bol_mag.id_prof_documento~"    OP =~"=~"RIGHT=~"documento.id_prof_documento~" )    JOIN (LEFT=~"registro.id_registro~"    OP =~"=~"RIGHT=~"documento.id_registro~" )    JOIN (LEFT=~"unita_confezione.id_unita_confezione~"    OP =~"=~"RIGHT=~"riga_documento.id_unita_confezione~" )    JOIN (LEFT=~"unita_misura.id_unita_misura~"    OP =~"=~"RIGHT=~"unita_confezione.id_unita_misura~" )WHERE(    EXP1 =~"~~~"bol_mag~~~".~~~"flag~~~"~"   OP =~"=~"    EXP2 =~":ra_tipo~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"documento~~~".~~~"data_registrazione~~~"~"   OP =~">=~"    EXP2 =~":ra_da_data~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"documento~~~".~~~"data_registrazione~~~"~"   OP =~"<=~"    EXP2 =~":ra_a_data~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"sog_commerciale_gen~~~".~~~"codice~~~"~"   OP =~">=~"    EXP2 =~":ra_da_sog~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"sog_commerciale_gen~~~".~~~"codice~~~"~"   OP =~"<=~"    EXP2 =~":ra_a_sog~" ) ) ORDER(NAME=~"documento.data_registrazione~" ASC=yes )  ORDER(NAME=~"documento.num_progressivo~" ASC=yes )  ORDER(NAME=~"riga_documento.num_riga~" ASC=yes ) ARG(NAME = ~"ra_tipo~" TYPE = string)  ARG(NAME = ~"ra_da_data~" TYPE = date)  ARG(NAME = ~"ra_a_data~" TYPE = date)  ARG(NAME = ~"ra_da_sog~" TYPE = string)  ARG(NAME = ~"ra_a_sog~" TYPE = string)  ARG(NAME = ~"ra_cont~" TYPE = number) " arguments=(("ra_tipo", string),("ra_da_data", date),("ra_a_data", date),("ra_da_sog", string),("ra_a_sog", string),("ra_cont", number))  sort="documento_data_registrazione A documento_num_progressivo A documento_num_documento A " )
group(level=1 header.height=0 trailer.height=0 by=("documento_num_documento" ) header.color="536870912" trailer.color="536870912"  sort="documento_data_registrazione A sum(documento_num_progressivo for group 1) A count(documento_num_documento for group 1) A " )
