azzino.md_vis_fornitori~") COLUMN(NAME=~"caus_magazzino.md_imp_produzione~") COLUMN(NAME=~"caus_magazzino.md_ord_produzione~") COLUMN(NAME=~"caus_magazzino.md_qta_cl_clienti~") COLUMN(NAME=~"caus_magazzino.md_qta_cl_fornitori~") COLUMN(NAME=~"caus_magazzino.md_qta_cl_terzi~") COLUMN(NAME=~"caus_magazzino.md_gruppo_lib_1~") COLUMN(NAME=~"caus_magazzino.md_gruppo_lib_2~") COLUMN(NAME=~"caus_magazzino.md_gruppo_lib_3~") COLUMN(NAME=~"caus_magazzino.md_gruppo_lib_4~") COLUMN(NAME=~"caus_magazzino.md_ult_scarico~") COLUMN(NAME=~"caus_magazzino.mp_ult_scarico~") COLUMN(NAME=~"riga_documento.peso_netto~") COLUMN(NAME=~"riga_documento.tot_riga_val_az~") COLUMN(NAME=~"riga_documento.qta_un_base~") COLUMN(NAME=~"documento.data_registrazione~") COMPUTE(NAME=~"cast(year(~~~"documento~~~".~~~"data_registrazione~~~") as numeric(4)) as anno~") COMPUTE(NAME=~"cast(month(~~~"documento~~~".~~~"data_registrazione~~~") as numeric(2)) as mese~")    JOIN (LEFT=~"unita_misura.id_unita_misura~"    OP =~"=~"RIGHT=~"unita_confezione.id_unita_misura~"    OUTER2 =~"unita_confezione.id_unita_misura~" )    JOIN (LEFT=~"riga_documento.id_documento~"    OP =~"=~"RIGHT=~"documento.id_documento~" )    JOIN (LEFT=~"riga_documento.id_caus_magazzino~"    OP =~"=~"RIGHT=~"caus_magazzino.id_caus_magazzino~" )    JOIN (LEFT=~"documento.id_azienda~"    OP =~"=~"RIGHT=~"azienda.id_azienda~" )    JOIN (LEFT=~"unita_confezione.id_unita_confezione~"    OP =~"=~"RIGHT=~"riga_documento.id_unita_confezione~" )) "  sort="azienda_id_attivita A azienda_id_esercizio A riga_documento_id_locazione_1 A anno A mese A riga_documento_id_articolo A " )
