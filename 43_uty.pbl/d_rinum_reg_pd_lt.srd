table(column=(type=decimal(0) update=yes updatewhereclause=yes key=yes name=num_prog dbname="reg_pd.num_progressivo" validation=" real(gettext())  >= 0" validationmsg="'Immettere un valore >= 0'" )
 column=(type=date updatewhereclause=yes key=yes name=reg_pd_data_registrazione dbname="reg_pd.data_registrazione" )
 column=(type=date updatewhereclause=yes name=reg_pd_data_competenza dbname="reg_pd.data_competenza" )
 column=(type=char(8) updatewhereclause=yes name=prof_registrazione_codice dbname="prof_registrazione.codice" )
 column=(type=decimal(4) updatewhereclause=yes name=reg_pd_cambio dbname="reg_pd.cambio" validation=" real(gettext())  >= 0" validationmsg="'Immettere un valore >= 0'" )
 column=(type=char(40) updatewhereclause=yes name=reg_pd_descrizione dbname="reg_pd.descrizione" )
 column=(type=date updatewhereclause=yes name=reg_pd_data_documento dbname="reg_pd.data_documento" )
 column=(type=char(16) updatewhereclause=yes name=reg_pd_num_documento dbname="reg_pd.num_documento" validation=" real(gettext())  >= 0" validationmsg="'Immettere un valore >= 0'" )
 column=(type=long updatewhereclause=yes name=reg_pd_id_azienda dbname="reg_pd.id_azienda" initial="1" )
 column=(type=long updatewhereclause=yes identity=yes name=id_reg_pd dbname="reg_pd.id_reg_pd" )
 column=(type=decimal(0) updatewhereclause=yes name=reg_pd_importo dbname="reg_pd.importo" validation=" real(gettext())  >= 0" validationmsg="'Immettere un valore >= 0'" )
 column=(type=char(1) updatewhereclause=yes name=reg_pd_ges_oper_intracomunitarie dbname="reg_pd.ges_oper_intracomunitarie" initial="N" values="	S/	N" validation=" gettext()  = 'S' OR  gettext()  = 'N'" validationmsg="'Immettere: S, N'" )
 column=(type=long updatewhereclause=yes name=reg_pd_id_conto dbname="reg_pd.id_conto" )
 column=(type=char(8) updatewhereclause=yes name=conto_codice dbname="conto.codice" )
 column=(type=char(40) updatewhereclause=yes name=conto_descrizione dbname="conto.descrizione" )
 column=(type=char(1) updatewhereclause=yes name=reg_pd_tipo_fattura dbname="reg_pd.tipo_fattura" initial="N" values="Normale	N/Nota di Credito	C/Nota di Debito	D/" validation=" gettext()  = 'N' OR  gettext()  = 'C' OR  gettext()  = 'D'" validationmsg="'Immettere un valore compreso tra N, C, D'" )
 column=(type=char(40) updatewhereclause=yes name=prof_registrazione_descrizione dbname="prof_registrazione.descrizione" )
 column=(type=decimal(4) updatewhereclause=yes name=reg_pd_imp_valuta dbname="reg_pd.imp_valuta" )
 column=(type=char(1) updatewhereclause=yes name=reg_pd_st_stampa_bollato dbname="reg_pd.st_stampa_bollato" initial="N" values="Non stampato	N/In corso di stampa	I/Stampata su bollato	S/" validation=" gettext()  = 'N' OR  gettext()  = 'I' OR  gettext()  = 'S'" validationmsg="'Immettere un valore tra N, I, S'" )
 column=(type=char(1) updatewhereclause=yes name=reg_pd_st_liquidazione dbname="reg_pd.st_liquidazione" )
 column=(type=char(1) updatewhereclause=yes name=reg_pd_st_reg_iva dbname="reg_pd.st_reg_iva" )
 column=(type=date updatewhereclause=yes name=reg_pd_st_data_bollato dbname="reg_pd.st_data_bollato" )
 column=(type=date updatewhereclause=yes name=reg_pd_st_data_liquidazione dbname="reg_pd.st_data_liquidazione" )
 column=(type=date updatewhereclause=yes name=reg_pd_st_data_reg_iva dbname="reg_pd.st_data_reg_iva" )
 column=(type=long updatewhereclause=yes key=yes name=reg_pd_id_registro dbname="reg_pd.id_registro" )
 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"reg_pd~" )  TABLE(NAME=~"conto~" )  TABLE(NAME=~"prof_registrazione~" ) COLUMN(NAME=~"reg_pd.num_progressivo~") COLUMN(NAME=~"reg_pd.data_registrazione~") COLUMN(NAME=~"reg_pd.data_competenza~") COLUMN(NAME=~"prof_registrazione.codice~") COLUMN(NAME=~"reg_pd.cambio~") COLUMN(NAME=~"reg_pd.descrizione~") COLUMN(NAME=~"reg_pd.data_documento~") COLUMN(NAME=~"reg_pd.num_documento~") COLUMN(NAME=~"reg_pd.id_azienda~") COLUMN(NAME=~"reg_pd.id_reg_pd~") COLUMN(NAME=~"reg_pd.importo~") COLUMN(NAME=~"reg_pd.ges_oper_intracomunitarie~") COLUMN(NAME=~"reg_pd.id_conto~") COLUMN(NAME=~"conto.codice~") COLUMN(NAME=~"conto.descrizione~") COLUMN(NAME=~"reg_pd.tipo_fattura~") COLUMN(NAME=~"prof_registrazione.descrizione~") COLUMN(NAME=~"reg_pd.imp_valuta~") COLUMN(NAME=~"reg_pd.st_stampa_bollato~") COLUMN(NAME=~"reg_pd.st_liquidazione~") COLUMN(NAME=~"reg_pd.st_reg_iva~") COLUMN(NAME=~"reg_pd.st_data_bollato~") COLUMN(NAME=~"reg_pd.st_data_liquidazione~") COLUMN(NAME=~"reg_pd.st_data_reg_iva~") COLUMN(NAME=~"reg_pd.id_registro~")    JOIN (LEFT=~"reg_pd.id_conto~"    OP =~"=~"RIGHT=~"conto.id_conto~"    OUTER1 =~"reg_pd.id_conto~" )    JOIN (LEFT=~"prof_registrazione.id_prof_registrazione~"    OP =~"=~"RIGHT=~"reg_pd.id_prof_registrazione~" )WHERE(    EXP1 =~"( ( ~~~"reg_pd~~~".~~~"id_azienda~~~"~"   OP =~"in~"    EXP2 =~"(0, 1) ) )~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"reg_pd~~~".~~~"id_registro~~~"~"   OP =~"=~"    EXP2 =~":rd_reg~" ) ) ORDER(NAME=~"reg_pd.data_registrazione~" ASC=yes )  ORDER(NAME=~"reg_pd.num_progressivo~" ASC=yes ) ARG(NAME = ~"rd_reg~" TYPE = number) " update="reg_pd" updatewhere=1 updatekeyinplace=yes arguments=(("rd_reg", number)) )
