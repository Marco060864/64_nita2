 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"v_movimenti~" )  TABLE(NAME=~"documento~" )  TABLE(NAME=~"riga_documento~" )  TABLE(NAME=~"sog_commerciale_gen~" )  TABLE(NAME=~"caus_magazzino~" )  TABLE(NAME=~"magazzino~" )  TABLE(NAME=~"locazione~" ) COLUMN(NAME=~"documento.data_documento~") COLUMN(NAME=~"documento.num_documento~") COLUMN(NAME=~"documento.data_registrazione~") COLUMN(NAME=~"documento.num_progressivo~") COLUMN(NAME=~"sog_commerciale_gen.codice~") COLUMN(NAME=~"magazzino.codice~") COLUMN(NAME=~"caus_magazzino.codice~") COLUMN(NAME=~"riga_documento.qta_un_base~") COLUMN(NAME=~"riga_documento.quantita~") COLUMN(NAME=~"riga_documento.prezzo_netto~") COLUMN(NAME=~"riga_documento.tot_riga_val_az~")    JOIN (LEFT=~"documento.id_documento~"    OP =~"=~"RIGHT=~"v_movimenti.id_documento~" )    JOIN (LEFT=~"riga_documento.id_riga_documento~"    OP =~"=~"RIGHT=~"v_movimenti.id_riga_documento~" )    JOIN (LEFT=~"sog_commerciale_gen.id_sog_commerciale~"    OP =~"=~"RIGHT=~"documento.id_sog_commerciale~" )    JOIN (LEFT=~"locazione.id_magazzino~"    OP =~"=~"RIGHT=~"magazzino.id_magazzino~" )    JOIN (LEFT=~"locazione.id_locazione~"    OP =~"=~"RIGHT=~"v_movimenti.locazione~" )    JOIN (LEFT=~"caus_magazzino.id_caus_magazzino~"    OP =~"=~"RIGHT=~"riga_documento.id_caus_magazzino~" )) " )
