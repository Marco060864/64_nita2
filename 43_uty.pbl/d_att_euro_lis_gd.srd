 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"listino~" )  TABLE(NAME=~"variazione~" ) COLUMN(NAME=~"listino.id_listino~") COLUMN(NAME=~"listino.codice~") COLUMN(NAME=~"listino.descrizione~") COLUMN(NAME=~"listino.tipo~") COLUMN(NAME=~"listino.id_valuta~") COLUMN(NAME=~"listino.id_azienda~") COLUMN(NAME=~"listino.lis_base~") COLUMN(NAME=~"variazione.id_variazione~") COLUMN(NAME=~"variazione.data_inizio~") COLUMN(NAME=~"variazione.data_fine~") COMPUTE(NAME=~"CAST('' AS CHAR(4) ) AS c_nuovo_codice~") COMPUTE(NAME=~"CAST( 'N' AS CHAR(1)) AS c_seleziona~") COMPUTE(NAME=~"CAST( ' ' AS CHAR(100) ) AS c_note~")    JOIN (LEFT=~"variazione.id_listino~"    OP =~"=~"RIGHT=~"listino.id_listino~" )WHERE(    EXP1 =~"~~~"variazione~~~".~~~"data_inizio~~~"~"   OP =~"<=~"    EXP2 =~":rd_data_validita~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"( ~~~"variazione~~~".~~~"data_fine~~~"~"   OP =~">=~"    EXP2 =~":rd_data_validita~"    LOGIC =~"or~" ) WHERE(    EXP1 =~"~~~"variazione~~~".~~~"data_fine~~~"~"   OP =~"is~"    EXP2 =~"NULL )~" ) ) ARG(NAME = ~"rd_data_validita~" TYPE = date)  ARG(NAME = ~"rs_storico~" TYPE = string)  ARG(NAME = ~"rn_id_valuta_new~" TYPE = number) " update="variazione" updatewhere=1 updatekeyinplace=yes arguments=(("rd_data_validita", date),("rs_storico", string),("rn_id_valuta_new", number)) )
