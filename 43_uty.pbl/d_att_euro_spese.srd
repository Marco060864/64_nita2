 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"spesa~" )  TABLE(NAME=~"riga_spesa~" ) COLUMN(NAME=~"spesa.id_spesa~") COLUMN(NAME=~"spesa.tipo_importo~") COLUMN(NAME=~"spesa.id_valuta~") COLUMN(NAME=~"riga_spesa.da_imponibile~") COLUMN(NAME=~"riga_spesa.a_imponibile~") COLUMN(NAME=~"riga_spesa.importo~") COMPUTE(NAME=~"CAST(FN_CONV_VALUTA(~~~"spesa~~~".~~~"id_valuta~~~", ~~~"riga_spesa~~~".~~~"da_imponibile~~~", :rn_a_id_valuta) AS NUMERIC(18,4) ) AS c_da_imponibile~") COMPUTE(NAME=~"CAST(FN_CONV_VALUTA(~~~"spesa~~~".~~~"id_valuta~~~", ~~~"riga_spesa~~~".~~~"a_imponibile~~~", :rn_a_id_valuta) AS NUMERIC(18,4) ) AS c_a_imponibile~") COMPUTE(NAME=~"CAST(FN_CONV_VALUTA(~~~"spesa~~~".~~~"id_valuta~~~", ~~~"riga_spesa~~~".~~~"importo~~~", :rn_a_id_valuta) AS NUMERIC(18,4) ) AS c_importo~") COLUMN(NAME=~"riga_spesa.id_spesa~") COLUMN(NAME=~"riga_spesa.codice~") COLUMN(NAME=~"spesa.codice~")    JOIN (LEFT=~"riga_spesa.id_spesa~"    OP =~"=~"RIGHT=~"spesa.id_spesa~"    OUTER2 =~"spesa.id_spesa~" )WHERE(    EXP1 =~"~~~"spesa~~~".~~~"tipo_importo~~~"~"   OP =~"=~"    EXP2 =~"'F'~" ) ) ARG(NAME = ~"rn_a_id_valuta~" TYPE = number) " update="riga_spesa" updatewhere=1 updatekeyinplace=yes arguments=(("rn_a_id_valuta", number)) )
