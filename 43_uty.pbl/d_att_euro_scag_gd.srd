agenti~" )WHERE(    EXP1 =~"(~~~"scag_provvigione~~~".~~~"tipo_applicazione~~~"~"   OP =~"=~"    EXP2 =~"'I'~"    LOGIC =~"or~" ) WHERE(    EXP1 =~"~~~"scag_provvigione~~~".~~~"tipo_sconto~~~"~"   OP =~"=~"    EXP2 =~"'I')~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"con_provvigione~~~".~~~"data_inizio~~~"~"   OP =~"<=~"    EXP2 =~":rdt_data_validita~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"( ~~~"con_provvigione~~~".~~~"data_fine~~~"~"   OP =~">=~"    EXP2 =~":rdt_data_validita~"    LOGIC =~"or~" ) WHERE(    EXP1 =~"~~~"con_provvigione~~~".~~~"data_fine~~~"~"   OP =~"is~"    EXP2 =~"NULL )~" ) ) ARG(NAME = ~"rdt_data_validita~" TYPE = date)  ARG(NAME = ~"rn_a_id_valuta~" TYPE = number) " update="scag_provvigione" updatewhere=1 updatekeyinplace=yes arguments=(("rdt_data_validita", date),("rn_a_id_valuta", number)) )
