 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"documento~" )  TABLE(NAME=~"sog_commerciale_gen~" )  TABLE(NAME=~"prof_documento~" )  TABLE(NAME=~"registro~" )  TABLE(NAME=~"riga_documento~" )  TABLE(NAME=~"articolo~" ) COLUMN(NAME=~"documento.num_progressivo~") COLUMN(NAME=~"documento.data_registrazione~") COLUMN(NAME=~"documento.num_documento~") COLUMN(NAME=~"documento.data_documento~") COLUMN(NAME=~"sog_commerciale_gen.codice~") COLUMN(NAME=~"sog_commerciale_gen.rag_soc_1~") COLUMN(NAME=~"registro.descrizione~") COLUMN(NAME=~"prof_documento.id_prof_registrazione~") COLUMN(NAME=~"prof_documento.descrizione~") COLUMN(NAME=~"prof_documento.codice~") COLUMN(NAME=~"riga_documento.id_riga_doc_provenienza~") COLUMN(NAME=~"riga_documento.id_documento~") COLUMN(NAME=~"articolo.codice~") COLUMN(NAME=~"articolo.descrizione~") COLUMN(NAME=~"riga_documento.num_riga~") COLUMN(NAME=~"riga_documento.quantita~") COLUMN(NAME=~"riga_documento.prezzo~") COLUMN(NAME=~"riga_documento.sconto~") COLUMN(NAME=~"riga_documento.id_des_articolo~") COLUMN(NAME=~"riga_documento.id_tab_iva~") COLUMN(NAME=~"riga_documento.id_articolo~") COLUMN(NAME=~"articolo.id_cat_com_articolo~") COLUMN(NAME=~"articolo.id_cat_merceologica~") COLUMN(NAME=~"articolo.id_sog_commerciale~") COLUMN(NAME=~"articolo.id_anagrafica~") COLUMN(NAME=~"articolo.id_gruppo_articoli~") COLUMN(NAME=~"riga_documento.id_con_lis_articolo~") COMPUTE(NAME=~"cast(0 as integer) as riga_doc~") COLUMN(NAME=~"documento.id_sog_commerciale~") COMPUTE(NAME=~"cast(null as date) as data1~") COMPUTE(NAME=~"cast(null as date) as data2~") COMPUTE(NAME=~"CAST(fn_esi_disp2(1, ~~~"articolo~~~".~~~"id_articolo~~~", 0, :anno, :mese,0) AS CHAR(100)) AS ret_esi_attuale~") COMPUTE(NAME=~"CAST( SUBSTRING(ret_esi_attuale, 1, 20) AS NUMERIC(18,4) ) AS esi_fisica_attuale~") COMPUTE(NAME=~"CAST( SUBSTRING(ret_esi_attuale, 61, 20) AS NUMERIC(18,4) ) AS qta_caricata~") COMPUTE(NAME=~"CAST( SUBSTRING(ret_esi_attuale, 81, 20) AS NUMERIC(18,4) ) AS qta_scaricata~") COMPUTE(NAME=~"CAST(fn_ordinato(1, ~~~"articolo~~~".~~~"id_articolo~~~",0, :anno, :mese) AS CHAR(40)) AS c_ord_clifor~") COMPUTE(NAME=~"CAST( SUBSTRING(c_ord_clifor, 21, 20) AS NUMERIC(18,4) ) AS qta_ord_fornitori~") COMPUTE(NAME=~"cast(null as date) as data_stampa~")    JOIN (LEFT=~"documento.id_sog_commerciale~"    OP =~"=~"RIGHT=~"sog_commerciale_gen.id_sog_commerciale~" )    JOIN (LEFT=~"prof_documento.id_prof_documento~"    OP =~"=~"RIGHT=~"documento.id_prof_documento~" )    JOIN (LEFT=~"registro.id_registro~"    OP =~"=~"RIGHT=~"documento.id_registro~" )    JOIN (LEFT=~"documento.id_documento~"    OP =~"=~"RIGHT=~"riga_documento.id_documento~" )    JOIN (LEFT=~"articolo.id_articolo~"    OP =~"=~"RIGHT=~"riga_documento.id_articolo~" )WHERE(    EXP1 =~"~~~"riga_documento~~~".~~~"id_articolo~~~"~"   OP =~"=~"    EXP2 =~":ra_id_articolo~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"documento~~~".~~~"data_registrazione~~~"~"   OP =~">=~"    EXP2 =~":ra_da_data~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"documento~~~".~~~"data_registrazione~~~"~"   OP =~"<=~"    EXP2 =~":ra_a_data~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"registro~~~".~~~"tipo_registro~~~"~"   OP =~"=~"    EXP2 =~":ra_tipo_reg~" ) ) ORDER(NAME=~"articolo.codice~" ASC=yes ) ARG(NAME = ~"ra_id_articolo~" TYPE = number)  ARG(NAME = ~"ra_da_data~" TYPE = date)  ARG(NAME = ~"ra_a_data~" TYPE = date)  ARG(NAME = ~"ra_tipo_reg~" TYPE = string)  ARG(NAME = ~"anno~" TYPE = number)  ARG(NAME = ~"mese~" TYPE = number) " arguments=(("ra_id_articolo", number),("ra_da_data", date),("ra_a_data", date),("ra_tipo_reg", string),("anno", number),("mese", number))  sort="articolo_codice A " )
