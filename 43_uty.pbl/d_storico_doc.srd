 column=(type=decimal(4) updatewhereclause=yes name=riga_documento_prezzo dbname="riga_documento.prezzo" )
 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"documento~" )  TABLE(NAME=~"sog_commerciale_gen~" )  TABLE(NAME=~"prof_documento~" )  TABLE(NAME=~"registro~" )  TABLE(NAME=~"riga_documento~" )  TABLE(NAME=~"articolo~" ) COLUMN(NAME=~"documento.num_progressivo~") COLUMN(NAME=~"documento.data_registrazione~") COLUMN(NAME=~"documento.num_documento~") COLUMN(NAME=~"documento.data_documento~") COLUMN(NAME=~"sog_commerciale_gen.codice~") COLUMN(NAME=~"sog_commerciale_gen.rag_soc_1~") COLUMN(NAME=~"registro.descrizione~") COLUMN(NAME=~"prof_documento.id_prof_registrazione~") COLUMN(NAME=~"prof_documento.descrizione~") COLUMN(NAME=~"prof_documento.codice~") COLUMN(NAME=~"riga_documento.id_riga_doc_provenienza~") COLUMN(NAME=~"riga_documento.id_documento~") COLUMN(NAME=~"articolo.codice~") COLUMN(NAME=~"articolo.descrizione~") COLUMN(NAME=~"riga_documento.num_riga~") COLUMN(NAME=~"riga_documento.quantita~") COMPUTE(NAME=~"cast('' as char(1)) as riga_doc~") COLUMN(NAME=~"riga_documento.prezzo~")    JOIN (LEFT=~"documento.id_sog_commerciale~"    OP =~"=~"RIGHT=~"sog_commerciale_gen.id_sog_commerciale~" )    JOIN (LEFT=~"prof_documento.id_prof_documento~"    OP =~"=~"RIGHT=~"documento.id_prof_documento~" )    JOIN (LEFT=~"registro.id_registro~"    OP =~"=~"RIGHT=~"documento.id_registro~" )    JOIN (LEFT=~"documento.id_documento~"    OP =~"=~"RIGHT=~"riga_documento.id_documento~" )    JOIN (LEFT=~"articolo.id_articolo~"    OP =~"=~"RIGHT=~"riga_documento.id_articolo~" )WHERE(    EXP1 =~"~~~"riga_documento~~~".~~~"id_riga_documento~~~"~"   OP =~"=~"    EXP2 =~":ra_id_riga_documento~" ) ) ARG(NAME = ~"ra_id_riga_documento~" TYPE = number) " arguments=(("ra_id_riga_documento", number)) )
