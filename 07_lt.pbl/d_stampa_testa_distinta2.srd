 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"unita_confezione~" )  TABLE(NAME=~"unita_misura~" )  TABLE(NAME=~"distinta~" )  TABLE(NAME=~"distinta1~" )  TABLE(NAME=~"articolo~" ) COLUMN(NAME=~"distinta.codice~") COLUMN(NAME=~"articolo.codice~") COLUMN(NAME=~"articolo.descrizione~") COLUMN(NAME=~"unita_confezione.dim_l~") COLUMN(NAME=~"distinta1.componente_acq_finito~") COLUMN(NAME=~"distinta1.cod_art_fornitore~") COLUMN(NAME=~"distinta1.marc_ce~") COLUMN(NAME=~"distinta1.sterile~") COLUMN(NAME=~"distinta1.classe~") COLUMN(NAME=~"distinta1.etilene~") COLUMN(NAME=~"distinta1.allegato~") COLUMN(NAME=~"distinta1.beta~") COLUMN(NAME=~"distinta1.gamma~") COLUMN(NAME=~"unita_misura.simbolo~")    JOIN (LEFT=~"unita_confezione.id_unita_misura~"    OP =~"=~"RIGHT=~"unita_misura.id_unita_misura~"    OUTER1 =~"unita_confezione.id_unita_misura~" )    JOIN (LEFT=~"distinta.id_distinta~"    OP =~"=~"RIGHT=~"distinta1.id_distinta~" )    JOIN (LEFT=~"articolo.id_articolo~"    OP =~"=~"RIGHT=~"unita_confezione.id_articolo~" )    JOIN (LEFT=~"distinta.id_articolo~"    OP =~"=~"RIGHT=~"articolo.id_articolo~" )WHERE(    EXP1 =~"( ~~~"distinta~~~".~~~"id_distinta~~~"~"   OP =~"=~"    EXP2 =~":id_distinta )~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"( ~~~"unita_confezione~~~".~~~"unita_base~~~"~"   OP =~"=~"    EXP2 =~"'S')~" ) ) ARG(NAME = ~"id_distinta~" TYPE = number) " arguments=(("id_distinta", number)) )
