//objectcomments dw del lotto da generare
release 6;
datawindow(units=0 timer_interval=0 color=79741120 processing=0 print.documentname="" print.orientation = 0 print.margin.left = 110 print.margin.right = 110 print.margin.top = 97 print.margin.bottom = 97 print.paper.source = 0 print.paper.size = 0 print.prompt=no print.buttons=no print.preview.buttons=no )
summary(height=0 color="536870912" )
footer(height=0 color="536870912" )
detail(height=1220 color="536870912" )
table(column=(type=char(32) updatewhereclause=yes name=codice dbname="articolo.codice" )
 column=(type=char(80) updatewhereclause=yes name=descrizione dbname="articolo.descrizione" )
 column=(type=decimal(4) update=yes updatewhereclause=yes name=lotto_qta_iniziale dbname="lotto.qta_iniziale" )
 column=(type=date update=yes updatewhereclause=yes name=lotto_data_scadenza dbname="lotto.data_scadenza" )
 column=(type=long update=yes updatewhereclause=yes key=yes identity=yes name=id_lotto dbname="lotto.id_lotto" )
 column=(type=long update=yes updatewhereclause=yes name=id_articolo dbname="lotto.id_articolo" )
 column=(type=char(1) update=yes updatewhereclause=yes name=attivo dbname="lotto.attivo" initial="S" )
 column=(type=char(32766) update=yes updatewhereclause=no name=lotto_note dbname="lotto.note" )
 column=(type=char(1) update=yes updatewhereclause=yes name=tipo_lotto dbname="lotto.tipo_lotto" initial="P" )
 column=(type=char(30) update=yes updatewhereclause=yes name=cod_esterno dbname="lotto.cod_esterno" )
 column=(type=long update=yes updatewhereclause=yes name=lotto_numero dbname="lotto.numero" )
 column=(type=date update=yes updatewhereclause=yes name=data_doc dbname="lotto.data_doc" initial="today" )
 column=(type=char(20) update=yes updatewhereclause=yes name=modulo dbname="lotto.modulo" )
 column=(type=decimal(4) update=yes updatewhereclause=yes name=qta_scaricata dbname="lotto.qta_scaricata" initial="0" )
 column=(type=char(1) updatewhereclause=yes name=sterilizza dbname="sterilizza" initial="S" values="Sterile	S/Sterile	N" )
 column=(type=decimal(4) update=yes updatewhereclause=yes name=lotto_peso_netto_iniziale dbname="lotto.peso_netto_iniziale" )
 column=(type=decimal(4) update=yes updatewhereclause=yes name=lotto_peso_netto_scaricato dbname="lotto.peso_netto_scaricato" initial="0" )
 column=(type=decimal(4) update=yes updatewhereclause=yes name=lotto_peso_netto_da_lav dbname="lotto.peso_netto_da_lav" )
 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"articolo~" )  TABLE(NAME=~"lotto~" ) COLUMN(NAME=~"articolo.codice~") COLUMN(NAME=~"articolo.descrizione~") COLUMN(NAME=~"lotto.qta_iniziale~") COLUMN(NAME=~"lotto.data_scadenza~") COLUMN(NAME=~"lotto.id_lotto~") COLUMN(NAME=~"lotto.id_articolo~") COLUMN(NAME=~"lotto.attivo~") COLUMN(NAME=~"lotto.note~") COLUMN(NAME=~"lotto.tipo_lotto~") COLUMN(NAME=~"lotto.cod_esterno~") COLUMN(NAME=~"lotto.numero~") COLUMN(NAME=~"lotto.data_doc~") COLUMN(NAME=~"lotto.modulo~") COLUMN(NAME=~"lotto.qta_scaricata~") COMPUTE(NAME=~"cast('S' as char(1)) as sterilizza~") COLUMN(NAME=~"lotto.peso_netto_iniziale~") COLUMN(NAME=~"lotto.peso_netto_scaricato~") COLUMN(NAME=~"lotto.peso_netto_da_lav~")) " update="lotto" updatewhere=1 updatekeyinplace=yes )
