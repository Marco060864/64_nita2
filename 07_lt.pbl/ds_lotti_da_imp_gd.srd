 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"tmp_lotto~" )  TABLE(NAME=~"articolo~" ) COLUMN(NAME=~"tmp_lotto.id_lotto~") COLUMN(NAME=~"tmp_lotto.id_anag_modello~") COLUMN(NAME=~"tmp_lotto.a_codice~") COLUMN(NAME=~"tmp_lotto.qta_iniziale~") COLUMN(NAME=~"tmp_lotto.qta_scaricata~") COLUMN(NAME=~"tmp_lotto.attivo~") COLUMN(NAME=~"tmp_lotto.note~") COLUMN(NAME=~"tmp_lotto.data_scadenza~") COLUMN(NAME=~"tmp_lotto.tipo_lotto~") COLUMN(NAME=~"tmp_lotto.cod_esterno~") COLUMN(NAME=~"tmp_lotto.numero~") COLUMN(NAME=~"tmp_lotto.data_doc~") COLUMN(NAME=~"tmp_lotto.modulo~") COLUMN(NAME=~"tmp_lotto.lotto_ster_1~") COLUMN(NAME=~"tmp_lotto.lotto_ster_2~") COLUMN(NAME=~"tmp_lotto.peso_netto_iniziale~") COLUMN(NAME=~"tmp_lotto.peso_netto_scaricato~") COLUMN(NAME=~"tmp_lotto.peso_netto_da_lav~") COLUMN(NAME=~"tmp_lotto.r_quantita~") COLUMN(NAME=~"tmp_lotto.r_fat_con_unita_base~") COLUMN(NAME=~"tmp_lotto.r_fat_con_globale~") COLUMN(NAME=~"tmp_lotto.r_qta_un_base~") COLUMN(NAME=~"tmp_lotto.v_codice~") COLUMN(NAME=~"tmp_lotto.r_cambio~") COLUMN(NAME=~"tmp_lotto.r_prezzo~") COLUMN(NAME=~"tmp_lotto.r_prezzo_netto~") COLUMN(NAME=~"tmp_lotto.r_peso_netto~") COLUMN(NAME=~"tmp_lotto.t_codice~") COLUMN(NAME=~"tmp_lotto.r_val_attribuito~") COLUMN(NAME=~"tmp_lotto.r_tot_riga_val_riga~") COLUMN(NAME=~"tmp_lotto.r_tot_riga_val_doc~") COLUMN(NAME=~"tmp_lotto.r_tot_riga_val_az~") COLUMN(NAME=~"tmp_lotto.d_data_registrazione~") COMPUTE(NAME=~"CAST( 'S' AS CHAR(1) ) AS importa~") COLUMN(NAME=~"articolo.descrizione~")    JOIN (LEFT=~"articolo.codice~"    OP =~"=~"RIGHT=~"tmp_lotto.a_codice~" )WHERE(    EXP1 =~"( ~~~"tmp_lotto~~~".~~~"a_codice~~~" || IFNULL( ~~~"tmp_lotto~~~".~~~"cod_esterno~~~", '', ~~~"tmp_lotto~~~".~~~"cod_esterno~~~" ) ||  ~~~"tmp_lotto~~~".~~~"data_doc~~~" )~"   OP =~"not in~"    EXP2 =~"( SELECT a.codice || IFNULL( l.cod_esterno, '', l.cod_esterno) || l.data_doc FROM lotto l, articolo a WHERE a.id_articolo = l.id_articolo AND l.tipo_lotto IN ('K', 'Z'))~" ) ) " )
