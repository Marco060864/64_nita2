//objectcomments dw query che recupera i documenti dove i lotti base sono utilizzati
release 5;
datawindow(units=0 timer_interval=0 color=79741120 processing=1 print.documentname="" print.orientation = 0 print.margin.left = 110 print.margin.right = 110 print.margin.top = 97 print.margin.bottom = 97 print.paper.source = 0 print.paper.size = 0 print.prompt=no grid.lines=0 )
header(height=74 color="536870912" )
summary(height=4 color="536870912" )
footer(height=1 color="536870912" )
detail(height=87 color="536870912" )
table(column=(type=long updatewhereclause=yes name=riga_doc_lotto_id_riga_documento dbname="id_riga_documento" )
 column=(type=decimal(4) updatewhereclause=yes name=quantita dbname="quantita" )
 column=(type=date updatewhereclause=yes name=lotto_data_scadenza dbname="data_scadenza" )
 column=(type=long updatewhereclause=yes name=id_mov_lotto dbname="id_mov_lotto" )
 column=(type=long updatewhereclause=yes name=id_lotto dbname="id_lotto" )
 column=(type=char(32) updatewhereclause=yes name=articolo_codice dbname="codice" )
 column=(type=char(16) updatewhereclause=yes name=num_documento dbname="num_documento" )
 column=(type=date updatewhereclause=yes name=data_documento dbname="data_documento" )
 column=(type=char(8) updatewhereclause=yes name=sog_commerciale_codice dbname="codice" )
 column=(type=char(40) updatewhereclause=yes name=rag_soc_1 dbname="rag_soc_1" )
 column=(type=decimal(0) updatewhereclause=yes name=num_progressivo dbname="num_progressivo" )
 column=(type=date updatewhereclause=yes name=data_registrazione dbname="data_registrazione" )
 column=(type=char(80) updatewhereclause=yes name=articolo_descrizione dbname="descrizione" )
 column=(type=char(30) updatewhereclause=yes name=cod_esterno dbname="cod_esterno" )
 column=(type=long updatewhereclause=yes name=num_lotto_prod dbname="num_lotto_prod" )
 column=(type=decimal(4) updatewhereclause=yes name=riga_documento_quantita dbname="quantita" )
 column=(type=long updatewhereclause=yes name=id_documento dbname="id_documento" )
 retrieve="  SELECT DISTINCT  ~"riga_doc_lotto~".~"id_riga_documento~" ,           ~"movimenti_lotto~".~"quantita~" ,           ~"lotto~".~"data_scadenza~" ,           ~"movimenti_lotto~".~"id_mov_lotto~" ,           ~"movimenti_lotto~".~"id_lotto~" ,           ~"articolo~".~"codice~" ,           ~"documento~".~"num_documento~" ,           ~"documento~".~"data_documento~" ,           ~"sog_commerciale~".~"codice~" ,           ~"anagrafica~".~"rag_soc_1~" ,           ~"documento~".~"num_progressivo~" ,           ~"documento~".~"data_registrazione~" ,           ~"articolo~".~"descrizione~" ,           ~"lotto~".~"cod_esterno~" ,           ~"movimenti_lotto~".~"num_lotto_prod~" ,           ~"riga_documento~".~"quantita~" ,           ~"documento~".~"id_documento~"  
        FROM {oj {oj {oj ~"riga_documento~"  LEFT OUTER JOIN ~"documento~"  ON ~"riga_documento~".~"id_documento~" = ~"documento~".~"id_documento~"} LEFT OUTER JOIN ~"sog_commerciale~"  ON ~"documento~".~"id_sog_commerciale~" = ~"sog_commerciale~".~"id_sog_commerciale~"} LEFT OUTER JOIN ~"anagrafica~"  ON ~"sog_commerciale~".~"id_anagrafica~" = ~"anagrafica~".~"id_anagrafica~"}, {oj ~"riga_doc_lotto~"  LEFT OUTER JOIN ~"riga_documento~"  ON ~"riga_doc_lotto~".~"id_riga_documento~" = ~"riga_documento~".~"id_riga_lotto~"}, {oj ~"lotto~"  LEFT OUTER JOIN ~"riga_doc_lotto~"  ON ~"lotto~".~"numero~" = ~"riga_doc_lotto~".~"id_lotto~"}, {oj ~"lotto~"  LEFT OUTER JOIN ~"movimenti_lotto~"  ON ~"lotto~".~"numero~" = ~"movimenti_lotto~".~"num_lotto_prod~"} ,           ~"articolo~"    
        WHERE ( ~"articolo~".~"id_articolo~" = ~"lotto~".~"id_articolo~" ) and          ( ( ~"lotto~".~"id_lotto~" = :id_lotto ) or          ( ~"movimenti_lotto~".~"id_lotto~" = :id_lotto ) )  " arguments=(("id_lotto", number)) )
