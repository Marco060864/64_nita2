 retrieve="PBSELECT( VERSION(400) DISTINCT ()TABLE(NAME=~"documento~" )  TABLE(NAME=~"lotto~" )  TABLE(NAME=~"riga_doc_lotto~" )  TABLE(NAME=~"riga_documento~" )  TABLE(NAME=~"sog_commerciale~" )  TABLE(NAME=~"anagrafica~" )  TABLE(NAME=~"articolo~" ) COLUMN(NAME=~"riga_doc_lotto.id_riga_lotto~") COLUMN(NAME=~"lotto.data_scadenza~") COLUMN(NAME=~"articolo.codice~") COLUMN(NAME=~"documento.num_documento~") COLUMN(NAME=~"documento.data_documento~") COLUMN(NAME=~"sog_commerciale.codice~") COLUMN(NAME=~"anagrafica.rag_soc_1~") COLUMN(NAME=~"documento.num_progressivo~") COLUMN(NAME=~"documento.data_registrazione~") COLUMN(NAME=~"articolo.descrizione~") COLUMN(NAME=~"lotto.cod_esterno~") COLUMN(NAME=~"riga_documento.quantita~") COLUMN(NAME=~"documento.id_documento~") COLUMN(NAME=~"documento.id_prof_documento~") COLUMN(NAME=~"lotto.id_lotto~") COLUMN(NAME=~"riga_documento.peso_netto~")    JOIN (LEFT=~"riga_doc_lotto.id_riga_lotto~"    OP =~"=~"RIGHT=~"riga_documento.id_riga_lotto~"    OUTER1 =~"riga_doc_lotto.id_riga_lotto~" )    JOIN (LEFT=~"documento.id_sog_commerciale~"    OP =~"=~"RIGHT=~"sog_commerciale.id_sog_commerciale~"    OUTER1 =~"documento.id_sog_commerciale~" )    JOIN (LEFT=~"sog_commerciale.id_anagrafica~"    OP =~"=~"RIGHT=~"anagrafica.id_anagrafica~"    OUTER1 =~"sog_commerciale.id_anagrafica~" )    JOIN (LEFT=~"riga_documento.id_documento~"    OP =~"=~"RIGHT=~"documento.id_documento~"    OUTER1 =~"riga_documento.id_documento~" )    JOIN (LEFT=~"lotto.id_lotto~"    OP =~"=~"RIGHT=~"riga_doc_lotto.id_lotto~" )    JOIN (LEFT=~"articolo.id_articolo~"    OP =~"=~"RIGHT=~"lotto.id_articolo~" )WHERE(    EXP1 =~"~~~"lotto~~~".~~~"id_lotto~~~"~"   OP =~"=~"    EXP2 =~":id_lotto~"    LOGIC =~"or~" ) WHERE(    EXP1 =~"~~~"lotto~~~".~~~"id_lotto~~~"~"   OP =~"=~"    EXP2 =~":id_lotto_padre~" ) ) ARG(NAME = ~"id_lotto~" TYPE = number)  ARG(NAME = ~"id_lotto_padre~" TYPE = number) " arguments=(("id_lotto", number),("id_lotto_padre", number)) )
