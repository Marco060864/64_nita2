 column=(type=decimal(4) updatewhereclause=yes name=cprovv_imp_agente dbname="locazione.provv_imp_agente" )
 column=(type=decimal(4) updatewhereclause=yes name=cprovv_imp_subage dbname="locazione.provv_imp_subage" )
 column=(type=decimal(4) updatewhereclause=yes name=cprovv_imp_carea dbname="locazione.provv_imp_carea" )
 column=(type=date updatewhereclause=yes name=cdata_scadenza dbname="locazione.data_scadenza" )
 column=(type=char(30) updatewhereclause=yes name=ccod_esterno dbname="locazione.cod_esterno" )
 column=(type=long updatewhereclause=yes name=cid_riga_lotto dbname="locazione.id_riga_lotto" )
 column=(type=char(1) updatewhereclause=yes name=simbolo_mov dbname="locazione.tipo" )
 column=(type=char(1) updatewhereclause=yes name=ctipo_lotto dbname="locazione.tipo_lotto" )
 column=(type=char(32) updatewhereclause=yes name=des_articolo_codice dbname="codice" )
 column=(type=char(40) updatewhereclause=yes name=des_articolo_descrizione dbname="descrizione" )
 column=(type=char(32767) updatewhereclause=yes name=des_articolo_des_estesa dbname="des_estesa" )
 column=(type=char(32) updatewhereclause=yes name=codice dbname="locazione.codice" )
 column=(type=char(40) updatewhereclause=yes name=descrizione dbname="locazione.descrizione" )
 column=(type=char(32766) updatewhereclause=no name=des_estesa dbname="locazione.des_estesa" )
 column=(type=long updatewhereclause=yes name=id_gruppo_agenti_2 dbname="locazione.id_gruppo_agenti_2" )
 column=(type=decimal(2) updatewhereclause=yes name=provv_agente_2 dbname="locazione.provv_agente_2" )
 column=(type=decimal(2) updatewhereclause=yes name=provv_subage_2 dbname="locazione.provv_subage_2" )
 column=(type=decimal(2) updatewhereclause=yes name=provv_carea_2 dbname="locazione.provv_carea_2" )
 column=(type=decimal(4) updatewhereclause=yes name=provv_imp_agente_2 dbname="locazione.provv_imp_agente_2" )
 column=(type=decimal(4) updatewhereclause=yes name=provv_imp_subage_2 dbname="locazione.provv_imp_subage_2" )
 column=(type=decimal(4) updatewhereclause=yes name=provv_imp_carea_2 dbname="locazione.provv_imp_carea_2" )
 column=(type=char(30) updatewhereclause=yes name=c_ult_costo_data dbname="c_ult_costo_data" )
 column=(type=char(30) updatewhereclause=yes name=c_cmc_data dbname="c_cmc_data" )
 column=(type=char(10) updatewhereclause=yes name=data_costo_ultimo dbname="data_costo_ultimo" )
 column=(type=char(10) updatewhereclause=yes name=data_cmc dbname="data_cmc" )
 column=(type=char(60) updatewhereclause=yes name=c_esidisp dbname="c_esidisp" )
 retrieve="  SELECT Cast(~"articolo~".~"codice~" as char(20)) As c_articolo_cod,
         Cast(~"articolo~".~"descrizione~" as char(80)) As c_articolo_des,
			Cast(~"unita_confezione~".~"tipo_conversione~" as char(1)) As c_unita_conf_tipo_conversione,
         Cast(~"unita_confezione~".~"molteplicita~" as decimal) As c_unita_conf_molteplicita, 
         CAST(SUBSTR( c_esidisp, 21, 20) as numeric(18,4)) As c_esistenza,   
         CAST(SUBSTR(c_esidisp,  41, 20) as numeric(18,4)) As c_disponibilita,   
         Cast(0 as integer) As c_arrot,   
         ~"riga_documento~".~"id_riga_documento~",   
         ~"riga_documento~".~"id_documento~",   
         ~"riga_documento~".~"num_riga~",   
         ~"riga_documento~".~"id_articolo~",   
         ~"riga_documento~".~"descrizione~",   
         ~"riga_documento~".~"id_des_articolo~",   
         ~"riga_documento~".~"id_unita_confezione~",   
         ~"riga_documento~".~"quantita~",   
         ~"riga_documento~".~"qta_sconto_merce~",   
         ~"riga_documento~".~"qta_evasa~",   
         ~"riga_documento~".~"fat_con_unita_base~",   
         ~"riga_documento~".~"fat_con_globale~",   
         ~"riga_documento~".~"qta_un_base~",   
         ~"riga_documento~".~"qta_evasa_un_base~",   
         ~"riga_documento~".~"id_caus_magazzino~",   
         ~"riga_documento~".~"id_locazione_1~",   
         ~"riga_documento~".~"id_locazione_2~",   
         ~"riga_documento~".~"id_valuta~",   
         ~"riga_documento~".~"cambio~",   
         ~"riga_documento~".~"id_listino~",   
         ~"riga_documento~".~"id_con_lis_articolo~",   
         ~"riga_documento~".~"prezzo~",   
         ~"riga_documento~".~"sconto~",   
         ~"riga_documento~".~"prezzo_netto~",   
         ~"riga_documento~".~"sconto_riga~",   
         ~"riga_documento~".~"data_prevista_consegna~",   
         ~"riga_documento~".~"peso_netto~",   
         ~"riga_documento~".~"peso_lordo~",   
         ~"riga_documento~".~"dim_l~",   
         ~"riga_documento~".~"dim_h~",   
         ~"riga_documento~".~"dim_p~",   
         ~"riga_documento~".~"num_colli~",   
         ~"riga_documento~".~"id_tab_iva~",   
         ~"riga_documento~".~"provv_agente~",   
         ~"riga_documento~".~"id_gruppo_agenti~",   
         ~"riga_documento~".~"val_attribuito~",   
         ~"riga_documento~".~"id_caus_trasporto~",   
         ~"riga_documento~".~"forza_chius_evasione~",   
         ~"riga_documento~".~"sospesa~",   
         ~"riga_documento~".~"da_stampare~",   
         ~"riga_documento~".~"data_inizio_competenza~",   
         ~"riga_documento~".~"data_fine_competenza~",   
         ~"riga_documento~".~"tot_riga_val_riga~",   
         ~"riga_documento~".~"tot_riga_val_doc~",   
         ~"riga_documento~".~"tot_riga_val_az~",   
         ~"riga_documento~".~"id_riga_doc_provenienza~",   
         ~"riga_documento~".~"id_conto~",   
         ~"riga_documento~".~"id_azienda~",   
         ~"riga_documento~".~"provv_subage~",   
         ~"riga_documento~".~"provv_carea~",   
         ~"unita_misura_a~".~"simbolo~",   
         ~"unita_misura_a~".~"descrizione~",   
         ~"articolo~".~"stato~",   
         CAST(SUBSTR(c_esidisp, 1, 20) as numeric(18,4)) as esistenza_fisica,   
         CAST(SUBSTR(c_cmc_data, 1, 20) as numeric(18,4)) as cmc,   
         ~"unita_misura_b~".~"simbolo~",   
         ~"unita_misura_b~".~"descrizione~",   
         ~"unita_misura_a~".~"conversione~",   
         ~"unita_misura_b~".~"conversione~",   
         CAST(SUBSTR(c_ult_costo_data, 1, 20) as numeric(18,4)) as costo_ultimo,   
         CAST(FN_COSTO_MEDIO(1, ~"riga_documento~".~"id_articolo~", (SELECT id_magazzino FROM locazione WHERE id_locazione = ~"riga_documento~".~"id_locazione_1~"), YEAR(TODAY(*)), MONTH(TODAY(*)), ~"riga_documento~".~"id_valuta~")  AS DECIMAL(18,4) ) AS costo_medio,   
         cast(null as integer) as ric1,   
         cast(null as integer) as ric2,   
         ~"riga_documento~".~"id_riga_doc_padre~",   
         ~"riga_documento~".~"provv_imp_agente~",   
         ~"riga_documento~".~"provv_imp_subage~",   
         ~"riga_documento~".~"provv_imp_carea~",   
         ~"lotto~".~"data_scadenza~",   
         ~"lotto~".~"cod_esterno~",   
         ~"riga_documento~".~"id_riga_lotto~",   
         ~"unita_misura_c~".~"tipo~",   
         ~"lotto~".~"tipo_lotto~",
         cast(null as char(32)) as codice,   
         cast(null as char(40)) as descrizione,   
         cast(null as char)as des_estesa  ,   
         ~"des_articolo~".~"codice~",   
         ~"des_articolo~".~"descrizione~",   
         ~"des_articolo~".~"des_estesa~",   
         ~"riga_documento~".~"id_gruppo_agenti_2~",   
         ~"riga_documento~".~"provv_agente_2~",   
         ~"riga_documento~".~"provv_subage_2~",   
         ~"riga_documento~".~"provv_carea_2~",   
         ~"riga_documento~".~"provv_imp_agente_2~",   
         ~"riga_documento~".~"provv_imp_subage_2~",   
         ~"riga_documento~".~"provv_imp_carea_2~",
		   CAST(FN_ULTIMO_COSTO_DATA(1, ~"riga_documento~".~"id_articolo~", (SELECT id_magazzino FROM locazione WHERE id_locazione = ~"riga_documento~".~"id_locazione_1~"), YEAR(TODAY(*)), MONTH(TODAY(*)) , ~"riga_documento~".~"id_valuta~")  AS CHAR(30) ) AS c_ult_costo_data,
			CAST(FN_CMC_DATA(1, ~"riga_documento~".~"id_articolo~", (SELECT id_magazzino FROM locazione WHERE id_locazione = ~"riga_documento~".~"id_locazione_1~"), ~"riga_documento~".~"id_valuta~")  AS CHAR(30) ) AS c_cmc_data,
			CAST(SUBSTR(c_ult_costo_data, 21, 10) as CHAR(10)) as data_costo_ultimo,
			CAST(SUBSTR(c_cmc_data, 21, 10) as CHAR(10)) as data_cmc,
			CAST(FN_ESI_DISP(1, ~"riga_documento~".~"id_articolo~", (SELECT id_magazzino FROM locazione WHERE id_locazione = ~"riga_documento~".~"id_locazione_1~"), YEAR(TODAY(*)), MONTH(TODAY(*)) , ~"riga_documento~".~"id_valuta~")  AS CHAR(60) ) AS c_esidisp			
    FROM {oj {oj ~"unita_confezione~"  LEFT OUTER JOIN ~"unita_misura~" unita_misura_a  ON ~"unita_confezione~".~"id_unita_mis_peso~" = ~"unita_misura_a~".~"id_unita_misura~"} LEFT OUTER JOIN ~"unita_misura~" unita_misura_b  ON ~"unita_confezione~".~"id_unita_mis_volume~" = ~"unita_misura_b~".~"id_unita_misura~"}, {oj ~"riga_documento~"  LEFT OUTER JOIN ~"riga_doc_lotto~"  ON ~"riga_documento~".~"id_riga_lotto~" = ~"riga_doc_lotto~".~"id_riga_lotto~"}, {oj ~"unita_confezione~"  LEFT OUTER JOIN ~"unita_misura~" unita_misura_c  ON ~"unita_confezione~".~"id_unita_misura~" = ~"unita_misura_c~".~"id_unita_misura~"}, {oj ~"riga_doc_lotto~"  LEFT OUTER JOIN ~"lotto~"  ON ~"riga_doc_lotto~".~"id_lotto~" = ~"lotto~".~"id_lotto~"}, {oj ~"riga_documento~"  LEFT OUTER JOIN ~"articolo~"  ON ~"riga_documento~".~"id_articolo~" = ~"articolo~".~"id_articolo~"}, {oj ~"riga_documento~"  LEFT OUTER JOIN ~"unita_confezione~"  ON ~"riga_documento~".~"id_unita_confezione~" = ~"unita_confezione~".~"id_unita_confezione~"}, {oj ~"riga_documento~"  LEFT OUTER JOIN ~"des_articolo~"  ON ~"riga_documento~".~"id_des_articolo~" = ~"des_articolo~".~"id_des_articolo~"}
   WHERE ( ~"riga_documento~".~"id_documento~" = :ra_id_documento ) AND  
         ( ~"riga_documento~".~"id_azienda~" in (0,1) )    
" arguments=(("ra_id_documento", number)) )
