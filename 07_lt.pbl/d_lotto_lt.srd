//objectcomments dw di lotto specifica: mostra la situazione dei lotti: è un riepilogo!
release 6;
datawindow(units=0 timer_interval=60000 color=1090519039 processing=1 print.documentname="" print.orientation = 0 print.margin.left = 110 print.margin.right = 110 print.margin.top = 97 print.margin.bottom = 97 print.paper.source = 0 print.paper.size = 0 print.prompt=no print.buttons=no print.preview.buttons=no grid.lines=0 )
header(height=120 color="536870912" )
summary(height=16 color="536870912" )
footer(height=76 color="536870912" )
detail(height=88 color="553648127~tif((tipo_lotto=~"X~") or (tipo_lotto=~"Y~"), 65335, 16777215)" )
table(column=(type=long update=yes updatewhereclause=yes identity=yes name=id_lotto dbname="lotto.id_lotto" )
 column=(type=decimal(4) update=yes updatewhereclause=yes name=qta_iniziale dbname="lotto.qta_iniziale" )
 column=(type=decimal(4) update=yes updatewhereclause=yes name=qta_scaricata dbname="lotto.qta_scaricata" )
 column=(type=char(1) update=yes updatewhereclause=yes name=attivo dbname="lotto.attivo" )
 column=(type=char(32766) update=yes updatewhereclause=no name=note dbname="lotto.note" )
 column=(type=date update=yes updatewhereclause=yes name=data_scadenza dbname="lotto.data_scadenza" )
 column=(type=char(32) updatewhereclause=yes name=codice dbname="articolo.codice" )
 column=(type=char(80) updatewhereclause=yes name=articolo_descrizione dbname="articolo.descrizione" )
 column=(type=char(30) updatewhereclause=yes name=cod_esterno dbname="lotto.cod_esterno" )
 column=(type=char(1) updatewhereclause=yes name=tipo_lotto dbname="lotto.tipo_lotto" )
 column=(type=long updatewhereclause=yes name=numero dbname="lotto.numero" )
 column=(type=date updatewhereclause=yes name=data_doc dbname="lotto.data_doc" initial="today" )
 column=(type=decimal(4) updatewhereclause=yes name=peso_netto_iniziale dbname="lotto.peso_netto_iniziale" )
 column=(type=decimal(4) updatewhereclause=yes name=peso_netto_scaricato dbname="lotto.peso_netto_scaricato" )
 column=(type=decimal(4) updatewhereclause=yes name=rimanenza_peso dbname="rimanenza_peso" )
 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"lotto~" )  TABLE(NAME=~"articolo~" ) COLUMN(NAME=~"lotto.id_lotto~") COLUMN(NAME=~"lotto.qta_iniziale~") COLUMN(NAME=~"lotto.qta_scaricata~") COLUMN(NAME=~"lotto.attivo~") COLUMN(NAME=~"lotto.note~") COLUMN(NAME=~"lotto.data_scadenza~") COLUMN(NAME=~"articolo.codice~") COLUMN(NAME=~"articolo.descrizione~") COLUMN(NAME=~"lotto.cod_esterno~") COLUMN(NAME=~"lotto.tipo_lotto~") COLUMN(NAME=~"lotto.numero~") COLUMN(NAME=~"lotto.data_doc~") COLUMN(NAME=~"lotto.peso_netto_iniziale~") COLUMN(NAME=~"lotto.peso_netto_scaricato~") COMPUTE(NAME=~"CAST( (~~~"lotto~~~".~~~"peso_netto_iniziale~~~" - ifnull(~~~"lotto~~~".~~~"peso_netto_scaricato~~~" , 0, ~~~"lotto~~~".~~~"peso_netto_scaricato~~~") ) AS NUMERIC(18,4) ) AS rimanenza_peso~")    JOIN (LEFT=~"articolo.id_articolo~"    OP =~"=~"RIGHT=~"lotto.id_articolo~" )) "  sort="codice A cod_esterno A " )
