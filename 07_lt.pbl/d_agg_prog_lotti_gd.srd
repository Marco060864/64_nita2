release 6;
datawindow(units=0 timer_interval=0 color=79741120 processing=1 print.documentname="" print.orientation = 0 print.margin.left = 110 print.margin.right = 110 print.margin.top = 96 print.margin.bottom = 96 print.paper.source = 0 print.paper.size = 0 print.prompt=no print.buttons=no print.preview.buttons=no grid.lines=0 )
header(height=120 color="536870912" )
summary(height=0 color="536870912" )
footer(height=24 color="536870912" )
detail(height=72 color="536870912" )
table(column=(type=long updatewhereclause=yes key=yes identity=yes name=id_lotto dbname="lotto.id_lotto" )
 column=(type=long updatewhereclause=yes name=id_articolo dbname="lotto.id_articolo" )
 column=(type=char(32766) updatewhereclause=no name=note dbname="lotto.note" )
 column=(type=date updatewhereclause=yes name=data_scadenza dbname="lotto.data_scadenza" )
 column=(type=char(1) updatewhereclause=yes name=tipo_lotto dbname="lotto.tipo_lotto" values="Prodotto Finito	Z/Semilavorato	X/Materia Prima	M/" )
 column=(type=char(30) updatewhereclause=yes name=cod_esterno dbname="lotto.cod_esterno" )
 column=(type=decimal(4) update=yes updatewhereclause=yes name=peso_netto_iniziale dbname="lotto.peso_netto_iniziale" )
 column=(type=decimal(4) update=yes updatewhereclause=yes name=peso_netto_scaricato dbname="lotto.peso_netto_scaricato" )
 column=(type=decimal(4) updatewhereclause=yes name=peso_netto_da_lav dbname="lotto.peso_netto_da_lav" )
 column=(type=char(32) updatewhereclause=yes name=articolo_codice dbname="articolo.codice" )
 column=(type=char(80) updatewhereclause=yes name=articolo_descrizione dbname="articolo.descrizione" )
 column=(type=char(80) updatewhereclause=yes name=valori_esistenza dbname="valori_esistenza" )
 column=(type=decimal(4) updatewhereclause=yes name=esi_fiscale dbname="esi_fiscale" )
 column=(type=decimal(4) updatewhereclause=yes name=carichi dbname="carichi" )
 column=(type=decimal(4) updatewhereclause=yes name=scarichi dbname="scarichi" )
 column=(type=char(1) updatewhereclause=yes name=unita_misura_tipo dbname="unita_misura.tipo" values="Peso	P/Qta	--  --  --/Qta	Quantità/" )
 column=(type=decimal(4) update=yes updatewhereclause=yes name=lotto_qta_iniziale dbname="lotto.qta_iniziale" )
 column=(type=decimal(4) update=yes updatewhereclause=yes name=lotto_qta_scaricata dbname="lotto.qta_scaricata" )
 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"lotto~" )  TABLE(NAME=~"articolo~" )  TABLE(NAME=~"unita_confezione~" )  TABLE(NAME=~"unita_misura~" ) COLUMN(NAME=~"lotto.id_lotto~") COLUMN(NAME=~"lotto.id_articolo~") COLUMN(NAME=~"lotto.note~") COLUMN(NAME=~"lotto.data_scadenza~") COLUMN(NAME=~"lotto.tipo_lotto~") COLUMN(NAME=~"lotto.cod_esterno~") COLUMN(NAME=~"lotto.peso_netto_iniziale~") COLUMN(NAME=~"lotto.peso_netto_scaricato~") COLUMN(NAME=~"lotto.peso_netto_da_lav~") COLUMN(NAME=~"articolo.codice~") COLUMN(NAME=~"articolo.descrizione~") COMPUTE(NAME=~"CAST( fn_esi_lotti(~~~"lotto~~~".~~~"id_lotto~~~", 0, TODAY(*) ) AS CHAR(80) ) AS valori_esistenza~") COMPUTE(NAME=~"CAST( SUBSTR( valori_esistenza, 1, 20) AS DECIMAL(18,4) ) AS esi_fiscale~") COMPUTE(NAME=~"CAST( SUBSTR( valori_esistenza, 21, 20) AS DECIMAL(18,4) ) AS carichi~") COMPUTE(NAME=~"CAST( SUBSTR( valori_esistenza, 41, 20) AS DECIMAL(18,4) ) AS scarichi~") COLUMN(NAME=~"unita_misura.tipo~") COLUMN(NAME=~"lotto.qta_iniziale~") COLUMN(NAME=~"lotto.qta_scaricata~")    JOIN (LEFT=~"articolo.id_articolo~"    OP =~"=~"RIGHT=~"lotto.id_articolo~" )    JOIN (LEFT=~"unita_confezione.id_articolo~"    OP =~"=~"RIGHT=~"articolo.id_articolo~" )    JOIN (LEFT=~"unita_misura.id_unita_misura~"    OP =~"=~"RIGHT=~"unita_confezione.id_unita_misura~" )WHERE(    EXP1 =~"~~~"unita_confezione~~~".~~~"unita_base~~~"~"   OP =~"=~"    EXP2 =~"'S'~" ) ) " update="lotto" updatewhere=1 updatekeyinplace=yes )
