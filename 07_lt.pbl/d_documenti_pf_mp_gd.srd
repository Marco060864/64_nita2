footer(height=0 color="536870912" )
detail(height=64 color="536870912" )
table(column=(type=char(30) updatewhereclause=yes name=lotto_cod_esterno dbname="lotto.cod_esterno" )
 column=(type=char(32) updatewhereclause=yes name=articolo_codice dbname="articolo.codice" )
 column=(type=char(80) updatewhereclause=yes name=articolo_descrizione dbname="articolo.descrizione" )
 column=(type=decimal(4) updatewhereclause=yes name=riga_documento_quantita dbname="riga_documento.quantita" )
 column=(type=decimal(4) updatewhereclause=yes name=riga_documento_peso_netto dbname="riga_documento.peso_netto" )
 column=(type=date updatewhereclause=yes name=lotto_data_scadenza dbname="lotto.data_scadenza" )
 column=(type=char(8) updatewhereclause=yes name=prof_documento_codice dbname="prof_documento.codice" )
 column=(type=decimal(0) updatewhereclause=yes name=documento_num_progressivo dbname="documento.num_progressivo" )
 column=(type=date updatewhereclause=yes name=documento_data_registrazione dbname="documento.data_registrazione" )
 column=(type=char(16) updatewhereclause=yes name=documento_num_documento dbname="documento.num_documento" )
 column=(type=date updatewhereclause=yes name=documento_data_documento dbname="documento.data_documento" )
 column=(type=char(8) updatewhereclause=yes name=sog_commerciale_gen_codice dbname="sog_commerciale_gen.codice" )
 column=(type=char(40) updatewhereclause=yes name=sog_commerciale_gen_rag_soc_1 dbname="sog_commerciale_gen.rag_soc_1" )
 column=(type=char(1) updatewhereclause=yes name=lotto_tipo_lotto dbname="lotto.tipo_lotto" )
 column=(type=long updatewhereclause=yes name=id_documento dbname="documento.id_documento" )
 column=(type=char(1) updatewhereclause=yes name=c_tipo dbname="c_tipo" )
 retrieve="  SELECT ~"lotto~".~"cod_esterno~",   
         ~"articolo~".~"codice~",   
         ~"articolo~".~"descrizione~",   
         ~"riga_documento~".~"quantita~",   
         ~"riga_documento~".~"peso_netto~",   
         ~"lotto~".~"data_scadenza~",   
         ~"prof_documento~".~"codice~",   
         ~"documento~".~"num_progressivo~",   
         ~"documento~".~"data_registrazione~",   
         ~"documento~".~"num_documento~",   
         ~"documento~".~"data_documento~",   
         ~"sog_commerciale_gen~".~"codice~",   
         ~"sog_commerciale_gen~".~"rag_soc_1~",   
         ~"lotto~".~"tipo_lotto~",   
         ~"documento~".~"id_documento~",   
         CAST( 'A' AS CHAR(1) ) AS c_tipo  
    FROM ~"lotto~",   
         ~"riga_doc_lotto~",   
         ~"riga_documento~",   
         ~"documento~",   
         ~"sog_commerciale_gen~",   
         ~"prof_documento~",   
         ~"articolo~"  
   WHERE ( ~"lotto~".~"id_lotto~" = :rn_id_lotto_pf ) and
		   ( ~"riga_doc_lotto~".~"id_lotto~" = ~"lotto~".~"id_lotto~" ) and  
         ( ~"riga_documento~".~"id_riga_lotto~" = ~"riga_doc_lotto~".~"id_riga_lotto~" ) and  
         ( ~"documento~".~"id_documento~" = ~"riga_documento~".~"id_documento~" ) and  
         ( ~"sog_commerciale_gen~".~"id_sog_commerciale~" = ~"documento~".~"id_sog_commerciale~" ) and  
         ( ~"prof_documento~".~"id_prof_documento~" = ~"documento~".~"id_prof_documento~" ) and  
         ( ~"articolo~".~"id_articolo~" = ~"lotto~".~"id_articolo~" ) and  
         ( ~"riga_documento~".~"id_articolo~" = ~"articolo~".~"id_articolo~" )
         
UNION
  SELECT ~"lotto~".~"cod_esterno~",   
         ~"articolo~".~"codice~",   
         ~"articolo~".~"descrizione~",   
         ~"riga_documento~".~"quantita~",   
         ~"riga_documento~".~"peso_netto~",   
         ~"lotto~".~"data_scadenza~",   
         ~"prof_documento~".~"codice~",   
         ~"documento~".~"num_progressivo~",   
         ~"documento~".~"data_registrazione~",   
         ~"documento~".~"num_documento~",   
         ~"documento~".~"data_documento~",   
         ~"sog_commerciale_gen~".~"codice~",   
         ~"sog_commerciale_gen~".~"rag_soc_1~",   
         ~"lotto~".~"tipo_lotto~",   
         ~"documento~".~"id_documento~",   
         CAST( 'C' AS CHAR(1) ) AS c_tipo  
    FROM ~"lotto~",   
         ~"riga_documento~",   
         ~"documento~",   
         ~"sog_commerciale_gen~",   
         ~"prof_documento~",   
         ~"articolo~",
			~"lotto~" AS ~"lotto_pf~",
         ~"movimenti_lotto~"
   WHERE ( ~"lotto~".~"id_lotto~" = :rn_id_lotto_mp ) and
			( ~"lotto_pf~".~"id_lotto~" = :rn_id_lotto_pf ) and
         ( ~"movimenti_lotto~".~"num_lotto_prod~" = ~"lotto_pf~".~"numero~" ) and
         ( ~"movimenti_lotto~".~"id_lotto~" = ~"lotto~".~"id_lotto~" ) and
			( ~"riga_documento~".~"id_riga_documento~" = ~"movimenti_lotto~".~"id_riga_documento~" ) and  
         ( ~"documento~".~"id_documento~" = ~"riga_documento~".~"id_documento~" ) and  
         ( ~"sog_commerciale_gen~".~"id_sog_commerciale~" = ~"documento~".~"id_sog_commerciale~" ) and  
         ( ~"prof_documento~".~"id_prof_documento~" = ~"documento~".~"id_prof_documento~" ) and  
         ( ~"articolo~".~"id_articolo~" = ~"lotto~".~"id_articolo~" ) and  
         ( ~"riga_documento~".~"id_articolo~" = ~"articolo~".~"id_articolo~" )
UNION
  SELECT ~"lotto~".~"cod_esterno~",   
         ~"articolo~".~"codice~",   
         ~"articolo~".~"descrizione~",   
         ~"riga_documento~".~"quantita~",   
         ~"riga_documento~".~"peso_netto~",   
         ~"lotto~".~"data_scadenza~",   
         ~"prof_documento~".~"codice~",   
         ~"documento~".~"num_progressivo~",   
         ~"documento~".~"data_registrazione~",   
         ~"documento~".~"num_documento~",   
         ~"documento~".~"data_documento~",   
         ~"sog_commerciale_gen~".~"codice~",   
         ~"sog_commerciale_gen~".~"rag_soc_1~",   
         ~"lotto~".~"tipo_lotto~",   
         ~"documento~".~"id_documento~",   
         CAST( 'B' AS CHAR(1) ) AS c_tipo  
    FROM ~"lotto~",   
         ~"riga_doc_lotto~",   
         ~"riga_documento~",   
         ~"documento~",   
         ~"sog_commerciale_gen~",   
         ~"prof_documento~",   
         ~"articolo~",
			~"caus_magazzino~"
   WHERE ( ~"lotto~".~"id_lotto~" = :rn_id_lotto_mp ) and
		   ( ~"riga_doc_lotto~".~"id_lotto~" = ~"lotto~".~"id_lotto~" ) and  
         ( ~"riga_documento~".~"id_riga_lotto~" = ~"riga_doc_lotto~".~"id_riga_lotto~" ) and  
         ( ~"documento~".~"id_documento~" = ~"riga_documento~".~"id_documento~" ) and  
         ( ~"sog_commerciale_gen~".~"id_sog_commerciale~" = ~"documento~".~"id_sog_commerciale~" ) and  
         ( ~"prof_documento~".~"id_prof_documento~" = ~"documento~".~"id_prof_documento~" ) and  
         ( ~"articolo~".~"id_articolo~" = ~"lotto~".~"id_articolo~" ) and  
         ( ~"riga_documento~".~"id_articolo~" = ~"articolo~".~"id_articolo~" ) and
			( ~"caus_magazzino~".~"id_caus_magazzino~" = ~"riga_documento~".~"id_caus_magazzino~" ) and
			( ~"caus_magazzino~".~"gestisce_lotti~" = 'C' )


         

" arguments=(("rn_id_lotto_mp", number),("rn_id_lotto_pf", number))  sort="c_tipo A prof_documento_codice A documento_num_progressivo A documento_data_registrazione A " )
