 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"lotto~" ) COLUMN(NAME=~"lotto.id_lotto~") COLUMN(NAME=~"lotto.id_anag_modello~") COLUMN(NAME=~"lotto.id_articolo~") COLUMN(NAME=~"lotto.qta_iniziale~") COLUMN(NAME=~"lotto.qta_scaricata~") COLUMN(NAME=~"lotto.attivo~") COLUMN(NAME=~"lotto.note~") COLUMN(NAME=~"lotto.data_scadenza~") COLUMN(NAME=~"lotto.tipo_lotto~") COLUMN(NAME=~"lotto.cod_esterno~") COLUMN(NAME=~"lotto.numero~") COLUMN(NAME=~"lotto.data_doc~") COLUMN(NAME=~"lotto.modulo~") COLUMN(NAME=~"lotto.lotto_ster_1~") COLUMN(NAME=~"lotto.lotto_ster_2~")WHERE(    EXP1 =~"~~~"lotto~~~".~~~"tipo_lotto~~~"~"   OP =~"=~"    EXP2 =~"'S'~"    LOGIC =~"or~" ) WHERE(    EXP1 =~"~~~"lotto~~~".~~~"tipo_lotto~~~"~"   OP =~"=~"    EXP2 =~"'P'~"    LOGIC =~"or~" ) WHERE(    EXP1 =~"~~~"lotto~~~".~~~"tipo_lotto~~~"~"   OP =~"=~"    EXP2 =~"'X'~"    LOGIC =~"or~" ) WHERE(    EXP1 =~"~~~"lotto~~~".~~~"tipo_lotto~~~"~"   OP =~"=~"    EXP2 =~"'Y'~" ) ) " update="lotto" updatewhere=1 updatekeyinplace=yes  sort="data_scadenza A qta_iniziale - if(isnull( qta_scaricata ), 0,  qta_scaricata ) A " )
