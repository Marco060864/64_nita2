 column=(type=decimal(4) updatewhereclause=yes name=peso_netto_scaricato dbname="lotto.peso_netto_scaricato" )
 column=(type=decimal(4) updatewhereclause=yes name=peso_netto_da_lav dbname="lotto.peso_netto_da_lav" )
 column=(type=decimal(4) updatewhereclause=yes name=val_sel dbname="val_sel" )
 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"lotto~" ) COLUMN(NAME=~"lotto.id_lotto~") COLUMN(NAME=~"lotto.id_anag_modello~") COLUMN(NAME=~"lotto.id_articolo~") COLUMN(NAME=~"lotto.qta_iniziale~") COLUMN(NAME=~"lotto.qta_scaricata~") COLUMN(NAME=~"lotto.attivo~") COLUMN(NAME=~"lotto.note~") COLUMN(NAME=~"lotto.data_scadenza~") COLUMN(NAME=~"lotto.tipo_lotto~") COLUMN(NAME=~"lotto.cod_esterno~") COLUMN(NAME=~"lotto.numero~") COLUMN(NAME=~"lotto.data_doc~") COLUMN(NAME=~"lotto.modulo~") COLUMN(NAME=~"lotto.lotto_ster_1~") COLUMN(NAME=~"lotto.lotto_ster_2~") COLUMN(NAME=~"lotto.peso_netto_iniziale~") COLUMN(NAME=~"lotto.peso_netto_scaricato~") COLUMN(NAME=~"lotto.peso_netto_da_lav~") COMPUTE(NAME=~"cast(0 as numeric(18,4) ) as val_sel~")WHERE(    EXP1 =~"~~~"lotto~~~".~~~"id_articolo~~~"~"   OP =~"=~"    EXP2 =~":rn_id_articolo~" ) ) ARG(NAME = ~"rn_id_articolo~" TYPE = number) " arguments=(("rn_id_articolo", number)) )
