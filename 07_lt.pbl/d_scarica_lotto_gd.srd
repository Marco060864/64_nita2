table(column=(type=long updatewhereclause=yes name=id_lotto dbname="lotto.id_lotto" )
 column=(type=long updatewhereclause=yes name=id_anag_modello dbname="lotto.id_anag_modello" )
 column=(type=long updatewhereclause=yes name=id_articolo dbname="lotto.id_articolo" )
 column=(type=decimal(4) updatewhereclause=yes name=qta_iniziale dbname="lotto.qta_iniziale" )
 column=(type=decimal(4) updatewhereclause=yes name=qta_scaricata dbname="lotto.qta_scaricata" )
 column=(type=char(1) updatewhereclause=yes name=attivo dbname="lotto.attivo" )
 column=(type=char(32766) updatewhereclause=no name=note dbname="lotto.note" )
 column=(type=date updatewhereclause=yes name=data_scadenza dbname="lotto.data_scadenza" )
 column=(type=char(1) updatewhereclause=yes name=tipo_lotto dbname="lotto.tipo_lotto" values="Prodotto Finito	Z/Semilavorato	K/Materia Prima	M/" )
 column=(type=char(30) updatewhereclause=yes name=cod_esterno dbname="lotto.cod_esterno" )
 column=(type=long updatewhereclause=yes name=numero dbname="lotto.numero" )
 column=(type=date updatewhereclause=yes name=data_doc dbname="lotto.data_doc" )
 column=(type=char(20) updatewhereclause=yes name=modulo dbname="lotto.modulo" )
 column=(type=char(16) updatewhereclause=yes name=lotto_ster_1 dbname="lotto.lotto_ster_1" )
 column=(type=char(16) updatewhereclause=yes name=lotto_ster_2 dbname="lotto.lotto_ster_2" )
