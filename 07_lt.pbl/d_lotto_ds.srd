//objectcomments datastore usata per aggiornare i lotti nei documenti
release 6;
datawindow(units=0 timer_interval=0 color=79741120 processing=0 print.documentname="" print.orientation = 0 print.margin.left = 110 print.margin.right = 110 print.margin.top = 97 print.margin.bottom = 97 print.paper.source = 0 print.paper.size = 0 print.prompt=no print.buttons=no print.preview.buttons=no )
header(height=68 color="536870912" )
summary(height=4 color="536870912" )
footer(height=0 color="536870912" )
detail(height=88 color="536870912" )
table(column=(type=long update=yes updatewhereclause=yes key=yes identity=yes name=id_lotto dbname="lotto.id_lotto" )
 column=(type=long update=yes updatewhereclause=yes name=id_anag_modello dbname="lotto.id_anag_modello" )
 column=(type=long update=yes updatewhereclause=yes name=id_articolo dbname="lotto.id_articolo" )
 column=(type=decimal(4) update=yes updatewhereclause=yes name=qta_iniziale dbname="lotto.qta_iniziale" )
 column=(type=decimal(4) update=yes updatewhereclause=yes name=qta_scaricata dbname="lotto.qta_scaricata" initial="0" )
 column=(type=char(1) update=yes updatewhereclause=yes name=attivo dbname="lotto.attivo" initial="S" values="	S/	N" )
 column=(type=char(32766) update=yes updatewhereclause=no name=note dbname="lotto.note" )
 column=(type=date update=yes updatewhereclause=yes name=data_scadenza dbname="lotto.data_scadenza" )
 column=(type=char(30) update=yes updatewhereclause=yes name=cod_esterno dbname="lotto.cod_esterno" )
 column=(type=long update=yes updatewhereclause=yes name=numero dbname="lotto.numero" )
 column=(type=char(1) update=yes updatewhereclause=yes name=tipo_lotto dbname="lotto.tipo_lotto" )
 column=(type=long updatewhereclause=yes name=id_doc dbname="riga_doc_lotto.id_doc" )
 column=(type=char(16) update=yes updatewhereclause=yes name=ster_1 dbname="lotto.lotto_ster_1" )
 column=(type=char(16) update=yes updatewhereclause=yes name=ster_2 dbname="lotto.lotto_ster_2" )
 column=(type=decimal(4) update=yes updatewhereclause=yes name=peso_netto_iniziale dbname="lotto.peso_netto_iniziale" )
 column=(type=decimal(4) update=yes updatewhereclause=yes name=peso_netto_scaricato dbname="lotto.peso_netto_scaricato" )
 column=(type=date update=yes updatewhereclause=yes name=lotto_data_doc dbname="lotto.data_doc" )
 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"lotto~" )  TABLE(NAME=~"riga_doc_lotto~" ) COLUMN(NAME=~"lotto.id_lotto~") COLUMN(NAME=~"lotto.id_anag_modello~") COLUMN(NAME=~"lotto.id_articolo~") COLUMN(NAME=~"lotto.qta_iniziale~") COLUMN(NAME=~"lotto.qta_scaricata~") COLUMN(NAME=~"lotto.attivo~") COLUMN(NAME=~"lotto.note~") COLUMN(NAME=~"lotto.data_scadenza~") COLUMN(NAME=~"lotto.cod_esterno~") COLUMN(NAME=~"lotto.numero~") COLUMN(NAME=~"lotto.tipo_lotto~") COLUMN(NAME=~"riga_doc_lotto.id_doc~") COLUMN(NAME=~"lotto.lotto_ster_1~") COLUMN(NAME=~"lotto.lotto_ster_2~") COLUMN(NAME=~"lotto.peso_netto_iniziale~") COLUMN(NAME=~"lotto.peso_netto_scaricato~") COLUMN(NAME=~"lotto.data_doc~")    JOIN (LEFT=~"lotto.numero~"    OP =~"=~"RIGHT=~"riga_doc_lotto.id_riga_lotto~" )WHERE(    EXP1 =~"~~~"riga_doc_lotto~~~".~~~"id_doc~~~"~"   OP =~"=~"    EXP2 =~":ra_id_doc~" ) ) ORDER(NAME=~"lotto.data_scadenza~" ASC=yes ) ARG(NAME = ~"ra_id_doc~" TYPE = number) " update="lotto" updatewhere=1 updatekeyinplace=yes arguments=(("ra_id_doc", number)) )
