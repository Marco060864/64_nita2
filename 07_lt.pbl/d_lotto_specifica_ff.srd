 retrieve="PBSELECT( VERSION(400) DISTINCT ()TABLE(NAME=~"lotto~" )  TABLE(NAME=~"articolo~" ) COLUMN(NAME=~"lotto.id_lotto~") COLUMN(NAME=~"lotto.qta_iniziale~") COLUMN(NAME=~"lotto.qta_scaricata~") COLUMN(NAME=~"lotto.attivo~") COLUMN(NAME=~"lotto.note~") COLUMN(NAME=~"lotto.data_scadenza~") COLUMN(NAME=~"articolo.codice~") COLUMN(NAME=~"lotto.tipo_lotto~") COLUMN(NAME=~"lotto.id_articolo~") COLUMN(NAME=~"articolo.descrizione~") COLUMN(NAME=~"lotto.cod_esterno~") COLUMN(NAME=~"lotto.numero~") COLUMN(NAME=~"lotto.data_doc~") COLUMN(NAME=~"lotto.modulo~") COLUMN(NAME=~"lotto.peso_netto_iniziale~") COLUMN(NAME=~"lotto.peso_netto_scaricato~")    JOIN (LEFT=~"articolo.id_articolo~"    OP =~"=~"RIGHT=~"lotto.id_articolo~" )) " update="lotto" updatewhere=1 updatekeyinplace=yes )
