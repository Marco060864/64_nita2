 column=(type=char(1) update=yes updatewhereclause=yes name=tipo_lotto dbname="lotto.tipo_lotto" values="Prodotto Finito	Z/Semilavorato	K/Materia Prima	M/PF in sterilizzazione	X/SM in sterilizzazione	Y/da sterilizzare	P/" )
