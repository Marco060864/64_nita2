table(column=(type=long updatewhereclause=yes identity=yes name=documento_id_documento dbname="documento.id_documento" )
 column=(type=decimal(0) updatewhereclause=yes name=documento_num_progressivo dbname="documento.num_progressivo" )
 column=(type=date updatewhereclause=yes name=documento_data_registrazione dbname="documento.data_registrazione" )
 column=(type=char(16) updatewhereclause=yes name=documento_num_documento dbname="documento.num_documento" )
 column=(type=date updatewhereclause=yes name=documento_data_documento dbname="documento.data_documento" )
 column=(type=long updatewhereclause=yes identity=yes name=riga_documento_id_riga_documento dbname="riga_documento.id_riga_documento" )
 column=(type=decimal(0) updatewhereclause=yes name=riga_documento_num_riga dbname="riga_documento.num_riga" )
 column=(type=decimal(4) updatewhereclause=yes name=riga_documento_quantita dbname="riga_documento.quantita" )
 column=(type=decimal(6) updatewhereclause=yes name=riga_documento_prezzo dbname="riga_documento.prezzo" )
 column=(type=decimal(4) updatewhereclause=yes name=riga_documento_peso_netto dbname="riga_documento.peso_netto" )
 column=(type=decimal(6) updatewhereclause=yes name=riga_documento_prezzo_manifattura dbname="riga_documento.prezzo_manifattura" )
 column=(type=char(64) updatewhereclause=yes name=articolo_codice dbname="articolo.codice" )
 column=(type=long updatewhereclause=yes identity=yes name=articolo_id_articolo dbname="articolo.id_articolo" )
 column=(type=char(32766) updatewhereclause=no name=riga_documento_descrizione dbname="riga_documento.descrizione" )
 column=(type=char(2) updatewhereclause=yes name=registro_tipo_registro dbname="registro.tipo_registro" )
 column=(type=char(1) updatewhereclause=yes name=sog_commerciale_tipo dbname="sog_commerciale.tipo" )
 column=(type=char(8) updatewhereclause=yes name=prof_documento_codice dbname="prof_documento.codice" )
 column=(type=char(8) updatewhereclause=yes name=sog_commerciale_codice dbname="sog_commerciale.codice" )
 column=(type=decimal(6) updatewhereclause=yes name=riga_documento_prezzo_complessivo dbname="riga_documento.prezzo_complessivo" )
 column=(type=decimal(6) updatewhereclause=yes name=c_pr_listino dbname="c_pr_listino" )
 column=(type=char(32766) updatewhereclause=no name=c_des dbname="riga_documento.c_des" )
 column=(type=decimal(6) updatewhereclause=yes name=c_pr_fat dbname="riga_documento.c_pr_fat" )
 retrieve="  SELECT ~"documento~".~"id_documento~",   
         ~"documento~".~"num_progressivo~",   
         ~"documento~".~"data_registrazione~",   
         ~"documento~".~"num_documento~",   
         ~"documento~".~"data_documento~",   
         ~"riga_documento~".~"id_riga_documento~",   
         ~"riga_documento~".~"num_riga~",   
         ~"riga_documento~".~"quantita~",   
         ~"riga_documento~".~"prezzo~",   
         ~"riga_documento~".~"peso_netto~",   
         ~"riga_documento~".~"prezzo_manifattura~",   
         ~"articolo~".~"codice~",   
         ~"articolo~".~"id_articolo~",   
         ~"riga_documento~".~"descrizione~",   
         ~"registro~".~"tipo_registro~",   
         ~"sog_commerciale~".~"tipo~",   
         ~"prof_documento~".~"codice~",   
         ~"sog_commerciale~".~"codice~"  , ~"riga_documento~".~"prezzo_complessivo~",
		(select prezzo from dba.prezzo  where id_variazione=15 and id_unita_confezione=~"riga_documento~".~"id_unita_confezione~") as c_pr_listino,
		r2.descrizione as c_des,
		r2.prezzo_complessivo as c_pr_fat
		
    FROM
 {oj ~"riga_documento~" LEFT OUTER JOIN ~"riga_documento~" as r2 ON ~"riga_documento~".~"id_riga_doc_provenienza~" = ~"r2~".~"id_riga_documento~"}, 
		~"articolo~",   
         ~"documento~",   
         ~"riga_documento~",   
         ~"registro~",   
         ~"sog_commerciale~",   
         ~"prof_documento~"  
   WHERE ( ~"riga_documento~".~"id_documento~" = ~"documento~".~"id_documento~" ) and  //prezzo.id_variazione=15 and
         ( ~"riga_documento~".~"id_articolo~" = ~"articolo~".~"id_articolo~" ) and  
         ( ~"documento~".~"id_registro~" = ~"registro~".~"id_registro~" ) and  
         ( ~"documento~".~"id_sog_commerciale~" = ~"sog_commerciale~".~"id_sog_commerciale~" ) and  
         ( ~"documento~".~"id_prof_documento~" = ~"prof_documento~".~"id_prof_documento~" ) and  
         ( ( ~"documento~".~"data_documento~" >= :da_data ) AND  
         ( ~"documento~".~"data_documento~" <= :a_data ) )    
" arguments=(("da_data", date),("a_data", date))  sort="prof_documento_codice D documento_data_documento D articolo_id_articolo A " )
