 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"anagrafica~" )  TABLE(NAME=~"sog_commerciale~" )  TABLE(NAME=~"lingua~" )  TABLE(NAME=~"conto~" )  TABLE(NAME=~"sottomastro~" ) COLUMN(NAME=~"sog_commerciale.id_sog_commerciale~") COLUMN(NAME=~"anagrafica.rag_soc_1~") COLUMN(NAME=~"sog_commerciale.tipo~") COLUMN(NAME=~"sog_commerciale.codice~") COLUMN(NAME=~"sog_commerciale.crea_gruppo_agenti~")    JOIN (LEFT=~"lingua.id_lingua~"    OP =~"=~"RIGHT=~"anagrafica.id_lingua~"    OUTER2 =~"anagrafica.id_lingua~" )    JOIN (LEFT=~"sog_commerciale.id_anagrafica~"    OP =~"=~"RIGHT=~"anagrafica.id_anagrafica~" )    JOIN (LEFT=~"sottomastro.id_sottomastro~"    OP =~"=~"RIGHT=~"conto.id_sottomastro~" )    JOIN (LEFT=~"sog_commerciale.id_conto~"    OP =~"=~"RIGHT=~"conto.id_conto~" )WHERE(    EXP1 =~"~~~"sottomastro~~~".~~~"uso~~~"~"   OP =~"=~"    EXP2 =~"'F'~" ) ) " update="sog_commerciale" updatewhere=1 updatekeyinplace=yes  sort="rag_soc_1 A " )
