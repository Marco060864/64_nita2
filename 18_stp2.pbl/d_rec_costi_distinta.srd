 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"art_per_lavorazione~" )  TABLE(NAME=~"riga_distinta~" )  TABLE(NAME=~"distinta~" ) COLUMN(NAME=~"art_per_lavorazione.lavorazione~") COLUMN(NAME=~"riga_distinta.costo~") COLUMN(NAME=~"art_per_lavorazione.id_articolo~") COLUMN(NAME=~"distinta.id_articolo~") COLUMN(NAME=~"riga_distinta.id_riga_distinta~") COLUMN(NAME=~"riga_distinta.id_articolo~") COLUMN(NAME=~"riga_distinta.id_distinta~") COLUMN(NAME=~"riga_distinta.num_riga~") COLUMN(NAME=~"riga_distinta.tipo_riga~") COLUMN(NAME=~"riga_distinta.quantita~") COLUMN(NAME=~"riga_distinta.peso_netto~") COLUMN(NAME=~"riga_distinta.varie~")    JOIN (LEFT=~"riga_distinta.id_articolo~"    OP =~"=~"RIGHT=~"art_per_lavorazione.id_articolo~" )    JOIN (LEFT=~"distinta.id_distinta~"    OP =~"=~"RIGHT=~"riga_distinta.id_distinta~" )WHERE(    EXP1 =~"~~~"distinta~~~".~~~"id_articolo~~~"~"   OP =~"=~"    EXP2 =~":art~" ) ) ARG(NAME = ~"art~" TYPE = number) " update="riga_distinta" updatewhere=1 updatekeyinplace=yes arguments=(("art", number)) )
