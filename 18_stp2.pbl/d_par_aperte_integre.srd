 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"orafo_aper_partita~" )  TABLE(NAME=~"documento~" )  TABLE(NAME=~"orafo_titolo~" )  TABLE(NAME=~"caus_magazzino~" )  TABLE(NAME=~"orafo_tipo_partita~" ) COLUMN(NAME=~"orafo_aper_partita.id_partita~") COLUMN(NAME=~"orafo_aper_partita.stato~") COLUMN(NAME=~"orafo_aper_partita.id_documento~") COLUMN(NAME=~"orafo_aper_partita.id_tipo_partita~") COLUMN(NAME=~"orafo_aper_partita.val_apertura~") COLUMN(NAME=~"orafo_aper_partita.val_scarico~") COLUMN(NAME=~"orafo_aper_partita.id_titolo~") COLUMN(NAME=~"documento.data_documento~") COLUMN(NAME=~"documento.id_sog_commerciale~") COLUMN(NAME=~"documento.id_caus_magazzino~") COLUMN(NAME=~"orafo_titolo.id_metallo~") COLUMN(NAME=~"orafo_tipo_partita.cod_tipo_partita~") COLUMN(NAME=~"documento.num_documento~")    JOIN (LEFT=~"documento.id_documento~"    OP =~"=~"RIGHT=~"orafo_aper_partita.id_documento~" )    JOIN (LEFT=~"orafo_titolo.id_titolo~"    OP =~"=~"RIGHT=~"orafo_aper_partita.id_titolo~" )    JOIN (LEFT=~"caus_magazzino.id_caus_magazzino~"    OP =~"=~"RIGHT=~"documento.id_caus_magazzino~" )    JOIN (LEFT=~"orafo_tipo_partita.id_tipo_partita~"    OP =~"=~"RIGHT=~"caus_magazzino.id_tipo_partita~" )WHERE(    EXP1 =~"~~~"orafo_aper_partita~~~".~~~"id_partita~~~"~"   OP =~"not in~"    EXP2 =~"(select id_partita from orafo_scar_partita)~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"documento~~~".~~~"data_documento~~~"~"   OP =~">=~"    EXP2 =~":da_data~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"documento~~~".~~~"data_documento~~~"~"   OP =~"<=~"    EXP2 =~":a_data~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"orafo_titolo~~~".~~~"id_metallo~~~"~"   OP =~"=~"    EXP2 =~":id_metallo~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"documento~~~".~~~"id_sog_commerciale~~~"~"   OP =~"=~"    EXP2 =~":id_sog~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"orafo_tipo_partita~~~".~~~"cod_tipo_partita~~~"~"   OP =~"=~"    EXP2 =~":tipo_partita~" ) ) ARG(NAME = ~"da_data~" TYPE = date)  ARG(NAME = ~"a_data~" TYPE = date)  ARG(NAME = ~"id_metallo~" TYPE = number)  ARG(NAME = ~"id_sog~" TYPE = number)  ARG(NAME = ~"tipo_partita~" TYPE = string) " arguments=(("da_data", date),("a_data", date),("id_metallo", number),("id_sog", number),("tipo_partita", string))  sort="data_documento A id_tipo_partita A " )
