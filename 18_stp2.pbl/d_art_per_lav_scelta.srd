 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"art_per_lavorazione~" )  TABLE(NAME=~"unita_confezione~" )  TABLE(NAME=~"prezzo~" )  TABLE(NAME=~"variazione~" )  TABLE(NAME=~"listino~" )  TABLE(NAME=~"unita_misura~" ) COLUMN(NAME=~"art_per_lavorazione.id_articolo~") COLUMN(NAME=~"art_per_lavorazione.descrizione~") COMPUTE(NAME=~"cast(0 as integer) as c_scegli~") COLUMN(NAME=~"prezzo.prezzo~") COLUMN(NAME=~"prezzo.prezzo_manifattura~") COLUMN(NAME=~"unita_misura.tipo~") COLUMN(NAME=~"unita_confezione.id_unita_confezione~") COLUMN(NAME=~"art_per_lavorazione.lavorazione~")    JOIN (LEFT=~"art_per_lavorazione.id_articolo~"    OP =~"=~"RIGHT=~"unita_confezione.id_articolo~" )    JOIN (LEFT=~"prezzo.id_unita_confezione~"    OP =~"=~"RIGHT=~"unita_confezione.id_unita_confezione~" )    JOIN (LEFT=~"variazione.id_variazione~"    OP =~"=~"RIGHT=~"prezzo.id_variazione~" )    JOIN (LEFT=~"listino.id_listino~"    OP =~"=~"RIGHT=~"variazione.id_listino~" )    JOIN (LEFT=~"unita_confezione.id_unita_misura~"    OP =~"=~"RIGHT=~"unita_misura.id_unita_misura~" )WHERE(    EXP1 =~"~~~"unita_confezione~~~".~~~"unita_base~~~"~"   OP =~"=~"    EXP2 =~"'S'~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"variazione~~~".~~~"data_inizio~~~"~"   OP =~"<=~"    EXP2 =~"today()~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"variazione~~~".~~~"data_fine~~~"~"   OP =~">=~"    EXP2 =~"today()~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"listino~~~".~~~"tipo~~~"~"   OP =~"=~"    EXP2 =~"'V'~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"listino~~~".~~~"lis_base~~~"~"   OP =~"=~"    EXP2 =~"'S'~" ) ) " )
