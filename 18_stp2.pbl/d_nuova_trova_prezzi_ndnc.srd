a_documento_a.id_riga_doc_provenienza~"    OP =~"=~"RIGHT=~"riga_documento_b.id_riga_documento~"    OUTER1 =~"riga_documento_a.id_riga_doc_provenienza~" )    JOIN (LEFT=~"riga_documento_b.id_documento~"    OP =~"=~"RIGHT=~"documento_b.id_documento~"    OUTER1 =~"riga_documento_b.id_documento~" )    JOIN (LEFT=~"documento_a.id_documento~"    OP =~"=~"RIGHT=~"riga_documento_a.id_documento~"    OUTER1 =~"documento_a.id_documento~" )    JOIN (LEFT=~"riga_documento_c.id_documento~"    OP =~"=~"RIGHT=~"documento_c.id_documento~"    OUTER1 =~"riga_documento_c.id_documento~" )WHERE(    EXP1 =~"(~~~"documento_a~~~".~~~"id_prof_documento~~~"~"   OP =~"=~"    EXP2 =~"158~"    LOGIC =~"or~" ) WHERE(    EXP1 =~"~~~"documento_a~~~".~~~"id_prof_documento~~~"~"   OP =~"=~"    EXP2 =~"54)~" ) ) " )
