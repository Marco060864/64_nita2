 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"documento~" )  TABLE(NAME=~"articolo~" )  TABLE(NAME=~"riga_documento~" )  TABLE(NAME=~"caus_magazzino~" )  TABLE(NAME=~"unita_confezione~" )  TABLE(NAME=~"unita_misura~" ) COLUMN(NAME=~"documento.num_progressivo~") COLUMN(NAME=~"documento.data_registrazione~") COLUMN(NAME=~"riga_documento.id_riga_documento~") COLUMN(NAME=~"riga_documento.id_documento~") COLUMN(NAME=~"riga_documento.id_articolo~") COLUMN(NAME=~"riga_documento.qta_un_base~") COLUMN(NAME=~"riga_documento.id_caus_magazzino~") COLUMN(NAME=~"riga_documento.peso_netto~") COLUMN(NAME=~"riga_documento.tot_riga_val_doc~") COLUMN(NAME=~"riga_documento.tot_riga_val_az~") COLUMN(NAME=~"riga_documento.calo~") COLUMN(NAME=~"riga_documento.fino~") COLUMN(NAME=~"riga_documento.prezzo_metallo~") COLUMN(NAME=~"riga_documento.prezzo_manifattura~") COLUMN(NAME=~"articolo.codice~") COLUMN(NAME=~"articolo.descrizione~") COLUMN(NAME=~"articolo.id_titolo~") COLUMN(NAME=~"documento.id_sog_commerciale~") COLUMN(NAME=~"riga_documento.importo_manifattura~") COLUMN(NAME=~"documento.id_valuta~") COLUMN(NAME=~"caus_magazzino.codice~") COLUMN(NAME=~"caus_magazzino.segno_pezzi~") COLUMN(NAME=~"unita_misura.tipo~")    JOIN (LEFT=~"riga_documento.id_articolo~"    OP =~"=~"RIGHT=~"articolo.id_articolo~" )    JOIN (LEFT=~"riga_documento.id_documento~"    OP =~"=~"RIGHT=~"documento.id_documento~" )    JOIN (LEFT=~"caus_magazzino.id_caus_magazzino~"    OP =~"=~"RIGHT=~"riga_documento.id_caus_magazzino~" )    JOIN (LEFT=~"unita_confezione.id_unita_confezione~"    OP =~"=~"RIGHT=~"riga_documento.id_unita_confezione~" )    JOIN (LEFT=~"unita_misura.id_unita_misura~"    OP =~"=~"RIGHT=~"unita_confezione.id_unita_misura~" )WHERE(    EXP1 =~"( ~~~"documento~~~".~~~"data_documento~~~"~"   OP =~">=~"    EXP2 =~":da_data )~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"( ~~~"documento~~~".~~~"data_documento~~~"~"   OP =~"<=~"    EXP2 =~":a_data )~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"( ~~~"unita_misura~~~".~~~"tipo~~~"~"   OP =~"=~"    EXP2 =~"'N' )~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"articolo~~~".~~~"codice~~~"~"   OP =~"not in~"    EXP2 =~"'6IVA'~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"articolo~~~".~~~"codice~~~"~"   OP =~"not in~"    EXP2 =~"'8RIMBORSI SU SPESE'~" ) ) ARG(NAME = ~"da_data~" TYPE = date)  ARG(NAME = ~"a_data~" TYPE = date)  ARG(NAME = ~"tipo_arr~" TYPE = string)  ARG(NAME = ~"num_dec~" TYPE = number)  ARG(NAME = ~"cambio~" TYPE = number)  ARG(NAME = ~"id_valuta~" TYPE = number) " arguments=(("da_data", date),("a_data", date),("tipo_arr", string),("num_dec", number),("cambio", number),("id_valuta", number))  sort="articolo_codice A caus_magazzino_segno_pezzi A " )
