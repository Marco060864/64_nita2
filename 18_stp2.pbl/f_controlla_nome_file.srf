global type f_controlla_nome_file from function_object
end type

forward prototypes
global function string f_controlla_nome_file (string as_nome_file)
end prototypes

global function string f_controlla_nome_file (string as_nome_file);integer i


i=pos(as_nome_file, "/")

do while i>0 
	as_nome_file=Replace ( as_nome_file, i, 1, "-") 
	i=pos(as_nome_file, "/")
loop

return as_nome_file
end function

