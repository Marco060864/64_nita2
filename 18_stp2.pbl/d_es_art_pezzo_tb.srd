compute(band=detail alignment="0" expression="if( caus_magazzino_segno_pezzi ='+', if( ra_id_valuta_di_stampa = valuta_id_valuta ,  f_round(riga_documento_tot_riga_val_az,  num_dec , tipo_arr ) ,  f_round(riga_documento_tot_riga_val_az / cambio,  num_dec , tipo_arr )),  if( ra_id_valuta_di_stampa = valuta_id_valuta ,  f_round(riga_documento_tot_riga_val_az,  num_dec , tipo_arr ) ,  f_round(riga_documento_tot_riga_val_az / cambio,  num_dec , tipo_arr ))* -1)"border="0" color="0" x="1321" y="12" height="68" width="494" format="~tf_valu_mask( ra_id_valuta_di_stampa )"  name=importo visible="1~t0"  font.face="Arial" font.height="-8" font.weight="400"  font.family="2" font.pitch="2" font.charset="0" background.mode="1" background.color="536870912" )
compute(band=detail alignment="0" expression="if( caus_magazzino_segno_pezzi ='+',  riga_documento_qta_un_base ,  riga_documento_qta_un_base * -1)"border="0" color="0" x="311" y="16" height="56" width="183" format="[general]"  name=qta  font.face="Arial" font.height="-8" font.weight="400"  font.family="2" font.pitch="2" font.charset="0" background.mode="1" background.color="536870912" )
