detail(height=0 color="536870912" )
table(column=(type=char(32) updatewhereclause=yes name=articolo_codice dbname="articolo.codice" )
 column=(type=char(80) updatewhereclause=yes name=articolo_descrizione dbname="articolo.descrizione" )
 column=(type=decimal(4) updatewhereclause=yes name=riga_documento_qta_un_base dbname="riga_documento.qta_un_base" )
 column=(type=char(5) updatewhereclause=yes name=valuta_simbolo dbname="valuta.simbolo" )
 column=(type=decimal(0) updatewhereclause=yes name=valuta_cifra_arrotondamento dbname="valuta.cifra_arrotondamento" )
 column=(type=char(1) updatewhereclause=yes name=valuta_tipo_arrotondamento dbname="valuta.tipo_arrotondamento" )
 column=(type=decimal(4) updatewhereclause=yes name=riga_documento_cambio dbname="riga_documento.cambio" )
 column=(type=decimal(6) updatewhereclause=yes name=riga_documento_tot_riga_val_az dbname="riga_documento.tot_riga_val_az" )
 column=(type=char(1) updatewhereclause=yes name=caus_magazzino_segno_pezzi dbname="caus_magazzino.segno_pezzi" )
 column=(type=long updatewhereclause=yes identity=yes name=valuta_id_valuta dbname="valuta.id_valuta" )
 column=(type=decimal(6) updatewhereclause=yes name=prezzo dbname="prezzo" )
 column=(type=decimal(6) updatewhereclause=yes name=costo dbname="costo" )
 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"articolo~" )  TABLE(NAME=~"caus_magazzino~" )  TABLE(NAME=~"riga_documento~" )  TABLE(NAME=~"documento~" )  TABLE(NAME=~"valuta~" ) COLUMN(NAME=~"articolo.codice~") COLUMN(NAME=~"articolo.descrizione~") COLUMN(NAME=~"riga_documento.qta_un_base~") COLUMN(NAME=~"valuta.simbolo~") COLUMN(NAME=~"valuta.cifra_arrotondamento~") COLUMN(NAME=~"valuta.tipo_arrotondamento~") COLUMN(NAME=~"riga_documento.cambio~") COLUMN(NAME=~"riga_documento.tot_riga_val_az~") COLUMN(NAME=~"caus_magazzino.segno_pezzi~") COLUMN(NAME=~"valuta.id_valuta~") COMPUTE(NAME=~"cast((select prezzo from prezzo, variazione, listino where variazione.id_listino=listino.id_listino and listino.tipo='V' and listino.lis_base='S' and prezzo.id_unita_confezione=~~~"riga_documento~~~".~~~"id_unita_confezione~~~" and prezzo.id_variazione=variazione.id_variazione and variazione.data_inizio<=~~~"documento~~~".~~~"data_documento~~~" and (variazione.data_fine>=~~~"documento~~~".~~~"data_documento~~~" or variazione.data_fine is null)) as decimal) as prezzo~") COMPUTE(NAME=~"cast((select prezzo from prezzo, variazione, listino where variazione.id_listino=listino.id_listino and listino.tipo='A' and listino.lis_base='S' and prezzo.id_unita_confezione=~~~"riga_documento~~~".~~~"id_unita_confezione~~~" and prezzo.id_variazione=variazione.id_variazione and variazione.data_inizio<=~~~"documento~~~".~~~"data_documento~~~" and (variazione.data_fine>=~~~"documento~~~".~~~"data_documento~~~" or variazione.data_fine is null)) as decimal) as costo~")    JOIN (LEFT=~"riga_documento.id_caus_magazzino~"    OP =~"=~"RIGHT=~"caus_magazzino.id_caus_magazzino~" )    JOIN (LEFT=~"riga_documento.id_articolo~"    OP =~"=~"RIGHT=~"articolo.id_articolo~" )    JOIN (LEFT=~"documento.id_documento~"    OP =~"=~"RIGHT=~"riga_documento.id_documento~" )    JOIN (LEFT=~"valuta.id_valuta~"    OP =~"=~"RIGHT=~"riga_documento.id_valuta~" )WHERE(    EXP1 =~"~~~"caus_magazzino~~~".~~~"segno_pezzi~~~"~"   OP =~">~"    EXP2 =~"''~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"documento~~~".~~~"data_documento~~~"~"   OP =~">=~"    EXP2 =~":da_data~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"documento~~~".~~~"data_documento~~~"~"   OP =~"<=~"    EXP2 =~":a_data~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"articolo~~~".~~~"codice~~~"~"   OP =~">=~"    EXP2 =~":da_sog~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"articolo~~~".~~~"codice~~~"~"   OP =~"<=~"    EXP2 =~":a_sog~" ) ) ARG(NAME = ~"ra_id_valuta_di_stampa~" TYPE = number)  ARG(NAME = ~"cambio~" TYPE = number)  ARG(NAME = ~"da_data~" TYPE = date)  ARG(NAME = ~"a_data~" TYPE = date)  ARG(NAME = ~"da_sog~" TYPE = string)  ARG(NAME = ~"a_sog~" TYPE = string)  ARG(NAME = ~"num_dec~" TYPE = number)  ARG(NAME = ~"tipo_arr~" TYPE = string) " arguments=(("ra_id_valuta_di_stampa", number),("cambio", number),("da_data", date),("a_data", date),("da_sog", string),("a_sog", string),("num_dec", number),("tipo_arr", string))  sort="articolo_codice A " )
group(level=1 header.height=0 trailer.height=80 by=("articolo_codice" ) header.color="536870912" trailer.color="536870912" )
text(band=header alignment="1" text="Quantità"border="0" color="0" x="2391" y="92" height="56" width="247"  name=riga_documento_qta_un_base_t  font.face="Arial" font.height="-8" font.weight="700"  font.family="2" font.pitch="2" font.charset="0" background.mode="1" background.color="536870912" )
