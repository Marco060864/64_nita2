compute(band=detail alignment="1" expression="qta*prezzo"border="0" color="0" x="2656" y="4" height="68" width="494" format="~tf_valu_mask( ra_id_valuta_di_stampa )"  name=imp_senza_zero visible="1~tif(sum_qta=0, 0,if( articolo_codice = articolo_codice [-1],0,1))"  font.face="Arial" font.height="-8" font.weight="400"  font.family="2" font.pitch="2" font.charset="0" background.mode="1" background.color="536870912" )
