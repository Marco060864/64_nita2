release 6;
datawindow(units=3 timer_interval=0 color=16777215 processing=0 print.documentname="" print.orientation = 0 print.margin.left = 635 print.margin.right = 635 print.margin.top = 635 print.margin.bottom = 635 print.paper.source = 0 print.paper.size = 0 print.prompt=no print.buttons=no print.preview.buttons=no )
summary(height=582 color="536870912" )
footer(height=370 color="536870912" )
detail(height=0 color="553648127"  height.autosize=yes)
table(column=(type=long updatewhereclause=yes identity=yes name=caus_magazzino_id_caus_magazzino dbname="caus_magazzino.id_caus_magazzino" )
 column=(type=decimal(4) updatewhereclause=yes name=riga_documento_peso_netto dbname="riga_documento.peso_netto" )
 column=(type=decimal(0) updatewhereclause=yes name=num_riga dbname="riga_documento.num_riga" )
 column=(type=decimal(4) updatewhereclause=yes name=riga_documento_calo dbname="riga_documento.calo" )
 column=(type=decimal(4) updatewhereclause=yes name=riga_documento_fino dbname="riga_documento.fino" )
 column=(type=char(2) updatewhereclause=yes name=orafo_metallo_codice dbname="orafo_metallo.codice" )
 column=(type=char(8) updatewhereclause=yes name=sog_commerciale_gen_codice dbname="sog_commerciale_gen.codice" )
 column=(type=char(40) updatewhereclause=yes name=sog_commerciale_gen_rag_soc_1 dbname="sog_commerciale_gen.rag_soc_1" )
 column=(type=char(1) updatewhereclause=yes name=caus_magazzino_saldi_cl_fino dbname="caus_magazzino.saldi_cl_fino" )
 column=(type=char(1) updatewhereclause=yes name=caus_magazzino_saldi_cl_lire dbname="caus_magazzino.saldi_cl_lire" )
 column=(type=decimal(4) updatewhereclause=yes name=riga_documento_importo_manifattura_val dbname="riga_documento.importo_manifattura_val" )
 column=(type=decimal(4) updatewhereclause=yes name=riga_documento_importo_manifattura dbname="riga_documento.importo_manifattura" )
 column=(type=decimal(6) updatewhereclause=yes name=riga_documento_tot_riga_val_az dbname="riga_documento.tot_riga_val_az" )
 column=(type=date updatewhereclause=yes name=documento_data_documento dbname="documento.data_documento" )
 column=(type=char(16) updatewhereclause=yes name=documento_num_documento dbname="documento.num_documento" )
 column=(type=char(8) updatewhereclause=yes name=caus_magazzino_codice dbname="caus_magazzino.codice" )
 column=(type=long updatewhereclause=yes identity=yes name=documento_id_documento dbname="documento.id_documento" )
 column=(type=long updatewhereclause=yes identity=yes name=id_titolo dbname="orafo_titolo.id_titolo" )
 column=(type=decimal(2) updatewhereclause=yes name=titolo dbname="orafo_titolo.titolo" )
 column=(type=decimal(2) updatewhereclause=yes name=coef_calo dbname="riga_documento.coef_calo" )
 column=(type=decimal(5) updatewhereclause=yes name=resto dbname="resto" )
 column=(type=datetime updatewhereclause=yes name=documento_data_ora_creazione dbname="documento.data_ora_creazione" )
 column=(type=char(1) updatewhereclause=yes name=orafo_metallo_cod_int_met dbname="orafo_metallo.cod_int_met" )
 column=(type=char(4) updatewhereclause=yes name=tipo_caus dbname="tipo_caus" )
 column=(type=long updatewhereclause=yes name=riga_documento_id_documento dbname="riga_documento.id_documento" )
 column=(type=long updatewhereclause=yes name=id_valuta dbname="id_valuta" )
 column=(type=char(32766) updatewhereclause=no name=riga_documento_descrizione dbname="riga_documento.descrizione" )
 retrieve="  SELECT ~"caus_magazzino~".~"id_caus_magazzino~",   
         ~"riga_documento~".~"peso_netto~",   
         ~"riga_documento~".~"num_riga~", 
         ~"riga_documento~".~"calo~",   
         ~"riga_documento~".~"fino~",   
         ~"orafo_metallo~".~"codice~",   
         ~"sog_commerciale_gen~".~"codice~",   
         ~"sog_commerciale_gen~".~"rag_soc_1~",   
         ~"caus_magazzino~".~"saldi_cl_fino~",   
         ~"caus_magazzino~".~"saldi_cl_lire~",   
         ~"riga_documento~".~"importo_manifattura_val~",   
         ~"riga_documento~".~"importo_manifattura~",   
         ~"riga_documento~".~"tot_riga_val_az~",   
         ~"documento~".~"data_documento~",   
         ~"documento~".~"num_documento~",   
         ~"caus_magazzino~".~"codice~",   
         ~"documento~".~"id_documento~",   
         ~"orafo_titolo~".~"id_titolo~",
			~"orafo_titolo~".~"titolo~", 
			~"riga_documento~".~"coef_calo~",  
         cast((select resto from orafo_scar_partita s where s.id_riga_documento=~"riga_documento~".~"id_riga_partita~"
and resto<>0) as numeric(6,5)) as resto,
			~"documento~".~"data_ora_creazione~",
	
			~"orafo_metallo~".~"cod_int_met~",
cast((select t.cod_tipo_partita from orafo_tipo_partita t, caus_magazzino c 
			where c.id_caus_magazzino=~"riga_documento~".~"id_caus_magazzino~" 
and t.id_tipo_partita=c.id_tipo_partita)as char(4)) as tipo_caus,
~"riga_documento~".~"id_documento~",
cast((  SELECT e.~"id_valuta~" FROM ~"esercizio~" e    WHERE :da_data>=data_inizio and :da_data<= data_fine ) as integer) as id_valuta,
~"riga_documento~".~"descrizione~" 
  
			   
 FROM ~"caus_magazzino~",   
         ~"documento~",   
         ~"riga_documento~",   
         ~"sog_commerciale_gen~",   
         ~"articolo~",   
         ~"orafo_metallo~",   
         ~"orafo_titolo~"  
   WHERE ( ~"riga_documento~".~"id_documento~" = ~"documento~".~"id_documento~" ) and  
         ( ~"riga_documento~".~"id_caus_magazzino~" = ~"caus_magazzino~".~"id_caus_magazzino~" ) and  
         ( ~"documento~".~"id_sog_commerciale~" = ~"sog_commerciale_gen~".~"id_sog_commerciale~" ) and  
         ( ~"articolo~".~"id_articolo~" = ~"riga_documento~".~"id_articolo~" ) and  
         ( ~"orafo_titolo~".~"id_metallo~" = ~"orafo_metallo~".~"id_metallo~" ) and  
         ( ~"orafo_titolo~".~"id_titolo~" = ~"articolo~".~"id_titolo~" ) and  
         ( ( ~"documento~".~"data_documento~" >= '1901-01-01' AND  
         ~"documento~".~"data_documento~" <= :a_data ) AND  
         ( ~"sog_commerciale_gen~".~"codice~" >= :da_sog AND  
         ~"sog_commerciale_gen~".~"codice~" <= :a_sog )) AND  
         (~"caus_magazzino~".~"saldi_cl_fino~" = '+' OR  
         ~"caus_magazzino~".~"saldi_cl_lire~" = '+' OR  
         ~"caus_magazzino~".~"saldi_cl_fino~" = '-' OR  
         ~"caus_magazzino~".~"saldi_cl_lire~" = '-')    
" arguments=(("da_data", date),("a_data", date),("da_sog", string),("a_sog", string))  sort="orafo_metallo_codice A sog_commerciale_gen_rag_soc_1 A sog_commerciale_gen_codice A right(tipo_caus, 3) A documento_data_documento A documento_data_ora_creazione A documento_num_documento A documento_id_documento A num_riga A id_titolo A " )
group(level=1 header.height=0 trailer.height=873 by=("orafo_metallo_codice" ) header.color="553648127" trailer.color="15793151" )
group(level=2 header.height=1640 trailer.height=1217 by=("orafo_metallo_codice" , "sog_commerciale_gen_codice" , "right(tipo_caus, 3)" ) header.color="1090519039" trailer.color="12639424" )
group(level=3 header.height=0 trailer.height=0 by=("documento_id_documento" ) header.color="536870912" trailer.color="15793151" )
