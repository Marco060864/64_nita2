 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"conto~" )  TABLE(NAME=~"documento~" )  TABLE(NAME=~"riga_documento~" )  TABLE(NAME=~"caus_magazzino~" ) COLUMN(NAME=~"conto.codice~") COLUMN(NAME=~"conto.descrizione~") COLUMN(NAME=~"riga_documento.descrizione~") COLUMN(NAME=~"riga_documento.quantita~") COLUMN(NAME=~"riga_documento.prezzo_netto~") COLUMN(NAME=~"riga_documento.peso_netto~") COLUMN(NAME=~"riga_documento.tot_riga_val_riga~") COLUMN(NAME=~"riga_documento.calo~") COLUMN(NAME=~"riga_documento.fino~") COLUMN(NAME=~"riga_documento.coef_calo~") COLUMN(NAME=~"riga_documento.prezzo_metallo~") COLUMN(NAME=~"riga_documento.prezzo_manifattura~") COLUMN(NAME=~"riga_documento.prezzo_complessivo~") COLUMN(NAME=~"riga_documento.importo_manifattura_val~") COLUMN(NAME=~"documento.num_documento~") COLUMN(NAME=~"documento.data_documento~") COLUMN(NAME=~"caus_magazzino.codice~") COLUMN(NAME=~"caus_magazzino.segno_lire~") COLUMN(NAME=~"caus_magazzino.segno_legato~") COLUMN(NAME=~"caus_magazzino.segno_pezzi~") COLUMN(NAME=~"documento.id_documento~") COLUMN(NAME=~"caus_magazzino.saldi_cl_lire~") COLUMN(NAME=~"caus_magazzino.saldi_cl_fino~")    JOIN (LEFT=~"riga_documento.id_conto~"    OP =~"=~"RIGHT=~"conto.id_conto~" )    JOIN (LEFT=~"riga_documento.id_documento~"    OP =~"=~"RIGHT=~"documento.id_documento~" )    JOIN (LEFT=~"caus_magazzino.id_caus_magazzino~"    OP =~"=~"RIGHT=~"riga_documento.id_caus_magazzino~" )WHERE(    EXP1 =~"(~~~"caus_magazzino~~~".~~~"segno_lire~~~"~"   OP =~"=~"    EXP2 =~"'C'~"    LOGIC =~"or~" ) WHERE(    EXP1 =~"~~~"caus_magazzino~~~".~~~"segno_lire~~~"~"   OP =~"=~"    EXP2 =~"'S')~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"conto~~~".~~~"codice~~~"~"   OP =~">=~"    EXP2 =~":DA_CONTO~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"conto~~~".~~~"codice~~~"~"   OP =~"<=~"    EXP2 =~":A_CONTO~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"documento~~~".~~~"data_documento~~~"~"   OP =~">=~"    EXP2 =~":DA_DATA~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"documento~~~".~~~"data_documento~~~"~"   OP =~"<=~"    EXP2 =~":A_DATA~" ) ) ARG(NAME = ~"DA_CONTO~" TYPE = string)  ARG(NAME = ~"A_CONTO~" TYPE = string)  ARG(NAME = ~"DA_DATA~" TYPE = date)  ARG(NAME = ~"A_DATA~" TYPE = date) " arguments=(("DA_CONTO", string),("A_CONTO", string),("DA_DATA", date),("A_DATA", date))  sort="conto_descrizione A conto_codice A documento_data_documento A documento_num_documento A " )
