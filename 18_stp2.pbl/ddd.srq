PBSELECT( VERSION(400) TABLE(NAME="riga_documento" ALIAS="riga_documento_a" )  TABLE(NAME="documento" ALIAS="documento_a" )  TABLE(NAME="riga_documento" ALIAS="riga_documento_b" )  TABLE(NAME="documento" ALIAS="documento_b" ) COLUMN(NAME="riga_documento_a.id_riga_documento") COLUMN(NAME="riga_documento_a.num_riga") COLUMN(NAME="riga_documento_a.id_articolo") COLUMN(NAME="riga_documento_a.descrizione") COLUMN(NAME="riga_documento_a.quantita") COLUMN(NAME="riga_documento_a.peso_netto") COLUMN(NAME="riga_documento_a.prezzo") COLUMN(NAME="riga_documento_a.prezzo_manifattura") COLUMN(NAME="riga_documento_a.prezzo_complessivo") COLUMN(NAME="documento_a.id_documento") COLUMN(NAME="documento_a.num_documento") COLUMN(NAME="documento_a.data_documento") COLUMN(NAME="riga_documento_b.id_riga_documento") COLUMN(NAME="riga_documento_b.num_riga") COLUMN(NAME="riga_documento_b.quantita") COLUMN(NAME="riga_documento_b.peso_netto") COLUMN(NAME="riga_documento_b.prezzo") COLUMN(NAME="riga_documento_b.prezzo_manifattura") COLUMN(NAME="riga_documento_b.prezzo_complessivo") COLUMN(NAME="documento_b.num_documento") COLUMN(NAME="documento_b.data_documento")    JOIN (LEFT="documento_a.id_documento"    OP ="="RIGHT="riga_documento_a.id_documento" )    JOIN (LEFT="riga_documento_a.id_riga_documento"    OP ="="RIGHT="riga_documento_b.id_riga_doc_provenienza" )    JOIN (LEFT="riga_documento_b.id_documento"    OP ="="RIGHT="documento_b.id_documento" )WHERE(    EXP1 ="(~"documento_a~".~"id_prof_documento~""   OP ="="    EXP2 ="158"    LOGIC ="or" ) WHERE(    EXP1 ="~"documento_a~".~"id_prof_documento~""   OP ="="    EXP2 ="54)" ) ) 