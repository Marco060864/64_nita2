table(column=(type=long updatewhereclause=yes identity=yes name=articolo_id_articolo dbname="articolo.id_articolo" )
 column=(type=char(32) updatewhereclause=yes name=articolo_codice dbname="articolo.codice" )
 column=(type=char(80) updatewhereclause=yes name=articolo_descrizione dbname="articolo.descrizione" )
 column=(type=char(255) updatewhereclause=yes name=articolo_immagine dbname="articolo.immagine" )
 column=(type=char(32766) update=yes updatewhereclause=no name=articolo_nota dbname="articolo.nota" )
 column=(type=char(1) updatewhereclause=yes name=um_tipo dbname="unita_misura.tipo" )
 column=(type=long updatewhereclause=yes identity=yes name=id_unita_confezione dbname="unita_confezione.id_unita_confezione" )
 column=(type=decimal(6) updatewhereclause=yes name=prezzo dbname="prezzo.prezzo" )
 column=(type=decimal(4) updatewhereclause=yes name=c_sa dbname="c_costo_saldatura" )
 column=(type=decimal(4) updatewhereclause=yes name=c_sp dbname="c_costo_spazzolatura" )
 column=(type=decimal(4) updatewhereclause=yes name=c_gv dbname="c_costo_galvanica" )
 column=(type=decimal(6) updatewhereclause=yes name=prezzo_manifattura dbname="prezzo.prezzo_manifattura" )
 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"articolo~" )  TABLE(NAME=~"unita_confezione~" )  TABLE(NAME=~"unita_misura~" )  TABLE(NAME=~"prezzo~" )  TABLE(NAME=~"listino~" )  TABLE(NAME=~"variazione~" ) COLUMN(NAME=~"articolo.id_articolo~") COLUMN(NAME=~"articolo.codice~") COLUMN(NAME=~"articolo.descrizione~") COLUMN(NAME=~"articolo.immagine~") COLUMN(NAME=~"articolo.nota~") COLUMN(NAME=~"unita_misura.tipo~") COLUMN(NAME=~"unita_confezione.id_unita_confezione~") COLUMN(NAME=~"prezzo.prezzo~") COMPUTE(NAME=~"cast(0 as numeric(18,4)) as c_costo_saldatura~") COMPUTE(NAME=~"cast(0 as numeric(18,4) )as c_costo_spazzolatura~") COMPUTE(NAME=~"cast(0 as numeric(18,4) )as c_costo_galvanica~") COLUMN(NAME=~"prezzo.prezzo_manifattura~")    JOIN (LEFT=~"prezzo.id_unita_confezione~"    OP =~"=~"RIGHT=~"unita_confezione.id_unita_confezione~"    OUTER2 =~"unita_confezione.id_unita_confezione~" )    JOIN (LEFT=~"variazione.id_listino~"    OP =~"=~"RIGHT=~"listino.id_listino~"    OUTER1 =~"variazione.id_listino~" )    JOIN (LEFT=~"variazione.id_variazione~"    OP =~"=~"RIGHT=~"prezzo.id_variazione~"    OUTER2 =~"prezzo.id_variazione~" )    JOIN (LEFT=~"unita_confezione.id_articolo~"    OP =~"=~"RIGHT=~"articolo.id_articolo~" )    JOIN (LEFT=~"unita_misura.id_unita_misura~"    OP =~"=~"RIGHT=~"unita_confezione.id_unita_mis_peso~" )WHERE(    EXP1 =~"~~~"listino~~~".~~~"lis_base~~~"~"   OP =~"=~"    EXP2 =~"'S'~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"variazione~~~".~~~"data_inizio~~~"~"   OP =~"<=~"    EXP2 =~"today()~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"variazione~~~".~~~"data_fine~~~"~"   OP =~">=~"    EXP2 =~"today()~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"articolo~~~".~~~"codice~~~"~"   OP =~"like~"    EXP2 =~":as_codice~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"listino~~~".~~~"tipo~~~"~"   OP =~"=~"    EXP2 =~"'V'~" ) ) ARG(NAME = ~"as_codice~" TYPE = string) " arguments=(("as_codice", string))  sort="articolo_codice A " )
