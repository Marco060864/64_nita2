 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"articolo~" )  TABLE(NAME=~"documento~" )  TABLE(NAME=~"riga_documento~" )  TABLE(NAME=~"prof_documento~" ) COLUMN(NAME=~"documento.id_documento~") COLUMN(NAME=~"documento.id_prof_documento~") COLUMN(NAME=~"documento.num_progressivo~") COLUMN(NAME=~"documento.num_documento~") COLUMN(NAME=~"documento.data_documento~") COLUMN(NAME=~"riga_documento.id_riga_documento~") COLUMN(NAME=~"riga_documento.descrizione~") COLUMN(NAME=~"riga_documento.quantita~") COLUMN(NAME=~"riga_documento.prezzo~") COLUMN(NAME=~"riga_documento.peso_netto~") COLUMN(NAME=~"riga_documento.prezzo_manifattura~") COLUMN(NAME=~"riga_documento.prezzo_metallo~") COLUMN(NAME=~"riga_documento.prezzo_complessivo~") COLUMN(NAME=~"articolo.codice~") COLUMN(NAME=~"riga_documento.id_articolo~") COLUMN(NAME=~"riga_documento.tot_riga_val_az~") COLUMN(NAME=~"prof_documento.codice~")    JOIN (LEFT=~"riga_documento.id_documento~"    OP =~"=~"RIGHT=~"documento.id_documento~" )    JOIN (LEFT=~"riga_documento.id_articolo~"    OP =~"=~"RIGHT=~"articolo.id_articolo~" )    JOIN (LEFT=~"documento.id_prof_documento~"    OP =~"=~"RIGHT=~"prof_documento.id_prof_documento~" )WHERE(    EXP1 =~"~~~"riga_documento~~~".~~~"id_articolo~~~"~"   OP =~"=~"    EXP2 =~":id_art~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"(~~~"documento~~~".~~~"id_prof_documento~~~"~"   OP =~"=~"    EXP2 =~"229~"    LOGIC =~"or~" ) WHERE(    EXP1 =~"~~~"documento~~~".~~~"id_prof_documento~~~"~"   OP =~"=~"    EXP2 =~"187~"    LOGIC =~"or~" ) WHERE(    EXP1 =~"~~~"documento~~~".~~~"id_prof_documento~~~"~"   OP =~"=~"    EXP2 =~"50~"    LOGIC =~"or~" ) WHERE(    EXP1 =~"~~~"documento~~~".~~~"id_prof_documento~~~"~"   OP =~"=~"    EXP2 =~"66~"    LOGIC =~"or~" ) WHERE(    EXP1 =~"~~~"documento~~~".~~~"id_prof_documento~~~"~"   OP =~"=~"    EXP2 =~"171)~" ) ) ARG(NAME = ~"id_art~" TYPE = number) " arguments=(("id_art", number))  sort="documento_data_documento A documento_num_documento A " )
