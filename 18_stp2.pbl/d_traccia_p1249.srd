 column=(type=char(16) updatewhereclause=yes name=c_num_bollettina dbname="c_num_bollettina" )
 column=(type=datetime updatewhereclause=yes name=data_ora_creazione dbname="documento.data_ora_creazione" dbalias=".data_ora_creazione" )
 column=(type=decimal(6) updatewhereclause=yes name=imp_avanzo_acconto dbname="documento.imp_avanzo_acconto" dbalias=".imp_avanzo_acconto" )
 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"documento~" )  TABLE(NAME=~"prof_documento~" )  TABLE(NAME=~"riga_documento~" ) COLUMN(NAME=~"prof_documento.codice~") COLUMN(NAME=~"documento.id_documento~") COLUMN(NAME=~"prof_documento.id_prof_documento~") COLUMN(NAME=~"riga_documento.id_riga_documento~") COLUMN(NAME=~"documento.num_progressivo~") COLUMN(NAME=~"documento.data_registrazione~") COLUMN(NAME=~"documento.num_documento~") COLUMN(NAME=~"documento.data_documento~") COLUMN(NAME=~"riga_documento.id_articolo~") COLUMN(NAME=~"riga_documento.descrizione~") COLUMN(NAME=~"riga_documento.quantita~") COLUMN(NAME=~"riga_documento.peso_netto~") COLUMN(NAME=~"riga_documento.provv_imp_subage_2~") COMPUTE(NAME=~"(select num_documento from documento d1, riga_documento r1 where d1.id_documento=r1.id_documento and r1.id_riga_documento=riga_documento.provv_imp_subage_2) as c_num_bollettina~") COLUMN(NAME=~"documento.data_ora_creazione~") COLUMN(NAME=~"documento.imp_avanzo_acconto~")    JOIN (LEFT=~"prof_documento.id_prof_documento~"    OP =~"=~"RIGHT=~"documento.id_prof_documento~" )    JOIN (LEFT=~"riga_documento.id_documento~"    OP =~"=~"RIGHT=~"documento.id_documento~" )WHERE(    EXP1 =~"~~~"documento~~~".~~~"id_prof_documento~~~"~"   OP =~"=~"    EXP2 =~"249~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"c_num_bollettina~"   OP =~"like~"    EXP2 =~":num_bol~" ) ) ARG(NAME = ~"num_bol~" TYPE = string) " arguments=(("num_bol", string))  sort="data_ora_creazione D prof_documento_id_prof_documento A prof_documento_codice A documento_data_documento A documento_num_documento A " )
