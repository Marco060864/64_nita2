 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"documento~" ALIAS=~"documento_a~" )  TABLE(NAME=~"orafo_scar_partita~" )  TABLE(NAME=~"riga_documento~" )  TABLE(NAME=~"sog_commerciale_gen~" )  TABLE(NAME=~"orafo_titolo~" )  TABLE(NAME=~"articolo~" )  TABLE(NAME=~"caus_magazzino~" )  TABLE(NAME=~"orafo_tipo_partita~" )  TABLE(NAME=~"orafo_aper_partita~" )  TABLE(NAME=~"documento~" ALIAS=~"documento_b~" ) COLUMN(NAME=~"documento_a.num_progressivo~") COLUMN(NAME=~"documento_a.data_registrazione~") COLUMN(NAME=~"documento_a.num_documento~") COLUMN(NAME=~"documento_a.data_documento~") COLUMN(NAME=~"documento_a.id_sog_commerciale~") COLUMN(NAME=~"riga_documento.valoriz_peso_non_prezioso~") COLUMN(NAME=~"sog_commerciale_gen.codice~") COLUMN(NAME=~"sog_commerciale_gen.rag_soc_1~") COLUMN(NAME=~"riga_documento.num_riga~") COLUMN(NAME=~"riga_documento.id_articolo~") COLUMN(NAME=~"riga_documento.descrizione~") COLUMN(NAME=~"riga_documento.quantita~") COLUMN(NAME=~"riga_documento.peso_netto~") COLUMN(NAME=~"riga_documento.coef_calo~") COLUMN(NAME=~"riga_documento.calo~") COLUMN(NAME=~"riga_documento.fino~") COLUMN(NAME=~"orafo_titolo.id_metallo~") COLUMN(NAME=~"orafo_scar_partita.id_partita~") COLUMN(NAME=~"orafo_scar_partita.val_scarico~") COLUMN(NAME=~"orafo_scar_partita.num_fat~") COLUMN(NAME=~"orafo_tipo_partita.cod_tipo_partita~") COLUMN(NAME=~"riga_documento.id_riga_documento~") COLUMN(NAME=~"documento_b.num_progressivo~") COLUMN(NAME=~"documento_b.num_documento~") COLUMN(NAME=~"documento_b.data_documento~") COLUMN(NAME=~"documento_b.data_registrazione~")    JOIN (LEFT=~"riga_documento.id_documento~"    OP =~"=~"RIGHT=~"documento_a.id_documento~" )    JOIN (LEFT=~"riga_documento.id_riga_partita~"    OP =~"=~"RIGHT=~"orafo_scar_partita.id_riga_documento~" )    JOIN (LEFT=~"documento_a.id_sog_commerciale~"    OP =~"=~"RIGHT=~"sog_commerciale_gen.id_sog_commerciale~" )    JOIN (LEFT=~"articolo.id_titolo~"    OP =~"=~"RIGHT=~"orafo_titolo.id_titolo~" )    JOIN (LEFT=~"articolo.id_articolo~"    OP =~"=~"RIGHT=~"riga_documento.id_articolo~" )    JOIN (LEFT=~"caus_magazzino.id_caus_magazzino~"    OP =~"=~"RIGHT=~"riga_documento.id_caus_magazzino~" )    JOIN (LEFT=~"orafo_tipo_partita.id_tipo_partita~"    OP =~"=~"RIGHT=~"caus_magazzino.id_tipo_partita~" )    JOIN (LEFT=~"orafo_aper_partita.id_partita~"    OP =~"=~"RIGHT=~"orafo_scar_partita.id_partita~" )    JOIN (LEFT=~"orafo_aper_partita.id_documento~"    OP =~"=~"RIGHT=~"documento_b.id_documento~" )WHERE(    EXP1 =~"~~~"documento_a~~~".~~~"data_documento~~~"~"   OP =~">=~"    EXP2 =~":da_data~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"documento_a~~~".~~~"data_documento~~~"~"   OP =~"<=~"    EXP2 =~":a_data~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"orafo_titolo~~~".~~~"id_metallo~~~"~"   OP =~"=~"    EXP2 =~":metallo~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"documento_a~~~".~~~"id_sog_commerciale~~~"~"   OP =~"=~"    EXP2 =~":soggetto~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"orafo_tipo_partita~~~".~~~"cod_tipo_partita~~~"~"   OP =~"=~"    EXP2 =~":tipo_partita~" ) ) ARG(NAME = ~"da_data~" TYPE = date)  ARG(NAME = ~"a_data~" TYPE = date)  ARG(NAME = ~"metallo~" TYPE = number)  ARG(NAME = ~"soggetto~" TYPE = number)  ARG(NAME = ~"tipo_partita~" TYPE = string) " filter=" round(c_scar_partita,2)<> round(c_riga_partita , 2) "arguments=(("da_data", date),("a_data", date),("metallo", number),("soggetto", number),("tipo_partita", string))  sort="id_riga_documento A orafo_scar_partita_id_partita A riga_documento_num_riga A documento_data_documento A documento_num_progressivo A " )
