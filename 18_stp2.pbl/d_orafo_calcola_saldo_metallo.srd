 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"documento~" )  TABLE(NAME=~"orafo_aper_partita~" )  TABLE(NAME=~"riga_documento~" ALIAS=~"riga_documento_a~" )  TABLE(NAME=~"riga_documento~" ALIAS=~"riga_documento_b~" )  TABLE(NAME=~"orafo_scar_partita~" )  TABLE(NAME=~"orafo_metallo~" )  TABLE(NAME=~"orafo_titolo~" ) COLUMN(NAME=~"documento.num_documento~") COLUMN(NAME=~"documento.data_documento~") COLUMN(NAME=~"documento.num_progressivo~") COLUMN(NAME=~"documento.data_registrazione~") COLUMN(NAME=~"orafo_aper_partita.val_apertura~") COLUMN(NAME=~"orafo_scar_partita.val_scarico~") COLUMN(NAME=~"orafo_metallo.codice~") COLUMN(NAME=~"orafo_metallo.id_metallo~") COLUMN(NAME=~"orafo_aper_partita.id_partita~") COLUMN(NAME=~"orafo_metallo.cod_int_met~")    JOIN (LEFT=~"riga_documento_a.id_documento~"    OP =~"=~"RIGHT=~"documento.id_documento~" )    JOIN (LEFT=~"riga_documento_a.id_riga_doc_provenienza~"    OP =~"=~"RIGHT=~"riga_documento_b.id_riga_documento~" )    JOIN (LEFT=~"orafo_scar_partita.id_partita~"    OP =~"=~"RIGHT=~"orafo_aper_partita.id_partita~" )    JOIN (LEFT=~"orafo_scar_partita.id_riga_documento~"    OP =~"=~"RIGHT=~"riga_documento_b.id_riga_partita~" )    JOIN (LEFT=~"orafo_titolo.id_metallo~"    OP =~"=~"RIGHT=~"orafo_metallo.id_metallo~" )    JOIN (LEFT=~"orafo_titolo.id_titolo~"    OP =~"=~"RIGHT=~"orafo_aper_partita.id_titolo~" )WHERE(    EXP1 =~"~~~"documento~~~".~~~"num_documento~~~"~"   OP =~"<=~"    EXP2 =~":rn_numero_doc~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"documento~~~".~~~"id_sog_commerciale~~~"~"   OP =~"=~"    EXP2 =~":rn_id_sog_com~" ) ) ARG(NAME = ~"rn_numero_doc~" TYPE = number)  ARG(NAME = ~"rn_id_sog_com~" TYPE = number) " arguments=(("rn_numero_doc", number),("rn_id_sog_com", number))  sort="orafo_metallo_id_metallo A orafo_aper_partita_id_partita A " )
