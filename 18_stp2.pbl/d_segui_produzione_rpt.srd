 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"articolo~" )  TABLE(NAME=~"caus_magazzino~" )  TABLE(NAME=~"documento~" )  TABLE(NAME=~"riga_documento~" ) COLUMN(NAME=~"documento.num_documento~") COLUMN(NAME=~"documento.data_documento~") COLUMN(NAME=~"articolo.codice~") COLUMN(NAME=~"riga_documento.num_riga~") COLUMN(NAME=~"riga_documento.quantita~") COLUMN(NAME=~"riga_documento.peso_netto~") COLUMN(NAME=~"riga_documento.calo~") COLUMN(NAME=~"riga_documento.fino~") COLUMN(NAME=~"caus_magazzino.segno~") COLUMN(NAME=~"riga_documento.dim_l~") COLUMN(NAME=~"caus_magazzino.step_produzione~") COLUMN(NAME=~"caus_magazzino.codice~") COLUMN(NAME=~"documento.data_ora_creazione~") COLUMN(NAME=~"riga_documento.sigla_prezzo~") COLUMN(NAME=~"riga_documento.id_riga_sorgente~") COLUMN(NAME=~"documento.id_documento~")    JOIN (LEFT=~"riga_documento.id_documento~"    OP =~"=~"RIGHT=~"documento.id_documento~" )    JOIN (LEFT=~"riga_documento.id_caus_magazzino~"    OP =~"=~"RIGHT=~"caus_magazzino.id_caus_magazzino~" )    JOIN (LEFT=~"riga_documento.id_articolo~"    OP =~"=~"RIGHT=~"articolo.id_articolo~" )WHERE(    EXP1 =~"~~~"documento~~~".~~~"data_documento~~~"~"   OP =~">=~"    EXP2 =~":da_data~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"documento~~~".~~~"data_documento~~~"~"   OP =~"<=~"    EXP2 =~":a_data~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"caus_magazzino~~~".~~~"step_produzione~~~"~"   OP =~">~"    EXP2 =~"''~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"documento~~~".~~~"chius_forzata~~~"~"   OP =~"<>~"    EXP2 =~"'S'~" ) ) ARG(NAME = ~"da_data~" TYPE = date)  ARG(NAME = ~"a_data~" TYPE = date) " arguments=(("da_data", date),("a_data", date))  sort="id_riga_sorgente A articolo_codice A riga_documento_dim_l A sigla_prezzo A documento_data_documento A documento_data_ora_creazione A caus_magazzino_segno A " )
