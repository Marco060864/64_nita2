PBSELECT( VERSION(400) TABLE(NAME="articolo" )  TABLE(NAME="documento" )  TABLE(NAME="riga_documento" )  TABLE(NAME="registro" )  TABLE(NAME="sog_commerciale" )  TABLE(NAME="prof_documento" )  TABLE(NAME="prezzo" ) COLUMN(NAME="documento.id_documento") COLUMN(NAME="documento.num_progressivo") COLUMN(NAME="documento.data_registrazione") COLUMN(NAME="documento.num_documento") COLUMN(NAME="documento.data_documento") COLUMN(NAME="riga_documento.id_riga_documento") COLUMN(NAME="riga_documento.num_riga") COLUMN(NAME="riga_documento.quantita") COLUMN(NAME="riga_documento.prezzo") COLUMN(NAME="riga_documento.peso_netto") COLUMN(NAME="riga_documento.prezzo_manifattura") COLUMN(NAME="articolo.codice") COLUMN(NAME="articolo.id_articolo") COLUMN(NAME="riga_documento.descrizione") COLUMN(NAME="registro.tipo_registro") COLUMN(NAME="sog_commerciale.tipo") COLUMN(NAME="prof_documento.codice") COMPUTE(NAME="(case ~"riga_documento~".~"num_colli~" when 101 then 2 else 0 end case) as c_nd") COMPUTE(NAME="(case ~"riga_documento~".~"num_colli~" when 100 then 2 else 0 end case) as c_nc") COLUMN(NAME="riga_documento.num_colli") COLUMN(NAME="prezzo.prezzo") COLUMN(NAME="riga_documento.id_riga_doc_provenienza") COMPUTE(NAME="0 as c_vedi") COLUMN(NAME="riga_documento.prezzo_complessivo")    JOIN (LEFT="riga_documento.id_unita_confezione"    OP ="="RIGHT="prezzo.id_unita_confezione"    OUTER1 ="riga_documento.id_unita_confezione" )    JOIN (LEFT="riga_documento.id_documento"    OP ="="RIGHT="documento.id_documento" )    JOIN (LEFT="riga_documento.id_articolo"    OP ="="RIGHT="articolo.id_articolo" )    JOIN (LEFT="documento.id_registro"    OP ="="RIGHT="registro.id_registro" )    JOIN (LEFT="documento.id_sog_commerciale"    OP ="="RIGHT="sog_commerciale.id_sog_commerciale" )    JOIN (LEFT="documento.id_prof_documento"    OP ="="RIGHT="prof_documento.id_prof_documento" )WHERE(    EXP1 ="( ( ~"articolo~".~"id_articolo~""   OP ="="    EXP2 =":id_art ) )"    LOGIC ="and" ) WHERE(    EXP1 ="~"prezzo~".~"id_variazione~""   OP ="="    EXP2 ="15" ) ) ARG(NAME = "id_art" TYPE = number) 