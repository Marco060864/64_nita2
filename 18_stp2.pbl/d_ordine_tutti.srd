release 6;
datawindow(units=3 timer_interval=0 color=16777215 processing=0 print.documentname="" print.orientation = 0 print.margin.left = 635 print.margin.right = 635 print.margin.top = 635 print.margin.bottom = 635 print.paper.source = 0 print.paper.size = 0 print.prompt=no print.buttons=no print.preview.buttons=no )
header(height=6006 color="536870912" )
summary(height=5715 color="536870912" )
footer(height=0 color="553648127" )
detail(height=502 color="553648127"  height.autosize=yes)
table(column=(type=char(32) updatewhereclause=yes name=codice dbname="codice" )
 column=(type=char(32766) updatewhereclause=no name=descrizione dbname="descrizione" )
 column=(type=decimal(4) updatewhereclause=yes name=quantita dbname="quantita" )
 column=(type=decimal(4) updatewhereclause=yes name=peso_netto dbname="peso_netto" )
 column=(type=decimal(4) updatewhereclause=yes name=lunghezza_riga dbname="lunghezza_riga" )
 column=(type=decimal(2) updatewhereclause=yes name=coef_calo dbname="coef_calo" )
 column=(type=decimal(4) updatewhereclause=yes name=fino dbname="fino" )
 column=(type=decimal(6) updatewhereclause=yes name=prezzo_manifattura dbname="prezzo_manifattura" )
 column=(type=decimal(4) updatewhereclause=yes name=calo dbname="calo" )
 column=(type=decimal(4) updatewhereclause=yes name=dim_l dbname="dim_l" )
 column=(type=decimal(4) updatewhereclause=yes name=uc_peso_netto dbname="peso_netto" )
 column=(type=long updatewhereclause=yes identity=yes name=id_documento dbname="id_documento" )
 column=(type=char(16) updatewhereclause=yes name=num_documento dbname="num_documento" )
 column=(type=date updatewhereclause=yes name=data_documento dbname="data_documento" )
 column=(type=date updatewhereclause=yes name=data_prev_consegna dbname="data_prev_consegna" )
 column=(type=char(32766) updatewhereclause=no name=note_intestazione dbname="note_intestazione" )
 column=(type=char(20) updatewhereclause=yes name=bollo dbname="bollo" )
 column=(type=char(40) updatewhereclause=yes name=rag_soc_1 dbname="rag_soc_1" )
 column=(type=char(40) updatewhereclause=yes name=indirizzo dbname="indirizzo" )
 column=(type=char(40) updatewhereclause=yes name=localita dbname="localita" )
 column=(type=char(10) updatewhereclause=yes name=cap dbname="cap" )
 column=(type=char(5) updatewhereclause=yes name=provincia dbname="provincia" )
 column=(type=char(5) updatewhereclause=yes name=nazione dbname="nazione" )
 column=(type=char(40) updatewhereclause=yes name=az_rag_1 dbname="az_rag_1" )
 column=(type=char(40) updatewhereclause=yes name=rag_soc_2 dbname="rag_soc_2" )
 column=(type=char(20) updatewhereclause=yes name=bollo dbname="bollo" )
 column=(type=long updatewhereclause=yes name=id_valuta dbname="id_valuta" )
 column=(type=decimal(6) updatewhereclause=yes name=prezzo_complessivo dbname="prezzo_complessivo" )
 column=(type=long updatewhereclause=yes name=id_riga_ord_cliente dbname="id_riga_ord_cliente" )
 column=(type=long updatewhereclause=yes identity=yes name=id_articolo dbname="id_articolo" )
 column=(type=char(5) updatewhereclause=yes name=simbolo dbname="simbolo" )
 column=(type=char(32766) updatewhereclause=no name=nota_ord_cliente dbname="nota_ord_cliente" )
 column=(type=char(1) updatewhereclause=yes name=cfg_pezzi dbname="cfg_pezzi" )
 column=(type=char(1) updatewhereclause=yes name=cfg_mis dbname="cfg_mis" )
 column=(type=char(1) updatewhereclause=yes name=cfg_p_uni dbname="cfg_p_uni" )
 column=(type=char(1) updatewhereclause=yes name=cfg_p_tot dbname="cfg_p_tot" )
 column=(type=char(1) updatewhereclause=yes name=cfg_prezzo dbname="cfg_prezzo" )
 column=(type=char(2) updatewhereclause=yes name=sigla_prezzo dbname="sigla_prezzo" )
 retrieve="SELECT
    articolo.~"codice~", 
    riga_documento.~"descrizione~", riga_documento.~"quantita~", riga_documento.~"peso_netto~",
 riga_documento.~"dim_l~" as lunghezza_riga, riga_documento.~"coef_calo~", riga_documento.~"fino~", riga_documento.~"prezzo_manifattura~",
riga_documento.~"calo~", unita_confezione.dim_l, unita_confezione.peso_netto,
    documento.~"id_documento~", documento.~"num_documento~", documento.~"data_documento~", documento.~"data_prev_consegna~", documento.~"note_intestazione~", documento.~"bollo~",
    sog_commerciale_gen.~"rag_soc_1~", sede.indirizzo, sede.localita, sede.cap, sede.provincia, 
	sede.nazione, azienda.rag_soc_1 as az_rag_1, azienda.rag_soc_2, documento.~"bollo~",
documento.~"id_valuta~", riga_documento.prezzo_complessivo, ord_cli_fornitore.id_riga_ord_cliente, 
articolo.id_articolo, unita_misura.simbolo, oc_documento.note_intestazione as nota_ord_cliente,

art_cfg_stampa.pezzi as cfg_pezzi, art_cfg_stampa.misura as cfg_mis, 
art_cfg_stampa.peso_unitario as cfg_p_uni, 
art_cfg_stampa.peso_totale as cfg_p_tot, art_cfg_stampa.prezzo as cfg_prezzo,
riga_documento.~"sigla_prezzo~"
FROM
    ~"DBA~".~"riga_documento~" riga_documento LEFT OUTER JOIN ~"DBA~".~"articolo~" articolo ON
         riga_documento.~"id_articolo~"=articolo.~"id_articolo~",
 ~"DBA~".~"riga_documento~" riga_documento LEFT OUTER JOIN ~"DBA~".~"unita_confezione~" unita_confezione ON
         riga_documento.~"id_unita_confezione~"=unita_confezione.~"id_unita_confezione~",

~"DBA~".~"unita_confezione~" unita_confezione LEFT OUTER JOIN ~"DBA~".~"unita_misura~" unita_misura ON
         unita_confezione.~"id_unita_misura~"=unita_misura.~"id_unita_misura~",

 ~"DBA~".~"riga_documento~" riga_documento LEFT OUTER JOIN ~"DBA~".~"ord_cli_fornitore~" ord_cli_fornitore ON
         riga_documento.~"id_riga_documento~"=ord_cli_fornitore.~"id_riga_ord_fornitore~",

~"DBA~".~"ord_cli_fornitore~" ord_cli_fornitore LEFT OUTER JOIN ~"DBA~".~"riga_documento~" oc_riga_documento ON
         ord_cli_fornitore.~"id_riga_ord_cliente~"=oc_riga_documento.~"id_riga_documento~",
~"DBA~".~"riga_documento~" oc_riga_documento LEFT OUTER JOIN ~"DBA~".~"documento~" oc_documento ON
         oc_riga_documento.~"id_documento~"=oc_documento.~"id_documento~",
~"DBA~".~"articolo~" articolo LEFT OUTER JOIN ~"DBA~".~"art_cfg_stampa~" art_cfg_stampa ON
         upper(left(articolo.~"codice~",2))=upper(art_cfg_stampa.~"prime_2_lettere~"),

    ~"DBA~".~"documento~" documento,
    ~"DBA~".~"sog_commerciale_gen~" sog_commerciale_gen ,
azienda, sede
WHERE
    riga_documento.~"id_documento~" = documento.~"id_documento~" AND
    documento.~"id_sog_commerciale~" = sog_commerciale_gen.~"id_sog_commerciale~" and
documento.id_azienda=azienda.id_azienda and sede.id_azienda=azienda.id_azienda

and documento.id_documento=:rn_id_doc" arguments=(("rn_id_doc", number)) )
