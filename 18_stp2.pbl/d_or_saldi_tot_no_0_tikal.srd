table(column=(type=long updatewhereclause=yes identity=yes name=caus_magazzino_id_caus_magazzino dbname="caus_magazzino.id_caus_magazzino" )
 column=(type=decimal(4) updatewhereclause=yes name=riga_documento_peso_netto dbname="riga_documento.peso_netto" )
 column=(type=decimal(4) updatewhereclause=yes name=riga_documento_calo dbname="riga_documento.calo" )
 column=(type=decimal(4) updatewhereclause=yes name=riga_documento_fino dbname="riga_documento.fino" )
 column=(type=char(2) updatewhereclause=yes name=orafo_metallo_codice dbname="orafo_metallo.codice" )
 column=(type=char(8) updatewhereclause=yes name=sog_commerciale_gen_codice dbname="sog_commerciale_gen.codice" )
 column=(type=char(40) updatewhereclause=yes name=sog_commerciale_gen_rag_soc_1 dbname="sog_commerciale_gen.rag_soc_1" )
 column=(type=char(1) updatewhereclause=yes name=caus_magazzino_saldi_cl_fino dbname="caus_magazzino.saldi_cl_fino" )
 column=(type=char(1) updatewhereclause=yes name=caus_magazzino_saldi_cl_lire dbname="caus_magazzino.saldi_cl_lire" )
 column=(type=decimal(4) updatewhereclause=yes name=riga_documento_importo_manifattura_val dbname="riga_documento.importo_manifattura_val" )
 column=(type=decimal(4) updatewhereclause=yes name=riga_documento_importo_manifattura dbname="riga_documento.importo_manifattura" )
 column=(type=decimal(6) updatewhereclause=yes name=riga_documento_tot_riga_val_az dbname="riga_documento.tot_riga_val_az" )
 column=(type=long updatewhereclause=yes identity=yes name=id_documento dbname="documento.id_documento" )
 column=(type=long updatewhereclause=yes name=id_titolo dbname="articolo.id_titolo" )
 column=(type=date updatewhereclause=yes name=documento_data_documento dbname="documento.data_documento" )
 column=(type=decimal(5) updatewhereclause=yes name=resto dbname="resto" )
 column=(type=long updatewhereclause=yes name=id_valuta dbname="id_valuta" )
 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"caus_magazzino~" )  TABLE(NAME=~"documento~" )  TABLE(NAME=~"riga_documento~" )  TABLE(NAME=~"sog_commerciale_gen~" )  TABLE(NAME=~"articolo~" )  TABLE(NAME=~"orafo_metallo~" )  TABLE(NAME=~"orafo_titolo~" ) COLUMN(NAME=~"caus_magazzino.id_caus_magazzino~") COLUMN(NAME=~"riga_documento.peso_netto~") COLUMN(NAME=~"riga_documento.calo~") COLUMN(NAME=~"riga_documento.fino~") COLUMN(NAME=~"orafo_metallo.codice~") COLUMN(NAME=~"sog_commerciale_gen.codice~") COLUMN(NAME=~"sog_commerciale_gen.rag_soc_1~") COLUMN(NAME=~"caus_magazzino.saldi_cl_fino~") COLUMN(NAME=~"caus_magazzino.saldi_cl_lire~") COLUMN(NAME=~"riga_documento.importo_manifattura_val~") COLUMN(NAME=~"riga_documento.importo_manifattura~") COLUMN(NAME=~"riga_documento.tot_riga_val_az~") COLUMN(NAME=~"documento.id_documento~") COLUMN(NAME=~"articolo.id_titolo~") COLUMN(NAME=~"documento.data_documento~") COMPUTE(NAME=~"cast((select resto from orafo_scar_partita s where s.id_riga_documento=~~~"riga_documento~~~".~~~"id_riga_partita~~~" and resto<>0) as numeric(6,5)) as resto~") COMPUTE(NAME=~"cast((  SELECT e.~~~"id_valuta~~~" FROM ~~~"esercizio~~~" e    WHERE :da_data>=data_inizio and :da_data<= data_fine ) as integer) as id_valuta~")    JOIN (LEFT=~"riga_documento.id_documento~"    OP =~"=~"RIGHT=~"documento.id_documento~" )    JOIN (LEFT=~"riga_documento.id_caus_magazzino~"    OP =~"=~"RIGHT=~"caus_magazzino.id_caus_magazzino~" )    JOIN (LEFT=~"documento.id_sog_commerciale~"    OP =~"=~"RIGHT=~"sog_commerciale_gen.id_sog_commerciale~" )    JOIN (LEFT=~"articolo.id_articolo~"    OP =~"=~"RIGHT=~"riga_documento.id_articolo~" )    JOIN (LEFT=~"orafo_titolo.id_metallo~"    OP =~"=~"RIGHT=~"orafo_metallo.id_metallo~" )    JOIN (LEFT=~"orafo_titolo.id_titolo~"    OP =~"=~"RIGHT=~"articolo.id_titolo~" )WHERE(    EXP1 =~"( ( ~~~"documento~~~".~~~"data_documento~~~"~"   OP =~">=~"    EXP2 =~":da_data~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"documento~~~".~~~"data_documento~~~"~"   OP =~"<=~"    EXP2 =~":a_data )~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"( ~~~"sog_commerciale_gen~~~".~~~"codice~~~"~"   OP =~">=~"    EXP2 =~":da_sog~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"sog_commerciale_gen~~~".~~~"codice~~~"~"   OP =~"<=~"    EXP2 =~":a_sog ))~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"(~~~"caus_magazzino~~~".~~~"saldi_cl_fino~~~"~"   OP =~"=~"    EXP2 =~"'+'~"    LOGIC =~"or~" ) WHERE(    EXP1 =~"~~~"caus_magazzino~~~".~~~"saldi_cl_lire~~~"~"   OP =~"=~"    EXP2 =~"'+'~"    LOGIC =~"or~" ) WHERE(    EXP1 =~"~~~"caus_magazzino~~~".~~~"saldi_cl_fino~~~"~"   OP =~"=~"    EXP2 =~"'-'~"    LOGIC =~"or~" ) WHERE(    EXP1 =~"~~~"caus_magazzino~~~".~~~"saldi_cl_lire~~~"~"   OP =~"=~"    EXP2 =~"'-')~" ) ) ARG(NAME = ~"da_data~" TYPE = date)  ARG(NAME = ~"a_data~" TYPE = date)  ARG(NAME = ~"da_sog~" TYPE = string)  ARG(NAME = ~"a_sog~" TYPE = string) " arguments=(("da_data", date),("a_data", date),("da_sog", string),("a_sog", string))  sort="orafo_metallo_codice A sog_commerciale_gen_codice A id_documento A riga_documento_tot_riga_val_az A " )
