 retrieve="PBSELECT( VERSION(400) DISTINCT ()TABLE(NAME=~"documento~" ALIAS=~"documento_a~" )  TABLE(NAME=~"produzione_2011~" )  TABLE(NAME=~"riga_documento~" ALIAS=~"riga_documento_a~" )  TABLE(NAME=~"caus_magazzino~" )  TABLE(NAME=~"articolo~" ALIAS=~"articolo_a~" )  TABLE(NAME=~"sog_commerciale_gen~" ALIAS=~"sog_commerciale_gen_a~" )  TABLE(NAME=~"riga_documento~" ALIAS=~"riga_documento_b~" )  TABLE(NAME=~"articolo~" ALIAS=~"articolo_b~" )  TABLE(NAME=~"documento~" ALIAS=~"documento_b~" )  TABLE(NAME=~"documento~" ALIAS=~"documento_c~" )  TABLE(NAME=~"riga_documento~" ALIAS=~"riga_documento_c~" )  TABLE(NAME=~"sog_commerciale_gen~" ALIAS=~"sog_commerciale_gen_b~" )  TABLE(NAME=~"sog_commerciale_gen~" ALIAS=~"sog_commerciale_gen_c~" ) COLUMN(NAME=~"documento_a.num_progressivo~") COLUMN(NAME=~"documento_a.data_registrazione~") COLUMN(NAME=~"documento_a.num_documento~") COLUMN(NAME=~"documento_a.data_documento~") COLUMN(NAME=~"caus_magazzino.step_produzione~") COLUMN(NAME=~"caus_magazzino.saldi_cl_fino~") COLUMN(NAME=~"riga_documento_a.num_riga~") COLUMN(NAME=~"riga_documento_a.id_articolo~") COLUMN(NAME=~"riga_documento_a.quantita~") COLUMN(NAME=~"riga_documento_a.peso_netto~") COLUMN(NAME=~"riga_documento_a.calo~") COLUMN(NAME=~"riga_documento_a.fino~") COLUMN(NAME=~"articolo_a.codice~") COLUMN(NAME=~"documento_a.id_documento~") COLUMN(NAME=~"articolo_a.id_cat_codifica~") COLUMN(NAME=~"riga_documento_a.id_riga_sorgente~") COLUMN(NAME=~"riga_documento_b.num_riga~") COLUMN(NAME=~"articolo_b.codice~") COLUMN(NAME=~"riga_documento_b.descrizione~") COLUMN(NAME=~"riga_documento_b.quantita~") COLUMN(NAME=~"riga_documento_b.peso_netto~") COLUMN(NAME=~"riga_documento_b.calo~") COLUMN(NAME=~"riga_documento_b.fino~") COLUMN(NAME=~"documento_b.num_progressivo~") COLUMN(NAME=~"documento_b.data_registrazione~") COLUMN(NAME=~"documento_b.num_documento~") COLUMN(NAME=~"documento_b.data_documento~") COLUMN(NAME=~"documento_a.data_ora_creazione~") COLUMN(NAME=~"documento_c.num_documento~") COLUMN(NAME=~"documento_c.data_documento~") COLUMN(NAME=~"riga_documento_c.num_riga~") COLUMN(NAME=~"riga_documento_c.quantita~") COLUMN(NAME=~"riga_documento_b.id_riga_documento~") COLUMN(NAME=~"sog_commerciale_gen_b.rag_soc_1~") COLUMN(NAME=~"documento_c.data_prev_consegna~") COLUMN(NAME=~"produzione_2011.id_bollettina~") COLUMN(NAME=~"riga_documento_a.id_riga_documento~") COLUMN(NAME=~"riga_documento_a.qta_evasa~") COLUMN(NAME=~"sog_commerciale_gen_a.codice~") COLUMN(NAME=~"sog_commerciale_gen_a.rag_soc_1~") COLUMN(NAME=~"documento_b.data_prev_consegna~") COLUMN(NAME=~"sog_commerciale_gen_c.rag_soc_1~")    JOIN (LEFT=~"documento_c.id_documento~"    OP =~"=~"RIGHT=~"riga_documento_c.id_documento~"    OUTER2 =~"riga_documento_c.id_documento~" )    JOIN (LEFT=~"documento_a.id_documento~"    OP =~"=~"RIGHT=~"riga_documento_a.id_documento~"    OUTER2 =~"riga_documento_a.id_documento~" )    JOIN (LEFT=~"riga_documento_a.id_articolo~"    OP =~"=~"RIGHT=~"articolo_a.id_articolo~"    OUTER1 =~"riga_documento_a.id_articolo~" )    JOIN (LEFT=~"documento_a.id_caus_magazzino~"    OP =~"=~"RIGHT=~"caus_magazzino.id_caus_magazzino~"    OUTER1 =~"documento_a.id_caus_magazzino~" )    JOIN (LEFT=~"documento_c.id_sog_commerciale~"    OP =~"=~"RIGHT=~"sog_commerciale_gen_b.id_sog_commerciale~"    OUTER1 =~"documento_c.id_sog_commerciale~" )    JOIN (LEFT=~"produzione_2011.id_doc_produzione~"    OP =~"=~"RIGHT=~"riga_documento_a.id_riga_documento~"    OUTER1 =~"produzione_2011.id_doc_produzione~" )    JOIN (LEFT=~"riga_documento_b.id_riga_doc_provenienza~"    OP =~"=~"RIGHT=~"riga_documento_c.id_riga_documento~"    OUTER1 =~"riga_documento_b.id_riga_doc_provenienza~" )    JOIN (LEFT=~"documento_a.id_sog_commerciale~"    OP =~"=~"RIGHT=~"sog_commerciale_gen_c.id_sog_commerciale~"    OUTER1 =~"documento_a.id_sog_commerciale~" )    JOIN (LEFT=~"riga_documento_b.id_articolo~"    OP =~"=~"RIGHT=~"articolo_b.id_articolo~" )    JOIN (LEFT=~"produzione_2011.id_bollettina~"    OP =~"=~"RIGHT=~"documento_b.id_documento~" )    JOIN (LEFT=~"documento_b.id_documento~"    OP =~"=~"RIGHT=~"riga_documento_b.id_documento~" )    JOIN (LEFT=~"sog_commerciale_gen_a.id_sog_commerciale~"    OP =~"=~"RIGHT=~"documento_b.id_sog_commerciale~" )WHERE(    EXP1 =~"~~~"documento_b~~~".~~~"data_documento~~~"~"   OP =~">=~"    EXP2 =~":da_data~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"documento_b~~~".~~~"data_documento~~~"~"   OP =~"<=~"    EXP2 =~":a_data~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"riga_documento_b~~~".~~~"id_riga_doc_padre~~~"~"   OP =~"is~"    EXP2 =~"null~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"riga_documento_a~~~".~~~"id_riga_doc_padre~~~"~"   OP =~"is~"    EXP2 =~"null~" ) ) ORDER(NAME=~"documento_b.data_documento~" ASC=yes )  ORDER(NAME=~"documento_a.data_documento~" ASC=yes )  ORDER(NAME=~"documento_a.num_documento~" ASC=yes )  ORDER(NAME=~"documento_a.data_ora_creazione~" ASC=yes ) ARG(NAME = ~"da_data~" TYPE = date)  ARG(NAME = ~"a_data~" TYPE = date) " arguments=(("da_data", date),("a_data", date))  sort="documento_data_documento_1 A documento_num_documento_1 A produzione_2011_id_bollettina A id_articolo A documento_data_ora_creazione A caus_magazzino_saldi_cl_fino A documento_id_documento A " )
