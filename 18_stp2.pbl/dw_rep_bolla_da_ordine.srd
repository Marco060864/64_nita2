 retrieve="SELECT
	cast(null as char(10))as num_vs_bolla,
cast(null as date)as data_vs_bolla,
cast(null as decimal(16,2))as residuo,
    sede.~"indirizzo~", sede.~"cap~", sede.~"localita~", sede.~"provincia~", sede.~"nazione~",
    azienda.~"rag_soc_1~", azienda.~"par_iva~", azienda.~"cod_fiscale~",
    Documento.~"id_documento~", Documento.~"num_documento~", Documento.~"data_documento~", Documento.~"note_intestazione~", Documento.~"num_colli~", Documento.~"asp_beni~", Documento.~"tras_mezzo~",
    Destinazione.~"rag_soc_1~", Destinazione.~"rag_soc_2~", Destinazione.~"indirizzo~", Destinazione.~"cap~", Destinazione.~"localita~", Destinazione.~"provincia~", Destinazione.~"nazione~",
    Registro.~"tipo_registro~",
    Tipo_Trasporto.~"descrizione~",
    Riga_Documento.~"id_riga_documento~", Riga_Documento.~"descrizione~", Riga_Documento.~"quantita~", Riga_Documento.~"peso_netto~", Riga_Documento.~"peso_lordo~", Riga_Documento.~"coef_calo~",Riga_Documento.~"num_riga~",
    Caus_Trasporto.~"descrizione~",
    Prof_Documento.~"descrizione~",
    Anagrafica.~"rag_soc_1~", Anagrafica.~"rag_soc_2~", Anagrafica.~"indirizzo~", Anagrafica.~"cap~", Anagrafica.~"localita~", Anagrafica.~"provincia~", Anagrafica.~"nazione~",
    Anagrafica_Vettore.~"rag_soc_1~", Anagrafica_Vettore.~"rag_soc_2~", Anagrafica_Vettore.~"indirizzo~", Anagrafica_Vettore.~"cap~", Anagrafica_Vettore.~"localita~", Anagrafica_Vettore.~"provincia~", Anagrafica_Vettore.~"nazione~",
    Articolo.~"codice~",
    Unita_Misura.~"simbolo~", Unita_Misura.~"conversione~",
    orafo_titolo.~"titolo~"
FROM
    ~"DBA~".~"sede~" sede RIGHT OUTER JOIN ~"DBA~".~"azienda~" azienda ON
        sede.~"id_azienda~" = azienda.~"id_azienda~",
    ~"DBA~".~"documento~" Documento LEFT OUTER JOIN ~"DBA~".~"Sog_Commerciale~" Sog_Commerciale ON
        Documento.~"id_sog_commerciale~" = Sog_Commerciale.~"id_sog_commerciale~",
    ~"DBA~".~"documento~" Documento LEFT OUTER JOIN ~"DBA~".~"Destinazione~" Destinazione ON
        Documento.~"id_destinazione~" = Destinazione.~"id_destinazione~",
    ~"DBA~".~"documento~" Documento LEFT OUTER JOIN ~"DBA~".~"Tipo_Trasporto~" Tipo_Trasporto ON
        Documento.~"id_tipo_trasporto~" = Tipo_Trasporto.~"id_tipo_trasporto~",
    ~"DBA~".~"documento~" Documento LEFT OUTER JOIN ~"DBA~".~"riga_documento~" Riga_Documento ON
        Documento.~"id_documento~" = Riga_Documento.~"id_documento~",
    ~"DBA~".~"documento~" Documento LEFT OUTER JOIN ~"DBA~".~"Caus_Trasporto~" Caus_Trasporto ON
        Documento.~"id_caus_trasporto~" = Caus_Trasporto.~"id_caus_trasporto~",
    ~"DBA~".~"documento~" Documento LEFT OUTER JOIN ~"DBA~".~"Sog_Commerciale~" Sog_Commerciale_Vettore ON
        Documento.~"id_sog_commerciale_vettore~" = Sog_Commerciale_Vettore.~"id_sog_commerciale~",
    ~"DBA~".~"documento~" Documento LEFT OUTER JOIN ~"DBA~".~"Prof_Documento~" Prof_Documento ON
        Documento.~"id_prof_documento~" = Prof_Documento.~"id_prof_documento~",
    ~"DBA~".~"Sog_Commerciale~" Sog_Commerciale LEFT OUTER JOIN ~"DBA~".~"Anagrafica~" Anagrafica ON
        Sog_Commerciale.~"id_anagrafica~" = Anagrafica.~"id_anagrafica~",
    ~"DBA~".~"riga_documento~" Riga_Documento LEFT OUTER JOIN ~"DBA~".~"Unita_Confezione~" Unita_Confezione ON
        Riga_Documento.~"id_unita_confezione~" = Unita_Confezione.~"id_unita_confezione~",
    ~"DBA~".~"Sog_Commerciale~" Sog_Commerciale_Vettore LEFT OUTER JOIN ~"DBA~".~"Anagrafica~" Anagrafica_Vettore ON
        Sog_Commerciale_Vettore.~"id_anagrafica~" = Anagrafica_Vettore.~"id_anagrafica~",
    ~"DBA~".~"riga_documento~" Riga_Documento LEFT OUTER JOIN ~"DBA~".~"Articolo~" Articolo ON
        Riga_Documento.~"id_articolo~" = Articolo.~"id_articolo~",
    ~"DBA~".~"Unita_Confezione~" Unita_Confezione LEFT OUTER JOIN ~"DBA~".~"Unita_Misura~" Unita_Misura ON
        Unita_Confezione.~"id_unita_misura~" = Unita_Misura.~"id_unita_misura~",
    ~"DBA~".~"Articolo~" Articolo LEFT OUTER JOIN ~"DBA~".~"orafo_titolo~" orafo_titolo ON
        Articolo.~"id_titolo~" = orafo_titolo.~"id_titolo~",
    ~"DBA~".~"Registro~" ~"Registro~"
WHERE
    azienda.~"id_azienda~" = Documento.~"id_azienda~" AND
    Documento.~"id_registro~" = Registro.~"id_registro~"
and Documento.~"id_documento~"=:rn_id_doc

ORDER BY
    Documento.~"id_documento~" ASC,
    Riga_Documento.~"id_riga_documento~" ASC" arguments=(("rn_id_doc", number))  sort="num_riga A " )
