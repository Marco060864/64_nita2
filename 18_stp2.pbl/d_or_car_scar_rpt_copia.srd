 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"orafo_aper_partita~" )  TABLE(NAME=~"orafo_scar_partita~" )  TABLE(NAME=~"documento~" ALIAS=~"documento_a~" )  TABLE(NAME=~"caus_magazzino~" ALIAS=~"caus_magazzino_a~" )  TABLE(NAME=~"orafo_tipo_partita~" ALIAS=~"orafo_tipo_partita_a~" )  TABLE(NAME=~"orafo_titolo~" ALIAS=~"orafo_titolo_a~" )  TABLE(NAME=~"riga_documento~" )  TABLE(NAME=~"documento~" ALIAS=~"documento_b~" )  TABLE(NAME=~"sog_commerciale_gen~" )  TABLE(NAME=~"orafo_titolo~" ALIAS=~"orafo_titolo_b~" )  TABLE(NAME=~"articolo~" )  TABLE(NAME=~"orafo_metallo~" )  TABLE(NAME=~"caus_magazzino~" ALIAS=~"caus_magazzino_b~" )  TABLE(NAME=~"orafo_tipo_partita~" ALIAS=~"orafo_tipo_partita_b~" ) COLUMN(NAME=~"orafo_aper_partita.stato~") COLUMN(NAME=~"orafo_aper_partita.val_apertura~") COLUMN(NAME=~"orafo_aper_partita.val_scarico~") COLUMN(NAME=~"orafo_titolo_a.titolo~") COLUMN(NAME=~"documento_a.num_documento~") COLUMN(NAME=~"documento_a.data_documento~") COLUMN(NAME=~"caus_magazzino_a.codice~") COLUMN(NAME=~"orafo_tipo_partita_a.cod_tipo_partita~") COLUMN(NAME=~"orafo_scar_partita.val_scarico~") COLUMN(NAME=~"orafo_aper_partita.id_partita~") COLUMN(NAME=~"documento_b.num_documento~") COLUMN(NAME=~"documento_b.data_documento~") COLUMN(NAME=~"riga_documento.num_riga~") COLUMN(NAME=~"sog_commerciale_gen.id_sog_commerciale~") COLUMN(NAME=~"sog_commerciale_gen.codice~") COLUMN(NAME=~"sog_commerciale_gen.rag_soc_1~") COLUMN(NAME=~"riga_documento.peso_netto~") COLUMN(NAME=~"orafo_titolo_b.titolo~") COLUMN(NAME=~"articolo.codice~") COLUMN(NAME=~"orafo_metallo.codice~") COLUMN(NAME=~"documento_a.id_documento~") COLUMN(NAME=~"orafo_tipo_partita_b.cod_tipo_partita~") COLUMN(NAME=~"riga_documento.coef_calo~") COLUMN(NAME=~"riga_documento.calo~") COLUMN(NAME=~"riga_documento.fino~") COMPUTE(NAME=~"cast( (select sum(r.peso_netto) from riga_documento r, articolo a, orafo_titolo t where id_documento=~~~"orafo_aper_partita~~~".~~~"id_documento~~~" and t.id_titolo=~~~"orafo_aper_partita~~~".~~~"id_titolo~~~" and a.id_articolo=r.id_articolo and t.id_titolo=a.id_titolo) as numeric(14,2)) as aper_legato~") COMPUTE(NAME=~"cast((select codice from orafo_metallo where id_metallo=orafo_titolo_a.id_metallo) as char(2)) as aper_met~") COLUMN(NAME=~"documento_b.scarica_ogni_titolo~")    JOIN (LEFT=~"orafo_scar_partita.id_partita~"    OP =~"=~"RIGHT=~"orafo_aper_partita.id_partita~"    OUTER2 =~"orafo_aper_partita.id_partita~" )    JOIN (LEFT=~"riga_documento.id_riga_partita~"    OP =~"=~"RIGHT=~"orafo_scar_partita.id_riga_documento~"    OUTER2 =~"orafo_scar_partita.id_riga_documento~" )    JOIN (LEFT=~"documento_b.id_documento~"    OP =~"=~"RIGHT=~"riga_documento.id_documento~"    OUTER2 =~"riga_documento.id_documento~" )    JOIN (LEFT=~"articolo.id_articolo~"    OP =~"=~"RIGHT=~"riga_documento.id_articolo~"    OUTER2 =~"riga_documento.id_articolo~" )    JOIN (LEFT=~"caus_magazzino_b.id_caus_magazzino~"    OP =~"=~"RIGHT=~"riga_documento.id_caus_magazzino~"    OUTER2 =~"riga_documento.id_caus_magazzino~" )    JOIN (LEFT=~"orafo_tipo_partita_b.id_tipo_partita~"    OP =~"=~"RIGHT=~"caus_magazzino_b.id_tipo_partita~"    OUTER2 =~"caus_magazzino_b.id_tipo_partita~" )    JOIN (LEFT=~"orafo_titolo_b.id_titolo~"    OP =~"=~"RIGHT=~"articolo.id_titolo~"    OUTER2 =~"articolo.id_titolo~" )    JOIN (LEFT=~"orafo_metallo.id_metallo~"    OP =~"=~"RIGHT=~"orafo_titolo_b.id_metallo~"    OUTER2 =~"orafo_titolo_b.id_metallo~" )    JOIN (LEFT=~"documento_a.id_documento~"    OP =~"=~"RIGHT=~"orafo_aper_partita.id_documento~" )    JOIN (LEFT=~"caus_magazzino_a.id_caus_magazzino~"    OP =~"=~"RIGHT=~"documento_a.id_caus_magazzino~" )    JOIN (LEFT=~"orafo_tipo_partita_a.id_tipo_partita~"    OP =~"=~"RIGHT=~"caus_magazzino_a.id_tipo_partita~" )    JOIN (LEFT=~"orafo_titolo_a.id_titolo~"    OP =~"=~"RIGHT=~"orafo_aper_partita.id_titolo~" )    JOIN (LEFT=~"sog_commerciale_gen.id_sog_commerciale~"    OP =~"=~"RIGHT=~"documento_a.id_sog_commerciale~" )WHERE(    EXP1 =~"(~~~"documento_a~~~".~~~"data_documento~~~"~"   OP =~">=~"    EXP2 =~":da_data~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"documento_a~~~".~~~"data_documento~~~"~"   OP =~"<=~"    EXP2 =~":a_data)~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"(~~~"sog_commerciale_gen~~~".~~~"codice~~~"~"   OP =~">=~"    EXP2 =~":da_sog~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"sog_commerciale_gen~~~".~~~"codice~~~"~"   OP =~"<=~"    EXP2 =~":a_sog)~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"(~~~"caus_magazzino_a~~~".~~~"codice~~~"~"   OP =~">=~"    EXP2 =~":da_caus~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"caus_magazzino_a~~~".~~~"codice~~~"~"   OP =~"<=~"    EXP2 =~":a_caus)~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"(orafo_aper_partita.stato~"   OP =~"=~"    EXP2 =~":stato~"    LOGIC =~"or~" ) WHERE(    EXP1 =~"orafo_aper_partita.stato~"   OP =~"=~"    EXP2 =~":stato2)~" ) ) ARG(NAME = ~"da_data~" TYPE = date)  ARG(NAME = ~"a_data~" TYPE = date)  ARG(NAME = ~"da_sog~" TYPE = string)  ARG(NAME = ~"a_sog~" TYPE = string)  ARG(NAME = ~"da_caus~" TYPE = string)  ARG(NAME = ~"a_caus~" TYPE = string)  ARG(NAME = ~"stato~" TYPE = string)  ARG(NAME = ~"stato2~" TYPE = string) " arguments=(("da_data", date),("a_data", date),("da_sog", string),("a_sog", string),("da_caus", string),("a_caus", string),("stato", string),("stato2", string))  sort="orafo_aper_partita_id_partita A documento_a_num_documento A documento_a_data_documento A riga_documento_num_riga A " )
