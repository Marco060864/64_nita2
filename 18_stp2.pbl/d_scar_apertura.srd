 column=(type=decimal(2) updatewhereclause=yes name=orafo_aper_partita_val_apertura dbname="orafo_aper_partita.val_apertura" )
 column=(type=decimal(2) updatewhereclause=yes name=orafo_aper_partita_val_scarico dbname="orafo_aper_partita.val_scarico" )
 column=(type=char(16) updatewhereclause=yes name=documento_num_documento_1 dbname="documento.num_documento" )
 column=(type=date updatewhereclause=yes name=documento_data_documento_2 dbname="documento.data_documento" )
 column=(type=datetime updatewhereclause=yes name=documento_data_ora_creazione dbname="documento.data_ora_creazione" )
 column=(type=decimal(2) updatewhereclause=yes name=orafo_scar_partita_val_scarico dbname="orafo_scar_partita.val_scarico" )
 column=(type=decimal(2) updatewhereclause=yes name=riga_documento_calo dbname="riga_documento.calo" )
 column=(type=decimal(2) updatewhereclause=yes name=riga_documento_fino dbname="riga_documento.fino" )
 column=(type=decimal(2) updatewhereclause=yes name=riga_documento_coef_calo dbname="riga_documento.coef_calo" )
 column=(type=char(4) updatewhereclause=yes name=orafo_tipo_partita_cod_tipo_partita dbname="orafo_tipo_partita.cod_tipo_partita" )
 column=(type=char(8) updatewhereclause=yes name=sog_commerciale_gen_codice dbname="sog_commerciale_gen.codice" )
 column=(type=char(40) updatewhereclause=yes name=sog_commerciale_gen_rag_soc_1 dbname="sog_commerciale_gen.rag_soc_1" )
 retrieve="  SELECT ~"orafo_aper_partita~".~"id_partita~",   
         ~"riga_documento~".~"id_riga_partita~",   
         ~"documento_a~".~"num_documento~",   
         ~"documento_a~".~"data_documento~",  
			~"documento_a~".~"data_ORA_CREAZIONE~", 
         ~"orafo_aper_partita~".~"val_apertura~",   
         ~"orafo_aper_partita~".~"val_scarico~",   
         ~"documento_b~".~"num_documento~",   
         ~"documento_b~".~"data_documento~",
			~"documento_b~".~"data_ORA_CREAZIONE~",   
         ~"orafo_scar_partita~".~"val_scarico~",   
         ~"riga_documento~".~"calo~",   
         ~"riga_documento~".~"fino~",   
         ~"riga_documento~".~"coef_calo~",   
         ~"orafo_tipo_partita~".~"cod_tipo_partita~",
         ~"sog_commerciale_gen~".~"codice~",
         ~"sog_commerciale_gen~".~"rag_soc_1~"
    FROM ~"documento~" ~"documento_a~",   
         ~"orafo_aper_partita~",   
         ~"orafo_scar_partita~",   
         ~"riga_documento~",   
         ~"documento~" ~"documento_b~",   
         ~"caus_magazzino~",   
         ~"orafo_tipo_partita~",
			~"sog_commerciale_gen~"
   WHERE ( ~"orafo_aper_partita~".~"id_documento~" = ~"documento_a~".~"id_documento~" ) and  
         ( ~"orafo_scar_partita~".~"id_partita~" = ~"orafo_aper_partita~".~"id_partita~" ) and  
         ( ~"orafo_scar_partita~".~"id_riga_documento~" = ~"riga_documento~".~"id_riga_partita~") and  
         ( ~"riga_documento~".~"id_documento~" = ~"documento_b~".~"id_documento~" ) and  
         ( ~"caus_magazzino~".~"id_caus_magazzino~" = ~"riga_documento~".~"id_caus_magazzino~" ) and  
         ( ~"orafo_tipo_partita~".~"id_tipo_partita~" = ~"caus_magazzino~".~"id_tipo_partita~" ) and 
			( ~"sog_commerciale_gen~".~"id_sog_commerciale~" = ~"documento_a~".~"id_sog_commerciale~") and 
			( ~"documento_a~".~"data_documento~" >=:da_data) and 
			( ~"documento_a~".~"data_documento~" <=:a_data) and
			( ~"sog_commerciale_gen~".~"codice~">=:da_sog) and
			( ~"sog_commerciale_gen~".~"codice~"<=:a_sog) and
			( substr(~"orafo_tipo_partita~".~"cod_tipo_partita~",1,1) = 'S' )     
" arguments=(("da_data", date),("a_data", date),("DA_SOG", string),("A_SOG", string))  sort="documento_data_documento_2 A documento_num_documento_1 A " )
compute(band=header alignment="0" expression="~"Stampa scarichi dal ~"+string( da_data )+ ~" al ~" + string(a_data)+ ~"  per i sog. commerciali  ~"+if( DA_SOG='0000000000000000000000000', ~"dal primo ~", ~"da ~"+ da_sog) +  if(a_sog=~"ZZZZZZZZZZZZZZZZZZZZZZZZZ~", ~" all'ultimo~", ~" a ~"+a_sog)  "border="0" color="0" x="41" y="12" height="60" width="3136" format="[general]"  name=c_filtro  font.face="Arial" font.height="-8" font.weight="400"  font.family="2" font.pitch="2" font.charset="0" background.mode="1" background.color="536870912" )
