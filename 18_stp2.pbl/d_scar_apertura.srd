table(column=(type=long updatewhereclause=yes identity=yes name=orafo_aper_partita_id_partita dbname="orafo_aper_partita.id_partita" )
 column=(type=long updatewhereclause=yes name=riga_documento_id_riga_partita dbname="riga_documento.id_riga_partita" )
