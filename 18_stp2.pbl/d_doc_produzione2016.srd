 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"documento~" ALIAS=~"documento_a~" )  TABLE(NAME=~"riga_documento~" )  TABLE(NAME=~"produzione_2011~" )  TABLE(NAME=~"articolo~" )  TABLE(NAME=~"caus_magazzino~" )  TABLE(NAME=~"sog_commerciale_gen~" )  TABLE(NAME=~"documento~" ALIAS=~"documento_b~" ) COLUMN(NAME=~"documento_a.id_sog_commerciale~") COLUMN(NAME=~"produzione_2011.id_bollettina~") COLUMN(NAME=~"produzione_2011.id_doc_produzione~") COLUMN(NAME=~"riga_documento.quantita~") COLUMN(NAME=~"documento_a.num_progressivo~") COLUMN(NAME=~"documento_a.data_registrazione~") COLUMN(NAME=~"documento_a.num_documento~") COLUMN(NAME=~"documento_a.data_documento~") COLUMN(NAME=~"articolo.codice~") COLUMN(NAME=~"caus_magazzino.step_produzione~") COLUMN(NAME=~"caus_magazzino.saldi_cl_fino~") COLUMN(NAME=~"riga_documento.id_riga_documento~") COLUMN(NAME=~"sog_commerciale_gen.codice~") COLUMN(NAME=~"sog_commerciale_gen.rag_soc_1~")    JOIN (LEFT=~"produzione_2011.id_doc_produzione~"    OP =~"=~"RIGHT=~"riga_documento.id_riga_documento~" )    JOIN (LEFT=~"riga_documento.id_documento~"    OP =~"=~"RIGHT=~"documento_a.id_documento~" )    JOIN (LEFT=~"riga_documento.id_articolo~"    OP =~"=~"RIGHT=~"articolo.id_articolo~" )    JOIN (LEFT=~"caus_magazzino.id_caus_magazzino~"    OP =~"=~"RIGHT=~"riga_documento.id_caus_magazzino~" )    JOIN (LEFT=~"documento_a.id_sog_commerciale~"    OP =~"=~"RIGHT=~"sog_commerciale_gen.id_sog_commerciale~" )    JOIN (LEFT=~"produzione_2011.id_bollettina~"    OP =~"=~"RIGHT=~"documento_b.id_documento~" )WHERE(    EXP1 =~"~~~"documento_a~~~".~~~"id_sog_commerciale~~~"~"   OP =~"=~"    EXP2 =~":id_fornitore~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"documento_b~~~".~~~"id_prof_documento~~~"~"   OP =~"<>~"    EXP2 =~"127~" ) ) ARG(NAME = ~"id_fornitore~" TYPE = number) " arguments=(("id_fornitore", number))  sort="produzione_2011_id_bollettina A documento_data_documento A " )
