table(column=(type=long updatewhereclause=yes key=yes identity=yes name=id_documento dbname="documento.id_documento" dbalias=".id_documento" )
 column=(type=long updatewhereclause=yes name=id_prof_documento dbname="documento.id_prof_documento" dbalias=".id_prof_documento" )
 column=(type=decimal(0) updatewhereclause=yes name=num_progressivo dbname="documento.num_progressivo" dbalias=".num_progressivo" )
 column=(type=char(16) updatewhereclause=yes name=num_documento dbname="documento.num_documento" dbalias=".num_documento" )
 column=(type=date updatewhereclause=yes name=data_documento dbname="documento.data_documento" dbalias=".data_documento" )
 column=(type=char(1) update=yes updatewhereclause=yes name=chius_forzata dbname="documento.chius_forzata" dbalias=".chius_forzata" )
 column=(type=long updatewhereclause=yes name=id_sog_commerciale dbname="documento.id_sog_commerciale" dbalias=".id_sog_commerciale" )
 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"documento~" ) COLUMN(NAME=~"documento.id_documento~") COLUMN(NAME=~"documento.id_prof_documento~") COLUMN(NAME=~"documento.num_progressivo~") COLUMN(NAME=~"documento.num_documento~") COLUMN(NAME=~"documento.data_documento~") COLUMN(NAME=~"documento.chius_forzata~") COLUMN(NAME=~"documento.id_sog_commerciale~")WHERE(    EXP1 =~"~~~"documento~~~".~~~"id_prof_documento~~~"~"   OP =~"=~"    EXP2 =~":id_prof~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"documento~~~".~~~"id_sog_commerciale~~~"~"   OP =~"=~"    EXP2 =~":id_sog~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"documento~~~".~~~"data_documento~~~"~"   OP =~"<=~"    EXP2 =~":a_data~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"documento~~~".~~~"data_documento~~~"~"   OP =~">=~"    EXP2 =~":da_data~" ) ) ARG(NAME = ~"id_prof~" TYPE = number)  ARG(NAME = ~"id_sog~" TYPE = number)  ARG(NAME = ~"da_data~" TYPE = date)  ARG(NAME = ~"a_data~" TYPE = date) " update="documento" updatewhere=1 updatekeyinplace=yes arguments=(("id_prof", number),("id_sog", number),("da_data", date),("a_data", date)) )
