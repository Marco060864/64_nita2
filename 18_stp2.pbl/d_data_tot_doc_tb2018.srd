 retrieve="  SELECT ~"riga_documento~".~"id_riga_documento~",   
         ~"riga_documento~".~"id_documento~",   
         ~"riga_documento~".~"id_articolo~",   
         ~"articolo~".~"codice~",   
         ~"articolo~".~"descrizione~",   
         ~"riga_documento~".~"quantita~",   
         ~"riga_documento~".~"qta_un_base~",   
         ~"riga_documento~".~"id_locazione_1~",   
         ~"riga_documento~".~"prezzo~",   
         ~"riga_documento~".~"peso_netto~",   
         ~"riga_documento~".~"dim_l~",   
         ~"riga_documento~".~"tot_riga_val_riga~",   
         ~"riga_documento~".~"calo~",   
         ~"riga_documento~".~"coef_calo~",   
         ~"riga_documento~".~"fino~",   
         ~"riga_documento~".~"prezzo_metallo~",   
         ~"riga_documento~".~"prezzo_manifattura~",   
         ~"riga_documento~".~"prezzo_complessivo~",   
         ~"riga_documento~".~"peso_non_prezioso~",   
         ~"riga_documento~".~"importo_manifattura_val~",   
         ~"documento~".~"num_documento~",   
         ~"documento~".~"data_documento~",   
         ~"sog_commerciale_gen~".~"rag_soc_1~",   
         ~"sog_commerciale_gen~".~"codice~",   
         ~"caus_magazzino~".~"segno~",   
         ~"orafo_titolo~".~"titolo~",   
         ~"orafo_metallo~".~"codice~",   
         ~"caus_magazzino~".~"codice~",   
         ~"esercizio~".~"data_inizio~",   
         ~"esercizio~".~"data_fine~",   
         ~"esercizio~".~"id_esercizio~",   
         ~"azienda~".~"rag_soc_1~",   
         ~"riga_documento~".~"importo_manifattura~",   
         ~"caus_magazzino~".~"segno_lire~",   
         ~"riga_documento~".~"num_riga~",   
         ~"riga_documento~".~"id_locazione_2~",   
         ~"riga_documento~".~"tot_riga_val_az~",   
         ~"valuta~".~"id_valuta~",   
         ~"esercizio~".~"id_valuta~",   
         ~"orafo_tipo_partita~".~"cod_tipo_partita~",   
         ~"documento~".~"cambio~",   
         ~"caus_magazzino~".~"vedi_prezzi_in_stampe~",   
         ~"riga_documento~".~"provv_imp_agente_2~",   
         ~"riga_documento~".~"provv_imp_carea_2~",   
         ~"orafo_par_sistema~".~"peso_laccio~",   
         ~"orafo_par_sistema~".~"peso_filo_rame~",   
         ~"riga_documento~".~"peso_lordo~",   
         fn_rec_prezzo_filo_rame('L', documento.~"data_documento~") as c_prezzo_laccio,   
         fn_rec_prezzo_filo_rame('F', documento.~"data_documento~") as c_prezzo_filo_rame,   
         ~"documento~".~"id_prof_documento~"  
    FROM {oj ~"orafo_tipo_partita~" RIGHT OUTER JOIN ~"caus_magazzino~" ON ~"orafo_tipo_partita~".~"id_tipo_partita~" = ~"caus_magazzino~".~"id_tipo_partita~"},   
         ~"riga_documento~",   
         ~"documento~",   
         ~"sog_commerciale_gen~",   
         ~"articolo~",   
         ~"orafo_metallo~",   
         ~"orafo_titolo~",   
         ~"azienda~",   
         ~"esercizio~",   
         ~"valuta~",   
         ~"orafo_par_sistema~"  
   WHERE ( ~"caus_magazzino~".~"id_caus_magazzino~" = ~"riga_documento~".~"id_caus_magazzino~" ) and  
         ( ~"documento~".~"id_documento~" = ~"riga_documento~".~"id_documento~" ) and  
         ( ~"documento~".~"id_sog_commerciale~" = ~"sog_commerciale_gen~".~"id_sog_commerciale~" ) and  
         ( ~"articolo~".~"id_articolo~" = ~"riga_documento~".~"id_articolo~" ) and  
         ( ~"orafo_titolo~".~"id_metallo~" = ~"orafo_metallo~".~"id_metallo~" ) and  
         ( ~"orafo_titolo~".~"id_titolo~" = ~"articolo~".~"id_titolo~" ) and  
         ( ~"azienda~".~"id_azienda~" = ~"documento~".~"id_azienda~" ) and  
         ( ~"esercizio~".~"id_esercizio~" = ~"azienda~".~"id_esercizio~" ) and  
         ( ~"valuta~".~"id_valuta~" = ~"riga_documento~".~"id_valuta~" ) and  
         (~"articolo~".~"codice~" >= :da_art AND  
         ~"articolo~".~"codice~" <= :a_art) AND  
         (~"caus_magazzino~".~"codice~" >= :da_caus AND  
         ~"caus_magazzino~".~"codice~" <= :a_caus) AND  
         (~"caus_magazzino~".~"segno~" = 'C' OR  
         ~"caus_magazzino~".~"segno~" = 'S' OR  
         ~"caus_magazzino~".~"segno~" = 'N' ) AND  
         (~"documento~".~"data_documento~" >= :data_inizio_es AND  
         ~"documento~".~"data_documento~" <= :a_data) AND  
         (~"sog_commerciale_gen~".~"codice~" >= :da_sog AND  
         ~"sog_commerciale_gen~".~"codice~" <= :a_sog) AND  
         (~"orafo_metallo~".~"prezioso~" = 'S' OR  
         ~"orafo_metallo~".~"prezioso~" = :solo_preziosi) AND  
         ~"caus_magazzino~".~"mp_gruppo_lib_4~" is null    
" update="riga_documento" updatewhere=1 updatekeyinplace=yes arguments=(("da_art", string),("a_art", string),("da_sog", string),("a_sog", string),("da_caus", string),("a_caus", string),("da_data", date),("a_data", date),("data_inizio_es", date),("filtro", string),("totali_doc", string),("legato_fino", string),("solo_preziosi", string),("magazzino", number),("solo_fiscali", number))  sort="orafo_metallo_codice A documento_data_documento A documento_num_documento A riga_documento_id_documento A sog_commerciale_gen_rag_soc_1 A sog_commerciale_gen_codice A num_riga A articolo_codice A " )
