table(column=(type=char(1) updatewhereclause=yes name=orafo_aper_partita_stato dbname="orafo_aper_partita.stato" dbalias=".stato" )
 column=(type=decimal(4) updatewhereclause=yes name=orafo_aper_partita_val_apertura dbname="orafo_aper_partita.val_apertura" dbalias=".val_apertura" )
 column=(type=decimal(4) updatewhereclause=yes name=orafo_aper_partita_val_scarico dbname="orafo_aper_partita.val_scarico" dbalias=".val_scarico" )
 column=(type=decimal(2) updatewhereclause=yes name=orafo_titolo_titolo dbname="orafo_titolo.titolo" dbalias=".titolo" )
 column=(type=char(16) updatewhereclause=yes name=documento_num_documento dbname="documento.num_documento" dbalias="documento_a.num_documento" )
 column=(type=date updatewhereclause=yes name=documento_data_documento dbname="documento.data_documento" dbalias="documento_a.data_documento" )
 column=(type=char(8) updatewhereclause=yes name=caus_magazzino_codice dbname="caus_magazzino.codice" dbalias=".codice" )
 column=(type=char(4) updatewhereclause=yes name=orafo_tipo_partita_cod_tipo_partita dbname="orafo_tipo_partita.cod_tipo_partita" dbalias=".cod_tipo_partita" )
 column=(type=decimal(4) updatewhereclause=yes name=orafo_scar_partita_val_scarico dbname="orafo_scar_partita.val_scarico" dbalias=".val_scarico" )
 column=(type=long updatewhereclause=yes identity=yes name=orafo_aper_partita_id_partita dbname="orafo_aper_partita.id_partita" dbalias=".id_partita" )
 column=(type=char(16) updatewhereclause=yes name=documento_num_documento dbname="documento.num_documento" dbalias="documento_b.num_documento" )
 column=(type=date updatewhereclause=yes name=documento_data_documento dbname="documento.data_documento" dbalias="documento_b.data_documento" )
 column=(type=decimal(0) updatewhereclause=yes name=riga_documento_num_riga dbname="riga_documento.num_riga" dbalias=".num_riga" )
 column=(type=decimal(4) updatewhereclause=yes name=riga_documento_peso_netto dbname="riga_documento.peso_netto" dbalias=".peso_netto" )
 column=(type=long updatewhereclause=yes identity=yes name=documento_id_documento dbname="documento.id_documento" dbalias="documento_a.id_documento" )
 column=(type=decimal(2) updatewhereclause=yes name=riga_documento_coef_calo dbname="riga_documento.coef_calo" dbalias=".coef_calo" )
 column=(type=decimal(4) updatewhereclause=yes name=riga_documento_calo dbname="riga_documento.calo" dbalias=".calo" )
 column=(type=decimal(4) updatewhereclause=yes name=riga_documento_fino dbname="riga_documento.fino" dbalias=".fino" )
 column=(type=decimal(2) updatewhereclause=yes name=aper_legato dbname="aper_legato" )
 column=(type=char(2) updatewhereclause=yes name=orafo_metallo_codice dbname="orafo_metallo.codice" dbalias=".codice" )
 column=(type=char(1) updatewhereclause=yes name=documento_scarica_ogni_titolo dbname="documento.scarica_ogni_titolo" dbalias="documento_b.scarica_ogni_titolo" )
 retrieve="  SELECT ~"orafo_aper_partita~".~"stato~",   
         ~"orafo_aper_partita~".~"val_apertura~",   
         ~"orafo_aper_partita~".~"val_scarico~",   
         ~"orafo_titolo~".~"titolo~",   
         ~"documento_a~".~"num_documento~",   
         ~"documento_a~".~"data_documento~",   
         ~"caus_magazzino~".~"codice~",   
         ~"orafo_tipo_partita~".~"cod_tipo_partita~",   
         ~"orafo_scar_partita~".~"val_scarico~",   
         ~"orafo_aper_partita~".~"id_partita~",   
         ~"documento_b~".~"num_documento~",   
         ~"documento_b~".~"data_documento~",   
         ~"riga_documento~".~"num_riga~",   
         ~"riga_documento~".~"peso_netto~",   
         ~"documento_a~".~"id_documento~",   
         ~"riga_documento~".~"coef_calo~",   
         ~"riga_documento~".~"calo~",   
         ~"riga_documento~".~"fino~",   
         cast( (select sum(r.peso_netto) from riga_documento r, articolo a, orafo_titolo t where id_documento=~"orafo_aper_partita~".~"id_documento~" 
and t.id_titolo=~"orafo_aper_partita~".~"id_titolo~" and a.id_articolo=r.id_articolo and t.id_titolo=a.id_titolo) as numeric(14,2)) as aper_legato,   
         //cast((select codice from orafo_metallo where id_metallo=orafo_titolo.id_metallo) as char(2)) as aper_met,   
		orafo_metallo.codice,
         ~"documento_b~".~"scarica_ogni_titolo~"  
    FROM {oj ~"orafo_scar_partita~" RIGHT OUTER JOIN ~"orafo_aper_partita~" ON ~"orafo_scar_partita~".~"id_partita~" = ~"orafo_aper_partita~".~"id_partita~"},
 {oj ~"riga_documento~" RIGHT OUTER JOIN ~"orafo_scar_partita~" ON ~"riga_documento~".~"id_riga_partita~" = ~"orafo_scar_partita~".~"id_riga_documento~"}, 
{oj ~"documento~" ~"documento_b~" RIGHT OUTER JOIN ~"riga_documento~" ON ~"documento_b~".~"id_documento~" = ~"riga_documento~".~"id_documento~"},   
         ~"documento~" ~"documento_a~",   
         ~"caus_magazzino~",   
         ~"orafo_tipo_partita~",   
         ~"orafo_titolo~",
~"orafo_metallo~"  
   WHERE ( ~"documento_a~".~"id_documento~" = ~"orafo_aper_partita~".~"id_documento~" ) and  
         ( ~"caus_magazzino~".~"id_caus_magazzino~" = ~"documento_a~".~"id_caus_magazzino~" ) and  
         ( ~"orafo_tipo_partita~".~"id_tipo_partita~" = ~"caus_magazzino~".~"id_tipo_partita~" ) and  
         ( ~"orafo_titolo~".~"id_titolo~" = ~"orafo_aper_partita~".~"id_titolo~" ) and  
         (  ~"documento_a~".~"data_documento~" >= :da_data)  AND  
         ( ~"documento_a~".~"data_documento~" <= :a_data ) AND  
         (  ~"documento_a~".~"id_sog_commerciale~" = :da_sog )    
		and orafo_metallo.id_metallo=orafo_titolo.id_metallo
" arguments=(("da_data", date),("a_data", date),("da_sog", number))  sort="orafo_aper_partita_id_partita A documento_data_documento A documento_num_documento A riga_documento_num_riga A " )
