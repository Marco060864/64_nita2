table(column=(type=char(16) updatewhereclause=yes name=documento_num_bollettina dbname="documento.num_bollettina" dbalias="doc_c.num_bollettina" )
 column=(type=char(16) updatewhereclause=yes name=documento_num_documento dbname="documento.num_documento" dbalias="doc_b.num_documento" )
 column=(type=char(12) updatewhereclause=yes name=galvanica_lavorazione dbname="galvanica.lavorazione" dbalias=".lavorazione" )
 column=(type=char(32766) updatewhereclause=no name=riga_documento_descrizione dbname="riga_documento.descrizione" dbalias=".descrizione" )
 column=(type=char(255) updatewhereclause=yes name=c_des_k dbname="c_des_k" )
 column=(type=decimal(4) updatewhereclause=yes name=riga_documento_quantita dbname="riga_documento.quantita" dbalias=".quantita" )
 column=(type=decimal(4) updatewhereclause=yes name=riga_documento_peso_netto dbname="riga_documento.peso_netto" dbalias=".peso_netto" )
 column=(type=decimal(6) updatewhereclause=yes name=c_peso_medio dbname="c_peso_medio" )
 column=(type=decimal(6) updatewhereclause=yes name=riga_documento_prezzo_manifattura dbname="riga_documento.prezzo_manifattura" dbalias=".prezzo_manifattura" )
 column=(type=decimal(6) updatewhereclause=yes name=riga_documento_prezzo_complessivo dbname="riga_documento.prezzo_complessivo" dbalias=".prezzo_complessivo" )
 column=(type=decimal(6) updatewhereclause=yes name=riga_documento_prezzo_metallo dbname="riga_documento.prezzo_metallo" dbalias=".prezzo_metallo" )
 column=(type=decimal(4) updatewhereclause=yes name=riga_documento_peso_lordo dbname="riga_documento.peso_lordo" dbalias=".peso_lordo" )
 column=(type=long updatewhereclause=yes name=riga_documento_id_articolo dbname="riga_documento.id_articolo" dbalias=".id_articolo" )
 retrieve="SELECT    
		doc_c.num_documento as num_bollettina,
        doc_b.num_documento,
         galvanica.lavorazione,
~"riga_documento~".~"descrizione~",
(select des_2  from dba.prezzo where id_unita_confezione= ~"riga_documento~".~"id_unita_confezione~" and id_variazione=riga_documento.id_listino) as c_des_k,
 ~"riga_documento~".~"quantita~", 
 ~"riga_documento~".~"peso_netto~",   
 (if ~"riga_documento~".~"quantita~">0 then ~"riga_documento~".~"peso_netto~"/~"riga_documento~".~"quantita~" else '0'   end if) as c_peso_medio,
 ~"riga_documento~".~"prezzo_manifattura~", 
           
~"riga_documento~".~"prezzo_complessivo~",
 ~"riga_documento~".~"prezzo_metallo~", 
         ~"riga_documento~".~"peso_lordo~", 
         ~"riga_documento~".~"id_articolo~"
   
           
                      
       
    
FROM 	
			 ~"riga_documento~" LEFT OUTER JOIN ~"articolo~" ON ~"riga_documento~".~"id_articolo~"=~"articolo~".~"id_articolo~",
			 ~"riga_documento~"  LEFT OUTER JOIN ~"riga_documento~" as riga_b  ON ~"riga_documento~".~"id_riga_doc_provenienza~" = riga_b.id_riga_documento,   
 			~"riga_documento~"  LEFT OUTER JOIN ~"riga_documento~" as riga_c  ON riga_b.id_riga_doc_provenienza = riga_c.id_riga_documento,   
            ~"riga_documento~"  LEFT OUTER JOIN ~"galvanica~"  ON ~"riga_documento~".~"id_gruppo_agenti_2~" = galvanica.id_galvanica,  
			 ~"riga_documento~"  LEFT OUTER JOIN ~"documento~" as doc_b  ON riga_b.~"id_documento~" = doc_b.id_documento ,
			~"riga_documento~"  LEFT OUTER JOIN ~"documento~" as doc_c  ON riga_c.~"id_documento~" = doc_c.id_documento ,
			~"riga_documento~"  LEFT OUTER JOIN ~"riga_doc_estensione~"   ON riga_c.~"id_riga_documento~"=~"riga_doc_estensione~".~"id_riga_documento~" ,		
		~"documento~"	

 WHERE ( ~"riga_documento~".~"id_azienda~" in (0,1) ) AND  ~"documento~".id_documento=~"riga_documento~".id_documento and
         
         (~"documento~".~"id_documento~" = :id_doc)    
order by   doc_b.id_documento, riga_doc_estensione.data_ora_modifica, 
			IF riga_documento.provv_subage_2>0 then  riga_documento.provv_subage_2 else 0 end if ,
			 ~"riga_documento~".~"num_riga~"
			" arguments=(("id_doc", number)) )
