footer(height=0 color="536870912" )
detail(height=96 color="553648127" )
table(column=(type=char(4) updatewhereclause=yes name=c_tipo_partita dbname="c_tipo_partita" )
 column=(type=decimal(4) updatewhereclause=yes name=riga_documento_calo dbname="riga_documento.calo" )
 column=(type=decimal(4) updatewhereclause=yes name=riga_documento_fino dbname="riga_documento.fino" )
 column=(type=char(2) updatewhereclause=yes name=orafo_metallo_codice dbname="orafo_metallo.codice" )
 column=(type=decimal(4) updatewhereclause=yes name=resto dbname="resto" )
 column=(type=decimal(2) updatewhereclause=yes name=titolo dbname="orafo_titolo.titolo" )
 retrieve="  SELECT 
cast((select t.cod_tipo_partita from orafo_tipo_partita t, orafo_aper_partita a
where a.id_titolo=~"orafo_titolo~".~"id_titolo~" and a.id_documento=~"documento~".~"id_documento~"
and a.id_tipo_partita=t.id_tipo_partita) as char(4)) as c_tipo_partita,
  
         ~"riga_documento~".~"calo~",   
         ~"riga_documento~".~"fino~",   
         ~"orafo_metallo~".~"codice~" , 
cast((select sum(resto) from orafo_scar_partita
			where id_riga_documento= ~"riga_documento~".~"id_riga_partita~") 
			as numeric(5,4)) as resto,
			~"orafo_titolo~".~"titolo~"
    FROM  
         ~"documento~",   
         ~"riga_documento~",   
   
         ~"articolo~",   
         ~"orafo_metallo~",   
         ~"orafo_titolo~"  
   WHERE ( ~"riga_documento~".~"id_documento~" = ~"documento~".~"id_documento~" ) and  
    
        
         ( ~"articolo~".~"id_articolo~" = ~"riga_documento~".~"id_articolo~" ) and  
         ( ~"orafo_titolo~".~"id_metallo~" = ~"orafo_metallo~".~"id_metallo~" ) and  
         ( ~"orafo_titolo~".~"id_titolo~" = ~"articolo~".~"id_titolo~" ) and 
			( ( ~"documento~".~"data_ora_creazione~" > :da_data ) AND  
         ( ~"documento~".~"data_ora_creazione~" <= :a_data ) AND  
         ( ~"documento~".~"id_sog_commerciale~" = :a_sog ) ) 
" arguments=(("da_data", datetime),("a_data", datetime),("a_sog", number))  sort="orafo_metallo_codice A right(c_tipo_partita,3) A titolo A " )
group(level=1 header.height=4 trailer.height=108 by=("orafo_metallo_codice" , "right(c_tipo_partita, 3)" , "titolo" ) header.color="536870912" trailer.color="536870912" )
