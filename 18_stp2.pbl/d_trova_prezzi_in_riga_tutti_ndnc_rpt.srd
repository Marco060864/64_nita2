table(column=(type=long updatewhereclause=yes identity=yes name=documento_id_documento dbname="documento.id_documento" dbalias=".id_documento" )
 column=(type=decimal(0) updatewhereclause=yes name=documento_num_progressivo dbname="documento.num_progressivo" dbalias=".num_progressivo" )
 column=(type=date updatewhereclause=yes name=documento_data_registrazione dbname="documento.data_registrazione" dbalias=".data_registrazione" )
 column=(type=char(16) updatewhereclause=yes name=documento_num_documento dbname="documento.num_documento" dbalias=".num_documento" )
 column=(type=date updatewhereclause=yes name=documento_data_documento dbname="documento.data_documento" dbalias=".data_documento" )
 column=(type=long updatewhereclause=yes identity=yes name=id_riga_documento dbname="riga_documento.id_riga_documento" dbalias=".id_riga_documento" )
 column=(type=decimal(0) updatewhereclause=yes name=riga_documento_num_riga dbname="riga_documento.num_riga" dbalias=".num_riga" )
 column=(type=decimal(4) updatewhereclause=yes name=riga_documento_quantita dbname="riga_documento.quantita" dbalias=".quantita" )
 column=(type=decimal(6) updatewhereclause=yes name=riga_documento_prezzo dbname="riga_documento.prezzo" dbalias=".prezzo" )
 column=(type=decimal(4) updatewhereclause=yes name=riga_documento_peso_netto dbname="riga_documento.peso_netto" dbalias=".peso_netto" )
 column=(type=decimal(6) updatewhereclause=yes name=riga_documento_prezzo_manifattura dbname="riga_documento.prezzo_manifattura" dbalias=".prezzo_manifattura" )
 column=(type=char(64) updatewhereclause=yes name=articolo_codice dbname="articolo.codice" dbalias=".codice" )
 column=(type=long updatewhereclause=yes identity=yes name=articolo_id_articolo dbname="articolo.id_articolo" dbalias=".id_articolo" )
 column=(type=char(32766) updatewhereclause=no name=riga_documento_descrizione dbname="riga_documento.descrizione" dbalias=".descrizione" )
 column=(type=char(2) updatewhereclause=yes name=registro_tipo_registro dbname="registro.tipo_registro" dbalias=".tipo_registro" )
 column=(type=char(1) updatewhereclause=yes name=sog_commerciale_tipo dbname="sog_commerciale.tipo" dbalias=".tipo" values="	C/	N" )
 column=(type=char(8) updatewhereclause=yes name=prof_documento_codice dbname="prof_documento.codice" dbalias=".codice" )
 column=(type=long updatewhereclause=yes name=c_nd dbname="c_nd" values="	1/	0" )
 column=(type=long updatewhereclause=yes name=c_nc dbname="c_nc" values="	1/	0" )
 column=(type=decimal(0) update=yes updatewhereclause=yes name=num_colli dbname="riga_documento.num_colli" dbalias=".num_colli" )
 column=(type=decimal(6) updatewhereclause=yes name=prezzo dbname="prezzo.prezzo" dbalias=".prezzo" )
 column=(type=long updatewhereclause=yes name=riga_documento_id_riga_doc_provenienza dbname="riga_documento.id_riga_doc_provenienza" dbalias=".id_riga_doc_provenienza" )
 column=(type=long updatewhereclause=yes name=c_vedi dbname="c_vedi" values="	1/	0" )
 column=(type=decimal(6) updatewhereclause=yes name=riga_documento_prezzo_complessivo dbname="riga_documento.prezzo_complessivo" dbalias=".prezzo_complessivo" )
 retrieve="  SELECT ~"documento~".~"id_documento~",   
         ~"documento~".~"num_progressivo~",   
         ~"documento~".~"data_registrazione~",   
         ~"documento~".~"num_documento~",   
         ~"documento~".~"data_documento~",   
         ~"riga_documento~".~"id_riga_documento~",   
         ~"riga_documento~".~"num_riga~",   
         ~"riga_documento~".~"quantita~",   
         ~"riga_documento~".~"prezzo~",   
         ~"riga_documento~".~"peso_netto~",   
         ~"riga_documento~".~"prezzo_manifattura~",   
         ~"articolo~".~"codice~",   
         ~"articolo~".~"id_articolo~",   
         ~"riga_documento~".~"descrizione~",   
         ~"registro~".~"tipo_registro~",   
         ~"sog_commerciale~".~"tipo~",   
         ~"prof_documento~".~"codice~",   
         (case ~"riga_documento~".~"num_colli~" when 101 then 2 else 0 end case) as c_nd,   
         (case ~"riga_documento~".~"num_colli~" when 100 then 2 else 0 end case) as c_nc,   
         ~"riga_documento~".~"num_colli~",   
         ~"prezzo~".~"prezzo~",   
         ~"riga_documento~".~"id_riga_doc_provenienza~",   
         0 as c_vedi,   
         ~"riga_documento~".~"prezzo_complessivo~"  
    FROM {oj ~"riga_documento~" LEFT OUTER JOIN ~"prezzo~" ON ~"riga_documento~".~"id_unita_confezione~" = ~"prezzo~".~"id_unita_confezione~"},   
         ~"articolo~",   
         ~"documento~",   
         ~"registro~",   
         ~"sog_commerciale~",   
         ~"prof_documento~"  
   WHERE ( ~"riga_documento~".~"id_documento~" = ~"documento~".~"id_documento~" ) and  
         ( ~"riga_documento~".~"id_articolo~" = ~"articolo~".~"id_articolo~" ) and  
         ( ~"documento~".~"id_registro~" = ~"registro~".~"id_registro~" ) and  
         ( ~"documento~".~"id_sog_commerciale~" = ~"sog_commerciale~".~"id_sog_commerciale~" ) and  
         ( ~"documento~".~"id_prof_documento~" = ~"prof_documento~".~"id_prof_documento~" ) and  

		( (~"registro~".~"tipo_registro~"='IV' and (~"documento~".~"id_prof_documento~"=54 or  ~"documento~".~"id_prof_documento~"=158 or    ~"documento~".~"id_prof_documento~"=182  or  ~"documento~".~"id_prof_documento~"=183 )
 or (~"documento~".~"id_prof_documento~"=47 and ~"riga_documento~".~"num_colli~">99) 
		or (~"documento~".~"id_prof_documento~"=136 and ~"riga_documento~".~"num_colli~">99) ))

//and  (( ~"documento~".~"data_documento~">= 20241101 and (~"documento~".~"id_prof_documento~"=54 or  ~"documento~".~"id_prof_documento~"=158  ) or
//  ~"documento~".~"data_documento~">= 20240101 and  ~"documento~".~"id_prof_documento~"<>54 and  ~"documento~".~"id_prof_documento~"<>158  ))

       and  ( ~"prezzo~".~"id_variazione~" = 15 )     
"  sort="documento_data_documento A c_ordina D prof_documento_codice A " )
