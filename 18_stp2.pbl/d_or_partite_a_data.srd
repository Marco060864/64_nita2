 column=(type=decimal(4) updatewhereclause=yes name=orafo_aper_partita_val_scarico dbname="orafo_aper_partita.val_scarico" )
 column=(type=char(16) updatewhereclause=yes name=documento_num_documento dbname="documento.num_documento" )
 column=(type=date updatewhereclause=yes name=data_carico_1 dbname="documento.data_carico" )
 column=(type=long updatewhereclause=yes name=orafo_aper_partita_id_partita dbname="orafo_aper_partita.id_partita" )
 column=(type=long updatewhereclause=yes name=documento_id_sog_commerciale dbname="documento.id_sog_commerciale" )
 column=(type=decimal(4) updatewhereclause=yes name=orafo_aper_partita_val_scarico dbname="orafo_aper_partita.val_scarico" )
 retrieve="select sum(s.val_scarico) as c_sum_scarichi , d.num_documento, d.data_documento, a.val_apertura, a.val_scarico, d2.num_documento,
 d2.data_documento as data_carico,a.id_partita, d.id_sog_commerciale, a.val_scarico
from orafo_scar_partita s, riga_documento r, documento d, orafo_aper_partita a, orafo_titolo t,
documento d2
where s.id_riga_documento= r.id_riga_partita
and d2.id_documento=a.id_documento
and r.id_documento=d.id_documento
and a.id_partita=s.id_partita
and d.data_documento>=:da_data	
and d.data_documento<=:a_data
and t.id_titolo=a.id_titolo and t.id_metallo=:id_metallo
and d.id_sog_commerciale=:id_sog_comm
and d.id_caus_magazzino=:id_caus_scarico
group by (d.num_documento, d.data_documento, a.val_apertura, a.val_scarico, d2.num_documento, d2.data_documento, a.id_partita,
			d.id_sog_commerciale, a.val_scarico)
order by d.data_documento" arguments=(("da_data", date),("a_data", date),("id_metallo", number),("id_sog_comm", number),("id_caus_scarico", number))  sort="data_carico_1 A orafo_aper_partita_id_partita A documento_data_documento A documento_num_documento A " )
