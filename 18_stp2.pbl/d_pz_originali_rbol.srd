table(column=(type=long updatewhereclause=yes identity=yes name=documento_id_documento dbname="documento.id_documento" )
 column=(type=char(16) updatewhereclause=yes name=num_documento dbname="documento.num_documento" )
 column=(type=date updatewhereclause=yes name=data_documento dbname="documento.data_documento" )
 column=(type=decimal(4) updatewhereclause=yes name=riga_documento_quantita dbname="riga_documento.quantita" )
 column=(type=decimal(4) updatewhereclause=yes name=qta_rbol dbname="riga_documento.quantita" )
 column=(type=decimal(0) updatewhereclause=yes name=qta_originale dbname="bollettine_excel.pezzi" )
 column=(type=long updatewhereclause=yes name=id_articolo dbname="riga_documento.id_articolo" )
 column=(type=char(40) updatewhereclause=yes name=c_id_fornitore dbname="c_id_fornitore" )
 column=(type=decimal(4) updatewhereclause=yes name=qta_sald dbname="qta_sald" )
 column=(type=decimal(4) updatewhereclause=yes name=peso_sald dbname="peso_sald" )
 column=(type=decimal(4) updatewhereclause=yes name=peso_rbol dbname="riga_documento.peso_rbol" )
 column=(type=date updatewhereclause=yes name=data_sald dbname="data_sald" )
 column=(type=decimal(4) updatewhereclause=yes name=dim_l dbname="riga_documento.dim_l" )
 retrieve="  SELECT ~"documento~".~"id_documento~",   
         ~"documento~".~"num_documento~",   
         ~"documento~".~"data_documento~",   
         ~"riga_documento_a~".~"quantita~",   
         ~"riga_documento_b~".~"quantita~",   
         ~"bollettine_excel~".~"pezzi~",   
         ~"riga_documento_a~".~"id_articolo~",   
         (select first(rag_soc_1) from sog_commerciale_gen s, documento d, riga_documento r where d.id_sog_commerciale=s.id_sog_commerciale and r.id_documento=d.id_documento and r.provv_imp_subage_2=riga_documento_a.id_riga_documento 
and (d.id_prof_documento=130 or d.id_prof_documento=196 or d.id_prof_documento=204 or d.id_prof_documento=228) order by id_riga_documento desc ) as c_id_fornitore ,

 (select first(r.quantita ) from  documento d, riga_documento r where  r.id_documento=d.id_documento and r.provv_imp_subage_2=riga_documento_a.id_riga_documento 
and (d.id_prof_documento=130 or d.id_prof_documento=196 or d.id_prof_documento=204 or d.id_prof_documento=228) order by id_riga_documento desc ) as qta_sald ,


(select first(r.peso_netto) from documento d, riga_documento r where  r.id_documento=d.id_documento and r.provv_imp_subage_2=riga_documento_a.id_riga_documento 
and (d.id_prof_documento=130 or d.id_prof_documento=196 or d.id_prof_documento=204 or d.id_prof_documento=228) order by id_riga_documento desc ) as peso_sald, 
~"riga_documento_b~".~"peso_netto~" as peso_rbol, 
(select first(d.data_documento) from documento d, riga_documento r where r.id_documento=d.id_documento and r.provv_imp_subage_2=riga_documento_a.id_riga_documento 
and (d.id_prof_documento=130 or d.id_prof_documento=196 or d.id_prof_documento=204 or d.id_prof_documento=228) order by id_riga_documento desc ) as data_sald ,
  ~"riga_documento_a~".~"dim_l~"
  
  FROM {oj ~"riga_documento~" ~"riga_documento_a~" LEFT OUTER JOIN ~"riga_documento~" ~"riga_documento_b~" ON ~"riga_documento_a~".~"id_riga_documento~" = ~"riga_documento_b~".~"id_riga_doc_provenienza~" 
LEFT OUTER JOIN ~"bollettine_excel~" ON ~"riga_documento_a~".~"id_riga_documento~" = ~"bollettine_excel~".~"id_riga_documento~"},   
         ~"documento~"  
   WHERE ( ~"riga_documento_a~".~"id_documento~" = ~"documento~".~"id_documento~" ) and  
	
         ( ( ~"documento~".~"data_documento~" >= :da_data ) AND  
         ( ~"documento~".~"data_documento~" <= :a_data ) AND  
         ( ~"documento~".~"num_documento~" like '%-%' ) )    
" arguments=(("da_data", date),("a_data", date))  sort="data_documento A num_documento A " )
