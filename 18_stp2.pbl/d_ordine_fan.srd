 column=(type=char(16) updatewhereclause=yes name=num_documento dbname="num_documento" )
 column=(type=date updatewhereclause=yes name=data_documento dbname="data_documento" )
 column=(type=date updatewhereclause=yes name=data_prev_consegna dbname="data_prev_consegna" )
 column=(type=char(32766) updatewhereclause=no name=note_intestazione dbname="note_intestazione" )
 column=(type=char(20) updatewhereclause=yes name=bollo dbname="bollo" )
 column=(type=char(40) updatewhereclause=yes name=rag_soc_1 dbname="rag_soc_1" )
 column=(type=char(40) updatewhereclause=yes name=indirizzo dbname="indirizzo" )
 column=(type=char(40) updatewhereclause=yes name=localita dbname="localita" )
 column=(type=char(10) updatewhereclause=yes name=cap dbname="cap" )
 column=(type=char(5) updatewhereclause=yes name=provincia dbname="provincia" )
 column=(type=char(5) updatewhereclause=yes name=nazione dbname="nazione" )
 column=(type=char(40) updatewhereclause=yes name=az_rag_1 dbname="az_rag_1" )
 column=(type=char(40) updatewhereclause=yes name=rag_soc_2 dbname="rag_soc_2" )
 column=(type=char(20) updatewhereclause=yes name=bollo dbname="bollo" )
 column=(type=long updatewhereclause=yes name=id_valuta dbname="id_valuta" )
 column=(type=decimal(4) updatewhereclause=yes name=prezzo_complessivo dbname="prezzo_complessivo" )
 retrieve="SELECT
    articolo.~"codice~",
    riga_documento.~"descrizione~", riga_documento.~"quantita~", riga_documento.~"peso_netto~",
 riga_documento.~"dim_l~", riga_documento.~"coef_calo~", riga_documento.~"fino~", riga_documento.~"prezzo_manifattura~",
riga_documento.~"calo~",
    documento.~"id_documento~", documento.~"num_documento~", documento.~"data_documento~", documento.~"data_prev_consegna~", documento.~"note_intestazione~", documento.~"bollo~",
    sog_commerciale_gen.~"rag_soc_1~", sede.indirizzo, sede.localita, sede.cap, sede.provincia, 
	sede.nazione, azienda.rag_soc_1 as az_rag_1, azienda.rag_soc_2, documento.~"bollo~",
documento.~"id_valuta~", riga_documento.prezzo_complessivo
FROM
    ~"DBA~".~"riga_documento~" riga_documento LEFT OUTER JOIN ~"DBA~".~"articolo~" articolo ON
         riga_documento.~"id_articolo~"=articolo.~"id_articolo~",
    ~"DBA~".~"documento~" documento,
    ~"DBA~".~"sog_commerciale_gen~" sog_commerciale_gen ,
azienda, sede
WHERE
    riga_documento.~"id_documento~" = documento.~"id_documento~" AND
    documento.~"id_sog_commerciale~" = sog_commerciale_gen.~"id_sog_commerciale~" and
documento.id_azienda=azienda.id_azienda and sede.id_azienda=azienda.id_azienda
and documento.id_documento=:rn_id_doc" arguments=(("rn_id_doc", number)) )
