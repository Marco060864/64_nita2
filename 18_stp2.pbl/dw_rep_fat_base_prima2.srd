 retrieve="  SELECT  ~"riga_documento_a~".~"descrizione~" ,           ~"riga_documento_a~".~"quantita~" ,           ~"riga_documento_a~".~"peso_netto~" ,           ~"riga_documento_a~".~"coef_calo~" ,           ~"riga_documento_a~".~"prezzo_manifattura~" ,           ~"riga_documento_a~".~"importo_manifattura_val~" ,           ~"articolo~".~"codice~" ,           ~"documento_a~".~"id_documento~" ,           ~"documento_a~".~"num_documento~" ,           ~"documento_a~".~"data_documento~" ,           ~"documento_b~".~"num_documento~" ,           ~"documento_b~".~"data_documento~" ,           ~"sog_commerciale_gen~".~"rag_soc_1~" ,           ~"sog_commerciale_gen~".~"rag_soc_2~" ,           ~"sog_commerciale_gen~".~"indirizzo~" ,           ~"sog_commerciale_gen~".~"cap~" ,           ~"sog_commerciale_gen~".~"localita~" ,           ~"sog_commerciale_gen~".~"provincia~" ,           ~"sog_commerciale_gen~".~"nazione~" ,           ~"sog_commerciale_gen~".~"par_iva~" ,           ~"prof_documento~".~"des_stampa~" ,           ~"con_pagamento~".~"descrizione~" ,           ~"orafo_titolo~".~"titolo~" ,           ~"banca_appoggio~".~"den_abi~" ,           ~"banca_appoggio~".~"den_cab~" ,           ~"orafo_metallo~".~"codice~" ,           ~"riga_documento_a~".~"tot_riga_val_riga~" ,           ~"riga_documento_b~".~"id_documento~" ,           ~"riga_documento_a~".~"num_riga~"  , ~"orafo_metallo~".~"cod_int_met~"
        FROM {oj {oj {oj {oj ~"documento~" documento_a  LEFT OUTER JOIN ~"riga_documento~" riga_documento_a  ON ~"documento_a~".~"id_documento~" = ~"riga_documento_a~".~"id_documento~"} LEFT OUTER JOIN ~"banca_sog_commerciale~"  ON ~"documento_a~".~"id_banca_sog_commerciale~" = ~"banca_sog_commerciale~".~"id_banca_sog_commerciale~"}, {oj ~"riga_documento~" riga_documento_a  LEFT OUTER JOIN ~"articolo~"  ON ~"riga_documento_a~".~"id_articolo~" = ~"articolo~".~"id_articolo~"} LEFT OUTER JOIN ~"orafo_titolo~"  ON ~"articolo~".~"id_titolo~" = ~"orafo_titolo~".~"id_titolo~"}, {oj ~"documento~" documento_a  LEFT OUTER JOIN ~"con_pagamento~"  ON ~"documento_a~".~"id_con_pagamento~" = ~"con_pagamento~".~"id_con_pagamento~"}, {oj ~"riga_documento~" riga_documento_a  LEFT OUTER JOIN ~"riga_documento~" riga_documento_b  ON ~"riga_documento_a~".~"id_riga_doc_provenienza~" = ~"riga_documento_b~".~"id_riga_documento~"} LEFT OUTER JOIN ~"documento~" documento_b  ON ~"riga_documento_b~".~"id_documento~" = ~"documento_b~".~"id_documento~"}, {oj ~"banca_sog_commerciale~"  LEFT OUTER JOIN ~"banca_appoggio~"  ON ~"banca_sog_commerciale~".~"id_banca_appoggio~" = ~"banca_appoggio~".~"id_banca_appoggio~"}, {oj ~"orafo_titolo~"  LEFT OUTER JOIN ~"orafo_metallo~"  ON ~"orafo_titolo~".~"id_metallo~" = ~"orafo_metallo~".~"id_metallo~"} ,           ~"sog_commerciale_gen~" ,           ~"prof_documento~"    
        WHERE ( ~"sog_commerciale_gen~".~"id_sog_commerciale~" = ~"documento_a~".~"id_sog_commerciale~" ) and          ( ~"prof_documento~".~"id_prof_documento~" = ~"documento_a~".~"id_prof_documento~" ) and          ( ( ~"documento_a~".~"id_documento~" = :rn_id_doc ) )  " arguments=(("rn_id_doc", number))  sort="num_riga A id_doc_prov A " )
