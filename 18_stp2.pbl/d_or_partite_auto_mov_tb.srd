table(column=(type=long updatewhereclause=yes identity=yes name=caus_magazzino_id_caus_magazzino dbname="caus_magazzino.id_caus_magazzino" dbalias=".id_caus_magazzino" )
 column=(type=char(4) updatewhereclause=yes name=orafo_tipo_partita_cod_tipo_partita dbname="orafo_tipo_partita.cod_tipo_partita" dbalias=".cod_tipo_partita" )
 column=(type=decimal(4) updatewhereclause=yes name=riga_documento_peso_netto dbname="riga_documento.peso_netto" dbalias=".peso_netto" )
 column=(type=decimal(4) updatewhereclause=yes name=riga_documento_calo dbname="riga_documento.calo" dbalias=".calo" )
 column=(type=decimal(4) updatewhereclause=yes name=riga_documento_fino dbname="riga_documento.fino" dbalias=".fino" )
 column=(type=char(2) updatewhereclause=yes name=orafo_metallo_codice dbname="orafo_metallo.codice" dbalias=".codice" )
 column=(type=char(8) updatewhereclause=yes name=sog_commerciale_gen_codice dbname="sog_commerciale_gen.codice" dbalias=".codice" )
 column=(type=decimal(5) updatewhereclause=yes name=resto dbname="resto" )
 column=(type=decimal(2) updatewhereclause=yes name=riga_documento_coef_calo dbname="riga_documento.coef_calo" dbalias=".coef_calo" )
 column=(type=date updatewhereclause=yes name=data_documento dbname="documento.data_documento" dbalias=".data_documento" )
 column=(type=char(16) updatewhereclause=yes name=num_documento dbname="documento.num_documento" dbalias=".num_documento" )
 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"caus_magazzino~" )  TABLE(NAME=~"documento~" )  TABLE(NAME=~"riga_documento~" )  TABLE(NAME=~"sog_commerciale_gen~" )  TABLE(NAME=~"orafo_tipo_partita~" )  TABLE(NAME=~"articolo~" )  TABLE(NAME=~"orafo_metallo~" )  TABLE(NAME=~"orafo_titolo~" ) COLUMN(NAME=~"caus_magazzino.id_caus_magazzino~") COLUMN(NAME=~"orafo_tipo_partita.cod_tipo_partita~") COLUMN(NAME=~"riga_documento.peso_netto~") COLUMN(NAME=~"riga_documento.calo~") COLUMN(NAME=~"riga_documento.fino~") COLUMN(NAME=~"orafo_metallo.codice~") COLUMN(NAME=~"sog_commerciale_gen.codice~") COMPUTE(NAME=~"cast((select resto from orafo_scar_partita s where s.id_riga_documento=~~~"riga_documento~~~".~~~"id_riga_partita~~~" and resto<>0) as numeric(6,5)) as resto~") COLUMN(NAME=~"riga_documento.coef_calo~") COLUMN(NAME=~"documento.data_documento~") COLUMN(NAME=~"documento.num_documento~")    JOIN (LEFT=~"riga_documento.id_documento~"    OP =~"=~"RIGHT=~"documento.id_documento~" )    JOIN (LEFT=~"riga_documento.id_caus_magazzino~"    OP =~"=~"RIGHT=~"caus_magazzino.id_caus_magazzino~" )    JOIN (LEFT=~"documento.id_sog_commerciale~"    OP =~"=~"RIGHT=~"sog_commerciale_gen.id_sog_commerciale~" )    JOIN (LEFT=~"orafo_tipo_partita.id_tipo_partita~"    OP =~"=~"RIGHT=~"caus_magazzino.id_tipo_partita~" )    JOIN (LEFT=~"articolo.id_articolo~"    OP =~"=~"RIGHT=~"riga_documento.id_articolo~" )    JOIN (LEFT=~"orafo_titolo.id_metallo~"    OP =~"=~"RIGHT=~"orafo_metallo.id_metallo~" )    JOIN (LEFT=~"orafo_titolo.id_titolo~"    OP =~"=~"RIGHT=~"articolo.id_titolo~" )WHERE(    EXP1 =~"~~~"documento~~~".~~~"data_documento~~~"~"   OP =~">=~"    EXP2 =~":da_data~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"documento~~~".~~~"data_documento~~~"~"   OP =~"<=~"    EXP2 =~":a_data~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"sog_commerciale_gen~~~".~~~"codice~~~"~"   OP =~">=~"    EXP2 =~":da_sog~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"sog_commerciale_gen~~~".~~~"codice~~~"~"   OP =~"<=~"    EXP2 =~":a_sog~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"right( orafo_tipo_partita.cod_tipo_partita , 3)~"   OP =~"=~"    EXP2 =~":tipo_pertita~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"orafo_metallo~~~".~~~"codice~~~"~"   OP =~"=~"    EXP2 =~":metallo~" ) ) ARG(NAME = ~"da_data~" TYPE = date)  ARG(NAME = ~"a_data~" TYPE = date)  ARG(NAME = ~"da_sog~" TYPE = string)  ARG(NAME = ~"a_sog~" TYPE = string)  ARG(NAME = ~"tipo_pertita~" TYPE = string)  ARG(NAME = ~"metallo~" TYPE = string) " arguments=(("da_data", date),("a_data", date),("da_sog", string),("a_sog", string),("tipo_pertita", string),("metallo", string))  sort="data_documento A orafo_metallo_codice A sog_commerciale_gen_codice A right(orafo_tipo_partita_cod_tipo_partita, 3) A " )
