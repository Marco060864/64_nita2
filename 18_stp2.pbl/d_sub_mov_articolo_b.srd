 retrieve="  SELECT ~"riga_documento~".~"id_riga_documento~",   
         ~"riga_documento~".~"id_documento~",   
         ~"riga_documento~".~"id_articolo~",   
         ~"articolo~".~"codice~",   
         ~"articolo~".~"descrizione~",   
         ~"riga_documento~".~"quantita~",   
         ~"riga_documento~".~"qta_un_base~",   
         ~"riga_documento~".~"id_locazione_1~",   
         ~"riga_documento~".~"prezzo~",   
         ~"riga_documento~".~"peso_netto~",   
         ~"riga_documento~".~"dim_l~",   
         ~"riga_documento~".~"tot_riga_val_riga~",   
         ~"riga_documento~".~"calo~",   
         ~"riga_documento~".~"coef_calo~",   
         ~"riga_documento~".~"fino~",   
         ~"riga_documento~".~"prezzo_metallo~",   
         ~"riga_documento~".~"prezzo_manifattura~",   
         ~"riga_documento~".~"prezzo_complessivo~",   
         ~"riga_documento~".~"peso_non_prezioso~",   
         ~"riga_documento~".~"importo_manifattura_val~",   
         ~"documento~".~"num_documento~", 
~"documento~".~"num_progressivo~",  
         ~"documento~".~"data_documento~",   
         ~"sog_commerciale_gen~".~"rag_soc_1~",   
         ~"sog_commerciale_gen~".~"codice~",   
         ~"caus_magazzino~".~"segno~",   
         ~"orafo_titolo~".~"titolo~",   
         ~"orafo_metallo~".~"codice~",   
         ~"caus_magazzino~".~"codice~",   
         ~"azienda~".~"rag_soc_1~",   
         ~"riga_documento~".~"importo_manifattura~",   
         ~"caus_magazzino~".~"segno_lire~",   
         ~"riga_documento~".~"num_riga~",   
         ~"riga_documento~".~"tot_riga_val_az~",   
         ~"caus_magazzino~".~"saldi_cl_fino~",   
         ~"caus_magazzino~".~"saldi_cl_lire~",   
         ~"documento~".~"id_valuta~",   
         ~"unita_confezione~".~"id_unita_misura~",   
         ~"unita_misura~".~"tipo~"  ,
~"caus_magazzino~".~"descrizione~",
~"documento~".~"note_intestazione~" 
    FROM ~"riga_documento~",   
         ~"caus_magazzino~",   
         ~"documento~",   
         ~"sog_commerciale_gen~",   
         ~"articolo~",   
         ~"orafo_metallo~",   
         ~"orafo_titolo~",   
         ~"azienda~",   
         ~"unita_confezione~",   
         ~"unita_misura~"  
   WHERE ( ~"caus_magazzino~".~"id_caus_magazzino~" = ~"riga_documento~".~"id_caus_magazzino~" ) and  
         ( ~"documento~".~"id_documento~" = ~"riga_documento~".~"id_documento~" ) and  
         ( ~"documento~".~"id_sog_commerciale~" = ~"sog_commerciale_gen~".~"id_sog_commerciale~" ) and  
         ( ~"articolo~".~"id_articolo~" = ~"riga_documento~".~"id_articolo~" ) and  
         ( ~"orafo_titolo~".~"id_metallo~" = ~"orafo_metallo~".~"id_metallo~" ) and  
         ( ~"orafo_titolo~".~"id_titolo~" = ~"articolo~".~"id_titolo~" ) and  
         ( ~"azienda~".~"id_azienda~" = ~"documento~".~"id_azienda~" ) and  
         ( ~"unita_confezione~".~"id_unita_confezione~" = ~"riga_documento~".~"id_unita_confezione~" ) and  
         ( ~"unita_misura~".~"id_unita_misura~" = ~"unita_confezione~".~"id_unita_misura~" ) and  
         (~"documento~".~"data_documento~" >= :data_inizio_es AND  
         ~"documento~".~"data_documento~" <= :a_data) AND  
         (~"articolo~".~"codice~" >= :da_cod AND  
         ~"articolo~".~"codice~" <= :a_cod)    
" arguments=(("da_cod", string),("a_cod", string),("da_data", date),("a_data", date),("data_inizio_es", date),("filtro", string))  sort="orafo_metallo_codice A articolo_codice A documento_data_documento A documento_num_progressivo A documento_num_documento A riga_documento_id_documento A num_riga A " )
