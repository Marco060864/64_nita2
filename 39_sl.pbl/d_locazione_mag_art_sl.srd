table(column=(type=long updatewhereclause=yes identity=yes name=locazione_id_locazione dbname="locazione.id_locazione" )
 column=(type=long updatewhereclause=yes name=locazione_id_magazzino dbname="locazione.id_magazzino" )
 column=(type=long updatewhereclause=yes name=locazione_id_area dbname="locazione.id_area" )
 column=(type=char(8) updatewhereclause=yes name=magazzino_codice dbname="magazzino.codice" )
 column=(type=char(40) updatewhereclause=yes name=magazzino_descrizione dbname="magazzino.descrizione" )
 column=(type=char(4) updatewhereclause=yes name=area_codice dbname="area.codice" )
 column=(type=char(40) updatewhereclause=yes name=area_descrizione dbname="area.descrizione" )
 column=(type=char(5) updatewhereclause=yes name=locazione_corsia dbname="locazione.corsia" )
 column=(type=char(5) updatewhereclause=yes name=locazione_scaffale dbname="locazione.scaffale" )
 column=(type=char(5) updatewhereclause=yes name=locazione_ripiano dbname="locazione.ripiano" )
 column=(type=char(5) updatewhereclause=yes name=locazione_posizione dbname="locazione.posizione" )
 column=(type=long updatewhereclause=yes name=locazione_id_azienda dbname="locazione.id_azienda" )
 column=(type=char(90) updatewhereclause=yes name=c_locazione_mag dbname="c_locazione_mag" )
 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"locazione~" )  TABLE(NAME=~"area~" )  TABLE(NAME=~"magazzino~" ) COLUMN(NAME=~"locazione.id_locazione~") COLUMN(NAME=~"locazione.id_magazzino~") COLUMN(NAME=~"locazione.id_area~") COLUMN(NAME=~"magazzino.codice~") COLUMN(NAME=~"magazzino.descrizione~") COLUMN(NAME=~"area.codice~") COLUMN(NAME=~"area.descrizione~") COLUMN(NAME=~"locazione.corsia~") COLUMN(NAME=~"locazione.scaffale~") COLUMN(NAME=~"locazione.ripiano~") COLUMN(NAME=~"locazione.posizione~") COLUMN(NAME=~"locazione.id_azienda~") COMPUTE(NAME=~"~~~"magazzino~~~".~~~"descrizione~~~" + ' (' + ~~~"magazzino~~~".~~~"codice~~~" + ') - ' + ~~~"area~~~".~~~"codice~~~" + ' - ' + ~~~"locazione~~~".~~~"corsia~~~" + ' - ' + ~~~"locazione~~~".~~~"scaffale~~~" + ' - ' + ~~~"locazione~~~".~~~"ripiano~~~" + ' - ' + ~~~"locazione~~~".~~~"posizione~~~" As c_locazione_mag~")    JOIN (LEFT=~"locazione.id_area~"    OP =~"=~"RIGHT=~"area.id_area~"    OUTER1 =~"locazione.id_area~" )    JOIN (LEFT=~"magazzino.id_magazzino~"    OP =~"=~"RIGHT=~"locazione.id_magazzino~" )WHERE(    EXP1 =~"~~~"locazione~~~".~~~"id_azienda~~~"~"   OP =~"in~"    EXP2 =~"(0,1)~" ) ) ORDER(NAME=~"13~" ASC=yes ) " )
