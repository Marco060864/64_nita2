table(column=(type=long update=yes updatewhereclause=yes identity=yes name=id_tributo dbname="tributo.id_tributo" )
 column=(type=char(8) update=yes updatewhereclause=yes key=yes name=codice dbname="tributo.codice" )
 column=(type=char(4) update=yes updatewhereclause=yes name=cod_tributo dbname="tributo.cod_tributo" )
