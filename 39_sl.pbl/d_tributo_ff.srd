 column=(type=char(10) update=yes updatewhereclause=yes name=mod_fiscale dbname="tributo.mod_fiscale" )
 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"tributo~" ) COLUMN(NAME=~"tributo.id_tributo~") COLUMN(NAME=~"tributo.codice~") COLUMN(NAME=~"tributo.cod_tributo~") COLUMN(NAME=~"tributo.descrizione~") COLUMN(NAME=~"tributo.gruppo~") COLUMN(NAME=~"tributo.per_imponibile~") COLUMN(NAME=~"tributo.per_tributo~") COLUMN(NAME=~"tributo.inizio_per_validita~") COLUMN(NAME=~"tributo.fine_per_validita~") COLUMN(NAME=~"tributo.mod_fiscale~")) " update="tributo" updatewhere=1 updatekeyinplace=no )
