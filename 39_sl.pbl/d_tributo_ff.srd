 column=(type=decimal(2) update=yes updatewhereclause=yes name=per_imponibile dbname="tributo.per_imponibile" validation=" real(gettext())  >= 0 AND  real(gettext())  <= 100" validationmsg="'Immettere un valore fra 0 e 100'" )
 column=(type=decimal(2) update=yes updatewhereclause=yes name=per_tributo dbname="tributo.per_tributo" validation=" real(gettext())  >= 0 AND  real(gettext())  <= 100" validationmsg="'Immettere un valore fra 0 e 100'" )
