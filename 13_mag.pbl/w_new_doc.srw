tab_1.tabpage_2.ddlb_prezzi.selectitem(1)
tab_1.tabpage_2.ddlb_riga.selectitem(1)
tab_1.tabpage_2.ddlb_boll.selectitem(1)
tab_1.tabpage_2.ddlb_vedi.selectitem(1)

