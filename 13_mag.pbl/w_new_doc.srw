if isvalid(ids_righe_ordine) and not isvalid(ids_ord_cli_fo) then
	ids_ord_cli_fo=create datastore
	ids_ord_cli_fo.dataobject="ds_ord_cli_fo"
	ids_ord_cli_fo.settransobject(sqlca)
	setnull(ll_id_riga_nulla)
	for i_d= 1 to rowcount()
		ids_ord_cli_fo.insertrow(i_d)
		ll_id_riga_cliente=getitemnumber(i_d, "id_riga_documento")
		ids_ord_cli_fo.setitem(i_d, "id_riga_ord_cliente", ll_id_riga_cliente)
		setitem(i_d, "id_riga_documento", ll_id_riga_nulla)
	next
		
end if
//inserire controllo se saldo<0  10-03-09
if isvalid(w_saldo_doc_pop) then
	ls_test=""
	select segnala_saldo_negativo
	into :ls_test
	from dba.orafo_par_sistema;
	if ls_test='S' then
		for i_d=1 to w_saldo_doc_pop.dw_1.rowcount()
			ldc_saldo=w_saldo_doc_pop.dw_1.getitemdecimal(i_d, "somma_prog_grammi")
			if ldc_saldo<0 then
				if messagebox("Attenzione!", "Il saldo è minore di zero: salvare comunque?", StopSign!, YesNo!) <>1 then
					return 1
				else
					exit
				end if
			end if
		next
	end if
end if
	

return ll_ritorno_antenato
end event

