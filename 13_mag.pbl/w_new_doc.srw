	if (not isnull(ld_quantita) and ld_quantita > 0) then ll_num_colli=ll_num_colli*ld_quantita
	setitem(ll_row,"riga_documento_num_colli", ll_num_colli)
	triggerevent("ue_set_ucon_riga")
end if

