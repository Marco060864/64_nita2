event ue_retrieve;call super::ue_retrieve;
long ll_altezza
ll_altezza= idw_riga.height
long ll_delta_y

//iF POS(UPPER(U_FREDDIE.ISTR_DATABASE.NAME),'ORAFO')<=0 THEN
