string ls_sort


ls_sort=string(dwo.name)
if right(ls_sort, 2)="_t" then
	ls_sort=left(ls_sort, len(ls_sort) - 2)
	idw_riga.setsort(ls_sort)
	idw_riga.sort()
end if

