public subroutine uf_dw_corrente (u_dw_main adw);//20261116 per u_dw_new_doc: la DataWindow che prende il fuoco diventa quella corrente nel giro di F6
integer li_cnt

ib_f6_in_dw = false
for li_cnt = 1 to ii_dwcount
	if idw_tree[li_cnt] = adw then ii_dwcurr = li_cnt
next

end subroutine

public subroutine uf_dw_prossima (integer ai_verso);//20261116 per u_dw_new_doc: F6 (ai_verso = 1) e Shift+F6 (ai_verso = -1) passano alla DataWindow successiva o precedente
integer li_cdw, li_ret, li_giri

ib_f6_in_dw = true
if ii_dwcount < 1 then return
li_ret = -1
do while li_ret < 0 and li_giri <= ii_dwcount
	li_giri++
	li_cdw = ii_dwcurr + ai_verso
	if li_cdw > ii_dwcount then li_cdw = 1
	if li_cdw < 1 then li_cdw = ii_dwcount
	ii_dwcurr = li_cdw
	li_ret = uf_dwsetfocus(idw_tree[li_cdw])
loop

end subroutine

public subroutine wf_set_campi_destinazione ();//20261116 era u_setta_campi_documento.uf_set_campi_destinazione, che accetta solo u_dw_new_doc:
//agente, secondo agente e pagamento della destinazione scelta in testata
long ll_row, ll_id_destinazione, ll_id_gruppo_agenti, ll_id_gruppo_agenti_2
long ll_id_con_pagamento

ll_row=idw_gen.getrow()
if ll_row < 1 then return
ll_id_destinazione=idw_gen.getitemnumber(ll_row, "id_destinazione")

SELECT id_gruppo_agenti, id_gruppo_agenti_2, id_con_pagamento
INTO	 :ll_id_gruppo_agenti, :ll_id_gruppo_agenti_2, 
		 :ll_id_con_pagamento 
FROM	 destinazione
WHERE  id_destinazione = :ll_id_destinazione
;

choose case SQLCA.SQLCODE
	case -1
		messagebox("DBError", SQLCA.SQLERRTEXT)
	case 0
		if (ll_id_gruppo_agenti > 0) and (not isnull(ll_id_gruppo_agenti)) then	idw_gen.setitem(ll_row, "id_gruppo_agenti", ll_id_gruppo_agenti)
		if (ll_id_gruppo_agenti_2 > 0) and (not isnull(ll_id_gruppo_agenti_2)) then	idw_gen.setitem(ll_row, "id_gruppo_agenti_2", ll_id_gruppo_agenti_2)		
		if (ll_id_con_pagamento > 0) and (not isnull(ll_id_con_pagamento)) then	idw_gen.setitem(ll_row, "id_con_pagamento_des", ll_id_con_pagamento)	
end choose

end subroutine

