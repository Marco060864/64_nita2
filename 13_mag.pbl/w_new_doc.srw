If IsValid(iuo_msg_log) then
	
	iuo_msg_log.uf_new_text("",1)
	
	destroy iuo_msg_log
end if


long				ll_row
integer			li_size, li_i
string			ls_colname
u_dw_main		ludw_1
s_rit_wp			istr_rit


ludw_1 = idw_master
ll_row = ludw_1.getRow()
istr_rit = ludw_1.is_ritorni
istr_rit.s_modo_rit = "X"
if ll_row>0 then
	li_size = UpperBound(ludw_1.is_list.s_identifica)
	for li_i = 1 to li_size
		ls_colname = ludw_1.is_list.s_identifica[li_i]
		istr_rit.l_identifica[li_i] = ludw_1.GetItemNumber(ll_row, ls_colname)
	next
end if
Message.PowerObjectParm = istr_rit


if isValid(iuo_pag) then
	destroy iuo_pag
end if	
if isValid(iu_contab_documento) then
	destroy iu_contab_documento
end if	
if isValid(ids_lotti) then
	destroy ids_lotti
end if	

if isValid(ids_doc_lotto) then
	destroy ids_doc_lotto
end if	

if isValid(ids_scar_lotto) then
	destroy ids_scar_lotto
end if	
if isValid(IDS_ANTICIPI) then
	destroy IDS_ANTICIPI
end if	


if isvalid(us_dati_partita.s_dw_aper_partita) then
	
	destroy us_dati_partita.s_dw_aper_partita
	destroy us_dati_partita.s_dw_scar_partita
end if
if isvalid(u_ordini) then destroy u_ordini
tab_1.tabpage_7.dw_salva_prezzo_in_listino.reset()

if isvalid(ids_ev_forzata) then
	destroy ids_ev_forzata
end if

//20231024 distruggo eventuale ds_excel
if isvalid(ds_excel) then 	destroy ds_excel
end event

event deactivate;
SetNull(u_freddie.iw_current)

If IsValid(iuo_msg_log) then
	iuo_msg_log.uf_leave_msg()
end if
end event

event activate;



If not IsValid(u_freddie.iudw_current) then
	u_freddie.iudw_current= idw_master
end if

end event

event key;

keycode			lk_code
string			ls_nome
windowobject	lw_me

lk_code = key

choose case lk_code
	case KeyF12!
		if keyflags=3 then
			ls_nome = this.ClassName()
			MessageBox ("ClassName",ls_nome)
		end if
	case KeyF1!
		if (keyflags = 0 Or keyflags = 1 Or keyflags = 2) then
			This.Event ue_help(Topic!, il_HelpTopic, "")
		end if
end choose


integer		li_cdw, li_ret

choose case key
	case KeyN!
		if (keyflags=2) then
			if (idw_master.is_list.s_modo=modo_inserisci) or (ib_nonmodale=true) then
				cb_nuovo.triggerevent(clicked!)
			end if
		end if
	case KeyS!
		if (keyflags=2) then
			cb_salva.triggerevent(clicked!)
		end if
	case KeyF12!
		if (keyflags=0) then
			cb_salva.triggerevent(clicked!)
		end if
	case KeyF6!
		
		
		if not ib_F6_in_dw then
			if (keyflags=0) then		
				li_ret = -1
				do while li_ret<0
					li_cdw = ii_dwcurr
					li_cdw++
					if li_cdw > ii_dwcount then li_cdw = 1
					ii_dwcurr = li_cdw
					li_ret = uf_dwsetfocus(idw_tree[li_cdw])
				loop
			end if
			if (keyFlags=1) then		
				li_ret = -1
				do while li_ret<0
					li_cdw = ii_dwcurr
					li_cdw --
					if li_cdw < 1 then li_cdw = ii_dwcount
					ii_dwcurr = li_cdw
					li_ret = uf_dwsetfocus(idw_tree[li_cdw])
				loop
			end if
		end if
		ib_F6_in_dw = false
		
end choose

end event

event closequery;long ll_intestatario, ll_prof_documento, ll_count, ll_size
string ls_codice_int, ls_codice_prof, ls_codice, ls_info

ls_info= uf_update_info()
if ls_info <> "" then
	If MessageBox(is_nome_tipo_documento, "Le seguenti tabelle sono state cambiate:" + ls_info +&
							 "~n~n Vuoi salvare le modifiche?", Information!,YesNo!, 1) = 1 then
		if tab_1.tabpage_1.dw_documento_ordine_ff.GetItemStatus(il_row, 0, Primary!)= New! or tab_1.tabpage_1.dw_documento_ordine_ff.GetItemStatus(il_row, 0, Primary!)= NewModified! then
			
			ib_crea_spesa= TRUE
		end if
		TriggerEvent("ue_update")
		
		tab_1.tabpage_4.dw_spesa_documento_gd.SetColumn("percentuale")
	end if
end if

