		wf_premi(tab_1.tabpage_2.cb_5bis, false)
	case "Aggiorna listino dal documento"
		wf_premi(tab_1.tabpage_2.cb_agg_listino, false)
	case "Aggiorna listino: tutte le righe + fornitore"
		wf_premi(tab_1.tabpage_2.cb_agg_listino, true)
	case "Listino da documento"
		wf_premi(tab_1.tabpage_2.cb_8, false)
	case "F+C"
		wf_premi(tab_1.tabpage_2.cb_f_c, false)
	case "Galvanica su tutte le righe"
		wf_premi(tab_1.tabpage_2.cb_4, false)
	// --- riga
