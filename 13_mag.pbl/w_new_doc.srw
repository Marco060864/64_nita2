public function integer uf_buildtree (u_dw_main audw_dw);integer	li_cnt, li_size, li_i

li_cnt = ii_dwcount
li_cnt++
idw_tree[li_cnt] = audw_dw
ii_dwcount = li_cnt
li_size = upperbound(audw_dw.iudw_children)
for li_i = 1 to li_size
	uf_buildtree(audw_dw.iudw_children[li_i])
next
return 0
end function

public function integer uf_dwsetfocus (ref u_dw_main audw_dw);datawindow  ldw_uno
PowerObject lpo_uno, lpo_due
Userobject  luo_uno
tab			ltb_uno
integer		ll_retval

ldw_uno = audw_dw
ll_retval = 0

lpo_uno = ldw_uno.GetParent()
if typeof(lpo_uno) = UserObject! then
	lpo_due = lpo_uno.GetParent()
	if typeof(lpo_due) = Tab! then
		ltb_uno = lpo_due
		luo_uno = lpo_uno
		
		
		
		if (ltb_uno.visible) and (ltb_uno.enabled) and (luo_uno.visible) and (luo_uno.enabled) then

			ltb_uno.SelectTab(lpo_uno)
			
			lpo_uno = ltb_uno.GetParent()
			
			if typeof(lpo_uno) = UserObject! then
				lpo_due = lpo_uno.GetParent()
				if typeof(lpo_due) = Tab! then
					ltb_uno = lpo_due
					luo_uno = lpo_uno
					
					
					
					if (ltb_uno.visible) and (ltb_uno.enabled) and (luo_uno.visible) and (luo_uno.enabled) then
						
						ltb_uno.SelectTab(lpo_uno)
					else
						ll_retval = -2
					end if
				else
					
					ll_retval = 2
				end if
			else
				
			end if

		else
			ll_retval = -1
		end if
		
	else
		
		ll_retval = 1
	end if
else
	
end if
ldw_uno.setfocus()

return ll_retval

end function

public function integer uf_retrieve_dddw (integer ai_index);
PowerObject		lpo_object
datawindow		ldw_data
u_dw_main		ldw_u_dw_main
integer 			li_size, li_i
integer			li_size_k, li_k
integer			li_size_z, li_z
integer			li_count
tab				ltb_panel
UserObject		luo_tab_page
li_size = UpperBound( this.Control )

li_count	= 0

for li_i = 1 to li_size 
	if not isNull(this.Control[li_i]) then

		if this.Control[li_i].TypeOf() = Tab! then
			ltb_panel = this.Control[li_i]
			li_size_k = UpperBound( ltb_panel.Control )
			for li_k = 1 to li_size_k 
				if not isNull(ltb_panel.Control[li_k]) then

					if ltb_panel.Control[li_k].TypeOf() = UserObject! then
						li_count++
						if li_count = ai_index then
							luo_tab_page = ltb_panel.Control[li_k]
							li_size_z = UpperBound( luo_tab_page.Control )
							for li_z = 1 to li_size_z 
																
								if luo_tab_page.Control[li_z].TypeOf() = DataWindow! then
									lpo_object = luo_tab_page.Control[li_z]
									ldw_data   = lpo_object
									
									if not isNull( ldw_data.DataObject ) and ldw_data.DataObject <> "" then
										ldw_data.triggerevent("ue_retrieve_dddw")
									end if	
								end if
								
							next
						end if	
					end if
				end if	

			next	
		end if	
	end if	
next	

return 0
end function

public function decimal uf_calcola_prezzo (string as_sconto, decimal adc_prezzo, decimal adc_quantita);
char		lch_sconto[], lch_item[]
long 		ll_char_size, ll_char_count, ll_item_count
decimal  ldc_parte,ldc_tot_riga
string  ls_parte
long ll_row, ll_pos_plus,ll_pos_minus, ll_pos
boolean lb_non_calcolabile, lb_minus
string ls_tot_riga

lb_minus= FALSE
lch_item = ""
ll_item_count=0
if IsNull(adc_prezzo) then adc_prezzo = 0
if not (IsNull(as_sconto) OR as_sconto= "") then
	lch_sconto= Trim(as_sconto)
	ll_char_size= UpperBound(lch_sconto)
	For ll_char_count= 1 to ll_char_size
		CHOOSE CASE lch_sconto[ll_char_count]
			CASE "-"
				If not(lch_item = "") OR ll_char_count = 1 then
					ldc_parte= Dec(lch_item)
					if  ldc_parte < 0 OR (ldc_parte > 100 AND not lb_minus) then 
					
						SetNull(ldc_parte)	
						RETURN ldc_parte
					else
						if lb_minus then
							adc_prezzo = adc_prezzo + adc_prezzo * (ldc_parte / 100)
						else
							adc_prezzo = adc_prezzo - adc_prezzo * (ldc_parte / 100)
						end if
					end if
				else
					
					SetNull(ldc_parte)	
					RETURN ldc_parte				
				end if
				lch_item = ""
				ll_item_count=0
				lb_minus = TRUE
			CASE "+"
					If not(lch_item = "") OR ll_char_count = 1 then
					ldc_parte= Dec(lch_item)
					if ldc_parte < 0 OR (ldc_parte > 100 AND not lb_minus) then 
					
						SetNull(ldc_parte)	
						RETURN ldc_parte
					else
						if lb_minus then
							adc_prezzo = adc_prezzo + adc_prezzo * (ldc_parte / 100)
						else
							adc_prezzo = adc_prezzo - adc_prezzo * (ldc_parte / 100)
						end if
					end if
				else
					
					SetNull(ldc_parte)	
					RETURN ldc_parte				
				end if
				lch_item = ""
				ll_item_count=0
				lb_minus = FALSE
			CASE ELSE
				ll_item_count ++
				lch_item[ll_item_count]= lch_sconto[ll_char_count]
		END CHOOSE
	next


	If not(lch_item = "") then
		ldc_parte= Dec(lch_item)
		if ldc_parte < 0 OR (ldc_parte > 100 AND not lb_minus) then 
		
			SetNull(ldc_parte)	
			RETURN ldc_parte
		else
			if lb_minus then
				adc_prezzo = adc_prezzo + adc_prezzo * (ldc_parte / 100)
			else
				adc_prezzo = adc_prezzo - adc_prezzo * (ldc_parte / 100)
			end if
		end if
	end if
end if

RETURN adc_prezzo

end function

public function integer uf_set_ric (string as_value, string as_field, datawindow adw_datawindow);

string ls_color
CHOOSE CASE as_value
	CASE "N"
		f_displayonly(adw_datawindow, as_field, TRUE)

		
		ls_color = "276856960"
		adw_datawindow.Modify(as_field + ".color = " + ls_color)
	CASE "L"
		f_displayonly(adw_datawindow, as_field, TRUE)
		ls_color= f_get_dwo_property(adw_datawindow.Describe(as_field + ".color"), "0", "")
		adw_datawindow.Modify(as_field + ".color = " + ls_color)
		
		adw_datawindow.Modify(as_field + ".color = 0")

	CASE "M"
		f_displayonly(adw_datawindow, as_field, FALSE)
		ls_color= f_get_dwo_property(adw_datawindow.Describe(as_field + ".color"), "0", "")
		adw_datawindow.Modify(as_field + ".color = " + ls_color)

		CHOOSE CASE String(adw_datawindow.Describe(as_field + ".edit.style"))
			CASE "edit"
				adw_datawindow.Modify(as_field + ".edit.nilisnull = FALSE")
				adw_datawindow.Modify(as_field + ".edit.required = FALSE")
			CASE "dddw"
				adw_datawindow.Modify(as_field + ".dddw.required = FALSE")

			CASE "ddlb"
				adw_datawindow.Modify(as_field + ".ddlb.required = FALSE")
			CASE "editmask"
				adw_datawindow.Modify(as_field + ".editmask.required = FALSE")
			CASE ELSE
		END CHOOSE
	CASE "O"
		CHOOSE CASE String(adw_datawindow.Describe(as_field + ".edit.style"))
			CASE "edit"
				adw_datawindow.Modify(as_field + ".edit.nilisnull = TRUE")
				adw_datawindow.Modify(as_field + ".edit.required = TRUE")
			CASE "dddw"
				adw_datawindow.Modify(as_field + ".dddw.required = TRUE")

			CASE "ddlb"
				adw_datawindow.Modify(as_field + ".ddlb.required = TRUE")
			CASE "editmask"
				adw_datawindow.Modify(as_field + ".editmask.required = TRUE")
			CASE ELSE
		END CHOOSE
END CHOOSE
return 0
end function

