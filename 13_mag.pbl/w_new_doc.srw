	cbx_des_3.triggerevent(clicked!)
end if
end event

event ue_itemerror;call super::ue_itemerror;
CHOOSE CASE adwo_dwo.name
	CASE "prezzo_netto"
		If IsNull(as_data) OR as_data="" then
			RETURN 3
		end if
END CHOOSE
RETURN 2
end event

event doubleclicked;call super::doubleclicked;
if string(dwo.name)="cmc" or string(dwo.name)="costo_medio" or string(dwo.name)="costo_ultimo" then 
	long ll_riga_corrente
	decimal ld_prezzo
	ll_riga_corrente=getrow()
	ld_prezzo=getitemdecimal(ll_riga_corrente, string(dwo.name))
	if not isnull(ld_prezzo) and not ld_prezzo=0 then
		tab_1.tabpage_2.dw_riga_documento_ordine_gd.setitem(ll_riga_corrente, "prezzo", ld_prezzo)
	end if
end if

long ll_articolo, ll_temp
nvo_file_list sl_lista_file
integer li_ret
string ls_file_trovato, ls_path

if dwo.name="riga_documento_id_articolo" then
	ll_articolo=getitemnumber(row, "riga_documento_id_articolo")
	if ll_articolo>0 then
		select dir_immagini 
		into :ls_path
		from dba.par_sistema
		;

		sl_lista_file=f_leggi_files(ls_path, false)
	end if
	FOR ll_temp = 1 TO UpperBound( sl_lista_file.as_file )
		 li_ret=pos(sl_lista_file.as_file[ll_temp], string(ll_articolo))
		 if li_ret>0 then
			ls_file_trovato=sl_lista_file.as_file[ll_temp]
			//l'ho trovato ora lo mostro
			//ma prima chiudo la finestra se fosse stata aperta già precedentemente
			close(w_mostra_foto)
			openwithparm(w_mostra_foto, ls_file_trovato)
			exit
			
			
		end if
	 NEXT
end if
end event

