li_riga=ds_par_sistema.retrieve()
if li_riga>0 then
	ls_nota=ds_par_sistema.getitemstring(1, "nota_in_primo_piano")
	if upper(ls_nota)='S' then
		idw_gen.modify("documento_note_intestazione.visible=1")
		idw_gen.modify("c_registro.visible=0")
