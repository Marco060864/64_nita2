public function boolean wf_vede_des_aggiuntiva ();//20261113 unisce il controllo che era copiato in ue_post_open e in tab_1.selectionchanging:
//la descrizione aggiuntiva di riga si vede nelle bollettine (registro GV numero 2) e, per LaBella, in alcuni profili
long ll_id_prof_doc, ll_id_registro
string ls_tipo_registro
integer li_num_registro

if idw_gen.rowcount() < 1 then return false
ll_id_prof_doc = idw_gen.getitemnumber(1, "id_prof_documento")
ll_id_registro = idw_gen.getitemnumber(1, "id_registro")
ls_tipo_registro = ""
li_num_registro = 0
select tipo_registro, numero
into :ls_tipo_registro, :li_num_registro
from dba.registro
where id_registro = :ll_id_registro;
if ls_tipo_registro = 'GV' and li_num_registro = 2 then return true
if is_cod_azienda <> "LABELLA" then return false
choose case ll_id_prof_doc
	case 107, 108, 110, 116, 117, 125, 133, 142
		return true
end choose
return false

end function

public subroutine wf_agg_listino (boolean ab_tutto_e_fornitore);//20261113 unisce il clic e il clic destro di cb_agg_listino.
//ab_tutto_e_fornitore = false: listino personale (una riga o tutte secondo orafo_par_sistema.agg_lis_da_doc)
//ab_tutto_e_fornitore = true : tutte le righe e anche il listino fornitore
integer ll_row, ll_nr_row, li_ret, ll_prima_riga
decimal ld_prezzo
string ls_agg_una_riga_o_tutto, ls_msg
long ll_id_uc, ll_id_cliente
date ldt_data_doc
uo_lis_fornitori uo_lis_fo

if ab_tutto_e_fornitore then
	ls_msg = "Sei sicura di voler riportare TUTTI i prezzi attuali ~r~n"
else
	ls_msg = "Sei sicura di voler riportare i prezzi attuali ~r~n"
end if
if messagebox("Attenzione!", ls_msg + "nel listino personale dell'intestatario di questo documento?", stopsign!, yesno!) <> 1 then return

ll_nr_row = idw_riga.RowCount()
ll_prima_riga = 1
if ab_tutto_e_fornitore then
	ll_id_cliente = idw_gen.getitemnumber(1, "id_sog_commerciale")
	ldt_data_doc = idw_gen.getitemdate(1, "data_documento")
	uo_lis_fo = create uo_lis_fornitori
else
	ls_agg_una_riga_o_tutto = ""
	select agg_lis_da_doc
	into :ls_agg_una_riga_o_tutto
	from dba.orafo_par_sistema
	;
	if ls_agg_una_riga_o_tutto = "U" then //aggiorno solo la riga corrente
		ll_nr_row = idw_riga.getrow()
		ll_prima_riga = ll_nr_row
	end if
end if
FOR ll_row = ll_prima_riga to ll_nr_row
	ld_prezzo = idw_riga.getitemdecimal(ll_row, "prezzo_manifattura")
	if isnull(ld_prezzo) or ld_prezzo = 0 then
		ld_prezzo = idw_riga.getitemdecimal(ll_row, "prezzo_complessivo")
	end if
	ll_id_uc = idw_riga.getitemnumber(ll_row, "riga_documento_id_unita_confezione")
	wf_salva_prezzo_in_listino(ll_row, ld_prezzo, 100, ll_id_uc)
	if ab_tutto_e_fornitore then uo_lis_fo.f_agg_lis_fornitore(ll_id_cliente, ld_prezzo, ll_id_uc, ldt_data_doc)
next
if ab_tutto_e_fornitore then destroy uo_lis_fo
if tab_1.tabpage_7.dw_salva_prezzo_in_listino.rowcount() > 0 then
	li_ret = tab_1.tabpage_7.dw_salva_prezzo_in_listino.update()
	if li_ret = 1 then
		commit;
	else
		messagebox("Attenzione!", SQLCA.SQLErrText)
		rollback;
	end if
end if

end subroutine

public subroutine wf_layout_init ();//20261113 memorizza le misure di partenza usate dal ridimensionamento
integer li_i
dragobject ldo

il_tab_w0 = tab_1.width
il_tab_h0 = tab_1.height
il_grid_w0 = tab_1.tabpage_2.dw_riga_documento_ordine_gd.width
il_grid_h0 = tab_1.tabpage_2.dw_riga_documento_ordine_gd.height
for li_i = 1 to upperbound(tab_1.tabpage_2.control)
