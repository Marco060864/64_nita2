type dw_riga_documento_dett_ord_ff from u_dw_new_doc within tabpage_2
integer x = 5
integer y = 924
integer width = 3109
integer height = 880
integer taborder = 20
string dataobject = "d_new_doc_riga_dett"
end type

event ue_init;call super::ue_init;ib_dw_shared = TRUE
is_list.s_colonne_drop[1] = "riga_documento_id_listino"
is_list.s_colonne_drop[1] = "articolo_id_titolo"
is_list.s_colonne_drop[2] = "articolo_metallo"
is_list.s_colonne_drop[3] = "id_caus_magazzino"
is_list.s_colonne_drop[4] = "id_caus_des"
is_list.s_colonne_drop[5] = "riga_documento_id_listino"
is_list.s_colonne_drop[6] = "riga_documento_id_TAB_IVA"
is_list.s_colonne_drop[7] = "id_conto"
end event

event itemfocuschanged;call super::itemfocuschanged;is_last_field=dwo.name
end event

event itemchanged;call super::itemchanged;
long ll_ritorno_antenato  //20261113 valore restituito dalla parte che era nell'antenato
long			ll_row
decimal		lcd_null
decimal		ld_prezzo_netto, ld_qta, ld_sconto_riga, ld_totale_riga
decimal		ld_cambio, ld_totale_riga_lire, ld_QTA_SM, ld_Qta_Effettiva

ll_row= GetRow()
If IsNull(ll_row) OR ll_row=0 then ll_row=row
SetNull(lcd_null)
CHOOSE CASE dwo.name
	CASE "prezzo_netto"
		tab_1.tabpage_2.dw_riga_documento_ordine_gd.event ue_set_calc_tot_riga(ll_row ,lcd_null, Dec(data), TRUE)
END CHOOSE

ll_ritorno_antenato = 0  //era: return 0 
goto fine_antenato





fine_antenato:
long ll_id_caus, ll_id_uc
string ls_met, ls_man, ls_um
decimal{4} ld_prezzo_metallo, ld_prezzo_manifattura ,ld_qta2
decimal{2} ld_peso_gr, ld_fino_calo, ld_peso
integer i

choose case string(dwo.name)
	case "id_caus_magazzino" 
		ll_id_caus=long(data)
		select proponi_prezzo_metallo, proponi_prezzo_manifattura
		into :ls_met, :ls_man
		from caus_magazzino
		where id_caus_magazzino=:ll_id_caus;
		
		setitem(row, "proponi_prezzo_metallo", ls_met)
		setitem(row, "proponi_prezzo_manifattura", ls_man)
//20241129 se si cambia la caus della prima riga si cambiano tutte forse...
		if row=1 then
			if messagebox("Attenzione!", "Vuoi riportare la causale su tutte le righe?", stopsign!, yesno!)=1 then
				for i=1 to rowcount()
					setitem(i, "id_caus_magazzino", long(data))
				next
			end if
		end if

	case "sconto" 
		ls_um=tab_1.tabpage_2.dw_riga_documento_ordine_gd.getitemstring(row,"tipo_um")
		if ls_um='P' then
			ld_prezzo_manifattura=idw_riga.getitemdecimal(row, "prezzo_manifattura")
			if ld_prezzo_manifattura>0 then
	
	
	
				
				post wf_calcola_prezzo(row)
			else
				if pos(data, "+")=0 and len(data)>3 then //è il caso della Bella che usa lo sconto come descrizione
				
				else
					messagebox("Attenzione!", "Impossibile applicare sconto:~r~nnon esiste un valore per la manifattura!")
					post uf_set_colval("sconto",  "0")
				end if
			end if
		else
			tab_1.tabpage_2.dw_riga_documento_ordine_gd.post event ue_set_calc_riga(row)
		end if
	case "sconto_riga" 
		tab_1.tabpage_2.dw_riga_documento_ordine_gd.event post ue_set_calc_riga(row)
	case "peso_non_prezioso" 
		ld_peso=idw_riga.getitemdecimal(row, "riga_documento_peso_netto")
		if dec(data)<=ld_peso then
			if not isnull(ld_peso) then
				post wf_setta_fino_calo(row)
				post wf_calcola_prezzo(row)
			end if
		else
			messagebox("Errore!", "Il peso non prezioso non può essere maggiore del legato!")
			return 2
		end if
	case "id_unita_confezione"
		ll_id_uc=long(data)
		select m.tipo
		into 	:ls_um
		from unita_misura m, unita_confezione c
		where c.id_unita_misura=m.id_unita_misura
		and c.id_unita_confezione=:ll_id_uc
		;
		idw_riga.setitem(row, "tipo_um", ls_um)
		ld_qta2=tab_1.tabpage_2.dw_riga_documento_ordine_gd.getitemdecimal(row, "quantita")
		tab_1.tabpage_2.dw_riga_documento_ordine_gd.post event ue_rec_prezzo(row, ld_qta2)
		post wf_calcola_prezzo(row)
		
	case "riga_documento_id_tab_iva"
		if row=1 then 
			if messagebox("Attenzione!", "Vuoi cambiare l'iva su tutte le righe?",  stopsign!, yesno!)=1 then 
				wf_ricopia_iva_su_tutte_righe(long(data), row)
			end if
		end if
	case	"riga_documento_id_listino"
		if messagebox("Attenzione!", "Vuoi cambiare il listino su tutte le righe?",  stopsign!, yesno!)=1 then 
				wf_ricopia_listino_tutte_righe(long(data), row)
			end if
		
		
end choose
return ll_ritorno_antenato
end event

event ue_retrieve;call super::ue_retrieve;is_title="Riga " + is_nome_tipo_documento
end event

event ue_key;boolean 	lb_new=FALSE
boolean 	lb_last=FALSE
long 		ll_last_row

CHOOSE CASE key
	CASE KeyTab!
		If keyflags = 0 then
			lb_new= (GetItemStatus(GetRow(), 0, Primary!)= New!) OR (GetItemStatus(GetRow(), 0, Primary!) = NewModified!)
			lb_last = (GetRow() = RowCount())
			if is_last_field = "id_caus_magazzino" then
				if lb_new then
				
					if lb_last then
					
						idw_riga.PostEvent("ue_wiz_insert")
					else
	
						idw_riga.PostEvent("ue_wiz_getfocus")
					end if
				else
				
					idw_riga.PostEvent("ue_wiz_getfocus")
				end if
				RETURN -1
			end if
		end if
END CHOOSE
end event

event clicked;call super::clicked;





decimal 		ldc_esistenza, ldc_disponibilita
long			ll_id_articolo, ll_id_azienda,ll_id_documento, ll_id_par_disponibilita, ll_row
long			ll_id_profilo, ll_null, ll_orafo
s_any_array	lstr_any_array

long			ll_idmag, ll_idsc, ll_idloc, ll_idart
s_list_main	lstr_list

setnull(ll_null)

CHOOSE CASE string(dwo.name) 
	CASE "img_info"
		
	CASE "c_esistenza","c_disponibilita", "cesistenza_fisica"
		ll_row = getRow()
		ll_idart = GetItemNumber (ll_row, "riga_documento_id_articolo")
		ll_idloc = GetItemNumber (ll_row,"id_locazione_1")
		if not isNull(ll_idloc) then
			select "locazione"."id_magazzino"
				into :ll_idmag
				from "dba"."locazione"
				where "locazione"."id_locazione" = :ll_idloc
				using SQLCA;
			if SQLCA.SQLCode=0 then
			else
				ll_idmag=0
			end if
		else
			ll_idmag=0
		end if
		ll_row 			= idw_gen.GetRow()
		ll_idsc 			= idw_gen.GetItemNumber(ll_row, "id_sog_commerciale")
		ll_id_profilo	= idw_gen.GetItemNumber(ll_row, "id_prof_documento")
		
		if (not isNull(ll_idsc)) and (not isNull(ll_idart)) and (ll_idmag>0) and (ll_idsc>0) and (ll_idart>0) then
			lstr_list.l_identifica[1]	= ll_idart
			lstr_list.l_identifica[2]	= ll_idsc
			lstr_list.l_identifica[3]	= ll_idmag
			if not isNull(ll_id_profilo) then
				lstr_list.s_par_name[1]		= "id_prof_documento"
				lstr_list.s_par_value[1]	= string(ll_id_profilo)
			end if	
			lstr_list.s_win_parametri='D'
			select table_id 
			into :ll_orafo
			from systable
			where table_name='orafo_par_sistema';
			if ll_orafo>0 then
				
			else
				OpenWithParm(w_sit_articolo_wz,lstr_list)
			end if
		end if
	CASE "img_info_art"
		ll_row = getRow()
		ll_idart = GetItemNumber (ll_row, "riga_documento_id_articolo")
		ll_idloc = GetItemNumber (ll_row,"id_locazione_1")
		
		ll_row 			= idw_gen.GetRow()		
		ll_id_profilo	= idw_gen.GetItemNumber(ll_row, "id_prof_documento")
		ll_idsc 			= idw_gen.GetItemNumber(ll_row, "id_sog_commerciale")
		
		if (ll_idart > 0) then
			lstr_list.s_modo = modo_modifica
			lstr_list.s_identifica[1]	= "id_articolo"
			lstr_list.l_identifica[1]	= ll_idart
			lstr_list.l_identifica[2]	= ll_idsc
			lstr_list.l_identifica[3]	= ll_idloc
			
			lstr_list.s_par_value[1]	= string(ll_id_profilo)
			
			lstr_list.s_par_value[2]	= string(idw_gen.getitemnumber(ll_row, "id_registro"))
			lstr_list.s_par_value[3]	= string(idw_riga.getitemnumber(row, "riga_documento_id_unita_confezione"))
			lstr_list.s_par_value[4]	= string(idw_gen.getitemnumber(ll_row, "documento_id_valuta_des"))
			lstr_list.s_par_value[5]	= string(idw_gen.getitemnumber(ll_row, "id_destinazione"))
			lstr_list.s_par_value[6]	= string(idw_gen_trasp.getitemnumber(ll_row, "id_tipo_trasporto"))
			lstr_list.s_par_value[7]	= string(idw_riga.getitemnumber(row, "quantita"))
			lstr_list.s_par_value[8]	= idw_gen_trasp.getitemstring(ll_row, "tras_mezzo")
			if not (isnull(idw_gen.getitemdate(ll_row, "data_documento"))) then
				lstr_list.s_par_value[9]	= string(idw_gen.getitemdate(ll_row, "data_documento"))
			else
				lstr_list.s_par_value[9]	= string(idw_gen.getitemdate(ll_row, "data_registrazione"))
			end if
			lstr_list.s_par_value[10]	= string(idw_gen.getItemNumber(1,"documento_id_listino"))
			lstr_list.s_par_value[11]	= string(idw_gen.getItemNumber(1,"documento_id_variazione"))
			
		
			OpenWithParm(w_dati_articolo_cx, lstr_list)		
		end if
END CHOOSE

//CHOOSE CASE dwo.name
//	CASE "riga_documento_descrizione"
//		string	ls_height, ls_width
