public function string wf_col (datawindow adw, string as_col);//20261113 valore di una colonna come testo, senza errori se la colonna non esiste nella DataWindow
string ls_tipo, ls_val
long ll_row

ls_val = ""
if not isvalid(adw) then return ""
ll_row = adw.getrow()
if ll_row < 1 then return ""
ls_tipo = lower(adw.describe(as_col + ".coltype"))
if ls_tipo = "!" or ls_tipo = "?" or ls_tipo = "" then return ""
choose case left(ls_tipo, 4)
	case "char"
		ls_val = adw.getitemstring(ll_row, as_col)
	case "date"
		if ls_tipo = "date" then
			ls_val = string(adw.getitemdate(ll_row, as_col), "dd/mm/yyyy")
		else
			ls_val = string(adw.getitemdatetime(ll_row, as_col), "dd/mm/yyyy")
		end if
	case "deci"
		ls_val = string(adw.getitemdecimal(ll_row, as_col), "#,##0.00")
	case "long", "ulon", "numb", "real", "int"
		ls_val = string(adw.getitemnumber(ll_row, as_col))
	case else
		ls_val = ""
end choose
if isnull(ls_val) then ls_val = ""
return ls_val

end function

public subroutine wf_aggiorna_fascia ();//20261113 fascia di testata sempre visibile: documento, intestatario, stato, totale
string ls_doc, ls_sog, ls_stato, ls_tot, ls_s

if not isvalid(idw_gen) then return
if idw_gen.rowcount() < 1 then return
ls_doc = wf_col(idw_gen, "c_prof_doc_cod")
ls_s = wf_col(idw_gen, "num_documento")
if ls_s <> "" then ls_doc = ls_doc + "   n. " + ls_s
ls_s = wf_col(idw_gen, "data_documento")
if ls_s <> "" then ls_doc = ls_doc + "   del " + ls_s
ls_sog = trim(wf_col(idw_gen, "c_sog_comm_cod") + "  " + wf_col(idw_gen, "c_sog_comm_des"))
if is_blocco = "B" or wf_col(idw_gen, "bloccato") = "S" then
	ls_stato = "Bloccato"
	st_h_stato.backcolor = 14079999	//rosa
elseif idw_gen.GetItemStatus(1, 0, Primary!) = New! or idw_gen.GetItemStatus(1, 0, Primary!) = NewModified! then
	ls_stato = "Nuovo"
	st_h_stato.backcolor = 16771798	//azzurro
else
	ls_stato = "Aperto"
	st_h_stato.backcolor = 13434828	//verde chiaro
end if
ls_tot = ""
if isvalid(idw_gen_tot_ext) then ls_tot = wf_col(idw_gen_tot_ext, "tot_documento_lire")
st_h_doc.text = " " + ls_doc
st_h_sog.text = " " + ls_sog
st_h_stato.text = ls_stato
if ls_tot = "" then
	st_h_tot.text = ""
else
	st_h_tot.text = "Totale  " + ls_tot + " "
end if

end subroutine

public subroutine wf_premi (dragobject ado, boolean ab_destro);//20261113 esegue il clic (o il clic destro) di un pulsante anche se e' invisibile, rispettando lo stato abilitato
boolean lb_abilitato
commandbutton lcb
picturebutton lpb
picture lp

if not isvalid(ado) then return
lb_abilitato = true
choose case ado.typeof()
	case commandbutton!
		lcb = ado
		lb_abilitato = lcb.enabled
	case picturebutton!
		lpb = ado
		lb_abilitato = lpb.enabled
	case picture!
		lp = ado
		lb_abilitato = lp.enabled
end choose
if not lb_abilitato then
	messagebox("Attenzione!", "Azione non disponibile in questo momento.")
	return
end if
if ab_destro then
	ado.postevent(rbuttondown!)
else
	ado.postevent(clicked!)
end if

end subroutine

public subroutine wf_azione (dropdownlistbox addlb, integer ai_index);//20261113 menu a tendina delle azioni: la prima voce e' il titolo del menu, le altre richiamano i pulsanti
string ls_voce

if ai_index <= 1 then return
ls_voce = addlb.text(ai_index)
addlb.selectitem(1)
choose case ls_voce
	// --- altre azioni (finestra)
	case "Calcolatrice"
		wf_premi(cb_calcolatrice, false)
	case "Stampa etichette"
		wf_premi(cb_stampa_etichette, false)
	case "Stampa buratto per articolo"
		wf_premi(cb_7, false)
	case "Stampa buratto"
		wf_premi(cb_7, true)
	case "Stampa articoli con foto"
