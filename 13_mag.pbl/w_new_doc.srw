		wf_premi(tab_1.tabpage_2.cb_copia_riga, false)
	case "Reso non lavorato"
		wf_premi(tab_1.tabpage_2.cb_reso_non_lavorato, false)
	case "Riga derivata"
		wf_premi(tab_1.tabpage_2.cb_10, false)
	case "NO BOL in descrizione"
		wf_premi(tab_1.tabpage_2.cb_11, false)
