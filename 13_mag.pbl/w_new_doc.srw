event resize;//20261113 la finestra e' ridimensionabile: il tab e la griglia delle righe seguono,
//i controlli sotto la griglia scendono, il pulsante Chiudi e il totale restano a destra
integer li_i
long ll_dx, ll_dy, ll_w, ll_h
dragobject ldo

if il_tab_h0 = 0 then wf_layout_init()
ll_w = newwidth
ll_h = newheight
if ll_w < il_tab_w0 + tab_1.x + 37 then ll_w = il_tab_w0 + tab_1.x + 37
if ll_h < il_tab_h0 + tab_1.y + 24 then ll_h = il_tab_h0 + tab_1.y + 24
tab_1.width = ll_w - tab_1.x - 37
tab_1.height = ll_h - tab_1.y - 24
ll_dx = tab_1.width - il_tab_w0
ll_dy = tab_1.height - il_tab_h0
cb_annulla.x = ll_w - cb_annulla.width - 37
st_h_tot.x = ll_w - st_h_tot.width - 37
st_h_stato.x = st_h_tot.x - st_h_stato.width
st_h_sog.width = st_h_stato.x - st_h_sog.x
tab_1.tabpage_2.dw_riga_documento_ordine_gd.width = il_grid_w0 + ll_dx
tab_1.tabpage_2.dw_riga_documento_ordine_gd.height = il_grid_h0 + ll_dy
for li_i = 1 to upperbound(tab_1.tabpage_2.control)
	if li_i > upperbound(il_y0) then exit
	if il_y0[li_i] >= 900 then
		ldo = tab_1.tabpage_2.control[li_i]
		ldo.y = il_y0[li_i] + ll_dy
	end if
next

end event

