type cb_quotazione from commandbutton within tabpage_2
integer x = 2930
integer y = 8
integer width = 280
integer height = 88
integer taborder = 41
boolean bringtotop = true
integer textsize = -9
integer weight = 400
fontcharset fontcharset = ansi!
fontpitch fontpitch = variable!
