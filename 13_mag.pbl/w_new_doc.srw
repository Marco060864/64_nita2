event open;call super::open;//20261113 w_new_doc: finestra unica (antenato w_base). Sostituisce w_new_doc
iw_corrente = this
select codice, rag_soc_1 into :is_cod_azienda, :is_rag_soc_azienda from dba.azienda;
if isnull(is_cod_azienda) then is_cod_azienda = ""
if isnull(is_rag_soc_azienda) then is_rag_soc_azienda = ""

//MM 171106 dovrebbe velocizzare la presentazione della finestra
//lo riaccendo nel ue_postopen
SETREDRAW(false)

ib_close_query = TRUE
ib_askforsave = TRUE
is_wintype = "_"					
u_freddie.center_window(this)
This.TriggerEvent("ue_initvar")
ib_openok = f_check_serial(is_serialize)
if ib_openok then
	ib_openok = f_check_win_password(is_password)
end if
if ib_openok then
	
	iuo_msg_log = create uo_msg_log
	
	iuo_msg_log.uf_new_text("Sessione del " + String(Today()) + " - " + String(Now()),2)
	PostEvent("ue_post_open")
else
	
	postevent("ue_close")
end if




integer			li_size, li_i
s_list_main		lstr_list, lstr_2

is_wintype = "W_P_DATA"
lstr_list = Message.PowerObjectParm

if isValid(lstr_list) then
	li_size = upperBound(lstr_list.l_identifica)
	if li_size <1 then
		li_size = upperbound(lstr_list.s_identifica)
		for li_i = 1 to li_size
			lstr_list.l_identifica[li_i] = -1
		next
		Message.PowerObjectParm = lstr_list
	end if
else
		Message.PowerObjectParm = lstr_2
end if

iw_corrente=this
SetPointer(HourGlass!)

This.y = 8


tab_1.tabpage_1.dw_documento_ordine_ff.sharedata(tab_1.tabpage_3.dw_documento_bolla_trasp_ff)
tab_1.tabpage_1.dw_documento_ordine_ff.sharedata(tab_1.tabpage_4.dw_documento_ord_tot_ff)


idw_gen = tab_1.tabpage_1.dw_documento_ordine_ff
idw_riga=  tab_1.tabpage_2.dw_riga_documento_ordine_gd  
idw_riga_tot= tab_1.tabpage_2.dw_riga_documento_dett_ord_ff
idw_gen_trasp=tab_1.tabpage_3.dw_documento_bolla_trasp_ff
idw_scadenza= tab_1.tabpage_4.dw_scadenza_documento_lt
idw_gen_tot= tab_1.tabpage_4.dw_documento_ord_tot_ff
idw_gen_tot_ext = tab_1.tabpage_4.dw_documento_tot_ext_ff
idw_spesa= tab_1.tabpage_4.dw_spesa_documento_gd 
idw_castelletto=tab_1.tabpage_4.dw_cast_iva_documento_lt
idw_contropartita=tab_1.tabpage_5.dw_contr_documento_lt

this.enabled = FALSE

iuo_pag = create uo_esp_pag
idw_master=tab_1.tabpage_1.dw_documento_ordine_ff
idw_master.is_list = Message.PowerObjectParm
Message.Processed=TRUE

is_tipo_documento= idw_master.is_list.s_win_parametri



tab_1.tabpage_2.dw_riga_documento_ordine_gd.SetRowFocusIndicator(tab_1.tabpage_2.p_arrow)

TriggerEvent("ue_tipo_documento")
If Upperbound(idw_master.is_list.s_identifica) = 0  then
	idw_master.is_list.s_modo= modo_inserisci
end if

ib_nonmodale = TRUE
iu_contab_documento = create u_contab_documento

il_doppio_doc=0  



string ls_cod_azienda, ls_tipo_registro
integer li_num_registro

ib_cast_in_updatestart_righe = true  //20261012 il castelletto si ricalcola nell'updatestart di dw_riga_documento_ordine_gd: il cb_salva dell'antenato non lo rifà


//Inserito per samy il 02-12-09 (con bollo gestisce stampa disponibilità-esistenza per clienti)
