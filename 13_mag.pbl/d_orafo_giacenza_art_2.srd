 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"riga_documento~" )  TABLE(NAME=~"caus_magazzino~" )  TABLE(NAME=~"documento~" ) COLUMN(NAME=~"riga_documento.calo~") COLUMN(NAME=~"riga_documento.fino~") COLUMN(NAME=~"caus_magazzino.segno~") COLUMN(NAME=~"caus_magazzino.segno_lire~") COLUMN(NAME=~"riga_documento.tot_riga_val_az~") COLUMN(NAME=~"caus_magazzino.saldi_cl_fino~") COLUMN(NAME=~"caus_magazzino.saldi_cl_lire~") COLUMN(NAME=~"riga_documento.quantita~") COLUMN(NAME=~"riga_documento.qta_un_base~") COLUMN(NAME=~"riga_documento.id_articolo~") COLUMN(NAME=~"caus_magazzino.segno_pezzi~")    JOIN (LEFT=~"caus_magazzino.id_caus_magazzino~"    OP =~"=~"RIGHT=~"riga_documento.id_caus_magazzino~" )    JOIN (LEFT=~"documento.id_documento~"    OP =~"=~"RIGHT=~"riga_documento.id_documento~" )WHERE(    EXP1 =~"(~~~"documento~~~".~~~"data_documento~~~"~"   OP =~">=~"    EXP2 =~":da_data~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"documento~~~".~~~"data_documento~~~"~"   OP =~"<=~"    EXP2 =~":a_data)~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"riga_documento~~~".~~~"id_articolo~~~"~"   OP =~"=~"    EXP2 =~":id_art~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"caus_magazzino~~~".~~~"segno_pezzi~~~"~"   OP =~">~"    EXP2 =~"''~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"documento~~~".~~~"id_sog_commerciale~~~"~"   OP =~"=~"    EXP2 =~":id_sog~" ) ) ARG(NAME = ~"da_data~" TYPE = date)  ARG(NAME = ~"a_data~" TYPE = date)  ARG(NAME = ~"id_art~" TYPE = number)  ARG(NAME = ~"id_sog~" TYPE = number) " arguments=(("da_data", date),("a_data", date),("id_art", number),("id_sog", number)) )
