 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"ute_documento~" )  TABLE(NAME=~"utenti~" )  TABLE(NAME=~"documento~" )  TABLE(NAME=~"riga_documento~" ) COLUMN(NAME=~"ute_documento.id_utente~") COLUMN(NAME=~"ute_documento.id_documento~") COLUMN(NAME=~"ute_documento.operazione~") COLUMN(NAME=~"ute_documento.dataora~") COLUMN(NAME=~"ute_documento.descrizione~") COLUMN(NAME=~"utenti.ut_utente~") COLUMN(NAME=~"riga_documento.num_riga~") COLUMN(NAME=~"documento.num_documento~") COLUMN(NAME=~"documento.data_documento~") COLUMN(NAME=~"documento.num_progressivo~")    JOIN (LEFT=~"riga_documento.id_documento~"    OP =~"=~"RIGHT=~"documento.id_documento~"    OUTER2 =~"documento.id_documento~" )    JOIN (LEFT=~"ute_documento.id_documento~"    OP =~"=~"RIGHT=~"documento.id_documento~"    OUTER1 =~"ute_documento.id_documento~" )    JOIN (LEFT=~"ute_documento.id_utente~"    OP =~"=~"RIGHT=~"utenti.id_utenti~" )WHERE(    EXP1 =~"~~~"ute_documento~~~".~~~"id_documento~~~"~"   OP =~"=~"    EXP2 =~":id_riga~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"riga_documento~~~".~~~"num_riga~~~"~"   OP =~"=~"    EXP2 =~":num_riga~" ) ) ARG(NAME = ~"id_riga~" TYPE = number)  ARG(NAME = ~"num_riga~" TYPE = number) " arguments=(("id_riga", number),("num_riga", number))  sort="dataora D " )
