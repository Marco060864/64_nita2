 column=(type=char(1) updatewhereclause=yes name=stampa_in_inventario dbname="articolo.stampa_in_inventario" initial="S" values="	S/	N" validation=" gettext()  = 'S' OR  gettext()  = 'N'" validationmsg="'Immettere: S, N'" )
 column=(type=char(1) updatewhereclause=yes name=stampa_in_listini dbname="articolo.stampa_in_listini" initial="S" values="	S/	N" validation=" gettext()  = 'S' OR  gettext()  = 'N'" validationmsg="'Immettere: S, N'" )
 column=(type=char(1) updatewhereclause=yes name=stampa_in_giornale dbname="articolo.stampa_in_giornale" initial="S" values="	S/	N" validation=" gettext()  = 'S' OR  gettext()  = 'N'" validationmsg="'Immettere: S, N'" )
 column=(type=char(1) updatewhereclause=yes name=stampa_in_schede dbname="articolo.stampa_in_schede" initial="S" values="	S/	N" validation=" gettext()  = 'S' OR  gettext()  = 'N'" validationmsg="'Immettere: S, N'" )
 column=(type=char(1) updatewhereclause=yes name=ges_lotti dbname="articolo.ges_lotti" initial="N" values="	S/	N" validation=" gettext()  = 'S' OR  gettext()  = 'N'" validationmsg="'Immettere: S, N'" )
 column=(type=char(1) updatewhereclause=yes name=ges_matricole dbname="articolo.ges_matricole" initial="N" values="	S/	N" validation=" gettext()  = 'S' OR  gettext()  = 'N'" validationmsg="'Immettere: S, N'" )
 column=(type=char(1) updatewhereclause=yes name=ges_produzione dbname="articolo.ges_produzione" initial="N" values="	S/	N" validation=" gettext()  = 'S' OR  gettext()  = 'N'" validationmsg="'Immettere: S, N'" )
 column=(type=char(32766) updatewhereclause=no name=note dbname="articolo.note" )
 column=(type=char(1) updatewhereclause=yes name=utilizzabile dbname="articolo.utilizzabile" initial="S" values="Utilizzabile	S/Utilizzabile	N" validation=" gettext()  = 'S' OR  gettext()  = 'N'" validationmsg="'Immettere: S, N'" )
 column=(type=char(1) updatewhereclause=yes name=stato dbname="articolo.stato" initial="P" values="In Produzione	P/Novità	N/Ordinabile ma Fuori Produzione	O/Fuori Produzione	F/In Offerta	R/" validation=" gettext()  = 'P' OR  gettext()  = 'N' OR  gettext()  = 'O' OR  gettext()  = 'F' OR  gettext()  = 'R'" validationmsg="'Immettere: P, N, O, F, R'" )
