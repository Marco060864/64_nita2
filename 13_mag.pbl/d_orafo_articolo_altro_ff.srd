 column=(type=datetime updatewhereclause=yes name=data_ora_creazione dbname="articolo.data_ora_creazione" initial="Today" )
 column=(type=datetime updatewhereclause=yes name=data_ora_ult_cambiamento dbname="articolo.data_ora_ult_cambiamento" initial="Today" )
