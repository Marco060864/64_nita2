 column=(type=char(1) updatewhereclause=yes name=stampa_in_catalogo dbname="articolo.stampa_in_catalogo" )
 column=(type=char(32766) updatewhereclause=no name=nota dbname="articolo.nota" )
 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"articolo~" ) COLUMN(NAME=~"articolo.id_articolo~") COLUMN(NAME=~"articolo.id_cat_codifica~") COLUMN(NAME=~"articolo.codice~") COLUMN(NAME=~"articolo.descrizione~") COLUMN(NAME=~"articolo.rif_catalogo~") COLUMN(NAME=~"articolo.id_cat_com_articolo~") COLUMN(NAME=~"articolo.id_cat_merceologica~") COLUMN(NAME=~"articolo.id_cat_fiscale~") COLUMN(NAME=~"articolo.id_gruppo_articoli~") COLUMN(NAME=~"articolo.des_breve~") COLUMN(NAME=~"articolo.id_reparto~") COLUMN(NAME=~"articolo.id_anagrafica~") COLUMN(NAME=~"articolo.id_sog_commerciale~") COLUMN(NAME=~"articolo.id_tab_iva~") COLUMN(NAME=~"articolo.cod_intrastat~") COLUMN(NAME=~"articolo.data_ora_creazione~") COLUMN(NAME=~"articolo.data_ora_ult_cambiamento~") COLUMN(NAME=~"articolo.data_ora_ult_var_stato~") COLUMN(NAME=~"articolo.stampa_in_inventario~") COLUMN(NAME=~"articolo.stampa_in_listini~") COLUMN(NAME=~"articolo.stampa_in_giornale~") COLUMN(NAME=~"articolo.stampa_in_schede~") COLUMN(NAME=~"articolo.ges_lotti~") COLUMN(NAME=~"articolo.ges_matricole~") COLUMN(NAME=~"articolo.ges_produzione~") COLUMN(NAME=~"articolo.note~") COLUMN(NAME=~"articolo.utilizzabile~") COLUMN(NAME=~"articolo.stato~") COLUMN(NAME=~"articolo.ges_locazioni~") COLUMN(NAME=~"articolo.id_azienda~") COMPUTE(NAME=~"Cast('' as char(40)) As c_anagrafica_rag_soc_1~") COMPUTE(NAME=~"Cast('' as char(8)) As c_sog_commerciale_codice~") COMPUTE(NAME=~"Cast('' as char(40)) As c_anagrafica_b_rag_soc_1~") COMPUTE(NAME=~"Cast('' as char(32)) As c_codice_1~") COMPUTE(NAME=~"Cast('' as char(32)) As c_codice_2~") COMPUTE(NAME=~"Cast('' as char(32)) As c_codice_3~") COMPUTE(NAME=~"Cast('' as char(32)) As c_codice_4~") COMPUTE(NAME=~"Cast('' as char(32)) As c_codice_5~") COMPUTE(NAME=~"Cast('' as char(32)) As c_codice_6~") COMPUTE(NAME=~"Cast('' as char(32)) As c_codice_7~") COMPUTE(NAME=~"Cast('' as char(32)) As c_codice_8~") COMPUTE(NAME=~"Cast('' as char(32)) As c_codice_9~") COMPUTE(NAME=~"cast(0 as decimal(18,4)) as prezzo_for~") COMPUTE(NAME=~"cast(0 as decimal(6,2)) as coeff_calo~") COLUMN(NAME=~"articolo.giorni_invenduto~") COLUMN(NAME=~"articolo.id_cif~") COLUMN(NAME=~"articolo.costo_aggiuntivo~") COLUMN(NAME=~"articolo.immagine~") COLUMN(NAME=~"articolo.prod_interna~") COLUMN(NAME=~"articolo.id_lega~") COLUMN(NAME=~"articolo.id_titolo~") COLUMN(NAME=~"articolo.id_colore~") COLUMN(NAME=~"articolo.coef_calo~") COLUMN(NAME=~"articolo.id_pietra~") COLUMN(NAME=~"articolo.id_valuta~") COLUMN(NAME=~"articolo.id_unita_conf_base~") COMPUTE(NAME=~"cast(0 as decimal(18,4)) as prezzo~") COLUMN(NAME=~"articolo.id_sog_comm_variante~") COMPUTE(NAME=~"cast(null as char(8)) as c_sog_com_variante~") COMPUTE(NAME=~"cast(null as char(40)) as c_rag_soc_1_variante~") COLUMN(NAME=~"articolo.spina~") COLUMN(NAME=~"articolo.stampa_in_catalogo~") COLUMN(NAME=~"articolo.nota~")WHERE(    EXP1 =~"( ~~~"articolo~~~".~~~"id_azienda~~~"~"   OP =~"in~"    EXP2 =~"(0,1) )~" ) ) ORDER(NAME=~"articolo.codice~" ASC=yes ) " update="articolo" updatewhere=0 updatekeyinplace=no )
