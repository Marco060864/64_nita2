table(column=(type=long updatewhereclause=yes key=yes identity=yes name=id_articolo dbname="articolo.id_articolo" )
 column=(type=long updatewhereclause=yes name=id_cat_codifica dbname="articolo.id_cat_codifica" )
 column=(type=char(32) updatewhereclause=yes name=codice dbname="articolo.codice" )
 column=(type=char(80) updatewhereclause=yes name=descrizione dbname="articolo.descrizione" )
