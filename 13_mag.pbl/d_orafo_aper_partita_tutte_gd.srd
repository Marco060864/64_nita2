summary(height=0 color="553648127" )
footer(height=0 color="553648127" )
detail(height=72 color="536870912" )
table(column=(type=char(16) updatewhereclause=yes name=documento_num_documento dbname="documento.num_documento" )
 column=(type=date updatewhereclause=yes name=documento_data_documento dbname="documento.data_documento" )
 column=(type=decimal(2) update=yes updatewhereclause=yes name=orafo_aper_partita_val_apertura dbname="orafo_aper_partita.val_apertura" )
 column=(type=decimal(2) update=yes updatewhereclause=yes name=orafo_aper_partita_val_scarico dbname="orafo_aper_partita.val_scarico" initial="0" )
 column=(type=long updatewhereclause=yes name=sog_commerciale_gen_id_sog_commerciale dbname="sog_commerciale_gen.id_sog_commerciale" )
 column=(type=char(40) updatewhereclause=yes name=sog_commerciale_gen_rag_soc_1 dbname="sog_commerciale_gen.rag_soc_1" )
 column=(type=char(1) update=yes updatewhereclause=yes name=orafo_aper_partita_stato dbname="orafo_aper_partita.stato" )
 column=(type=long update=yes updatewhereclause=yes name=orafo_aper_partita_id_titolo dbname="orafo_aper_partita.id_titolo" )
 column=(type=long update=yes updatewhereclause=yes key=yes identity=yes name=orafo_aper_partita_id_partita dbname="orafo_aper_partita.id_partita" )
 column=(type=char(4) updatewhereclause=yes name=orafo_tipo_partita_cod_tipo_partita dbname="orafo_tipo_partita.cod_tipo_partita" )
 column=(type=char(2) updatewhereclause=yes name=orafo_metallo_codice dbname="orafo_metallo.codice" )
 column=(type=char(3) updatewhereclause=yes name=tipo dbname="tipo" )
 retrieve="  SELECT ~"documento~".~"num_documento~",   
         ~"documento~".~"data_documento~",   
         ~"orafo_aper_partita~".~"val_apertura~",   
         ~"orafo_aper_partita~".~"val_scarico~",   
         ~"sog_commerciale_gen~".~"id_sog_commerciale~",   
         ~"sog_commerciale_gen~".~"rag_soc_1~",   
         ~"orafo_aper_partita~".~"stato~",   
         ~"orafo_aper_partita~".~"id_titolo~",   
         ~"orafo_aper_partita~".~"id_partita~",   
         ~"orafo_tipo_partita~".~"cod_tipo_partita~",   
         ~"orafo_metallo~".~"codice~",   
         
			cast(substr( orafo_tipo_partita.cod_tipo_partita ,2,3) as char(3)) as tipo
    FROM ~"documento~",   
         ~"orafo_aper_partita~",   
         ~"sog_commerciale_gen~",   
         ~"orafo_tipo_partita~",   
         ~"orafo_metallo~",   
         ~"orafo_titolo~"  
   WHERE ( ~"orafo_aper_partita~".~"id_documento~" = ~"documento~".~"id_documento~" ) and  
         ( ~"documento~".~"id_sog_commerciale~" = ~"sog_commerciale_gen~".~"id_sog_commerciale~" ) and  
         ( ~"orafo_tipo_partita~".~"id_tipo_partita~" = ~"orafo_aper_partita~".~"id_tipo_partita~" ) and  
         ( ~"orafo_titolo~".~"id_metallo~" = ~"orafo_metallo~".~"id_metallo~" ) and  
         ( ~"orafo_titolo~".~"id_titolo~" = ~"orafo_aper_partita~".~"id_titolo~" ) and  
         ( ~"sog_commerciale_gen~".~"id_sog_commerciale~" >= :rn_id_sogg1 ) AND  
         ( ~"sog_commerciale_gen~".~"id_sog_commerciale~" <= :rn_id_sogg2 )    
" update="orafo_aper_partita" updatewhere=1 updatekeyinplace=yes arguments=(("rn_id_sogg1", number),("rn_id_sogg2", number))  sort="orafo_metallo_codice A orafo_tipo_partita_cod_tipo_partita A documento_data_documento A documento_num_documento A " )
