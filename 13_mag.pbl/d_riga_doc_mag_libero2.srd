table(column=(type=char(64) updatewhereclause=yes name=c_articolo_cod dbname="c_articolo_cod" )
 column=(type=long updatewhereclause=yes name=riga_documento_id_articolo dbname="riga_documento.id_articolo" dbalias=".id_articolo" )
 column=(type=char(32766) updatewhereclause=no name=riga_documento_descrizione dbname="riga_documento.descrizione" dbalias=".descrizione" )
 column=(type=decimal(4) updatewhereclause=yes name=riga_documento_quantita dbname="riga_documento.quantita" dbalias=".quantita" )
 column=(type=decimal(4) updatewhereclause=yes name=riga_documento_peso_netto dbname="riga_documento.peso_netto" dbalias=".peso_netto" )
 column=(type=decimal(4) updatewhereclause=yes name=riga_documento_peso_lordo dbname="riga_documento.peso_lordo" dbalias=".peso_lordo" )
 column=(type=decimal(4) updatewhereclause=yes name=riga_documento_dim_l dbname="riga_documento.dim_l" dbalias=".dim_l" )
 column=(type=char(2) updatewhereclause=yes name=c_galvanica dbname="c_galvanica" )
 retrieve="  SELECT    Cast(~"articolo~".~"codice~" as char(64)) As c_articolo_cod,
        
         ~"riga_documento~".~"id_articolo~",   
        ~"riga_documento~".~"descrizione~",  
         ~"riga_documento~".~"quantita~",   
        
         ~"riga_documento~".~"peso_netto~",   
         ~"riga_documento~".~"peso_lordo~",   
         ~"riga_documento~".~"dim_l~",   
     
//		   ~"riga_documento~".~"id_gruppo_agenti_2~"   ,
(select lavorazione from dba.galvanica where id_galvanica=~"riga_documento~".~"id_gruppo_agenti_2~") AS C_GALVANICA
	
     

		
    FROM {oj 
			 {oj
			  {oj ~"unita_confezione~"  LEFT OUTER JOIN ~"unita_misura~" unita_misura_a  ON ~"unita_confezione~".~"id_unita_mis_peso~" = ~"unita_misura_a~".~"id_unita_misura~"},
		     {oj ~"riga_documento~"  LEFT OUTER JOIN ~"caus_magazzino~"  ON ~"riga_documento~".~"id_caus_magazzino~" = ~"caus_magazzino~".~"id_caus_magazzino~"} 
			 LEFT OUTER JOIN ~"orafo_tipo_partita~"  ON ~"caus_magazzino~".~"id_tipo_partita~" = ~"orafo_tipo_partita~".~"id_tipo_partita~"}, 
		    {oj ~"unita_confezione~"  LEFT OUTER JOIN ~"unita_misura~" unita_misura_b  ON ~"unita_confezione~".~"id_unita_mis_volume~" = ~"unita_misura_b~".~"id_unita_misura~"}, 
			 {oj ~"riga_documento~"  LEFT OUTER JOIN ~"unita_confezione~"  ON ~"riga_documento~".~"id_unita_confezione~" = ~"unita_confezione~".~"id_unita_confezione~"} 
			LEFT OUTER JOIN ~"unita_misura~" unita_misura_c  ON ~"unita_confezione~".~"id_unita_misura~" = ~"unita_misura_c~".~"id_unita_misura~"}, 
			{oj ~"riga_documento~"  LEFT OUTER JOIN ~"des_articolo~"  ON ~"riga_documento~".~"id_des_articolo~" = ~"des_articolo~".~"id_des_articolo~"}, 
			{oj ~"articolo~"  LEFT OUTER JOIN ~"sog_commerciale_gen~"  ON ~"articolo~".~"id_sog_commerciale~" = ~"sog_commerciale_gen~".~"id_sog_commerciale~"},
			{oj ~"riga_documento~" LEFT OUTER JOIN ~"articolo~" ON ~"riga_documento~".~"id_articolo~"=~"articolo~".~"id_articolo~"},
			{oj ~"riga_documento~"  LEFT OUTER JOIN ~"riga_documento~" as riga_b  ON ~"riga_documento~".~"id_riga_doc_provenienza~" = riga_b.id_riga_documento}   
 WHERE ( ~"riga_documento~".~"id_azienda~" in (0,1) ) AND  
         (~"riga_documento~".~"id_documento~" = :ra_id_documento)    
//( ~"articolo~".~"id_articolo~" = ~"riga_documento~".~"id_articolo~" ) and  " filter="/* isnull(id_riga_doc_padre) */"arguments=(("ra_id_documento", number))  sort="c_articolo_cod A " )
