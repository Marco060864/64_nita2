 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"articolo~" )  TABLE(NAME=~"caus_magazzino~" )  TABLE(NAME=~"orafo_tipo_partita~" )  TABLE(NAME=~"riga_documento~" )  TABLE(NAME=~"orafo_titolo~" ) COLUMN(NAME=~"riga_documento.id_documento~") COLUMN(NAME=~"riga_documento.quantita~") COLUMN(NAME=~"orafo_tipo_partita.cod_tipo_partita~") COLUMN(NAME=~"orafo_tipo_partita.id_tipo_partita~") COLUMN(NAME=~"articolo.id_titolo~") COLUMN(NAME=~"riga_documento.peso_netto~") COLUMN(NAME=~"riga_documento.coef_calo~") COLUMN(NAME=~"riga_documento.calo~") COLUMN(NAME=~"riga_documento.fino~") COLUMN(NAME=~"orafo_titolo.titolo~") COLUMN(NAME=~"orafo_titolo.id_metallo~")    JOIN (LEFT=~"orafo_titolo.id_titolo~"    OP =~"=~"RIGHT=~"articolo.id_titolo~"    OUTER2 =~"articolo.id_titolo~" )    JOIN (LEFT=~"riga_documento.id_caus_magazzino~"    OP =~"=~"RIGHT=~"caus_magazzino.id_caus_magazzino~" )    JOIN (LEFT=~"riga_documento.id_articolo~"    OP =~"=~"RIGHT=~"articolo.id_articolo~" )    JOIN (LEFT=~"orafo_tipo_partita.id_tipo_partita~"    OP =~"=~"RIGHT=~"caus_magazzino.id_tipo_partita~" )WHERE(    EXP1 =~"~~~"riga_documento~~~".~~~"id_documento~~~"~"   OP =~"=~"    EXP2 =~":ra_id_documento~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"substr(~~~"orafo_tipo_partita~~~".~~~"cod_tipo_partita~~~", 1,1)~"   OP =~"=~"    EXP2 =~"'A'~" ) ) ARG(NAME = ~"ra_id_documento~" TYPE = number) " arguments=(("ra_id_documento", number))  sort="id_metallo A id_titolo A " )
