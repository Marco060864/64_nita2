table(column=(type=char(32) updatewhereclause=yes name=articolo_codice dbname="articolo.codice" )
 column=(type=char(80) updatewhereclause=yes name=articolo_descrizione dbname="articolo.descrizione" )
 column=(type=long update=yes updatewhereclause=yes key=yes name=id_variazione dbname="prezzo.id_variazione" )
 column=(type=char(8) updatewhereclause=yes name=c_unita_confezione_cod dbname="unita_confezione.codice" )
 column=(type=char(40) updatewhereclause=yes name=c_unita_confezione_des dbname="unita_confezione.descrizione" )
 column=(type=long update=yes updatewhereclause=yes key=yes name=id_unita_confezione dbname="prezzo.id_unita_confezione" )
 column=(type=long updatewhereclause=yes identity=yes name=id_articolo dbname="articolo.id_articolo" )
 column=(type=decimal(2) update=yes updatewhereclause=yes name=prezzo_coef_calo dbname="prezzo.coef_calo" )
 column=(type=long updatewhereclause=yes name=articolo_id_titolo dbname="articolo.id_titolo" )
 column=(type=long updatewhereclause=yes name=id_pietra dbname="articolo.id_pietra" initial="null" )
 column=(type=decimal(6) update=yes updatewhereclause=yes name=prezzo_prezzo dbname="prezzo.prezzo" )
 column=(type=decimal(6) update=yes updatewhereclause=yes name=prezzo_prezzo_manifattura dbname="prezzo.prezzo_manifattura" )
 column=(type=long updatewhereclause=yes name=listino_id_valuta dbname="listino.id_valuta" )
 column=(type=decimal(6) update=yes updatewhereclause=yes name=costo_imballo dbname="prezzo.costo_imballo" )
 column=(type=decimal(6) update=yes updatewhereclause=yes name=prezzo_galvanica dbname="prezzo.galvanica" )
 column=(type=long updatewhereclause=yes name=id_gruppo_articoli dbname="articolo.id_gruppo_articoli" )
 column=(type=long update=yes updatewhereclause=yes name=prezzo_id_galvanica dbname="prezzo.id_galvanica" )
 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"articolo~" )  TABLE(NAME=~"prezzo~" )  TABLE(NAME=~"unita_confezione~" )  TABLE(NAME=~"listino~" )  TABLE(NAME=~"variazione~" ) COLUMN(NAME=~"articolo.codice~") COLUMN(NAME=~"articolo.descrizione~") COLUMN(NAME=~"prezzo.id_variazione~") COLUMN(NAME=~"unita_confezione.codice~") COLUMN(NAME=~"unita_confezione.descrizione~") COLUMN(NAME=~"prezzo.id_unita_confezione~") COLUMN(NAME=~"articolo.id_articolo~") COLUMN(NAME=~"prezzo.coef_calo~") COLUMN(NAME=~"articolo.id_titolo~") COLUMN(NAME=~"articolo.id_pietra~") COLUMN(NAME=~"prezzo.prezzo~") COLUMN(NAME=~"prezzo.prezzo_manifattura~") COLUMN(NAME=~"listino.id_valuta~") COLUMN(NAME=~"prezzo.costo_imballo~") COLUMN(NAME=~"prezzo.galvanica~") COLUMN(NAME=~"articolo.id_gruppo_articoli~") COLUMN(NAME=~"prezzo.id_galvanica~")    JOIN (LEFT=~"unita_confezione.id_unita_confezione~"    OP =~"=~"RIGHT=~"prezzo.id_unita_confezione~" )    JOIN (LEFT=~"unita_confezione.id_articolo~"    OP =~"=~"RIGHT=~"articolo.id_articolo~" )    JOIN (LEFT=~"variazione.id_listino~"    OP =~"=~"RIGHT=~"listino.id_listino~" )    JOIN (LEFT=~"variazione.id_variazione~"    OP =~"=~"RIGHT=~"prezzo.id_variazione~" )WHERE(    EXP1 =~"( ( ~~~"prezzo~~~".~~~"id_variazione~~~"~"   OP =~"=~"    EXP2 =~":rn_id_variazione ) )~" ) ) ORDER(NAME=~"articolo.codice~" ASC=yes ) ARG(NAME = ~"rn_id_variazione~" TYPE = number) " update="prezzo" updatewhere=1 updatekeyinplace=yes arguments=(("rn_id_variazione", number)) )
