 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"riga_documento~" )  TABLE(NAME=~"caus_magazzino~" )  TABLE(NAME=~"documento~" )  TABLE(NAME=~"articolo~" )  TABLE(NAME=~"orafo_metallo~" )  TABLE(NAME=~"orafo_titolo~" ) COLUMN(NAME=~"riga_documento.calo~") COLUMN(NAME=~"riga_documento.fino~") COLUMN(NAME=~"caus_magazzino.segno~") COLUMN(NAME=~"orafo_metallo.codice~") COLUMN(NAME=~"caus_magazzino.segno_lire~") COLUMN(NAME=~"riga_documento.tot_riga_val_az~") COLUMN(NAME=~"caus_magazzino.saldi_cl_fino~") COLUMN(NAME=~"caus_magazzino.saldi_cl_lire~")    JOIN (LEFT=~"caus_magazzino.id_caus_magazzino~"    OP =~"=~"RIGHT=~"riga_documento.id_caus_magazzino~" )    JOIN (LEFT=~"documento.id_documento~"    OP =~"=~"RIGHT=~"riga_documento.id_documento~" )    JOIN (LEFT=~"articolo.id_articolo~"    OP =~"=~"RIGHT=~"riga_documento.id_articolo~" )    JOIN (LEFT=~"orafo_titolo.id_metallo~"    OP =~"=~"RIGHT=~"orafo_metallo.id_metallo~" )    JOIN (LEFT=~"orafo_titolo.id_titolo~"    OP =~"=~"RIGHT=~"articolo.id_titolo~" )WHERE(    EXP1 =~"(~~~"documento~~~".~~~"data_documento~~~"~"   OP =~">=~"    EXP2 =~":data_inizio_es~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"documento~~~".~~~"data_documento~~~"~"   OP =~"<=~"    EXP2 =~":a_data)~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"documento~~~".~~~"id_sog_commerciale~~~"~"   OP =~"=~"    EXP2 =~":id_sog~" ) ) ARG(NAME = ~"id_sog~" TYPE = number)  ARG(NAME = ~"a_data~" TYPE = date)  ARG(NAME = ~"data_inizio_es~" TYPE = date) " arguments=(("id_sog", number),("a_data", date),("data_inizio_es", date))  sort="orafo_metallo_codice A " )
