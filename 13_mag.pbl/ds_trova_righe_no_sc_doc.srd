 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"orafo_scar_partita~" )  TABLE(NAME=~"riga_documento~" )  TABLE(NAME=~"orafo_tipo_partita~" )  TABLE(NAME=~"caus_magazzino~" ) COLUMN(NAME=~"riga_documento.calo~") COLUMN(NAME=~"riga_documento.fino~") COLUMN(NAME=~"riga_documento.id_riga_documento~") COLUMN(NAME=~"riga_documento.id_documento~") COLUMN(NAME=~"riga_documento.num_riga~") COLUMN(NAME=~"riga_documento.peso_netto~") COLUMN(NAME=~"orafo_scar_partita.id_partita~") COLUMN(NAME=~"orafo_scar_partita.val_scarico~") COLUMN(NAME=~"riga_documento.id_riga_partita~") COLUMN(NAME=~"orafo_tipo_partita.cod_tipo_partita~")    JOIN (LEFT=~"riga_documento.id_riga_partita~"    OP =~"=~"RIGHT=~"orafo_scar_partita.id_riga_documento~"    OUTER1 =~"riga_documento.id_riga_partita~" )    JOIN (LEFT=~"caus_magazzino.id_tipo_partita~"    OP =~"=~"RIGHT=~"orafo_tipo_partita.id_tipo_partita~" )    JOIN (LEFT=~"caus_magazzino.id_caus_magazzino~"    OP =~"=~"RIGHT=~"riga_documento.id_caus_magazzino~" )WHERE(    EXP1 =~"~~~"riga_documento~~~".~~~"id_documento~~~"~"   OP =~"=~"    EXP2 =~":rn_id_doc~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"substr(~~~"orafo_tipo_partita~~~".~~~"cod_tipo_partita~~~", 1,1)~"   OP =~"=~"    EXP2 =~"'S'~" ) ) ARG(NAME = ~"rn_id_doc~" TYPE = number) " arguments=(("rn_id_doc", number))  sort="riga_documento_id_riga_partita A " )
