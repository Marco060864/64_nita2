 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"unita_confezione~" )  TABLE(NAME=~"unita_misura~" ALIAS=~"unita_misura_a~" )  TABLE(NAME=~"unita_misura~" ALIAS=~"unita_misura_b~" )  TABLE(NAME=~"unita_misura~" ALIAS=~"unita_misura_c~" ) COLUMN(NAME=~"unita_confezione.id_unita_confezione~") COLUMN(NAME=~"unita_confezione.id_articolo~") COLUMN(NAME=~"unita_confezione.codice~") COLUMN(NAME=~"unita_confezione.descrizione~") COLUMN(NAME=~"unita_confezione.app_conversione~") COLUMN(NAME=~"unita_confezione.fat_conversione~") COLUMN(NAME=~"unita_confezione.tipo_conversione~") COLUMN(NAME=~"unita_confezione.molteplicita~") COLUMN(NAME=~"unita_confezione.qta_minima~") COLUMN(NAME=~"unita_confezione.qta_massima~") COLUMN(NAME=~"unita_confezione.id_unita_mis_peso~") COLUMN(NAME=~"unita_confezione.peso_netto~") COLUMN(NAME=~"unita_confezione.peso_lordo~") COLUMN(NAME=~"unita_confezione.id_unita_mis_volume~") COLUMN(NAME=~"unita_confezione.dim_l~") COLUMN(NAME=~"unita_confezione.dim_h~") COLUMN(NAME=~"unita_confezione.dim_p~") COLUMN(NAME=~"unita_confezione.unita_base~") COLUMN(NAME=~"unita_confezione.unita_prezzo~") COLUMN(NAME=~"unita_confezione.unita_documenti~") COLUMN(NAME=~"unita_confezione.unita_produzione~") COLUMN(NAME=~"unita_confezione.id_azienda~") COLUMN(NAME=~"unita_misura_a.simbolo~") COLUMN(NAME=~"unita_misura_a.descrizione~") COLUMN(NAME=~"unita_misura_b.simbolo~") COLUMN(NAME=~"unita_misura_b.descrizione~") COLUMN(NAME=~"unita_misura_c.simbolo~") COLUMN(NAME=~"unita_misura_c.descrizione~")    JOIN (LEFT=~"unita_confezione.id_unita_mis_volume~"    OP =~"=~"RIGHT=~"unita_misura_c.id_unita_misura~"    OUTER1 =~"unita_confezione.id_unita_mis_volume~" )    JOIN (LEFT=~"unita_confezione.id_unita_mis_peso~"    OP =~"=~"RIGHT=~"unita_misura_b.id_unita_misura~"    OUTER1 =~"unita_confezione.id_unita_mis_peso~" )    JOIN (LEFT=~"unita_misura_a.id_unita_misura~"    OP =~"=~"RIGHT=~"unita_confezione.id_unita_misura~"    OUTER2 =~"unita_confezione.id_unita_misura~" )WHERE(    EXP1 =~" ~~~"unita_confezione~~~".~~~"id_azienda~~~"~"   OP =~"in~"    EXP2 =~"(0,1) ~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"unita_confezione~~~".~~~"id_articolo~~~"~"   OP =~"=~"    EXP2 =~":ra_id_articolo~" ) ) ARG(NAME = ~"ra_id_articolo~" TYPE = number) " update="unita_confezione" updatewhere=1 updatekeyinplace=yes arguments=(("ra_id_articolo", number)) )
