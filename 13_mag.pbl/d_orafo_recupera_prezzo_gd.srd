 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"con_lis_articolo~" )  TABLE(NAME=~"articolo~" ALIAS=~"articolo_a~" )  TABLE(NAME=~"articolo~" ALIAS=~"articolo_b~" )  TABLE(NAME=~"valuta~" ) COLUMN(NAME=~"con_lis_articolo.id_con_lis_articolo~") COLUMN(NAME=~"con_lis_articolo.applicazione~") COLUMN(NAME=~"con_lis_articolo.id_unita_confezione~") COLUMN(NAME=~"con_lis_articolo.id_sog_commerciale~") COLUMN(NAME=~"con_lis_articolo.id_cat_com_sc~") COLUMN(NAME=~"con_lis_articolo.id_art_da~") COLUMN(NAME=~"con_lis_articolo.id_cat_com_articolo~") COLUMN(NAME=~"con_lis_articolo.id_sog_commerciale_fornitore~") COLUMN(NAME=~"con_lis_articolo.id_anagrafica~") COLUMN(NAME=~"con_lis_articolo.id_listino~") COLUMN(NAME=~"con_lis_articolo.data_inizio~") COLUMN(NAME=~"con_lis_articolo.data_fine~") COLUMN(NAME=~"con_lis_articolo.qta_minima~") COLUMN(NAME=~"con_lis_articolo.qta_massima~") COLUMN(NAME=~"con_lis_articolo.tipo_applicazione~") COLUMN(NAME=~"con_lis_articolo.id_valuta~") COLUMN(NAME=~"con_lis_articolo.importo~") COLUMN(NAME=~"con_lis_articolo.percentuali~") COLUMN(NAME=~"con_lis_articolo.priorita~") COLUMN(NAME=~"con_lis_articolo.id_art_a~") COLUMN(NAME=~"articolo_a.codice~") COLUMN(NAME=~"articolo_b.codice~") COLUMN(NAME=~"con_lis_articolo.spesa~") COLUMN(NAME=~"con_lis_articolo.spesa_fissa~") COLUMN(NAME=~"valuta.cambio~") COLUMN(NAME=~"con_lis_articolo.coef_calo~")    JOIN (LEFT=~"articolo_a.id_articolo~"    OP =~"=~"RIGHT=~"con_lis_articolo.id_art_da~"    OUTER2 =~"con_lis_articolo.id_art_da~" )    JOIN (LEFT=~"articolo_b.id_articolo~"    OP =~"=~"RIGHT=~"con_lis_articolo.id_art_a~"    OUTER2 =~"con_lis_articolo.id_art_a~" )    JOIN (LEFT=~"valuta.id_valuta~"    OP =~"=~"RIGHT=~"con_lis_articolo.id_valuta~"    OUTER2 =~"con_lis_articolo.id_valuta~" )WHERE(    EXP1 =~"~~~"con_lis_articolo~~~".~~~"data_inizio~~~"~"   OP =~"<=~"    EXP2 =~":ra_data_attuale~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"ifnull(~~~"con_lis_articolo~~~".~~~"data_fine~~~", date('2200/01/01'),~~~"con_lis_articolo~~~".~~~"data_fine~~~")~"   OP =~">=~"    EXP2 =~":ra_data_attuale~" ) ) ORDER(NAME=~"con_lis_articolo.priorita~" ASC=no) ARG(NAME = ~"ra_data_attuale~" TYPE = date) " arguments=(("ra_data_attuale", date))  sort="priorita D " )
