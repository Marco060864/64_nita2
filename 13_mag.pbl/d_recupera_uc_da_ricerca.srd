 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"unita_confezione~" )  TABLE(NAME=~"unita_misura~" ALIAS=~"unita_misura_a~" )  TABLE(NAME=~"unita_misura~" ALIAS=~"unita_misura_b~" )  TABLE(NAME=~"unita_misura~" ALIAS=~"unita_misura_c~" ) COLUMN(NAME=~"unita_confezione.id_unita_mis_peso~") COLUMN(NAME=~"unita_confezione.id_unita_misura~") COLUMN(NAME=~"unita_confezione.id_unita_mis_volume~") COLUMN(NAME=~"unita_confezione.dim_l~") COLUMN(NAME=~"unita_confezione.conv_misura_peso~") COLUMN(NAME=~"unita_misura_a.simbolo~") COLUMN(NAME=~"unita_misura_a.descrizione~") COLUMN(NAME=~"unita_misura_b.simbolo~") COLUMN(NAME=~"unita_misura_b.descrizione~") COLUMN(NAME=~"unita_misura_c.simbolo~") COLUMN(NAME=~"unita_misura_c.descrizione~") COLUMN(NAME=~"unita_misura_c.tipo~")    JOIN (LEFT=~"unita_misura_a.id_unita_misura~"    OP =~"=~"RIGHT=~"unita_confezione.id_unita_mis_peso~" )    JOIN (LEFT=~"unita_misura_b.id_unita_misura~"    OP =~"=~"RIGHT=~"unita_confezione.id_unita_mis_volume~" )    JOIN (LEFT=~"unita_misura_c.id_unita_misura~"    OP =~"=~"RIGHT=~"unita_confezione.id_unita_misura~" )WHERE(    EXP1 =~"~~~"unita_confezione~~~".~~~"id_unita_confezione~~~"~"   OP =~"=~"    EXP2 =~":rn_id_uc~" ) ) ARG(NAME = ~"rn_id_uc~" TYPE = number) " arguments=(("rn_id_uc", number)) )
