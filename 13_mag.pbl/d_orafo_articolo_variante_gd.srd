 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"articolo~" )  TABLE(NAME=~"cat_codifica~" )  TABLE(NAME=~"parte_regola~" )  TABLE(NAME=~"sog_commerciale_gen~" ) COLUMN(NAME=~"articolo.id_articolo~") COLUMN(NAME=~"articolo.id_cat_codifica~") COLUMN(NAME=~"articolo.codice~") COLUMN(NAME=~"articolo.descrizione~") COLUMN(NAME=~"articolo.des_breve~") COLUMN(NAME=~"articolo.prod_interna~") COLUMN(NAME=~"articolo.id_titolo~") COLUMN(NAME=~"articolo.id_lega~") COLUMN(NAME=~"articolo.id_colore~") COLUMN(NAME=~"articolo.coef_calo~") COLUMN(NAME=~"parte_regola.variante~") COLUMN(NAME=~"cat_codifica.codice~") COLUMN(NAME=~"articolo.stato~") COLUMN(NAME=~"sog_commerciale_gen.codice~") COLUMN(NAME=~"sog_commerciale_gen.rag_soc_1~") COLUMN(NAME=~"articolo.id_sog_comm_variante~")    JOIN (LEFT=~"articolo.id_sog_comm_variante~"    OP =~"=~"RIGHT=~"sog_commerciale_gen.id_sog_commerciale~"    OUTER1 =~"articolo.id_sog_comm_variante~" )    JOIN (LEFT=~"cat_codifica.id_cat_codifica~"    OP =~"=~"RIGHT=~"articolo.id_cat_codifica~" )    JOIN (LEFT=~"parte_regola.id_scomposizione~"    OP =~"=~"RIGHT=~"cat_codifica.id_scomposizione~" )WHERE(    EXP1 =~"( ~~~"parte_regola~~~".~~~"variante~~~"~"   OP =~"=~"    EXP2 =~"'S' )~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"articolo~~~".~~~"codice~~~"~"   OP =~"like~"    EXP2 =~":rs_codice~" ) ) ARG(NAME = ~"rs_codice~" TYPE = string) " arguments=(("rs_codice", string))  sort="sog_commerciale_gen_codice A sog_commerciale_gen_rag_soc_1 A " )
