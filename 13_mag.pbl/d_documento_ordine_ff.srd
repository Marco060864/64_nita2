AME=~"documento.id_documento~") COMPUTE(NAME=~"CAST (null as numeric(18,4)) as c_imp_acconto_convertito~") COLUMN(NAME=~"prof_documento.ric_acconti~") COMPUTE(NAME=~"CAST('' as char(8)) as c_sog_comm_2_cod~") COMPUTE(NAME=~"CAST('' as char(40)) as c_sog_comm_2_des~") COLUMN(NAME=~"documento.ora_registrazione~") COLUMN(NAME=~"documento.id_locazione_1~") COLUMN(NAME=~"documento.id_locazione_2~") COLUMN(NAME=~"documento.storno_anticipi~") COLUMN(NAME=~"documento.id_variazione~") COLUMN(NAME=~"documento.bollo~") COMPUTE(NAME=~"CAST(0 AS DECIMAL(18,4)) AS tara~") COLUMN(NAME=~"documento.data_ora_creazione~") COLUMN(NAME=~"documento.id_gruppo_agenti_2~") COLUMN(NAME=~"documento.scarica_ogni_titolo~") COLUMN(NAME=~"documento.data_ric_consegna~") COLUMN(NAME=~"documento.imp_avanzo_acconto~") COLUMN(NAME=~"documento.id_utenti~") COLUMN(NAME=~"documento.ordinato_fo~")    JOIN (LEFT=~"prof_documento.id_prof_documento~"    OP =~"=~"RIGHT=~"documento.id_prof_documento~" )) " update="documento" updatewhere=1 updatekeyinplace=yes )
