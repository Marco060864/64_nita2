table(column=(type=decimal(2) updatewhereclause=yes name=val_apertura dbname="orafo_aper_partita.val_apertura" )
 column=(type=decimal(2) updatewhereclause=yes name=val_scarico dbname="orafo_aper_partita.val_scarico" )
 column=(type=decimal(0) updatewhereclause=yes name=num_progressivo dbname="documento.num_progressivo" )
 column=(type=char(1) updatewhereclause=yes name=stato dbname="orafo_aper_partita.stato" values="	A/	C" )
 column=(type=date updatewhereclause=yes name=data_registrazione dbname="documento.data_registrazione" )
 column=(type=long updatewhereclause=yes identity=yes name=id_partita dbname="orafo_aper_partita.id_partita" )
 column=(type=long updatewhereclause=yes name=id_documento dbname="orafo_aper_partita.id_documento" )
 column=(type=long updatewhereclause=yes name=id_tipo_partita dbname="orafo_aper_partita.id_tipo_partita" )
 column=(type=long updatewhereclause=yes name=id_titolo dbname="orafo_aper_partita.id_titolo" )
 column=(type=long updatewhereclause=yes name=id_sog_commerciale dbname="documento.id_sog_commerciale" )
 column=(type=decimal(4) updatewhereclause=yes name=qta_da_scaricare dbname="somma_da_scaricare" )
 column=(type=decimal(2) updatewhereclause=yes name=titolo dbname="orafo_titolo.titolo" )
 column=(type=char(4) updatewhereclause=yes name=cod_tipo_partita dbname="orafo_tipo_partita.cod_tipo_partita" )
 column=(type=char(2) updatewhereclause=yes name=metallo_codice dbname="orafo_metallo.codice" )
 column=(type=decimal(2) updatewhereclause=yes name=coef_calo dbname="coef_calo" )
 column=(type=decimal(2) updatewhereclause=yes name=qta_zoppa dbname="qta_zoppa" )
 column=(type=char(16) updatewhereclause=yes name=documento_num_documento dbname="documento.num_documento" )
 column=(type=date updatewhereclause=yes name=documento_data_documento dbname="documento.data_documento" )
 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"orafo_aper_partita~" )  TABLE(NAME=~"documento~" )  TABLE(NAME=~"orafo_titolo~" )  TABLE(NAME=~"orafo_tipo_partita~" )  TABLE(NAME=~"orafo_metallo~" ) COLUMN(NAME=~"orafo_aper_partita.val_apertura~") COLUMN(NAME=~"orafo_aper_partita.val_scarico~") COLUMN(NAME=~"documento.num_progressivo~") COLUMN(NAME=~"orafo_aper_partita.stato~") COLUMN(NAME=~"documento.data_registrazione~") COLUMN(NAME=~"orafo_aper_partita.id_partita~") COLUMN(NAME=~"orafo_aper_partita.id_documento~") COLUMN(NAME=~"orafo_aper_partita.id_tipo_partita~") COLUMN(NAME=~"orafo_aper_partita.id_titolo~") COLUMN(NAME=~"documento.id_sog_commerciale~") COMPUTE(NAME=~"cast(0 as numeric(18,4)) as somma_da_scaricare~") COLUMN(NAME=~"orafo_titolo.titolo~") COLUMN(NAME=~"orafo_tipo_partita.cod_tipo_partita~") COLUMN(NAME=~"orafo_metallo.codice~") COMPUTE(NAME=~"cast(0 as numeric(6,2)) as coef_calo~") COMPUTE(NAME=~"cast(0 as numeric(18,2)) as qta_zoppa~") COLUMN(NAME=~"documento.num_documento~") COLUMN(NAME=~"documento.data_documento~")    JOIN (LEFT=~"documento.id_documento~"    OP =~"=~"RIGHT=~"orafo_aper_partita.id_documento~" )    JOIN (LEFT=~"orafo_aper_partita.id_titolo~"    OP =~"=~"RIGHT=~"orafo_titolo.id_titolo~" )    JOIN (LEFT=~"orafo_tipo_partita.id_tipo_partita~"    OP =~"=~"RIGHT=~"orafo_aper_partita.id_tipo_partita~" )    JOIN (LEFT=~"orafo_metallo.id_metallo~"    OP =~"=~"RIGHT=~"orafo_titolo.id_metallo~" )WHERE(    EXP1 =~"( ~~~"documento~~~".~~~"id_sog_commerciale~~~"~"   OP =~"=~"    EXP2 =~":ra_id_sog_com )~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"( (~~~"orafo_aper_partita~~~".~~~"id_titolo~~~"~"   OP =~"=~"    EXP2 =~":ra_id_titolo )~"    LOGIC =~"or~" ) WHERE(    EXP1 =~"( ~~~"orafo_aper_partita~~~".~~~"id_titolo~~~"~"   OP =~"=~"    EXP2 =~"(select id_titolo from orafo_titolo where titolo=1000) ) )~" ) ) ORDER(NAME=~"documento.data_documento~" ASC=yes ) ARG(NAME = ~"ra_id_sog_com~" TYPE = number)  ARG(NAME = ~"ra_id_titolo~" TYPE = number) " arguments=(("ra_id_sog_com", number),("ra_id_titolo", number)) )
