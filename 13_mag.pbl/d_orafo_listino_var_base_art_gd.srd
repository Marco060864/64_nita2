 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"listino_variazione~" )  TABLE(NAME=~"variazione~" )  TABLE(NAME=~"prezzo~" ) COLUMN(NAME=~"listino_variazione.list_codice~") COLUMN(NAME=~"listino_variazione.list_descrizione~") COLUMN(NAME=~"listino_variazione.prezzo~") COLUMN(NAME=~"listino_variazione.conf_codice~") COLUMN(NAME=~"listino_variazione.conf_descrizione~") COLUMN(NAME=~"listino_variazione.id_articolo~") COLUMN(NAME=~"listino_variazione.id_listino~") COLUMN(NAME=~"variazione.data_inizio~") COLUMN(NAME=~"variazione.data_fine~") COLUMN(NAME=~"listino_variazione.unita_base~") COLUMN(NAME=~"listino_variazione.coef_calo~") COLUMN(NAME=~"listino_variazione.prezzo_manifattura~") COLUMN(NAME=~"prezzo.ultima_modifica~") COLUMN(NAME=~"prezzo.id_utente~") COLUMN(NAME=~"prezzo.id_unita_confezione~") COLUMN(NAME=~"prezzo.id_variazione~") COLUMN(NAME=~"prezzo.ult_modifica_2~")    JOIN (LEFT=~"listino_variazione.id_variazione~"    OP =~"=~"RIGHT=~"variazione.id_variazione~"    OUTER1 =~"listino_variazione.id_variazione~" )    JOIN (LEFT=~"listino_variazione.id_variazione~"    OP =~"=~"RIGHT=~"prezzo.id_variazione~"    OUTER1 =~"listino_variazione.id_variazione~" )    JOIN (LEFT=~"listino_variazione.id_unita_confezione~"    OP =~"=~"RIGHT=~"prezzo.id_unita_confezione~"    OUTER1 =~"listino_variazione.id_unita_confezione~" )WHERE(    EXP1 =~"~~~"listino_variazione~~~".~~~"id_articolo~~~"~"   OP =~"=~"    EXP2 =~":rn_id_articolo~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"listino_variazione~~~".~~~"unita_base~~~"~"   OP =~"=~"    EXP2 =~"'S'~" ) ) ARG(NAME = ~"rn_id_articolo~" TYPE = number) " update="prezzo" updatewhere=1 updatekeyinplace=yes arguments=(("rn_id_articolo", number)) )
