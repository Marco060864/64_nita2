 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"des_articolo~" )  TABLE(NAME=~"sog_commerciale~" )  TABLE(NAME=~"linguaggio~" )  TABLE(NAME=~"articolo~" )  TABLE(NAME=~"anagrafica~" ) COLUMN(NAME=~"des_articolo.id_des_articolo~") COLUMN(NAME=~"des_articolo.id_sog_commerciale~") COLUMN(NAME=~"sog_commerciale.codice~") COLUMN(NAME=~"anagrafica.rag_soc_1~") COLUMN(NAME=~"linguaggio.codice~") COLUMN(NAME=~"linguaggio.descrizione~") COLUMN(NAME=~"des_articolo.descrizione~") COLUMN(NAME=~"des_articolo.des_estesa~") COLUMN(NAME=~"des_articolo.id_articolo~") COLUMN(NAME=~"articolo.descrizione~") COLUMN(NAME=~"articolo.codice~") COLUMN(NAME=~"des_articolo.id_lingua~") COLUMN(NAME=~"des_articolo.codice~") COLUMN(NAME=~"des_articolo.simbolo_um~") COLUMN(NAME=~"des_articolo.lunghezza~")    JOIN (LEFT=~"des_articolo.id_sog_commerciale~"    OP =~"=~"RIGHT=~"sog_commerciale.id_sog_commerciale~"    OUTER1 =~"des_articolo.id_sog_commerciale~" )    JOIN (LEFT=~"des_articolo.id_linguaggio~"    OP =~"=~"RIGHT=~"linguaggio.id_linguaggio~"    OUTER1 =~"des_articolo.id_linguaggio~" )    JOIN (LEFT=~"des_articolo.id_articolo~"    OP =~"=~"RIGHT=~"articolo.id_articolo~"    OUTER1 =~"des_articolo.id_articolo~" )    JOIN (LEFT=~"sog_commerciale.id_anagrafica~"    OP =~"=~"RIGHT=~"anagrafica.id_anagrafica~"    OUTER1 =~"sog_commerciale.id_anagrafica~" )WHERE(    EXP1 =~"( ~~~"des_articolo~~~".~~~"id_azienda~~~"~"   OP =~"in~"    EXP2 =~"(0,1) )~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"( ~~~"des_articolo~~~".~~~"id_articolo~~~"~"   OP =~"=~"    EXP2 =~":rn_id_articolo )~" ) ) ARG(NAME = ~"rn_id_articolo~" TYPE = number) " update="des_articolo" updatewhere=1 updatekeyinplace=yes arguments=(("rn_id_articolo", number)) )
