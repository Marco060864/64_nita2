 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"orafo_aper_partita~" )  TABLE(NAME=~"orafo_scar_partita~" ALIAS=~"orafo_scar_partita_a~" )  TABLE(NAME=~"orafo_scar_partita~" ALIAS=~"orafo_scar_partita_b~" )  TABLE(NAME=~"riga_documento~" ALIAS=~"riga_documento_a~" )  TABLE(NAME=~"documento~" ALIAS=~"documento_a~" )  TABLE(NAME=~"riga_documento~" ALIAS=~"riga_documento_b~" )  TABLE(NAME=~"documento~" ALIAS=~"documento_b~" ) COLUMN(NAME=~"orafo_aper_partita.id_partita~") COLUMN(NAME=~"orafo_aper_partita.id_documento~") COLUMN(NAME=~"orafo_aper_partita.val_apertura~") COLUMN(NAME=~"orafo_aper_partita.val_scarico~") COLUMN(NAME=~"orafo_aper_partita.id_titolo~") COLUMN(NAME=~"orafo_scar_partita_a.id_partita~") COLUMN(NAME=~"orafo_scar_partita_a.id_riga_documento~") COLUMN(NAME=~"orafo_scar_partita_a.val_scarico~") COLUMN(NAME=~"orafo_scar_partita_b.id_partita~") COLUMN(NAME=~"orafo_scar_partita_b.id_riga_documento~") COLUMN(NAME=~"orafo_scar_partita_b.val_scarico~") COLUMN(NAME=~"riga_documento_a.id_riga_documento~") COLUMN(NAME=~"documento_a.num_documento~") COLUMN(NAME=~"riga_documento_b.num_riga~") COLUMN(NAME=~"documento_b.num_documento~") COLUMN(NAME=~"documento_b.data_documento~")    JOIN (LEFT=~"orafo_scar_partita_a.id_partita~"    OP =~"=~"RIGHT=~"orafo_aper_partita.id_partita~" )    JOIN (LEFT=~"orafo_scar_partita_b.id_partita~"    OP =~"=~"RIGHT=~"orafo_aper_partita.id_partita~" )    JOIN (LEFT=~"riga_documento_a.id_documento~"    OP =~"=~"RIGHT=~"documento_a.id_documento~" )    JOIN (LEFT=~"riga_documento_a.id_riga_partita~"    OP =~"=~"RIGHT=~"orafo_scar_partita_b.id_riga_documento~" )    JOIN (LEFT=~"riga_documento_b.id_riga_partita~"    OP =~"=~"RIGHT=~"orafo_scar_partita_a.id_riga_documento~" )    JOIN (LEFT=~"riga_documento_b.id_documento~"    OP =~"=~"RIGHT=~"documento_b.id_documento~" )WHERE(    EXP1 =~"~~~"riga_documento_a~~~".~~~"id_riga_documento~~~"~"   OP =~"=~"    EXP2 =~"254~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"((~~~"documento_b~~~".~~~"num_documento~~~"~"   OP =~"=~"    EXP2 =~"~~~"documento_a~~~".~~~"num_documento~~~"~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"riga_documento_b~~~".~~~"num_riga~~~"~"   OP =~"<=~"    EXP2 =~"~~~"riga_documento_a~~~".~~~"num_riga~~~")~"    LOGIC =~"or~" ) WHERE(    EXP1 =~"~~~"documento_b~~~".~~~"num_documento~~~"~"   OP =~"<~"    EXP2 =~"~~~"documento_a~~~".~~~"num_documento~~~")~" ) ) " )
