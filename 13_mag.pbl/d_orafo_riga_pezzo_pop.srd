 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"riga_documento~" )  TABLE(NAME=~"caus_magazzino~" )  TABLE(NAME=~"documento~" )  TABLE(NAME=~"articolo~" )  TABLE(NAME=~"orafo_metallo~" )  TABLE(NAME=~"orafo_titolo~" )  TABLE(NAME=~"orafo_tipo_partita~" ) COLUMN(NAME=~"orafo_metallo.codice~") COLUMN(NAME=~"caus_magazzino.segno_pezzi~") COLUMN(NAME=~"orafo_tipo_partita.cod_tipo_partita~") COLUMN(NAME=~"riga_documento.quantita~")    JOIN (LEFT=~"caus_magazzino.id_caus_magazzino~"    OP =~"=~"RIGHT=~"riga_documento.id_caus_magazzino~" )    JOIN (LEFT=~"documento.id_documento~"    OP =~"=~"RIGHT=~"riga_documento.id_documento~" )    JOIN (LEFT=~"articolo.id_articolo~"    OP =~"=~"RIGHT=~"riga_documento.id_articolo~" )    JOIN (LEFT=~"orafo_titolo.id_metallo~"    OP =~"=~"RIGHT=~"orafo_metallo.id_metallo~" )    JOIN (LEFT=~"orafo_titolo.id_titolo~"    OP =~"=~"RIGHT=~"articolo.id_titolo~" )    JOIN (LEFT=~"orafo_tipo_partita.id_tipo_partita~"    OP =~"=~"RIGHT=~"caus_magazzino.id_tipo_partita~" )WHERE(    EXP1 =~"(~~~"documento~~~".~~~"data_documento~~~"~"   OP =~">=~"    EXP2 =~":data_inizio_es~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"documento~~~".~~~"data_documento~~~"~"   OP =~"<=~"    EXP2 =~":a_data)~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"documento~~~".~~~"id_sog_commerciale~~~"~"   OP =~"=~"    EXP2 =~":id_sog~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"caus_magazzino~~~".~~~"segno_pezzi~~~"~"   OP =~">~"    EXP2 =~"''~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"riga_documento~~~".~~~"id_articolo~~~"~"   OP =~"=~"    EXP2 =~":id_art~" ) ) ARG(NAME = ~"id_sog~" TYPE = number)  ARG(NAME = ~"a_data~" TYPE = date)  ARG(NAME = ~"data_inizio_es~" TYPE = date)  ARG(NAME = ~"id_art~" TYPE = number) " arguments=(("id_sog", number),("a_data", date),("data_inizio_es", date),("id_art", number))  sort="orafo_metallo_codice A " )
