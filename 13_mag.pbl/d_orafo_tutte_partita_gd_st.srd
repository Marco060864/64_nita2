table(column=(type=char(16) updatewhereclause=yes name=documento_num_documento dbname="documento.num_documento" )
 column=(type=date updatewhereclause=yes name=documento_data_documento dbname="documento.data_documento" )
 column=(type=decimal(2) updatewhereclause=yes name=orafo_aper_partita_val_apertura dbname="orafo_aper_partita.val_apertura" )
 column=(type=decimal(2) updatewhereclause=yes name=orafo_aper_partita_val_scarico dbname="orafo_aper_partita.val_scarico" )
 column=(type=long updatewhereclause=yes identity=yes name=sog_commerciale_gen_id_sog_commerciale dbname="sog_commerciale_gen.id_sog_commerciale" )
 column=(type=char(40) updatewhereclause=yes name=sog_commerciale_gen_rag_soc_1 dbname="sog_commerciale_gen.rag_soc_1" )
 column=(type=char(1) updatewhereclause=yes name=orafo_aper_partita_stato dbname="orafo_aper_partita.stato" )
 column=(type=long updatewhereclause=yes name=orafo_aper_partita_id_titolo dbname="orafo_aper_partita.id_titolo" )
 column=(type=long updatewhereclause=yes identity=yes name=orafo_aper_partita_id_partita dbname="orafo_aper_partita.id_partita" )
 column=(type=decimal(2) updatewhereclause=yes name=orafo_titolo_titolo dbname="orafo_titolo.titolo" )
 retrieve="  SELECT ~"documento~".~"num_documento~",   
         ~"documento~".~"data_documento~",   
         ~"orafo_aper_partita~".~"val_apertura~",   
         ~"orafo_aper_partita~".~"val_scarico~",   
         ~"sog_commerciale_gen~".~"id_sog_commerciale~",   
         ~"sog_commerciale_gen~".~"rag_soc_1~",   
         ~"orafo_aper_partita~".~"stato~",   
         ~"orafo_aper_partita~".~"id_titolo~",   
         ~"orafo_aper_partita~".~"id_partita~",   
         ~"orafo_titolo~".~"titolo~"  
    FROM ~"documento~",   
         ~"orafo_aper_partita~",   
         ~"sog_commerciale_gen~",   
         ~"orafo_titolo~"  
   WHERE ( ~"orafo_aper_partita~".~"id_documento~" = ~"documento~".~"id_documento~" ) and  
         ( ~"documento~".~"id_sog_commerciale~" = ~"sog_commerciale_gen~".~"id_sog_commerciale~" ) and  
         ( ~"orafo_titolo~".~"id_titolo~" = ~"orafo_aper_partita~".~"id_titolo~" ) and  
         ( ( ~"sog_commerciale_gen~".~"id_sog_commerciale~" >= :rn_id_sogg1 ) AND  
         ( ~"sog_commerciale_gen~".~"id_sog_commerciale~" <= :rn_id_sogg2 ))        



 " arguments=(("rn_id_sogg1", number),("rn_id_sogg2", number)) )
