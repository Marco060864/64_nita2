~") COLUMN(NAME=~"prezzo.prezzo_manifattura~") COLUMN(NAME=~"prezzo.prezzo_complessivo~") COLUMN(NAME=~"prezzo.coef_calo~")    JOIN (LEFT=~"orafo_colore.id_colore~"    OP =~"=~"RIGHT=~"articolo.id_colore~"    OUTER2 =~"articolo.id_colore~" )    JOIN (LEFT=~"orafo_lega.id_lega~"    OP =~"=~"RIGHT=~"articolo.id_lega~"    OUTER2 =~"articolo.id_lega~" )    JOIN (LEFT=~"orafo_titolo.id_titolo~"    OP =~"=~"RIGHT=~"articolo.id_titolo~"    OUTER2 =~"articolo.id_titolo~" )    JOIN (LEFT=~"orafo_metallo.id_metallo~"    OP =~"=~"RIGHT=~"orafo_titolo.id_metallo~"    OUTER2 =~"orafo_titolo.id_metallo~" )    JOIN (LEFT=~"magazzino.id_magazzino~"    OP =~"=~"RIGHT=~"locazione.id_magazzino~"    OUTER2 =~"locazione.id_magazzino~" )    JOIN (LEFT=~"riepilogo.id_locazione~"    OP =~"=~"RIGHT=~"locazione.id_locazione~"    OUTER1 =~"riepilogo.id_locazione~" )    JOIN (LEFT=~"riepilogo.id_articolo~"    OP =~"=~"RIGHT=~"articolo.id_articolo~"    OUTER2 =~"articolo.id_articolo~" )    JOIN (LEFT=~"unita_misura.id_unita_misura~"    OP =~"=~"RIGHT=~"unita_confezione.id_unita_mis_peso~"    OUTER2 =~"unita_confezione.id_unita_mis_peso~" )    JOIN (LEFT=~"articolo.id_articolo~"    OP =~"=~"RIGHT=~"unita_confezione.id_articolo~"    OUTER1 =~"articolo.id_articolo~" )    JOIN (LEFT=~"prezzo.id_unita_confezione~"    OP =~"=~"RIGHT=~"unita_confezione.id_unita_confezione~"    OUTER2 =~"unita_confezione.id_unita_confezione~" )WHERE(    EXP1 =~"~~~"unita_confezione~~~".~~~"unita_base~~~"~"   OP =~"=~"    EXP2 =~"'S'~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"prezzo~~~".~~~"id_variazione~~~"~"   OP =~"=~"    EXP2 =~":ra_id_variazione~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"riepilogo~~~".~~~"anno~~~"~"   OP =~"=~"    EXP2 =~":ra_anno~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"riepilogo~~~".~~~"mese~~~"~"   OP =~">~"    EXP2 =~":ra_mese~" ) ) ARG(NAME = ~"ra_id_variazione~" TYPE = number)  ARG(NAME = ~"ra_anno~" TYPE = number)  ARG(NAME = ~"ra_mese~" TYPE = number) " arguments=(("ra_id_variazione", 