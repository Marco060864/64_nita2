table(column=(type=char(32) updatewhereclause=yes name=articolo_codice dbname="articolo.codice" )
 column=(type=char(80) updatewhereclause=yes name=articolo_descrizione dbname="articolo.descrizione" )
 column=(type=long update=yes updatewhereclause=yes key=yes name=id_variazione dbname="prezzo.id_variazione" )
 column=(type=char(8) updatewhereclause=yes name=c_unita_confezione_cod dbname="unita_confezione.codice" )
 column=(type=char(40) updatewhereclause=yes name=c_unita_confezione_des dbname="unita_confezione.descrizione" )
 column=(type=long update=yes updatewhereclause=yes key=yes name=id_unita_confezione dbname="prezzo.id_unita_confezione" )
 column=(type=long updatewhereclause=yes name=id_articolo dbname="articolo.id_articolo" )
 column=(type=char(1) updatewhereclause=yes name=cstato dbname="stato" )
 column=(type=decimal(4) update=yes updatewhereclause=yes name=prezzo_prezzo dbname="prezzo.prezzo" )
 column=(type=decimal(2) update=yes updatewhereclause=yes name=coef_calo dbname="prezzo.coef_calo" )
 column=(type=decimal(4) update=yes updatewhereclause=yes name=prezzo_manifattura dbname="prezzo.prezzo_manifattura" )
 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"articolo~" )  TABLE(NAME=~"prezzo~" )  TABLE(NAME=~"unita_confezione~" ) COLUMN(NAME=~"articolo.codice~") COLUMN(NAME=~"articolo.descrizione~") COLUMN(NAME=~"prezzo.id_variazione~") COLUMN(NAME=~"unita_confezione.codice~") COLUMN(NAME=~"unita_confezione.descrizione~") COLUMN(NAME=~"prezzo.id_unita_confezione~") COLUMN(NAME=~"articolo.id_articolo~") COMPUTE(NAME=~"'N' as stato~") COLUMN(NAME=~"prezzo.prezzo~") COLUMN(NAME=~"prezzo.coef_calo~") COLUMN(NAME=~"prezzo.prezzo_manifattura~")    JOIN (LEFT=~"unita_confezione.id_unita_confezione~"    OP =~"=~"RIGHT=~"prezzo.id_unita_confezione~" )    JOIN (LEFT=~"unita_confezione.id_articolo~"    OP =~"=~"RIGHT=~"articolo.id_articolo~" )WHERE(    EXP1 =~"( ( ~~~"prezzo~~~".~~~"id_variazione~~~"~"   OP =~"=~"    EXP2 =~":rn_id_variazione ) )~" ) ) ORDER(NAME=~"articolo.codice~" ASC=yes )  ORDER(NAME=~"unita_confezione.codice~" ASC=yes ) ARG(NAME = ~"rn_id_variazione~" TYPE = number) " update="prezzo" updatewhere=1 updatekeyinplace=yes arguments=(("rn_id_variazione", number)) )
