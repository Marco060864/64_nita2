 column=(type=decimal(2) updatewhereclause=yes name=orafo_metallo_val_arrotondamento dbname="orafo_metallo.val_arrotondamento" )
 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"orafo_aper_partita~" )  TABLE(NAME=~"documento~" )  TABLE(NAME=~"orafo_titolo~" )  TABLE(NAME=~"orafo_tipo_partita~" )  TABLE(NAME=~"orafo_metallo~" ) COLUMN(NAME=~"orafo_aper_partita.val_apertura~") COLUMN(NAME=~"orafo_aper_partita.val_scarico~") COLUMN(NAME=~"documento.num_progressivo~") COLUMN(NAME=~"orafo_aper_partita.stato~") COLUMN(NAME=~"documento.data_registrazione~") COLUMN(NAME=~"orafo_aper_partita.id_partita~") COLUMN(NAME=~"orafo_aper_partita.id_documento~") COLUMN(NAME=~"orafo_aper_partita.id_tipo_partita~") COLUMN(NAME=~"orafo_aper_partita.id_titolo~") COLUMN(NAME=~"documento.id_sog_commerciale~") COMPUTE(NAME=~"cast(0 as numeric(18,4)) as somma_da_scaricare~") COLUMN(NAME=~"orafo_titolo.titolo~") COLUMN(NAME=~"orafo_tipo_partita.cod_tipo_partita~") COLUMN(NAME=~"orafo_metallo.codice~") COMPUTE(NAME=~"cast(0 as numeric(6,2)) as coef_calo~") COMPUTE(NAME=~"cast(0 as numeric(18,2)) as qta_zoppa~") COLUMN(NAME=~"documento.num_documento~") COLUMN(NAME=~"documento.data_documento~") COLUMN(NAME=~"documento.data_ora_creazione~") COLUMN(NAME=~"orafo_metallo.val_arrotondamento~")    JOIN (LEFT=~"documento.id_documento~"    OP =~"=~"RIGHT=~"orafo_aper_partita.id_documento~" )    JOIN (LEFT=~"orafo_aper_partita.id_titolo~"    OP =~"=~"RIGHT=~"orafo_titolo.id_titolo~" )    JOIN (LEFT=~"orafo_tipo_partita.id_tipo_partita~"    OP =~"=~"RIGHT=~"orafo_aper_partita.id_tipo_partita~" )    JOIN (LEFT=~"orafo_metallo.id_metallo~"    OP =~"=~"RIGHT=~"orafo_titolo.id_metallo~" )WHERE(    EXP1 =~"( ~~~"documento~~~".~~~"id_sog_commerciale~~~"~"   OP =~"=~"    EXP2 =~":ra_id_sog_com )~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"documento~~~".~~~"data_ora_creazione~~~"~"   OP =~"<=~"    EXP2 =~":rdt_data_ora~" ) ) ORDER(NAME=~"documento.data_documento~" ASC=yes ) ARG(NAME = ~"ra_id_sog_com~" TYPE = number)  ARG(NAME = ~"rdt_data_ora~" TYPE = datetime) " update="orafo_aper_partita" updatewhere=1 updatekeyinplace=yes arguments=(("ra_id_sog_com", number),("rdt_data_ora", datetime)) )
