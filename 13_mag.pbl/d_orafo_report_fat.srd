 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"orafo_aper_partita~" )  TABLE(NAME=~"orafo_scar_partita~" ALIAS=~"orafo_scar_partita_a~" )  TABLE(NAME=~"riga_documento~" ALIAS=~"riga_documento_a~" )  TABLE(NAME=~"orafo_scar_partita~" ALIAS=~"orafo_scar_partita_b~" )  TABLE(NAME=~"documento~" ALIAS=~"documento_a~" )  TABLE(NAME=~"documento~" ALIAS=~"documento_b~" )  TABLE(NAME=~"riga_documento~" ALIAS=~"riga_documento_b~" )  TABLE(NAME=~"riga_documento~" ALIAS=~"riga_documento_c~" )  TABLE(NAME=~"riga_documento~" ALIAS=~"riga_documento_d~" ) COLUMN(NAME=~"orafo_scar_partita_b.val_scarico~") COLUMN(NAME=~"orafo_aper_partita.val_apertura~") COLUMN(NAME=~"documento_b.id_documento~") COLUMN(NAME=~"riga_documento_b.num_riga~") COLUMN(NAME=~"documento_a.num_documento~") COLUMN(NAME=~"documento_b.num_documento~") COLUMN(NAME=~"orafo_aper_partita.id_partita~")    JOIN (LEFT=~"orafo_scar_partita_b.id_partita~"    OP =~"=~"RIGHT=~"orafo_aper_partita.id_partita~" )    JOIN (LEFT=~"orafo_scar_partita_a.id_partita~"    OP =~"=~"RIGHT=~"orafo_aper_partita.id_partita~" )    JOIN (LEFT=~"documento_b.id_documento~"    OP =~"=~"RIGHT=~"riga_documento_b.id_documento~" )    JOIN (LEFT=~"riga_documento_c.id_riga_documento~"    OP =~"=~"RIGHT=~"riga_documento_a.id_riga_doc_provenienza~" )    JOIN (LEFT=~"documento_a.id_documento~"    OP =~"=~"RIGHT=~"riga_documento_c.id_documento~" )    JOIN (LEFT=~"riga_documento_d.id_riga_documento~"    OP =~"=~"RIGHT=~"riga_documento_a.id_riga_doc_provenienza~" )    JOIN (LEFT=~"orafo_scar_partita_a.id_riga_documento~"    OP =~"=~"RIGHT=~"riga_documento_d.id_riga_partita~" )    JOIN (LEFT=~"riga_documento_b.id_riga_partita~"    OP =~"=~"RIGHT=~"orafo_scar_partita_b.id_riga_documento~" )    JOIN (LEFT=~"documento_a.num_documento~"    OP =~"<=~"RIGHT=~"documento_b.num_documento~" )WHERE(    EXP1 =~"~~~"riga_documento_a~~~".~~~"id_documento~~~"~"   OP =~"=~"    EXP2 =~"213~" ) ) "  sort="orafo_aper_partita_id_partita A riga_documento_num_riga A documento_id_documento A " )
