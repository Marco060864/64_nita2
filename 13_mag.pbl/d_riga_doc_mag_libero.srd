table(column=(type=long updatewhereclause=yes name=riga_documento_id_articolo dbname="riga_documento.id_articolo" dbalias=".id_articolo" )
 column=(type=char(64) updatewhereclause=yes name=c_articolo dbname="c_articolo" )
 column=(type=char(3) updatewhereclause=yes name=c_spessore dbname="c_spessore" )
 column=(type=char(2) updatewhereclause=yes name=c_galvanica dbname="c_galvanica" )
 column=(type=decimal(4) updatewhereclause=yes name=riga_documento_dim_l dbname="riga_documento.dim_l" dbalias=".dim_l" )
 column=(type=decimal(4) updatewhereclause=yes name=riga_documento_quantita dbname="riga_documento.quantita" dbalias=".quantita" )
 column=(type=decimal(4) updatewhereclause=yes name=riga_documento_peso_netto dbname="riga_documento.peso_netto" dbalias=".peso_netto" )
 retrieve=" SELECT  ~"riga_documento~".~"id_articolo~",  
 
(if charindex('_',~"articolo~".~"codice~" )>4 then left(~"articolo~".~"codice~", charindex('_',~"articolo~".~"codice~" ) - 4) else ~"articolo~".~"codice~"  end if) as c_articolo ,
(substring(~"articolo~".~"codice~", charindex('_',~"articolo~".~"codice~" ) - 3, 3)) as c_spessore,

(select lavorazione from dba.galvanica where id_galvanica=~"riga_documento~".~"id_gruppo_agenti_2~") AS C_GALVANICA,
          ~"riga_documento~".~"dim_l~",   
                        ~"riga_documento~".~"quantita~",         ~"riga_documento~".~"peso_netto~"

       
     

	
    FROM 		   	    ~"unita_confezione~", 		
			 ~"riga_documento~", ~"articolo~"
	  
 WHERE  unita_confezione.id_unita_confezione=riga_documento.id_unita_confezione and unita_confezione.id_articolo=articolo.id_articolo 
and unita_confezione.unita_base='S'  and
         (~"riga_documento~".~"id_documento~" = :ra_id_documento) " arguments=(("ra_id_documento", number)) )
