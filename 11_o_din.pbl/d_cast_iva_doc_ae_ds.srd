 retrieve="PBSELECT( VERSION(400) DISTINCT ()TABLE(NAME=~"cast_iva_documento~" )  TABLE(NAME=~"tab_iva~" ) COLUMN(NAME=~"cast_iva_documento.id_tab_iva~") COLUMN(NAME=~"cast_iva_documento.val_omaggi~") COLUMN(NAME=~"cast_iva_documento.val_imp_scontato~") COLUMN(NAME=~"cast_iva_documento.val_spese~") COLUMN(NAME=~"cast_iva_documento.val_tot_imp_v~") COLUMN(NAME=~"cast_iva_documento.val_tot_iva_v~") COLUMN(NAME=~"tab_iva.codice~") COLUMN(NAME=~"tab_iva.des_breve~") COLUMN(NAME=~"tab_iva.des_estesa~") COLUMN(NAME=~"tab_iva.tipo_iva~") COLUMN(NAME=~"tab_iva.per_aliquota~") COLUMN(NAME=~"cast_iva_documento.val_imponibile~") COLUMN(NAME=~"cast_iva_documento.val_tot_imp_l~") COLUMN(NAME=~"cast_iva_documento.val_tot_iva_l~") COLUMN(NAME=~"tab_iva.natura~") COLUMN(NAME=~"tab_iva.esigibilita~")    JOIN (LEFT=~"cast_iva_documento.id_tab_iva~"    OP =~"=~"RIGHT=~"tab_iva.id_tab_iva~" )WHERE(    EXP1 =~"~~~"cast_iva_documento~~~".~~~"id_documento~~~"~"   OP =~"=~"    EXP2 =~":al_id_documento~" ) ) ARG(NAME = ~"al_id_documento~" TYPE = number) " arguments=(("al_id_documento", number)) )
