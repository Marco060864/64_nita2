 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"lista_oggetti~" ) COLUMN(NAME=~"lista_oggetti.pos_y~") COLUMN(NAME=~"lista_oggetti.pos_x~") COLUMN(NAME=~"lista_oggetti.oggetto~") COLUMN(NAME=~"lista_oggetti.id_conf_oggetti~") COLUMN(NAME=~"lista_oggetti.larghezza~") COLUMN(NAME=~"lista_oggetti.lunghezza~") COLUMN(NAME=~"lista_oggetti.spostabile~") COLUMN(NAME=~"lista_oggetti.ridimensionabile~") COLUMN(NAME=~"lista_oggetti.banda~") COLUMN(NAME=~"lista_oggetti.tipo~") COLUMN(NAME=~"lista_oggetti.bordo~")WHERE(    EXP1 =~"( ~~~"lista_oggetti~~~".~~~"id_conf_oggetti~~~"~"   OP =~"=~"    EXP2 =~":al_id_conf )~" ) ) ARG(NAME = ~"al_id_conf~" TYPE = number) " update="lista_oggetti" updatewhere=1 updatekeyinplace=yes arguments=(("al_id_conf", number))  sort="oggetto A " )
