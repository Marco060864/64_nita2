 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"documento~" )  TABLE(NAME=~"anagrafica~" )  TABLE(NAME=~"sog_commerciale~" ) COLUMN(NAME=~"documento.id_documento~") COLUMN(NAME=~"documento.num_progressivo~") COLUMN(NAME=~"documento.data_registrazione~") COLUMN(NAME=~"documento.num_documento~") COLUMN(NAME=~"documento.data_documento~") COLUMN(NAME=~"documento.id_sog_commerciale~") COLUMN(NAME=~"anagrafica.rag_soc_1~") COLUMN(NAME=~"sog_commerciale.codice~") COLUMN(NAME=~"documento.peso_netto~")    JOIN (LEFT=~"documento.id_sog_commerciale~"    OP =~"=~"RIGHT=~"sog_commerciale.id_sog_commerciale~" )    JOIN (LEFT=~"sog_commerciale.id_anagrafica~"    OP =~"=~"RIGHT=~"anagrafica.id_anagrafica~" )WHERE(    EXP1 =~"~~~"documento~~~".~~~"id_prof_documento~~~"~"   OP =~"=~"    EXP2 =~":id_prof_doc~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"documento~~~".~~~"id_sog_commerciale~~~"~"   OP =~"=~"    EXP2 =~":id_sog~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"documento~~~".~~~"data_documento~~~"~"   OP =~">=~"    EXP2 =~":da_data~" ) ) ARG(NAME = ~"id_prof_doc~" TYPE = number)  ARG(NAME = ~"id_sog~" TYPE = number)  ARG(NAME = ~"da_data~" TYPE = date) " arguments=(("id_prof_doc", number),("id_sog", number),("da_data", date))  sort="data_documento A documento_num_progressivo A " )
