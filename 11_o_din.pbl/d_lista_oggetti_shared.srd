release 6;
datawindow(units=0 timer_interval=0 color=16777215 processing=1 print.documentname="" print.orientation = 0 print.margin.left = 110 print.margin.right = 110 print.margin.top = 96 print.margin.bottom = 96 print.paper.source = 0 print.paper.size = 0 print.prompt=no print.buttons=no print.preview.buttons=no grid.lines=0 )
header(height=56 color="553648127~tif(isRowModified(), rgb(0, 255, 255), rgb(255,255,255))" )
summary(height=0 color="536870912" )
footer(height=0 color="536870912" )
detail(height=72 color="553648127~tif( oggetto = oggetto [-1], 255, if( pos_y <0 or  pos_x <0, rgb(255,0,255),rgb(255,255,255)))"  height.autosize=yes)
table(column=(type=decimal(3) updatewhereclause=yes name=pos_y dbname="lista_oggetti.pos_y" )
 column=(type=decimal(3) updatewhereclause=yes name=pos_x dbname="lista_oggetti.pos_x" )
 column=(type=char(255) updatewhereclause=yes key=yes name=oggetto dbname="lista_oggetti.oggetto" )
 column=(type=long updatewhereclause=yes key=yes name=id_conf_oggetti dbname="lista_oggetti.id_conf_oggetti" )
 column=(type=decimal(3) updatewhereclause=yes name=larghezza dbname="lista_oggetti.larghezza" )
 column=(type=decimal(3) updatewhereclause=yes name=lunghezza dbname="lista_oggetti.lunghezza" )
 column=(type=long updatewhereclause=yes name=spostabile dbname="lista_oggetti.spostabile" )
 column=(type=long updatewhereclause=yes name=ridimensionabile dbname="lista_oggetti.ridimensionabile" )
 column=(type=char(32) updatewhereclause=yes name=banda dbname="lista_oggetti.banda" )
 column=(type=char(16) updatewhereclause=yes name=tipo dbname="lista_oggetti.tipo" )
 column=(type=long updatewhereclause=yes name=bordo dbname="lista_oggetti.bordo" )
 column=(type=long updatewhereclause=yes name=primo_piano dbname="lista_oggetti.primo_piano" )
 column=(type=char(32766) updatewhereclause=no name=visibile dbname="lista_oggetti.visibile" )
 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"lista_oggetti~" ) COLUMN(NAME=~"lista_oggetti.pos_y~") COLUMN(NAME=~"lista_oggetti.pos_x~") COLUMN(NAME=~"lista_oggetti.oggetto~") COLUMN(NAME=~"lista_oggetti.id_conf_oggetti~") COLUMN(NAME=~"lista_oggetti.larghezza~") COLUMN(NAME=~"lista_oggetti.lunghezza~") COLUMN(NAME=~"lista_oggetti.spostabile~") COLUMN(NAME=~"lista_oggetti.ridimensionabile~") COLUMN(NAME=~"lista_oggetti.banda~") COLUMN(NAME=~"lista_oggetti.tipo~") COLUMN(NAME=~"lista_oggetti.bordo~") COLUMN(NAME=~"lista_oggetti.primo_piano~") COLUMN(NAME=~"lista_oggetti.visibile~")WHERE(    EXP1 =~"( ~~~"lista_oggetti~~~".~~~"id_conf_oggetti~~~"~"   OP =~"=~"    EXP2 =~":al_id_conf )~" ) ) ARG(NAME = ~"al_id_conf~" TYPE = number) " update="lista_oggetti" updatewhere=0 updatekeyinplace=no arguments=(("al_id_conf", number))  sort="oggetto A " )
