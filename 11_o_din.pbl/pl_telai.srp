PIPELINE(source_connect=nita,destination_connect=nita,type=update,commit=100,errors=100,keyname="mdb_telai")
SOURCE(name="telai",COLUMN(type=long,name="id",dbtype="integer",nulls_allowed=no)
 COLUMN(type=varchar,name="commessa",dbtype="VARCHAR(30)",nulls_allowed=yes)
 COLUMN(type=long,name="frame",dbtype="INTEGER",nulls_allowed=yes)
 COLUMN(type=long,name="state",dbtype="INTEGER",nulls_allowed=yes)
 COLUMN(type=long,name="pezzi",dbtype="INTEGER",nulls_allowed=yes))
RETRIEVE(statement="SELECT telai.id, telai.commessa, telai.frame, telai.state, telai.pezzi FROM telai")
DESTINATION(name="mdb_telai",COLUMN(type=long,name="id",dbtype="integer",key=yes,nulls_allowed=no,initial_value="0")
 COLUMN(type=varchar,name="commessa",dbtype="varchar(30)",nulls_allowed=no,initial_value="spaces")
 COLUMN(type=long,name="frame",dbtype="integer",nulls_allowed=yes)
 COLUMN(type=long,name="state",dbtype="integer",nulls_allowed=yes)
 COLUMN(type=long,name="pezzi",dbtype="integer",nulls_allowed=yes))
