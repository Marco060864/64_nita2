table(column=(type=long update=yes updatewhereclause=yes name=id_documento dbname="spesa_documento.id_documento" dbalias=".id_documento" )
 column=(type=long update=yes updatewhereclause=yes name=id_spesa_cod dbname="spesa_documento.id_spesa" dbalias=".id_spesa" )
 column=(type=decimal(2) update=yes updatewhereclause=yes name=percentuale dbname="spesa_documento.percentuale" dbalias=".percentuale" validation=" real(gettext())  >= 0 AND  real(gettext())  <= 100" validationmsg="'Immettere un valore fra 0 e 100'" )
 column=(type=decimal(4) update=yes updatewhereclause=yes name=importo dbname="spesa_documento.importo" dbalias=".importo" )
 column=(type=long update=yes updatewhereclause=yes identity=yes name=id_tab_iva_cod dbname="spesa_documento.id_tab_iva" dbalias=".id_tab_iva" )
 column=(type=char(1) updatewhereclause=yes name=cc_mod_calc_iva dbname="c_mod_calc_iva" )
 column=(type=decimal(0) updatewhereclause=yes name=cc_importo_buffer dbname="c_importo_buffer" )
 column=(type=char(1) update=yes updatewhereclause=yes name=mantieni dbname="spesa_documento.mantieni" dbalias=".mantieni" initial="S" values="	S/	N" )
 column=(type=char(1) updatewhereclause=yes name=spesa_codice dbname="spesa.codice" dbalias=".codice" )
 column=(type=char(40) updatewhereclause=yes name=spesa_descrizione dbname="spesa.descrizione" dbalias=".descrizione" )
 column=(type=char(8) updatewhereclause=yes name=tab_iva_codice dbname="tab_iva.codice" dbalias=".codice" )
 column=(type=char(32766) updatewhereclause=no name=tab_iva_des_estesa dbname="tab_iva.des_estesa" dbalias=".des_estesa" )
 column=(type=decimal(2) updatewhereclause=yes name=tab_iva_per_aliquota dbname="tab_iva.per_aliquota" dbalias=".per_aliquota" )
 column=(type=char(4) updatewhereclause=yes name=tab_iva_natura dbname="tab_iva.natura" dbalias=".natura" )
 column=(type=char(1) updatewhereclause=yes name=tab_iva_esigibilita dbname="tab_iva.esigibilita" dbalias=".esigibilita" )
 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"spesa_documento~" )  TABLE(NAME=~"spesa~" )  TABLE(NAME=~"tab_iva~" ) COLUMN(NAME=~"spesa_documento.id_documento~") COLUMN(NAME=~"spesa_documento.id_spesa~") COLUMN(NAME=~"spesa_documento.percentuale~") COLUMN(NAME=~"spesa_documento.importo~") COLUMN(NAME=~"spesa_documento.id_tab_iva~") COMPUTE(NAME=~"CAST( ~~~"spesa~~~".~~~"mod_cal_iva~~~" as char(1)) as c_mod_calc_iva~") COMPUTE(NAME=~"CAST( 0  as decimal) as c_importo_buffer~") COLUMN(NAME=~"spesa_documento.mantieni~") COLUMN(NAME=~"spesa.codice~") COLUMN(NAME=~"spesa.descrizione~") COLUMN(NAME=~"tab_iva.codice~") COLUMN(NAME=~"tab_iva.des_estesa~") COLUMN(NAME=~"tab_iva.per_aliquota~") COLUMN(NAME=~"tab_iva.natura~") COLUMN(NAME=~"tab_iva.esigibilita~")    JOIN (LEFT=~"spesa.id_spesa~"    OP =~"=~"RIGHT=~"spesa_documento.id_spesa~" )    JOIN (LEFT=~"tab_iva.id_tab_iva~"    OP =~"=~"RIGHT=~"spesa_documento.id_tab_iva~" )WHERE(    EXP1 =~"( ( ~~~"spesa_documento~~~".~~~"id_documento~~~"~"   OP =~"=~"    EXP2 =~":ra_id_documento ) )~" ) ) ARG(NAME = ~"ra_id_documento~" TYPE = number) " arguments=(("ra_id_documento", number)) )
