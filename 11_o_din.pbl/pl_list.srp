PIPELINE(source_connect=nita,destination_connect=nita,type=update,commit=100,errors=100,keyname="mdb_list")
SOURCE(name="list",COLUMN(type=long,name="id",dbtype="integer",key=yes,nulls_allowed=no)
 COLUMN(type=varchar,name="commessa",dbtype="VARCHAR(30)",nulls_allowed=yes)
 COLUMN(type=long,name="frame",dbtype="INTEGER",nulls_allowed=yes)
 COLUMN(type=long,name="station",dbtype="INTEGER",nulls_allowed=yes)
 COLUMN(type=double,name="volt",dbtype="DOUBLE",nulls_allowed=yes)
 COLUMN(type=double,name="ampere",dbtype="DOUBLE",nulls_allowed=yes)
 COLUMN(type=long,name="tempo",dbtype="INTEGER",nulls_allowed=yes)
 COLUMN(type=long,name="scatti",dbtype="INTEGER",nulls_allowed=yes)
 COLUMN(type=datetime,name="time_in",dbtype="timestamp",nulls_allowed=yes)
 COLUMN(type=datetime,name="time_out",dbtype="timestamp",nulls_allowed=yes)
 COLUMN(type=long,name="alarm",dbtype="INTEGER",nulls_allowed=yes))
RETRIEVE(statement="SELECT list.id, list.commessa, list.frame, list.station, list.volt, list.ampere, list.tempo, list.scatti, list.time_in, list.time_out, list.alarm FROM list")
DESTINATION(name="mdb_list",COLUMN(type=long,name="id",dbtype="integer",key=yes,nulls_allowed=no,initial_value="0")
 COLUMN(type=varchar,name="commessa",dbtype="varchar(30)",nulls_allowed=no,initial_value="spaces")
 COLUMN(type=long,name="frame",dbtype="integer",nulls_allowed=yes)
 COLUMN(type=long,name="station",dbtype="integer",nulls_allowed=no,initial_value="0")
 COLUMN(type=double,name="volt",dbtype="double",nulls_allowed=yes)
 COLUMN(type=double,name="ampere",dbtype="double",nulls_allowed=yes)
 COLUMN(type=long,name="tempo",dbtype="integer",nulls_allowed=yes)
 COLUMN(type=long,name="scatti",dbtype="integer",nulls_allowed=yes)
 COLUMN(type=datetime,name="time_in",dbtype="timestamp",nulls_allowed=no,initial_value="today")
 COLUMN(type=datetime,name="time_out",dbtype="timestamp",nulls_allowed=no,initial_value="today")
 COLUMN(type=long,name="alarm",dbtype="integer",nulls_allowed=yes))
