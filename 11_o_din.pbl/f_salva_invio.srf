global type f_salva_invio from function_object
end type

forward prototypes
global subroutine f_salva_invio (long al_id_doc, string as_allegato)
end prototypes

global subroutine f_salva_invio (long al_id_doc, string as_allegato);datetime ldt_data_ora_invio 
long ll_id_invio, ll_prog_invio

select data_ora_invio
into :ldt_data_ora_invio
from dba.FE_invio
where id_documento=:al_id_doc
;
if string(ldt_data_ora_invio, "yyyy-mm-dd hh:mm")> string(datetime("2018-12-01"),"yyyy-mm-dd hh:mm")   then
	if messagebox("Incredibile!", "Il documento è stato già inviato una volta ("+ string(ldt_data_ora_invio, "yyyy-mm-dd hh:mm")+"). Com'è possibile????", stopsign!, yesno!)=2 then
		return
	end if
end if
ldt_data_ora_invio=datetime(today(), now())
select max(id_invio_fe)
into :ll_id_invio
from dba.fe_invio
;
if isnull(ll_id_invio) then ll_id_invio=0
ll_id_invio++
//recupero il num_prog dell'invio
//devo aprire l'allegato (xml) cercare "num_progressivo" e prenderlo e metterlo in in tabella fe_invio (per ora non serve)

insert into dba.fe_invio (id_invio_fe, data_ora_invio, id_documento)
values (:ll_id_invio, :ldt_data_ora_invio, :al_id_doc)
;
if sqlca.sqlcode=0 then
	commit;
else
	rollback;
	messagebox("Attenzione!", "L'invio NON è stato registrato nella tabella degli invii (FE_invio): CONTROLLARE prima di inviare un altro documento!!!!")
end if
end subroutine

