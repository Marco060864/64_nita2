PIPELINE(source_connect=nita,destination_connect=nita,type=update,commit=100,errors=100,keyname="mdb_commesse")
SOURCE(name="commesse",COLUMN(type=long,name="id",dbtype="integer",nulls_allowed=no)
 COLUMN(type=varchar,name="commessa",dbtype="VARCHAR(30)",nulls_allowed=yes)
 COLUMN(type=varchar,name="committente",dbtype="VARCHAR(250)",nulls_allowed=yes)
 COLUMN(type=varchar,name="articolo",dbtype="VARCHAR(250)",nulls_allowed=yes)
 COLUMN(type=long,name="pezzi",dbtype="INTEGER",nulls_allowed=yes))
RETRIEVE(statement="SELECT commesse.id, commesse.commessa, commesse.committente, commesse.articolo, commesse.pezzi FROM commesse")
DESTINATION(name="mdb_commesse",COLUMN(type=long,name="id",dbtype="integer",key=yes,nulls_allowed=no,initial_value="0")
 COLUMN(type=varchar,name="commessa",dbtype="varchar(30)",nulls_allowed=no,initial_value="spaces")
 COLUMN(type=varchar,name="committente",dbtype="varchar(250)",nulls_allowed=yes)
 COLUMN(type=varchar,name="articolo",dbtype="varchar(250)",nulls_allowed=yes)
 COLUMN(type=long,name="pezzi",dbtype="integer",nulls_allowed=yes))
