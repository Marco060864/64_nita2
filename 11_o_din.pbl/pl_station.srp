PIPELINE(source_connect=common,destination_connect=nita,type=update,commit=100,errors=100,keyname="mdb_station")
SOURCE(name="station",COLUMN(type=long,name="id",dbtype="COUNTER",key=yes,nulls_allowed=no)
 COLUMN(type=long,name="numb_station",dbtype="INTEGER",nulls_allowed=yes)
 COLUMN(type=varchar,name="name_station",dbtype="VARCHAR(50)",nulls_allowed=yes)
 COLUMN(type=long,name="type_station",dbtype="INTEGER",nulls_allowed=yes))
RETRIEVE(statement="SELECT station.id, station.numb_station, station.name_station, station.type_station FROM station")
DESTINATION(name="mdb_station",COLUMN(type=long,name="id",dbtype="integer",key=yes,nulls_allowed=no,initial_value="0")
 COLUMN(type=long,name="numb_station",dbtype="integer",nulls_allowed=no,initial_value="0")
 COLUMN(type=varchar,name="name_station",dbtype="varchar(50)",nulls_allowed=yes)
 COLUMN(type=long,name="type_station",dbtype="integer",nulls_allowed=yes))
