global function string f_crea_fat_e (long al_id_doc);PBDOM_BUILDER pbdom_bldr
PBDOM_DOCUMENT pbdom_doc
pbdom_doctype pbdom_doctype_1
pbdom_element pbdom_elem_1
pbdom_element pbdom_elem_root
