 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"documento~" ALIAS=~"documento_a~" )  TABLE(NAME=~"riga_documento~" ALIAS=~"riga_documento_a~" )  TABLE(NAME=~"riga_documento~" ALIAS=~"riga_documento_b~" )  TABLE(NAME=~"documento~" ALIAS=~"documento_b~" ) COLUMN(NAME=~"documento_a.id_documento~") COLUMN(NAME=~"documento_a.num_progressivo~") COLUMN(NAME=~"documento_a.data_registrazione~") COLUMN(NAME=~"documento_a.num_documento~") COLUMN(NAME=~"documento_a.data_documento~") COLUMN(NAME=~"riga_documento_a.id_riga_documento~") COLUMN(NAME=~"riga_documento_a.num_riga~") COLUMN(NAME=~"riga_documento_a.id_articolo~") COLUMN(NAME=~"riga_documento_a.descrizione~") COLUMN(NAME=~"riga_documento_a.quantita~") COLUMN(NAME=~"riga_documento_a.peso_netto~") COLUMN(NAME=~"documento_b.num_documento~") COLUMN(NAME=~"riga_documento_a.provv_imp_carea_2~") COMPUTE(NAME=~"0 as c_ordina~") COMPUTE(NAME=~"0 as c_colora~") COMPUTE(NAME=~"0.001 as c_differenza~") COMPUTE(NAME=~"0 as c_evidenzia~") COMPUTE(NAME=~"0 as c_vedi_differenza~")    JOIN (LEFT=~"riga_documento_a.provv_imp_subage_2~"    OP =~"=~"RIGHT=~"riga_documento_b.id_riga_documento~"    OUTER1 =~"riga_documento_a.provv_imp_subage_2~" )    JOIN (LEFT=~"riga_documento_b.id_documento~"    OP =~"=~"RIGHT=~"documento_b.id_documento~"    OUTER1 =~"riga_documento_b.id_documento~" )    JOIN (LEFT=~"riga_documento_a.id_documento~"    OP =~"=~"RIGHT=~"documento_a.id_documento~" )WHERE(    EXP1 =~"~~~"documento_a~~~".~~~"id_documento~~~"~"   OP =~"=~"    EXP2 =~":id_doc~" ) ) ARG(NAME = ~"id_doc~" TYPE = number) " arguments=(("id_doc", number))  sort="c_bol_2 A " )
