 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"DBA.riga_documento~" ALIAS=~"riga_documento~" )  TABLE(NAME=~"DBA.articolo~" ALIAS=~"articolo~" )  TABLE(NAME=~"DBA.documento~" ALIAS=~"documento~" )  TABLE(NAME=~"DBA.sog_commerciale_gen~" ALIAS=~"sog_commerciale_gen~" )  TABLE(NAME=~"azienda~" )  TABLE(NAME=~"sede~" ) COLUMN(NAME=~"articolo.codice~") COLUMN(NAME=~"riga_documento.descrizione~") COLUMN(NAME=~"riga_documento.quantita~") COLUMN(NAME=~"riga_documento.peso_netto~") COLUMN(NAME=~"riga_documento.dim_l~") COLUMN(NAME=~"riga_documento.coef_calo~") COLUMN(NAME=~"riga_documento.calo~") COLUMN(NAME=~"riga_documento.fino~") COLUMN(NAME=~"riga_documento.prezzo_manifattura~") COLUMN(NAME=~"riga_documento.prezzo_complessivo~") COLUMN(NAME=~"documento.id_documento~") COLUMN(NAME=~"documento.num_documento~") COLUMN(NAME=~"documento.data_documento~") COLUMN(NAME=~"documento.data_prev_consegna~") COLUMN(NAME=~"documento.note_intestazione~") COLUMN(NAME=~"documento.bollo~") COLUMN(NAME=~"azienda.rag_soc_1~") COLUMN(NAME=~"sog_commerciale_gen.rag_soc_1~") COLUMN(NAME=~"sede.indirizzo~") COLUMN(NAME=~"sede.cap~") COLUMN(NAME=~"sede.localita~") COLUMN(NAME=~"sede.provincia~") COLUMN(NAME=~"riga_documento.id_riga_documento~") COLUMN(NAME=~"riga_documento.importo_manifattura~")    JOIN (LEFT=~"riga_documento.id_articolo~"    OP =~"=~"RIGHT=~"articolo.id_articolo~"    OUTER1 =~"riga_documento.id_articolo~" )    JOIN (LEFT=~"riga_documento.id_documento~"    OP =~"=~"RIGHT=~"documento.id_documento~" )    JOIN (LEFT=~"riga_documento.id_azienda~"    OP =~"=~"RIGHT=~"azienda.id_azienda~" )    JOIN (LEFT=~"documento.id_sog_commerciale~"    OP =~"=~"RIGHT=~"sog_commerciale_gen.id_sog_commerciale~" )    JOIN (LEFT=~"azienda.id_azienda~"    OP =~"=~"RIGHT=~"sede.id_azienda~" )WHERE(    EXP1 =~"~~~"documento~~~".~~~"id_documento~~~"~"   OP =~"=~"    EXP2 =~":id_doc~" ) ) ORDER(NAME=~"documento.num_documento~" ASC=yes ) ARG(NAME = ~"id_doc~" TYPE = number) " arguments=(("id_doc", number)) )
