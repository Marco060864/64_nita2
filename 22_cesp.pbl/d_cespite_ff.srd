table(column=(type=long update=yes updatewhereclause=yes key=yes identity=yes name=id_cespite dbname="cespite.id_cespite" )
 column=(type=char(10) update=yes updatewhereclause=yes name=codice dbname="cespite.codice" )
 column=(type=char(40) update=yes updatewhereclause=yes name=descrizione dbname="cespite.descrizione" )
 column=(type=date update=yes updatewhereclause=yes name=data_inizio_utilizzo dbname="cespite.data_inizio_utilizzo" )
 column=(type=long update=yes updatewhereclause=yes name=id_cat_int_cespite dbname="cespite.id_cat_int_cespite" )
 column=(type=long update=yes updatewhereclause=yes name=id_ubic_cespite dbname="cespite.id_ubic_cespite" )
 column=(type=char(1) update=yes updatewhereclause=yes name=stato dbname="cespite.stato" initial="U" values="Utilizzato	U/Uso promiscuo	S/Estinto	E/Venduto	V/Escluso dalla produzione	P/Distruzione	D/Locato (amm a carico del locatore)	L/Non ammortizzabile	N/Inutilizzato	I/" validation=" gettext()  = 'U' OR  gettext()  = 'S' OR  gettext()  = 'E' OR  gettext()  = 'V' OR  gettext()  = 'P' OR  gettext()  = 'D' OR  gettext()  = 'L' OR  gettext()  = 'N' OR  gettext()  = 'I'" validationmsg="'Immettere un valore tra U, S, E, V, P, D, L, N, I'" )
 column=(type=char(1) update=yes updatewhereclause=yes name=tipo_ammortamento dbname="cespite.tipo_ammortamento" initial="O" values="Ordinario	O/Ordinario//Anticipato	A/Ridotto	R/" )
 column=(type=long update=yes updatewhereclause=yes name=id_centro_costo dbname="cespite.id_centro_costo" )
 column=(type=char(1) update=yes updatewhereclause=yes name=bene_usato dbname="cespite.bene_usato" initial="N" values="	S/	N" validation=" gettext()  = 'S' OR  gettext()  = 'N'" validationmsg="'Immettere: S, N'" )
 column=(type=char(32766) update=yes updatewhereclause=no name=note dbname="cespite.note" )
 column=(type=long update=yes updatewhereclause=yes name=id_azienda dbname="cespite.id_azienda" initial="1" )
 column=(type=long update=yes updatewhereclause=yes name=id_cespite_padre dbname="cespite.id_cespite_padre" )
 column=(type=char(8) updatewhereclause=yes name=cat_int_cespite_codice dbname="cat_int_cespite.codice" )
