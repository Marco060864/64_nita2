 column=(type=char(8) updatewhereclause=yes name=ubic_cespite_codice dbname="ubic_cespite.codice" )
 column=(type=char(80) updatewhereclause=yes name=ubic_cespite_descrizione dbname="ubic_cespite.descrizione" )
 column=(type=decimal(4) update=yes updatewhereclause=yes name=valore_acq dbname="cespite.valore_acq" )
 column=(type=date update=yes updatewhereclause=yes name=rival_data dbname="cespite.rival_data" )
 column=(type=decimal(4) update=yes updatewhereclause=yes name=rival_valore dbname="cespite.rival_valore" )
 column=(type=date update=yes updatewhereclause=yes name=sval_data dbname="cespite.sval_data" )
 column=(type=decimal(4) update=yes updatewhereclause=yes name=sval_valore dbname="cespite.sval_valore" )
 column=(type=char(10) updatewhereclause=yes name=ccod dbname="cod" )
 column=(type=char(40) updatewhereclause=yes name=cdes dbname="des" )
 column=(type=decimal(2) update=yes updatewhereclause=yes name=amm_normale dbname="cespite.amm_normale" )
 column=(type=decimal(2) update=yes updatewhereclause=yes name=amm_anticipato dbname="cespite.amm_anticipato" )
 column=(type=decimal(0) update=yes updatewhereclause=yes name=anni_ammortizzati dbname="cespite.anni_ammortizzati" )
 column=(type=decimal(0) update=yes updatewhereclause=yes name=anni_ammortizzabili dbname="cespite.anni_ammortizzabili" )
 column=(type=char(1) update=yes updatewhereclause=yes name=deduzione dbname="cespite.deduzione" initial="N" )
 column=(type=char(1) update=yes updatewhereclause=yes name=autotraportatori dbname="cespite.autotraportatori" initial="N" )
 column=(type=char(1) update=yes updatewhereclause=yes name=registr_cassa dbname="cespite.registr_cassa" initial="N" )
 column=(type=date update=yes updatewhereclause=yes name=data_inizio_amm dbname="cespite.data_inizio_amm" )
 column=(type=date update=yes updatewhereclause=yes name=data_fine_amm dbname="cespite.data_fine_amm" )
 column=(type=decimal(4) update=yes updatewhereclause=yes name=fondo_amm_norm dbname="cespite.fondo_amm_norm" )
 column=(type=decimal(4) update=yes updatewhereclause=yes name=fondo_amm_ant dbname="cespite.fondo_amm_ant" )
 column=(type=decimal(4) update=yes updatewhereclause=yes name=tot_perdite dbname="cespite.tot_perdite" )
 column=(type=decimal(4) update=yes updatewhereclause=yes name=perd_uso_promiscuo dbname="cespite.perd_uso_promiscuo" )
 column=(type=decimal(4) update=yes updatewhereclause=yes name=credito_imposta dbname="cespite.credito_imposta" )
 column=(type=date update=yes updatewhereclause=yes name=alien_data dbname="cespite.alien_data" )
 column=(type=decimal(4) update=yes updatewhereclause=yes name=alien_valore dbname="cespite.alien_valore" )
 column=(type=decimal(4) update=yes updatewhereclause=yes name=imp_non_amm dbname="cespite.imp_non_amm" )
 column=(type=decimal(4) update=yes updatewhereclause=yes name=plus dbname="cespite.plus" )
 column=(type=decimal(4) update=yes updatewhereclause=yes name=minus dbname="cespite.minus" )
