 column=(type=decimal(4) update=yes updatewhereclause=yes name=quota_amm_prev_antic dbname="cespite.quota_amm_prev_antic" )
 column=(type=char(1) update=yes updatewhereclause=yes name=sog_contr_manut dbname="cespite.sog_contr_manut" initial="N" )
 column=(type=long update=yes updatewhereclause=yes name=id_valuta dbname="cespite.id_valuta" )
 column=(type=char(20) update=yes updatewhereclause=yes name=matricola dbname="cespite.matricola" )
 column=(type=decimal(2) update=yes updatewhereclause=yes name=amm_particolare dbname="cespite.amm_particolare" )
 column=(type=char(8) updatewhereclause=yes name=centro_costo_codice dbname="centro_costo.codice" )
 column=(type=char(40) updatewhereclause=yes name=centro_costo_descrizione dbname="centro_costo.descrizione" )
 column=(type=decimal(4) update=yes updatewhereclause=yes name=imp_originale dbname="cespite.imp_originale" )
 column=(type=char(16) update=yes updatewhereclause=yes name=cespite_cod_barre dbname="cespite.cod_barre" )
 retrieve="  SELECT  ~"cespite~".~"id_cespite~" ,
           ~"cespite~".~"codice~" ,
           ~"cespite~".~"descrizione~" ,
           ~"cespite~".~"data_inizio_utilizzo~" ,
           ~"cespite~".~"id_cat_int_cespite~" ,
           ~"cespite~".~"id_ubic_cespite~" ,
           ~"cespite~".~"stato~" ,
           ~"cespite~".~"tipo_ammortamento~" , 
          ~"cespite~".~"id_centro_costo~" ,  
         ~"cespite~".~"bene_usato~" ,         
  ~"cespite~".~"note~" ,        
   ~"cespite~".~"id_azienda~" ,    
       ~"cespite~".~"id_cespite_padre~" ,    
       ~"cat_int_cespite~".~"codice~" ,        
   ~"cat_int_cespite~".~"descrizione~" ,         
  ~"ubic_cespite~".~"codice~" ,       
    ~"ubic_cespite~".~"descrizione~" ,    
       ~"cespite~".~"valore_acq~" ,        
   ~"cespite~".~"rival_data~" ,           
~"cespite~".~"rival_valore~" ,     
      ~"cespite~".~"sval_data~" ,     
      ~"cespite~".~"sval_valore~" ,    
       cast(null as char(10)) as cod,      
     cast(null as char(40)) as des,       
    ~"cespite~".~"amm_normale~" ,          
 ~"cespite~".~"amm_anticipato~" ,          
 ~"cespite~".~"anni_ammortizzati~" ,  
  ~"cespite~".~"anni_ammortizzabili~" ,   
        ~"cespite~".~"deduzione~" ,        
   ~"cespite~".~"autotraportatori~" ,   
        ~"cespite~".~"registr_cassa~" ,  
         ~"cespite~".~"data_inizio_amm~" , 
         ~"cespite~".~"data_fine_amm~" ,    
       ~"cespite~".~"fondo_amm_norm~" ,        
   ~"cespite~".~"fondo_amm_ant~" ,        
   ~"cespite~".~"tot_perdite~" ,         
  ~"cespite~".~"perd_uso_promiscuo~" ,  
         ~"cespite~".~"credito_imposta~" ,       
    ~"cespite~".~"alien_data~" ,           ~"cespite~".~"alien_valore~" ,         ~"cespite~".~"imp_non_amm~" ,    
       ~"cespite~".~"plus~" ,           ~"cespite~".~"minus~" ,           ~"cespite~".~"quota_amm_prev_norm~" ,      
     ~"cespite~".~"quota_amm_prev_antic~" ,           ~"cespite~".~"sog_contr_manut~" ,           ~"cespite~".~"id_valuta~" ,    
       ~"cespite~".~"matricola~" ,           ~"cespite~".~"amm_particolare~" ,           ~"centro_costo~".~"codice~" ,          
 ~"centro_costo~".~"descrizione~"  ,          ~"cespite~".~"imp_originale~",
~"cespite~".~"cod_barre~"

        FROM {oj {oj ~"cespite~"  LEFT OUTER JOIN ~"ubic_cespite~"  ON ~"cespite~".~"id_ubic_cespite~" = ~"ubic_cespite~".~"id_ubic_cespite~"} LEFT OUTER JOIN ~"centro_costo~"  ON ~"cespite~".~"id_centro_costo~" = ~"centro_costo~".~"id_centro_costo~"} ,           ~"cat_int_cespite~"    
        WHERE ( ~"cat_int_cespite~".~"id_cat_int_cespite~" = ~"cespite~".~"id_cat_int_cespite~" ) and          ( ( ~"cespite~".~"id_azienda~" in (0, 1) ) )   " update="cespite" updatewhere=1 updatekeyinplace=yes )
