 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"cespite~" )  TABLE(NAME=~"cat_int_cespite~" ) COLUMN(NAME=~"cespite.codice~") COLUMN(NAME=~"cespite.descrizione~") COLUMN(NAME=~"cespite.stato~") COLUMN(NAME=~"cespite.data_inizio_utilizzo~") COLUMN(NAME=~"cespite.valore_acq~") COLUMN(NAME=~"cespite.anni_ammortizzati~") COLUMN(NAME=~"cespite.credito_imposta~") COLUMN(NAME=~"cespite.fondo_amm_norm~") COLUMN(NAME=~"cespite.fondo_amm_ant~") COLUMN(NAME=~"cat_int_cespite.codice~") COLUMN(NAME=~"cat_int_cespite.descrizione~") COLUMN(NAME=~"cespite.id_cespite~") COLUMN(NAME=~"cespite.rival_valore~") COLUMN(NAME=~"cespite.sval_valore~") COLUMN(NAME=~"cat_int_cespite.perc_ammortamento~") COLUMN(NAME=~"cespite.perd_uso_promiscuo~") COLUMN(NAME=~"cespite.alien_valore~") COLUMN(NAME=~"cespite.alien_data~") COLUMN(NAME=~"cespite.plus~") COLUMN(NAME=~"cespite.minus~") COLUMN(NAME=~"cespite.imp_non_amm~") COLUMN(NAME=~"cespite.bene_usato~") COLUMN(NAME=~"cespite.data_inizio_amm~") COLUMN(NAME=~"cespite.matricola~") COLUMN(NAME=~"cespite.note~")    JOIN (LEFT=~"cat_int_cespite.id_cat_int_cespite~"    OP =~"=~"RIGHT=~"cespite.id_cat_int_cespite~" )WHERE(    EXP1 =~"( ( ~~~"cat_int_cespite~~~".~~~"codice~~~"~"   OP =~">=~"    EXP2 =~":rn_da_cod )~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"( ~~~"cat_int_cespite~~~".~~~"codice~~~"~"   OP =~"<=~"    EXP2 =~":rn_a_cod ) )~" ) ) ARG(NAME = ~"rn_da_cod~" TYPE = string)  ARG(NAME = ~"rn_a_cod~" TYPE = string) " arguments=(("rn_da_cod", string),("rn_a_cod", string))  sort="cat_int_cespite_codice A " )
