 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"cespite~" )  TABLE(NAME=~"cat_int_cespite~" )  TABLE(NAME=~"mov_cespite~" )  TABLE(NAME=~"prof_cespite~" ) COLUMN(NAME=~"cespite.codice~") COLUMN(NAME=~"cespite.descrizione~") COLUMN(NAME=~"cespite.valore_acq~") COLUMN(NAME=~"cespite.data_inizio_utilizzo~") COLUMN(NAME=~"cespite.anni_ammortizzati~") COLUMN(NAME=~"cespite.fondo_amm_norm~") COLUMN(NAME=~"cespite.fondo_amm_ant~") COLUMN(NAME=~"cat_int_cespite.codice~") COLUMN(NAME=~"cat_int_cespite.descrizione~") COLUMN(NAME=~"cat_int_cespite.anni_durata~") COLUMN(NAME=~"cat_int_cespite.perc_ammortamento~") COLUMN(NAME=~"cat_int_cespite.perc_amm_anticipato~") COLUMN(NAME=~"cat_int_cespite.perc_primo_amm~") COLUMN(NAME=~"cespite.amm_particolare~") COLUMN(NAME=~"cat_int_cespite.id_cat_int_cespite~") COMPUTE(NAME=~"CAST( (select  rag_soc_1 from azienda where id_azienda=1) as char(40))~") COLUMN(NAME=~"mov_cespite.importo~") COLUMN(NAME=~"cespite.id_cespite~") COLUMN(NAME=~"prof_cespite.codice~") COLUMN(NAME=~"prof_cespite.descrizione~") COLUMN(NAME=~"mov_cespite.data_mov_cespite~") COLUMN(NAME=~"mov_cespite.id_conto~") COLUMN(NAME=~"mov_cespite.id_reg_pd~")    JOIN (LEFT=~"cat_int_cespite.id_cat_int_cespite~"    OP =~"=~"RIGHT=~"cespite.id_cat_int_cespite~" )    JOIN (LEFT=~"mov_cespite.id_cespite~"    OP =~"=~"RIGHT=~"cespite.id_cespite~" )    JOIN (LEFT=~"mov_cespite.id_prof_cespite~"    OP =~"=~"RIGHT=~"prof_cespite.id_prof_cespite~" )WHERE(    EXP1 =~"~~~"mov_cespite~~~".~~~"data_mov_cespite~~~"~"   OP =~">=~"    EXP2 =~":rd_da~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"mov_cespite~~~".~~~"data_mov_cespite~~~"~"   OP =~"<=~"    EXP2 =~":rd_a~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"cespite~~~".~~~"codice~~~"~"   OP =~">=~"    EXP2 =~":da_ces~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"cespite~~~".~~~"codice~~~"~"   OP =~"<=~"    EXP2 =~":a_ces~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"cat_int_cespite~~~".~~~"codice~~~"~"   OP =~">=~"    EXP2 =~":da_cat~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"cat_int_cespite~~~".~~~"codice~~~"~"   OP =~"<=~"    EXP2 =~":a_cat~" ) ) ORDER(NAME=~"cat_int_cespite.id_cat_int_cespite~" ASC=yes )  ORDER(NAME=~"cespite.id_cespite~" ASC=yes ) ARG(NAME = ~"rd_da~" TYPE = date)  ARG(NAME = ~"rd_a~" TYPE = date)  ARG(NAME = ~"da_ces~" TYPE = string)  ARG(NAME = ~"a_ces~" TYPE = string)  ARG(NAME = ~"da_cat~" TYPE = string)  ARG(NAME = ~"a_cat~" TYPE = string) " arguments=(("rd_da", date),("rd_a", date),("da_ces", string),("a_ces", string),("da_cat", string),("a_cat", string)) )
