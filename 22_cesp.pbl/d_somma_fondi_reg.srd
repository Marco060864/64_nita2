 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"mov_contabile~" )  TABLE(NAME=~"reg_pd~" )  TABLE(NAME=~"conto~" )  TABLE(NAME=~"prof_registrazione~" ) COLUMN(NAME=~"conto.codice~") COLUMN(NAME=~"conto.descrizione~") COLUMN(NAME=~"mov_contabile.dare~") COLUMN(NAME=~"mov_contabile.avere~") COLUMN(NAME=~"reg_pd.num_documento~") COLUMN(NAME=~"reg_pd.data_documento~") COLUMN(NAME=~"mov_contabile.numero~") COLUMN(NAME=~"prof_registrazione.codice~") COLUMN(NAME=~"prof_registrazione.descrizione~") COLUMN(NAME=~"reg_pd.num_progressivo~") COLUMN(NAME=~"reg_pd.data_registrazione~")    JOIN (LEFT=~"reg_pd.id_reg_pd~"    OP =~"=~"RIGHT=~"mov_contabile.id_reg_pd~" )    JOIN (LEFT=~"conto.id_conto~"    OP =~"=~"RIGHT=~"mov_contabile.id_conto~" )    JOIN (LEFT=~"prof_registrazione.id_prof_registrazione~"    OP =~"=~"RIGHT=~"reg_pd.id_prof_registrazione~" )WHERE(    EXP1 =~"~~~"mov_contabile~~~".~~~"id_reg_pd~~~"~"   OP =~"=~"    EXP2 =~":id_reg_pd~" ) ) ARG(NAME = ~"id_reg_pd~" TYPE = number) " arguments=(("id_reg_pd", number))  sort="conto_codice A " )
