 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"cat_int_cespite~" )  TABLE(NAME=~"cespite~" ) COLUMN(NAME=~"cespite.id_cespite~") COLUMN(NAME=~"cespite.valore_acq~") COLUMN(NAME=~"cespite.amm_normale~") COLUMN(NAME=~"cat_int_cespite.perc_ammortamento~") COLUMN(NAME=~"cespite.tipo_ammortamento~") COLUMN(NAME=~"cespite.anni_ammortizzati~") COLUMN(NAME=~"cespite.rival_valore~") COLUMN(NAME=~"cespite.sval_valore~") COLUMN(NAME=~"cespite.fondo_amm_norm~") COLUMN(NAME=~"cespite.fondo_amm_ant~") COLUMN(NAME=~"cespite.perd_uso_promiscuo~") COLUMN(NAME=~"cespite.alien_valore~") COLUMN(NAME=~"cespite.imp_non_amm~") COLUMN(NAME=~"cespite.amm_particolare~") COLUMN(NAME=~"cat_int_cespite.perc_primo_amm~") COLUMN(NAME=~"cat_int_cespite.perc_amm_anticipato~") COLUMN(NAME=~"cespite.quota_amm_prev_norm~") COLUMN(NAME=~"cespite.quota_amm_prev_antic~") COLUMN(NAME=~"cat_int_cespite.id_cat_int_cespite~") COLUMN(NAME=~"cespite.stato~") COLUMN(NAME=~"cespite.data_inizio_utilizzo~") COLUMN(NAME=~"cespite.data_inizio_amm~") COLUMN(NAME=~"cespite.codice~")    JOIN (LEFT=~"cespite.id_cat_int_cespite~"    OP =~"=~"RIGHT=~"cat_int_cespite.id_cat_int_cespite~" )WHERE(    EXP1 =~"(~~~"cespite~~~".~~~"stato~~~"~"   OP =~"=~"    EXP2 =~"'U'~"    LOGIC =~"or~" ) WHERE(    EXP1 =~"~~~"cespite~~~".~~~"stato~~~"~"   OP =~"=~"    EXP2 =~"'S')~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"cespite~~~".~~~"data_inizio_amm~~~"~"   OP =~"<=~"    EXP2 =~":rd_data~" ) ) ARG(NAME = ~"rd_data~" TYPE = date) " update="cespite" updatewhere=1 updatekeyinplace=yes arguments=(("rd_data", date)) )
