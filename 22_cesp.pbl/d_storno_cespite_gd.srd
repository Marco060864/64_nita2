 retrieve="PBSELECT( VERSION(400) DISTINCT ()TABLE(NAME=~"cespite~" )  TABLE(NAME=~"mov_cespite~" )  TABLE(NAME=~"prof_cespite~" ) COLUMN(NAME=~"cespite.id_cespite~") COLUMN(NAME=~"cespite.codice~") COLUMN(NAME=~"cespite.descrizione~") COLUMN(NAME=~"cespite.stato~") COLUMN(NAME=~"cespite.anni_ammortizzati~") COLUMN(NAME=~"cespite.fondo_amm_norm~") COLUMN(NAME=~"cespite.fondo_amm_ant~") COLUMN(NAME=~"mov_cespite.id_mov_cespite~") COLUMN(NAME=~"mov_cespite.importo~") COLUMN(NAME=~"mov_cespite.data_mov_cespite~") COLUMN(NAME=~"cespite.amm_normale~") COLUMN(NAME=~"cespite.amm_anticipato~") COLUMN(NAME=~"cespite.valore_acq~")    JOIN (LEFT=~"mov_cespite.id_cespite~"    OP =~"=~"RIGHT=~"cespite.id_cespite~" )    JOIN (LEFT=~"mov_cespite.id_prof_cespite~"    OP =~"=~"RIGHT=~"prof_cespite.id_prof_cespite~" )WHERE(    EXP1 =~"~~~"mov_cespite~~~".~~~"data_mov_cespite~~~"~"   OP =~"=~"    EXP2 =~":data_amm~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"(~~~"prof_cespite~~~".~~~"accantonamento_ordinario~~~"~"   OP =~"=~"    EXP2 =~"'S'~"    LOGIC =~"or~" ) WHERE(    EXP1 =~"~~~"prof_cespite~~~".~~~"accantonamento_anticipato~~~"~"   OP =~"=~"    EXP2 =~"'S')~" ) ) ARG(NAME = ~"data_amm~" TYPE = date) " update="cespite" updatewhere=0 updatekeyinplace=yes arguments=(("data_amm", date))  sort="codice A " )
