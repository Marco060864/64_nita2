 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"reg_pd~" )  TABLE(NAME=~"mov_cespite~" )  TABLE(NAME=~"conto~" ) COLUMN(NAME=~"reg_pd.num_progressivo~") COLUMN(NAME=~"reg_pd.data_registrazione~") COLUMN(NAME=~"mov_cespite.id_esercizio~") COLUMN(NAME=~"mov_cespite.importo~") COLUMN(NAME=~"mov_cespite.note~") COLUMN(NAME=~"mov_cespite.data_mov_cespite~") COLUMN(NAME=~"mov_cespite.id_conto~") COLUMN(NAME=~"mov_cespite.id_reg_pd~") COLUMN(NAME=~"mov_cespite.id_cespite~") COLUMN(NAME=~"mov_cespite.id_mov_cespite~") COLUMN(NAME=~"conto.codice~") COLUMN(NAME=~"conto.descrizione~") COLUMN(NAME=~"mov_cespite.id_prof_cespite~") COLUMN(NAME=~"mov_cespite.id_valuta~") COLUMN(NAME=~"mov_cespite.perc_particolare~") COLUMN(NAME=~"mov_cespite.anni_amm~") COMPUTE(NAME=~"cast (( select prof_base from prof_cespite where id_prof_cespite=~~~"mov_cespite~~~".~~~"id_prof_cespite~~~") as char(1)) as test~") COMPUTE(NAME=~"cast (( select acquisto from prof_cespite where id_prof_cespite=~~~"mov_cespite~~~".~~~"id_prof_cespite~~~") as char(1)) as acquisto~")    JOIN (LEFT=~"mov_cespite.id_reg_pd~"    OP =~"=~"RIGHT=~"reg_pd.id_reg_pd~"    OUTER1 =~"mov_cespite.id_reg_pd~" )    JOIN (LEFT=~"mov_cespite.id_conto~"    OP =~"=~"RIGHT=~"conto.id_conto~"    OUTER1 =~"mov_cespite.id_conto~" )WHERE(    EXP1 =~"~~~"mov_cespite~~~".~~~"id_cespite~~~"~"   OP =~"=~"    EXP2 =~":rn_id_cespite~" ) ) ORDER(NAME=~"mov_cespite.data_mov_cespite~" ASC=yes ) ARG(NAME = ~"rn_id_cespite~" TYPE = number) " update="mov_cespite" updatewhere=1 updatekeyinplace=yes arguments=(("rn_id_cespite", number))  sort="data_mov_cespite D " )
