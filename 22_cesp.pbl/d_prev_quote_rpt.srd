 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"cespite~" )  TABLE(NAME=~"cat_int_cespite~" ) COLUMN(NAME=~"cespite.codice~") COLUMN(NAME=~"cespite.descrizione~") COLUMN(NAME=~"cespite.valore_acq~") COLUMN(NAME=~"cespite.data_inizio_utilizzo~") COLUMN(NAME=~"cespite.anni_ammortizzati~") COLUMN(NAME=~"cespite.fondo_amm_norm~") COLUMN(NAME=~"cespite.fondo_amm_ant~") COLUMN(NAME=~"cespite.quota_amm_prev_norm~") COLUMN(NAME=~"cespite.quota_amm_prev_antic~") COLUMN(NAME=~"cat_int_cespite.codice~") COLUMN(NAME=~"cat_int_cespite.descrizione~") COLUMN(NAME=~"cat_int_cespite.anni_durata~") COLUMN(NAME=~"cat_int_cespite.perc_ammortamento~") COLUMN(NAME=~"cat_int_cespite.perc_amm_anticipato~") COLUMN(NAME=~"cat_int_cespite.perc_primo_amm~") COLUMN(NAME=~"cespite.amm_particolare~") COLUMN(NAME=~"cat_int_cespite.id_cat_int_cespite~") COMPUTE(NAME=~"CAST( (select  rag_soc_1 from azienda where id_azienda=1) as char(40))~")    JOIN (LEFT=~"cat_int_cespite.id_cat_int_cespite~"    OP =~"=~"RIGHT=~"cespite.id_cat_int_cespite~" )WHERE(    EXP1 =~"~~~"cespite~~~".~~~"stato~~~"~"   OP =~"=~"    EXP2 =~"'U'~"    LOGIC =~"or~" ) WHERE(    EXP1 =~"~~~"cespite~~~".~~~"stato~~~"~"   OP =~"=~"    EXP2 =~"'S'~" ) ) " )
