 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"cespite~" )  TABLE(NAME=~"cat_int_cespite~" )  TABLE(NAME=~"mov_cespite~" )  TABLE(NAME=~"prof_cespite~" ) COLUMN(NAME=~"cespite.codice~") COLUMN(NAME=~"cespite.descrizione~") COLUMN(NAME=~"cespite.valore_acq~") COLUMN(NAME=~"cespite.data_inizio_utilizzo~") COLUMN(NAME=~"cespite.anni_ammortizzati~") COLUMN(NAME=~"cespite.fondo_amm_norm~") COLUMN(NAME=~"cespite.fondo_amm_ant~") COLUMN(NAME=~"cat_int_cespite.codice~") COLUMN(NAME=~"cat_int_cespite.descrizione~") COLUMN(NAME=~"cat_int_cespite.anni_durata~") COLUMN(NAME=~"cat_int_cespite.perc_ammortamento~") COLUMN(NAME=~"cat_int_cespite.perc_amm_anticipato~") COLUMN(NAME=~"cat_int_cespite.perc_primo_amm~") COLUMN(NAME=~"cespite.amm_particolare~") COLUMN(NAME=~"cat_int_cespite.id_cat_int_cespite~") COMPUTE(NAME=~"CAST( (select  rag_soc_1 from azienda where id_azienda=1) as char(40))~") COLUMN(NAME=~"mov_cespite.importo~") COLUMN(NAME=~"cespite.id_cespite~") COLUMN(NAME=~"prof_cespite.prof_base~")    JOIN (LEFT=~"cat_int_cespite.id_cat_int_cespite~"    OP =~"=~"RIGHT=~"cespite.id_cat_int_cespite~" )    JOIN (LEFT=~"mov_cespite.id_cespite~"    OP =~"=~"RIGHT=~"cespite.id_cespite~" )    JOIN (LEFT=~"mov_cespite.id_prof_cespite~"    OP =~"=~"RIGHT=~"prof_cespite.id_prof_cespite~" )WHERE(    EXP1 =~"(~~~"prof_cespite~~~".~~~"prof_base~~~"~"   OP =~"=~"    EXP2 =~"'N'~"    LOGIC =~"or~" ) WHERE(    EXP1 =~"~~~"prof_cespite~~~".~~~"prof_base~~~"~"   OP =~"=~"    EXP2 =~"'A')~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"mov_cespite~~~".~~~"id_esercizio~~~"~"   OP =~"=~"    EXP2 =~":rd_es~" ) ) ARG(NAME = ~"rd_anno~" TYPE = number)  ARG(NAME = ~"rd_es~" TYPE = number) " arguments=(("rd_anno", number),("rd_es", number)) )
