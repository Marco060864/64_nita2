 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"cespite~" )  TABLE(NAME=~"cat_int_cespite~" ) COLUMN(NAME=~"cespite.codice~") COLUMN(NAME=~"cespite.descrizione~") COLUMN(NAME=~"cespite.valore_acq~") COLUMN(NAME=~"cespite.data_inizio_utilizzo~") COLUMN(NAME=~"cespite.anni_ammortizzati~") COLUMN(NAME=~"cespite.fondo_amm_norm~") COLUMN(NAME=~"cespite.fondo_amm_ant~") COLUMN(NAME=~"cespite.quota_amm_prev_norm~") COLUMN(NAME=~"cespite.quota_amm_prev_antic~") COLUMN(NAME=~"cat_int_cespite.codice~") COLUMN(NAME=~"cat_int_cespite.descrizione~") COLUMN(NAME=~"cat_int_cespite.anni_durata~") COLUMN(NAME=~"cat_int_cespite.perc_ammortamento~") COLUMN(NAME=~"cat_int_cespite.perc_amm_anticipato~") COLUMN(NAME=~"cat_int_cespite.perc_primo_amm~") COLUMN(NAME=~"cespite.amm_particolare~") COLUMN(NAME=~"cat_int_cespite.id_cat_int_cespite~") COMPUTE(NAME=~"CAST( (select  rag_soc_1 from azienda where id_azienda=1) as char(40))~") COLUMN(NAME=~"cespite.rival_valore~") COLUMN(NAME=~"cespite.sval_valore~") COLUMN(NAME=~"cespite.perd_uso_promiscuo~") COLUMN(NAME=~"cespite.alien_valore~") COLUMN(NAME=~"cespite.imp_non_amm~") COLUMN(NAME=~"cespite.plus~") COLUMN(NAME=~"cespite.minus~")    JOIN (LEFT=~"cat_int_cespite.id_cat_int_cespite~"    OP =~"=~"RIGHT=~"cespite.id_cat_int_cespite~" )WHERE(    EXP1 =~"~~~"cat_int_cespite~~~".~~~"codice~~~"~"   OP =~">=~"    EXP2 =~":da_cat~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"cat_int_cespite~~~".~~~"codice~~~"~"   OP =~"<=~"    EXP2 =~":a_cat~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"cespite~~~".~~~"data_inizio_utilizzo~~~"~"   OP =~"<=~"    EXP2 =~":a_data~" ) ) ORDER(NAME=~"cespite.data_inizio_utilizzo~" ASC=yes ) ARG(NAME = ~"da_cat~" TYPE = string)  ARG(NAME = ~"a_cat~" TYPE = string)  ARG(NAME = ~"a_data~" TYPE = date) " arguments=(("da_cat", string),("a_cat", string),("a_data", date)) )
