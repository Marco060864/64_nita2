table(column=(type=long update=yes updatewhereclause=yes key=yes identity=yes name=id_parte_regola dbname="parte_regola.id_parte_regola" )
 column=(type=decimal(0) update=yes updatewhereclause=yes name=num_sezione dbname="parte_regola.num_sezione" validation=" real(gettext())  >= 0" validationmsg="'Immettere un valore >= 0'" )
 column=(type=char(40) update=yes updatewhereclause=yes name=descrizione dbname="parte_regola.descrizione" )
 column=(type=decimal(0) update=yes updatewhereclause=yes name=lunghezza dbname="parte_regola.lunghezza" )
 column=(type=char(1) update=yes updatewhereclause=yes name=progressivo dbname="parte_regola.progressivo" initial="N" values="	S/	N" validation=" gettext()  = 'S' OR  gettext()  = 'N'" validationmsg="'Immettere: S, N'" )
 column=(type=char(1) update=yes updatewhereclause=yes name=variante dbname="parte_regola.variante" initial="N" values="	S/	N" validation=" gettext()  = 'S' OR  gettext()  = 'N'" validationmsg="'Immettere: S, N'" )
 column=(type=long update=yes updatewhereclause=yes name=id_azienda dbname="parte_regola.id_azienda" initial="1" )
 column=(type=long update=yes updatewhereclause=yes name=id_scomposizione dbname="parte_regola.id_scomposizione" )
 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"parte_regola~" ) COLUMN(NAME=~"parte_regola.id_parte_regola~") COLUMN(NAME=~"parte_regola.num_sezione~") COLUMN(NAME=~"parte_regola.descrizione~") COLUMN(NAME=~"parte_regola.lunghezza~") COLUMN(NAME=~"parte_regola.progressivo~") COLUMN(NAME=~"parte_regola.variante~") COLUMN(NAME=~"parte_regola.id_azienda~") COLUMN(NAME=~"parte_regola.id_scomposizione~")WHERE(    EXP1 =~"~~~"parte_regola~~~".~~~"id_azienda~~~"~"   OP =~"in~"    EXP2 =~"(0, 1)~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"parte_regola~~~".~~~"id_scomposizione~~~"~"   OP =~"=~"    EXP2 =~":rn_id_scomposizione~" ) ) ORDER(NAME=~"parte_regola.num_sezione~" ASC=yes ) ARG(NAME = ~"rn_id_scomposizione~" TYPE = number) " update="parte_regola" updatewhere=1 updatekeyinplace=yes arguments=(("rn_id_scomposizione", number)) )
