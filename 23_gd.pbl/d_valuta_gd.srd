table(column=(type=long update=yes updatewhereclause=yes key=yes identity=yes name=id_valuta dbname="valuta.id_valuta" )
 column=(type=char(4) update=yes updatewhereclause=yes name=codice dbname="valuta.codice" )
 column=(type=char(40) update=yes updatewhereclause=yes name=descrizione dbname="valuta.descrizione" )
 column=(type=char(5) update=yes updatewhereclause=yes name=simbolo dbname="valuta.simbolo" )
 column=(type=decimal(4) update=yes updatewhereclause=yes name=cambio dbname="valuta.cambio" validation=" real(gettext())  >= 0" validationmsg="'Immettere un valore >= 0'" )
 column=(type=decimal(0) update=yes updatewhereclause=yes name=cifra_arrotondamento dbname="valuta.cifra_arrotondamento" )
 column=(type=char(1) update=yes updatewhereclause=yes name=tipo_arrotondamento dbname="valuta.tipo_arrotondamento" initial="I" values="Inferiore	I/Superiore	S/Medio	M/" validation=" gettext()  = 'I' OR  gettext()  = 'S' OR  gettext()  = 'M'" validationmsg="'Immettere: I, S, M'" )
 column=(type=decimal(4) update=yes updatewhereclause=yes name=parita_euro dbname="valuta.parita_euro" validation=" real(gettext())  >= 0" validationmsg="'Immettere un valore >= 0'" )
 column=(type=decimal(0) update=yes updatewhereclause=yes name=dec_significativi dbname="valuta.dec_significativi" )
 column=(type=char(3) update=yes updatewhereclause=yes name=iso_4217_a3_201 dbname="valuta.iso_4217_a3_201" initial="EUR" values="EURO	EUR/DOLLARO	USD/BRITISH POUND	GPB/DOLLARO AUSTRALIANO	AUD/YEN	JPY/Franco Svizzero	CHF/CINA	CNY/DOLLARO SINGAPORE	SGD/RUPIA INDIANA	INR/Canada	CAD/" )
 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"valuta~" ) COLUMN(NAME=~"valuta.id_valuta~") COLUMN(NAME=~"valuta.codice~") COLUMN(NAME=~"valuta.descrizione~") COLUMN(NAME=~"valuta.simbolo~") COLUMN(NAME=~"valuta.cambio~") COLUMN(NAME=~"valuta.cifra_arrotondamento~") COLUMN(NAME=~"valuta.tipo_arrotondamento~") COLUMN(NAME=~"valuta.parita_euro~") COLUMN(NAME=~"valuta.dec_significativi~") COLUMN(NAME=~"valuta.iso_4217_a3_201~")) ORDER(NAME=~"valuta.codice~" ASC=yes ) " update="valuta" updatewhere=1 updatekeyinplace=yes )
