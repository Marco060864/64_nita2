 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"mov_scadenza~" ALIAS=~"mov_scadenza_a~" )  TABLE(NAME=~"scadenza~" )  TABLE(NAME=~"anagrafica~" )  TABLE(NAME=~"sog_commerciale~" )  TABLE(NAME=~"mov_scadenza~" ALIAS=~"mov_scadenza_b~" ) COLUMN(NAME=~"scadenza.data_scadenza~") COLUMN(NAME=~"scadenza.importo~") COLUMN(NAME=~"mov_scadenza_a.data~") COLUMN(NAME=~"mov_scadenza_a.importo~") COLUMN(NAME=~"scadenza.tipo_scadenza~") COLUMN(NAME=~"sog_commerciale.codice~") COLUMN(NAME=~"anagrafica.rag_soc_1~") COLUMN(NAME=~"mov_scadenza_a.note~") COLUMN(NAME=~"mov_scadenza_a.id_mov_partita~") COLUMN(NAME=~"mov_scadenza_a.id_mov_scadenza~") COLUMN(NAME=~"mov_scadenza_a.id_scadenza~") COMPUTE(NAME=~"~~~"scadenza~~~".~~~"importo~~~" - ifnull( sum( ~~~"mov_scadenza_b~~~".~~~"importo~~~" ), 0, sum( ~~~"mov_scadenza_b~~~".~~~"importo~~~" )) as saldo~")    JOIN (LEFT=~"scadenza.id_scadenza~"    OP =~"=~"RIGHT=~"mov_scadenza_a.id_scadenza~"    OUTER1 =~"scadenza.id_scadenza~" )    JOIN (LEFT=~"sog_commerciale.id_anagrafica~"    OP =~"=~"RIGHT=~"anagrafica.id_anagrafica~"    OUTER1 =~"sog_commerciale.id_anagrafica~" )    JOIN (LEFT=~"sog_commerciale.id_sog_commerciale~"    OP =~"=~"RIGHT=~"scadenza.id_sog_commerciale~"    OUTER2 =~"scadenza.id_sog_commerciale~" )    JOIN (LEFT=~"mov_scadenza_b.id_scadenza~"    OP =~"=~"RIGHT=~"scadenza.id_scadenza~"    OUTER2 =~"scadenza.id_scadenza~" )WHERE(    EXP1 =~"~~~"mov_scadenza_a~~~".~~~"id_mov_partita~~~"~"   OP =~"=~"    EXP2 =~":al_id_mov_partita~" )  GROUP(NAME=~"mov_scadenza_a.id_mov_scadenza~") GROUP(NAME=~"mov_scadenza_a.id_scadenza~") GROUP(NAME=~"mov_scadenza_a.id_mov_partita~") GROUP(NAME=~"scadenza.tipo_scadenza~") GROUP(NAME=~"mov_scadenza_a.note~") GROUP(NAME=~"mov_scadenza_a.importo~") GROUP(NAME=~"mov_scadenza_a.data~") GROUP(NAME=~"anagrafica.rag_soc_1~") GROUP(NAME=~"sog_commerciale.codice~") GROUP(NAME=~"scadenza.importo~") GROUP(NAME=~"scadenza.data_scadenza~")) ARG(NAME = ~"al_id_mov_partita~" TYPE = number) " update="mov_scadenza" updatewhere=0 updatekeyinplace=yes arguments=(("al_id_mov_partita", number)) )
