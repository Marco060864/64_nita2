 column=(type=char(1) updatewhereclause=yes name=scadenza_tipo_scadenza dbname="scadenza.tipo_scadenza" values="Attiva	A/Passiva	P/" validation=" gettext()  = 'A' OR  gettext()  = 'P'" validationmsg="'Immettere un valore tra A, P'" )
