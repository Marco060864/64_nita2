//objectcomments Data window per datastore libro giornale
release 5;
datawindow(units=0 timer_interval=0 color=79741120 processing=1 print.documentname="" print.orientation = 0 print.margin.left = 110 print.margin.right = 110 print.margin.top = 97 print.margin.bottom = 97 print.paper.source = 0 print.paper.size = 0 print.prompt=no grid.lines=0 )
header(height=77 color="536870912" )
summary(height=1 color="536870912" )
footer(height=1 color="536870912" )
detail(height=89 color="536870912" )
table(column=(type=long update=yes updatewhereclause=yes key=yes identity=yes name=reg_pd_id_reg_pd dbname="reg_pd.id_reg_pd" )
 column=(type=char(2) updatewhereclause=yes name=registro_tipo_registro dbname="registro.tipo_registro" values="IVA acquisti	IA/IVA vendite	IV/IVA corrispettivi	IC/Manageriale	MN/Prima nota	PN/Prima nota chiusure	PZ/Preventivi acquisti	PA/Preventivi vendite	PV/Ordini acquisti	OA/Ordini vendite	OV/DDT acquisti	DA/DDT vendite	DV/Liste prelievo acquisti	LA/Liste prelievo vendite	LV/Generico acquisti	GA/Generico vendite	GV/" validation=" gettext()  = 'IA' OR  gettext()  = 'IV' OR  gettext()  = 'IC' OR  gettext()  = 'MN' OR  gettext()  = 'PN' OR  gettext()  = 'PZ' OR  gettext()  = 'PA' OR  gettext()  = 'PV' OR  gettext()  = 'OA' OR  gettext()  = 'OV' OR  gettext()  = 'DA' OR  gettext()  = 'DV' OR  gettext()  = 'LA' OR  gettext()  = 'LV' OR  gettext()  = 'GA' OR  gettext()  = 'GV'" validationmsg="'Immettere: IA, IV,IC , MN, PN, OA, OP, DA, DV, LA, LP, GA, GV'" )
 column=(type=date update=yes updatewhereclause=yes name=reg_pd_data_registrazione dbname="reg_pd.data_registrazione" )
 column=(type=char(1) update=yes updatewhereclause=yes name=reg_pd_st_stampa_bollato dbname="reg_pd.st_stampa_bollato" initial="N" values="Non stampato	N/In corso di stampa	I/Stampata su bollato	S/" validation=" gettext()  = 'N' OR  gettext()  = 'I' OR  gettext()  = 'S'" validationmsg="'Immettere un valore tra N, I, S'" )
 column=(type=date update=yes updatewhereclause=yes name=reg_pd_st_data_bollato dbname="reg_pd.st_data_bollato" )
 column=(type=char(1) update=yes updatewhereclause=yes name=reg_pd_st_reg_iva dbname="reg_pd.st_reg_iva" )
 column=(type=date update=yes updatewhereclause=yes name=reg_pd_st_data_reg_iva dbname="reg_pd.st_data_reg_iva" )
 column=(type=char(1) update=yes updatewhereclause=yes name=reg_pd_st_liquidazione dbname="reg_pd.st_liquidazione" )
 column=(type=date update=yes updatewhereclause=yes name=reg_pd_st_data_liquidazione dbname="reg_pd.st_data_liquidazione" )
 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"reg_pd~" )  TABLE(NAME=~"registro~" ) COLUMN(NAME=~"reg_pd.id_reg_pd~") COLUMN(NAME=~"registro.tipo_registro~") COLUMN(NAME=~"reg_pd.data_registrazione~") COLUMN(NAME=~"reg_pd.st_stampa_bollato~") COLUMN(NAME=~"reg_pd.st_data_bollato~") COLUMN(NAME=~"reg_pd.st_reg_iva~") COLUMN(NAME=~"reg_pd.st_data_reg_iva~") COLUMN(NAME=~"reg_pd.st_liquidazione~") COLUMN(NAME=~"reg_pd.st_data_liquidazione~")    JOIN (LEFT=~"registro.id_registro~"    OP =~"=~"RIGHT=~"reg_pd.id_registro~" )WHERE(    EXP1 =~"(~~~"registro~~~".~~~"tipo_registro~~~"~"   OP =~"=~"    EXP2 =~"'IV'~"    LOGIC =~"or~" ) WHERE(    EXP1 =~"~~~"registro~~~".~~~"tipo_registro~~~"~"   OP =~"=~"    EXP2 =~"'IA'~"    LOGIC =~"or~" ) WHERE(    EXP1 =~"~~~"registro~~~".~~~"tipo_registro~~~"~"   OP =~"=~"    EXP2 =~"'IC'~"    LOGIC =~"or~" ) WHERE(    EXP1 =~"~~~"registro~~~".~~~"tipo_registro~~~"~"   OP =~"=~"    EXP2 =~"'PN')~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"reg_pd~~~".~~~"st_stampa_bollato~~~"~"   OP =~"<>~"    EXP2 =~"'S'~" ) ) ORDER(NAME=~"reg_pd.data_registrazione~" ASC=yes )  ORDER(NAME=~"registro.tipo_registro~" ASC=yes )  ORDER(NAME=~"reg_pd.id_reg_pd~" ASC=yes ) " update="reg_pd" updatewhere=1 updatekeyinplace=yes )
