release 5;
datawindow(units=0 timer_interval=0 color=79741120 processing=1 print.documentname="" print.orientation = 0 print.margin.left = 110 print.margin.right = 110 print.margin.top = 97 print.margin.bottom = 97 print.paper.source = 0 print.paper.size = 0 print.prompt=no grid.lines=0 )
header(height=77 color="536870912" )
summary(height=1 color="536870912" )
footer(height=1 color="536870912" )
detail(height=89 color="536870912" )
table(column=(type=decimal(0) update=yes updatewhereclause=yes name=mov_contabile_prog_stampato dbname="mov_contabile.prog_stampato" validation=" real(gettext())  >= 0" validationmsg="'Immettere un valore >= 0'" )
 column=(type=char(1) update=yes updatewhereclause=yes name=mov_contabile_st_stampa_bollato dbname="mov_contabile.st_stampa_bollato" initial="N" values="Non stampato	N/In corso di stampa	I/Stampata su bollato	S/" validation=" gettext()  = 'N' OR  gettext()  = 'I' OR  gettext()  = 'S'" validationmsg="'Immettere un valore tra N, I, S'" )
 column=(type=decimal(0) update=yes updatewhereclause=yes name=mov_contabile_numero dbname="mov_contabile.numero" validation=" real(gettext())  >= 0" validationmsg="'Immettere un valore >= 0'" )
 column=(type=long updatewhereclause=yes name=reg_pd_id_reg_pd dbname="reg_pd.id_reg_pd" )
 column=(type=date updatewhereclause=yes name=reg_pd_data_registrazione dbname="reg_pd.data_registrazione" )
 column=(type=char(2) updatewhereclause=yes name=registro_tipo_registro dbname="registro.tipo_registro" values="IVA acquisti	IA/IVA vendite	IV/IVA corrispettivi	IC/Manageriale	MN/Prima nota	PN/Prima nota chiusure	PZ/Preventivi acquisti	PA/Preventivi vendite	PV/Ordini acquisti	OA/Ordini vendite	OV/DDT acquisti	DA/DDT vendite	DV/Liste prelievo acquisti	LA/Liste prelievo vendite	LV/Generico acquisti	GA/Generico vendite	GV/" validation=" gettext()  = 'IA' OR  gettext()  = 'IV' OR  gettext()  = 'IC' OR  gettext()  = 'MN' OR  gettext()  = 'PN' OR  gettext()  = 'PZ' OR  gettext()  = 'PA' OR  gettext()  = 'PV' OR  gettext()  = 'OA' OR  gettext()  = 'OV' OR  gettext()  = 'DA' OR  gettext()  = 'DV' OR  gettext()  = 'LA' OR  gettext()  = 'LV' OR  gettext()  = 'GA' OR  gettext()  = 'GV'" validationmsg="'Immettere: IA, IV,IC , MN, PN, OA, OP, DA, DV, LA, LP, GA, GV'" )
 column=(type=long update=yes updatewhereclause=yes key=yes identity=yes name=mov_contabile_id_mov_contabile dbname="mov_contabile.id_mov_contabile" )
 column=(type=date update=yes updatewhereclause=yes name=mov_contabile_st_data_bollato dbname="mov_contabile.st_data_bollato" )
 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"mov_contabile~" )  TABLE(NAME=~"reg_pd~" )  TABLE(NAME=~"registro~" ) COLUMN(NAME=~"mov_contabile.prog_stampato~") COLUMN(NAME=~"mov_contabile.st_stampa_bollato~") COLUMN(NAME=~"mov_contabile.numero~") COLUMN(NAME=~"reg_pd.id_reg_pd~") COLUMN(NAME=~"reg_pd.data_registrazione~") COLUMN(NAME=~"registro.tipo_registro~") COLUMN(NAME=~"mov_contabile.id_mov_contabile~") COLUMN(NAME=~"mov_contabile.st_data_bollato~")    JOIN (LEFT=~"reg_pd.id_reg_pd~"    OP =~"=~"RIGHT=~"mov_contabile.id_reg_pd~" )    JOIN (LEFT=~"registro.id_registro~"    OP =~"=~"RIGHT=~"reg_pd.id_registro~" )WHERE(    EXP1 =~"~~~"mov_contabile~~~".~~~"id_reg_pd~~~"~"   OP =~"=~"    EXP2 =~":id_reg_pd~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"mov_contabile~~~".~~~"st_stampa_bollato~~~"~"   OP =~"<>~"    EXP2 =~"'S'~" ) ) ORDER(NAME=~"mov_contabile.numero~" ASC=yes ) ARG(NAME = ~"id_reg_pd~" TYPE = number) " update="mov_contabile" updatewhere=1 updatekeyinplace=yes arguments=(("id_reg_pd", number)) )
