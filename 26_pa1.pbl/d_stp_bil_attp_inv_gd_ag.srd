 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"chiusura_apertura~" )  TABLE(NAME=~"conto~" )  TABLE(NAME=~"mastro~" )  TABLE(NAME=~"sottomastro~" ) COLUMN(NAME=~"conto.codice~") COLUMN(NAME=~"conto.descrizione~") COLUMN(NAME=~"chiusura_apertura.saldo_dare~") COLUMN(NAME=~"chiusura_apertura.saldo_avere~") COLUMN(NAME=~"chiusura_apertura.data~") COLUMN(NAME=~"chiusura_apertura.tipo~") COMPUTE(NAME=~"cast(left(~~~"conto~~~".~~~"codice~~~",2) as char) as mastro~") COMPUTE(NAME=~"cast(substr(~~~"conto~~~".~~~"codice~~~",3,2) as char) as sottomastr~") COLUMN(NAME=~"mastro.descrizione~") COLUMN(NAME=~"sottomastro.descrizione~") COLUMN(NAME=~"chiusura_apertura.saldo1~") COMPUTE(NAME=~"cast(~~~"chiusura_apertura~~~".~~~"saldo_dare~~~" as decimal) as dare_valuta~") COMPUTE(NAME=~"cast(~~~"chiusura_apertura~~~".~~~"saldo_avere~~~" as decimal) as avere_valuta~") COMPUTE(NAME=~"cast(~~~"chiusura_apertura~~~".~~~"saldo1~~~" as decimal) as saldo_valuta~")    JOIN (LEFT=~"chiusura_apertura.id_conto~"    OP =~"=~"RIGHT=~"conto.id_conto~" )    JOIN (LEFT=~"conto.id_sottomastro~"    OP =~"=~"RIGHT=~"sottomastro.id_sottomastro~" )    JOIN (LEFT=~"mastro.id_mastro~"    OP =~"=~"RIGHT=~"sottomastro.id_mastro~" )WHERE(    EXP1 =~"~~~"chiusura_apertura~~~".~~~"tipo~~~"~"   OP =~"=~"    EXP2 =~"'P'~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"(~~~"chiusura_apertura~~~".~~~"saldo_dare~~~"~"   OP =~">~"    EXP2 =~"0~"    LOGIC =~"or~" ) WHERE(    EXP1 =~"~~~"chiusura_apertura~~~".~~~"saldo_avere~~~"~"   OP =~">~"    EXP2 =~"0)~" ) ) ORDER(NAME=~"7~" ASC=yes )  ORDER(NAME=~"8~" ASC=yes )  ORDER(NAME=~"chiusura_apertura.tipo~" ASC=yes )  ORDER(NAME=~"conto.codice~" ASC=yes ) ARG(NAME = ~"rn_cambio~" TYPE = number)  ARG(NAME = ~"rs_formato~" TYPE = string) " filter="tot_riga<>0" arguments=(("rn_cambio", number),("rs_formato", string))  sort="conto_codice A " )
