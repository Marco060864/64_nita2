 column=(type=decimal(4) updatewhereclause=yes name=tot1 dbname="tot1" )
 column=(type=long updatewhereclause=yes name=segno dbname="segno" )
 retrieve="  SELECT ~"bilancio_cee~".~"pos1~",   
         ~"bilancio_cee~".~"pos2~",   
         ~"bilancio_cee~".~"pos3~",   
         ~"bilancio_cee~".~"pos4~",   
         ~"bilancio_cee~".~"saldo1~",   
         ~"bilancio_cee~".~"saldo2~",   
         cast( pos3+' )' as char(5)) as pos3new,   
         cast( pos4+' )' as char(5)) as pos4new,   
         cast( pos1+' )' as char(5)) as pos1new,   
         ~"bilancio_cee~".~"id_bilancio_cee~",   
         ~"bilancio_cee~".~"tipo~",   
         ~"bilancio_cee~".~"descrizione~",   
         ~"bilancio_cee~".~"riferimento~",   
         ~"bilancio_cee~".~"flag~",   
         cast( pos2+' )' as char(6)) as pos2new,   
         cast( null as numeric(18,4)) as tot2,   
         cast( null as numeric(18,4)) as tot1,   
         cast( null as integer) as segno  
    FROM ~"bilancio_cee~"  
   WHERE ~"bilancio_cee~".~"tipo~" = 'PP'     AND  
         (~"bilancio_cee~".~"saldo1~" <> 0 OR  
         ~"bilancio_cee~".~"saldo2~" <> 0  OR
         ~"bilancio_cee~".~"flag~" is not null)    
" update="bilancio_cee" updatewhere=1 updatekeyinplace=yes arguments=(("rn_anno", number))  sort="pos1 A ordpos2 A ordpos3 A pos4 A " )
