 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"bilancio_cee~" ) COLUMN(NAME=~"bilancio_cee.pos1~") COLUMN(NAME=~"bilancio_cee.pos2~") COLUMN(NAME=~"bilancio_cee.pos3~") COLUMN(NAME=~"bilancio_cee.pos4~") COLUMN(NAME=~"bilancio_cee.saldo1~") COLUMN(NAME=~"bilancio_cee.saldo2~") COMPUTE(NAME=~"cast( pos2+' )' as char(5)) as pos2new~") COMPUTE(NAME=~"cast( pos3+' )' as char(5)) as pos3new~") COMPUTE(NAME=~"cast( pos4+' )' as char(5)) as pos4new~") COMPUTE(NAME=~"cast( pos1+' )' as char(5)) as pos1new~") COLUMN(NAME=~"bilancio_cee.id_bilancio_cee~") COLUMN(NAME=~"bilancio_cee.tipo~") COLUMN(NAME=~"bilancio_cee.descrizione~") COLUMN(NAME=~"bilancio_cee.riferimento~") COLUMN(NAME=~"bilancio_cee.flag~")WHERE(    EXP1 =~"~~~"bilancio_cee~~~".~~~"tipo~~~"~"   OP =~"=~"    EXP2 =~"'PA'~"    LOGIC =~"or~" ) WHERE(    EXP1 =~"~~~"bilancio_cee~~~".~~~"tipo~~~"~"   OP =~"=~"    EXP2 =~"'PP'~"    LOGIC =~"or~" ) WHERE(    EXP1 =~"~~~"bilancio_cee~~~".~~~"tipo~~~"~"   OP =~"=~"    EXP2 =~"'E'~"    LOGIC =~"or~" ) WHERE(    EXP1 =~"~~~"bilancio_cee~~~".~~~"tipo~~~"~"   OP =~"=~"    EXP2 =~"'O'~" ) ) " update="bilancio_cee" updatewhere=1 updatekeyinplace=yes  sort="tipo_pa D tipo_pp D tipo_o D tipo_e D pos1 A pos2_dec A pos2x A pos2 A pos3dec A pos3 A pos4 A " )
