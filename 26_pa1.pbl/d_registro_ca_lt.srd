table(column=(type=long update=yes updatewhereclause=yes identity=yes name=registro_id_registro dbname="registro.id_registro" )
 column=(type=char(2) update=yes updatewhereclause=yes name=tipo_registro dbname="registro.tipo_registro" values="IVA acquisti	IA/IVA vendite	IV/Manageriale	MN/Prima nota	PN/Preventivi acquisti	PA/Preventivi vendite	PV/Ordini acquisti	OA/Ordini vendite	OV/DDT acquisti	DA/DDT vendite	DV/Liste prelievo acquisti	LA/Liste prelievo vendite	LV/Generico acquisti	GA/Generico vendite	GV/" )
 column=(type=decimal(0) update=yes updatewhereclause=yes name=registro_numero dbname="registro.numero" validation=" real(gettext())  >= 0" validationmsg="'Immettere un valore >= 0'" )
 column=(type=char(40) update=yes updatewhereclause=yes name=registro_descrizione dbname="registro.descrizione" )
 column=(type=char(1) update=yes updatewhereclause=yes name=registro_usa_prorata dbname="registro.usa_prorata" initial="N" values="	S/	N" validation=" gettext()  = 'S' OR  gettext()  = 'N'" validationmsg="'Immettere: S, N'" )
 column=(type=char(1) update=yes updatewhereclause=yes name=registro_iva_sospensione dbname="registro.iva_sospensione" initial="N" values="	S/	N" validation=" gettext()  = 'S' OR  gettext()  = 'N'" validationmsg="'Immettere: S, N'" )
 column=(type=long update=yes updatewhereclause=yes name=registro_id_azienda dbname="registro.id_azienda" initial="1" )
 column=(type=char(1) update=yes updatewhereclause=yes name=registro_ges_sco_giornaliero dbname="registro.ges_sco_giornaliero" initial="N" values="	S/	N" validation=" gettext()  = 'S' OR  gettext()  = 'N'" validationmsg="'Immettere: S, N'" )
 column=(type=long updatewhereclause=yes name=registro_id_esercizio dbname="registro.id_esercizio" )
 column=(type=long updatewhereclause=yes name=registro_id_mod_registro dbname="registro.id_mod_registro" )
 column=(type=long updatewhereclause=yes name=id_attivita dbname="registro.id_attivita" )
 column=(type=char(4) updatewhereclause=yes name=esercizio_codice dbname="esercizio.codice" )
 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"registro~" )  TABLE(NAME=~"azienda~" )  TABLE(NAME=~"esercizio~" ) COLUMN(NAME=~"registro.id_registro~") COLUMN(NAME=~"registro.tipo_registro~") COLUMN(NAME=~"registro.numero~") COLUMN(NAME=~"registro.descrizione~") COLUMN(NAME=~"registro.usa_prorata~") COLUMN(NAME=~"registro.iva_sospensione~") COLUMN(NAME=~"registro.id_azienda~") COLUMN(NAME=~"registro.ges_sco_giornaliero~") COLUMN(NAME=~"registro.id_esercizio~") COLUMN(NAME=~"registro.id_mod_registro~") COLUMN(NAME=~"registro.id_attivita~") COLUMN(NAME=~"esercizio.codice~")    JOIN (LEFT=~"esercizio.id_esercizio~"    OP =~"=~"RIGHT=~"registro.id_esercizio~" )    JOIN (LEFT=~"azienda.id_azienda~"    OP =~"=~"RIGHT=~"registro.id_azienda~" )) " )
