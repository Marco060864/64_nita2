 column=(type=long update=yes updatewhereclause=yes identity=yes name=conto_id_conto dbname="conto.id_conto" )
 column=(type=long updatewhereclause=yes identity=yes name=id_sog_commerciale dbname="sog_commerciale.id_sog_commerciale" )
 column=(type=char(1) updatewhereclause=yes name=uso dbname="sottomastro.uso" )
 column=(type=char(80) updatewhereclause=yes name=bilancio_cee_descrizione dbname="bilancio_cee.descrizione" )
 column=(type=long updatewhereclause=yes identity=yes name=id_bilancio_cee dbname="bilancio_cee.id_bilancio_cee" )
 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"conto~" )  TABLE(NAME=~"mastro~" )  TABLE(NAME=~"sottomastro~" )  TABLE(NAME=~"sog_commerciale~" )  TABLE(NAME=~"bilancio_cee~" ) COLUMN(NAME=~"conto.codice~") COLUMN(NAME=~"conto.descrizione~") COLUMN(NAME=~"mastro.codice~") COLUMN(NAME=~"mastro.descrizione~") COLUMN(NAME=~"sottomastro.codice~") COLUMN(NAME=~"sottomastro.descrizione~") COLUMN(NAME=~"conto.ges_par_aperte~") COLUMN(NAME=~"conto.id_conto~") COLUMN(NAME=~"sog_commerciale.id_sog_commerciale~") COLUMN(NAME=~"sottomastro.uso~") COLUMN(NAME=~"bilancio_cee.descrizione~") COLUMN(NAME=~"bilancio_cee.id_bilancio_cee~")    JOIN (LEFT=~"sog_commerciale.id_conto~"    OP =~"=~"RIGHT=~"conto.id_conto~"    OUTER2 =~"conto.id_conto~" )    JOIN (LEFT=~"sottomastro.id_mastro~"    OP =~"=~"RIGHT=~"mastro.id_mastro~" )    JOIN (LEFT=~"sottomastro.id_sottomastro~"    OP =~"=~"RIGHT=~"conto.id_sottomastro~" )    JOIN (LEFT=~"bilancio_cee.id_bilancio_cee~"    OP =~"=~"RIGHT=~"conto.id_bilancio_cee~" )WHERE(    EXP1 =~"~~~"conto~~~".~~~"id_azienda~~~"~"   OP =~"in~"    EXP2 =~"(0,1)~" ) ) ORDER(NAME=~"conto.codice~" ASC=yes ) " )
