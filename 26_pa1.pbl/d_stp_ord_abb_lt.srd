 column=(type=char(5) updatewhereclause=yes name=pos3new dbname="pos3new" )
 column=(type=char(5) updatewhereclause=yes name=pos4new dbname="pos4new" )
 column=(type=char(5) updatewhereclause=yes name=pos1new dbname="pos1new" )
 column=(type=long updatewhereclause=yes key=yes identity=yes name=id_bilancio_cee dbname="bilancio_cee.id_bilancio_cee" )
 column=(type=char(2) updatewhereclause=yes name=tipo dbname="bilancio_cee.tipo" )
 column=(type=char(80) updatewhereclause=yes name=descrizione dbname="bilancio_cee.descrizione" )
 column=(type=decimal(0) updatewhereclause=yes name=riferimento dbname="bilancio_cee.riferimento" )
 column=(type=char(1) updatewhereclause=yes name=flag dbname="bilancio_cee.flag" )
 column=(type=char(6) updatewhereclause=yes name=pos2new dbname="pos2new" )
 retrieve="  SELECT ~"bilancio_cee~".~"pos1~",   
         ~"bilancio_cee~".~"pos2~",   
         ~"bilancio_cee~".~"pos3~",   
         ~"bilancio_cee~".~"pos4~",   
         ~"bilancio_cee~".~"saldo1~",   
         ~"bilancio_cee~".~"saldo2~",   
         cast( pos3+' )' as char(5)) as pos3new,   
         cast( pos4+' )' as char(5)) as pos4new,   
         cast( pos1+' )' as char(5)) as pos1new,   
         ~"bilancio_cee~".~"id_bilancio_cee~",   
         ~"bilancio_cee~".~"tipo~",   
         ~"bilancio_cee~".~"descrizione~",   
         ~"bilancio_cee~".~"riferimento~",   
         ~"bilancio_cee~".~"flag~",   
         cast( pos2+' )' as char(6)) as pos2new  
    FROM ~"bilancio_cee~"  
   WHERE ~"bilancio_cee~".~"tipo~" = 'O'     AND  
         (~"bilancio_cee~".~"saldo1~" <> 0 OR  
         ~"bilancio_cee~".~"saldo2~" <> 0  OR
         ~"bilancio_cee~".~"flag~" is not null)   
" update="bilancio_cee" updatewhere=1 updatekeyinplace=yes arguments=(("rn_anno", number))  sort="pos1 A ordpos2 A ordpos3 A pos4 A " )
group(level=1 header.height=76 trailer.height=4 by=("pos1" , "new_pos_2" ) header.color="536870912" trailer.color="536870912"  sort="pos1 A new_pos_2 A " )
