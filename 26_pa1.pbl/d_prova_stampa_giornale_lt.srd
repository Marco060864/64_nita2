 column=(type=char(2) updatewhereclause=yes name=registro_tipo_registro dbname="registro.tipo_registro" )
 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"mov_contabile~" )  TABLE(NAME=~"reg_pd~" )  TABLE(NAME=~"conto~" )  TABLE(NAME=~"registro~" ) COLUMN(NAME=~"mov_contabile.prog_stampato~") COLUMN(NAME=~"reg_pd.data_registrazione~") COLUMN(NAME=~"reg_pd.data_competenza~") COLUMN(NAME=~"reg_pd.num_documento~") COLUMN(NAME=~"reg_pd.data_documento~") COLUMN(NAME=~"reg_pd.descrizione~") COLUMN(NAME=~"conto.codice~") COLUMN(NAME=~"conto.descrizione~") COLUMN(NAME=~"mov_contabile.dare~") COLUMN(NAME=~"mov_contabile.avere~") COLUMN(NAME=~"registro.tipo_registro~")    JOIN (LEFT=~"reg_pd.id_reg_pd~"    OP =~"=~"RIGHT=~"mov_contabile.id_reg_pd~" )    JOIN (LEFT=~"conto.id_conto~"    OP =~"=~"RIGHT=~"mov_contabile.id_conto~" )    JOIN (LEFT=~"registro.id_registro~"    OP =~"=~"RIGHT=~"reg_pd.id_registro~" )WHERE(    EXP1 =~"(( ~~~"registro~~~".~~~"tipo_registro~~~"~"   OP =~"=~"    EXP2 =~"'IV' )~"    LOGIC =~"or~" ) WHERE(    EXP1 =~"( ~~~"registro~~~".~~~"tipo_registro~~~"~"   OP =~"=~"    EXP2 =~"'IC' )~"    LOGIC =~"or~" ) WHERE(    EXP1 =~"( ~~~"registro~~~".~~~"tipo_registro~~~"~"   OP =~"=~"    EXP2 =~"'IA' )~"    LOGIC =~"or~" ) WHERE(    EXP1 =~"( ~~~"registro~~~".~~~"tipo_registro~~~"~"   OP =~"=~"    EXP2 =~"'PN' ))~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"( ~~~"reg_pd~~~".~~~"data_registrazione~~~"~"   OP =~"<=~"    EXP2 =~":rn_data_reg )~" ) ) ARG(NAME = ~"rn_data_reg~" TYPE = date) " arguments=(("rn_data_reg", date))  sort="reg_pd_data_registrazione A " )
