 column=(type=char(40) updatewhereclause=yes name=mastro_descrizione dbname="mastro.descrizione" )
 column=(type=char(40) updatewhereclause=yes name=sottomastro_descrizione dbname="sottomastro.descrizione" )
 column=(type=decimal(4) updatewhereclause=yes name=cdare_valuta dbname="dare_valuta" )
 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"chiusura_apertura~" )  TABLE(NAME=~"conto~" )  TABLE(NAME=~"mastro~" )  TABLE(NAME=~"sottomastro~" ) COLUMN(NAME=~"conto.codice~") COLUMN(NAME=~"conto.descrizione~") COLUMN(NAME=~"chiusura_apertura.saldo_dare~") COLUMN(NAME=~"chiusura_apertura.saldo_avere~") COLUMN(NAME=~"chiusura_apertura.data~") COLUMN(NAME=~"chiusura_apertura.tipo~") COMPUTE(NAME=~"cast(left(~~~"conto~~~".~~~"codice~~~",2) as char) as mastro~") COMPUTE(NAME=~"cast(substr(~~~"conto~~~".~~~"codice~~~",3,2) as char) as sottomastr~") COLUMN(NAME=~"mastro.descrizione~") COLUMN(NAME=~"sottomastro.descrizione~") COMPUTE(NAME=~"cast(~~~"chiusura_apertura~~~".~~~"saldo_dare~~~" as decimal) as dare_valuta~")    JOIN (LEFT=~"chiusura_apertura.id_conto~"    OP =~"=~"RIGHT=~"conto.id_conto~" )    JOIN (LEFT=~"conto.id_sottomastro~"    OP =~"=~"RIGHT=~"sottomastro.id_sottomastro~" )    JOIN (LEFT=~"mastro.id_mastro~"    OP =~"=~"RIGHT=~"sottomastro.id_mastro~" )WHERE(    EXP1 =~"~~~"chiusura_apertura~~~".~~~"tipo~~~"~"   OP =~"=~"    EXP2 =~"'P'~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"chiusura_apertura~~~".~~~"saldo_dare~~~"~"   OP =~">~"    EXP2 =~"0~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"(~~~"mastro~~~".~~~"codice~~~"~"   OP =~"=~"    EXP2 =~"(select  pref_cod_cliente from par_sistema)~"    LOGIC =~"or~" ) WHERE(    EXP1 =~"~~~"mastro~~~".~~~"codice~~~"~"   OP =~"=~"    EXP2 =~"(select pref_cod_fornitore from par_sistema))~" ) ) ORDER(NAME=~"7~" ASC=yes )  ORDER(NAME=~"8~" ASC=yes )  ORDER(NAME=~"chiusura_apertura.tipo~" ASC=yes )  ORDER(NAME=~"conto.codice~" ASC=yes ) ARG(NAME = ~"rn_cambio~" TYPE = number)  ARG(NAME = ~"rs_formato~" TYPE = string) " arguments=(("rn_cambio", number),("rs_formato", string))  sort="conto_codice A " )
