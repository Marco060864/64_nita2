 column=(type=char(40) updatewhereclause=yes name=azienda_rag_soc_1 dbname="azienda.rag_soc_1" )
 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"chiusura_apertura~" )  TABLE(NAME=~"conto~" )  TABLE(NAME=~"azienda~" ) COLUMN(NAME=~"conto.codice~") COLUMN(NAME=~"conto.descrizione~") COLUMN(NAME=~"chiusura_apertura.saldo_dare~") COLUMN(NAME=~"chiusura_apertura.saldo_avere~") COLUMN(NAME=~"chiusura_apertura.data~") COLUMN(NAME=~"chiusura_apertura.tipo~") COLUMN(NAME=~"azienda.id_azienda~") COLUMN(NAME=~"azienda.rag_soc_1~")    JOIN (LEFT=~"chiusura_apertura.id_conto~"    OP =~"=~"RIGHT=~"conto.id_conto~" )    JOIN (LEFT=~"conto.id_azienda~"    OP =~"=~"RIGHT=~"azienda.id_azienda~" )) ORDER(NAME=~"chiusura_apertura.tipo~" ASC=yes )  ORDER(NAME=~"chiusura_apertura.saldo_dare~" ASC=yes )  ORDER(NAME=~"chiusura_apertura.saldo_avere~" ASC=yes ) "  sort="conto_codice A " )
