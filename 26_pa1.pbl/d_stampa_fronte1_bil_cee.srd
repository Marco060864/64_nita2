 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"azienda~" )  TABLE(NAME=~"sede~" ) COLUMN(NAME=~"azienda.rag_soc_1~") COLUMN(NAME=~"sede.localita~") COLUMN(NAME=~"sede.indirizzo~") COLUMN(NAME=~"azienda.cod_fiscale~") COLUMN(NAME=~"azienda.tot_capitale~") COLUMN(NAME=~"azienda.cciaa~") COLUMN(NAME=~"azienda.trib_iscrizione~") COLUMN(NAME=~"azienda.id_azienda~") COMPUTE(NAME=~":rn_cod_esercizio as cod_esercizio~") COMPUTE(NAME=~"cast (:rn_data_in as date) as cdata_in~") COMPUTE(NAME=~"cast (:rn_data_fin as date) as cdata_fin~")    JOIN (LEFT=~"azienda.id_azienda~"    OP =~"=~"RIGHT=~"sede.id_azienda~" )WHERE(    EXP1 =~"( ( ~~~"sede~~~".~~~"tipo_sede~~~"~"   OP =~"=~"    EXP2 =~"'L' ) )~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"azienda~~~".~~~"id_azienda~~~"~"   OP =~"=~"    EXP2 =~":rn_id_azienda~" ) ) ARG(NAME = ~"rn_id_azienda~" TYPE = number)  ARG(NAME = ~"rn_cod_esercizio~" TYPE = number)  ARG(NAME = ~"rn_data_in~" TYPE = date)  ARG(NAME = ~"rn_data_fin~" TYPE = date)  ARG(NAME = ~"rn_cambio~" TYPE = number) " arguments=(("rn_id_azienda", number),("rn_cod_esercizio", number),("rn_data_in", date),("rn_data_fin", date),("rn_cambio", number)) )
