table(column=(type=long updatewhereclause=yes identity=yes name=id_conto dbname="conto.id_conto" )
 column=(type=decimal(4) updatewhereclause=yes name=dare dbname="mov_contabile.dare" )
 column=(type=decimal(4) updatewhereclause=yes name=avere dbname="mov_contabile.avere" )
 column=(type=char(8) updatewhereclause=yes name=conto_codice dbname="conto.codice" )
 column=(type=long updatewhereclause=yes identity=yes name=mastro_id_mastro dbname="mastro.id_mastro" )
 column=(type=long updatewhereclause=yes identity=yes name=sottomastro_id_sottomastro dbname="sottomastro.id_sottomastro" )
 column=(type=char(2) updatewhereclause=yes name=mastro_codice dbname="mastro.codice" )
 column=(type=char(2) updatewhereclause=yes name=sottomastro_codice dbname="sottomastro.codice" )
 column=(type=char(40) updatewhereclause=yes name=mastro_descrizione dbname="mastro.descrizione" )
 column=(type=char(40) updatewhereclause=yes name=sottomastro_descrizione dbname="sottomastro.descrizione" )
 column=(type=char(40) updatewhereclause=yes name=conto_descrizione dbname="conto.descrizione" )
 column=(type=date updatewhereclause=yes name=reg_pd_data_competenza dbname="reg_pd.data_competenza" )
 column=(type=date updatewhereclause=yes name=reg_pd_data_registrazione dbname="reg_pd.data_registrazione" )
 column=(type=long updatewhereclause=yes name=registro_id_esercizio dbname="registro.id_esercizio" )
 retrieve="  SELECT ~"conto~".~"id_conto~",   
         ~"mov_contabile~".~"dare~",   
         ~"mov_contabile~".~"avere~",   
       ~"conto~".~"codice~",   
         ~"mastro~".~"id_mastro~",   
         ~"sottomastro~".~"id_sottomastro~",   
         ~"mastro~".~"codice~",   
         ~"sottomastro~".~"codice~",   
         ~"mastro~".~"descrizione~",   
         ~"sottomastro~".~"descrizione~",   
         ~"conto~".~"descrizione~",   
         ~"reg_pd~".~"data_competenza~",   
         ~"reg_pd~".~"data_registrazione~",
  registro.id_esercizio
    FROM ~"conto~",   
         ~"mov_contabile~",   
         ~"reg_pd~",   
         ~"registro~",   
         ~"mastro~",   
         ~"sottomastro~"  
   WHERE ( ~"conto~".~"id_conto~" = ~"mov_contabile~".~"id_conto~" ) and  
         ( ~"mov_contabile~".~"id_reg_pd~" = ~"reg_pd~".~"id_reg_pd~" ) and  
         ( ~"conto~".~"id_sottomastro~" = ~"sottomastro~".~"id_sottomastro~" ) and  
         ( ~"sottomastro~".~"id_mastro~" = ~"mastro~".~"id_mastro~" ) and  
         ( ~"reg_pd~".~"id_registro~" = ~"registro~".~"id_registro~" ) and  
         (reg_pd.data_competenza >= :data_da) AND  
         (reg_pd.data_competenza <= :data_a ) AND  
         reg_pd.id_prof_registrazione <> :prof_chiu AND  
         registro.tipo_registro <> 'MN' AND  
         ( ( mastro.tipo = 'C') OR  
         (mastro.tipo = 'R') OR  
         (mastro.tipo = 'E'))    
" filter="c_saldo_controllo_2>0  or  c_saldo_controllo > 0"arguments=(("data_da", date),("data_a", date),("prof_aper", number),("prof_chiu", number))  sort="mastro_codice A sottomastro_codice A conto_codice A " )
