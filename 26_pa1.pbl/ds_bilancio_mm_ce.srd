 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"conto~" )  TABLE(NAME=~"mov_contabile~" )  TABLE(NAME=~"reg_pd~" )  TABLE(NAME=~"registro~" )  TABLE(NAME=~"mastro~" )  TABLE(NAME=~"sottomastro~" ) COLUMN(NAME=~"conto.id_conto~") COLUMN(NAME=~"mov_contabile.dare~") COLUMN(NAME=~"mov_contabile.avere~") COMPUTE(NAME=~"cast((select id_valuta from esercizio where id_esercizio=~~~"registro~~~".~~~"id_esercizio~~~") as numeric ) as val_es~") COMPUTE(NAME=~"cast(fn_conv_valuta(val_es,~~~"mov_contabile~~~".~~~"avere~~~",:rd_val) as decimal(18,4) ) as vavere~") COMPUTE(NAME=~"cast(fn_conv_valuta(val_es,~~~"mov_contabile~~~".~~~"dare~~~",:rd_val) as decimal(18,4) ) as vdare~") COLUMN(NAME=~"conto.codice~") COLUMN(NAME=~"mastro.id_mastro~") COLUMN(NAME=~"sottomastro.id_sottomastro~") COLUMN(NAME=~"mastro.codice~") COLUMN(NAME=~"sottomastro.codice~") COLUMN(NAME=~"mastro.descrizione~") COLUMN(NAME=~"sottomastro.descrizione~") COLUMN(NAME=~"conto.descrizione~")    JOIN (LEFT=~"conto.id_conto~"    OP =~"=~"RIGHT=~"mov_contabile.id_conto~" )    JOIN (LEFT=~"mov_contabile.id_reg_pd~"    OP =~"=~"RIGHT=~"reg_pd.id_reg_pd~" )    JOIN (LEFT=~"conto.id_sottomastro~"    OP =~"=~"RIGHT=~"sottomastro.id_sottomastro~" )    JOIN (LEFT=~"sottomastro.id_mastro~"    OP =~"=~"RIGHT=~"mastro.id_mastro~" )    JOIN (LEFT=~"reg_pd.id_registro~"    OP =~"=~"RIGHT=~"registro.id_registro~" )WHERE(    EXP1 =~"(reg_pd.data_competenza~"   OP =~">=~"    EXP2 =~":data_da)~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"(reg_pd.data_competenza~"   OP =~"<=~"    EXP2 =~":data_a )~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"reg_pd.id_prof_registrazione~"   OP =~"<>~"    EXP2 =~":prof_chiu~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"registro.tipo_registro~"   OP =~"<>~"    EXP2 =~"'MN'~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"( ( mastro.tipo~"   OP =~"=~"    EXP2 =~"'C')~"    LOGIC =~"or~" ) WHERE(    EXP1 =~"(mastro.tipo~"   OP =~"=~"    EXP2 =~"'R')~"    LOGIC =~"or~" ) WHERE(    EXP1 =~"(mastro.tipo~"   OP =~"=~"    EXP2 =~"'E'))~" ) ) ARG(NAME = ~"data_da~" TYPE = date)  ARG(NAME = ~"data_a~" TYPE = date)  ARG(NAME = ~"prof_aper~" TYPE = number)  ARG(NAME = ~"prof_chiu~" TYPE = number)  ARG(NAME = ~"rd_val~" TYPE = number) " arguments=(("data_da", date),("data_a", date),("prof_aper", number),("prof_chiu", number),("rd_val", number))  sort="mastro_codice A sottomastro_codice A conto_codice A " )
