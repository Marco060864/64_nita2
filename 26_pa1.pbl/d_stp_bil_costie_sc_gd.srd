header(height=96 color="536870912" )
summary(height=0 color="553648127" )
footer(height=0 color="553648127" )
detail(height=76 color="536870912" )
table(column=(type=char(8) updatewhereclause=yes name=conto_codice dbname="conto.codice" )
 column=(type=char(40) updatewhereclause=yes name=conto_descrizione dbname="conto.descrizione" )
 column=(type=decimal(4) updatewhereclause=yes name=dare dbname="chiusura_apertura.saldo_dare" )
 column=(type=decimal(4) updatewhereclause=yes name=avere dbname="chiusura_apertura.saldo_avere" )
 column=(type=date updatewhereclause=yes name=chiusura_apertura_data dbname="chiusura_apertura.data" )
 column=(type=char(1) updatewhereclause=yes name=tipo dbname="chiusura_apertura.tipo" )
 column=(type=char(2) updatewhereclause=yes name=csottomastro dbname="sottomastro" )
 column=(type=char(2) updatewhereclause=yes name=cmastro dbname="mastro" )
 column=(type=char(40) updatewhereclause=yes name=sottomastro_descrizione dbname="sottomastro.descrizione" )
 column=(type=char(40) updatewhereclause=yes name=mastro_descrizione dbname="mastro.descrizione" )
 column=(type=decimal(4) updatewhereclause=yes name=chiusura_apertura_saldo1 dbname="chiusura_apertura.saldo1" )
 column=(type=decimal(4) updatewhereclause=yes name=saldo_valuta dbname="saldo_valuta" )
 column=(type=decimal(4) updatewhereclause=yes name=avere_valuta dbname="avere_valuta" )
 column=(type=decimal(4) updatewhereclause=yes name=cdare_valuta dbname="dare_valuta" )
 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"chiusura_apertura~" )  TABLE(NAME=~"conto~" )  TABLE(NAME=~"mastro~" )  TABLE(NAME=~"sottomastro~" ) COLUMN(NAME=~"conto.codice~") COLUMN(NAME=~"conto.descrizione~") COLUMN(NAME=~"chiusura_apertura.saldo_dare~") COLUMN(NAME=~"chiusura_apertura.saldo_avere~") COLUMN(NAME=~"chiusura_apertura.data~") COLUMN(NAME=~"chiusura_apertura.tipo~") COMPUTE(NAME=~"cast(substr(~~~"conto~~~".~~~"codice~~~",3,2) as char) as sottomastro~") COMPUTE(NAME=~"cast(left(~~~"conto~~~".~~~"codice~~~",2) as char) as mastro~") COLUMN(NAME=~"sottomastro.descrizione~") COLUMN(NAME=~"mastro.descrizione~") COLUMN(NAME=~"chiusura_apertura.saldo1~") COMPUTE(NAME=~"cast(~~~"chiusura_apertura~~~".~~~"saldo1~~~" as decimal) as saldo_valuta~") COMPUTE(NAME=~"cast(~~~"chiusura_apertura~~~".~~~"saldo_avere~~~" as decimal) as avere_valuta~") COMPUTE(NAME=~"cast(~~~"chiusura_apertura~~~".~~~"saldo_dare~~~" as decimal) as dare_valuta~")    JOIN (LEFT=~"chiusura_apertura.id_conto~"    OP =~"=~"RIGHT=~"conto.id_conto~" )    JOIN (LEFT=~"conto.id_sottomastro~"    OP =~"=~"RIGHT=~"sottomastro.id_sottomastro~" )    JOIN (LEFT=~"sottomastro.id_mastro~"    OP =~"=~"RIGHT=~"mastro.id_mastro~" )WHERE(    EXP1 =~"~~~"chiusura_apertura~~~".~~~"tipo~~~"~"   OP =~"=~"    EXP2 =~"'E'~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"(~~~"chiusura_apertura~~~".~~~"saldo_dare~~~"~"   OP =~">~"    EXP2 =~"0~"    LOGIC =~"or~" ) WHERE(    EXP1 =~"~~~"chiusura_apertura~~~".~~~"saldo_avere~~~"~"   OP =~">~"    EXP2 =~"0~"    LOGIC =~"or~" ) WHERE(    EXP1 =~"~~~"chiusura_apertura~~~".~~~"saldo1~~~"~"   OP =~">~"    EXP2 =~"0)~" ) ) ORDER(NAME=~"chiusura_apertura.tipo~" ASC=yes )  ORDER(NAME=~"conto.codice~" ASC=yes ) ARG(NAME = ~"rn_cambio~" TYPE = number)  ARG(NAME = ~"rs_formato~" TYPE = string) " arguments=(("rn_cambio", number),("rs_formato", string)) )
