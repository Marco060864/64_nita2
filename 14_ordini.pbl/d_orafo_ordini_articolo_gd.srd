 column=(type=date updatewhereclause=yes name=data_prev_consegna dbname="documento.data_prev_consegna" )
 column=(type=date updatewhereclause=yes name=data_scadenza dbname="documento.data_scadenza" )
 column=(type=long updatewhereclause=yes name=riga_documento_id_articolo dbname="riga_documento.id_articolo" )
 column=(type=long updatewhereclause=yes name=id_sog_commerciale dbname="documento.id_sog_commerciale" )
 column=(type=char(16) updatewhereclause=yes name=num_progressivo dbname="documento.num_documento" )
 column=(type=date updatewhereclause=yes name=data_registrazione dbname="documento.data_documento" )
 column=(type=char(20) updatewhereclause=yes name=documento_bollo dbname="documento.bollo" )
 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"documento~" )  TABLE(NAME=~"mod_registro~" )  TABLE(NAME=~"registro~" )  TABLE(NAME=~"riga_documento~" ) COLUMN(NAME=~"documento.id_documento~") COLUMN(NAME=~"documento.num_progressivo~") COLUMN(NAME=~"documento.data_registrazione~") COLUMN(NAME=~"documento.ora_registrazione~") COLUMN(NAME=~"documento.evaso_totalmente~") COLUMN(NAME=~"documento.chius_forzata~") COLUMN(NAME=~"documento.data_prev_consegna~") COLUMN(NAME=~"documento.data_scadenza~") COLUMN(NAME=~"riga_documento.id_articolo~") COLUMN(NAME=~"documento.id_sog_commerciale~") COLUMN(NAME=~"documento.num_documento~") COLUMN(NAME=~"documento.data_documento~") COLUMN(NAME=~"documento.bollo~")    JOIN (LEFT=~"registro.id_registro~"    OP =~"=~"RIGHT=~"documento.id_registro~" )    JOIN (LEFT=~"registro.id_mod_registro~"    OP =~"=~"RIGHT=~"mod_registro.id_mod_registro~" )    JOIN (LEFT=~"riga_documento.id_documento~"    OP =~"=~"RIGHT=~"documento.id_documento~" )WHERE(    EXP1 =~"( ~~~"mod_registro~~~".~~~"tipo_registro~~~"~"   OP =~"=~"    EXP2 =~"'ov' ) ~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"riga_documento~~~".~~~"id_articolo~~~"~"   OP =~"=~"    EXP2 =~":rn_id_articolo~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"documento~~~".~~~"evaso_totalmente~~~"~"   OP =~"<>~"    EXP2 =~"'S'~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"documento~~~".~~~"chius_forzata~~~"~"   OP =~"<>~"    EXP2 =~"'S'~" ) ) ARG(NAME = ~"rn_id_articolo~" TYPE = number) " update="documento" updatewhere=1 updatekeyinplace=yes arguments=(("rn_id_articolo", number)) )
