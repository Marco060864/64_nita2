 column=(type=decimal(0) updatewhereclause=yes name=num_progressivo_vero dbname="documento.num_progressivo" )
 column=(type=date updatewhereclause=yes name=data_registrazione_vera dbname="documento.data_registrazione" )
 column=(type=time updatewhereclause=yes name=ora_registrazione dbname="documento.ora_registrazione" )
 column=(type=char(1) updatewhereclause=yes name=documento_evaso_totalmente dbname="documento.evaso_totalmente" )
