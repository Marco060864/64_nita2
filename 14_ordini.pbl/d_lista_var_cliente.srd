 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"riga_distinta~" )  TABLE(NAME=~"orafo_dis_cliente~" )  TABLE(NAME=~"distinta~" )  TABLE(NAME=~"articolo~" ALIAS=~"articolo_a~" )  TABLE(NAME=~"articolo~" ALIAS=~"articolo_b~" )  TABLE(NAME=~"articolo~" ALIAS=~"articolo_c~" ) COLUMN(NAME=~"distinta.id_distinta~") COLUMN(NAME=~"distinta.codice~") COLUMN(NAME=~"distinta.descrizione~") COLUMN(NAME=~"distinta.id_articolo~") COLUMN(NAME=~"riga_distinta.id_articolo~") COLUMN(NAME=~"riga_distinta.quantita~") COLUMN(NAME=~"orafo_dis_cliente.id_art_sostitutivo~") COLUMN(NAME=~"orafo_dis_cliente.quantita~") COMPUTE(NAME=~"cast('N' as char(1)) as modificato~") COLUMN(NAME=~"articolo_a.codice~") COLUMN(NAME=~"articolo_a.descrizione~") COLUMN(NAME=~"orafo_dis_cliente.id_riga_doc~") COLUMN(NAME=~"orafo_dis_cliente.id_cliente~") COLUMN(NAME=~"orafo_dis_cliente.id_art_originale~") COLUMN(NAME=~"riga_distinta.id_riga_distinta~") COLUMN(NAME=~"orafo_dis_cliente.id_riga_distinta~") COLUMN(NAME=~"orafo_dis_cliente.note~") COLUMN(NAME=~"articolo_b.codice~") COLUMN(NAME=~"articolo_b.descrizione~") COLUMN(NAME=~"articolo_c.codice~") COLUMN(NAME=~"articolo_c.descrizione~")    JOIN (LEFT=~"riga_distinta.id_riga_distinta~"    OP =~"=~"RIGHT=~"orafo_dis_cliente.id_riga_distinta~"    OUTER1 =~"riga_distinta.id_riga_distinta~" )    JOIN (LEFT=~"articolo_a.id_articolo~"    OP =~"=~"RIGHT=~"riga_distinta.id_articolo~"    OUTER2 =~"riga_distinta.id_articolo~" )    JOIN (LEFT=~"orafo_dis_cliente.id_art_sostitutivo~"    OP =~"=~"RIGHT=~"articolo_b.id_articolo~"    OUTER1 =~"orafo_dis_cliente.id_art_sostitutivo~" )    JOIN (LEFT=~"distinta.id_articolo~"    OP =~"=~"RIGHT=~"articolo_c.id_articolo~" )    JOIN (LEFT=~"riga_distinta.id_distinta~"    OP =~"=~"RIGHT=~"distinta.id_distinta~" )WHERE(    EXP1 =~"~~~"orafo_dis_cliente~~~".~~~"id_cliente~~~"~"   OP =~"=~"    EXP2 =~":rn_id_cliente~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"articolo_c~~~".~~~"id_articolo~~~"~"   OP =~"=~"    EXP2 =~":rn_id_articolo~" ) ) ARG(NAME = ~"rn_id_cliente~" TYPE = number)  ARG(NAME = ~"rn_id_articolo~" TYPE = number) " update="orafo_dis_cliente" updatewhere=0 updatekeyinplace=no arguments=(("rn_id_cliente", number),("rn_id_articolo", number)) )
