 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"documento~" )  TABLE(NAME=~"mod_registro~" )  TABLE(NAME=~"registro~" ) COLUMN(NAME=~"documento.id_documento~") COLUMN(NAME=~"documento.num_progressivo~") COLUMN(NAME=~"documento.data_registrazione~") COLUMN(NAME=~"documento.ora_registrazione~") COLUMN(NAME=~"documento.evaso_totalmente~") COLUMN(NAME=~"documento.chius_forzata~") COLUMN(NAME=~"documento.data_prev_consegna~") COLUMN(NAME=~"documento.data_scadenza~") COLUMN(NAME=~"documento.id_sog_commerciale~") COLUMN(NAME=~"documento.bollo~")    JOIN (LEFT=~"registro.id_registro~"    OP =~"=~"RIGHT=~"documento.id_registro~" )    JOIN (LEFT=~"registro.id_mod_registro~"    OP =~"=~"RIGHT=~"mod_registro.id_mod_registro~" )WHERE(    EXP1 =~"( ~~~"mod_registro~~~".~~~"tipo_registro~~~"~"   OP =~"=~"    EXP2 =~"'ov' ) ~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"documento~~~".~~~"evaso_totalmente~~~"~"   OP =~"<>~"    EXP2 =~"'S'~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"documento~~~".~~~"chius_forzata~~~"~"   OP =~"<>~"    EXP2 =~"'S'~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"documento~~~".~~~"data_prev_consegna~~~"~"   OP =~"<=~"    EXP2 =~":ad_data_scad~" ) ) ARG(NAME = ~"ad_data_scad~" TYPE = date) " update="documento" updatewhere=1 updatekeyinplace=yes arguments=(("ad_data_scad", date))  sort="data_scadenza A " )
