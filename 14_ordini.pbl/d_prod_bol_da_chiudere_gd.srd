 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"produzione_2011~" )  TABLE(NAME=~"riga_documento~" ALIAS=~"riga_documento_a~" )  TABLE(NAME=~"documento~" )  TABLE(NAME=~"riga_documento~" ALIAS=~"riga_documento_b~" )  TABLE(NAME=~"articolo~" )  TABLE(NAME=~"sog_commerciale_gen~" ) COLUMN(NAME=~"produzione_2011.id_bollettina~") COLUMN(NAME=~"produzione_2011.id_doc_produzione~") COLUMN(NAME=~"documento.id_documento~") COLUMN(NAME=~"documento.num_progressivo~") COLUMN(NAME=~"documento.data_registrazione~") COLUMN(NAME=~"documento.num_documento~") COLUMN(NAME=~"riga_documento_b.peso_netto~") COLUMN(NAME=~"riga_documento_b.sigla_prezzo~") COLUMN(NAME=~"articolo.codice~") COLUMN(NAME=~"sog_commerciale_gen.rag_soc_1~") COLUMN(NAME=~"riga_documento_b.forza_chius_evasione~") COLUMN(NAME=~"riga_documento_b.id_riga_documento~") COLUMN(NAME=~"documento.data_documento~") COLUMN(NAME=~"riga_documento_b.num_riga~")    JOIN (LEFT=~"riga_documento_a.id_riga_documento~"    OP =~"=~"RIGHT=~"produzione_2011.id_doc_produzione~" )    JOIN (LEFT=~"documento.id_documento~"    OP =~"=~"RIGHT=~"produzione_2011.id_bollettina~" )    JOIN (LEFT=~"riga_documento_b.id_documento~"    OP =~"=~"RIGHT=~"documento.id_documento~" )    JOIN (LEFT=~"riga_documento_b.id_articolo~"    OP =~"=~"RIGHT=~"articolo.id_articolo~" )    JOIN (LEFT=~"documento.id_sog_commerciale~"    OP =~"=~"RIGHT=~"sog_commerciale_gen.id_sog_commerciale~" )WHERE(    EXP1 =~"~~~"riga_documento_a~~~".~~~"id_documento~~~"~"   OP =~"=~"    EXP2 =~":ll_id_doc~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"(~~~"articolo~~~".~~~"id_cat_codifica~~~"~"   OP =~"=~"    EXP2 =~"8~"    LOGIC =~"or~" ) WHERE(    EXP1 =~"~~~"articolo~~~".~~~"id_cat_codifica~~~"~"   OP =~"=~"    EXP2 =~"18~"    LOGIC =~"or~" ) WHERE(    EXP1 =~"~~~"articolo~~~".~~~"id_cat_codifica~~~"~"   OP =~"=~"    EXP2 =~"57)~" ) ) ARG(NAME = ~"ll_id_doc~" TYPE = number) " update="riga_documento" updatewhere=1 updatekeyinplace=yes filter=" forza_chius_evasione <>'S'"arguments=(("ll_id_doc", number))  sort="documento_data_documento A num_progressivo A riga_documento_num_riga A " )
