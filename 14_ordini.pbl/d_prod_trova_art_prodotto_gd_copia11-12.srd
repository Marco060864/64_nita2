 retrieve="PBSELECT( VERSION(400) DISTINCT ()TABLE(NAME=~"produzione_2011~" )  TABLE(NAME=~"riga_documento~" ALIAS=~"riga_documento_a~" )  TABLE(NAME=~"documento~" )  TABLE(NAME=~"riga_documento~" ALIAS=~"riga_documento_b~" ) COLUMN(NAME=~"produzione_2011.id_bollettina~") COLUMN(NAME=~"produzione_2011.id_doc_produzione~") COLUMN(NAME=~"documento.id_documento~") COLUMN(NAME=~"documento.num_progressivo~") COLUMN(NAME=~"documento.data_registrazione~") COLUMN(NAME=~"documento.num_documento~") COLUMN(NAME=~"riga_documento_b.peso_netto~") COLUMN(NAME=~"riga_documento_b.sigla_prezzo~") COLUMN(NAME=~"riga_documento_b.forza_chius_evasione~") COLUMN(NAME=~"riga_documento_b.ordinato_fo~")    JOIN (LEFT=~"riga_documento_a.id_riga_documento~"    OP =~"=~"RIGHT=~"produzione_2011.id_doc_produzione~" )    JOIN (LEFT=~"documento.id_documento~"    OP =~"=~"RIGHT=~"produzione_2011.id_bollettina~" )    JOIN (LEFT=~"riga_documento_b.id_documento~"    OP =~"=~"RIGHT=~"documento.id_documento~" )WHERE(    EXP1 =~"~~~"riga_documento_b~~~".~~~"id_articolo~~~"~"   OP =~"=~"    EXP2 =~":ll_id_art~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"riga_documento_a~~~".~~~"ordinato_fo~~~"~"   OP =~"=~"    EXP2 =~"'O'~" ) ) ARG(NAME = ~"ll_id_art~" TYPE = number) " arguments=(("ll_id_art", number)) )
