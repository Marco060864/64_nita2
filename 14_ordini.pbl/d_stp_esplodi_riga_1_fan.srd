         ~"orafo_titolo_a~".~"titolo~",   
         ~"orafo_titolo_b~".~"id_titolo~",   
         ~"orafo_titolo_b~".~"titolo~",   
         ~"articolo_b~".~"prod_interna~",   
         ~"articolo_a~".~"prod_interna~",   
         ~"articolo_b~".~"id_sog_commerciale~",   
         ~"articolo_b~".~"codice~",   
         ~"articolo_b~".~"descrizione~",   
         ~"articolo_a~".~"codice~",   
         ~"articolo_a~".~"descrizione~",   
         ~"articolo_b~".~"coef_calo~",   
         ~"articolo_b~".~"id_articolo~",   
         ~"articolo_b~".~"id_titolo~",   
         ~"riga_documento~".~"id_tab_iva~",   
         ~"documento~".~"data_prev_consegna~",   
         ~"sog_commerciale_gen~".~"codice~",   
         ~"riga_documento~".~"id_unita_confezione~",   
         ~"unita_confezione~".~"dim_l~",   
         ~"riga_distinta~".~"varie~",   
         cast(fn_ordini(~"riga_distinta~".~"id_distinta~",~"riga_documento~".~"qta_un_base~" - ~"riga_documento~".~"qta_evasa_un_base~",~"riga_distinta~".~"quantita~",~"riga_documento~".~"dim_l~",~"unita_confezione~".~"dim_l~",~"riga_distinta~".~"varie~") as numeric(18,4)) as quantita15,   
         cast(fn_dim_l(~"articolo_b~".~"id_articolo~") as numeric(18,4)) as misura15,   
         ~"riga_documento~".~"peso_netto~",
~"riga_distinta~".~"peso_netto~" ,
~"riga_documento~".~"qta_un_base~",   
~"riga_documento~".~"qta_evasa_un_base~",
cast((select infilatura from infilatura where id_articolo=~"riga_distinta~".~"id_articolo~")as numeric(5,2))as c_infilatura,
~"riga_distinta~".~"infilatura~",
~"documento~".~"note_intestazione~",
~"articolo_a~".~"des_breve~",
~"documento~".~"num_progressivo~",
~"articolo_a~".~"id_sog_commerciale~"
    FROM ~"distinta~",   
         ~"riga_distinta~",   
         ~"riga_documento~",   
         ~"articolo~" ~"articolo_a~",   
         ~"articolo~" ~"articolo_b~",   
         ~"documento~",   
         ~"sog_commerciale_gen~",   
         ~"orafo_titolo~" ~"orafo_titolo_a~",   
         ~"orafo_titolo~" ~"orafo_titolo_b~",   
         ~"unita_confezione~"  
   WHERE ( ~"riga_distinta~".~"id_distinta~" = ~"distinta~".~"id_distinta~" ) and  
         ( ~"distinta~".~"id_articolo~" = ~"riga_documento~".~"id_articolo~" ) and  
         ( ~"riga_distinta~".~"id_articolo~" = ~"articolo_b~".~"id_articolo~" ) and  
         ( ~"orafo_titolo_a~".~"id_titolo~" = ~"articolo_a~".~"id_titolo~" ) and  
         ( ~"articolo_b~".~"id_titolo~" = ~"orafo_titolo_b~".~"id_titolo~" ) and  
         ( ~"documento~".~"id_sog_commerciale~" = ~"sog_commerciale_gen~".~"id_sog_commerciale~" ) and  
         ( ~"riga_documento~".~"id_documento~" = ~"documento~".~"id_documento~" ) and  
         ( ~"riga_documento~".~"id_articolo~" = ~"articolo_a~".~"id_articolo~" ) and  
         ( ~"articolo_a~".~"id_articolo~" = ~"unita_confezione~".~"id_articolo~" ) and  
         ( ( ~"riga_documento~".~"id_riga_documento~" = :rn_id_riga ) ) AND  
         ~"articolo_a~".~"prod_interna~" = 'S'    
and ( ~"riga_documento~".~"id_unita_confezione~"= ~"unita_confezione~".~"id_unita_confezione~")" arguments=(("rn_id_riga", number))  sort="riga_documento_id_articolo A id_riga_sorgente A riga_distinta_id_riga_distinta A " )
