 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"riga_distinta~" )  TABLE(NAME=~"distinta~" )  TABLE(NAME=~"articolo~" ALIAS=~"articolo_a~" )  TABLE(NAME=~"articolo~" ALIAS=~"articolo_b~" ) COLUMN(NAME=~"distinta.id_distinta~") COLUMN(NAME=~"distinta.codice~") COLUMN(NAME=~"distinta.descrizione~") COLUMN(NAME=~"distinta.id_articolo~") COLUMN(NAME=~"riga_distinta.id_articolo~") COLUMN(NAME=~"riga_distinta.quantita~") COMPUTE(NAME=~"cast('N' as char(1)) as modificato~") COLUMN(NAME=~"articolo_a.codice~") COLUMN(NAME=~"articolo_a.descrizione~") COLUMN(NAME=~"riga_distinta.id_riga_distinta~") COLUMN(NAME=~"distinta.id_azienda~") COLUMN(NAME=~"distinta.id_valuta~") COLUMN(NAME=~"distinta.note~") COLUMN(NAME=~"articolo_b.codice~")    JOIN (LEFT=~"articolo_a.id_articolo~"    OP =~"=~"RIGHT=~"riga_distinta.id_articolo~"    OUTER2 =~"riga_distinta.id_articolo~" )    JOIN (LEFT=~"riga_distinta.id_distinta~"    OP =~"=~"RIGHT=~"distinta.id_distinta~"    OUTER2 =~"distinta.id_distinta~" )    JOIN (LEFT=~"distinta.id_articolo~"    OP =~"=~"RIGHT=~"articolo_b.id_articolo~" )WHERE(    EXP1 =~"~~~"articolo_b~~~".~~~"id_articolo~~~"~"   OP =~"=~"    EXP2 =~":rn_id_art_originale~" ) ) ARG(NAME = ~"rn_id_art_originale~" TYPE = number) " arguments=(("rn_id_art_originale", number)) )
