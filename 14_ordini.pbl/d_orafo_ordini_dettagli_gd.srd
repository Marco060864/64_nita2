 retrieve="  SELECT ~"articolo~".~"codice~",   
         ~"articolo~".~"descrizione~",   
         ~"articolo~".~"immagine~",   
         ~"articolo~".~"coef_calo~",   
         ~"articolo~".~"note~",   
         ~"riga_documento~".~"id_riga_documento~",   
         ~"articolo~".~"id_articolo~",   
         ~"riga_documento~".~"id_documento~",   
         ~"riga_documento~".~"id_unita_confezione~",   
         ~"riga_documento~".~"id_gruppo_agenti~",   
         ~"riga_documento~".~"num_riga~",   
         ~"riga_documento~".~"id_articolo~",   
         ~"riga_documento~".~"descrizione~",   
         ~"riga_documento~".~"id_des_articolo~",   
         ~"riga_documento~".~"quantita~",   
         ~"riga_documento~".~"qta_sconto_merce~",   
         ~"riga_documento~".~"qta_evasa~",   
         ~"riga_documento~".~"fat_con_unita_base~",   
         ~"riga_documento~".~"fat_con_globale~",   
         ~"riga_documento~".~"qta_un_base~",   
         ~"riga_documento~".~"qta_evasa_un_base~",   
         ~"riga_documento~".~"id_caus_magazzino~",   
         ~"riga_documento~".~"id_locazione_1~",   
         ~"riga_documento~".~"id_locazione_2~",   
         ~"riga_documento~".~"id_valuta~",   
         ~"riga_documento~".~"cambio~",   
         ~"riga_documento~".~"id_listino~",   
         ~"riga_documento~".~"id_con_lis_articolo~",   
         ~"riga_documento~".~"prezzo~",   
         ~"riga_documento~".~"sconto~",   
         ~"riga_documento~".~"prezzo_netto~",   
         ~"riga_documento~".~"sconto_riga~",   
         ~"riga_documento~".~"data_prevista_consegna~",   
         ~"riga_documento~".~"peso_netto~",   
         ~"riga_documento~".~"peso_lordo~",   
         ~"riga_documento~".~"dim_l~",   
         ~"riga_documento~".~"dim_h~",   
         ~"riga_documento~".~"dim_p~",   
         ~"riga_documento~".~"num_colli~",   
         ~"riga_documento~".~"id_tab_iva~",   
         ~"riga_documento~".~"val_attribuito~",   
         ~"riga_documento~".~"provv_agente~",   
         ~"riga_documento~".~"provv_subage~",   
         ~"riga_documento~".~"provv_carea~",   
         ~"riga_documento~".~"id_caus_trasporto~",   
         ~"riga_documento~".~"forza_chius_evasione~",   
         ~"riga_documento~".~"sospesa~",   
         ~"riga_documento~".~"da_stampare~",   
         ~"riga_documento~".~"data_inizio_competenza~",   
         ~"riga_documento~".~"data_fine_competenza~",   
         ~"riga_documento~".~"tot_riga_val_riga~",   
         ~"riga_documento~".~"tot_riga_val_doc~",   
         ~"riga_documento~".~"tot_riga_val_az~",   
         ~"riga_documento~".~"id_riga_doc_provenienza~",   
         ~"riga_documento~".~"id_conto~",   
         ~"riga_documento~".~"id_azienda~",   
         ~"riga_documento~".~"coef_calo~",   
         ~"riga_documento~".~"calo~",   
         ~"riga_documento~".~"fino~",   
         ~"riga_documento~".~"prezzo_metallo~",   
         ~"riga_documento~".~"prezzo_manifattura~",   
         ~"riga_documento~".~"id_riga_partita~",   
         ~"riga_documento~".~"sigla_prezzo~",   
         ~"riga_documento~".~"valoriz_peso_non_prezioso~",  
         ~"riga_documento~".~"id_riga_sorgente~",  
         ~"articolo~".~"id_titolo~",   
         ~"articolo~".~"prod_interna~",   
         ~"des_articolo~".~"codice~",   
         ~"des_articolo~".~"descrizione~",   
         ~"des_articolo~".~"des_estesa~",   
         ~"articolo~".~"id_sog_commerciale~",   
         ~"sog_commerciale_gen~".~"rag_soc_1~",   
         ~"riga_documento~".~"ordinato_fo~",
		~"riga_documento~".~"prezzo_complessivo~",
		~"riga_documento~".~"importo_manifattura~",
~"riga_documento~".~"importo_manifattura_val~" 
		
    FROM {oj ~"riga_documento~"  LEFT OUTER JOIN ~"des_articolo~"  ON ~"riga_documento~".~"id_des_articolo~" = ~"des_articolo~".~"id_des_articolo~"}, {oj ~"articolo~"  LEFT OUTER JOIN ~"sog_commerciale_gen~"  ON ~"articolo~".~"id_sog_commerciale~" = ~"sog_commerciale_gen~".~"id_sog_commerciale~"}  
   WHERE ( ~"articolo~".~"id_articolo~" = ~"riga_documento~".~"id_articolo~" ) and  
         ( (~"riga_documento~".~"qta_un_base~" > ~"riga_documento~".~"qta_evasa_un_base~" ) or
         (~"riga_documento~".~"peso_netto~" > 
ifnull(~"riga_documento~".~"peso_netto_evaso~", 0,~"riga_documento~".~"peso_netto_evaso~") ) AND  
         ~"riga_documento~".~"forza_chius_evasione~" <> 'S' )" update="riga_documento" updatewhere=1 updatekeyinplace=yes  sort="articolo_codice A " )
