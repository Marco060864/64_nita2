 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"unita_confezione~" )  TABLE(NAME=~"unita_misura~" ALIAS=~"unita_misura_a~" )  TABLE(NAME=~"unita_misura~" ALIAS=~"unita_misura_b~" )  TABLE(NAME=~"unita_misura~" ALIAS=~"unita_misura_c~" ) COLUMN(NAME=~"unita_confezione.id_unita_misura~") COLUMN(NAME=~"unita_confezione.id_unita_mis_peso~") COLUMN(NAME=~"unita_confezione.peso_netto~") COLUMN(NAME=~"unita_confezione.id_unita_mis_volume~") COLUMN(NAME=~"unita_confezione.dim_l~") COLUMN(NAME=~"unita_misura_a.simbolo~") COLUMN(NAME=~"unita_misura_a.tipo~") COLUMN(NAME=~"unita_misura_b.simbolo~") COLUMN(NAME=~"unita_misura_b.tipo~") COLUMN(NAME=~"unita_misura_c.simbolo~") COLUMN(NAME=~"unita_misura_c.tipo~") COLUMN(NAME=~"unita_misura_a.id_unita_misura_riferimento~") COLUMN(NAME=~"unita_misura_a.conversione~") COLUMN(NAME=~"unita_misura_b.id_unita_misura_riferimento~") COLUMN(NAME=~"unita_misura_b.conversione~") COLUMN(NAME=~"unita_misura_c.id_unita_misura_riferimento~") COLUMN(NAME=~"unita_misura_c.conversione~")    JOIN (LEFT=~"unita_confezione.id_unita_misura~"    OP =~"=~"RIGHT=~"unita_misura_a.id_unita_misura~"    OUTER1 =~"unita_confezione.id_unita_misura~" )    JOIN (LEFT=~"unita_confezione.id_unita_mis_peso~"    OP =~"=~"RIGHT=~"unita_misura_b.id_unita_misura~"    OUTER1 =~"unita_confezione.id_unita_mis_peso~" )    JOIN (LEFT=~"unita_confezione.id_unita_mis_volume~"    OP =~"=~"RIGHT=~"unita_misura_c.id_unita_misura~"    OUTER1 =~"unita_confezione.id_unita_mis_volume~" )WHERE(    EXP1 =~"~~~"unita_confezione~~~".~~~"unita_base~~~"~"   OP =~"=~"    EXP2 =~"'S'~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"unita_confezione~~~".~~~"id_articolo~~~"~"   OP =~"=~"    EXP2 =~":rn_id_articolo~" ) ) ARG(NAME = ~"rn_id_articolo~" TYPE = number) " arguments=(("rn_id_articolo", number)) )
