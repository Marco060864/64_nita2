 column=(type=long updatewhereclause=yes identity=yes name=id_sog_commerciale dbname="sog_commerciale.id_sog_commerciale" )
 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"prezzo~" )  TABLE(NAME=~"variazione~" )  TABLE(NAME=~"unita_confezione~" )  TABLE(NAME=~"sog_commerciale~" )  TABLE(NAME=~"listino~" )  TABLE(NAME=~"articolo~" )  TABLE(NAME=~"anagrafica~" ) COLUMN(NAME=~"unita_confezione.unita_base~") COLUMN(NAME=~"prezzo.id_variazione~") COLUMN(NAME=~"variazione.id_listino~") COLUMN(NAME=~"sog_commerciale.codice~") COLUMN(NAME=~"unita_confezione.id_articolo~") COLUMN(NAME=~"prezzo.prezzo~") COLUMN(NAME=~"prezzo.coef_calo~") COLUMN(NAME=~"variazione.data_inizio~") COLUMN(NAME=~"variazione.data_fine~") COLUMN(NAME=~"listino.codice~") COLUMN(NAME=~"articolo.codice~") COLUMN(NAME=~"articolo.descrizione~") COLUMN(NAME=~"anagrafica.rag_soc_1~") COLUMN(NAME=~"sog_commerciale.id_sog_commerciale~")    JOIN (LEFT=~"unita_confezione.id_unita_confezione~"    OP =~"=~"RIGHT=~"prezzo.id_unita_confezione~" )    JOIN (LEFT=~"prezzo.id_variazione~"    OP =~"=~"RIGHT=~"variazione.id_variazione~" )    JOIN (LEFT=~"listino.id_listino~"    OP =~"=~"RIGHT=~"variazione.id_listino~" )    JOIN (LEFT=~"articolo.id_articolo~"    OP =~"=~"RIGHT=~"unita_confezione.id_articolo~" )    JOIN (LEFT=~"variazione.id_listino~"    OP =~"=~"RIGHT=~"sog_commerciale.id_listino~" )    JOIN (LEFT=~"anagrafica.id_anagrafica~"    OP =~"=~"RIGHT=~"sog_commerciale.id_anagrafica~" )WHERE(    EXP1 =~"~~~"unita_confezione~~~".~~~"unita_base~~~"~"   OP =~"=~"    EXP2 =~"'S'~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"substr(~~~"sog_commerciale~~~".~~~"codice~~~" , 1, 2)~"   OP =~"=~" NEST = PBSELECT( VERSION(400) TABLE(NAME=~"par_sistema~" ) COLUMN(NAME=~"par_sistema.pref_cod_fornitore~"))) ) ORDER(NAME=~"prezzo.prezzo~" ASC=yes )  ORDER(NAME=~"prezzo.coef_calo~" ASC=yes ) "  sort="unita_confezione_id_articolo A " )
