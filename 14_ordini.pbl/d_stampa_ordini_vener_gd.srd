         ~"unita_misura_b~".~"conversione~",   
          ~"unita_confezione~".~"conv_misura_peso~",



  
         ~"unita_misura_c~".~"simbolo~",   
         ~"unita_misura_c~".~"tipo~",   
         ~"riga_documento~".~"sigla_prezzo~",   
         ~"riga_documento~".~"valoriz_peso_non_prezioso~",   
         ~"des_articolo~".~"codice~",   
         ~"des_articolo~".~"descrizione~",   
         ~"des_articolo~".~"des_estesa~",   
         ~"sog_commerciale_gen~".~"rag_soc_1~",   
         ~"articolo~".~"id_sog_commerciale~",   
         ~"riga_documento~".~"qta_ordinata_fo~",   
         cast(0 as decimal)as importo,   
         ~"riga_documento~".~"ordinato_fo~",   
         ~"riga_documento~".~"id_riga_doc_padre~",   
         ~"riga_documento~".~"id_riga_sorgente~",   
         
~"riga_documento~".~"prezzo_complessivo~",
   
         ~"riga_documento~".~"provv_imp_agente~",   
         ~"riga_documento~".~"provv_imp_subage~",   
         ~"riga_documento~".~"provv_imp_carea~",
         ~"riga_documento~".~"importo_manifattura~",
         ~"articolo~".~"prod_interna~",   
         ~"caus_magazzino~".~"proponi_prezzo_metallo~",   
         ~"caus_magazzino~".~"proponi_prezzo_manifattura~",
	      ~"riga_documento~".~"peso_non_prezioso~" ,
	      ~"riga_documento~".~"peso_netto_evaso~" ,
	      ~"riga_documento~".~"importo_manifattura_val~" ,
		   ~"riga_documento~".~"id_gruppo_agenti_2~",   
         ~"riga_documento~".~"provv_agente_2~",   
         ~"riga_documento~".~"provv_subage_2~",   
         ~"riga_documento~".~"provv_carea_2~",   
         ~"riga_documento~".~"provv_imp_agente_2~",   
         ~"riga_documento~".~"provv_imp_subage_2~",   
         ~"riga_documento~".~"provv_imp_carea_2~",
			CAST(SUBSTR(c_cmc_data, 1, 20) as numeric(20,6)) as cmc,   
         CAST(SUBSTR(c_ult_costo_data, 1, 20) as numeric(20,6)) as costo_ultimo,   
         CAST(FN_COSTO_MEDIO(1, ~"riga_documento~".~"id_articolo~", (SELECT id_magazzino FROM locazione WHERE id_locazione = ~"riga_documento~".~"id_locazione_1~"), YEAR(TODAY(*)), MONTH(TODAY(*)), ~"riga_documento~".~"id_valuta~")  AS DECIMAL(20,6) ) AS costo_medio,   
         CAST(SUBSTR( c_esidisp, 21, 20) as numeric(20,6)) As c_esistenza,   
         CAST(SUBSTR(c_esidisp,  41, 20) as numeric(20,6)) As c_disponibilita,   
         CAST(SUBSTR(c_esidisp, 1, 20) as numeric(20,6)) as esistenza_fisica,   
         CAST(FN_ESI_DISP(1, ~"riga_documento~".~"id_articolo~", (SELECT id_magazzino FROM locazione WHERE id_locazione = ~"riga_documento~".~"id_locazione_1~"), YEAR(TODAY(*)), MONTH(TODAY(*)) , ~"riga_documento~".~"id_valuta~")  AS CHAR(60) ) AS c_esidisp,   
         CAST(FN_ULTIMO_COSTO_DATA(1, ~"riga_documento~".~"id_articolo~", (SELECT id_magazzino FROM locazione WHERE id_locazione = ~"riga_documento~".~"id_locazione_1~"), YEAR(TODAY(*)), MONTH(TODAY(*)) , ~"riga_documento~".~"id_valuta~")  AS CHAR(30) ) AS c_ult_costo_data,   
         CAST(FN_CMC_DATA(1, ~"riga_documento~".~"id_articolo~", (SELECT id_magazzino FROM locazione WHERE id_locazione = ~"riga_documento~".~"id_locazione_1~"), ~"riga_documento~".~"id_valuta~")  AS CHAR(30) ) AS c_cmc_data,   
         CAST(SUBSTR(c_ult_costo_data, 21, 10) as CHAR(10)) as data_costo_ultimo,   
         CAST(SUBSTR(c_cmc_data, 21, 10) as CHAR(10)) as data_cmc,
		riga_b.forza_chius_evasione		
    FROM {oj 
			 {oj
			  {oj ~"unita_confezione~"  LEFT OUTER JOIN ~"unita_misura~" unita_misura_a  ON ~"unita_confezione~".~"id_unita_mis_peso~" = ~"unita_misura_a~".~"id_unita_misura~"},
		     {oj ~"riga_documento~"  LEFT OUTER JOIN ~"caus_magazzino~"  ON ~"riga_documento~".~"id_caus_magazzino~" = ~"caus_magazzino~".~"id_caus_magazzino~"} 
			 LEFT OUTER JOIN ~"orafo_tipo_partita~"  ON ~"caus_magazzino~".~"id_tipo_partita~" = ~"orafo_tipo_partita~".~"id_tipo_partita~"}, 
		    {oj ~"unita_confezione~"  LEFT OUTER JOIN ~"unita_misura~" unita_misura_b  ON ~"unita_confezione~".~"id_unita_mis_volume~" = ~"unita_misura_b~".~"id_unita_misura~"}, 
			 {oj ~"riga_documento~"  LEFT OUTER JOIN ~"unita_confezione~"  ON ~"riga_documento~".~"id_unita_confezione~" = ~"unita_confezione~".~"id_unita_confezione~"} 
			LEFT OUTER JOIN ~"unita_misura~" unita_misura_c  ON ~"unita_confezione~".~"id_unita_misura~" = ~"unita_misura_c~".~"id_unita_misura~"}, 
			{oj ~"riga_documento~"  LEFT OUTER JOIN ~"des_articolo~"  ON ~"riga_documento~".~"id_des_articolo~" = ~"des_articolo~".~"id_des_articolo~"}, 
			{oj ~"articolo~"  LEFT OUTER JOIN ~"sog_commerciale_gen~"  ON ~"articolo~".~"id_sog_commerciale~" = ~"sog_commerciale_gen~".~"id_sog_commerciale~"},
			{oj ~"riga_documento~" LEFT OUTER JOIN ~"articolo~" ON ~"riga_documento~".~"id_articolo~"=~"articolo~".~"id_articolo~"},
			{oj ~"riga_documento~"  LEFT OUTER JOIN ~"riga_documento~" as riga_b  ON ~"riga_documento~".~"id_riga_doc_provenienza~" = riga_b.id_riga_documento}   
 WHERE ( ~"riga_documento~".~"id_azienda~" in (0,1) ) AND  
         (~"riga_documento~".~"id_documento~" = :ra_id_documento)    
//( ~"articolo~".~"id_articolo~" = ~"riga_documento~".~"id_articolo~" ) and  " arguments=(("ra_id_documento", number))  sort="c_articolo_cod A sigla_prezzo A " )
