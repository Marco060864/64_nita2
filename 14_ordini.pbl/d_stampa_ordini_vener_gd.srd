 retrieve="  SELECT    Cast(~"articolo~".~"codice~" as char(32)) As c_articolo_cod,
         Cast(~"articolo~".~"descrizione~" as char(80)) As c_articolo_des,   
         Cast(~"unita_confezione~".~"tipo_conversione~" as char(1)) As c_unita_conf_tipo_conversione,   
         Cast(~"unita_confezione~".~"molteplicita~" as decimal) As c_unita_conf_molteplicita,   
         Cast(0 as integer) As c_arrot,
         ~"riga_documento~".~"id_riga_documento~",   
         ~"riga_documento~".~"id_documento~",   
         ~"riga_documento~".~"num_riga~",   
         ~"riga_documento~".~"id_articolo~",   
