 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"documento~" )  TABLE(NAME=~"registro~" )  TABLE(NAME=~"sog_commerciale_gen~" ) COLUMN(NAME=~"documento.id_documento~") COLUMN(NAME=~"documento.num_progressivo~") COLUMN(NAME=~"documento.data_registrazione~") COLUMN(NAME=~"documento.ora_registrazione~") COLUMN(NAME=~"documento.evaso_totalmente~") COLUMN(NAME=~"documento.chius_forzata~") COLUMN(NAME=~"documento.data_prev_consegna~") COLUMN(NAME=~"documento.data_scadenza~") COLUMN(NAME=~"documento.id_sog_commerciale~") COLUMN(NAME=~"documento.bollo~") COLUMN(NAME=~"documento.num_documento~") COLUMN(NAME=~"documento.data_documento~") COLUMN(NAME=~"sog_commerciale_gen.rag_soc_1~") COLUMN(NAME=~"sog_commerciale_gen.codice~") COLUMN(NAME=~"documento.ordinato_fo~") COLUMN(NAME=~"documento.stampato~")    JOIN (LEFT=~"registro.id_registro~"    OP =~"=~"RIGHT=~"documento.id_registro~" )    JOIN (LEFT=~"documento.id_sog_commerciale~"    OP =~"=~"RIGHT=~"sog_commerciale_gen.id_sog_commerciale~" )WHERE(    EXP1 =~"(~~~"registro~~~".~~~"tipo_registro~~~"~"   OP =~"=~"    EXP2 =~"'ov' ) ~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"documento~~~".~~~"evaso_totalmente~~~"~"   OP =~"<>~"    EXP2 =~"'S'~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"documento~~~".~~~"chius_forzata~~~"~"   OP =~"<>~"    EXP2 =~"'S'~" ) ) " update="documento" updatewhere=1 updatekeyinplace=yes  sort="data_registrazione_vera D num_progressivo A data_registrazione A " )
