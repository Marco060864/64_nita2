end type

event ue_post_itemchanged;this.setItem(al_riga, as_colonna, as_valore)
end event

event clicked;if row>0 then
	wf_multisel(row,this,"",this,"","")
end if

end event

event itemchanged;long ll_id_r_doc, ll_id_doc, i, ll_id_r_doc_elimina

CHOOSE CASE dwo.name
	CASE "riga_documento_forza_chius_evasione"
		if data='S' then
			post event ue_post_itemchanged(row,dwo.name,'S')
			if messagebox("Conferma evasione","Vuoi evadere completamente la riga?",Question!,YesNo!)=1 then
				ll_id_r_doc_elimina=this.GetItemNumber(row,"riga_documento_id_riga_documento")
				ll_id_doc=this.GetItemNumber(row,"riga_documento_id_documento")
				update riga_documento
				set forza_chius_evasione='S'
				where id_riga_documento= :ll_id_r_doc_elimina;
				if sqlca.sqlnrows<1 then 
					messagebox('Errore','Impossibile accedere al DataBase!')
					return
				end if
				for i = 1 to tab_1.tabpage_2.dw_righe_scelte.RowCount()
					ll_id_r_doc=tab_1.tabpage_2.dw_righe_scelte.GetItemNumber(i,"riga_documento_id_riga_documento")
					if ll_id_r_doc=ll_id_r_doc_elimina then
						tab_1.tabpage_2.dw_righe_scelte.Deleterow(i)
					end if
				next
			else
				post event ue_post_itemchanged(row,dwo.name,'N')
			end if
		end if
END CHOOSE

end event

