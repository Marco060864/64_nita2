		ll_qta1=tab_1.tabpage_2.dw_righe_esplose.getitemdecimal(i,"tq")
		dw_4.setitem(a,"quantita",ll_qta1)
						
			
			
			ls_appoggio=tab_1.tabpage_2.dw_righe_esplose.getitemstring(i,"cod_var")
			
			
			select id_articolo
			into :ll_id_art_variato
			from articolo
			where codice=:ls_appoggio;
			
			
			select id_sog_commerciale
			into :ll_appoggio
			from articolo
			where codice=:ls_appoggio;
			
			select rag_soc_1 
			into :ls_rag_soc
			from sog_commerciale_gen
			where id_sog_commerciale=:ll_appoggio;
			dw_4.setitem(a,"id_sog_commerciale",ll_appoggio)
			dw_4.setitem(a,"rag_soc_1",ls_rag_soc)
						
			dw_4.setitem(a,"c_articolo_cod",ls_appoggio)
			
			
			
			ld_appoggio=tab_1.tabpage_2.dw_righe_esplose.getitemdecimal(i,"b_coef_calo")
			dw_4.setitem(a,"coef_calo",ld_appoggio)
			ll_appoggio=tab_1.tabpage_2.dw_righe_esplose.getitemnumber(i,"b_id_titolo")
			dw_4.setitem(a,"id_titolo",ll_appoggio)
			
			
			
			if ll_id_art_variato=0 or isnull(ll_id_art_variato) then
