event itemchanged;long ll_id_doc, i, ll_id_doc_elimina

CHOOSE CASE dwo.name
	CASE "documento_chius_forzata"
		if data='S' then
			
			if messagebox("Conferma evasione","Vuoi evadere completamente il documento?",Question!,YesNo!)=1 then
				ll_id_doc_elimina=this.GetItemNumber(row,"id_documento")
				update documento
				set chius_forzata='S'
				where id_documento= :ll_id_doc_elimina;
				if sqlca.sqlnrows<1 then 
					messagebox('Errore','Impossibile accedere al DataBase!')
					return
				end if
				this.Deleterow(row)
				
				
			else
				
			end if
		end if
END CHOOSE

end event

