event clicked;long ll_riga, i, ll_id_riga_doc, ll_id_bollettina
string ls_gia_ordinato, ls_numdoc
long ll_num_prog
date ldt_data_doc

ll_riga=tab_1.tabpage_2.dw_righe_scelte.Rowcount()
						
for i=1 to ll_riga
	ls_gia_ordinato=tab_1.tabpage_3.dw_righe_gruppo.getitemstring(i, "ordinato_fo")
	//se è chiusa (="S") o già ordinata (="O") salto
	if ls_gia_ordinato='S' or ls_gia_ordinato='O' then continue	
	
	ll_id_riga_doc=tab_1.tabpage_2.dw_righe_scelte.getItemNumber(i,"riga_documento_id_riga_documento")
		
	update riga_documento
	set ordinato_fo='O'
	where id_riga_documento= :ll_id_riga_doc;
	if sqlca.sqlnrows<1 then 
		messagebox('Errore','Impossibile accedere al DataBase!')
		rollback;
		return
	else
		commit;
		//DEVO SEGNARE ANCHE LA BOLLETTINA GENERATA DALLA RIGA ORDINE (1 RIGA ORDINE= 1 BOLLETTINA)
		select id_documento
		into :ll_id_bollettina
		from dba.riga_documento
		where provv_imp_subage_2=:ll_id_riga_doc
		;
		if ll_id_bollettina>0 then								
			UPDATE riga_documento
			set ORDINATO_FO='O'
			where id_documento=:ll_id_bollettina
			;
			if sqlca.sqlnrows<1 then 
				select num_documento, num_progressivo, data_documento
				into :ls_numdoc, :ll_num_prog, :ldt_data_doc
				from dba.documento
				where id_documento=:ll_id_bollettina
				;
				
				messagebox('Errore','Bollettina Prog. '+string(ll_num_prog)+' Num. '+ ls_numdoc+"del "+string(ldt_data_doc)+'non segnata ordinata!')
				rollback;
				return
			else
				commit;
				tab_1.tabpage_3.dw_righe_gruppo.setitem(i, "ordinato_fo", 'O')
			end if
			
		
		else
			select num_documento, num_progressivo, data_documento
			into :ls_numdoc, :ll_num_prog, :ldt_data_doc
			from dba.documento
			where id_documento=:ll_id_bollettina
			;
			
			messagebox('Errore','Bollettina Riga: '+string(ll_id_riga_doc)+'non collegata in "provv_imp_subage_2"!')
			return
		end if
	end if
next
messagebox("Attenzione!", "Le bollettine legate alle righe ordine scelte sono state segnate come GIA' ORDINATE "+&
			"e verranno pertanto evidenziate nel calcolo della disponibilità!")
end event

type cb_5 from commandbutton within tabpage_3
integer x = 3337
integer y = 684
integer width = 512
integer height = 92
integer taborder = 100
integer textsize = -8
integer weight = 700
fontcharset fontcharset = ansi!
fontpitch fontpitch = variable!
fontfamily fontfamily = swiss!
string facename = "Arial"
string text = "Chiudi Ordini"
end type

event clicked;long ll_riga, i, ll_id_riga_doc, ll_id_bollettina
string ls_gia_ordinato

ll_riga=tab_1.tabpage_2.dw_righe_scelte.Rowcount()
						
for i=1 to ll_riga
	ls_gia_ordinato=tab_1.tabpage_3.dw_righe_gruppo.getitemstring(i, "ordinato_fo")
	if ls_gia_ordinato='S' then continue	
	
	ll_id_riga_doc=tab_1.tabpage_2.dw_righe_scelte.getItemNumber(i,"riga_documento_id_riga_documento")
		
	update riga_documento
	set ordinato_fo='S'
	where id_riga_documento= :ll_id_riga_doc;
	if sqlca.sqlnrows<1 then 
		messagebox('Errore','Impossibile accedere al DataBase!')
		rollback;
		return
	else
		commit;
		//DEVO SEGNARE ANCHE LA BOLLETTINA GENERATA DALLA RIGA ORDINE (1 RIGA ORDINE= 1 BOLLETTINA)
		select id_documento
		into :ll_id_bollettina
		from dba.riga_documento
		where provv_imp_subage_2=:ll_id_riga_doc
		;
												
		UPDATE riga_documento
		set ORDINATO_FO='S'
		where id_documento=:ll_id_bollettina
		;
		if sqlca.sqlnrows<1 then 
			messagebox('Errore','Bollettina non chiusa!')
			rollback;
			return
		else
			commit;
			tab_1.tabpage_3.dw_righe_gruppo.setitem(i, "ordinato_fo", 'S')
		end if
		
	end if
next
messagebox("Attenzione!", "Le bollettine legate alle righe ordine scelte sono state chiuse e NON incideranno più nel calcolo della disponibilità!")
end event

type cb_mod_qta from commandbutton within tabpage_3
string tag = "Modifica qta in base al magazzino"
integer x = 3319
integer y = 1356
integer width = 562
integer height = 80
integer taborder = 70
integer textsize = -8
integer weight = 700
fontcharset fontcharset = ansi!
fontpitch fontpitch = variable!
fontfamily fontfamily = swiss!
string facename = "Arial"
string text = "Modifica Qta"
end type

event clicked;integer i
decimal ldc_qta_attuale, ldc_da_ordinare

if cbx_giacenza.checked then
	for i= 1 to dw_righe_gruppo.rowcount()
		dw_righe_gruppo.scrolltorow(i)
		w_giacenza_pz.w_leggi_saldo(-1)
		if w_giacenza_pz.dw_1.rowcount()>0 then
			idc_ord_art_maga[i]=w_giacenza_pz.dw_1.getitemdecimal(1, "c_saldo")
		else
			idc_ord_art_maga[i]=0
			//messagebox("Attenzione!", "Nessun ...Movimento
		end if
		if idc_ord_art_maga[i]>0 then
			
			ldc_qta_attuale=dw_righe_gruppo.getitemdecimal(i, "quantita")
			if idc_ord_art_maga[i]> ldc_qta_attuale then
				ldc_da_ordinare=0
				 idc_ord_art_maga[i]=ldc_qta_attuale
			else
				ldc_da_ordinare=ldc_qta_attuale - idc_ord_art_maga[i]
				
				
			end if
			dw_righe_gruppo.setitem(i, "quantita", ldc_da_ordinare )
		end if	
	
	
	next
end if

cb_prepara_ordine.triggerevent(clicked!)

for i= 1 to dw_righe_gruppo.rowcount()
	if idc_ord_art_maga[i]>0 then
		dw_righe_gruppo.setitem(i, "quantita", idc_ord_art_maga[i] )
	else
		dw_righe_gruppo.setitem(i, "quantita", 0 )
	end if
next
cb_produzione.postevent(clicked!)
end event

