on tabpage_4.create
this.cb_preview=create cb_preview
this.dw_5=create dw_5
this.Control[]={this.cb_preview,&
this.dw_5}
end on

on tabpage_4.destroy
destroy(this.cb_preview)
destroy(this.dw_5)
end on

type cb_preview from commandbutton within tabpage_4
integer x = 201
integer y = 36
integer width = 247
integer height = 108
integer taborder = 70
integer textsize = -8
integer weight = 400
fontcharset fontcharset = ansi!
fontpitch fontpitch = variable!
fontfamily fontfamily = swiss!
string facename = "Arial"
string text = "Preview"
end type

event clicked;if cb_preview.text='Preview' then
	cb_preview.text='Ritorna'
	dw_5.object.datawindow.print.preview='yes'
	dw_5.object.datawindow.print.preview.rulers='yes'
else
	cb_preview.text='Preview'
	dw_5.object.datawindow.print.preview='no'
	dw_5.object.datawindow.print.preview.rulers='no'
end if
end event

type dw_5 from datawindow within tabpage_4
integer x = 64
integer y = 156
integer width = 3273
integer height = 1580
integer taborder = 60
boolean titlebar = true
boolean hscrollbar = true
boolean vscrollbar = true
boolean livescroll = true
borderstyle borderstyle = stylelowered!
end type

