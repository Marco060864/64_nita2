event clicked;long ll_righe, i,j, ll_id_art, ll_id_sorgente, riga, ll_id_doc, ll_id_riga, ll_art_sost, ll_id_doc2, k
INTEGER LI_RET, li_r1, li_r2, li_r3, li_ret_old 
decimal{4} tot_fisso, ld_qta, ld_peso_componente
decimal{4} ld_dim,ld_dim_2, ld_doc_qta,ld_dim_sost, ld_qta_documento,ld_qta_componente,ld_dim_documento,ld_dim_confezione
string DWfilter2, ls_note, ls_varie, ls_bollo, ls_ret
integer li_arrotonda
long ll_test



li_ret=wf_controlla_singolo_ordine()
if li_ret=0 then return
//salvo la riga forza_chius_evasione e qta_un_base: PERCHé???? 031013 PROVO 
//if dw_righe_scelte.update()=1 then
//	commit;
//else
//	rollback;
//end if
if tab_1.tabpage_2.cbx_raggruppa.checked=true then
   dw_righe_esplose.dataobject='d_esplodi_riga'
	
else			
	if cbx_ogni_riga.checked=true then
		 dw_righe_esplose.dataobject='d_esplodi_ogni_riga_fan'
	
	else
		dw_righe_esplose.dataobject='d_esplodi_riga_fan'
		
	end if
end if
dw_righe_esplose.settransobject(sqlca)



dw_3.settransobject(sqlca)
tab_1.tabpage_2.dw_righe_esplose.Reset()
dw_1.Reset()
dw_2.Reset()
dw_3.Reset()
ll_test=tab_1.tabpage_2.dw_righe_scelte.rowcount()
DWfilter2 = "prod_interna='S' and not(isnull(confronto))"
tab_1.tabpage_2.dw_righe_scelte.SetFilter(DWfilter2)
tab_1.tabpage_2.dw_righe_scelte.Filter()
ll_righe=tab_1.tabpage_2.dw_righe_scelte.RowCount()
if ll_righe < ll_test then
	//21-01-13 inserito controllo sull'esistenza della distinta dell'articolo da lavorare 
	messagebox("Attenzione!", "Numero: "+string(ll_test -ll_righe)+&
	". Sono state scartate perché, probabilmente non avevano distinta o non erano di produzione interna!")
end if

//SE CI SONO RIGHE DOPO IL FILTRO GIRO
for i = 1 to ll_righe
		dw_1.Reset()
		dw_2.Reset()
		ld_qta=0
		
		ll_id_art=dw_righe_scelte.getitemnumber(i, "id_articolo")
		wf_controlla_distinta(ll_id_art)
		//21-01-13 fine
		ll_id_sorgente=dw_righe_scelte.getitemnumber(i,"id_riga_sorgente")
		ll_id_riga=dw_righe_scelte.getitemnumber(i, "riga_documento_id_riga_documento") 
		//aggiunto 130612 gestione bollo riga (sigla prezzo)
		ls_bollo=dw_righe_scelte.getitemstring(i, "riga_documento_sigla_prezzo")
		//fine 130612
		if isnull(ll_id_sorgente) then 
			li_ret=dw_2.retrieve(ll_id_riga)
			li_r2=dw_2.rowcount()
			li_r3=dw_righe_esplose.rowcount()
			if isnull(li_r3) then li_r3=1
			li_ret=dw_2.RowsCopy(1, li_r2, Primary!, dw_righe_esplose, li_r3 +1, Primary!)
			if li_ret<>1 then 
				messagebox("Errore", "Righe non copiate: dw2. ~r~n"+&
				"Un articolo potrebbe avere una distinta senza righe!"+&
				string(dw_righe_esplose.dataobject)+ " - dw2="+string(dw_2.dataobject))
			end if
		else	
			ld_dim=dw_righe_scelte.getitemdecimal(i, "riga_documento_dim_l") 
				
			LI_RET=dw_1.retrieve(ll_id_art, ll_id_sorgente)
			DWfilter2 = "id_riga_doc=" +string(ll_id_sorgente)
			dw_1.SetFilter(DWfilter2)
			dw_1.Filter( )
				
			
			LI_RET=dw_2.retrieve(ll_id_riga)
		
			li_r1=dw_1.rowcount()
			for j= 1 to li_r1 
					ll_id_riga=dw_1.getitemnumber(j, "id_riga_distinta")
					li_ret=dw_2.Find ( "riga_distinta_id_riga_distinta=" +string(ll_id_riga), 1, dw_2.rowcount() )
				
				if li_ret >0 then
				  	ls_note=dw_1.getitemstring(j,"note")
				  	ll_art_sost=dw_1.getitemnumber(j,"id_art_sostitutivo")
				  
				 	 ld_dim_sost=dw_1.getitemdecimal(j,"dim_l")
				  
				  	ld_qta=dw_1.getitemdecimal(j,"quantita")
				  	ld_peso_componente=dw_1.getitemdecimal(j,"peso_netto_componente")
				  
				  
				  	dw_2.Object.misura15[li_ret]=ld_dim_sost		
				  
				  
				  
				  	dw_2.Object.riga_distinta_note[li_ret] = ls_note     
				  	dw_2.Object.riga_distinta_id_articolo[li_ret] = ll_art_sost    
				  	dw_2.Object.riga_distinta_quantita[li_ret] = ld_qta  
				 	dw_2.Object.riga_distinta_peso_netto[li_ret]=ld_qta* ld_peso_componente
				end if  
		  	next 
		  	li_r2=dw_2.rowcount()
			//il tot_fisso altro non è che la somma delle lunghezze dei componenti che non variano con 
	  		//la lunghezza (chiusure, chiusure con bollo, infilature)
	  		if li_r2>0 then tot_fisso=dw_2.getitemdecimal(li_r2,'tot_fisso')
			  	  
//		  	tot_fisso=dw_2.getitemdecimal(li_r2,'tot_fisso')
		  	for j=1 to li_r2
			  	ls_varie=dw_2.getitemstring(j,'riga_distinta_varie') 
			  //aggiunto 130612 gestione bollo riga (sigla prezzo)
				if ls_varie='B' then
					dw_2.setitem(j, "bollo1", ls_bollo)
				end if
			 //fine 130612
				ld_qta_documento=dw_2.getitemdecimal(j,'qta_residua')
			  	ld_qta_componente=dw_2.getitemdecimal(j,'riga_distinta_quantita')
			  	if ls_varie='J' or ls_varie='L' then
					ld_dim_documento=dw_2.getitemdecimal(j,'riga_documento_dim_l')
					ld_dim_confezione=dw_2.getitemdecimal(j,'unita_confezione_dim_l')
					if integer(ld_qta_componente)=ld_qta_componente then 
						li_arrotonda=0
					else
						li_arrotonda=2
					end if
					tot_fisso=ld_qta_componente/(ld_dim_confezione - tot_fisso)
					ld_qta=(ld_qta_componente + (ld_dim_documento - ld_dim_confezione)*tot_fisso)*ld_qta_documento
					ld_qta=round(ld_qta, li_arrotonda)
					dw_2.Object.quantita15[j] = ld_qta
				else
					dw_2.Object.quantita15[j] = ld_qta_documento*ld_qta_componente
				end if	
		  	next
				
				
						
		  	li_r3=dw_righe_esplose.rowcount()
		  	if isnull(li_r3) or li_r3=0 then li_r3=1
		  	dw_2.RowsCopy(1, li_r2, Primary!, dw_righe_esplose, li_r3 +1, Primary!)
		  
		end if

next
//QUESTO SERVE PER PASSARE AL COMPONI ORDINE GLI ARTICOLI NON DI PRODUZIONE INTERNA 210113
DWfilter2 = "prod_interna='N' OR isnull(confronto)"
tab_1.tabpage_2.dw_righe_scelte.SetFilter(DWfilter2)
tab_1.tabpage_2.dw_righe_scelte.Filter()

ll_righe=tab_1.tabpage_2.dw_righe_scelte.RowCount()
if ll_righe>0 then
for i = 1 to ll_righe
	  ll_id_riga=dw_righe_scelte.getitemnumber(i, "riga_documento_id_riga_documento") 
     dw_3.retrieve(ll_id_riga)
next	  
end if
DWfilter2 = ""
tab_1.tabpage_2.dw_righe_scelte.SetFilter(DWfilter2)
tab_1.tabpage_2.dw_righe_scelte.Filter()
li_r2=dw_3.rowcount()
if li_r2>0 then
	li_r3=dw_righe_esplose.rowcount()
	
	li_r3=dw_3.RowsCopy(1, li_r2, Primary!, dw_righe_esplose, li_r3 +1, Primary!)
	if li_r3<>1 then messagebox("Errore", "Righe non copiate: riga 157 cb_esplodi")
end if
dw_righe_esplose.sort()
dw_righe_esplose.GroupCalc()



end event

