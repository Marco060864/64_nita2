type dw_righe_testa from datawindow within tabpage_1
event ue_post_itemchanged ( long al_riga,  string as_colonna,  string as_valore )
integer y = 988
integer width = 2761
integer height = 1148
integer taborder = 40
string dataobject = "d_orafo_ordini_dettagli_dis_gd"
boolean hscrollbar = true
boolean vscrollbar = true
