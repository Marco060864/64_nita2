		dw_4.setitem(a,"id_riga_documento", ll_id_riga_doc)
		ll_appoggio=tab_1.tabpage_2.dw_righe_esplose.getitemnumber(i,"id_documento")
		dw_4.setitem(a,"id_documento",ll_appoggio)
