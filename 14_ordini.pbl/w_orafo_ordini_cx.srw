ll_row=tab_1.tabpage_2.dw_righe_esplose.rowcount()


if ll_row>0 then
	dw_4.reset()
	//giro
	for i=1 to ll_row
		ll_id_riga_doc=tab_1.tabpage_2.dw_righe_esplose.getitemnumber(i,"id_riga_documento")
		select ordinato_fo
		into :ls_ordinato
		from dba.riga_documento
		where id_riga_documento=:ll_id_riga_doc
		;
		
		//trovo l'id_riga_distinta per cercare il tipo riga (se articolo fittizio non esplodo)
		ll_appoggio=tab_1.tabpage_2.dw_righe_esplose.getitemnumber(i,"riga_distinta_id_riga_distinta")
		select tipo_riga, varie
		into :ls_tipo_riga, :ls_varie
		from riga_distinta
		where id_riga_distinta=:ll_appoggio;
		//aggiunto varie ='s' che sta per articolo di lavorazione (è un articolo fittizio, in effetti potevo usare quel flag lì ...
		//l'articolo di lavorazione dovrebbe sempre essere fittizio, ma per sicurezza ... 07-04-2012
		//aggiungo se la riga è già stata
		if ls_tipo_riga='F' or ls_varie='S'  then
			continue
		else
			a++
		end if
		
		dw_4.insertrow(a)
