				dw_righe_gruppo.setitem(i,"sigla_prezzo",ls_bollo)

				//ll_riga_doc_trovato=tab_1.tabpage_1.dw_testa.find("id_documento="+string(ll_appoggio), 1, tab_1.tabpage_1.dw_testa.rowcount())
//				ls_appoggio=tab_1.tabpage_2.dw_righe_scelte.getitemstring(i,"riga_documento_descrizione")
//				//dw_righe_gruppo.setitem(i,"riga_documento_descrizione",ls_appoggio)
//				if ll_riga_doc_trovato>0 then
//					ls_bollo=tab_1.tabpage_1.dw_testa.getitemstring(ll_riga_doc_trovato, "bollo")
//					if ls_bollo> " " then
//						ls_appoggio+=" - Bollo: "+ls_bollo
//					end if
//				else
//					messagebox("Incredibile!", "Incredibile!")
//				end if
//				dw_righe_gruppo.setitem(i,"riga_documento_descrizione",ls_appoggio )
				//fine bollo
				
				dw_righe_gruppo.setitem(i,"riga_documento_id_conto",ll_conto_pred)
				ll_qta1=tab_1.tabpage_2.dw_righe_scelte.getitemdecimal(i,"riga_documento_quantita")			
				dw_righe_gruppo.setitem(i,"quantita",ll_qta1)
				ll_appoggio=tab_1.tabpage_2.dw_righe_scelte.getitemnumber(i,"articolo_id_sog_commerciale")
				dw_righe_gruppo.setitem(i,"id_sog_commerciale",ll_appoggio)
				ls_appoggio=tab_1.tabpage_2.dw_righe_scelte.getitemstring(i,"sog_commerciale_gen_rag_soc_1")	
				dw_righe_gruppo.setitem(i,"rag_soc_1",ls_appoggio)
				ls_appoggio=tab_1.tabpage_2.dw_righe_scelte.getitemstring(i,"articolo_codice")
				dw_righe_gruppo.setitem(i,"c_articolo_cod",ls_appoggio)
				ls_appoggio=tab_1.tabpage_2.dw_righe_scelte.getitemstring(i,"riga_documento_descrizione")
				dw_righe_gruppo.setitem(i,"riga_documento_descrizione",ls_appoggio)
