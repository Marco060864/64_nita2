event clicked;long ll_id_sog_com, ll_id_articolo, ll_rows

s_ric_param ls_ric_param
w_search_main lw_sm
window win_ord

CHOOSE CASE tab_1.tabpage_1.dw_testa.dataobject
	CASE "d_orafo_ordini_sog_com_gd"
		ls_codice_art=""
		ls_ric_param.s_filter_value=ls_codice_art
		ls_ric_param.s_filter_name="codice"
		openwithparm(lw_sm,ls_ric_param,"w_sog_commerciale_gen_coddes_sw")
		ls_ric_param=message.powerobjectparm
		if upperbound(ls_ric_param.s_id_seg_value)>0 then
			LL_id_sog_com=long(ls_ric_param.s_id_seg_value[1])
			tab_1.tabpage_1.dw_testa.retrieve(ll_id_sog_com)
			tab_1.tabpage_1.dw_testa.setfocus()
			ls_filtro=""
			ls_tipo_ricerca='sog_com'
			win_ord=Getparent(tab_1)
			win_ord.Title='Gestione Ordini: Ordini di '+ls_ric_param.s_ausil_value[1]
		end if
	CASE "d_orafo_ordini_articolo_gd"
		ls_codice_art=""
		ls_ric_param.s_filter_value=ls_codice_art
		ls_ric_param.s_filter_name="id_articolo"
		openwithparm(lw_sm,ls_ric_param,"w_articolo_coddes_documento_sw")
		ls_ric_param=message.powerobjectparm
		if upperbound(ls_ric_param.s_id_seg_value)>0 then
			ll_id_articolo=long(ls_ric_param.s_id_seg_value[1])
			ls_codice_art=ls_ric_param.s_main_value
			st_art_cor.text=ls_codice_art
			tab_1.tabpage_1.dw_testa.retrieve(ll_id_articolo)
			tab_1.tabpage_1.dw_testa.setfocus()
			cbx_tutti.Checked=false
			ls_filtro='riga_documento_id_articolo = '+string(ll_id_articolo)
			ll_valore=ll_id_articolo
			ls_tipo_ricerca='articolo'
			win_ord=Getparent(tab_1)
			win_ord.Title='Gestione Ordini: Ordini per Articolo'
		end if
	CASE "d_orafo_ordini_tutti_gd"
		tab_1.tabpage_1.dw_testa.retrieve()
		ls_filtro=''
		ls_tipo_ricerca='tutti'
		win_ord=Getparent(tab_1)
		win_ord.Title='Gestione Ordini: Tutti gli ordini'
	CASE "d_orafo_ordini_a_data_gd"
		Open(w_orafo_imposta_data_cx)
		ls_codice_art=Message.StringParm
		tab_1.tabpage_1.dw_testa.retrieve(date(ls_codice_art))
		ls_filtro=''
		ls_tipo_ricerca='data'
		win_ord=Getparent(tab_1)
		win_ord.Title='Gestione Ordini: Data scadenza entro il '+ls_codice_art
END CHOOSE



tab_1.tabpage_1.dw_righe_testa.Reset()
tab_1.tabpage_2.dw_righe_scelte.Reset()
tab_1.tabpage_2.dw_righe_esplose.Reset()
tab_1.tabpage_1.dw_testa.setfocus()






	
end event

