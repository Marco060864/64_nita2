	 from dba.documento d, dba.sog_commerciale_gen s
	 where d.id_documento=:ll_id_ordine
	 and d.id_sog_commerciale=s.id_sog_commerciale
	 ;
	 if isnull(ll_id_cliente) then ll_id_cliente=0
	 dw_4.setitem(i,'c_cmc_data',ls_rag_cliente)
 //quindi sommo le righe se fonritore, articolo, cliente e bollo sono identici
 //26-10-12 samy chiede di dividere anche per documento ...
	 if ls_rag1 = ls_rag2 and ll_id_art1 = ll_id_art2 and ll_id_cliente=ll_id_cliente1 &
	 and ls_bollo1=ls_bollo2 and ll_id_ordine_old=ll_id_ordine then 
		ll_qta2=dw_4.getitemdecimal(i,'quantita') //somma la qta
		ld_peso2=dw_4.getitemdecimal(i,'riga_documento_peso_netto') //e il peso
		if not(isnull(ld_peso2)) then 
			ld_peso=ld_peso+ld_peso2
		end if
		ll_qta1=ll_qta1+ll_qta2
		dw_4.setitem(row,'quantita',ll_qta1)//metto i valori nella prima riga
		dw_4.setitem(row,'riga_documento_peso_netto',ld_peso)
		dw_4.deleterow(i)//e cancello l'altra
		i= i - 1
		ll_row=ll_row - 1			
	else
		ls_rag1 = ls_rag2
		ll_id_cliente1=ll_id_cliente
		ll_id_art1 = ll_id_art2
		ls_bollo1=ls_bollo2
		
		if isnull(ls_bollo1) then ls_bollo1=""
		ll_qta1=dw_4.getitemdecimal(i,'quantita')
		ld_peso=dw_4.getitemdecimal(i,'riga_documento_peso_netto')
		if isnull(ld_peso) then ld_peso=0
		row=i
	end if
next			
