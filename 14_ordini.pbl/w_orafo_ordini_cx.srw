long ll_prog_vero[]
s_ordine_fornitori str_parm
//if  dw_4.rowcount()>0 then
if dw_righe_gruppo.rowcount()>0 then
	//wf_setta_disponibili()
	
	i=1
	li_row=tab_1.tabpage_1.dw_testa.GetSelectedRow (0 )
	
	DO WHILE li_row<>0
		//per samy 261012 vuole solo num progressivo
		ll_prog_vero[i]=tab_1.tabpage_1.dw_testa.Getitemnumber(li_row,'num_progressivo_vero')
		//fine 261012
		ll_num[i]=tab_1.tabpage_1.dw_testa.Getitemstring(li_row,'num_progressivo')
		ld_date[i]=tab_1.tabpage_1.dw_testa.Getitemdate(li_row,'data_registrazione')
		ls_rag[i]=tab_1.tabpage_1.dw_testa.Getitemstring(li_row,'rag_soc_1')
		li_row=tab_1.tabpage_1.dw_testa.GetSelectedRow ( li_row )
		i=i + 1
	LOOP
	
	//190612	AGGIUNTO
	str_parm.dw_ordini=tab_1.tabpage_1.dw_testa
	str_parm.dw_righe=dw_righe_gruppo
	str_parm.num_doc=ll_num
	str_parm.data_reg=ld_date
	str_parm.rag_sociale[]=ls_rag
	str_parm.num_prog=ll_prog_vero
	
	
	string ls_azienda

	select codice
	into :ls_azienda
	from dba.azienda
	;
	if cbx_st_disponibilita.checked then
		str_parm.personalizza='V'
	end if
		
	openwithparm(w_stampa_ordine_st, str_parm)
end if
end event

type dw_righe_gruppo from datawindow within tabpage_3
event ue_calc_qta ( boolean ab_ignora_disp )
integer x = 18
integer y = 28
integer width = 3301
integer height = 1956
integer taborder = 70
string dragicon = "S:\pb\commonframework\cometa.ico"
string dataobject = "d_orafo_ordini_riga_documento_gorup_gd"
boolean hscrollbar = true
boolean vscrollbar = true
boolean livescroll = true
borderstyle borderstyle = stylelowered!
end type

event ue_calc_qta;
end event

event clicked;string ls_codice
long ll_id_sog_com, ll_id_articolo
integer li_ret

s_ric_param ls_ric_param
w_search_main lw_sm

if string(dwo.name)= "p_ordini_fornitore" then
	ls_ric_param.s_filter_value=ls_codice
	ls_ric_param.s_filter_name="codice"
	ll_id_articolo=this.GetItemNumber(row,"id_articolo")
	ls_ric_param.s_sql_cond="unita_confezione.id_articolo = "+string(ll_id_articolo)
	openwithparm(lw_sm,ls_ric_param,"w_orafo_fornitori_sw")
	
	ls_ric_param=message.powerobjectparm
	if upperbound(ls_ric_param.s_id_seg_value)>0 then
		LL_id_sog_com=long(ls_ric_param.s_id_seg_value[1])
		ls_codice=ls_ric_param.s_ausil_value[1]
		li_ret=setitem(row, "rag_soc_1", ls_codice)
		if li_ret<>1 then messagebox("Errore!", "Setitem fallito codice fornitore")
		li_ret=setitem(row, "id_sog_commerciale", LL_id_sog_com)
		if li_ret<>1 then messagebox("Errore!", "Setitem fallito id_sog_commerciale")
		setsort("rag_soc_1")
		sort()
		groupcalc()
	end if
else
	if row>0 then
		this.drag(begin!)
		il_riga_part=row
		ll_fornitore_part = this.GetItemString(row,"rag_soc_1")
		wf_multisel(row,this,"",this,"","")
	end if
end if
end event

event dragdrop;this.drag(end!)
string ls_fornitore
long ll_id_sog_com
integer li_ret
char lc_prod_int
if isnull(ll_fornitore_part) then ll_fornitore_part=""
if ll_fornitore_part <> this.GetItemString(row,"rag_soc_1") then
if row>0 then
	ls_fornitore=getitemstring(row,"rag_soc_1")
	lc_prod_int=getitemstring(il_riga_part,"prod_interna")
	if (ls_fornitore<>'produzione interna')or(lc_prod_int='S') then
		ll_id_sog_com=getitemnumber(row,"id_sog_commerciale")
		setitem(il_riga_part, "rag_soc_1", ls_fornitore)
	
		setitem(il_riga_part, "id_sog_commerciale", ll_id_sog_com)	
		setsort("rag_soc_1")	
		sort()
		li_ret=groupcalc()
	end if
end if
end if


end event

event rowfocuschanged;//apro, se è il caso w_giacenza_pz
	long ll_id_art
	if isvalid(w_giacenza_pz) then
		w_giacenza_pz.post w_leggi_saldo(-1)
	end if

end event

