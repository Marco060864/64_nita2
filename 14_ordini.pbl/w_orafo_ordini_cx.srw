type cb_stampa from commandbutton within tabpage_2
integer x = 2894
integer y = 1140
integer width = 535
integer height = 112
integer taborder = 50
integer textsize = -8
integer weight = 400
fontcharset fontcharset = ansi!
fontpitch fontpitch = variable!
fontfamily fontfamily = swiss!
string facename = "Arial"
string text = "Stampa righe esplose"
end type

event clicked;

boolean lb_test,lb_test2
integer li_due_job 
integer k, j, i, f,a, li_pos,li_ret, li_test, c
decimal ld_ris_hor, ld_ris_ver, ld_peso, ld_qta, ld_test, ll_alt_pagina, ll_lar_pagina
decimal ld_dpi_x, ld_dpi_y, ll_altezza1, ll_larghezza1, ll_marg_superiore,ll_marg_sinistro
datastore ds_stampa
ulong ll_job, job ,mydc, mydc2
long ll_righe_doc_select 
long ll_row,  ll_breakrow,ll_primo, ll_secondo,ll_alt_banda,  ll_unita_conf
decimal ll_altezza, ll_larghezza,  ll_PixelDiX, ll_PixelDiY, ll_art,ll_MmDiX,ll_MmDiY, ld_peso_man, ld_lunghezza
string ls_path_imm, ls_nome_imm, ls_campo, ls_codice, ls_cod
constant integer HorzRes = 8	
constant integer VertRes = 10	
constant integer HorzSize = 4	
constant integer VertSize = 6  
constant integer PhysicalOffsetX = 112	
constant integer PhysicalOffsetY = 113	
long ll_id_articolo, ll_id_soggetto
string ls_cod_soggetto
decimal ld_misura_articolo

ll_row=dw_righe_esplose.rowcount()
if ll_row>0 then 
	
	ds_stampa=create datastore
	printsetup()
	
	parent.pointer='hourglass!'
	open(w_attesa)
	
	lb_test=tab_1.tabpage_2.cbx_singola_st.checked 
	lb_test2=tab_1.tabpage_2.cbx_raggruppa.checked 
	
	
	li_ret=0
	
	select dir_immagini
	into :ls_path_imm
	from par_sistema
	where id_azienda=1;
	
	ll_job = PrintOpen()
	 if ll_job<=0 then
		messagebox("Errore", "Problema di comunicazione con la stampante: non recupero job!")
		if isvalid(ds_stampa) then destroy(ds_stampa)
		close(w_attesa)
		return
	end if
	mydc=0
	myDC=PRP_GetDC(ll_job)
	if myDC<0 then 
		messagebox("Errore", "Problema di comunicazione con la stampante: non recupero job!")
		if isvalid(ds_stampa) then destroy(ds_stampa)
		close(w_attesa)
		return
	end if
	for i=1 to ll_row
		li_test=0
		
		ll_breakrow = dw_righe_esplose.FindGroupChange( i+1, 1)
		IF ll_breakrow <= 0 THEN 
				
				
				j= dw_righe_esplose.rowcount()
			else 
					if ll_breakrow<> 1 then
				 j=ll_breakrow -1
			else 
				j=2    
				i=3   
			 end if
		end if	
		
		
		
		ole_1.object.delimage=true
		
		ll_id_articolo=dw_righe_esplose.getitemnumber(i,"riga_documento_id_articolo") 
		ls_cod_soggetto=dw_righe_esplose.getitemstring(i, "sog_codice")
		select id_sog_commerciale
		into :ll_id_soggetto
		from sog_commerciale
		where codice=:ls_cod_soggetto;
		if sqlca.sqlcode<>0 then
			messagebox("Errore!", "Soggetto non trovato, verrà usata immagine di base!")
		end if
		
		ls_nome_imm=f_trova_immagine( ll_id_soggetto, ll_id_articolo)
		
		if ls_nome_imm="" then 
			ls_nome_imm=dw_righe_esplose.getitemstring(i,"articolo_immagine") 
		end if
		
		IF (not isnull(ls_nome_imm) and fileexists(ls_nome_imm)) or fileexists(ls_path_imm+'\'+ls_nome_imm) then
			if pos(ls_nome_imm, '\')>0 then
				ole_1.object.loadimage(ls_nome_imm)
			else
				ole_1.object.loadimage(ls_path_imm+'\'+ls_nome_imm)
			end if
		else
			ole_1.object.delimage=true
		END IF
		
		
		ll_PixelDiX = getdevicecaps(mydc,HorzRes) 
		ll_PixelDiY = getdevicecaps(mydc,VertRes) 
		ll_MmDiX = getdevicecaps(mydc,HorzSize) 
		ll_MmDiY = getdevicecaps(mydc,VertSize) 
		ll_marg_superiore=getdevicecaps(mydc,PhysicalOffsetY) 
		ll_marg_sinistro=getdevicecaps(mydc,PhysicalOffsetX) 
		
		if ll_PixelDiX=0 or isnull(ll_PixelDiX)  then 
			li_ret=messagebox("Errore", "Risoluzione stampante non recuperabile!")
			if isvalid(ds_stampa) then 
				destroy(ds_stampa)
				PrintCancel (job)
				close (w_attesa)
				return
			end if
		end if
		
		ld_Dpi_X = ll_PixelDiX / (10*ll_MmDiX)
		ld_Dpi_Y = ll_PixelDiY / (10*ll_MmDiY)
		
	
	
		
		
		ld_ris_hor=ole_1.object.imageXdpi
		ld_ris_ver=ole_1.object.imageYdpi
		
		
		if ld_ris_hor=0 or isnull(ld_ris_hor) then
			
			ld_ris_hor=100000000
			ld_ris_ver=100000000
		end if
		
		ll_altezza1=ole_1.object.imageheight
		ll_larghezza1=ole_1.object.imagewidth
		
		ll_altezza1=ll_altezza1/ld_ris_ver 
		ll_larghezza1=ll_larghezza1/ld_ris_hor
		
		ll_altezza1*=253.995
		ll_larghezza1*=253.995
				
		
		do while ll_larghezza1>2000
				
			messagebox('Attenzione', 'Il formato della foto non entra nel foglio A4 la foto ~r~n verrà ridimensionata di 1/3')
			ll_altezza1=ll_altezza1/3*2
			ll_larghezza1=ll_larghezza1/3*2
		loop
		
		Choose Case  ll_larghezza1  
			case is > 600
				
				
				if ll_altezza1> 1100 then 
					
					li_test=1
					
					if lb_test=true and lb_test2=false then
						 ds_stampa.dataobject='d_stp_esplodi_riga_3_fan'
					else	  
						 ds_stampa.dataobject='d_stp_esplodi_riga_3'
					end if	 
					ds_stampa.reset()
					ds_stampa.settransobject(sqlca)
					li_ret=dw_righe_esplose.RowsCopy(i,j , Primary!, ds_stampa, 1, Primary!)
					if li_ret<>1 then messagebox('Attenzione','righe non copiate!')
					job=PrintOpen()
								myDC2=PRP_GetDC(job)
					li_due_job=100
					
					
					ll_altezza1*=ld_Dpi_Y
					ll_larghezza1*=ld_Dpi_X
					ole_1.object.printsize=6
					//era ole_1.object.printtop=(100*ld_Dpi_Y) - ll_marg_superiore
					ole_1.object.printtop=(100*ld_Dpi_Y) - ll_marg_superiore
					ole_1.object.printleft=(50*ld_Dpi_X) - ll_marg_sinistro
					//era ole_1.object.printbottom= (100*ld_Dpi_Y) + ll_altezza1 - ll_marg_superiore
					ole_1.object.printbottom= (100*ld_Dpi_Y) + ll_altezza1 - ll_marg_superiore
					ole_1.object.printright=(50*ld_Dpi_X) + ll_larghezza1 - ll_marg_sinistro
					li_ret=1
						 else 
				
					
					if lb_test=true and lb_test2=false then
						 ds_stampa.dataobject='d_stp_esplodi_riga_1_fan'
					else	  
						ds_stampa.dataobject='d_stp_esplodi_riga_1'
					end if	 
					ds_stampa.reset()
					ds_stampa.settransobject(sqlca)
					li_ret=dw_righe_esplose.RowsCopy(i,j , Primary!, ds_stampa, 1, Primary!)
					if li_ret<>1 then messagebox('Attenzione','righe non copiate!')
					if lb_test=true  and lb_test2=false then
						
						
						ll_altezza1*=ld_Dpi_Y
						ll_larghezza1*=ld_Dpi_X
						ole_1.object.printsize=6
						ole_1.object.printtop=(500*ld_Dpi_Y) - ll_marg_superiore
						ole_1.object.printleft=(50*ld_Dpi_X) - ll_marg_sinistro
						ole_1.object.printbottom= (500*ld_Dpi_Y) + ll_altezza1 - ll_marg_superiore
						ole_1.object.printright=(50*ld_Dpi_X) + ll_larghezza1 - ll_marg_sinistro
						
					else	
						
						
						ll_altezza1*=ld_Dpi_Y
						ll_larghezza1*=ld_Dpi_X
						ole_1.object.printsize=6
						ole_1.object.printtop=(500*ld_Dpi_Y) - ll_marg_superiore
						ole_1.object.printleft=(50*ld_Dpi_X) - ll_marg_sinistro
						ole_1.object.printbottom= (500*ld_Dpi_Y) + ll_altezza1 - ll_marg_superiore
						ole_1.object.printright=(50*ld_Dpi_X) + ll_larghezza1 - ll_marg_sinistro	
					end if	
				end if	
			case else
				do while ll_altezza1>2500 
					messagebox('Attenzione','Il formato della foto non entra nel foglio A4 la foto ~r~nverrà ridimensionata di 1/3')
						ll_altezza1=ll_altezza1/3*2
								ll_larghezza1=ll_larghezza1/3*2
				loop
					if lb_test=true and lb_test2=false then
						 ds_stampa.dataobject='d_stp_esplodi_riga_2_fan'
					else	  
						ds_stampa.dataobject='d_stp_esplodi_riga_2'
					end if	 
				ds_stampa.reset()
				ds_stampa.settransobject(sqlca)
				li_ret=dw_righe_esplose.RowsCopy(i,j, Primary!, ds_stampa, 1, Primary!)
				if li_ret<>1 then messagebox('Attenzione','righe non copiate!')
				
				
				ll_altezza1*=ld_Dpi_Y
				ll_larghezza1*=ld_Dpi_X
									
				ole_1.object.printsize=6
				ole_1.object.printtop= (190*ld_Dpi_Y) - ll_marg_superiore
				ole_1.object.printleft= (1440*ld_Dpi_X) - ll_marg_sinistro
				ole_1.object.printbottom= (190*ld_Dpi_Y) + ll_altezza1 - ll_marg_superiore
				ole_1.object.printright= (1440*ld_Dpi_X) + ll_larghezza1 - ll_marg_sinistro
		
		END Choose
	
	
	
	
	
		f=1
		
		
		if lb_test=true and lb_test2=false then  
			ll_righe_doc_select=tab_1.tabpage_2.dw_righe_esplose.getitemnumber(i, "id_riga_documento")
			select id_des_articolo
			into :ll_art
			from riga_documento
			where id_riga_documento=:ll_righe_doc_select;
			if ll_art>0 then
				select codice
				into :ls_cod
				from des_articolo
				where id_des_articolo=:ll_art;
				if ls_cod >"" then ds_stampa.setitem(1,'note15', ls_cod)
			end if
	
	
		end if
		
		
		
		ld_lunghezza=dw_righe_esplose.getitemdecimal(i,"riga_documento_dim_l")
		ld_peso=0
		ld_peso_man=0
		select peso_manuale, peso_unitario
		into :ld_peso_man, :ld_peso
		from orafo_lung_peso
		where id_articolo=:ll_id_articolo and id_sog_commerciale=:ll_id_soggetto
		and lunghezza=:ld_lunghezza 
		
		and simbolo_um='CM';
		if ld_peso_man>0 or ld_peso>0 then	
			if ld_peso_man>0 then
				ld_peso=ld_peso_man
			end if
		else
			
			ll_unita_conf=tab_1.tabpage_2.dw_righe_esplose.getitemnumber(i, "riga_documento_id_unita_confezione")
			select peso_netto, dim_l
			into :ld_peso, :ld_misura_articolo
			from unita_confezione
			where id_unita_confezione=:ll_unita_conf;
			if ld_lunghezza>0 and ld_misura_articolo>0 and ld_lunghezza<>ld_misura_articolo then
				ld_peso=ld_lunghezza*ld_peso/ld_misura_articolo
			end if
		end if
	ds_stampa.setitem(1, 'misura15' ,ld_peso)
	ll_primo=dw_righe_esplose.getitemnumber(i, "riga_distinta_id_riga_distinta")
	wf_setta_cast(1,f,i,ds_stampa,lb_test,lb_test2)
	if j>i then
	  for k=i+1 to j
		
		ll_secondo=dw_righe_esplose.getitemnumber(k, "riga_distinta_id_riga_distinta")
		if ll_primo=ll_secondo or isnull(ll_secondo) then 
																		 
			f=f+1                                           
			wf_setta_cast(1,f,k,ds_stampa,lb_test,lb_test2)                  
		else																
				exit
		end if
	next	
	end if
		
		if li_test=0 then ole_1.object.printimage=mydc
			
			tab_1.tabpage_4.dw_5.dataobject=ds_stampa.dataobject
			ds_stampa.rowscopy(1, ds_stampa.rowcount(), primary!,tab_1.tabpage_4.dw_5,1, primary!)
			
			PrintDataWindow(ll_job, ds_stampa)
		
		
		if li_due_job=100 then
			ole_1.object.printimage=mydc2
			printclose(job)
			DeleteDC(mydc2)
			li_ret=0
		end if	
		
		i=j
		
		
		
		
//		if i=ll_row then
//			
//		//else
//			//printpage(ll_job)
//		end if
	next
	printclose(ll_job)
	deletedc(mydc)
	close(w_attesa)
	parent.pointer='arrow!'
end if
end event

event rbuttondown;

boolean lb_test,lb_test2
integer li_due_job 
integer k, j, i, f,a, li_pos,li_ret, li_test, c
decimal ld_ris_hor, ld_ris_ver, ld_peso, ld_qta, ld_test, ll_alt_pagina, ll_lar_pagina
decimal ld_dpi_x, ld_dpi_y, ll_altezza1, ll_larghezza1, ll_marg_superiore,ll_marg_sinistro, ll_rotate
datastore ds_stampa
ulong ll_job, job ,mydc, mydc2
long ll_righe_doc_select 
long ll_row,  ll_breakrow,ll_primo, ll_secondo,ll_alt_banda,  ll_unita_conf
decimal ll_altezza, ll_larghezza,  ll_PixelDiX, ll_PixelDiY, ll_art,ll_MmDiX,ll_MmDiY, ld_peso_man, ld_lunghezza
string ls_path_imm, ls_nome_imm, ls_campo, ls_codice, ls_cod
constant integer HorzRes = 8	
constant integer VertRes = 10	
constant integer HorzSize = 4	
constant integer VertSize = 6  
constant integer PhysicalOffsetX = 112	
constant integer PhysicalOffsetY = 113	
long 	  ll_costante = 1340 
long ll_id_articolo, ll_id_soggetto, ll_max_ingombro
string ls_cod_soggetto
decimal ld_misura_articolo


ll_row=dw_righe_esplose.rowcount()
if ll_row>0 then 
	
	ds_stampa=create datastore
	ds_stampa.settransobject(sqlca)
	
	
	//200308
//	ds_stampa.dataobject='d_stp_esplodi_riga_2_kati'
	 
	printsetup()
	
	parent.pointer='hourglass!'
	open(w_attesa)
	
	lb_test=tab_1.tabpage_2.cbx_singola_st.checked 
	lb_test2=tab_1.tabpage_2.cbx_raggruppa.checked 
	
	
	li_ret=0
	
	select dir_immagini
	into :ls_path_imm
	from par_sistema
	where id_azienda=1;
	
	ll_job = PrintOpen()
	 if ll_job<=0 then
		messagebox("Errore", "Problema di comunicazione con la stampante: non recupero job!")
		if isvalid(ds_stampa) then destroy(ds_stampa)
		close(w_attesa)
		return
	end if
	mydc=0
	myDC=PRP_GetDC(ll_job)
	if myDC<0 then 
		messagebox("Errore", "Problema di comunicazione con la stampante: non recupero job!")
		if isvalid(ds_stampa) then destroy(ds_stampa)
		close(w_attesa)
		return
	end if
	
	
	a=0
	for i=1 to ll_row
		
		
		li_test=0
		
		ll_breakrow = dw_righe_esplose.FindGroupChange( i+1, 1)
		IF ll_breakrow <= 0 THEN 
				
				
				j= dw_righe_esplose.rowcount()
			else 
					if ll_breakrow<> 1 then
				 j=ll_breakrow -1
			else 
				j=2    
				i=3   
			 end if
		end if	
		
		
		
		ole_1.object.delimage=true
		
		ll_id_articolo=dw_righe_esplose.getitemnumber(i,"riga_documento_id_articolo") 
		//200308 se esiste distinta stampo un dw sennò l'altra
		if wf_esiste_distinta(ll_id_articolo)>0 then
			if ds_stampa.dataobject='d_stp_esplodi_riga_2_kati' then
				if a=1 then 
//					a=-1
					tab_1.tabpage_4.dw_5.dataobject=ds_stampa.dataobject
					ds_stampa.rowscopy(1, ds_stampa.rowcount(), primary!,tab_1.tabpage_4.dw_5,1, primary!)
					DS_STAMPA.SORT()
					PrintDataWindow(ll_job, ds_stampa)
					//printpage(ll_job)
					ds_stampa.reset()
				end if
			end if
			ds_stampa.dataobject='d_stp_esplodi_riga_2_kati_pg_int'
			a=1
			ll_costante = 0
		else
			if ds_stampa.dataobject<>'d_stp_esplodi_riga_2_kati' then
				ds_stampa.dataobject='d_stp_esplodi_riga_2_kati'
				ll_costante = 1140
			end if
		end if
		ls_cod_soggetto=dw_righe_esplose.getitemstring(i, "sog_codice")
		select id_sog_commerciale
		into :ll_id_soggetto
		from sog_commerciale
		where codice=:ls_cod_soggetto;
		if sqlca.sqlcode<>0 then
			messagebox("Errore!", "Soggetto non trovato, verrà usata immagine di base!")
		end if
		
		ls_nome_imm=f_trova_immagine( ll_id_soggetto, ll_id_articolo)
		
		if ls_nome_imm="" then 
			ls_nome_imm=dw_righe_esplose.getitemstring(i,"articolo_immagine") 
		end if
		
		IF (not isnull(ls_nome_imm) and fileexists(ls_nome_imm)) or fileexists(ls_path_imm+'\'+ls_nome_imm) then
			if pos(ls_nome_imm, '\')>0 then
				ole_1.object.loadimage(ls_nome_imm)
			else
				ole_1.object.loadimage(ls_path_imm+'\'+ls_nome_imm)
			end if
		else
			ole_1.object.delimage=true
		END IF
		
		
		ll_PixelDiX = getdevicecaps(mydc,HorzRes) 
		ll_PixelDiY = getdevicecaps(mydc,VertRes) 
		ll_MmDiX = getdevicecaps(mydc,HorzSize) 
		ll_MmDiY = getdevicecaps(mydc,VertSize) 
		ll_marg_superiore=getdevicecaps(mydc,PhysicalOffsetY) 
		ll_marg_sinistro=getdevicecaps(mydc,PhysicalOffsetX) 
		
		if ll_PixelDiX=0 or isnull(ll_PixelDiX)  then 
			li_ret=messagebox("Errore", "Risoluzione stampante non recuperabile!")
			if isvalid(ds_stampa) then 
				destroy(ds_stampa)
				PrintCancel (job)
				close (w_attesa)
				return
			end if
		end if
		
		ld_Dpi_X = ll_PixelDiX / (10*ll_MmDiX)
		ld_Dpi_Y = ll_PixelDiY / (10*ll_MmDiY)
	
	
		
		
		ld_ris_hor=ole_1.object.imageXdpi
		ld_ris_ver=ole_1.object.imageYdpi
		
		
		if ld_ris_hor=0 or isnull(ld_ris_hor) then
			
			ld_ris_hor=100000000
			ld_ris_ver=100000000
		end if
		
		ll_altezza1=ole_1.object.imageheight
		ll_larghezza1=ole_1.object.imagewidth
		
		ll_altezza1=ll_altezza1/ld_ris_ver 
		ll_larghezza1=ll_larghezza1/ld_ris_hor
		
		ll_altezza1*=253.995
		ll_larghezza1*=253.995
				
		
		ll_max_ingombro=max(ll_altezza1, ll_larghezza1)
		do while ll_max_ingombro>1900
			
			messagebox('Attenzione', 'Il formato della foto non entra nel foglio A4 la foto ~r~n verrà ridimensionata di 1/3')
			ll_altezza1=ll_altezza1/3*2
			ll_larghezza1=ll_larghezza1/3*2
			ll_max_ingombro=max(ll_altezza1, ll_larghezza1)
		loop
			
		if ll_altezza1 > ll_larghezza1 then
				ole_1.object.Rotate = 270
				ll_rotate=ll_altezza1
				ll_altezza1=ll_larghezza1
				ll_larghezza1=ll_rotate
		END IF
		IF ll_altezza1>750 THEN
			do while ll_altezza1 > 750 
				ll_altezza1=ll_altezza1/3*2
				ll_larghezza1=ll_larghezza1/3*2
			loop
		END IF

		 
//		 if ll_larghezza1 > ll_altezza1 then
//			do while ll_altezza1 > 770 
//				ll_altezza1=ll_altezza1/3*2
//				ll_larghezza1=ll_larghezza1/3*2
//			loop
//		else
//			IF ll_larghezza1 <= 770 and ll_altezza1 > 770 THEN
//				ole_1.object.Rotate = 270
//				ll_rotate=ll_altezza1
//				ll_altezza1=ll_larghezza1
//				ll_larghezza1=ll_rotate
//			ELSE
//				do while ll_larghezza1 > 770 
//					ll_altezza1=ll_altezza1/3*2
//					ll_larghezza1=ll_larghezza1/3*2
//				loop
//			END IF
//			
		
					
					
		
	
		li_ret=dw_righe_esplose.RowsCopy(i,j , Primary!, ds_stampa, 1, Primary!)
		if li_ret<>1 then messagebox('Attenzione','righe non copiate!')
		
		
		ll_altezza1*=ld_Dpi_Y
		ll_larghezza1*=ld_Dpi_X
		ole_1.object.printsize=6
		//era ole_1.object.printtop=(451*ld_Dpi_Y) - ll_marg_superiore + (ll_costante*ld_Dpi_Y*a)
		ole_1.object.printtop=(351*ld_Dpi_Y) - ll_marg_superiore + (ll_costante*ld_Dpi_Y*a)
		ole_1.object.printleft=(50*ld_Dpi_X) - ll_marg_sinistro
		//era ole_1.object.printbottom= (451*ld_Dpi_Y) + ll_altezza1 - ll_marg_superiore + (ll_costante*ld_Dpi_Y*a)
		ole_1.object.printbottom= (351*ld_Dpi_Y) + ll_altezza1 - ll_marg_superiore + (ll_costante*ld_Dpi_Y*a)
		ole_1.object.printright=(50*ld_Dpi_X) + ll_larghezza1 - ll_marg_sinistro
		li_ret=1
		f=1
		
		
		if lb_test=true and lb_test2=false then  
			ll_righe_doc_select=tab_1.tabpage_2.dw_righe_esplose.getitemnumber(i, "id_riga_documento")
			select id_des_articolo
			into :ll_art
			from riga_documento
			where id_riga_documento=:ll_righe_doc_select;
			if ll_art>0 then
				select codice
				into :ls_cod
				from des_articolo
				where id_des_articolo=:ll_art;
				if ls_cod >"" then ds_stampa.setitem(1,'note15', ls_cod)
			end if
	
	
		end if
		//ricopio vecchio codice kati (memorizzato in cod:intrastat) 280408
		select cod_intrastat
		into :ls_cod
		from dba.articolo
		where id_articolo=:ll_id_articolo;
		ds_stampa.setitem(1,'note15', ls_cod)
		//fine aggiunta 280408
		
		ld_lunghezza=dw_righe_esplose.getitemdecimal(i,"riga_documento_dim_l")
		ld_peso=0
		ld_peso_man=0
		select peso_manuale, peso_unitario
		into :ld_peso_man, :ld_peso
		from orafo_lung_peso
		where id_articolo=:ll_id_articolo and id_sog_commerciale=:ll_id_soggetto
		and lunghezza=:ld_lunghezza 
		
		and simbolo_um='CM';
		if ld_peso_man>0 or ld_peso>0 then	
			if ld_peso_man>0 then
				ld_peso=ld_peso_man
			end if
		else
			
			ll_unita_conf=tab_1.tabpage_2.dw_righe_esplose.getitemnumber(i, "riga_documento_id_unita_confezione")
			select peso_netto, dim_l
			into :ld_peso, :ld_misura_articolo
			from unita_confezione
			where id_unita_confezione=:ll_unita_conf;
			if ld_lunghezza>0 and ld_misura_articolo>0 and ld_lunghezza<>ld_misura_articolo then
				ld_peso=ld_lunghezza*ld_peso/ld_misura_articolo
			end if
		end if
		ds_stampa.setitem(1, 'misura15' ,ld_peso)
		ll_primo=dw_righe_esplose.getitemnumber(i, "riga_distinta_id_riga_distinta")
		wf_setta_cast(1,f,i,ds_stampa,lb_test,lb_test2)
		if j>i then
		  for k=i+1 to j
				
				ll_secondo=dw_righe_esplose.getitemnumber(k, "riga_distinta_id_riga_distinta")
				if ll_primo=ll_secondo or isnull(ll_secondo) then 
																				 
					f=f+1                                           
					wf_setta_cast(1,f,k,ds_stampa,lb_test,lb_test2)                  
				else																
						exit
				end if
			next	
		end if
		
		ole_1.object.printimage=mydc
	
			i=j
			
			
			if i=ll_row then
				tab_1.tabpage_4.dw_5.dataobject=ds_stampa.dataobject
				ds_stampa.rowscopy(1, ds_stampa.rowcount(), primary!,tab_1.tabpage_4.dw_5,1, primary!)
				DS_STAMPA.SORT()
				PrintDataWindow(ll_job, ds_stampa)
				printclose(ll_job)
				ds_stampa.reset()
			elseif a=1 then
				a=-1
				tab_1.tabpage_4.dw_5.dataobject=ds_stampa.dataobject
				ds_stampa.rowscopy(1, ds_stampa.rowcount(), primary!,tab_1.tabpage_4.dw_5,1, primary!)
				DS_STAMPA.SORT()
				PrintDataWindow(ll_job, ds_stampa)
				//printpage(ll_job)
				ds_stampa.reset()
			end if
			a++
	next
	deletedc(mydc)
	close(w_attesa)
	parent.pointer='arrow!'
end if
end event

