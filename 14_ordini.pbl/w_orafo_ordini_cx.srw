public subroutine wf_setta_campi (long set_riga); string ls_note, ls_rag, ls_num_doc, ls_bollo, ls_codice, ls_rag_1
 decimal ld_dim, ld_qta
 date ld_doc, ld_scad
 integer li_cifre_cliente, li_ant_scad
 long ll_id_doc, ll_id_sog
 
 //10-09-13 correggo: riga giusta dw errata: non "dw_righe_esplose" ma "dw_righe_scelte"
 
 
 ls_note=tab_1.tabpage_2.dw_righe_esplose.getitemstring(set_riga, "riga_documento_descrizione")
 //correggo
 ll_id_doc=tab_1.tabpage_2.dw_righe_scelte.getitemnumber(set_riga, "riga_documento_id_documento")
 ls_num_doc=""
 ls_bollo=""
 select num_documento, data_documento, data_prev_consegna, bollo, id_sog_commerciale
 into :ls_num_doc, :ld_doc, :ld_scad, :ls_bollo, :ll_id_sog
 from dba.documento
 where id_documento=:ll_id_doc
 ;
 select codice, rag_soc_1
 into :ls_codice, :ls_rag_1
 from dba.sog_commerciale_gen
 where id_sog_commerciale=:ll_id_sog
 ;
 
 
 if tab_1.tabpage_2.rb_cod.checked=true then
	//ls_rag=tab_1.tabpage_2.dw_righe_esplose.getitemstring(set_riga, "sog_codice")
	ls_rag=ls_codice
else	
  // ls_rag=tab_1.tabpage_2.dw_righe_esplose.getitemstring(set_riga, "sog_commerciale_gen_rag_soc_1")
	ls_rag=ls_rag_1
 end if 	
 ld_dim=tab_1.tabpage_2.dw_righe_esplose.getitemdecimal(set_riga, "riga_documento_dim_l")
 //ls_num_doc=tab_1.tabpage_2.dw_righe_esplose.getitemstring(set_riga, "documento_num_documento")
 //ls_num_doc=tab_1.tabpage_2.dw_righe_scelte.getitemstring(set_riga, "documento_num_documento")
 
 ld_qta=tab_1.tabpage_2.dw_righe_esplose.getitemdecimal(set_riga, "riga_documento_quantita")
// ld_doc=tab_1.tabpage_2.dw_righe_esplose.getitemdate(set_riga, "documento_data_documento")
// ld_scad=tab_1.tabpage_2.dw_righe_esplose.getitemdate(set_riga, "documento_data_scadenza")
// ls_bollo=tab_1.tabpage_2.dw_righe_esplose.getitemstring(set_riga, "bollo")

//fine correzione 10-09-13


 li_cifre_cliente=integer(tab_1.tabpage_2.cifre_cliente.text)
 if li_cifre_cliente<>100 then ls_rag=Left ( ls_rag, li_cifre_cliente )
	
 if li_ant_scad>0 then li_ant_scad=0 - li_ant_scad
 If Not(IsNull(ld_scad)) then ld_scad=RelativeDate(ld_scad, li_ant_scad)


 tab_1.tabpage_5.dw_6.setitem(1, "note1" ,ls_note)
 tab_1.tabpage_5.dw_6.setitem(1, "cliente1" ,ls_rag)
 tab_1.tabpage_5.dw_6.setitem(1, "misura1" ,ld_dim)
 tab_1.tabpage_5.dw_6.setitem(1,"num_doc1" ,ls_num_doc)
 tab_1.tabpage_5.dw_6.setitem(1, "quantita1" ,ld_qta)
 tab_1.tabpage_5.dw_6.setitem(1, "data_doc1" ,ld_doc)
 tab_1.tabpage_5.dw_6.setitem(1, "data_consegna1" ,ld_scad)
 tab_1.tabpage_5.dw_6.setitem(1, "bollo1" ,ls_bollo)
end subroutine

public subroutine wf_carica_foto (long al_riga);integer i, li_larg_ok, li_altezza_ok
long ll_righe, ll_format
string ls_foto, ls_path
boolean lb_exist
//per ora non metto foto dei componenti
ll_righe=tab_1.tabpage_5.dw_6.rowcount()
if ll_righe>0 then
//
//for i = 1 to ll_righe
//	ls_foto=tab_1.tabpage_5.dw_6.getitemstring(i, "foto_comp")
//	p_1.picturename=ls_foto
//	li_larg_ok=p_1.width*132/p_1.height
//	
//	tab_1.tabpage_5.dw_6.modify('p_'+string(i)+'.filename="'+ls_foto+'"')
//	tab_1.tabpage_5.dw_6.modify('p_'+string(i)+'.width='+string(li_larg_ok))
//			
//next
	//ls_foto=tab_1.tabpage_5.dw_6.getitemstring(al_riga, "articolo_immagine")
	//ls_foto=tab_1.tabpage_5.dw_6.getitemstring(1, "articolo_immagine")
	select dir_immagini
	into :ls_path
	from dba.par_sistema;
	if right(ls_path,1)<>"\" then ls_path+="\"
	//ls_foto+=tab_1.tabpage_5.dw_6.getitemstring(al_riga, "articolo_immagine")
	ls_foto=ls_path+tab_1.tabpage_5.dw_6.getitemstring(1, "articolo_immagine")
	lb_exist = FileExists(ls_foto)
	if not lb_exist then ls_foto=ls_path+"no_immagine.jpg"
	p_1.picturename=ls_foto
	if p_1.height>p_1.width then
		ole_imm.object.printsize=6
		//cancello immagine precedente
		ole_imm.object.delimage=true
		//carico imm
		ole_imm.object.loadimage=ls_foto
		//trovo il tipo dell'immagine corrente (jpg)
		ll_format = ole_imm.object.FileType
		//imposto il tipo di file da salvare (recuperato sopra: jpg)
		ole_imm.object.saveformat=ll_format
		//salvo una copia
		ole_imm.object.saveimage=ls_foto+"copia"
		//ruoto
		ole_imm.object.Rotate = 270
		//cancello il file esistente
		FileDelete ( ls_foto )
		//salvo
		ole_imm.object.saveimage=ls_foto
		p_1.picturename=""
		p_1.picturename=ls_foto
	end if	
	
	
	li_larg_ok=p_1.width*468/p_1.height
	li_altezza_ok=468
	if li_larg_ok>3300 then
		li_larg_ok=3280
		li_altezza_ok=p_1.height*3280/p_1.width
	end if
//	tab_1.tabpage_5.dw_6.modify('p_foto_'+string(al_riga)+'.filename="'+ls_foto+'"')
//	tab_1.tabpage_5.dw_6.modify('p_foto_'+string(al_riga)+'.width='+string(li_larg_ok))
//	tab_1.tabpage_5.dw_6.modify('p_foto_'+string(al_riga)+'.height='+string(li_altezza_ok))
	tab_1.tabpage_5.dw_6.modify('p_foto_1.filename="'+ls_foto+'"')
	tab_1.tabpage_5.dw_6.modify('p_foto_1.width='+string(li_larg_ok))
	tab_1.tabpage_5.dw_6.modify('p_foto_1.height='+string(li_altezza_ok))
end if
	
end subroutine

public subroutine wf_setta_disponibili ();integer i
decimal ldc_peso_disp
date ldt_inizio_ese, ldt_fine
long ll_id_art,ll_righe
string ls_bollo
datastore ds_giac_peso

ds_giac_peso=create datastore
ds_giac_peso.dataobject="d_orafo_giacenza_peso_articolo"
ds_giac_peso.settransobject(sqlca)

select data_calc_saldi
into :ldt_inizio_ese
from dba.orafo_par_sistema
;
if isnull(ldt_inizio_ese) then 
	select data_inizio
	into :ldt_inizio_ese
	from dba.esercizio
	where data_inizio<=today()
	and data_fine>=today()
	;
end if
ldt_fine=today()
//for i=1 to tab_1.tabpage_3.dw_righe_gruppo.rowcount()
//	ll_id_art=tab_1.tabpage_3.dw_righe_gruppo.getitemnumber(i, "id_articolo")
//	ls_bollo=tab_1.tabpage_3.dw_righe_gruppo.getitemstring(i, "sigla_prezzo")
//	ll_righe=ds_giac_peso.retrieve(ldt_inizio_ese, ldt_fine, ll_id_art)
//	if ll_righe>0 then
//		ldc_peso_disp=ds_giac_peso.getitemdecimal(1, "c_disponibili")
//		tab_1.tabpage_3.dw_righe_gruppo.setitem(i, "provv_imp_subage", ldc_peso_disp) 
//	end if
//
//next
/* con la seguente calcolo la disponibilità dell'articolo in questione e la scrivo in "provv_imp_subage"
09-09-12
*/


for i=1 to tab_1.tabpage_3.dw_righe_gruppo.rowcount()
	ll_id_art=tab_1.tabpage_3.dw_4.getitemnumber(i, "id_articolo")
	ls_bollo=tab_1.tabpage_3.dw_4.getitemstring(i, "sigla_prezzo")
	if ls_bollo>" " then
		ds_giac_peso.setfilter("c_bollo='"+ls_bollo+"'")
	else
		ds_giac_peso.setfilter("c_bollo=''")
	end if
	ds_giac_peso.filter()
	ll_righe=ds_giac_peso.retrieve(ldt_inizio_ese, ldt_fine, ll_id_art)
	if ll_righe>0 then
		ldc_peso_disp=ds_giac_peso.getitemdecimal(ll_righe, "c_disponibili")
		tab_1.tabpage_3.dw_righe_gruppo.setitem(i, "provv_imp_subage", ldc_peso_disp) 
	end if
	ds_giac_peso.setfilter("")
	ds_giac_peso.filter()
	//con questa sotto calcolo il già odrinato al fonrnitore, che poi aggiungerò alla disponibilità 09-09-12
	wf_storna_ordinato(ll_id_art, ls_bollo, i)
	tab_1.tabpage_1.dw_testa.setfilter("")
	tab_1.tabpage_1.dw_testa.filter()
	
next
destroy ds_giac_peso
end subroutine

public function integer wf_controlla_se_esiste_bollettina ();integer i ,li_return
long ll_id_riga_ordine, ll_num_prog

li_return=1

for i =1 to tab_1.tabpage_2.dw_righe_scelte.rowcount()
	ll_id_riga_ordine=tab_1.tabpage_2.dw_righe_scelte.getitemnumber(i, "riga_documento_id_riga_documento")
	select d.num_progressivo
	into :ll_num_prog
	from dba.riga_documento r, dba.documento d
	where provv_imp_subage_2=:ll_id_riga_ordine
	and d.id_documento=r.id_documento
	;
	if isnull(ll_num_prog) or ll_num_prog=0 then
		li_return=0
		exit
	end if
next
return li_return
end function

public subroutine wf_storna_ordinato (long al_id_art, string as_bollo, long al_riga);//devo trovare eventuali ordini gia ordinati al fornitore per aggiungere le loro qta alla disponibilità
//secondo la richiesta di samy 150612
//ORDINI GIà ORDINATI =segnati come "O"i ordnato fornitore
INTEGER A
date ldt_inizio_calc
long ll_id_ordine, ll_righe
decimal ldc_peso
datastore ds_trova_peso_ordinato

ds_trova_peso_ordinato=create datastore
ds_trova_peso_ordinato.dataobject="d_prod_trova_art_prodotto_ra_gd"
ds_trova_peso_ordinato.SetTransObject(sqlca)

if isnull(as_bollo) or as_bollo<" " then as_bollo="X"
ds_trova_peso_ordinato.setfilter("c_bollo='"+as_bollo+"'")
ds_trova_peso_ordinato.filter()

//inserisco data inizio calcolo 010313
select data_calc_saldi
into :ldt_inizio_calc
from dba.orafo_par_sistema
;
if isnull(ldt_inizio_calc) then 
	select data_inizio
	into :ldt_inizio_calc
	from dba.esercizio
	where data_inizio<=today()
	and data_fine>=today()
	;
end if

ll_righe=ds_trova_peso_ordinato.retrieve(al_id_art, ldt_inizio_calc)

//ora trovo il peso già ordinato ...
if ll_righe>0 then
	ldc_peso+=ds_trova_peso_ordinato.getitemdecimal(ll_righe, "c_somma_peso")
end if
if ldc_peso>0 then
	tab_1.tabpage_3.dw_righe_gruppo.setitem(al_riga, "cmc", ldc_peso)
	ldc_peso=0
end if

destroy ds_trova_peso_ordinato

end subroutine

public function long wf_stampa_cod_barre_bollettina (long al_riga, long al_id_riga_ordine);string ls_cod_barre, ls_num_prog, ls_stato
string ls_fornitore, ls_codice_ok, ls_codice, ls_check
long ll_num_prog, ll_riga_inserita
date ldt_data_doc


select d.num_progressivo, d.data_documento
into :ll_num_prog, :ldt_data_doc
from dba.riga_documento r, dba.documento d
where r.provv_imp_subage_2=:al_id_riga_ordine
and d.id_documento=r.id_documento
;


if ll_num_prog > 0 then
	//inserisco il num bolletina nella dw di controllo
	ll_riga_inserita=tab_1.tabpage_5.dw_7.insertrow(0)
	tab_1.tabpage_5.dw_7.setitem(ll_riga_inserita, "bollettina", ll_num_prog)
	//fine inserimento controllo
	ls_num_prog=string(ll_num_prog)
	ls_stato='80'
	
	ls_fornitore="0"+string(year(ldt_data_doc))
	
	do while len(ls_num_prog)<5 
		ls_num_prog="0"+ls_num_prog
	loop
	
	ls_codice= ls_stato+ls_fornitore+ls_num_prog
	ls_check=string(f_check_digit(ls_codice, 13))
	
	ls_codice+= ls_check
	ls_codice_ok=f_crea_codice_a_barre(ls_codice)
	tab_1.tabpage_5.dw_6.modify('t_cod_barre.text="'+ls_codice_ok+'"')
else
	messagebox("Attenzione!", "Bollettina (VBOL) agganciata con provv_subage_2= "+string(al_id_riga_ordine)+" NON trovata!!!")
end if
return ll_num_prog

end function

public subroutine wf_controlla_distinta (long al_id_art);//21-01-13 inserito controllo sull'esistenza della distinta dell'articolo da lavorare 

integer li_righe_distinta
string ls_codice

select count(*)
into :li_righe_distinta
from distinta d, riga_distinta r
where d.id_distinta=r.id_distinta
and d.id_articolo=:al_id_art
;
if li_righe_distinta<=0 or isnull(li_righe_distinta) then
	select codice
	into :ls_codice
	from dba.articolo
	where id_articolo=:al_id_art
	;
	messagebox("Attenzione!", "L'articolo: "+ls_codice+" NON ha distinta o NON ha RIGHE distinta!"+&
	"La scheda lavorazione NON sarà stampata!")
end if


end subroutine

