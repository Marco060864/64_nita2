tab_1.tabpage_2.dw_righe_scelte.Filter()
//samy richiede di dividere anche per cliente dell'ordine (id_destinazione o id_sog-commericiale)

ll_row=tab_1.tabpage_2.dw_righe_scelte.rowcount()
if ll_row=0 then 
	
   
	k=1
else	
//ci sono righe documento con articoli ordinabili direttamente al fornitore (NO produzione interna)	
	for i=1 to ll_row
		ls_ordinato=tab_1.tabpage_2.dw_righe_scelte.getitemstring(i,"ordinato")
		ll_appoggio=tab_1.tabpage_2.dw_righe_scelte.getitemnumber(i,"id_articolo")
		//130612 gestione bollo riga 
		//ls_bollo=tab_1.tabpage_2.dw_righe_scelte.getitemstring(i,"bollo1")
		ls_bollo=tab_1.tabpage_2.dw_righe_scelte.getitemstring(i,"riga_documento_sigla_prezzo")
		if isnull(ls_bollo) then ls_bollo=""
		//fine 130612
		//180612gestione destinazione-cliente ordinante
				
		dw_righe_gruppo.insertrow(i)
		//aggiunto flag già ordinato a fornitore 08-10-12
		dw_righe_gruppo.setitem(i,"ordinato_fo",ls_ordinato)
		dw_righe_gruppo.setitem(i,"id_articolo",ll_appoggio)
		ll_appoggio=tab_1.tabpage_2.dw_righe_scelte.getitemnumber(i,"riga_documento_id_riga_documento")
		dw_righe_gruppo.setitem(i,"id_riga_documento",ll_appoggio)
				ll_appoggio=tab_1.tabpage_2.dw_righe_scelte.getitemnumber(i,"riga_documento_id_documento")
				dw_righe_gruppo.setitem(i,"id_documento",ll_appoggio)
				
