long picturemaskcolor = 536870912
dw_7 dw_7
pb_1 pb_1
pb_stampa pb_stampa
dw_6 dw_6
end type

on tabpage_5.create
this.dw_7=create dw_7
this.pb_1=create pb_1
this.pb_stampa=create pb_stampa
this.dw_6=create dw_6
this.Control[]={this.dw_7,&
this.pb_1,&
this.pb_stampa,&
this.dw_6}
end on

on tabpage_5.destroy
destroy(this.dw_7)
destroy(this.pb_1)
destroy(this.pb_stampa)
destroy(this.dw_6)
end on

