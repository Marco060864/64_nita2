event clicked;
datastore ds_esplose
s_list_main ls_dati
long ll_group, ll_next_group, ll_riga, ll_num_righe, i, ll_id_sog_com, j, k, ll_row
long ll_ret, ll_id_riga_doc, a, ll_id_bollettina
string ls_fornitore,ls_fornitore_old
w_orafo_documento_ordine_cx lw_doc
string ls_codice, ls_prod, ls_gia_ordinato
date ld_data_scad
integer li_ant_scad, li_conta=0
decimal ldc_test_qta

ll_riga=tab_1.tabpage_3.dw_righe_gruppo.RowCount()
for i= 1 to ll_riga
	ll_id_sog_com=tab_1.tabpage_3.dw_righe_gruppo.getItemNumber(i,"id_sog_commerciale")
	if IsNull(ll_id_sog_com) then
		messagebox('Attenzione!','Non è specificato nessun fornitore per la riga '+string(i)+'!'+char(13)+'Impossibile procedere!')
		
		dw_righe_gruppo.SelectRow ( 0, false )
		
		dw_righe_gruppo.SelectRow ( i, true )
		dw_righe_gruppo.setrow(i)
		return
	end if
next

ds_esplose = create datastore
ds_esplose.Dataobject="d_orafo_ordini_riga_documento_gorup_gd"
ds_esplose.SetTransObject(sqlca)
ll_num_righe=1
if ll_riga>0 then
		
	tab_1.tabpage_3.dw_righe_gruppo.groupcalc()
	
	Do
		ll_group=tab_1.tabpage_3.dw_righe_gruppo.FindGroupChange(ll_num_righe,1)
	
		
		if ll_group>0 then
			ll_next_group=tab_1.tabpage_3.dw_righe_gruppo.FindGroupChange(ll_group+1,1)
			if ll_next_group>0 then
				ll_riga=ll_next_group - 1
			else
				ll_riga=tab_1.tabpage_3.dw_righe_gruppo.RowCount()
			end if
			if not(isvalid(ds_esplose)) then
				ds_esplose = create datastore
				ds_esplose.Dataobject="d_orafo_ordini_riga_documento_gorup_gd"
				ds_esplose.SetTransObject(sqlca)
			else
	
			end if
			ds_esplose.Reset()
			
			for i= ll_riga to ll_group step -1
				ls_gia_ordinato=tab_1.tabpage_3.dw_righe_gruppo.getitemstring(i, "ordinato_fo")
				if ls_gia_ordinato='S' then continue //se è già stato ordinato non faccio nulla 08-10-12
				//qui copio le righe per creare l'ordine Ds_esplose sarà ricopiata in ds_righe_ordine
				//però se la disponibilità è >=0 non devo creare la riga 
				ldc_test_qta=tab_1.tabpage_3.dw_righe_gruppo.getitemdecimal(i, "quantita")
				//tab_1.tabpage_3.dw_righe_gruppo.getitemdecimal(i, "provv_imp_subage") //QUESTA è LA DISPONBILITà
				if ldc_test_qta>0 then
					ll_ret=tab_1.tabpage_3.dw_righe_gruppo.RowsCopy(i,i,Primary!,ds_esplose,1,Primary!)
					if ll_ret<>1 then Messagebox("Errore!", "Righe non copiate! Riga: "+string(i))
					//devo mettere il valore di "provv_imp_subage" sul "peso_netto" e azzerarlo in "provv_imp_subage"
//					ds_esplose.setitem(1, "riga_documento_peso_netto", ldc_test_qta* -1)
					ds_esplose.setitem(1, "provv_imp_subage", 0)
					//la qta va a 0 (si ordina per peso)
//					ds_esplose.setitem(1, "quantita", 0)
					tab_1.tabpage_3.dw_righe_gruppo.setitem(i, "ordinato_fo", 'O')
					
				end if
			next
			//se non ci sono righe non creo l'ordine ... 08-10-12
			if ds_esplose.rowcount()>0 then
				if not(isValid(ls_dati.ds_righe_ordine)) then
					ls_dati.ds_righe_ordine = create datastore
					ls_dati.ds_righe_ordine.Dataobject="d_orafo_ordini_riga_documento_gorup_gd"
					ls_dati.ds_righe_ordine.SetTransObject(sqlca)
				else
		
				end if
				
				
				ls_dati.ds_righe_ordine = ds_esplose
				ll_id_sog_com=tab_1.tabpage_3.dw_righe_gruppo.GetItemNumber(ll_group,"id_sog_commerciale")
				ls_prod=tab_1.tabpage_3.dw_righe_gruppo.GetItemString(ll_group,"rag_soc_1")
				
				if ls_prod<>'produzione interna' then
					select codice
					into :ls_dati.s_aux[1]
					from sog_commerciale_gen
					where id_sog_commerciale=:ll_id_sog_com;
					ls_dati.s_aux[2]=tab_1.tabpage_3.dw_righe_gruppo.GetItemString(ll_group,"rag_soc_1")
					ls_dati.s_aux[3]=string(ll_id_sog_com)
					ls_dati.s_aux[4]=''
					ls_dati.s_aux[5]=''
					ld_data_scad=wf_riempi_clienti(is_ordine,ls_dati.s_aux[4],ds_esplose)
					li_ant_scad=integer(tab_1.tabpage_2.em_ant_scad_ordine_fo.text)
					if li_ant_scad>0 then li_ant_scad=0 - li_ant_scad
					If Not(IsNull(ld_data_scad)) then 
						ld_data_scad=RelativeDate(ld_data_scad, li_ant_scad)
						ls_dati.s_aux[5]=string(ld_data_scad,"dd/mm/yyyy")
					end if
					
					ll_ret=openwithparm(lw_doc, ls_dati, "w_orafo_documento_ordine_cx")
			
					ll_ret=Message.DoubleParm
					
					if ll_ret>0 then
						//DA CAPIRE COSA FACESSE ... 08-10-12
//						ll_riga=(ll_riga - ll_group)+1	
//						for i= 1 to ll_riga
//							
//							ls_codice=ds_esplose.GetItemString(i,"c_articolo_cod")
//							
//							for j=1 to UpperBound(is_ordine)
//								for k=1 to Upperbound(is_ordine[j].cod_figlio)
//									if is_ordine[j].cod_figlio[k]=ls_codice then
//										is_ordine[j].ordinato='S'
//									end if
//								next
//							next
//						next
						ll_riga=tab_1.tabpage_2.dw_righe_scelte.Rowcount()
						
						for i=1 to ll_riga
							//è giusto: si controlla che tutte le righe esplose da quella scelta siano andate nell'ordine al fornitore
							//ma è troppo complesso: se la riga è stata scelta allora è andata nell'ordine al fonritore ....08-10-12
	//						ls_codice=tab_1.tabpage_2.dw_righe_scelte.GetItemString(i,"articolo_codice")
	//						for k =1 to UpperBound(is_ordine)
	//							if (is_ordine[k].cod_padre=ls_codice)and(is_ordine[k].ordinato='S') then
	//								tab_1.tabpage_2.dw_righe_scelte.SetItem(i,"ordinato",'S')
									ll_id_riga_doc=tab_1.tabpage_2.dw_righe_scelte.getItemNumber(i,"riga_documento_id_riga_documento")
									
									update riga_documento
									set ordinato_fo='O'
									where id_riga_documento= :ll_id_riga_doc;
									if sqlca.sqlnrows<1 then 
										messagebox('Errore','Impossibile accedere al DataBase!')
										rollback;
										return
									else
										commit;
										//DEVO SEGNARE ANCHE LA BOLLETTINA GENERATA DALLA RIGA ORDINE (1 RIGA ORDINE= 1 BOLLETTINA)
										select id_documento
										into :ll_id_bollettina
										from dba.riga_documento
										where provv_imp_subage_2=:ll_id_riga_doc
										;
																				
										UPDATE riga_documento
										set ordinato_fo='O'
										where id_documento=:ll_id_bollettina
										;
										if sqlca.sqlnrows<1 then 
											messagebox('Errore','Bollettina non segnata Ordinata ("O")!')
											rollback;
											return
										else
											commit;
										end if
										
									end if
								//end if
							//next
						next
					end if
				end if
			end if
		end if
		ll_num_righe=ll_group+1
	Loop Until ll_group=0
end if

destroy ds_esplose
destroy ls_dati.ds_righe_ordine






end event

