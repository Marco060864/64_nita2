			where id_articolo=:ll_id_art_variato and unita_base='S';
			
			ld_appoggio=tab_1.tabpage_2.dw_righe_esplose.getitemdecimal(i,"tot_peso_comp")
			ld_dim=tab_1.tabpage_2.dw_righe_esplose.getitemdecimal(i,"misura15")
			
			dw_4.setitem(a,"riga_documento_dim_l",ld_dim)
			dw_4.setitem(a,"riga_documento_peso_netto",ld_appoggio)
			dw_4.setitem(a,"riga_documento_id_unita_confezione",ll_un_conf)

			
			ll_appoggio=tab_1.tabpage_2.dw_righe_esplose.getitemnumber(i,"riga_documento_id_tab_iva")
