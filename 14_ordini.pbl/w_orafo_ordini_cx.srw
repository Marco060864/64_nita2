				dw_righe_gruppo.setitem(i,"calo",ld_appoggio)
				ld_appoggio=tab_1.tabpage_2.dw_righe_scelte.getitemdecimal(i,"riga_documento_fino")
				dw_righe_gruppo.setitem(i,"fino",ld_appoggio)
				ld_appoggio=tab_1.tabpage_2.dw_righe_scelte.getitemdecimal(i,"riga_documento_coef_calo")
				dw_righe_gruppo.setitem(i,"coef_calo",ld_appoggio)
