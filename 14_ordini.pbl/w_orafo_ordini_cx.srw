type cb_applica_ricarico from commandbutton within tabpage_3
integer x = 3401
integer y = 1804
integer width = 448
integer height = 84
integer taborder = 40
integer textsize = -8
integer weight = 400
fontpitch fontpitch = variable!
fontfamily fontfamily = swiss!
string facename = "Arial"
boolean enabled = false
string text = "Applica Ricarico"
end type

event clicked;long  ll_num_righe, i
decimal ldc_ricarico
string ls_ricarico
decimal ld_qta, ld_unita, ld_app, ld_ricarico
boolean ib_select



if cbx_imposta_ricarico.Checked then
	ls_ricarico=em_ricarico_perc.text
	if ls_ricarico>'' then
		ldc_ricarico=dec(ls_ricarico)
		ll_num_righe=tab_1.tabpage_3.dw_righe_gruppo.RowCount()
		for i= 1 to ll_num_righe
			ib_select=tab_1.tabpage_3.dw_righe_gruppo.isSelected(i)
			if ib_select=true then
				ld_qta=tab_1.tabpage_3.dw_righe_gruppo.GetItemDecimal(i,"quantita")
				ld_qta=ld_qta+((ld_qta/100)*ldc_ricarico)
				tab_1.tabpage_3.dw_righe_gruppo.SetItem(i,"quantita",ld_qta)
	
				ld_qta=tab_1.tabpage_3.dw_righe_gruppo.getitemdecimal(i,"prezzo")			
				ld_qta=ld_qta+((ld_qta/100)*ldc_ricarico)
				tab_1.tabpage_3.dw_righe_gruppo.SetItem(i,"prezzo",ld_qta)
	
				ld_qta=tab_1.tabpage_3.dw_righe_gruppo.getitemdecimal(i,"riga_documento_peso_netto")			
				ld_qta=ld_qta+((ld_qta/100)*ldc_ricarico)
				tab_1.tabpage_3.dw_righe_gruppo.SetItem(i,"riga_documento_peso_netto",ld_qta)
			end if
		next		
	else
		
		em_ricarico_perc.text=''
		ls_ricarico=sle_ricarico_pezzi.Text
		if ls_ricarico>'' then
			ldc_ricarico=dec(ls_ricarico)
			ll_num_righe=tab_1.tabpage_3.dw_righe_gruppo.RowCount()
			
			for i= 1 to ll_num_righe
			
				ib_select=tab_1.tabpage_3.dw_righe_gruppo.isSelected(i)
				if ib_select=true then
					ld_qta=tab_1.tabpage_3.dw_righe_gruppo.GetItemDecimal(i,"quantita")
					ld_app=tab_1.tabpage_3.dw_righe_gruppo.getitemdecimal(i,"prezzo")
	
					
					ld_unita=ld_app/ld_qta
					ld_ricarico=ld_unita*ldc_ricarico
					tab_1.tabpage_3.dw_righe_gruppo.SetItem(i,"prezzo",ld_app+ld_ricarico)
					ld_app=tab_1.tabpage_3.dw_righe_gruppo.getitemdecimal(i,"riga_documento_peso_netto")
	
					
					ld_unita=ld_app/ld_qta
					ld_ricarico=ld_unita*ldc_ricarico
					tab_1.tabpage_3.dw_righe_gruppo.SetItem(i,"riga_documento_peso_netto",ld_app+ld_ricarico)
					ld_qta=tab_1.tabpage_3.dw_righe_gruppo.GetItemDecimal(i,"quantita")
					tab_1.tabpage_3.dw_righe_gruppo.SetItem(i,"quantita",ld_qta+ldc_ricarico)
				end if	
					
				
			next
		end if
	end if
end if
end event

