public function string wf_multisel (long row, datawindow adw_origine, string as_col_origine, datawindow adw_dest, string as_col_dest, string as_filtro_agg);long i, ll_righe, ll_row
string ls_filter,ls_sql, ls_val_filter
boolean lb_filter

if as_filtro_agg<>"" then
	ls_filter=as_filtro_agg+" and ("
else
	ls_filter="("
end if
lb_filter=(as_col_origine<>"")and(as_col_dest<>"")
if NOT(KeyDown(KeyShift!))And NOT(KeyDown(KeyControl!)) then
	ll_righe=adw_origine.RowCount()
	ll_row=row
	
	for i = 1 to ll_righe
		if i=ll_row then continue
		if adw_origine.IsSelected(i) then adw_origine.SelectRow(i,false)
	next
	
	adw_origine.SelectRow(ll_row, not (adw_origine.isselected(ll_row)))
	if adw_origine=tab_1.tabpage_1.dw_testa then
		if adw_origine.isselected(ll_row) then 
			lb_filter=true 
		else 
			lb_filter=false	
		end if
	else
		lb_filter=false
	end if
	if lb_filter then
		ls_val_filter=string(adw_origine.GetItemNumber(ll_row,as_col_origine))
	 	ls_filter = ls_filter + as_col_dest+' ='+ls_val_filter+' or '
	end if
elseif KeyDown(KeyShift!) then
		ll_row=row
		adw_origine.SelectRow(ll_row,true)
		ll_righe=adw_origine.RowCount()
		ll_row=ll_righe
		
		for i= 1 to ll_row
			if adw_origine.IsSelected(i) then ll_row=i
		next
		
		for i=ll_row+1 to ll_righe
			if adw_origine.IsSelected(i) then ll_righe=i
		next
		
		for i = ll_row to ll_righe
			adw_origine.SelectRow(i,true)
			if lb_filter then ls_filter = ls_filter + as_col_dest+'='+string(adw_origine.GetItemNumber(i,as_col_origine))+' or '					
		next
	elseif KeyDown(KeyControl!) then
		
		ll_row=row
		adw_origine.SelectRow(ll_row,Not adw_origine.IsSelected(ll_row))
		
		ll_righe=adw_origine.RowCount()
		for i = 1 to ll_righe
			if adw_origine.IsSelected(i) then
				if lb_filter then ls_filter = ls_filter + as_col_dest+'='+string(adw_origine.GetItemNumber(i,as_col_origine))+' or '	
			end if
		next
end if
if lb_filter AND Len(ls_filter)>2 THEN
	ls_filter=Left(ls_filter,Len(ls_filter) - 3)+")"
	
	
	ls_sql=is_sql
	
	ls_sql=ls_sql+" and "+ls_filter
	adw_dest.Setsqlselect(ls_sql)
	adw_dest.Retrieve()
	return ls_filter
else
	if adw_origine=tab_1.tabpage_1.dw_testa then
		adw_dest.reset()
	end if
	return ""
end if

	

end function

public function date wf_riempi_clienti (s_ordine as_ordine[], ref string as_note, datastore ad_righe);long ll_riga, i, j, k, n, m, ll_id_sog_com,  ll_id_doc, ll_id_doc_visti
integer li_num_clienti
string ls_figlio, ls_codice, ls_bollo, ls_temp, ls_num_prog, ls_prod_finito
date ld_data_scad, ld_data_doc, ld_data_scad_min
boolean lb_salta
decimal{2} ld_qta

ll_riga=ad_righe.RowCount()
li_num_clienti=0
ls_temp=''
ll_id_doc_visti=0
SetNull(ld_data_scad_min)
for i= 1 to ll_riga
     ll_id_doc=ad_righe.GetItemNumber(i,"id_documento")
	  
	  
	 if ll_id_doc<>ll_id_doc_visti then
	      ll_id_doc_visti=ll_id_doc
		select id_sog_commerciale, num_documento, data_documento, data_prev_consegna, bollo
		into :ll_id_sog_com, :ls_num_prog, :ld_data_doc, :ld_data_scad, :ls_bollo
		from documento
		where documento.id_documento=:ll_id_doc;
		select codice
		into :ls_codice
		from sog_commerciale
		where sog_commerciale.id_sog_commerciale=:ll_id_sog_com;
		if Not(IsNull(ld_data_scad)) then
			if (li_num_clienti=1)or(IsNull(ld_data_scad_min)) then
					ld_data_scad_min=ld_data_scad
			elseif (ld_data_scad<ld_data_scad_min) then
				ld_data_scad_min=ld_data_scad
			end if
		end if
		ls_temp=ls_temp+ls_codice+'- Ord. n°'+ls_num_prog+' - '+&
				+string(ld_data_doc,"dd/mm/yyyy")+', '
		
		ls_prod_finito=ad_righe.GetItemstring(i,"sigla_prezzo")
		if ls_bollo>"" and ls_prod_finito="F" then
			ls_temp=Left(ls_temp,Len(ls_temp)-2)	
			ls_temp=ls_temp+'~r~n Bollo: '+ls_bollo+'~r~n '
		else
			ls_temp=ls_temp+'~r~n '
		end if
	end if

next
ls_temp=Left(ls_temp,Len(ls_temp)-2)	
as_note=ls_temp
return ld_data_scad_min

end function

public function datastore wf_crea_parm_lavorazione (string as_nome_ds, ref s_ordine as_ordine[]);long i, j, ll_riga, n, ll_ret
integer li_upper
string ls_cli, ls_ord, ls_bolli
date ld_data_scad
datastore ds_parm

for i=1 to UpperBound(as_ordine)-1
	for j=i+1 to UpperBound(as_ordine)
		if as_ordine[i].cod_padre=as_ordine[j].cod_padre then
			as_ordine[i].quantita=as_ordine[i].quantita+as_ordine[j].quantita
			as_ordine[i].peso_num=as_ordine[i].peso_num+as_ordine[j].peso_num
			as_ordine[i].misura_num=as_ordine[i].misura_num+as_ordine[j].misura_num
			
			
			
			
			
			ll_riga=UpperBound(as_ordine[j].cod_figlio)
			for n=1 to ll_riga
				SetNull(as_ordine[j].prod_interna_figlio[n])
			next
		end if
	next
next

for i=1 to UpperBound(as_ordine)
	as_ordine[i].passato=false
	for j=1 to UpperBound(as_ordine[i].prod_interna_figlio)
		if Not(IsNull(as_ordine[i].cod_padre)) and(as_ordine[i].prod_interna_figlio[j]='S' or as_ordine[i].prod_interna_figlio[j]='Y') then 
			
			if as_ordine[i].prod_interna_figlio[j]='Y' then 
				as_ordine[i].passato=true
			else
					
					ll_ret=tab_1.tabpage_3.dw_righe_gruppo.find("c_articolo_cod= '"+as_ordine[i].cod_padre+"' and rag_soc_1='produzione interna'",1,tab_1.tabpage_3.dw_righe_gruppo.rowcount())
				
				if (ll_ret > 0)and not IsNull(ll_ret) then as_ordine[i].passato=true
			end if
		end if
	next
next



ds_parm = create datastore
ds_parm.DataObject=as_nome_ds
for i=1 to UpperBound(as_ordine)
	if as_ordine[i].passato then
		
		
		
		
		
		li_upper=UpperBound(as_ordine[i].id_figlio)
		if as_ordine[i].prod_interna_figlio[li_upper]='Y' then
			
			li_upper --
		elseif as_ordine[i].prod_interna_figlio[li_upper]='X' then
			
			li_upper --
		end if
		for j=1 to li_upper
			ll_riga=ds_parm.InsertRow(0)
			ds_parm.SetItem(ll_riga,"id_padre",as_ordine[i].id_padre)
			ds_parm.SetItem(ll_riga,"cod_padre",as_ordine[i].cod_padre)
			ds_parm.SetItem(ll_riga,"quantita",as_ordine[i].quantita)
			ds_parm.SetItem(ll_riga,"peso",as_ordine[i].peso_num)
			ds_parm.SetItem(ll_riga,"misura",as_ordine[i].misura_num)
			ds_parm.SetItem(ll_riga,"riga",as_ordine[i].riga)
			ds_parm.SetItem(ll_riga,"note",'')
			ds_parm.SetItem(ll_riga,"ordinato",as_ordine[i].ordinato)		
			ds_parm.SetItem(ll_riga,"id_figlio",as_ordine[i].id_figlio[j])
	
				ds_parm.SetItem(ll_riga,"cod_figlio",as_ordine[i].cod_figlio[j])
	
			
			
			
			
			decimal ld_qta1
			select quantita
			into :ld_qta1
			from riga_distinta r, distinta d
			where d.id_articolo=	:as_ordine[i].id_padre
			and r.id_distinta=d.id_distinta
			and r.id_articolo=:as_ordine[i].id_figlio[j];
			ds_parm.SetItem(ll_riga,"qta_figlio",ld_qta1)
			
			ds_parm.SetItem(ll_riga,"des_figlio",as_ordine[i].des_figlio[j])
			ds_parm.SetItem(ll_riga,"u_peso",as_ordine[i].u_peso)
			ds_parm.SetItem(ll_riga,"u_misura",as_ordine[i].u_misura)
			if upperbound(as_ordine[i].varie_figlio) >= j then
				ds_parm.SetItem(ll_riga,"varie",as_ordine[i].varie_figlio[j])
			end if
			if upperbound(as_ordine[i].riga_figlio) >= j then
				ds_parm.SetItem(ll_riga,"riga_figlio",as_ordine[i].riga_figlio[j])
			end if
			
			
			ld_data_scad=wf_riempi_clienti_lav(as_ordine[i].cod_padre,ls_cli, ls_ord, ls_bolli)
			ds_parm.SetItem(ll_riga,"clienti",ls_cli)
			ls_cli=''
			ds_parm.SetItem(ll_riga,"ordini",ls_ord)
			ls_ord=''
			
			
			
			ds_parm.SetItem(ll_riga,"bolli",ls_bolli)
			ls_bolli=''
			ds_parm.SetItem(ll_riga,"data_scad",ld_data_scad)
			SetNull(ld_data_scad)
		next
	end if
next

return ds_parm
end function

public function date wf_riempi_clienti_lav (string as_codice_figlio, ref string as_clienti, ref string as_ordini, ref string as_vari);long ll_riga, i, j, k, n, ll_id_sog_com,  ll_id_doc, ll_id_doc_visti[]
integer li_num_clienti
string ls_figlio, ls_codice, ls_bollo, ls_temp, ls_note, ls_campo_cliente, ls_num_prog
date ld_data_scad, ld_data_doc, ld_data_scad_min
boolean lb_salta
decimal{2} ld_qta



li_num_clienti=0
ls_temp=''
SetNull(ld_data_scad_min)
for j=1 to UpperBound(is_ordine)
		lb_salta=false
		
		
				for n=1 to tab_1.tabpage_1.dw_righe_testa.RowCount()
					ls_codice=tab_1.tabpage_1.dw_righe_testa.GetItemString(n,"articolo_codice")
					
     				if ls_codice=as_codice_figlio then	
						ll_id_doc=tab_1.tabpage_1.dw_righe_testa.GetItemNumber(n,"riga_documento_id_documento")
						
						if li_num_clienti>0 then
							lb_salta=false
							for i=1 to UpperBound(ll_id_doc_visti)
								if ll_id_doc_visti[i]=ll_id_doc then 
									lb_salta=true
									exit
								end if
							next
						end if
						if Not(lb_salta) then	
							li_num_clienti ++
							ll_id_doc_visti[li_num_clienti]=ll_id_doc
							ld_qta=tab_1.tabpage_1.dw_righe_testa.GetItemDecimal(n,"riga_documento_quantita")
							ls_note=tab_1.tabpage_1.dw_righe_testa.GetItemString(n,"riga_documento_descrizione")
							lb_salta=false
							
							select id_sog_commerciale, num_documento, data_documento, data_prev_consegna, bollo
							into :ll_id_sog_com, :ls_num_prog, :ld_data_doc, :ld_data_scad, :ls_bollo
							from documento
							where documento.id_documento=:ll_id_doc;
							select codice
							into :ls_codice
							from sog_commerciale_gen
							where sog_commerciale_gen.id_sog_commerciale=:ll_id_sog_com;
							as_vari=as_vari+ls_codice+'|'
							select rag_soc_1
							into :ls_codice
							from sog_commerciale_gen
							where sog_commerciale_gen.id_sog_commerciale=:ll_id_sog_com;
							as_vari=as_vari+ls_codice+'-'
							if Not(IsNull(ld_data_scad)) then
								if (li_num_clienti=1)or(IsNull(ld_data_scad_min)) then
										ld_data_scad_min=ld_data_scad
								elseif (ld_data_scad<ld_data_scad_min) then
									ld_data_scad_min=ld_data_scad
								end if
							end if
							
							if Not(IsNull(ls_codice)) then as_clienti=as_clienti+',Pz. '+string(int(ld_qta))
							if Not(IsNull(ls_num_prog))and Not(IsNull(ld_data_doc)) then as_clienti=as_clienti+',n°'+ls_num_prog+','+&
																									+string(ld_data_doc,"dd/mm")
							if Not(IsNull(ls_bollo)) then as_clienti=as_clienti+','+ls_bollo
							as_clienti=as_clienti+' - '
							if Not(IsNull(ls_note)) then as_ordini=as_ordini+ls_codice+': '+ls_note+' - '
						end if
			
			
		end if
	next
next
as_clienti=Left(as_clienti,Len(as_clienti)-3)		
as_ordini=Left(as_ordini,Len(as_ordini)-3)		

return ld_data_scad_min

end function

public function integer wf_controlla_singolo_ordine ();if  tab_1.tabpage_2.cbx_singola_st.checked=true then 
	if tab_1.tabpage_1.dw_testa.getselectedrow(tab_1.tabpage_1.dw_testa.getselectedrow(0))>0 then
	  	messagebox('Information','Questa modalità è attiva solo se viene~r~selezionato un solo ordine',Information!)
	  	tab_1.tabpage_2.cbx_singola_st.checked=false
	  	return 0
	end if
end if
return 1
	
end function

public subroutine wf_setta_cast (integer riga, integer num_cast, integer set_riga, datastore ds_cast, boolean test1, boolean test2); decimal ld_qta, ld_dim, ld_peso
 string ls_note, ls_num_doc, ls_rag,ls_bollo, a,b,c,d,e,f,g,h
 long ll_cifre_cliente, ll_unita_conf
 date ld_doc, ld_scad
 integer li_ant_scad
 
 
 li_ant_scad=integer(tab_1.tabpage_2.em_ant_scad_ordine_fo.text)

 
 



 
 ls_note=tab_1.tabpage_2.dw_righe_esplose.getitemstring(set_riga, "riga_documento_descrizione")
 if tab_1.tabpage_2.rb_cod.checked=true then
	ls_rag=tab_1.tabpage_2.dw_righe_esplose.getitemstring(set_riga, "sog_codice")
 else	
   ls_rag=tab_1.tabpage_2.dw_righe_esplose.getitemstring(set_riga, "sog_commerciale_gen_rag_soc_1")
 end if 	
 ld_dim=tab_1.tabpage_2.dw_righe_esplose.getitemdecimal(set_riga, "riga_documento_dim_l")
 ls_num_doc=tab_1.tabpage_2.dw_righe_esplose.getitemstring(set_riga, "documento_num_documento")
 ld_qta=tab_1.tabpage_2.dw_righe_esplose.getitemdecimal(set_riga, "riga_documento_quantita")
 ld_doc=tab_1.tabpage_2.dw_righe_esplose.getitemdate(set_riga, "documento_data_documento")
 ld_scad=tab_1.tabpage_2.dw_righe_esplose.getitemdate(set_riga, "documento_data_scadenza")
 ls_bollo=tab_1.tabpage_2.dw_righe_esplose.getitemstring(set_riga, "bollo")

	


 ll_cifre_cliente=integer(tab_1.tabpage_2.cifre_cliente.text)
 if ll_cifre_cliente<>100 then ls_rag=Left ( ls_rag, ll_cifre_cliente )
	
 if li_ant_scad>0 then li_ant_scad=0 - li_ant_scad
 If Not(IsNull(ld_scad)) then ld_scad=RelativeDate(ld_scad, li_ant_scad)

 
 
 a='cliente'+string(num_cast)
 b='num_doc'+string(num_cast)
 c='data_doc'+string(num_cast)
 d='quantita'+string(num_cast)
 e='misura'+string(num_cast)
 f='data_consegna'+string(num_cast)
 g='note'+string(num_cast)
 h='bollo'+string(num_cast)
 
 
 

 
 ds_cast.setitem(riga, g ,ls_note)
 ds_cast.setitem(riga, a ,ls_rag)
 ds_cast.setitem(riga, e ,ld_dim)
 ds_cast.setitem(riga, b ,ls_num_doc)
 ds_cast.setitem(riga, d ,ld_qta)
 ds_cast.setitem(riga, c ,ld_doc)
 ds_cast.setitem(riga, f ,ld_scad)
 ds_cast.setitem(riga, h ,ls_bollo)
 

end subroutine

public subroutine wf_riempi_produzione (ref datastore ds_righe, integer li_righe);long ll_appoggio, ll_conto_pred, ll_id_doc, ll_riga_inserita
decimal ld_qta1, ld_appoggio, ldc_test_qta
integer i
string ls_appoggio

select id_conto_predefinito
into :ll_conto_pred
from par_sistema;

for i= 1 to li_righe
	//qui copio le righe per creare l'ordine Ds_esplose sarà ricopiata in ds_righe_ordine
	//però se la qta è <=0 non devo creare la riga (ordinerei qta=0!)
	ldc_test_qta=tab_1.tabpage_3.dw_righe_gruppo.getitemdecimal(i, "quantita")
	if ldc_test_qta>0 then
		ll_riga_inserita=ds_righe.insertrow(0)
		ll_appoggio=tab_1.tabpage_3.dw_righe_gruppo.getitemnumber(i,"id_riga_documento")
		//ll_appoggio=tab_1.tabpage_2.dw_righe_scelte.getitemnumber(i,"riga_documento_id_riga_documento")
		ds_righe.setitem(ll_riga_inserita,"id_riga_documento",ll_appoggio)
		ll_id_doc=tab_1.tabpage_3.dw_righe_gruppo.getitemnumber(i,"id_documento")
		
		//ll_appoggio=tab_1.tabpage_2.dw_righe_scelte.getitemnumber(i,"riga_documento_id_documento")
		ds_righe.setitem(ll_riga_inserita,"id_documento",ll_appoggio)
		ds_righe.setitem(ll_riga_inserita,"riga_documento_id_conto",ll_conto_pred)
		ld_qta1=tab_1.tabpage_3.dw_righe_gruppo.getitemdecimal(i,"quantita")	
	//	ld_qta1=tab_1.tabpage_2.dw_righe_scelte.getitemdecimal(i,"quantita")			
		ds_righe.setitem(ll_riga_inserita,"quantita",ld_qta1)
		ll_appoggio=tab_1.tabpage_3.dw_righe_gruppo.getitemnumber(i,"id_sog_commerciale")
		//ll_appoggio=tab_1.tabpage_2.dw_righe_scelte.getitemnumber(i,"articolo_id_sog_commerciale")
		ds_righe.setitem(ll_riga_inserita,"id_sog_commerciale",ll_appoggio)
		select rag_soc_1
		into :ls_appoggio
		from sog_commerciale_gen s, documento d
		where id_documento=:ll_id_doc
		and s.id_sog_commerciale = d.id_sog_commerciale;
		//	ls_appoggio=tab_1.tabpage_2.dw_righe_scelte.getitemstring(i,"sog_commerciale_gen_rag_soc_1")	
		ds_righe.setitem(ll_riga_inserita,"rag_soc_1",ls_appoggio)
		ls_appoggio=tab_1.tabpage_3.dw_righe_gruppo.getitemstring(i,"c_articolo_cod")
		//ls_appoggio=tab_1.tabpage_2.dw_righe_scelte.getitemstring(i,"articolo_codice")
		ds_righe.setitem(ll_riga_inserita,"c_articolo_cod",ls_appoggio)
		ls_appoggio=tab_1.tabpage_3.dw_righe_gruppo.getitemstring(i,"riga_documento_descrizione")
		//ls_appoggio=tab_1.tabpage_2.dw_righe_scelte.getitemstring(i,"riga_documento_descrizione")
		ds_righe.setitem(ll_riga_inserita,"riga_documento_descrizione",ls_appoggio)
		ld_appoggio=tab_1.tabpage_3.dw_righe_gruppo.getitemdecimal(i,"calo")
		//ld_appoggio=tab_1.tabpage_2.dw_righe_scelte.getitemdecimal(i,"calo")
		ds_righe.setitem(ll_riga_inserita,"calo",ld_appoggio)
		ld_appoggio=tab_1.tabpage_3.dw_righe_gruppo.getitemdecimal(i,"fino")
		//ld_appoggio=tab_1.tabpage_2.dw_righe_scelte.getitemdecimal(i,"riga_documento_fino")
		ds_righe.setitem(ll_riga_inserita,"fino",ld_appoggio)
		ld_appoggio=tab_1.tabpage_3.dw_righe_gruppo.getitemdecimal(i,"coef_calo")
		//ld_appoggio=tab_1.tabpage_2.dw_righe_scelte.getitemdecimal(i,"riga_documento_coef_calo")
		ds_righe.setitem(ll_riga_inserita,"coef_calo",ld_appoggio)
		ll_appoggio=tab_1.tabpage_3.dw_righe_gruppo.getitemnumber(i,"id_titolo")
		//ll_appoggio=tab_1.tabpage_2.dw_righe_scelte.getitemnumber(i,"articolo_id_titolo")
		ds_righe.setitem(ll_riga_inserita,"id_titolo",ll_appoggio)
		ll_appoggio=tab_1.tabpage_3.dw_righe_gruppo.getitemnumber(i,"id_articolo")
		//ll_appoggio=tab_1.tabpage_2.dw_righe_scelte.getitemnumber(i,"id_articolo")
		ds_righe.setitem(ll_riga_inserita,"id_articolo",ll_appoggio)
		ld_appoggio=tab_1.tabpage_3.dw_righe_gruppo.getitemdecimal(i,"riga_documento_dim_l")
	//	ld_appoggio=tab_1.tabpage_2.dw_righe_scelte.getitemdecimal(i,"riga_documento_dim_l")
		ds_righe.setitem(ll_riga_inserita,"riga_documento_dim_l",ld_appoggio)
		ld_appoggio=tab_1.tabpage_3.dw_righe_gruppo.getitemdecimal(i,"riga_documento_peso_netto")
	//	ld_appoggio=tab_1.tabpage_2.dw_righe_scelte.getitemdecimal(i,"riga_documento_peso_netto")
		ds_righe.setitem(ll_riga_inserita,"riga_documento_peso_netto",ld_appoggio)
		ll_appoggio=tab_1.tabpage_3.dw_righe_gruppo.getitemnumber(i,"riga_documento_id_unita_confezione")
	//	ll_appoggio=tab_1.tabpage_2.dw_righe_scelte.getitemnumber(i,"riga_documento_id_unita_confezione")
		ds_righe.setitem(ll_riga_inserita,"riga_documento_id_unita_confezione",ll_appoggio)
		ls_appoggio=tab_1.tabpage_3.dw_righe_gruppo.Getitemstring(i,"sconto")
		//ls_appoggio=tab_1.tabpage_2.dw_righe_scelte.Getitemstring(i,"riga_documento_sconto")
		ds_righe.setitem(ll_riga_inserita,"sconto", ls_appoggio)
		ll_appoggio=tab_1.tabpage_3.dw_righe_gruppo.getitemnumber(i,"riga_documento_id_tab_iva")
	//	ll_appoggio=tab_1.tabpage_2.dw_righe_scelte.getitemnumber(i,"riga_documento_id_tab_iva")
		ds_righe.setitem(ll_riga_inserita,"riga_documento_id_tab_iva",ll_appoggio)
		
		ds_righe.setitem(ll_riga_inserita,"sigla_prezzo","F")
	end if
next	

end subroutine

