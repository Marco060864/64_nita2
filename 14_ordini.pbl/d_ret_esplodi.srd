 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"distinta~" )  TABLE(NAME=~"riga_distinta~" )  TABLE(NAME=~"orafo_dis_cliente~" )  TABLE(NAME=~"unita_confezione~" ) COLUMN(NAME=~"distinta.id_articolo~") COLUMN(NAME=~"distinta.id_valuta~") COLUMN(NAME=~"orafo_dis_cliente.id_riga_doc~") COLUMN(NAME=~"orafo_dis_cliente.id_riga_distinta~") COLUMN(NAME=~"orafo_dis_cliente.id_art_sostitutivo~") COLUMN(NAME=~"orafo_dis_cliente.quantita~") COLUMN(NAME=~"orafo_dis_cliente.note~") COLUMN(NAME=~"riga_distinta.varie~") COLUMN(NAME=~"unita_confezione.dim_l~") COLUMN(NAME=~"orafo_dis_cliente.id_art_originale~") COLUMN(NAME=~"unita_confezione.peso_netto~")    JOIN (LEFT=~"orafo_dis_cliente.id_riga_distinta~"    OP =~"=~"RIGHT=~"riga_distinta.id_riga_distinta~" )    JOIN (LEFT=~"riga_distinta.id_distinta~"    OP =~"=~"RIGHT=~"distinta.id_distinta~" )    JOIN (LEFT=~"orafo_dis_cliente.id_art_sostitutivo~"    OP =~"=~"RIGHT=~"unita_confezione.id_articolo~" )WHERE(    EXP1 =~"~~~"orafo_dis_cliente~~~".~~~"id_riga_doc~~~"~"   OP =~"=~"    EXP2 =~":rn_sorgente~" ) ) ARG(NAME = ~"rn_id_articolo~" TYPE = number)  ARG(NAME = ~"rn_sorgente~" TYPE = number) " arguments=(("rn_id_articolo", number),("rn_sorgente", number)) )
